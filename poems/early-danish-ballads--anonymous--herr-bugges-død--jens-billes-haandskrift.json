{
  "id": null,
  "title": "Herr Bugges Død",
  "year_created": [
    1555,
    1559
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Jens Billes Håndskrift",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1559,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/BILL33.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Her Bugi bøger op Haldtt mett ere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "handtt actett det aldrigh y fremedtt mands vere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": ":: De fare saa fri y-genum Iullandtt. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Hal mett ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "han ated | dæt aller i fræmed | mans være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": ":: De rie saa | fri igæmen Iylan. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Her Bugi sider offuer sitt egitt bordtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "konningen aff danemarck sender hannum ordtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": ":: Di rider saa fri i-genum | iullandtt. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Handtt sender ham ordtt och bliden tall",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "oc feyligh leyde tiill sigh att fare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Dett suaritt fru Ingiborigh y kiortell rødtt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "\"Vedtt mendt, her Bugi, thett blyffuer eders døtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "I setter eders bordtt mett danske hoffmendtt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "tror icke paa koningh Voldemaars leyde endtt!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "\"Haffde iegh lenge lydtt paa dett raadtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "iegh haffde icke en penningh y Danemarck aadtt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "\"Skulle y i aar tiill konningen fare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "huem da setter y Haldtt tiill vare?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 6,
      "text": "\"Knudtt Bugi handtt er min yngste søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "handtt gemer vell Haldtt, tiill iegh komer hiem.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 7,
      "text": "Silligh om afften hueste di spydtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 7,
      "text": "och orligh om morgen rede de udtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 8,
      "text": "Her Bugi han redtt kongh Voldemaar y-modt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 8,
      "text": "dett selki sam under gaanger-fodtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 9,
      "text": "Seskj sam under gangerens ben,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 9,
      "text": "her Bugi redt paa graa kastekne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 10,
      "text": "Koningen handtt recker her Bugi sin handtt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 10,
      "text": "\"Du vere vell-komen, du edeligh mandtt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 11,
      "text": "Wer vell-kommen, du edeligh mandtt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 11,
      "text": "och hure staar hoffuitt y Nørre-Iullandtt?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 12,
      "text": "\"Saa staar hoffuitt y Nørre-Iullandtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 12,
      "text": "dett spørs tiill Sielindtt och Skone-landtt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 13,
      "text": "\"Hør du, her Bugi, iegh spør digh att:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 13,
      "text": "hur lengi viltt du digh paa Haldtt fødtt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 14,
      "text": "Hur lengi villt du digh paa Haldtt fø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 14,
      "text": "du viltt icke en penningh aff Danmarck forø?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 15,
      "text": "\"I VII aar vil iegh migh paa Haldtt føde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 15,
      "text": "iegh vill icke en penningh aff Danmarck for-øde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 16,
      "text": "Konningen handtt tager tiill sin knyff:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 16,
      "text": "\"Wedtt mendtt, her Bugi, dett gielder eders lyff.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 17,
      "text": "Her Bugi bleff saa bratt att suare:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 17,
      "text": "\"Y feyligh leyde loffuitt y migh tiill eder att fare.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 18,
      "text": "\"I feyligh leyde skall du fra migh fare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 18,
      "text": "II mine søster-sønner skall mett digh fare.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 19,
      "text": "Konningen handtt skreff di Melfar tiill:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 19,
      "text": "\"Gør aff her Bugi y-huadtt y vill!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 20,
      "text": "Før y lade her Bugi undgaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 20,
      "text": "da slar ihiell mine søster-søner II!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 21,
      "text": "Før-endtt y lader her Bugi undt-fare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 21,
      "text": "da slar y-hiell min søster-søner y skare!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 22,
      "text": "Herre Krist giffue de Melfar skam!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 22,
      "text": "de voffue her Bugi, den velbyrdigh mandtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 23,
      "text": "Herre Gudtt ladtt de Melfar dett tree!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 23,
      "text": "de voffue her Bugi y feyligh leyde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 24,
      "text": "De voffue her Bugi, den velbyrdigh mandtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 24,
      "text": "siden koningens søstersøner II.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 24,
      "text": ":: De rider saa fri i-genum Iullandtt. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}