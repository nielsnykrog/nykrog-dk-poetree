{
  "id": null,
  "title": "Karl og Margrete",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA56.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "\"Du røm aff land, herre Karll!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "kongen er worden theg wred:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "och miest haffuer du dinn iumfru,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "du faar hynd aldrig merre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: Y rømer aff lande! ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Tthett wor vngen herre Kaarll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "hand suøber seg hoffuet y skiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "saa gaar hand y hyffuelofft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "for Ingelild, søster synn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "\"Hør thu, stalltt Ingelild, søster myn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "och ieg wel thaalle den quide:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "ieg well gaa y blyberritt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "først blyett thett tager att rinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Ieg well gaa y bly-biergitt ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "først blyett thager att rinde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "och ieg well lade mit egit hiarrtte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "buode stiege och brende.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "\"Thu thy quer, herr Kaall, broder myn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "ieg siger deg halleff størr sum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "ieg well faare til Westerland,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "hientte theg thend rosensblome.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Wy well gange y rad-stuoffuen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "och rader wj thett saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "alle dy suene, der meg skall følge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "dy skall haffuee kappen hind graa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Alle thi suene, ther meg skall følge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "thi skall haffue kapen graa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "och alle thi mørr, ther meg skall følgge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "thi skaal haffue chloster-kleder paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Hallefftt wor guld och hallefft wor søleff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "thett legger wy neder y bunck!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "Stalt Ingelild gick til stranden neder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "hinder fuld daa suorten munck.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Tthi seggler denom for Westerland,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "och der løster denom at huile:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "\"Legger y nu neder rød skaarlagenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "y setter op suorten wylle!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Tthett wor iumfru Mergrette,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "hun sier vd till den straand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "\"Her komer ett skib med closter-iumfruer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "dy stunder her hid for land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Ieg sierr saa mangen closter-iunfruer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "thi stunder hid for land:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "antten daa er dierris chloster brend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "helder deris priers død.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Op stuod iumfru Mergrette,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "garr for syn faader att staa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "\"Mynn kerre fader, y giffuer meg luoff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "neder til straanden att gaa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "Herr seeder y, daaner-kongenn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "och kerre fader myn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "maa ieg gaa til strandenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 12,
      "text": "och byd dy iumfruer ind?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "\"Welltt thu theg til strannden gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "ieg well theg thett icke formiene:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "thu thag med deg buod rider och suene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 13,
      "text": "gack icke til strannden aliene!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Bortt gick iumfru Mergrette,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "liud icke syn faders rad:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "och saa gick hun til stranden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 14,
      "text": "alt med thuo iunnfruer smaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "Tthett wor iunnfru Megrette,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "hun gaar paa huiden sannd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "thett tha wor thi closter-iumfruer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 15,
      "text": "dy styritt derris skib for land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "\"I wer well-komen, y chloster-iumfruer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "thil thette her fremede land!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "huad helder daa er eders priers død?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 16,
      "text": "och helder eders chloster er brend?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "Er y thrett, och er y muod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "er komen vd-aff eders lieed:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "well y med meg till slottet gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 17,
      "text": "ieg lader eder en ba-stuo rede.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "\"Tthett loffued wy woris prieris,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "førind wy drog vd fra land:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "att wi skuld aldrig wor fuod indsette",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 18,
      "text": "paa den iødske sannd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "Wy haffuer laritt, wy haffuer lynn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "som iumfruer plier att købe:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "well y eder y skibbett gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 19,
      "text": "y maa thett skuo och welle.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "Iunfruenn ind y skibbitt thrend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "den edlig klarre mø:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "alle thi aarer, y skibbitt war,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 20,
      "text": "thi legger y sallttenn syøø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 21,
      "text": "Alle thi aaarer, y skibbitt waar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "thi leegger y saalltten syø:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 21,
      "text": "greffuens datter aff Lindeholum",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 21,
      "text": "hun war derris styris-mand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 22,
      "text": "Saa bratt kaam buod y hyffue-lofft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 22,
      "text": "for iumfruens muoder ind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 22,
      "text": "\"Bortte saa er dy chloster-iumfruer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 22,
      "text": "alltt med kerre datter dyn!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 23,
      "text": "\"Er dy nu bortte med datter myn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 23,
      "text": "och siger y meg saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 23,
      "text": "tha skall ieg thett wende:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 23,
      "text": "thi skall icke børrenn faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 24,
      "text": "Ttha skall ieg thett wende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 24,
      "text": "thi skall ike børren faa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 24,
      "text": "førrind hun iumfru Mergrett",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 24,
      "text": "och thett hun thaalle maa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 25,
      "text": "Dett var greffindenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 25,
      "text": "hun stod och saa der-paa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 25,
      "text": "hun giorde det med di ramme ronner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 25,
      "text": "di kunde icke børrenn faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 26,
      "text": "Windenn bleste, och dagenn gick,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 26,
      "text": "och bølgenn legthe for borde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 26,
      "text": "saa stille sad iomfru Margrette,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 26,
      "text": "hun thalde aldrig itt ordt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 27,
      "text": "Tther luoff dy y dage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 27,
      "text": "och der luo dy y fem:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 27,
      "text": "icke kund dy ett ord fannge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 27,
      "text": "vd-aff den iumfru y dem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 28,
      "text": "Iche wilde hun skiempte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 28,
      "text": "och iche wilde hun lee:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 28,
      "text": "saa saare monne hun grede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 28,
      "text": "hun wilde iche til dennem see.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 29,
      "text": "Det da melthe denn styrre-mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 29,
      "text": "som skibit skulle raade:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 29,
      "text": "\"Vy kand aldrig børrenn faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 29,
      "text": "før dene iomfru monne thalle.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 30,
      "text": "Sttalltt Ingelild thaaller till synne møørr:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 30,
      "text": "\"Y skerer aff iunfru Merrgrettis haard!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 30,
      "text": "hun skall lege neder rød skaar-lagen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 30,
      "text": "och tage cløster-kleder paa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 31,
      "text": "Tthett suared iunfru Mergrette,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 31,
      "text": "saa tuog hun paa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 31,
      "text": "\"Ieg haffuer slett rød skaarlagenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 31,
      "text": "siden ieg nam først att gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 32,
      "text": "Ieg haffuer slett thi røde guld-skuo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 32,
      "text": "siden ieg nam først att gange:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 32,
      "text": "haffde ieg bleffuet y Westerland,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 32,
      "text": "en konge saa haffde ieg fangitt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 33,
      "text": "Der denn iomfru haffde vdtalt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 33,
      "text": "daa fiich dy børrenn saa god:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 33,
      "text": "saa seylit di dennum thil Suerrig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 33,
      "text": "vel y maaneder tho.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 34,
      "text": "\"Alltt wor guld och alt wor sølleff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 34,
      "text": "thett leger wy nu til hande:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 34,
      "text": "wy lader hind vngee herre Kaal sie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 34,
      "text": "hans iumfru stander til lande.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 35,
      "text": "Saa kaast thi acker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 35,
      "text": "paa denn huide saand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 35,
      "text": "thett wor vnge herre Kaall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 35,
      "text": "hand render vd med thend straand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 36,
      "text": "Saa thuog thi iumfru Mergrette,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 36,
      "text": "thi løfftte hind først paa land:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 36,
      "text": "frem gaar vngen herre Kaall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 36,
      "text": "hand tog hind y syn arum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 37,
      "text": "Tthett wor vngen herre Kaall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 37,
      "text": "hand recker hind huiden haannd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 37,
      "text": "\"Y wer well-komen, iumfru Mergrete,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 37,
      "text": "til dese fremede land!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 38,
      "text": "Tthett wor iumfru Mergrettis",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 38,
      "text": "hindis størrtte harum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 38,
      "text": "thend første søndag efter, hun til Suerig kaam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 38,
      "text": "hun suo y her Kaals arum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 39,
      "text": "Herre Karl lader sig thil koning kronne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 39,
      "text": "en herre offuer Suerigs rige:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 39,
      "text": "den iomfrue hun gred, och hender hun slog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 39,
      "text": "hand lod hinde iche were sin lige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 40,
      "text": "Tthett lide fast om iamell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 40,
      "text": "thett aar thett mone om-gange:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 40,
      "text": "thett wor frue Mergrette,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 40,
      "text": "tager efter syn moder att lange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 41,
      "text": "Tthi lid hind vd, thi lid hind ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 41,
      "text": "hind lid ioo lenger och werde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 41,
      "text": "\"Imend thett kand icke bedere werre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 41,
      "text": "tha sender buod efter myn here!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 42,
      "text": "Op stuod staltenn Ingelild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 42,
      "text": "sluo offuer sieg skaarlagen-skiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 42,
      "text": "saa garr hun y hyffue-lofft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 42,
      "text": "for hare Kaal, broder synn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 43,
      "text": "\"Tthu statt nu op, herre Kaall, broder myn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 43,
      "text": "thu lad theg ther-till tøcke:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 43,
      "text": "thu giffuer Mergrett en kron aff guld!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 43,
      "text": "thett bliffuer oss alle till løcke.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 44,
      "text": "\"Ieg thør icke for broder myn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 44,
      "text": "hand er meg y kald aller-nest:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 44,
      "text": "ike helder for theg, stallt Ingerlild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 44,
      "text": "thu est myn søster alerkerist.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 45,
      "text": "\"Tthu matt well for broder dynn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 45,
      "text": "hand er deg icke kald aldernest:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 45,
      "text": "halff beder for meg, stalt Ingelild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 45,
      "text": "ieg vnder hind theg aller-heldst.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 46,
      "text": "Saa saare græd stolte Ingelild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 46,
      "text": "hun vred hindes huide haand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 46,
      "text": "\"Mindes eder, min kierre broder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 46,
      "text": "ieg hentte hinde af fremmede land?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 47,
      "text": "Op stuod vngen herre Kaall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 47,
      "text": "och hand skiend alt som guld:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 47,
      "text": "saa gick hand til allerkeriste syn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 47,
      "text": "for hand wor dyde-fuld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 48,
      "text": "Herre Kaall ind aff dørren thrend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 48,
      "text": "och hand glemer alt som guld:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 48,
      "text": "hand kund icke liuss paa kiartten siee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 48,
      "text": "hans øgen wor tare-fuld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 49,
      "text": "\"I lader hientte ind thi prester,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 49,
      "text": "som hinder skall skrefftte och berette!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 49,
      "text": "selliff well ieg med min egen hand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 49,
      "text": "guld-kronen paa hind sette.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 50,
      "text": "Hand satte guld-krone paa hindis hoffuet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 50,
      "text": "med hans huide hand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 50,
      "text": "hun bleff hans egtte-droning",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 50,
      "text": "om den morgenstund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 51,
      "text": "Tthett wor alle dy fruer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 51,
      "text": "thi bliff y hiarthett saa glad:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 51,
      "text": "droning Mergerette",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 51,
      "text": "hun føde thi soner thuo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 52,
      "text": "\"I lader wor bencke opreede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 52,
      "text": "wor guold med silcke bredde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 52,
      "text": "greffuens frw aff Østerland,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 52,
      "text": "wi skall hind ther-offuer lieede.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 53,
      "text": "Tthett thaa wor gereff-inden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 53,
      "text": "hun ind aff puortten thrend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 53,
      "text": "thett wor staltten Ingelild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 53,
      "text": "hun gaar hind vd igen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 54,
      "text": "Ttthette melltte greff-inden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 54,
      "text": "och saa thuog hun paa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 54,
      "text": "\"Fuldwell mat herre Kaall sleffred",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 54,
      "text": "paa den baare iord gaa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 55,
      "text": "Tthett suaridtt stalten Ingelild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 55,
      "text": "hun suaritt ett ord der-till:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 55,
      "text": "\"Fuld uell maa droning Mergreett",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 55,
      "text": "slid skaarlagenn, om hun well.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 56,
      "text": "Tthett melltte greff-inden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 56,
      "text": "hun smiller vnder skiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 56,
      "text": "\"Huor daa er frw Mergrette,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 56,
      "text": "kerre datter myn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 57,
      "text": "\"Hun legger siug y hyffue-lofft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 57,
      "text": "paa thi bolster blaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 57,
      "text": "thett er icke lennger sydenn y gaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 57,
      "text": "hun føde thi søner smaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 233,
      "stanza_id": 58,
      "text": "Offuenn for dy sualle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 234,
      "stanza_id": 58,
      "text": "och nedenn for dy tinde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 235,
      "stanza_id": 58,
      "text": "der finder i dronning Margrette",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 236,
      "stanza_id": 58,
      "text": "med sinne iomfruer inde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 237,
      "stanza_id": 59,
      "text": "Tthett wor greff-indenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 238,
      "stanza_id": 59,
      "text": "hun ind aff dørenn thrend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 239,
      "stanza_id": 59,
      "text": "thett wor droning Mergrette,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 240,
      "stanza_id": 59,
      "text": "hun recker hind handen igenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 241,
      "stanza_id": 60,
      "text": "\"I verre vell-kommen, kierre moder min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 242,
      "stanza_id": 60,
      "text": "thill disse fremmede lande!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 243,
      "stanza_id": 60,
      "text": "det vedt Gud-fader y Himmerig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 244,
      "stanza_id": 60,
      "text": "ieg haffuer fast effter eder langet.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 245,
      "stanza_id": 61,
      "text": "Tthett wor hindis kerre moder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 246,
      "stanza_id": 61,
      "text": "klaper hinder wed huiden kynd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 247,
      "stanza_id": 61,
      "text": "\"Huor lider theg? stalltte Mergrette,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 248,
      "stanza_id": 61,
      "text": "ieneste datter myn!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 249,
      "stanza_id": 62,
      "text": "\"Ieg tacker hende, stolt Ingelild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 250,
      "stanza_id": 62,
      "text": "hun er en iomfru saa fiin:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 251,
      "stanza_id": 62,
      "text": "ret aldrig kand ieg hende fuldtacke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 252,
      "stanza_id": 62,
      "text": "heller nogen aff venner min.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 253,
      "stanza_id": 63,
      "text": "Ieg tacker hind, stalltten Ingelild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 254,
      "stanza_id": 63,
      "text": "dog hun førde meg aff min lied:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 255,
      "stanza_id": 63,
      "text": "hun haffuer thett alliene wolditt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 256,
      "stanza_id": 63,
      "text": "att ieg er droning bleffuet.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 257,
      "stanza_id": 64,
      "text": "\"Du warst deg saa vng enn maard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 258,
      "stanza_id": 64,
      "text": "thu kamst aff dynn faders land:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 259,
      "stanza_id": 64,
      "text": "had thu matt hieme bleffuet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 260,
      "stanza_id": 64,
      "text": "en konge haffde thu ther och fangitt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 261,
      "stanza_id": 65,
      "text": "Det war greffinden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 262,
      "stanza_id": 65,
      "text": "klapper hende ved huiden kind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 263,
      "stanza_id": 65,
      "text": "\"I haffue tak, stolten Ingelild!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 264,
      "stanza_id": 65,
      "text": "i er en iomfru saa fiin.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 265,
      "stanza_id": 66,
      "text": "Tthett melltte droning Mergrete,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 266,
      "stanza_id": 66,
      "text": "i sengen som hun luo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 267,
      "stanza_id": 66,
      "text": "\"Y sender buod efter myn herre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 268,
      "stanza_id": 66,
      "text": "lader hanom til myn moder gaa!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 269,
      "stanza_id": 67,
      "text": "Kong Kaall hand ind aff dorren thrend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 270,
      "stanza_id": 67,
      "text": "hand reker hind huiden hand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 271,
      "stanza_id": 67,
      "text": "\"Y wer well-komen, myn kerre frw modder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 272,
      "stanza_id": 67,
      "text": "til dese her fremede land!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 273,
      "stanza_id": 68,
      "text": "Nu haffuer ieg eders datter kronne griffuett",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 274,
      "stanza_id": 68,
      "text": "och hinder en droning wduold:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 275,
      "stanza_id": 68,
      "text": "hør y thett, min kerre fru moder:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 276,
      "stanza_id": 68,
      "text": "y klager icke offuer meg wold!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 277,
      "stanza_id": 69,
      "text": "\"Ieg tacker eder, vngen konge Kaall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 278,
      "stanza_id": 69,
      "text": "alt for eders mogitt erre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 279,
      "stanza_id": 69,
      "text": "thett er thend løn, ther eder børr,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 280,
      "stanza_id": 69,
      "text": "y skylden att berre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 281,
      "stanza_id": 70,
      "text": "Tther war hun y maanitt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 282,
      "stanza_id": 70,
      "text": "och ther war hun y thre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 283,
      "stanza_id": 70,
      "text": "saa begyntte hun att lengis",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 284,
      "stanza_id": 70,
      "text": "hiem till syn egen rygge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 285,
      "stanza_id": 71,
      "text": "Tthett thaa wor greff-inndenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 286,
      "stanza_id": 71,
      "text": "och tager hun till att lang:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 287,
      "stanza_id": 71,
      "text": "\"Hør y thett, vnge kong Kaarll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 288,
      "stanza_id": 71,
      "text": "nu maa ieg hiem til lande.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 289,
      "stanza_id": 72,
      "text": "Tthett wor droning Mergrett,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 290,
      "stanza_id": 72,
      "text": "hun bød synn moder godnat:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 291,
      "stanza_id": 72,
      "text": "och hinder rand thaar paa huidenn kinnd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 292,
      "stanza_id": 72,
      "text": "der dy skuld skiellis att.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 293,
      "stanza_id": 73,
      "text": "\"Gred icke, droning Mergrette,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 294,
      "stanza_id": 73,
      "text": "och kerre datter myn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 295,
      "stanza_id": 73,
      "text": "men bed til Gud, att kong Kaarll maa leffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 296,
      "stanza_id": 73,
      "text": "och kerre herre din!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 297,
      "stanza_id": 74,
      "text": "\"Mynn allerkierist moder!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 298,
      "stanza_id": 74,
      "text": "ieg well eder Gud beffalle:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 299,
      "stanza_id": 74,
      "text": "y siger myn herre fader thusen guod natt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 300,
      "stanza_id": 74,
      "text": "nar y komer hiem til lande!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 301,
      "stanza_id": 75,
      "text": "\"Denn almegtiste herre och Gud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 302,
      "stanza_id": 75,
      "text": "som alting haffuer y wold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 303,
      "stanza_id": 75,
      "text": "beffaaller ieg deg och dyn kerre herre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 304,
      "stanza_id": 75,
      "text": "well thusind foold.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 305,
      "stanza_id": 76,
      "text": "Tthett wor wnge konge Kaarll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 306,
      "stanza_id": 76,
      "text": "hand fulde den greffuee til strand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 307,
      "stanza_id": 76,
      "text": "\"Den aller-megtiste herre och Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 308,
      "stanza_id": 76,
      "text": "sende eder well till lande!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 309,
      "stanza_id": 77,
      "text": "\"Hør y thett, vnge herre Kaall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 310,
      "stanza_id": 77,
      "text": "och kerre sønne mynn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 311,
      "stanza_id": 77,
      "text": "ieg beffaller eder den rige Chrest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 312,
      "stanza_id": 77,
      "text": "for-glemer icke kere dater myn!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 313,
      "stanza_id": 78,
      "text": "Aldrig hørrde ieg en sorrig-fuld ferd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 314,
      "stanza_id": 78,
      "text": "der feck en beddere ende:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 315,
      "stanza_id": 78,
      "text": "loffued were Gud-fader y Hemerig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 316,
      "stanza_id": 78,
      "text": "saa kand hand altting well om-wende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 317,
      "stanza_id": 78,
      "text": ":: I rømer aff lannde! ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}