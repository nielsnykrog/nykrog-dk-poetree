  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "WAare Gud icke met oss denne tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "saa skal Jsrael sige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "vaare Gud icke met oss denne tid/",
      "part": false,
      "marginal_notes": [
        "Exodi xiiii"
      ]
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "wi hagde lidt angist oc quide/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Gud saa de Christne store oc smaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "aff mange wantro foractis saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "som dem monne saare forfølge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "De menniske ere i hw saa vrede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "de reyse dem mod oss alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Saa leffuendis hagde de sunckit oss ned/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "med grunhed oss offuer faldet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "vor siel hun gick igennem det vand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "wi hagde faarsunckid alle mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "hagde Gud icke met oss wærit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Benedidet være Herren der oss ey gaff vnder deris tender fangne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "alt som en fwl der snaren kommer aff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "saa er vor siæl vndgangen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "dem snare er brøsten oc wi ere fri/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "vor herris naffn det staar oss bi",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Som haffuer skapt himmelen oc iorden",
      "part": false,
      "marginal_notes": [
        "Gene i"
      ]
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "Ere være dig Gud i euighed/",
      "part": false,
      "marginal_notes": [
        "Mat vi"
      ]
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "vor fader lost tu dig kalle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "begaffue oss met din miskundhed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "wi bede du oss ey vndfalde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Den ære din Søn skal wære lig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "fra nu oc ind til euig tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Den Helligand ey fra skilyes",
      "part": false,
      "marginal_notes": []
    }
  ]
}