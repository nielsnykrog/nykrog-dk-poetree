  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1833,
    "url": "https://tekstnet.dk/books/andersen-hc_den-femte-mai-1821/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "1.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "De Spanske lod’ mig deres Skib bestige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Da sorrigfuld jeg gik paa fjerne Bred;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Jeg svage Rest kun af et Helterige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Min Sorg, forviist, paa Ganges Bølger gled.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Fem Aar svandt under Indiens Middagsbue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Nu langt fra Cap, saa glad jeg seiler her.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Stakkels Soldat! jeg skal mit Frankrig’ skue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Min Søn skal lukke mine Øine der!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "2.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Ha, St. Helena! Lodsen høit udbryder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "See, der Europas Helt vansmægte maa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "I brave Spanske, Harmens Taare flyder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Hans Lænker og hans Bødler falde maae!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Sløv leger Tiden over Døgnets Tue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Ak, jeg kan intet gjøre for ham her!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Stakkels Soldat! jeg skal mit Frankrig’ skue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Min Søn skal lukke mine Øine der!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "3.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Maaskee han sover! han der gik at knuse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "De stolte Kongers Throner, hvor han saae!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Skal atter Kæmpevingen mægtigt suse?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Han gaae at døe, mens Konger styrte maae? –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Ak! Hav og Klippe barsk ad Haabet true,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "I Guders Raad er Ørnen ikke meer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Stakkels Soldat! jeg skal mit Frankrig’ skue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Min Søn skal lukke mine Øine der!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "4.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Træt Seiren stod, den kunde ham ei følge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Den sank, men ei han tøved’ efter den,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Kun tvende Gange med den falske Bølge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Han dukked’ for at hæve sig igjen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "Med giftig Saft de grønne Laurbær true,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "Dødsenglen Heltens bedste Krands frembær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "Stakkels Soldat, jeg skal mit Frankrig’ skue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "Min Søn skal lukke mine Øine der!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "5.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "»Mon det er ham?« Hver Potentat udbryder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "Saasnart et Skib gaaer over Bølgen blaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "»Ha, er det ham!« som Skrækkens Bud det lyder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "»Mod ham vi Millioner væbne maae!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "Og han? – Maaskee nu slukkes Lampens Lue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "Du, Fædreland, hans sidste Tanke er;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "Stakkels Soldat, jeg skal mit Frankrig skue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "Min Søn skal lukke mine Øine der!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "6.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "Dit Navn, din Aand, gik gjennem alle Zoner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "Thi Himlens Gud sin største Skat dig gav;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 5,
      "text": "Det straaler mægtigt over Jordens Throner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 5,
      "text": "Fra denne Klippe i det vilde Hav.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 5,
      "text": "Hans Seire seer jeg der som Fyret lue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 5,
      "text": "To Verdner, ny og gammel, mødes her.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 5,
      "text": "Stakkels Soldat! jeg skal mit Frankrig’ skue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 5,
      "text": "Min Søn skal lukke mine Øine der!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "7.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "I brave Spanske! Klippen hist jeg kjender,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 6,
      "text": "Men, store Gud, et kulsort Flag jeg seer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 6,
      "text": "O jeg maa græde! – græde selv hans Fjender,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 6,
      "text": "Død er han! Seir, din Hosbond er ei meer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 6,
      "text": "Nu synker Dagens Stjerne fra sin Bue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 6,
      "text": "Taust flye vi Klippen med dens Helgenskjær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 6,
      "text": "Stakkels Soldat! jeg skal mit Frankrig’ skue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 6,
      "text": "Min Søn skal lukke mine Øine der!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
