{
  "id": null,
  "title": "»Det har Zombien gjort«",
  "year_created": 1855,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Af. Samlede Skrifter. Sextende Bind",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1855,
    "url": "https://tekstnet.dk/books/andersen-hc_af-samlede-skrifter-sextende-bind/006/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Har Du hørt om Tryllelandet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Bag de vilde Pyrenæer?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Maurisk Kunst staaer i Ruiner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Under høie Pinietræer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "I den milde Luft ved Kilden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Synge Hyrderne om ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Messer læses, Klokker klinge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Her er altid Kirketid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "I SevillasDom er malet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "En Madonna reen og mild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Jomfru bly og dog som Moder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Ynde, Mildhed, Guddoms Ild.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Men hvo blanded’ disse Farver?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Hvo har kunnet male Sligt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Hvad jeg veed, vil jeg fortælle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Og det Givne er ei Digt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Velbekjendt er Don Murillo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Spaniens Correggio,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Paa hans Dragt man saae hans Rigdom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "I hans Øie Snillet loe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Det var just en Sommermorgen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Tidligt, som de pleied’ det,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Kom Eleverne og satte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "Sig til Pensel og Pallet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Don Murillo var der ikke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Der blev spøgt og der blev talt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Drillet, sværmet, aandet Viisdom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "Og forresten meget Galt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "»Ved Sanct Jacob!« skreg den Ene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Da han for sit Billed’ staaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "»Hvo har malet paa mit Stykke?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "Hvo gik sidst herfra igaar?«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "»O Du Nar, vi gik jo sammen!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "– »See, hvor min Pallet seer ud!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "Og betragt dog dette Stykke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "Det er malet til en Klud!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "»Dog i Hjørnet staaer et Hoved,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "O, hvor deiligt! o hvor blødt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "Det har Du ei kunnet male,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "Før dit lever er det dødt!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "»Mine Pensler ere vaade!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Raabte høit en Tredie der;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "»Det er ei den første Morgen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "Sligt er mødt os Alle her!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "Meget skeer i Nattens Time,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Meget, underfuldt og stort!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "– »Ah, du troer med Negerslaven",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "Gomes, det har Zombien gjort;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "Zombien, som han kalder Nissen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "Efter Negerfolkets Tro!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "– »Gid,« udbrød den Ældste blandt dem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "»Zombien lod Jer i Ro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 13,
      "text": "Og fuldførte min Madonna,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "Det vil ei med hende gaae!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "Han sig vendte til sit Billed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "Blegnede og saae og saae:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "Herligt skjønt, om kun skizzeret,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Et Madonnahoved stod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "»Naadens Gud! hvo maled’ dette?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "O, jeg har ei Kraft, ei Mod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 15,
      "text": "Til at ende dette Skabte!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "Hvilken Skjønhed! o, hvor stort!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "Don Murillo traad i Salen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "Spurgte: »hvo har dette gjort?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 16,
      "text": "Den som maled’ det, er Maler,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "Er min kjæreste Elev!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "Alle nedslog deres Øine,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "Alle om ham tause blev.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 17,
      "text": "»Svar dog, hvo har malet dette?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "Svar mig! jeg det vide vil!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "– »Zombien har gjort det, Mester!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "Her gaaer ikke rigtigt til!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 18,
      "text": "Hver en Aften Alt vi ordne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "Rense Pensel og Pallet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "Men hver Morgen naar vi komme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "Intet er paa samme Plet!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 19,
      "text": "Men rundt om, saa deiligt malet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "Titter mangt et Hoved frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "Her en Engel, der en Djævel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "Man maa gaae fra sine fem!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 20,
      "text": "Taus Murillo saae paa Stykket,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "Vendte Øiet da mod Jord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "»Gid jeg selv det havde malet!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "Var den store Mesters Ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 21,
      "text": "»Men hvo har? Kom ind Sebastian!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 21,
      "text": "Dreng, Du med det uldne Haar!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "Og en Søn af Negerslaven Kom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 21,
      "text": "en Dreng paa fjorten Aar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 22,
      "text": "»Har jeg ikke strengt befalet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 22,
      "text": "Du hver Nat skal sove her!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 22,
      "text": "– »Herre jo.« – »Du gjør det ikke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 22,
      "text": "Vi har jo Beviset der!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 23,
      "text": "Siig, hvo kommer her om Natten?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 23,
      "text": "Hvorfor løber Du din Vei?« – –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 23,
      "text": "»Herre, her har Ingen været,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 23,
      "text": "Ingen, Ingen, uden jeg!« –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 24,
      "text": "»Dreng, Du lyver! jeg befaler,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 24,
      "text": "Du skal vaage her inat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 24,
      "text": "Og imorgen Du fortæller,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 24,
      "text": "Hvo der har for Stykket sat!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 25,
      "text": "Sover Du, hvad heller løber,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 25,
      "text": "Vil det ilde med Dig gaae!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 25,
      "text": "Stokkeprygl, ja fem og tyve,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 25,
      "text": "Skal Du ærligt af mig faae!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 26,
      "text": "Og Enhver nu til sit Arbeid’!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 26,
      "text": "Under dette Dagen gik;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 26,
      "text": "»Tænk paa Pryglene, Sebastian!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 26,
      "text": "Var den Mindelse, han fik.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 27,
      "text": "»Zombien er det!« sagde Drengen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 27,
      "text": "»Slaae mig for det er for haardt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 27,
      "text": "Benet der paa Eders David",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 27,
      "text": "Trak han langt og Armen kort!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 28,
      "text": "»Rigtigt truffet!« skreg de Andre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 28,
      "text": "»Selv Sebastiangjør Dig Tort!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 28,
      "text": "Og de drillede og spøgte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 28,
      "text": "Endelig gik Alle bort.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 29,
      "text": "– – Det var Nat, saa tyst og stille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 29,
      "text": "Lampen bredte ud sit Skjær;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 29,
      "text": "Ene, grundende stod Drengen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 29,
      "text": "Tænkte han paa Zombien her?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 30,
      "text": "Døren aabnedes saa sagte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 30,
      "text": "Blikket vendte han derhen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 30,
      "text": "Negeren, hans Fader, var det,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 30,
      "text": "Eneste og bedste Ven.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 31,
      "text": "»Fader, hvad vil Du saa silde?«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 31,
      "text": "– »Vaage for Dig! sov saa Du.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 31,
      "text": "– »Det behøves ikke Fader!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 31,
      "text": "– »Men naar Zombien kommer nu!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 32,
      "text": "»Jeg er ei for Zombien bange!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 32,
      "text": "– »Men hvis Dig han tager bort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 32,
      "text": "Staaer jeg jo i Verden barnløs,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 32,
      "text": "Barnløs, der er altfor haardt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 33,
      "text": "Du min Slavestand mig mildner!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 33,
      "text": "– »Fader, jeg har meget grædt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 33,
      "text": "Være Slave, o hvor grusomt!« –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 33,
      "text": "– »Barn, Vorherre vilde det!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 34,
      "text": "– »Fader, Frihedstimen kommer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 34,
      "text": "Jeg i Drømmene den saae!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 34,
      "text": "Sov nu Du! naar Zombien kommer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 34,
      "text": "Muligt Hjelp fra ham vi faae!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 35,
      "text": "Gaae dog, Fader! vær ei bange!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 35,
      "text": "Bed, gid Frihedstimen slaae!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 35,
      "text": "Og med Kys og barnlig Tale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 35,
      "text": "Bragte han ham til at gaae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 36,
      "text": "»Nu til Arbeid!« raabte Drengen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 36,
      "text": "»Gud, jeg kan jo ei modstaae!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 36,
      "text": "Der er Noget inden i mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 36,
      "text": "Som tilraaber mig, jeg maa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 37,
      "text": "Men naar de i Morgen spørge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 37,
      "text": "Og jeg ikke svare kan.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 37,
      "text": "Fem og tyve Slag bekommer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 37,
      "text": "Da din Ryg, Sebastian?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 38,
      "text": "Gud, jeg kan ei lade være!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 38,
      "text": "Og han græd og knæled’ ned;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 38,
      "text": "Under Bønner, under Taarer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 38,
      "text": "Sendte Søvnen ham sin Fred! –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 39,
      "text": "Først i Dæmringen han vaagned’,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 39,
      "text": "Og forskrækket saae sig om,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 39,
      "text": "Kun tre Timer var tilbage;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 39,
      "text": "Da han vidste, at de kom.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 40,
      "text": "»Jeg har sovet, kunnet sove,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 40,
      "text": "Sove Friheds-Tiden hen!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 40,
      "text": "Kun endnu tre korte Timer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 40,
      "text": "Slave er jeg da igjen!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 41,
      "text": "Mod, Sebastian! Du maa male!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 41,
      "text": "Er det vel en Synd, o Gud?«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 41,
      "text": "Penslen greb han, sin Madonna",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 41,
      "text": "Vilde kjækt han slette ud;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 42,
      "text": "Men selv i de svage Omrids",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 42,
      "text": "Laae en Kraft, et Sjæleblik!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 42,
      "text": "O, det var, som om hun aanded’,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 42,
      "text": "Smilet til hans Hjerte gik.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 43,
      "text": "»De lod hende staae, de Andre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 43,
      "text": "Slette ud de kunde ei,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 43,
      "text": "Selv Murillo vilde ikke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 43,
      "text": "Mesteren, og skulde jeg?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 44,
      "text": "Nei, lad ham imorgen slaae mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 44,
      "text": "Hvert et Træk jeg lader staae!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 44,
      "text": "Som Du staaer for mig, Gudsmoder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 44,
      "text": "Jeg dit Billed’ male maa!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 45,
      "text": "Og hans Kunstner-Øie flammed’,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 45,
      "text": "Dristigt Penselen han tog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 45,
      "text": "Malede, imedens Hjertet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 45,
      "text": "Helligt i Begeistring slog.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 46,
      "text": "Solen lyste, Alt han glemte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 46,
      "text": "Stokkeprygl og Slavestand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 46,
      "text": "Stor og fri hans Sjæl sig følte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 46,
      "text": "Aanden vied’ ham til Mand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 47,
      "text": "Pludselig en Støi han hørte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 47,
      "text": "Tæt bag ved ham Klyngen stod:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 47,
      "text": "Don Murillo, hans Elever;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 47,
      "text": "Blodet Drengens Kind forlod;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 48,
      "text": "Hovedet af Skræk han bøied’",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 48,
      "text": "Straffen nu han tænkte paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 48,
      "text": "Mens den hele unge Skare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 48,
      "text": "I Beundring paa ham saae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 49,
      "text": "Don Murillodulgte Blikket,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 49,
      "text": "Syntes vred og streng i Hu.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 49,
      "text": "»Dreng, hvo lærte Dig at male«?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 49,
      "text": "»Herre, Du!” – »Hvad jeg?« – »Ja du!« –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 50,
      "text": "»Jeg har aldrig underviist Dig!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 50,
      "text": "– »Men jeg Dig jo male saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 50,
      "text": "Og naar Du de Andre lærte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 50,
      "text": "Stod og hørte jeg derpaa!« –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 51,
      "text": "– »Ja, Du hørte, Du benytted’,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 51,
      "text": "Ordet til den Rette kom!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 51,
      "text": "Du maa tugtes, eller lønnes –!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 51,
      "text": "– »Lønnes!« bad de rundten om.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 52,
      "text": "»Vel, forlang!« og Drengen bæved’,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 52,
      "text": "Han i Hjertet blev saa glad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 52,
      "text": "»Bed om Penge! bed om Klæder!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 52,
      "text": "Men endnu han ikke bad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 53,
      "text": "»Tal kun frit!« udbrød Murillo;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 53,
      "text": "»Herre, ak! jeg vover ei!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 53,
      "text": "»Bed om Penge!« sagde Nogle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 53,
      "text": "»Du i Dag faaer intet Nei!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 54,
      "text": "»Bed om Frihed!« raabte Andre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 54,
      "text": "»Nu din Trældom er forbi!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 54,
      "text": "»Frihed!« raabte Drengen, »Frihed!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 54,
      "text": "Herre giv min Fader fri!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 55,
      "text": "Og Murillo brast i Taarer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 55,
      "text": "Slutted’ Drengen i sin Favn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 55,
      "text": "»Han og du er’ frie, I Kjære!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 55,
      "text": "Værdig er Du Kunstner-Navn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 56,
      "text": "Aandens Snille kan man eie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 56,
      "text": "Men der maa et Hjerte til!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 56,
      "text": "Held mig, jeg har skabt en Maler,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 56,
      "text": "Spanien ham bekrandse vil!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 57,
      "text": "Negeren, den glade Fader,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 57,
      "text": "Hørte, undred’: »O, hvor stort!« –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 57,
      "text": "Drengen smilte gjennem Taarer:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 57,
      "text": "»Fader, det har Zombien gjort!«",
      "part": false,
      "marginal_notes": []
    }
  ]
}
