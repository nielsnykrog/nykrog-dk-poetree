  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Fader wor barmhiertig oc god:",
      "part": false,
      "marginal_notes": [
        "Math. vj. j. Petri. j. Psal. xlij. Psal. xxij."
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "som oss wilde til teg kalle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "oc stencke oss med Christi blod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "som borttager synder alle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Lad komme til oss thit hellige ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "thÿn wilie kan thet forklare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "som skabit haffuer himmel oc iord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "thet maa wor lære wære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "att wÿ ey wilde fare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Saa raabe wy alle nw til teg/",
      "part": false,
      "marginal_notes": [
        "Joh. viij. Johan. j. ij j. Petri. v. j. Corin. xj."
      ]
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "oss er ey andet til raade:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "thÿ ingen tager thÿne ord til seg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "vden han faar thÿn naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "O hellige fader tenck ther paa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "att dieffuelen giør oss wande/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "oc wil oss tage thÿne ord bort fraa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "oc komme oss seg til hande/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "thÿ send oss then helliaande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "O Gud oc meniske Jesu Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "som synden paa teg lagde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "tw wedst wel sielff wor store brøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "mæden tw mandom hadde.",
      "part": false,
      "marginal_notes": [
        "Heb. iiij. Joh. xv. oc xvj."
      ]
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "O Jesu Christ wor broder kiær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "werdis thit løffte att holde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "hugswaleren lad komme her/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "som oss lærer sanning alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "att wÿ icke fraa teg falle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "O tw gode helliaand kom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "slÿd sønder dieffuelsens snare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "lad Guds ord faa ÿ wort hierte rom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "att thet motte hooss oss wære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "saa bliffue wÿ alle reene giord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "oc prÿse wor Gud ÿ sanning/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "aff Jesu Christi ewige ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "then wÿ tacke alle sammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "nw siungendis alle AMEN.",
      "part": false,
      "marginal_notes": []
    }
  ]
}