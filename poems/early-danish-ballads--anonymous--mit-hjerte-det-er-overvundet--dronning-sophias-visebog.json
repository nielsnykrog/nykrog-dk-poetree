{
  "id": null,
  "title": "Mit hjerte det er overvundet",
  "year_created": 1584,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Dronning Sophias visebog",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1584,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/DRS54.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Mytt hiertte thend er offuer-wonden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "wndfangen wdj Wenners krafft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "aff thend ther mig well wnder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "hindes naffuen thet er wsagt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "y erenn hannd paa mig thencker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "baade offthe och ydellig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "hanns thienner saa will ieg leffue och død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "och alderig findis y suig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": ":: Aha, huor sielden bliffuer the aff hierttet glad, ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": ":: som giernne thill-sammen were will, ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": ":: och maa dog skiellis att. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "O du, min allerkieriste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "giff hielp och radt ther-thill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "at wij thill-sammen maa bliffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "om Gud thet saa haffue will;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "ther-thill stannder ald min werdsens begier",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "ald thennd stund ther mig windis liff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "O du, min allerkieriste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "luck op din throfast hiertte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "och luck thu mig ther-inde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "lad mig aldrig bliffue forglempt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "thj huos dig min all-enneste allerkierste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "att bliffue euindelig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "ther-thill stannder ald min werdsens beger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "ald thennd stund ther mig windis liff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Thenne wisze will ieg ether skencke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "for aldt thend stund ieg er ether thro kier",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "alle fruer och iomfruer thill wilge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "thieris thienner saa will ieg werre thro;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "och alderig paa ett øge-blick",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "mit hierthe io paa hinde thencker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": ":: Aha, huor sielden bliffuer the aff hierthet glad, ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": ":: som giernne thill-samen bliffue will; ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": ":: och maa dog skillis adt. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}