  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Digte",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1803,
    "url": "https://tekstnet.dk/books/oehlenschlaeger-a_digte/003/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "See Nordlys lue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "med röde Flammer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "paa sorten Bue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Hör Storme brage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "og Granestammer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "bugnende knage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Niords Sönner<button id=note1 type=button class=\"btn btn-outline-secondary btn-sm comment\" data-container=body data-toggle=popover data-template=\"<div class='popover' role='tooltip'><div class='arrow'></div><h3 class='popover-header'></h3><div class='popover-body'></div></div>\" data-placement=auto data-html=true data-content=\" <p>Stormene</p> \" data-title=\" Fodnote 1\">F1</button> sig hæve.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Snefunker, Stierner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "bleglyse bæve;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "og intet værner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "for Stormens Vælde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "paa Norges Fielde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Svanhild den hvide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "fortvivlet ene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "ved Midnatstide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "blandt Krat og Grene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "vildfaret vanker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "i Nattens Taage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "med bange Tanker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "hvor Aander vaage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "Brat Stormen standser,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "ei Graner brage;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "men Stene knage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "og Fieldets Pandser",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "hvinende brister,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "og grim og bister",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "af mörke Hule",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "en Fin sig hæver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "saa det natlige Thule",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "sukkende bæver.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "»Hvo tör sig vove",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "i mörke Nætter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 0,
      "text": "til sorte Skove,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 0,
      "text": "hvor höie Jetter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 0,
      "text": "naar Hanen galer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 0,
      "text": "i Mörket suse,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 0,
      "text": "som naar uhyre Hvaler",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 0,
      "text": "under Ishavet bruse.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 0,
      "text": "Naar Urner bæve",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 0,
      "text": "i Dödningstunden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 0,
      "text": "naar Aander sig hæve,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 0,
      "text": "naar Ulve i Lunden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 0,
      "text": "Offerne sluge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 0,
      "text": "naar gamle Drager",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 0,
      "text": "i Mulmet ruge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 0,
      "text": "naar Samvittighed nager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 0,
      "text": "naar Uskyldige græde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 0,
      "text": "naar Morderen antaster,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 0,
      "text": "og Natten sit Klæde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 0,
      "text": "over Bloddampen kaster?«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 0,
      "text": "Med röde Öie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 0,
      "text": "i skumle Pande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 0,
      "text": "han speider nöie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 0,
      "text": "blandt Granevrimlen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 0,
      "text": "overalt han skuer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 0,
      "text": "kun ei til Himlen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 0,
      "text": "hvor Nordlyset luer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 0,
      "text": "Med lumske Blikke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 0,
      "text": "han frem sig skyder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 0,
      "text": "af Klippens Bugter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 0,
      "text": "med lodne Fod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 0,
      "text": "»Mig lyster at drikke!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 0,
      "text": "saa Stemmen lyder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 0,
      "text": "»Jeg lugter, jeg lugter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 0,
      "text": "Menneskeblod!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 0,
      "text": "Og til den zittrende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 0,
      "text": "Möe han haster.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 0,
      "text": "Hans Öie knittrende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 0,
      "text": "vredeligt kaster",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 0,
      "text": "et Blik paa den Hulde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 0,
      "text": "men strax det mildes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 0,
      "text": "ved hendes Tække",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 0,
      "text": "det brat forvildes;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 0,
      "text": "og Vellystluer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 0,
      "text": "af Sövn sig vække.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 0,
      "text": "De brænde fulde –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 0,
      "text": "og Svanhild gruer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 0,
      "text": "»Frygt ei du Bolde!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 0,
      "text": "saa sledsk han taler,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 0,
      "text": "»over alle Trolde jeg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 0,
      "text": "strængt befaler.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 0,
      "text": "Fölg med i min Hule,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 0,
      "text": "hvor hundred Dverge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 0,
      "text": "smedde Armbaand gule",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 0,
      "text": "og Jetteværge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 0,
      "text": "Hvor Guld hin röde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 0,
      "text": "i Fieldets Aarer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 0,
      "text": "straaler dig imöde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 0,
      "text": "glem dine Taarer!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 0,
      "text": "»O stærke Jette!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 0,
      "text": "hvis Kraft du eier,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 0,
      "text": "da viis din Vælde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 0,
      "text": "i Dydens Seier;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 0,
      "text": "og dræb min Smerte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 0,
      "text": "og bring mig Arme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 0,
      "text": "til Haralds Hierte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 0,
      "text": "dæmp Nattens Harme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 0,
      "text": "Os Mulm adskilled.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 0,
      "text": "Som jeg den Bolde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 0,
      "text": "er nu forvildet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 0,
      "text": "blandt Mörkets Trolde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 0,
      "text": "»Jeg eier Skatte!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 0,
      "text": "det skal du sande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 0,
      "text": "I Guld vil jeg fatte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 0,
      "text": "din Haralds Pande;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 0,
      "text": "deraf vi ville",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 0,
      "text": "vort Fæstensöl drikke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 0,
      "text": "alt efter gamle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 0,
      "text": "Biergtroldeskikke.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 0,
      "text": "Ung Svanhild blegner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 0,
      "text": "og skielver saare;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 0,
      "text": "til Jorden hun segner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 0,
      "text": "med tunge Taare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 0,
      "text": "Med nedrig Skulen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 0,
      "text": "og grinende Læber,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 0,
      "text": "han need i Hulen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 0,
      "text": "den Blege slæber.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 0,
      "text": "Hun zittrer, vakler,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 0,
      "text": "og Angsten stiger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 0,
      "text": "I mörke Gange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 0,
      "text": "med blide Toner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 0,
      "text": "hun hörer Sange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 0,
      "text": "af Kiempekoner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 0,
      "text": "Og see, med Fakler",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 0,
      "text": "ti skiönne Piger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 0,
      "text": "sig nærme blide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 0,
      "text": "guldlokte, hvide;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 0,
      "text": "hver yndigt smiler,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 0,
      "text": "bort Mörket iler.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 0,
      "text": "Og stolt sig löfter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 0,
      "text": "de höie Sale;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 0,
      "text": "i Klippeklöfter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 0,
      "text": "Rubiner prale;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 0,
      "text": "stærkt Guldet glimter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 0,
      "text": "i Fieldets Side,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 0,
      "text": "mildt Sölvet skimter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 0,
      "text": "i Marmor hvide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 0,
      "text": "Og Lyset flammer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 0,
      "text": "og Mörket viger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 0,
      "text": "og i et Kammer tre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 0,
      "text": "andre Piger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 0,
      "text": "en Klædning væver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 0,
      "text": "saa riig og prægtig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 0,
      "text": "af Guld saa vægtig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 0,
      "text": "Men Svanhild bæver.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 0,
      "text": "»See, raaber Jetten,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 0,
      "text": "dit Bryllups-Klæde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 0,
      "text": "Glem ham paa Sletten",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 0,
      "text": "Hvor kan du græde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 0,
      "text": "Snart er den færdig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 0,
      "text": "Kom lad os ile.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 0,
      "text": "Du er mig værdig;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 0,
      "text": "fölg med til Hvile!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 0,
      "text": "Hvor Roser dufte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 0,
      "text": "hvor Harper lyde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 0,
      "text": "hvor Æthre lufte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 0,
      "text": "der skal du pryde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 0,
      "text": "det stolte Leie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 0,
      "text": "Mit Hierte raser!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 0,
      "text": "Jeg vil dig eie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 0,
      "text": "trods alle Aser.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 0,
      "text": "Hvad Vælde bruser?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 0,
      "text": "Hvad rædsomt Bulder?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 0,
      "text": "See Lynild suser,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 0,
      "text": "hör Torden ruller!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 0,
      "text": "og Stormen skriger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 0,
      "text": "og hylende viger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 0,
      "text": "bort Natten iler",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 0,
      "text": "og Solen smiler.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 0,
      "text": "Fra Himlens Bue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 0,
      "text": "ved Hlidskialfs Lue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 0,
      "text": "saae Asa Odin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 0,
      "text": "den Ædles Taare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 0,
      "text": "Han greb sit Septer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 0,
      "text": "og ynktes saare;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 0,
      "text": "og raabte: »Aukathor!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 0,
      "text": "tag din Hammer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 0,
      "text": "Dræb Nattens Mörke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 0,
      "text": "med Dagens Flammer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 0,
      "text": "Og fæld din Fiende!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 0,
      "text": "og kiöl min Harme!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 0,
      "text": "frels ham og hende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 0,
      "text": "i Guddoms Arme!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 0,
      "text": "Og Thor adlyder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 0,
      "text": "Ha blegn Uhyre!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 0,
      "text": "Med sine Bukke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 0,
      "text": "han Skyen bryder;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 0,
      "text": "og Tömmerne styre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 0,
      "text": "mod Uskylds Sukke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 0,
      "text": "Da seer han Harald",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 0,
      "text": "blandt Granestammer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 0,
      "text": "at söge Svanhild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 0,
      "text": "med Elskovs Jammer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 0,
      "text": "Hans Hierte bæver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 0,
      "text": "hans Öie flammer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 0,
      "text": "hans Röst sig hæver:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 0,
      "text": "»Hvor er du Svanhild?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 0,
      "text": "O svar mig Svanhild!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 0,
      "text": "Forgieves raaber,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 0,
      "text": "forgieves haaber",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 0,
      "text": "Midnattens Vandrer!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 0,
      "text": "»Der er min Hammer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 0,
      "text": "Red selv din Pige!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 0,
      "text": "Naar vist den rammer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 0,
      "text": "maa Livet vige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 0,
      "text": "Gaae need i Hulen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 0,
      "text": "hvor Steen sig hvælve,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 0,
      "text": "i Röverkulen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 0,
      "text": "Men ei du skielve.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 0,
      "text": "Naar Hiertet bæver",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 0,
      "text": "og frygtsomt bruser,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 0,
      "text": "Miölner sig hæver",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 0,
      "text": "og Panden knuser.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 0,
      "text": "Hammeren kræver",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 0,
      "text": "med roligt Mod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 0,
      "text": "at farves i Troldenes",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 0,
      "text": "Hierteblod!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 0,
      "text": "»Tak! raaber Harald,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 0,
      "text": "min Harm jeg kiölner.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 0,
      "text": "Og rask han griber",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 0,
      "text": "den store Miölner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 0,
      "text": "og rolig iler",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 0,
      "text": "hen til de Steder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 0,
      "text": "hvor Trolde hviler",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 0,
      "text": "og Svanhild græder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 0,
      "text": "I mörke Gange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 0,
      "text": "med fæle Toner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 0,
      "text": "han hörer Sange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 0,
      "text": "af Jettekoner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 0,
      "text": "Og uforfærdet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 0,
      "text": "han skuer Trolde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 0,
      "text": "at slaae med Sværdet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 0,
      "text": "paa Flinteskiolde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 233,
      "stanza_id": 0,
      "text": "hvoraf udspringer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 234,
      "stanza_id": 0,
      "text": "saa store Gnister,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 235,
      "stanza_id": 0,
      "text": "at Hulen stundum",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 236,
      "stanza_id": 0,
      "text": "sit Mörke mister.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 237,
      "stanza_id": 0,
      "text": "Ham Væggen trænger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 238,
      "stanza_id": 0,
      "text": "saa skarp og snæver.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 239,
      "stanza_id": 0,
      "text": "Fieldstykker som hænger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 240,
      "stanza_id": 0,
      "text": "i Loftet, bæver.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 241,
      "stanza_id": 0,
      "text": "Og Blod hin röde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 242,
      "stanza_id": 0,
      "text": "af uhevnede Döde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 243,
      "stanza_id": 0,
      "text": "af Sprækkerne rinde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 244,
      "stanza_id": 0,
      "text": "og Lyn ham blinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 245,
      "stanza_id": 0,
      "text": "os Drager i Tidsler",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 246,
      "stanza_id": 0,
      "text": "forbi ham hvidsler.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 247,
      "stanza_id": 0,
      "text": "Men rolig Harald",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 248,
      "stanza_id": 0,
      "text": "med Gudens Hammer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 249,
      "stanza_id": 0,
      "text": "til Maalet haster,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 250,
      "stanza_id": 0,
      "text": "han veed den rammer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 251,
      "stanza_id": 0,
      "text": "Og Lynet luer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 252,
      "stanza_id": 0,
      "text": "med blodige Flammer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 253,
      "stanza_id": 0,
      "text": "og i et Kammer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 254,
      "stanza_id": 0,
      "text": "hvor Mörket svinder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 255,
      "stanza_id": 0,
      "text": "han rolig skuer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 256,
      "stanza_id": 0,
      "text": "tre Jetteqvinder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 257,
      "stanza_id": 0,
      "text": "Uden Been i Ryggen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 258,
      "stanza_id": 0,
      "text": "de krummede bæve",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 259,
      "stanza_id": 0,
      "text": "paa Jernstole,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 260,
      "stanza_id": 0,
      "text": "og spole og væve",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 261,
      "stanza_id": 0,
      "text": "med mavre Arme,",
      "part": false,
      "marginal_notes": []
    },
    {
