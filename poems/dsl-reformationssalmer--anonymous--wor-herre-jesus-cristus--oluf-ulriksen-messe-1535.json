  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "WOr herre Jesus Cristus",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "y den nat der han bleff forraad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "tog han brød tackede oc brød det",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "oc gaff sine discipler oc sagde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "tager det hæn oc æderidt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "det er mytt legomme som bliffuer giffuit for eder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "det gører y myn hukommelse.",
      "part": false,
      "marginal_notes": []
    }
  ]
}