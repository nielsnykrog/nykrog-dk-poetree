{
  "id": null,
  "title": "Sang ved Fru Malle Drewsens Fødselsfest paa Silkeborg, den 5te August 1853",
  "year_created": 1853,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
