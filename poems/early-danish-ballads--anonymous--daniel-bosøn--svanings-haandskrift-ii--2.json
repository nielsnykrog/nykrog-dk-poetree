    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVII9.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Danil Bosen hand er en edeling",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "baade til steffne oc saa til ting.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Daniel hand lader en snecki bo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Oc det vaar iet. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Daniel hand lader en snecki bo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "hand siger, hand vil en reffuer vorde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Oc Daniel lader en snicki giør.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Daniel lader en snecki giøre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "hand siger, hand vil strid med vor dannekongen føre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Kongen rider til lands-ting.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "Kongen rider til lands-ting,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "hand biuder ud de Dane-leding.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Biuder hand ud fire, oc biuder hand ud fem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "Biuder hand ud fire, oc biuder hand ud fem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "effter Daniel Bossen vilde hand haffue dem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "\"Huilcken aff disse kongens mend mig Danil kand slaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "Huilcken aff disse kongens mend mig Danil kand faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "hannem skal jeg giffue huer pending gods, hand aa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "Bort da rider the rider ti, ridder vaar de ni.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 6,
      "text": "Bort da rider de ridder thi, ridder vaar de ni,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "effter Danil Bossøn da lette de.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 6,
      "text": "De rider ti kom riden i gaard.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 7,
      "text": "De ridder de kam der ridende i gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "ude stod frue Margret, hun vaar vel suøbt i mord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 7,
      "text": "\"I vere vel-kommen, i kongens mend, hiem til min.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 8,
      "text": "I være vel-kommen, i kongens mend, hiem til min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 8,
      "text": "huad heller vil i haffue miød, eller i vil dricke vin?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 8,
      "text": "\"Icke er oss om miød, icke heller om vin.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 9,
      "text": "Oss er icke om miød, icke heller om vin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 9,
      "text": "wi leder effter Danil Bosøn, søne din.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 9,
      "text": "\"Daniel er aff badstue mod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 10,
      "text": "Daniel handt er aff badstuen mod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 10,
      "text": "hand huilis i vort høye-lofft paa en seng saa god.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 10,
      "text": "Støtte de paa dørren met glauende oc met spiud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 11,
      "text": "Støtte de paa dørren met glauend oc met spiud:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 11,
      "text": "\"Stat op, Danil Bossen, oc gack i gaarden ud!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 11,
      "text": "\"I danne-suenne, hui lader i nu saa?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 12,
      "text": "I danne-suenne, hui lader i nu saa?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 12,
      "text": "ieg vil i gaarden til eder gaa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 12,
      "text": "Danil hand ud aff dørren løb.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 13,
      "text": "Danil hand ud aff dørren løb,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 13,
      "text": "sin god suerd hand for sig bød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 13,
      "text": "Daniel hand tog bast oc bond.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 14,
      "text": "Daniel hand tog bast oc baand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 14,
      "text": "saa bandt hand de ridder ni met sin egen haand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 14,
      "text": "Giorde hand det oc kap, oc giorde hand det aff roess.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 15,
      "text": "Giorde hand det aff kap, oc giorde hand det aff roess,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 15,
      "text": "hand lagde dem i sin moders karm, oc selff rider hand der-hoss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 15,
      "text": "Hand førde dem til Helsingborg vor dannekong imod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 16,
      "text": "Førde hand dem til Helsingborge vor dannekong imod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 16,
      "text": "Kongen hand ud att vinduet saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 16,
      "text": "\"Hisset seer ieg Danil Bossen met alt det gods, hand aa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 16,
      "text": "Danil hand veffter met sin hat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 17,
      "text": "Danil hand veffter met sin hat:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 17,
      "text": "\"Nei men, danne-kongen, i siger icke sant.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 17,
      "text": "Her haffuer i de golte ni.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 18,
      "text": "Her haffuer i de golte ni,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 18,
      "text": "oc reder eder paa en stercker sti oc setter dem der-i.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 18,
      "text": "Kongen gick til karmen, oc ind hand saae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 19,
      "text": "Kongen gick til karmen, oc ind hand saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 19,
      "text": "ni aff hans ridder bonden laa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 19,
      "text": "\"I wansøles mend, hui ligger i nu saa?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 20,
      "text": "I vansøles mend, hui ligger i nu saa?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 20,
      "text": "Danil hand skal haffue huer pendings gods, i aa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 20,
      "text": "Danil skal vere min gieffuiste suend.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 20,
      "text": ":: Oc det vaar iet. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}