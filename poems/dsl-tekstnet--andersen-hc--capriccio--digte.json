    "url": "https://tekstnet.dk/books/andersen-hc_digte-1830/032/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Et Speil er Søens Flade, det er saa smuk en Dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Og Skibene er pynted’ med alle Deres Flag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Hør Damp-Maskinen larmer og lysteligt det gaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "En lang og skumhvid Fure bag efter Skibet staaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "See Røgen hvor den bølger, det er en kulsort Sky,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Den skjuler reent os Broen hist ved den store By.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Saa skumhvid svulmer Søen mod Skibets stærke Bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Og deiligt for os ligger den grønne Sommerkyst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "De Fleste passiare paa denne raske Fart,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Men Andre sidde blege, og har det ei saa rart.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "– Hist seer jeg Baaden komme, nu sættes vi i Land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Saa sværmer man i Skoven og drikker Kilde-Vand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Her er saa smukke Damer, saa mange Dyr at see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Der synges og der spilles, og alle Godtfolk lee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "– Men Byens Fugle støie dog fælt bag Skovens Hang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Thi gaaer man dybt i Skoven sin egen stille Gang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Hist reiser sig en Landsby, see Kirken ligger smukt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Fra Søen har man Udsigt hen over Søens Bugt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Ved Kirkeporten seer jeg den hele Ungdom staae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "De Bønderpiger knixe, de store med de smaae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "Med Grønt og Blomsterkrandse er Kirken pyntet smukt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "Og Altar-Lys der tændes, som aldrig før er brugt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "Den gamle Jomfrue smiler, hun synes saa tilfreds,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "Skjøndt Brudgommen er ældre, thi hun er knap de Treds.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "Hør Degnen synger lifligt ved denne skjønne Pagt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "Nu kjøre De til Hjemmet, De er’ saa vel ved Magt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "Foran med Violiner de Spillemænd man seer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "Brudgommen længe smiilte, nu kan han ikke meer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "Han nikker og han sover, og Bruden seer derpaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "Sødt Turtelduer kurre og næbbes i det Blaae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "Den glade Brudgom drømmer vist deiligt om sin Brud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "Mens Skovens Træer dufte, og Blomster springe ud.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
