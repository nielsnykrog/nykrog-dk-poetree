{
  "id": null,
  "title": "Mø værger Æren",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift I",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVI81.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Stalt Ingelille sporde moeder sin:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": ":: For-glem ichi mig! ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "\"Maa ieg gaa till weckte i nat?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Hun traad herrlig. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "\"Huad vilt du ad vecktit i nat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "men der er huerchen søster eller broder!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Du haffuer ichi broder uden en,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "min kiere datter, bliff hieme!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "Saa lenge daa bad den iomfru fyn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "hun vill ichi tro den ferie-mand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 5,
      "text": "Hun tog sielff oren i sin hand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "hun ville ichi tro den ferie-mand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 6,
      "text": "Der hun kom till Tørssøø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "der gich en dands met fruer och møer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 7,
      "text": "Rider och suenne beginte en dantz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "stalt Ingelill saatte sig, hun giorde en krandz.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 8,
      "text": "Meltte det Turi under øø:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "\"Huem skall haffue den krands, du giør?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 9,
      "text": "\"Ieg giør ichi krands till anden mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "end till min broder, ieg vell vndt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 10,
      "text": "\"Inger lillele, om dig tychi",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 10,
      "text": "y afften vill ieg till ditt bure gaa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 11,
      "text": "\"Du tør ichi gaa till bure min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 11,
      "text": "ieg lader ryder ichi y afften ind.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 12,
      "text": "Inger-lille suøber sig y skiend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 12,
      "text": "saa gaar hun til broder sin.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 13,
      "text": "\"Hør du, her Peder, kiere broder din:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 13,
      "text": "y afften daa hielp du søster din!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 14,
      "text": "\"Ieg skall dig hielpe, ieg skall dig fry,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 14,
      "text": "skulle dit ind koste mit unge liff.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 15,
      "text": "Syldig om afften, røg full oe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 15,
      "text": "her Thure glemte ychi, huort hand ville gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 16,
      "text": "Hand met sig di ryder nye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 16,
      "text": "till Inger-lellis bure saa gange di.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 17,
      "text": "Først tog hand ny, saa tog hand fem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 17,
      "text": "till Inger-lillis bure gich hand met dem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 18,
      "text": "Hand klapitt paa døren under skiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 18,
      "text": "\"Du stadt op, Inger-lille, lad mig ind!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 19,
      "text": "\"Ingen haffuer ieg støffuen sat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 19,
      "text": "oc ingen lader ieg ind om natt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 20,
      "text": "\"Wiltu, Inger-lille, lade mig ind?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 20,
      "text": "ieg haffuer ichi uden min liden smaa-dreng.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 21,
      "text": "\"Ere i ene, och ere y tho,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 21,
      "text": "y aff afften skall y ude staa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 22,
      "text": "\"Wiltu ichi till døren gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 22,
      "text": "daa vill ieg døren offuer dig slaa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 23,
      "text": "\"Hør du, her Peder, broder min:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 23,
      "text": "stadt op oc hielp du søster din!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 24,
      "text": "Her Peder tog huassit suerd y hand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 25,
      "text": "hand kund ichi sye sit egit blod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 26,
      "text": "Her Peder hand kaste suerd aff hand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 26,
      "text": "\"Hielp dig, søster, om du kandt!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 27,
      "text": "Inger-lille tog suerd y hand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 27,
      "text": "saa gaar hun i døren at stande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 28,
      "text": "Stalt Ingelill hog, til hun vor mod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 28,
      "text": "hun stod y femtens ryders blod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 29,
      "text": "Saa sore mone hun kuide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 29,
      "text": "den tid hun klede sin broders lig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 30,
      "text": "Den iomfru luchte sin loffuis dør,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 30,
      "text": "hun gich y seng, som hun giorde før.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 31,
      "text": "Der kom rydende offuer kongens boer:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 31,
      "text": "\"Paa Tørssø er stoit saa stoert yt mord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 32,
      "text": "Paa Tørssø er stoer kuide:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 32,
      "text": "wyet saa er di ryder ny.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 33,
      "text": "Kongen slog sin hand mod bord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 33,
      "text": "\"Huem haffuer giort den unde mord?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 34,
      "text": "\"Døde er ny, och døde er fem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 34,
      "text": "saa skøn en iomfru haffuer wyet dem.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 35,
      "text": "Kongen hand melte it ord met kuide:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 35,
      "text": "\"Den iomfru fører i fangen hid!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 36,
      "text": "Kongens mend kom rydendis y giorde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 36,
      "text": "ud stod iomfruen, vor suøbt y mord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 37,
      "text": "\"Her stander y, iomfru fauer och fin!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 37,
      "text": "y afften skall y min herre finde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 38,
      "text": "Huad heller vill y eder fangen giffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 38,
      "text": "heller y vill till kongen ride?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 39,
      "text": "\"Iche vill ieg mig fangen giffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 39,
      "text": "saa vell tør ieg till kongen ryde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 40,
      "text": "Iomfruen ind att døren trend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 40,
      "text": "recher hun kongen sin huide hand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 41,
      "text": "\"Hør y, iomfru fouer och fyn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 41,
      "text": "hui haffuer y wyett saa mange kiemper min?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 42,
      "text": "Uden troldom dytt icki vere kand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 42,
      "text": "y wyett saa mangen erlige mand.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 43,
      "text": "\"Troldom ieg aldrig nam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 43,
      "text": "ieg slog dem met dragit suerd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 44,
      "text": "Di kom ichi met ander sag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 44,
      "text": "end di ville mig met vollen tage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 45,
      "text": "I ere en koning alt saa riig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 45,
      "text": "y skulle forsuare mig och mine lige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 46,
      "text": "Dit giorde mig y min hoff saa mod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 46,
      "text": "min broder loe alt for min fod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 47,
      "text": "Haffde di end verit en thid ny,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 47,
      "text": "ieg skulle lige saa haffue veyet di.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 48,
      "text": "Kongen klapit hende vid huiden kind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 48,
      "text": "\"Saa vist er y en iomfru fyn!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 49,
      "text": "Den iomfru gred och ichi før daa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 49,
      "text": "der hun skulle till skriffte gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 50,
      "text": "Hun fich ichi fredag at faste uden en,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 50,
      "text": "for di vor alle volds-mend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 51,
      "text": "Inger-lille red aff kongens gaard",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 51,
      "text": "med høge guld-krune och udslagit hoer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 52,
      "text": "Med høge guld-krune och udslagit hoer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 52,
      "text": ":: Forglem ichi mig! ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 52,
      "text": "hinder bad en ryder aff kongens gaard.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 52,
      "text": ":: Oc hun trod herlig. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}