  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Tha Frode, myn fadher, døder waar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc laffdher nøth i mwldhe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "ieg enæstæ Danmarks krone baar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "the ængelskæ meg wndhfwldhe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "i hundrede aar oc meræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Men meg vndfwldhe the tha plath",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "the willæ aar ey skatthe fleræ.",
      "part": false,
      "marginal_notes": []
    }
  ]
}