  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Orbe michi dudum decus extitit atque potestas.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Tu, mors, me nudum reddas, modo nil michi prestas.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "I wærdhen war ieg en mechtugh mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "allæ mwnæ mig neyæ och bwæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Blant herrer och førsther sadh ieg til bordz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "meth them at talæ kom ieg til ordz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "hwad kan thet mig nu dwæ?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "han tagher meth sig stoldbrødræ siw,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "gesthæ willæ the mig allæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Then førsthæ er sorg oc hoffuitwærck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "ieg worder wanmechtug som førræ war stærck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "Ieg kan ey thalæ for siwgdoms wee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Ihesum schal ieg meth øghnæ see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "och Dieffuelen stander til redhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Mynæ synder æræ manghæ, swo naadhæ migh Gwd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "ieg kan nept fly hanss wredhæ.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
