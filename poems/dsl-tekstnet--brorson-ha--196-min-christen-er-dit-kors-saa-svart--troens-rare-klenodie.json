  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Min christen, er dit kors saa svart",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Og af den allerhaardest art,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Lad dog dit taal ey svinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Troe, kiere siel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "GUd vil dig vel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Det skal du vist befinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Skal du bedrøved og forsmaaed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Foruden hielp og trøst og raad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Paa korsets bierg opstige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Græd eller lee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Det maa dog skee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Vil du til himmerige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Om GUd dig end saa heftig slog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "At du paa alting skade tog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Vær frisk, og troe kun sikker;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Hand drager dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Kun nær til sig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Med korsets baand og strikker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Umuelig man med verden paa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Sin ryg kand ind i himlen gaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "Og dertil holdes værdig;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Det vil hand da",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "Dig tage fra,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Saa est du reyse-færdig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Gaaer du med korset trøstig frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 4,
      "text": "Saa bærer korset selv dig hiem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 4,
      "text": "Til evig fryd og ære;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 4,
      "text": "Men vil du ey,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Saa vil din vey",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "Dig dobbelt piinsom være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 5,
      "text": "Kand du dig selv kun blive qvit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 5,
      "text": "Forsage alting, stort og lidt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 5,
      "text": "Saa har du veyen fundet;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 5,
      "text": "Giv dig deri,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 5,
      "text": "Saa est du fri,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Saa har du overvundet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 6,
      "text": "Fat dig kun et bestandigt sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 6,
      "text": "Lad blæse hvad der vil for vind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 6,
      "text": "At rosen-krands og nelder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 6,
      "text": "At suur og sød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 6,
      "text": "At liv og død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 6,
      "text": "Dig lige meget gielder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 7,
      "text": "Kors var et sværd i JEsu haand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 7,
      "text": "Den tiid hand bandt den onde aand;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 7,
      "text": "Hvor kand det noksom prises?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 7,
      "text": "Der fattes seyr",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 7,
      "text": "I ingen leyr,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 7,
      "text": "Hvor korsets fane vises.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 8,
      "text": "Kors er den vey til himlens land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 8,
      "text": "Som ellers aldrig findes kand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 8,
      "text": "Den JEsus selv opsøgte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 8,
      "text": "Kun trøstig frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 8,
      "text": "Du JEsu lem!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 8,
      "text": "Du tørst dig aldrig frygte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 9,
      "text": "Kors er det tegn, der spørges om,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 9,
      "text": "Naar JEsus kommer til sin dom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 9,
      "text": "Hvo da vil staae med ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 9,
      "text": "Maa korsets tegn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 9,
      "text": "I jammers egn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 9,
      "text": "Og Bochims dale bære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 10,
      "text": "Ey nogen trængsel er saa lang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 10,
      "text": "Var hun end helved-heed og trang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 10,
      "text": "At den os kunde bide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 10,
      "text": "Naar vi kun til",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 10,
      "text": "GUds ære vil",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 10,
      "text": "Saa gierne noget lide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 11,
      "text": "Vor HErre strider ikke mod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 11,
      "text": "Dig selv, men mod dit kiød og blod;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 11,
      "text": "O maatte det forbrændes!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 11,
      "text": "Hvad kunde vi",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 11,
      "text": "Da vandre fri",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 11,
      "text": "I al den deel os hændes.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 12,
      "text": "Det eget sind, det satans frøe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 12,
      "text": "Skal plukkes, brændes op, og døe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 12,
      "text": "Som alt vort liv forvilder;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 12,
      "text": "Det kand ey skee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 12,
      "text": "Naar korsets vee",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 12,
      "text": "Os ey vor vellyst spilder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 13,
      "text": "Just derfor har vor frelser giort",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 13,
      "text": "Anviisning om den snevre port;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 13,
      "text": "Hvo denne vey vil tage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 13,
      "text": "Hand vandrer fri,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 13,
      "text": "Og kand forbi",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 13,
      "text": "Sig selv og verden drage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 14,
      "text": "I ham opstaaer et andet sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 14,
      "text": "Som stedse lystig kiger ind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 14,
      "text": "I det, som GUd behager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 14,
      "text": "Er lige glad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 14,
      "text": "Hvor, naar og hvad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 14,
      "text": "Vor HErre foretager.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 15,
      "text": "Ved kors gik JEsus ind til GUd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 15,
      "text": "Og giver os et HErre-bud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 15,
      "text": "At vi skal selskab giøre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 15,
      "text": "En hver, som vil",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 15,
      "text": "Ham høre til,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 15,
      "text": "Saa vil hand selv os føre.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
