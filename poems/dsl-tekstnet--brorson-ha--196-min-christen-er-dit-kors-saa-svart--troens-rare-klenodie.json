{
  "id": null,
  "title": "196. Min christen, er dit kors saa svart",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
