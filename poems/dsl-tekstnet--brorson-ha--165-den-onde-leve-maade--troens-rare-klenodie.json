  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Den onde leve-maade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Den kiødets gamle stiil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Om himlen og Guds naade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "At bære ingen tviil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Og dog foruden aand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Og kraft og lys saa sikker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "At gaae i satans strikker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Har taget overhaand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Hver følger kun sin vane,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Som hand har vant sig til,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Den gamle Adams bane",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Saa nødig slippes vil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Vil nogen vise vey,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Det med fortred kun høres,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Om endundskyldning giøres,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Betyder det dog ney.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Man taler om de gamles",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Maneer at vandre frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Man ønsker alt at samles",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "I døden kun med dem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Den ene synder paa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Den anden sig beraaber,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Naar disse himlen haaber,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Vil jeg den og vel faae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "O kiere siel, som vanker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "I verdens mørke om,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Og har saa ringe tanker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Om HErrens strenge dom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "O! tænk dig om engang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Og for Guds død og smerte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Leg denne sag paa hierte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "At evighed er lang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Hvor skal jeg, vil du sige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "Den rette vey forstaae?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "De lærde selv jo krige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "Og mod hverandre gaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "Een spender buen hart",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "Om Christi kors at bære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "En anden veed at lære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "En mildre leve-art.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "O siel! du ey est bunden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "Til nogens mund og pen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 5,
      "text": "Men selv randsag i grunden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 5,
      "text": "Den vey, hvor du gaaer hen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 5,
      "text": "I JEsu fodspor maa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "Dit liv og vandring være,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "Saa lyder JEsu lære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "Med hannem skal du gaae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "Her skal dit sind forandres",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 6,
      "text": "I bøn og kamp og striid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 6,
      "text": "Og anderledes vandres",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 6,
      "text": "End hid til denne tiid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 6,
      "text": "Din JEsu leve-art",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "Guds ord jo ikke dølger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "Saa lær, at du ham følger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "Oprigtig, frisk og snart.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 7,
      "text": "See nu, hvor heel ulige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 7,
      "text": "Hans levnet er med dit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 7,
      "text": "Du vil til ære stige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 7,
      "text": "I synden glædes frit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 7,
      "text": "I pragt og riigdom boe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 7,
      "text": "Hand flydde verdens ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 7,
      "text": "Hand vilde fattig være,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "Hand græd naar andre loe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 8,
      "text": "Den vey i synd at glædes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 8,
      "text": "Den satans egen stie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 8,
      "text": "Den vey skal ret begrædes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 8,
      "text": "Hver stund man gik deri,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 8,
      "text": "Det sorte helved-trav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 8,
      "text": "Som verden lystig render,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 8,
      "text": "Og sig i pølen ender,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 8,
      "text": "Den vey skal skaffes af.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 9,
      "text": "Far vel med dine gange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 9,
      "text": "Du vellyst-fulde vey!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 9,
      "text": "Lad andre paa dig prange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 9,
      "text": "Jeg siger evig ney,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 9,
      "text": "Din ende er for haard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 9,
      "text": "Jeg lystes ey at trine",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 9,
      "text": "Paa roser til den pine,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 9,
      "text": "Som ingen ende faaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 10,
      "text": "Far vel du brede stræde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 10,
      "text": "Du seer mig aldrig meer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 10,
      "text": "Bort syndig selskabs glæde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 10,
      "text": "Som i din jammer leer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 10,
      "text": "Du est mig alt for leed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 10,
      "text": "Lad andre tænke andet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 10,
      "text": "Jeg kalder dig forbandet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 10,
      "text": "Saa stor du est og bred.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 11,
      "text": "Dig, rette vey! jeg ynder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 11,
      "text": "Som gaaer til himlens land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 11,
      "text": "Paa dig jeg nu begynder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 11,
      "text": "At trine, hvad jeg kand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 11,
      "text": "At dræbe kiød og blod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 11,
      "text": "Og verdens lyst forsage;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 11,
      "text": "Og har det skiønt sin plage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 11,
      "text": "Saa er dog enden god.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 12,
      "text": "Velan I fromme hierter!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 12,
      "text": "Jeg følger eders trop",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 12,
      "text": "Igiennem mange smerter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 12,
      "text": "Til himlens glæde op,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 12,
      "text": "Lad møde hvad der maa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 12,
      "text": "Det har slet ingen fare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 12,
      "text": "Naar vi den ondes snare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 12,
      "text": "Kun ret forbi kand gaae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 13,
      "text": "O JEsu! see hvor farlig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 13,
      "text": "Er vores vandrings færd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 13,
      "text": "Hielp, at vi færdes varlig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 13,
      "text": "Og vær os altid nær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 13,
      "text": "Viis os, hvordan vi skal",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 13,
      "text": "I dine fodspor ile,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 13,
      "text": "Saa kand vi snart os hvile",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 13,
      "text": "I himlens brude-sal.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 14,
      "text": "Den snevre vey er bred nok til Guds rige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 14,
      "text": "Naar man gaaer sagte, lige, stille fort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 14,
      "text": "At hvert et trin forsigtig bliver giort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 14,
      "text": "Naar man har lært hen op at stige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 14,
      "text": "Saa er den vey og bred nok til Guds rige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 15,
      "text": "Vor HErres vey er fuld af lifligheder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 15,
      "text": "Naar man den har i troen rigtig kiendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 15,
      "text": "At hiertet er til veyen trøstig vendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 15,
      "text": "Naar man sig dertil ret bereder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 15,
      "text": "Saa er vor vey og fuld af lifligheder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 16,
      "text": "Hvor kand en biørn som lammet taalig være,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 16,
      "text": "Den vilde ulv vil nødig lukkes ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 16,
      "text": "Hvor kand vort kiød faae lyst til aandens sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 16,
      "text": "Og himlens rette fodspor lære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 16,
      "text": "Hvor kand en biørn som lammet taalig være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 17,
      "text": "Du maa først aand af aand ved ordet fødes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 17,
      "text": "Saa kandst du gaae den snevre livets gang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 17,
      "text": "Men ellers er din vey forgieves trang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 17,
      "text": "Dit falske sind det først maa dødes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 17,
      "text": "Du maa først aand af aand ved ordet fødes.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 18,
      "text": "Hvo fødselen af Christo først erlanger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 18,
      "text": "Hand følger og sin HErre trolig med,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 18,
      "text": "Hand lider først hans skændsel og fortræd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 18,
      "text": "Før hand med ham i lyset pranger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 18,
      "text": "Hand fødselen af Christo først erlanger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 19,
      "text": "Hand bliver med ham i hans død begraven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 19,
      "text": "I graven bliver til en tiid forvart,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 19,
      "text": "Staaer op, og holder saa sin himmelfart,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 19,
      "text": "Faaer aanden, som er fæstegaven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 19,
      "text": "Naar hand er først i døden med begraven.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 20,
      "text": "Den aand, som Christum drev, hans christne driver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 20,
      "text": "Den samme aand har altid samme skik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 20,
      "text": "De faae at gaae den samme vey hand gik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 20,
      "text": "Vel den, som det i hiertet skriver:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 20,
      "text": "Den aand, som Christum drev, hans christne driver.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 21,
      "text": "Og skal man skiønt i skarpe torne trine,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 21,
      "text": "Det stød og sting kun ind i hælen gaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 21,
      "text": "Er lideligt, giør ingen hierte-saar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 21,
      "text": "Naar man er taalig i sin pine,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 21,
      "text": "Om man end fik i helved-frygt at trine.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 22,
      "text": "Det lette aag kand ey for haardt besvære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 22,
      "text": "Det onde sind kun derved trykkes ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 22,
      "text": "Det tvinger kun din egenkærlighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 22,
      "text": "Naar man forstaaer det ret at bære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 22,
      "text": "Det lette aag kand ey for haardt besvære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 23,
      "text": "Det lette aag kand lette vore sinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 23,
      "text": "At hiertet sig til Gud oprette kand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 23,
      "text": "Og aanden ret faae luft i saadan stand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 23,
      "text": "At man Guds kierlighed kand finde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 23,
      "text": "Det lette aag kand lette vore sinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 24,
      "text": "Hielp JEsu! dig at følge allevegne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 24,
      "text": "Du seer, jeg gaaer endnu saa skrøbelig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 24,
      "text": "O! drag mig, at jeg frisk kand følge dig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 24,
      "text": "Saa skal mig sødhed nok begegne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 24,
      "text": "Hielp JEsu! dig at følge allevegne.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
