  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Manghen man thraar ath konningæ naffn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "och haffuer ther tijl stor løstæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Vthen han bære'th sith rigæ tijl gaffn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Saa lidheth wor ieg dweligh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "tha ieg skullæ Danmark styræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Thi maa ieg kendes thet blueligh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "ieg hættæ megh wedh then byræ.",
      "part": false,
      "marginal_notes": []
    }
  ]
}