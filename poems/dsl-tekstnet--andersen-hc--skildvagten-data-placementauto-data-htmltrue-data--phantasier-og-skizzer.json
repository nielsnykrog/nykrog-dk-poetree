{
  "id": null,
  "title": "Skildvagten \" data-placement=auto data-html=true data-content=\" Skrevet i Foraaret 1830. \" data-title=\" Fodnote 2\">F2",
  "year_created": 1830,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Phantasier Og Skizzer",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1830,
    "url": "https://tekstnet.dk/books/andersen-hc_phantasier-og-skizzer/023/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "»Lui, lui, et toujours lui.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 1,
      "text": "Aft’nen er taaget – døsigt Lygterne brænde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Kun paa sin Støi og sin Larm kan man kjende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Det store Paris.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Den brogede, larmende Vrimmel, paa Bølgernes Viis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Fremtrænger sig vildt gjennem Stræde og Gade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Hist staaer et Palads med pragtfuld Façade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Men kun svagt, gjennem Taagen, dæmrer den straalende Krands",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Af Lampernes flammende Glands.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Hvem er vel Eier af hiin Pragt, man seer?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "»,« man veed ei meer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Ved Porten staaer en Graaskjæg i Gevær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Han tjente engang i den store Keisers Hær, –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Forresten man om ham veed meget mindre;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Men saae man i den gamle Krigers Indre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Da for vort Blik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "En svunden Verden, stor og klar opgik.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "»Hvor underligt forandres Alt med Tiden!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "– Saa drømmer han. – »Her stod jeg just! dog, det er længe siden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Mit Bryst var fuldt af store Ungdoms Drømme;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Da bruste Blodet – ja, i vilde Strømme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Flød Frankrigs Blod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Men Friheds-Træet grønt og herligt stod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Og jeg var hærdet; nu jeg gammel er og blød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Toulon var Fjendens. Seier eller Død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Vi med vor yngste Officeer da svore,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Thi han – han var Napoleon den Store.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "– Med ham gik Frankrigs yngste Helte-Flokke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Hen over Alpelandets Kjæmpeblokke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Bestandigt opad, opad i den skarpe Vind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Som vilde vi i Himlen ind!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Han gik foran, vi fulgte Mand for Mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "Hvor før kun Mulen steeg paa Fjeldets Rand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "Og gjennem Iis og Snee og skarpe Vinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "Vi vidste Fjenden, og vor Seir at finde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "Der midt imellem Kamp og Dødens Flamme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "Han stod den Samme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "Skjøndt Kugler fløi om ham i Dagens Dyst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "»Om han blev dræbt!« – det gjøs i hvert et Bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "Thi Gud og han vor Tanke var i Leiren,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 3,
      "text": "Og begge gav os Seiren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "Hvor jublede jeg høit med Folke-Vrimlen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "Da Keiser-Navnet tonede mod Himlen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "– Smaae-Fuglene paa Fjeldets Tind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "Saae stolt til Konge-Ørnen ind;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 4,
      "text": "Da stormede vi gjennem Busk og Hække,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 4,
      "text": "Og Konger kaared’ han, hvis Kraft de vilde knække.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 4,
      "text": "Selv Havets Slange, skjøndt den bister lo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 4,
      "text": "Dog frygtet Konge-Ørnens stærke Klo;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 4,
      "text": "En evig Troskab, Venskab høit de svore,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 4,
      "text": "Og glemte dog saa snart den Eneste – den Store!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 5,
      "text": "Ud over Reden voxte det stolte Vinge-Par,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 5,
      "text": "For lidet ham det store Frankrig var;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 5,
      "text": "Han var Europas Helt – Europa var hans Rige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 5,
      "text": "Hans Stjerne kjendte kun, at synke, eller stige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "»Mod ! – Moskov!« høit han bød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 6,
      "text": "Men stolt det reiste sig i Flamme-Glød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 6,
      "text": "Kun Ild og Aske inddrak vore Lunger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 6,
      "text": "Til Bjerge svulmed’ Brandens røde Tunger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 6,
      "text": "Alt blev til Ild, selv Liget i sin Grav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 6,
      "text": "Og Lykkens Stjerne svandt i dette Flamme-Hav.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 6,
      "text": "– Hver Dag skjød Ruslands Jordbund Hære frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 6,
      "text": "Dog havde vi nok faaet Bugt med dem!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 6,
      "text": "Det Vintren var, og ei Kosakkens Landse,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 6,
      "text": "Der røved’ Frankrig sine bedste Krandse.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 6,
      "text": "Kun Iis og Snee stod for vort matte Blik;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 6,
      "text": "Ja Neglene fra Kjødet gik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 6,
      "text": "Mens Børn og Kvinder, Alt – dog taus jeg være maae;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 6,
      "text": "Hvad Øiet dengang saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 6,
      "text": "Tør nu mit gamle Hoved ikke tænke paa! –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 6,
      "text": "Jeg blandt de Saarede paa Vognen laae;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 6,
      "text": "Een Flod og Riger var imellem Fædrelandet;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 6,
      "text": "Stærk Strømmen gik, tynd Isen var paa Vandet;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 6,
      "text": "Hver Vogn, hver Hest vi synke saae;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 6,
      "text": "Kun enkelt kunde man hiin Side Bredden naae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 6,
      "text": "De matte Hænder vi fra Vognen strakte frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 6,
      "text": "Man saae det ei, thi »hjemad! hjem!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 6,
      "text": "Det lød, det trængte i mit Hjerte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 6,
      "text": "Jeg styrted’ mig fra Vognen i min Smerte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 6,
      "text": "Men Isen brast; – – dog Strømmen hæved’ atter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 6,
      "text": "– En Haand mig fatter –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 6,
      "text": "Det var Napoleons – Han var min Redningsmand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 6,
      "text": "Og jeg saae Frankrig, saae mit Fødeland.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 6,
      "text": "Fri stod jeg der, men ham man Haanden bandt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 6,
      "text": "Europas Sol bag Skove svandt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 7,
      "text": "Men synke kan ei det som Gud opreiser,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 7,
      "text": "Og Folket selv ham kaarede til Keiser;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 7,
      "text": "Der maatte til den hele Spurve-Vrimmel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 7,
      "text": "For at forjage Ørnen fra sin Himmel.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 8,
      "text": "Han kom – – mit Hjerte vilde mig af Barmen!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 8,
      "text": "Min Hustru holdt den Spæde frem paa Armen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 8,
      "text": "Velsignelse fløi fra hans Helte-Blikke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 8,
      "text": "Han kom igjen – han glemte Frankrig ikke!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 8,
      "text": "– Men Frankrig glemte ham – det gav ham bort til Havet;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 8,
      "text": "Ei Fædrelandet har sin første Helt begravet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 9,
      "text": "– Mod Fjeldet stolt den høie Bølge slaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 9,
      "text": "Men den er bristet længst, naar Fjeldet staaer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 9,
      "text": "Det synker ei, hvad engang Gud opreiser!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 9,
      "text": "Europa glemmer ei min store Keiser!« –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 10,
      "text": "Saadan den gamle Skildvagt drømmer nu.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 10,
      "text": "»Hvad græder Du? –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 10,
      "text": "Lidt vaade er de gamle Øienlaage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 10,
      "text": "Dog, det er mueligt Aft’nens kolde Taage ...",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 10,
      "text": "Tys, stille dog! glem nu den Store!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 10,
      "text": "Hist gaaer en lille Een med Sabel og med Spore,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 10,
      "text": "Derfor ei Mere!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 10,
      "text": "Husk, gamle Graaskjæg, Du skal presentere!«",
      "part": false,
      "marginal_notes": []
    }
  ]
}
