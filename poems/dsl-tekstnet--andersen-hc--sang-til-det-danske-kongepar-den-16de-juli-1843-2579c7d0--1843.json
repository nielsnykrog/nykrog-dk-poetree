    "url": "https://tekstnet.dk/books/andersen-hc_sang-til-det-danske-kongepar-den-16de-juli-1843/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "En Sang er kun en lille fattig Gave,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Men födt af Hjertet gjör den Hjertet godt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Den er en Natviol i Pragtens Have,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "En Fest-Bouquet i Hytte og i Slot,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Den er det milde Udtryk i et Öie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Der samler Ord og Villie til eet Heelt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Duft frisk vor Sang! dit Blomsterflor sig böie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Til Krandse mellem Kongeparret deelt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "I Hjertets Bog er mange tusind Blade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Gjem mellem disse af vor Blomst et Blad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Det vil erindre om en Skare Glade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Der under Sangen stille, trofast bad:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "»Gud styrk den Arm, som skjermer Danmarks Rige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Velsign det Hjerte, som for Danmark slaaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Ledsag dem Sundhed, underfulde Pige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Guds Sol jo skinner, hvor din Vinge naaer!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Nu reiser Kongeparret gjennem Landet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Thi sving dig, Sangfugl, i den milde Luft!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Glasklare Bölge, dands hen over Sandet!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Spred, vilde Rosentræ, din Æble-Duft!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "O Danmark, du er Mildheds sande Billed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Dog i een Sum dit hele Præg man har,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Det staaer i danske Hjerter klart opstillet:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "I danske Hjerter staaer et Kongepar!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
