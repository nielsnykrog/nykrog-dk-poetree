  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "HJelp Gud huor stoer er menniskens sorg oc nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "huem kan det alt fortelge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "plat ligger han vdi alle raad er død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "och ey wed sin elende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "hierte mod oc sind/ er slet forblint",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "forderffuit i alle maade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "kant sig inted till raade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "finder inted got/ holder det for spot/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Det Gud er kiert/ haffuer sig forført/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "mod all hans hellige vilge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "O herre Gud hielp oss dette iammer at stille",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Jngen ro paa iorden her han finde maa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "ingen mact kan hannem redde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "thi synden hannem formaledider saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "O Gud hielp her aff nøde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "til dig herre blid/ aff megen id/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "robe wi/ Du høgiste gode/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "begaffue oss met din naade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "naar døden kommer/ oss alle met kømer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "forraader han/ at ingen kan",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "din gunst oc naade foruerffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "O herre Gud/ lad oss icke saa forderffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Ach huad vor nu din wrede her saa grum/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "dine ord de laage forborgen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "men nu de giffue sine liud igen saa from/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "vil ingen nu mer sørge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "mand hører dem vel/ met christelig skel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "dog faa ville dem anamme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "oc sin ondskaff bekende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "det er bedre giort/ ey høre dine ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "end høre den saa/ der effter ey gaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "ach vor straff haffuer ingen maade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "O herre Gud/ skenck oss aff din gunst oc naade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "See til oss formedelst din kære Søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "som dig monne vel befalde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "Saa dyrt haffuer han oss købt til sig igen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "rigelig betalit alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "oc met sin død/ løst all vor nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "din naade vilde du oss skencke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "hans blod skal oss bestencke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 3,
      "text": "din vrede lad staa straffe oss ey saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 3,
      "text": "forget vor skyld/ och ver oss huld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 3,
      "text": "vor synd bekende wi alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 3,
      "text": "o herre Gud dine børn lad oss nu kalle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "Den stund du haffuer saa kortelig dine ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 4,
      "text": "sent oss igen paa iorden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 4,
      "text": "til trøst som vore aff dieffuelske skut formyrde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 4,
      "text": "lad oss nu fromme vorde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 4,
      "text": "det er i din mact/ er all vor act/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 4,
      "text": "ingen raad kunde wi fram lede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 4,
      "text": "wi ære vdi din vrede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 4,
      "text": "see icke til vor synd och skam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 4,
      "text": "men kend/ dit ord/ all naade haffuer giort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 4,
      "text": "thi det er menniske vordet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 4,
      "text": "O herre Gud lad det for oss haffue taalit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 5,
      "text": "Frøyde dig met snilhed/ du som est hans folk/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 5,
      "text": "forsmaat skalt du ey bliffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 5,
      "text": "men see at du ey plat forsige skalt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 5,
      "text": "den skat der i bliff hart/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 5,
      "text": "det gør oss ey ath wige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 5,
      "text": "Hues kraffter ære saa rige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 5,
      "text": "huor det er forset/ bliffuer det formeret/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 5,
      "text": "tro fast der paa/ Lad tuiffell gaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 5,
      "text": "sett haab till den her offuen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 5,
      "text": "O herre Gud/ til euig tid wi dig loffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 5,
      "text": "Amen",
      "part": false,
      "marginal_notes": []
    }
  ]
}