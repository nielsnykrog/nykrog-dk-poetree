    "year_published": 1562,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/LNGK7.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Miitt hiertte skall hosz hinde werre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "iegh loffuer thett paa minn ere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "thend stund iegh leffue maa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Iegh wiill hinnde Gudt befale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "thennd ene megh trøste skall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "hinnde haffuer iegh wduold for alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "wdj thenne iammer-dall;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "iegh hobis thennd dag att leffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "wÿ wiille tiill-sammenn bliffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "thennd klaffer tiill nid och had.",
      "part": false,
      "marginal_notes": []
    }
  ]
}