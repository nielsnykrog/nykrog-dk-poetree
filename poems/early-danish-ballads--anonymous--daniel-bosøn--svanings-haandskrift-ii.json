{
  "id": null,
  "title": "Daniel Bosøn",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift II",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVII66.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Daniel Boossen sieler att sundet frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hand sieler offuer konningens snecke-staffn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "\"Daniel Boessen, och du sieler alt for høyt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Och det vor eth. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Daniell Boossen, och du sieler alt for høyt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "men du skalt bliffue udi morgen oppaa sundet møtt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Daniel Boossen suarde icki verre end saa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Daniell Boossen suarde icke verre ind saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Fuld vell da maa hand søncke, som icke siele maa!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Och konningen rider til lands-ting.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "Kongen rider til landtz-ting,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "hand biuder udt Danne-leyding.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Hand biuder ud fire, hand biuder ud fem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "Hand biuder ud vel fire, hand biuder ud fem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "vel tredue riddermends-mend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "\"I skal ride mith erinde paa land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "I skall ride mith erinde bort op aff land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "och hente mig Daniel Boessen och saa hans ganger graa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "siden alt det godtz, Daniel Boosøn aa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 6,
      "text": "Den kongens mend komme der riddendis i gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "ude stodt stolt fru Mettelild, hun vaar vel suøbt i maard.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 6,
      "text": "\"Her staar i, stolte fru Mettelille, suøbt i maardt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 7,
      "text": "Her staar i, stolte fru Mette-lille, i ere vel suøbt i maard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "huor er Daniel Boossen och saa hans gangere graa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 7,
      "text": "siden alt det godtz, Daniell Boossøn aa?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 8,
      "text": "Daniel Boossen ligger i lofftit suøbt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 8,
      "text": "hand er nu nylig aff badstoffuen led.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 8,
      "text": "De støtte paa dørenn met glaffuend och spiudt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 9,
      "text": "De støtte paa døren met glaffuend och spiud:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 9,
      "text": "\"Vaag op, Daniel Boossen, du gack i gaarden udt!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 9,
      "text": "\"I danne-suenne, huii lader i saa?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 10,
      "text": "I danne-suenne, hui lader i saa?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 10,
      "text": "ieg vil gierne i gaarden til eder gaa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 10,
      "text": "Hand førde sig i sin skiorte, hand drog paa sine skoo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 11,
      "text": "Hand førde sig i sin skiorte, hand drog paa sine skoo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 11,
      "text": "thet vor it fuld-gott it suerd, hand neder aff kraagen drog.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 11,
      "text": "Daniel Boossen ud aff døren løb.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 12,
      "text": "Daniel Boossen udaff døren løb,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 12,
      "text": "thet vor it fuld-gaat it suerd, der hand ud for sig skød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 12,
      "text": "Først wog hand fire, saa vog hand fem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 13,
      "text": "Først vog hand fire, saa vog hand fem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 13,
      "text": "handt vogh vel tredue riddermendtz-mendt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 13,
      "text": "Daniell Boossen rørde sin gode suerd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 14,
      "text": "Hand giorde det icke aff brask, hand giorde det icke paa ross,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 14,
      "text": "hand lagde dennem i sin moders karm, och sielffuer rider hand hoss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 14,
      "text": "Daniel Boossen rider att gordet frem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 15,
      "text": "Konningen stod i hiffue-lofft, och sagde handt saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 15,
      "text": "\"Histe seer ieg Daniel Boossen och saa hans ganger graa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 15,
      "text": "siden alt det godtz, Daniel Boossen aae.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 16,
      "text": "Daniel Boossen veffter met sin hatt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 16,
      "text": "\"Hør i, dankongen, i siger nu usant.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 16,
      "text": "Daniel Boossenn rider i konningens gaardt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 17,
      "text": "Daniel Boosen ridder i kongens gaardt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 17,
      "text": "ud stod dan-kongen, hand vor suøbt i maard.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 17,
      "text": "\"Och her haffue i de galte IX.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 18,
      "text": "Her haffuer i de galte IX,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 18,
      "text": "er her sti til rede, som de skulle ligge udi?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 18,
      "text": "Konningen løffte op tielet, och under hand saa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 19,
      "text": "Konningen løffte op tielet, och under hand saae:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 19,
      "text": "\"Herre Gud naade ether fattige karle, som her ligger slagne oppaa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 19,
      "text": "En stund vor du min største uuenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 20,
      "text": "En stund vor du min største uuen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 20,
      "text": "men nu da skalt du vere min geuiste suendt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 20,
      "text": "Kongen thog Daniel Boossen i sin arm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 20,
      "text": ":: Och thet vor eth. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}