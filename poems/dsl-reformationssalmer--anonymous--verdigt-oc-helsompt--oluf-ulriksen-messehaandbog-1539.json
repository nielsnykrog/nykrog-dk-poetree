  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Verdigt oc helsompt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "ATt vy dig O herre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "altid oc alle steder høgtidelige begaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Oc io besynderlige paa denne dag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Der vor Poske er offredt vor herre Jesus christus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Dij han er det sande poskelam.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "som bortog aluertsens synder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "huilcken vid sin død allis vor død haffuer offueruundet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Oc i sin opstandelse liffuit haffver fornyet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Oc derfore ut supra Jn Prefatione natiuitatis christi",
      "part": false,
      "marginal_notes": []
    }
  ]
}