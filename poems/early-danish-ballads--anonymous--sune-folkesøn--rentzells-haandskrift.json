  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Kong Magnus vor kong y sueriig |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hand haffde de dather tho,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "thj vor thenum | bode lidell och vnng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "ther thennom fald | moder fraa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: der liger thj helle thieriis | Weÿ. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "De wor thennom bode ledell och vng",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "ther | thennom fald moder fra,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "theriis fader | voxste en gamell mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "wille icke for | riigen staa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": ":: der ligger dj helle theriis Weÿ | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Hør du stoltenn Elline",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "kiere dather min, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "giff du deg ÿ wride Closter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "for kiere | moder din,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": ":: d: lig: d. h. d w. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Du giffuer deg ÿ Closter Ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "altt mett din | silcke serck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "du bliffuer ther vdtagen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "mitt | stuor hiertte werck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": ":: d. l. d. h. th. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "Dett vor stoltenn Elin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "hun vogner | om midÿnatt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "aff sin stercke drøme |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "thennom siiger hun saa bratt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": ":: d. l d. h | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "Dett vor stoltenn Elin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "och siiger hun sin | drøm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "wogenn Laa den prijdijsze,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "hun | gaff thett well ÿ giøme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": ":: d l d. h. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "Miig tøgtt om den falcke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "och saa den | wilde walle raffuenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "thett will ieg for | sandingen siige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": "dj fløge altt wdj min | fagenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 6,
      "text": ":: d l d. h d. w. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "Miig tøgtt om dj falcke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 7,
      "text": "dj for østen fløg, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": "ieg frøcter ieg faar soriig ÿ hierttett | min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 7,
      "text": "hun gaais mig aldriig aff hue. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 8,
      "text": "Dett diig thøgtt att dj falcke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 8,
      "text": "och saa den | wilde walraffuen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 8,
      "text": "dett bliffuer her sonne | falckquorszen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 8,
      "text": "hand diig mett volden | tager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 8,
      "text": ":: d. l d. h. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 9,
      "text": "Alder skall sonne Falckquorszøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 9,
      "text": "och | aldriig faa myn thro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 9,
      "text": "ieg loffuer kongen | aff spanien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 9,
      "text": "mett altt thett guodz ieg aar |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 10,
      "text": "Thett vor stolstin Ellin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 10,
      "text": "hun skriff | the brieffue mett handtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 10,
      "text": "hun sender | thennom koning aff spanien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 10,
      "text": "de kome | her sonne till handtt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 11,
      "text": "Der ligger dj heliige theriis weÿ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 11,
      "text": "saa witt | offuer sueriigiis ledtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 11,
      "text": "saa ilde giorde | sonne Falckuorszen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 11,
      "text": "hand brød then | Iomffruis brieff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 11,
      "text": ":: d. l. d h. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 12,
      "text": "Dett vor herre sonne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 12,
      "text": "thaller thiill sin | broder, her Knud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 12,
      "text": "wÿ wiill riide aff | Landen wd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 12,
      "text": "dÿ redtt for den same slott |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 12,
      "text": "dÿ bød her Magnus wdtt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 13,
      "text": "De redtt for then same portt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 13,
      "text": "och riste dj | ÿ then Ring,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 13,
      "text": "du statt op guoden porthner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 13,
      "text": "och lad du osz her Indtt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 14,
      "text": "Suaritt den portener,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 14,
      "text": "och en aff kongens | mend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 14,
      "text": "Och kongen ligger ÿ helthrodtt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 14,
      "text": "hand thaller icke wed ether endtt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 15,
      "text": "Saa glad tha wor thi herer thoff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 15,
      "text": "ther dj | thren thiill thieriis hest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 15,
      "text": "Och ind skall | wÿ ÿ afftenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 15,
      "text": "then riige Iomffru giest. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 16,
      "text": "De red thennom att oplandtt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 16,
      "text": "att oplanden | Ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 16,
      "text": "thj red for then same Closter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 16,
      "text": "thj | ristide ÿ then ring, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 17,
      "text": "De red thenum tiill wridie kloster,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 17,
      "text": "thj | ristitt ÿ then ring,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 17,
      "text": "thu statt op guoden | porte piige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 17,
      "text": "och lad thu osz her Indtt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 18,
      "text": "Der dj kom ÿ kloster,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 18,
      "text": "altt ÿ den omgang | Indtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 18,
      "text": "ther møtte thenum liden thienist | piige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 18,
      "text": "hun vor suøbtt ÿ skindtt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 19,
      "text": "Hør du, lidenn thienist piige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 19,
      "text": "Och huad | ieg siiger thiig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 19,
      "text": "wiste du huor din | Iomffruur er,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 19,
      "text": "thu døll thett icke for | mig |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 20,
      "text": "Huszitt er aff malmerstien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 20,
      "text": "thagen | er aff blÿ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 20,
      "text": "sengen er mett silcke bredtt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 20,
      "text": "myn Iomffru soffuer wthj |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 21,
      "text": "Huem briide wriide kloster,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 21,
      "text": "och huem | gaar her indtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 21,
      "text": "huem slucker nattlius |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 21,
      "text": "altt offuer hin stoltte Elin |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 22,
      "text": "Her knud briider wriide kloster,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 22,
      "text": "tho | ridder ganger her indtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 22,
      "text": "sielff slucher | ieg her sonne nattliusz",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 22,
      "text": "offuer staltt Elin |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 23,
      "text": "Hand hug ther ÿ dage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 23,
      "text": "och hand hog ther | ÿ tho",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 23,
      "text": "icke kunde hand stolthen Elin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 23,
      "text": "for | hindis toffelsuene faa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 24,
      "text": "Icke kunde hand stoltte Elin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 24,
      "text": "faar hindis | toffelsuene faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 24,
      "text": "før hand hug denum | alle thølff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 24,
      "text": "wthj støcher smaa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 25,
      "text": "Saa snartt tha bliiff then dør",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 25,
      "text": "vdaff then | fengsiill løfftt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 25,
      "text": "saa snartt bliff stolthen Elin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 25,
      "text": "aff silckeseng røgtt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 26,
      "text": "Obenhoffuitt och barfoditt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 26,
      "text": "saa bliff hun | thagen aff dør,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 26,
      "text": "aldriig hørde ieg en | Konge barn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 26,
      "text": "saa wsell aff kloster | førdtt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 27,
      "text": "Dÿ waar samell ÿ aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 27,
      "text": "oc well ÿ aar | fem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 27,
      "text": "och icke wor hannom saa we eller | well,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 27,
      "text": "hun thalliit thiill hannom ÿ dem, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 28,
      "text": "Dÿ wor samell ÿ aare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 28,
      "text": "och fulle ÿ Aare | nÿ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 28,
      "text": "aller wor hannom saa we eller well |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 28,
      "text": "hun thalliit thiill hannom ÿ them |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 29,
      "text": "Dett vor stoltin Elin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 29,
      "text": "hun lagdiis ÿ stercken thro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 29,
      "text": "hun sender budtt effther her | sonne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 29,
      "text": "att hand schulle thiill hinde gaa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 30,
      "text": "Lenge stod herre soone,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 30,
      "text": "och tennckte handtt | wed siig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 30,
      "text": "och hui mon nu stoltenn Elin |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 30,
      "text": "sende budtt epther mig, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 31,
      "text": "Ind kom herre sone,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 31,
      "text": "och stedis hand for | bordtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 31,
      "text": "huad will ÿ mig, stolthen Eline |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 31,
      "text": "hui haffuer ÿ sendtt mig ordtt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 32,
      "text": "Ieg fangitt min helsoitt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 32,
      "text": "ieg wedtt, ieg schall | nu dødtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 32,
      "text": "ieg tacher gud fader ÿ himerig |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 32,
      "text": "der mig haffuer løst aff nødtt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 33,
      "text": "Hand tog hinde listeliig ÿ sin arm, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 33,
      "text": "klapitt hind wedtt huiden kindtt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 33,
      "text": "forlad mig alle brøde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 33,
      "text": "hiertte allerkierste | min |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 34,
      "text": "Ieg kand Ether ick forlade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 34,
      "text": "altt for saa | møgitt harm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 34,
      "text": "Och ÿ haffuer thagiit min | thienist mø",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 34,
      "text": "och lagd hinde ÿ ethers arm. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 35,
      "text": "I haffuer thagitt min thienist quinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 35,
      "text": "lagtt | po dÿ bolster saa blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 35,
      "text": "mig haffuer ÿ paa | Gullitt skiøtt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 35,
      "text": "wdj the bare straae, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 36,
      "text": "Han tog hin anden gang ÿ sin arm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 36,
      "text": "klapitt | hin wiid huiden kindtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 36,
      "text": "forlad mig tha | alle brøde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 36,
      "text": "hierte aller kierste min, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 37,
      "text": "Ieg kand ether ick for lade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 37,
      "text": "altt for saa møgit | we,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 37,
      "text": "ieg haffuer fangitt wed ether døther thre, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 37,
      "text": "ieg motte thenum aldriig see |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 38,
      "text": "Lader ÿ nu thenne Iordtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 38,
      "text": "altt mett silcke | brede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 38,
      "text": "Lader ÿ thisze skiøne Iomffruer |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 38,
      "text": "altt for theriis moder indtt ledde, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 39,
      "text": "Welkomen stolten Enger tiill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 39,
      "text": "altt | mett din foffuere haar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 39,
      "text": "Och welkomen | stolten karin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 39,
      "text": "och kongens feste mor |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 40,
      "text": "Velkomen Liden kierstin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 40,
      "text": "och ingiste datther | min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 40,
      "text": "och thu skalltt arffue soriig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 40,
      "text": "effther kiere | moder din, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 41,
      "text": "Hør du liden kierstin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 41,
      "text": "och ingiste dather | min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 41,
      "text": "och giff du deg ÿ Wride kloster |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 41,
      "text": "for kieriste moder din, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 42,
      "text": "Suariit thett liden kierstin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 42,
      "text": "ieg siiger thett | po min sandtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 42,
      "text": "neÿ saa mind mÿnn | kiere Moder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 42,
      "text": "ieg loffuer mig heller | en mandtt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 43,
      "text": "Suaritt thett stolten Eline,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 43,
      "text": "vdaff saa møgit | harum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 43,
      "text": "motte mig icke widis bøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 43,
      "text": "vdaff | min egenn barnn |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 44,
      "text": "Suarett thett stoltenn Engerlille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 44,
      "text": "och | hinder raand thor po kindtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 44,
      "text": "ieg will | mig gierne y Closter giffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 44,
      "text": "for kiere | moder mÿn |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 45,
      "text": "Hand tog hin thridee gang ÿ sin arm, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 45,
      "text": "klapitt hinde widtt huiden kindtt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 45,
      "text": "forladtt mig nu all brøde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 45,
      "text": "hiertte | aller kieriste min, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 46,
      "text": "Ieg kand ether icke forlade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 46,
      "text": "for saa møgen | meen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 46,
      "text": "ÿ slo ihiell min thøffelsuene | tholff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 46,
      "text": "forglemer ÿ icke them, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 47,
      "text": "Hun tog guldering aff sin arm",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 47,
      "text": "slo hende | modtt sortten Iordtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 47,
      "text": "ÿ slo ÿ hiell | , min thøffelsuene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 47,
      "text": "ther gick for rett | Aldriig buodtt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 48,
      "text": "Fram da ginge dÿ Iomffrur,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 48,
      "text": "och dennum | randtt thor po kindtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 48,
      "text": "dÿ radde deriis | fader wenskab",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 48,
      "text": "aff kieriste moder sin, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 49,
      "text": "Dett wor stolten Elin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 49,
      "text": "hun wende tiill | wege ÿ dualle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 49,
      "text": "och thett will ieg forsandingen siige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 49,
      "text": "hun døde wedtt den thalle, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 50,
      "text": "Thog thj stolten Eline,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 50,
      "text": "lagde hinde ÿ | suortten Iordtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 50,
      "text": "saa sore sorgitt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 50,
      "text": "her | sone guodtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 50,
      "text": ":: d. l. | ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}