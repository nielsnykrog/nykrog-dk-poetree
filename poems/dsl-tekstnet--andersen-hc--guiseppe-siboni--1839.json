  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Han lyttede med sydlig Ild og Lyst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Til Tonerne, som følt’ og fyldig’ bæved’;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Han kjendte Sangens Verden i vort Bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Dens rige Skatte han for Lyset hæved’!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Den danske Bøg han fik som Pinien kjær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Saa hjemligt blev det om ham her i Norden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Men Kunsten, Kunsten elsked’ han især –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Nu er det varme Hjerte koldt som Jorden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Han bøied Hoved’, Alt blev Harmoni,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "I Sjælens Palmeland han turde træde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Den stille Sorgens Uge er forbi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Hør Paaskefestens Klokker ringe Glæde.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
