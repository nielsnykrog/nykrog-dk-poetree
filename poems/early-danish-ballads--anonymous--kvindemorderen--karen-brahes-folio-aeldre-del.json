{
  "id": null,
  "title": "Kvindemorderen",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA2.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Vllffuer hand gyllde stallt Wenelild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": ":: Men leinenn grodt. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "\"Vel y bliffue alerkereste min?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Y lyder icke paa di raad end! ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Ieg skall førre eder till den øø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "som y skall løffue och aldrig døø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Ieg skall førre eder til thett land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "som eder skall aldrig kome saarrig til haand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "Der groer icke andit greess ind løg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "ther sønger icke andre smaa fogle ind høgge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "Ther er wielde-kelder, ther sprenger aff win,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "throer paa min thalle, aler-kereste min!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "\"Enn vnger-suends ord well ieg well thro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 5,
      "text": "men alt maa gresett paa iordit graa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "Huor komer ieg aff gaarde med edder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "for alle thi wogter, ther hollder paa meg?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "Meg wogter faader och moder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 7,
      "text": "der-till mine rige suooger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "Meg wogtter och min brøder V,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 8,
      "text": "hin rige Chrest befaaller ieg dem.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "\"Allt om eder wogtet nu all eders iet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 9,
      "text": "y skall meg bortt føllge y denne natt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "\"Huor skall ieg daa kome aff gaarde med eder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 10,
      "text": "thett min kerre fader hand meg icke sier?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "\"Stalt Wenelild, samell dit guld y skrinn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 11,
      "text": "men ieg saaler ganger min.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "Ieg førrer theg paa min ganger graa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 12,
      "text": "min gyllte hielem den setter du paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "Ieg giorder deg med mitt forgyllte suerdt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 13,
      "text": "vlligt ridder du nogen iumfru-ferdt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "Thj red denom igenom skuoffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 14,
      "text": "theris guld skienitt offuer den saadel-buo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "Ther dy kaam y grønen lund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 15,
      "text": "ther loster hanom Vlffuer att huile en stund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "Stallt Wenerlild saatte segg nedder till iord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 16,
      "text": "Vlffuer hand kaster saa dyb en graff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "\"Hør i thett Vlffuer, huad ieg sigger eder:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 17,
      "text": "huor-til daa skall den graff, y giør?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 18,
      "text": "Tell min hest er den for trang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 18,
      "text": "til min lidel hund er den for lang.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 19,
      "text": "\"Siee deg heesset, huor den staad hun staar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 19,
      "text": "thj blodig strøme der fraa hin gaard!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 20,
      "text": "Otte iumfruer saa war der inde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 20,
      "text": "thi fieerst, ieg kunde y landenn finde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 21,
      "text": "Thi otte iumfruer dem haffuer ieg gieldt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 21,
      "text": "ieg haffuer thenom alle wed lyffuet skieldt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 22,
      "text": "Nu skalt du were den niende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 22,
      "text": "saa skalt thu suare alle min sønder.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 23,
      "text": "Allt saad stallt Wenelild och thentte der-paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 23,
      "text": "alt huad hun skulde till antsuar faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 24,
      "text": "\"I otte aar haffuer y meg giyld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 24,
      "text": "rett aldrig ieg eder løske wilde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 25,
      "text": "Nu haffuer meg lengtes y allt thette aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 25,
      "text": "thett ieg matte løske eders fuore haar.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 26,
      "text": "Hand lagde hans hoffuet vdj hindis skød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 26,
      "text": "hand soffuede en søffuen, denn bleff hanom icke sød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 27,
      "text": "Hun thog aff hans hals thett rødde guld-boen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 27,
      "text": "ther-med bandt hun Vlffuers huiden haand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 28,
      "text": "Saa løste hun hest aff fieeder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 28,
      "text": "hun spentte denom om Vlffuers feeder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 29,
      "text": "\"Du wag nu op, Vlffuer, och tall med meg!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 29,
      "text": "y søffuen wild ieg icke suige deg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 30,
      "text": "Sie nu selffuer, hnor den stad hun star,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 30,
      "text": "di bloddige strømer vd fraa hinder gaard!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 31,
      "text": "Otte iumfruer haffuer du der gild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 31,
      "text": "dw haffuer denom alle wed liffuet skiyld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 32,
      "text": "Nu skalt du seleff were den niende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 32,
      "text": "suar matt thu alle deris sønder.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 33,
      "text": "\"Holtt op, stalt Wenelild, du hoge icke meg!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 33,
      "text": "rett aldrig skall ieg suige deg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 34,
      "text": "\"Meg thøckte, der war stuor suig igen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 34,
      "text": "der dw vilt nu forraade meg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 35,
      "text": "Thu gaff meg dinn thro med huiden hand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 35,
      "text": "du mintte meg dog suig aff hiarttens grund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 36,
      "text": "Nu skalt dw alldrig merre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 36,
      "text": "och daare nogen iumfruer saa flerre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 37,
      "text": "Hun drog vd hans forgyltte suerdt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 37,
      "text": "thett war hand Vlffuer fulduell werdt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 38,
      "text": "Saa quendellig hun suerden drog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 38,
      "text": "saa mandellig hun till hanom huog.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 39,
      "text": "\"Leg du nu, Vlffuer, thett thieg render blod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 39,
      "text": "ind well ieg løffue, Wener, en iumfru guod.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 40,
      "text": "Hun saatte seg paa hans ganger rød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 40,
      "text": ":: Men lienden groer. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 40,
      "text": "hun red till sinn moder saa wen en møø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 40,
      "text": ":: I liuder icke paa di rad end! ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}