    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Mit Livs Eventyr (Inklusive Fortsættelse Og Tillæg). 1855-1877",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1855,
    "url": "https://tekstnet.dk/books/andersen-hc_mit-livs-eventyr-inklusive-fortsaettelse-og-tillaeg-1855-1877/026/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Et Sørgebudskab gjennem Landet lød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "»Kong FREDERIK DEN SYVENDE er død!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Lyd Sørgesang ud over Thyras Vold!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Et Konge-Hjerte brast i Danmarks Skjold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Et Hjerte, sendt af Gud til Folk og Land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Meer Dansk end Kongen var der ingen Mand!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Fra Hedenold og til vor Fremgang nu",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Har Ingen elsket Danmark meer end Du!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Du er for Verden Kongemagtens Tolk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "I Kjærlighed velsignet af et Folk.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Tak for dit Hjertelag, Alt, hvad Du gav!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Taknemlighed nu græder ved Din Grav.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Ei Nogen veed, hvad imorgen skeer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Alene Gud Herren det veed og seer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Men naar det for Danmark saae mørkest ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Kom altid Frelse og Hjælp fra Gud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "Da Landet laae splittet og reent faldet hen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "Opmandet det blev ved Niels Ebbesen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Gud Herren ledte vor Velfærds Sag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Og hele Danmark saae Atterdag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "Det er en Storm-Nat, høit Søen slaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "Vort lille Fartøi paa Dybet gaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "Men Gud, Vorherre ved Roret staaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "Han raader, hvad ogsaa end Mennesket spaaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "Ei Nogen veed, hvad imorgen skeer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "Alene Gud Herren det veed og seer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "Men naar det for Danmark saae mørkest ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "Kom altid Frelse og Hjælp fra Gud.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
