{
  "id": null,
  "title": "Hellig Anders",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Rentzells Håndskrift",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/RNZ68.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Wdj Slagelss vor en sognepræst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Vor Herre gaff hannom stor nade;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "hand thiente Gud som hand kunde best,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "sancte Peders sogn monne hand raade;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "aff Slagelss hand selff tolffte mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "ford borth till den hellig land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Hierusalem hand søcte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Hellig Anders er hans naffn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "thi Slagelss mend giorde hand gaffn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "hand vilde theris ærinde røcte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Vdj then hellige fasthe thid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "till Hierusalem monne hand komme;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "hand thiente ther Gud, thet vor hans idt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "thet er oss alle till fromme;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "hand loffuede Gud alt for sin død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "ther oss haffuer frelst aff alle vor nød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "met sine horde pine;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "hand bad oc for all christendom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "at Gud skulle vende thennom till sig om,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "græd for synder sine.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Paa then verdige paaske dagh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "alt met hand messer sagde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "then bør fald thennom saa vell i lau,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "alle fra hannom wdlagde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "then bør drog thennom saa snart fra land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "the mente at komme hiem før hand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "end Gud thet omuende;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "alt men the seilede paa then haff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "tha wor hand paa then hellig graff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "till messen wor adt ende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Hand holt then messe høytideligh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "som Gud stod op aff døde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "hand loffuet hannem ydmygeligh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "all werden haffde frelst aff møde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "saa gick hand vd oc saa sig om,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "ther hand till strandbacken kom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "tha wor the borthe alle;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "hand lagde sig neder, handz sorrig vor stor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "da wor hans huff wdj engle koer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "paa Gud hand monne kalde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "Aff sorrig kom hand i søffn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "hans sorrig fick snart god ende;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "thet hannom drømde, thet vor ey løgn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "men skeede hannom for sande:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "hand tøcte en mand alt paa en hest",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 4,
      "text": "førde hannom som hand kunde best",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 4,
      "text": "effther sin egen villie;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 4,
      "text": "hand vognede op oc saa sig om,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 4,
      "text": "paa Huilehøig sad hand vel som,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 4,
      "text": "thi duer icke sandingen at døle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 5,
      "text": "Thi hiorder ginge saa raskeligh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 5,
      "text": "till hannom at huffsuale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 5,
      "text": "hand bleff saa megit vnderligh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 5,
      "text": "hand hørd thennom danske tale;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 5,
      "text": "hand mente hand vor i Hierusalem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 5,
      "text": "hand viste ey huor hand kom hiem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 5,
      "text": "effther saadan ro oc huile;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 5,
      "text": "hand loffuede Gud i himmerigh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 5,
      "text": "ther hannom hagde førd saa vnderligh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 5,
      "text": "saa mange hundrit mile.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 6,
      "text": "Saa stod hand op, hand vor glad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 6,
      "text": "thet kunde icke andet wære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 6,
      "text": "saa gick hand ind i Slagilss stad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 6,
      "text": "thet vor en stort nymere:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 6,
      "text": "hand sagde messe i Hierusalem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 6,
      "text": "samme dagh kom hand ind hiem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 6,
      "text": "affthen sangh at siunge;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 6,
      "text": "ingen mand kand sige ther aff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 6,
      "text": "huor hand kom fra then hellig graff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 6,
      "text": "thet hand hagde mange tunger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 7,
      "text": "Anden dagh som ther vor nest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 7,
      "text": "hand ville icke lenger duelge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 7,
      "text": "fordj Gud vor hannom i huffuen mest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 7,
      "text": "hand ville the mile telge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 7,
      "text": "till sancte Ib oc till Trundhiem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 7,
      "text": "end kom hand alt hiem igien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 7,
      "text": "førend hans stalbrødre waare;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 7,
      "text": "hans hest wor snar oc icke seen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 7,
      "text": "fordj kom hand saa snart igien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 7,
      "text": "hans been vor gandske snare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 8,
      "text": "Fattige folck thennom lante hand huss,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 8,
      "text": "naar the ville hannom giesthe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 8,
      "text": "mad och øl, ild oc liuss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 8,
      "text": "gaff hand thennom aff thet beste;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 8,
      "text": "en quinde gaff hand sin syn igien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 8,
      "text": "en krøblingh gaff hand bode hender oc been",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 8,
      "text": "met Gudz hielp oc naade;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 8,
      "text": "alt thet hand wdi Gudz naffn gaff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 8,
      "text": "thet kom igien som vand till haff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 8,
      "text": "thet fick hand aff stor baade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 9,
      "text": "Alle the wdj Slauelse boo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 9,
      "text": "hand actede thieris beste:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 9,
      "text": "hand flyde thennom gress till theris koo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 9,
      "text": "oc wand till theris heste;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 9,
      "text": "alle the Gud monne kalde paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 9,
      "text": "hielp da monne the visselig faa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 9,
      "text": "the fattige met the rige;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 9,
      "text": "suar dags reyste oc aff then god,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 9,
      "text": "forlen som Christus met it frj mod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 9,
      "text": "wj finde slet ingen hans lige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 10,
      "text": "Nu ligger Hellig Anders i fallen muld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 10,
      "text": "alt wdj sancte Peders kircke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 10,
      "text": "alle the Christus hedre aff huld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 10,
      "text": "thennom vill Gud hielpe oc størcke;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 10,
      "text": "hellig Andris siel hun gledis nu met Gud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 10,
      "text": "fordj hand holt hans hellige bud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 10,
      "text": "men hand wor wdj liffue;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 10,
      "text": "o, Iesu Christ, met thine bøn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 10,
      "text": "lad oss i himmerige faa god løn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 10,
      "text": "lad oss ther met dig bliffue.",
      "part": false,
      "marginal_notes": []
    }
  ]
}