  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Ak, hvor romantisk smiler dog det Bjælkehuus i Dalen!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Med deiligt skaaret Halm og Hø er Gulvet strøet i Salen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Og midt derinde er et Baal, saa lysteligt det luer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Melodisk drypper Soden ned fra Loftets hvalte Buer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Imedens Røgen bølger frit om Bjælkerne derinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Rundtom et Bryggerkar med Øl, sig leirer Mand og Qvinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Ja det er Oldtids brede Børn det seer man paa Figuren,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Og De er’ alle klædt’ i Skind, der lugte af Naturen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Hver gnaver paa et Flæske-Been, og naar det reent er pillet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Naboen det i Panden faaer, og det er Tegn paa Snillet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "– I Jomfrue-Buret seer det ud, som i en Spindestue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "De Terner stoppe Hoser der med deres skjønne Frue;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Og sige de i barnlig Skjæmt lidt meer end sig kan sømme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Med Øredask, og andet meer, hun holder dem i Tømme.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
