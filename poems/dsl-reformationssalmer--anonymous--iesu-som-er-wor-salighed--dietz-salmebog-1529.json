  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "IEsu som er wor salighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "all wor attraa oc kierlighed/",
      "part": false,
      "marginal_notes": [
        "Johan. j."
      ]
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Allis wor Gud oc skabere blÿd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "som tog mandom sÿst ÿ werdzens tÿd.",
      "part": false,
      "marginal_notes": [
        "Col. j:"
      ]
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Hwilken miskundhed teg offuerwand/",
      "part": false,
      "marginal_notes": [
        "Gala. iiij: Esaie. liij."
      ]
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "att tw saa drogst wor syndzens band/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Then grumme død wilde tw lÿde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "att wÿ motte then ewig død qwit bliffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Thet heluede monne tw igiennom gaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "thÿne fanger tw frelste saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Jgien gangen til thÿn faders land/",
      "part": false,
      "marginal_notes": [
        "Marc. xvj. Esaie. liij."
      ]
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "ther sidder tw hooss hans høgre hand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Thÿn godhed twingde teg saa sterckelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "wor synd tw barst tolmodelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "wÿ bede giff oss then ewige roo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "hwor wÿ maa teg altÿd beskoe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Then som aff døden opstanden er/",
      "part": false,
      "marginal_notes": [
        "Mat xxviij Johan. xx."
      ]
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "hannwm wille wÿ loffue prÿse oc ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Med fader oc then Helliaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "som sitt ord kundgiør ÿ alle land.",
      "part": false,
      "marginal_notes": []
    }
  ]
}