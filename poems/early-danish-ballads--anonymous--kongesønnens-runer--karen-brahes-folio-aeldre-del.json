  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Denn konngenns sønn gannger y gaarde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "* huertt stalltt iumfrw,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "synn erre holder saa weell:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "tthy ...ell buod prysz och erre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Gud gyffuer denom lyckenn der-tiell.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": ":: Saa haffuer hun lagtt hans hiartte y stuor tnange. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}