    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/RNZ51.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Huem sig paa Guud forlade kannd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "dem staar hannd by tiill lannd oc vannd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "der aff wiill wy nu synge;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "huo hannom aff hiertet mon paa kalle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "thennom viil hannd wyszeliig hielpe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Men thennom som staltte oc tradzeliig er",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "med sin egen godtz oc velde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "oc huer mannd mon foracte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "dennom wiill Gud viiszeliig staannde imod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "det lader hannd os nu wel acte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Der mannd scriff tusind femhunndre aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "fire oc tresindtz tiffue det waar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "y maii maaned",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "begiønndis paa ny den krig igienn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "mellum Danmarck oc Suerrig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Dy lybske herrer waar daa tiill sindtz",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "att lade siig finnde vdj samme krid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "then vret viille dy heffne;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "med X rett vell beryste skyb",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "mon di fra Lybek vdløbe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "Tiill Bornholm dy først kom",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "oc ther fortøffuede siig tiill fromme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "aff Danmarckis krone,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "dy skybe dy waar daa well berøst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "dieris hob ther med atth størck.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "Der Danmarckis skyb ickj dyd komme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "tiill Falsterbo lod Lybsker staa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "aliene torde dy icki byde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "for fynndernis mackt oc stuore wold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": "tiill Kiøbenhaffuen mon dy sele.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "Paa Kiøbenhaffuen enn konning god,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "kong Frederick den anden, med itt fry mod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "dy lybsk hannd wel wndfinge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": "hannd tacke for alle ære oc gott",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 6,
      "text": "som dy monne hannom beuise.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "Tiffue mectiige krigs skyb waar ther paa stand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 7,
      "text": "her Oluff Trolle dieris høffuidzmand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": "Fortun omerall mon vere;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 7,
      "text": "der suore siig samel dy danske oc tysk",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 7,
      "text": "hiin andre ickj att suige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 8,
      "text": "Vdi den søe dro dy saa hen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 8,
      "text": "att der besøge obenbare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 8,
      "text": "med itt fry mod oc hiertte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 8,
      "text": "dy ropte paa Guud aff hiemelen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 8,
      "text": "att hand thennom viille beuare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 9,
      "text": "Vdj may monet ninde oc tiiffuend dag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 9,
      "text": "thaa løb dy herrer fraa Kallør aff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 9,
      "text": "alt tiill thenn suenske skare;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 9,
      "text": "dy suenske att søge waar deris act,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 9,
      "text": "ther tiill theris store begiere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 10,
      "text": "Paa en tysdag det saa tiill gieck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 10,
      "text": "att mannd dy suenske att sye fick,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 10,
      "text": "sin skyb war mange oc store;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 10,
      "text": "hannd søcte dy danske oc lybsk vel ret,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 10,
      "text": "for hannom wiill dy ey vige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 11,
      "text": "Dy skiød paa huer andre aff ganske mact",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 11,
      "text": "fra midag oc ind tiill afftenn vell hart,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 11,
      "text": "daa hørde mannd thy bysser klinge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 11,
      "text": "den Oldenborck, en lybske skyb,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 11,
      "text": "bliff skot ther slet tiill grunden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 12,
      "text": "Gud gaff och ther tiill naade sin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 12,
      "text": "som altiid sine beuare wiill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 12,
      "text": "att dy folck bliff holdenn wyd lyffue;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 12,
      "text": "en skyper tiill den annden sagde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 12,
      "text": "\"Y morgen viil wy først begiennde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 13,
      "text": "Om morgenn orliig thett war dag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 13,
      "text": "dy giorde hind annden møgen vmag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 13,
      "text": "med skod bode smaa oc store;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 13,
      "text": "ther bliff saa mangenn taper heldt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 13,
      "text": "thette wiill ieg syge forsannden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 14,
      "text": "Fordeell haffde daa dy suennske bordte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 14,
      "text": "huor aff dy schreppit oc brammit saa stordt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 14,
      "text": "dy acter alt seren att vinden;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 14,
      "text": "veridt stod os dog møgit emod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 14,
      "text": "att wy tiill thennom ey komme kunde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 15,
      "text": "Dog skiød dy saa denn gannske dag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 15,
      "text": "paa effthermedag tiill klockenn slo taa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 15,
      "text": "med karthoer oc slanger stuore;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 15,
      "text": "daa gick den vind aff Gudtz forsyn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 15,
      "text": "nogit om tiill voridz side.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 16,
      "text": "Den danske ommerall, der hand thette saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 16,
      "text": "enn ret fry mod monne hannd daa faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 16,
      "text": "dy danske wiille hannd thaa trøste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 16,
      "text": "oc bad thennom stryde retteliig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 16,
      "text": "som dy pleit altiidt att giøre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 17,
      "text": "Den lybske ommerall, her Hendrich Kull,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 17,
      "text": "hand mon daa icki løbe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 17,
      "text": "dy suenske sogte mand daa tappertt tiill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 17,
      "text": "ieg thet forsandenn sige viill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 17,
      "text": "Magløs fick thet att finde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 17,
      "text": "Iacob roffte med høg røst:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 17,
      "text": "\"O, y suenske, lader os fast stande.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 18,
      "text": "Dy skiød paa hind annden aff ganske mact,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 18,
      "text": "dy danske oc lybske waar vforsaud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 18,
      "text": "forten sig icki forglempte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 18,
      "text": "hunn skiød daa bort y samme stund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 18,
      "text": "Magløs hinndis styr med alle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 19,
      "text": "Der hunn haffde myst sin styre good,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 19,
      "text": "saa fald strax bort denn suenske mod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 19,
      "text": "theris skyb kunnde dy icki raade;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 19,
      "text": "thet waar theris klage oc nød vell stor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 19,
      "text": "dy danske oc lybske att byde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 20,
      "text": "Dy bordis med Magløs strax paa stand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 20,
      "text": "dy danske oc lybske fick offuerhand;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 20,
      "text": "daa saa mannd retteliig fickte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 20,
      "text": "dy vnge bosmend med itt fridt mod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 20,
      "text": "ther tiill dy guode landtz knecte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 21,
      "text": "Iacob Bage, thenn gamle kapertin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 21,
      "text": "hand saa dy giørde hannom stor meen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 21,
      "text": "Magløs begyntte att brennde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 21,
      "text": "hannd haffde well heller sett paa stannd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 21,
      "text": "dy dannske oc lybske att søncke tiill grunde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 22,
      "text": "Den danske capertin, Hendrich Skreder wiid naffnn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 22,
      "text": "y Magløs komme sig lidt tiill gaffn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 22,
      "text": "med mange krigs folck fromme;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 22,
      "text": "hannd myste sitt liiff paa samme stund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 22,
      "text": "med tredue mend gieffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 23,
      "text": "Nu Iacob Bage saa huor tiill viille gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 23,
      "text": "ther tiill tolluster oc saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 23,
      "text": "en ryder hr. Arill Trolle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 23,
      "text": "oc hr. Christofer, en suenske gaad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 23,
      "text": "aff Magløs dy strax vd sprange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 24,
      "text": "Dy fange fick wy nu strax paa stannd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 24,
      "text": "dy anndre bliff død aff ild oc wannd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 24,
      "text": "foruden dy som føre bliff slagen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 24,
      "text": "der tiill Magløs, den suenske omerall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 24,
      "text": "hun mon daa søncke tiill grunde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 25,
      "text": "Hunder tiffue oc sex stolt skod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 25,
      "text": "dy waar ther paa wforsøgt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 25,
      "text": "karthoer oc feltskod gaade;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 25,
      "text": "der tiill fem hundre suenske mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 25,
      "text": "dieris enndeligt dy anamit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 26,
      "text": "Her haffuer y hørt Magløs endeliig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 26,
      "text": "som altiid dy danske yder skiennde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 26,
      "text": "Iødhader mon hun sig kalle;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 26,
      "text": "Mars hied hun tiill det tridie naffnn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 26,
      "text": "Mactløs mon hun nu hyede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 27,
      "text": "Saa lader os nu alle tacke Guud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 27,
      "text": "frycte hannom oc holde hanns bod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 27,
      "text": "som den rette Magløs mon vere;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 27,
      "text": "hannom wiil wy nu tacke aff hiertens grund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 27,
      "text": "oc giiffue Gud loff, hieder oc ære. Amen.",
      "part": false,
      "marginal_notes": []
    }
  ]
}