  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "VEl er den Mand der vandrer ey",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "J de wgudeligis raad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Oc icke staar paa Synderis vey/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Eller sider som Spotterne sade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Men haffuer sin lyst i Herrens Low/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Den er altid vdi hans hu/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Hand idelig der paa tencker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Hand er som it Træ/ der plantet er",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Hoss rinnende Vandstrømme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Huilcket sin fruct i tiden bær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Hendis blad sig ey forsømme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Huad hand giør skal hannem vel bekomme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Men de forfaris som ere wfromme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Som Støff for vind hin stercke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Derfor skal ey de wgudelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "J Dom bestandige bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Oc naar de fromme forsamle sig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Da findis de Syndere at liuffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Thi Gud kiender de Retfærdigis vey/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Men de wgudeligis sti",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Vil hand met mact fordærffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Ære være dig Fader euindelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "Oc Christ din Søn vor Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Der til vor trøstere den hellig Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Aff hiertet wi det begære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Giff oss din naade oc styrcke vor Tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "At wi tilsammen met kierlighed bo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "J it sind effter din villie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "O Herre Gud i Himmerig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "Huo skal bo i din Leyre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "Huile sig paa dit hellige Bierg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "Oc sig daglige forbedre?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Det skal den giøre/ der du indfør",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "For vden vantroens lyde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "Der retuished haffuer til sed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "Mod ingen mand at bryde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "At huer sit egit maa nyde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "Den der taler aff hiertet sant/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "Oc ingen met tunge bedrager/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "Giør ey sin Neste skade oc tant/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "Ey spot mod dem oplegger/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "De Gud forsmaa/ passer hand ey paa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 5,
      "text": "Gudfryctige Folck hand ærer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 5,
      "text": "Hand suer en Eed oc holder det/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 5,
      "text": "Met Aager hand sig ey nærer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "Smugenset hand ey opbærer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 6,
      "text": "Huo disse tingist haffuer til sed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 6,
      "text": "At holde wbrødelige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "Met Guds hielp bliffuer hand vel ved/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 6,
      "text": "At bo i Himmerige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 6,
      "text": "For Christi skyld er Gud hannem huld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 6,
      "text": "Hand giffuer oss det alle sammen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 6,
      "text": "Der for skal være baade priss oc ære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "Den euige Gud altsammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "Nu oc euindelige/ Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 7,
      "text": "SAlig foruist ere alle de/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 7,
      "text": "Der met en stadig tro vandre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 7,
      "text": "J Herrens Low allene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 7,
      "text": "Salig foruist er huer den mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 7,
      "text": "Hans vidnisbyrd beuare kand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 7,
      "text": "Oc aff hiertet hannem tiene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 7,
      "text": "Thi huo Guds lydige børn bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 7,
      "text": "De ingen Ondskab bedriffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "Men i hans veye vandre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 7,
      "text": "O Herre Gud i Himmerig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 7,
      "text": "Du bødst wi skulle flitelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 7,
      "text": "Holde dine Bud offuer andre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 8,
      "text": "O Gud giffuit at leffnit mit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 8,
      "text": "Sig skicke maa effter Ordit dit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 8,
      "text": "Din retfærdighed at holde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 8,
      "text": "Saa skeer mig huercken spot eller spe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 8,
      "text": "Naar ieg vil stedze til din Low see/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 8,
      "text": "Saadant kand dit Ord volde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 8,
      "text": "Thi tacker ieg dig hiertelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 8,
      "text": "At du kiende oc lærde mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 8,
      "text": "Din retfærdige Domme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 8,
      "text": "Huilcke ieg altid holde vil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 8,
      "text": "Forlad mig ey/ giff naade der til/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 8,
      "text": "At ieg saa vijt kand komme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 9,
      "text": "HVor met bedrer den Vnge sin ijd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 9,
      "text": "Saa hand vel leffuer sin vngdoms tid?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 9,
      "text": "Naar hand holder dine Ord alle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 9,
      "text": "Jeg altid aff min hiertens grund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 9,
      "text": "Dig søgte/ lad mig ingelund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 9,
      "text": "Fra dit hellige Bud falde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 9,
      "text": "J mit hierte i Troen til dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 9,
      "text": "Din tale er skiult vel inderlig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 9,
      "text": "At ieg skal icke synde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 9,
      "text": "Velsignet est du Herre Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 9,
      "text": "Lær mig at kiende dine Bud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 9,
      "text": "Oc retfærdighed at finde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 10,
      "text": "Nu haffuer ieg met læber mine",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 10,
      "text": "Alle domme effter Munden din",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 10,
      "text": "Bekient/ oc vil fortæle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 10,
      "text": "Nu vil ieg oc met hiertens lyst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 10,
      "text": "Din vidnisbyrds Lærdom oc trøst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 10,
      "text": "Offuer all Rigdom vduæle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 10,
      "text": "J dine Bud øffuer ieg mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 10,
      "text": "J mit hierte er det min leeg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 10,
      "text": "Paa dine veye at vocte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 10,
      "text": "Oc om dine retfærdighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 10,
      "text": "At tencke oc tale er min sed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 10,
      "text": "Oc ey dine Ord foracte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 11,
      "text": "DJn tienere hielp nu Herre Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 11,
      "text": "At leffue effter dit hellige Bud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 11,
      "text": "Dine hellige Ord at holde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 11,
      "text": "Lad op mine Øyen/ at ieg seer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 11,
      "text": "De store vnder/ som nu skeer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 11,
      "text": "Met dine Ord saa bolde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 11,
      "text": "Jeg er her men en fremmet gest/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 11,
      "text": "Dig beder ieg Herre nu allermest/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 11,
      "text": "Skiul ey for mig din villie/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 11,
      "text": "Min Siel hun haffuer ret stor attraa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 11,
      "text": "Din Retuished at vide maa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 11,
      "text": "Oc dit Ord effter at følge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 12,
      "text": "De stolte straffer du O Herre slet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 12,
      "text": "Forskiuder dem oc met all Ræt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 12,
      "text": "Som fra dine Ord affalde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 12,
      "text": "Den spot oc skam tag fra mig bort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 12,
      "text": "Thi ieg atspør dit hellige Ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 12,
      "text": "Vil det bekiende for alle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 12,
      "text": "De veldige gaa i raad mod mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 12,
      "text": "Dine tienere tage dit Ord til sig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 12,
      "text": "Oc sig der til forlade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 12,
      "text": "Thi det er all min glæde oc lyst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 12,
      "text": "All min tilfluct/ oc all min trøst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 12,
      "text": "Mod alle de mig her hade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 13,
      "text": "MJn Siel hun henger ved muld oc Jord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 13,
      "text": "Herre lad mig leffue effter dit Ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 13,
      "text": "At ieg maa salig vorde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 13,
      "text": "Mine veye haffuer ieg sagt for dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 13,
      "text": "O Herre du haffuer oc vel hørt mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 13,
      "text": "Din Retuished mig lærde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 13,
      "text": "Din rette vey Herre du før mig til/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 13,
      "text": "Din villie ieg gierne høre vil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 13,
      "text": "Om dine Vnder tale.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 13,
      "text": "Min Siel nu saare bedrøffuit er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 13,
      "text": "Bestyrck mig met dit Ord saa klar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 13,
      "text": "Mig vil ieg dig befale.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 14,
      "text": "Den falske vey tag bort fra mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 14,
      "text": "Giff mig din Naade fuldkommelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 14,
      "text": "Vdi dit Ord at leffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 14,
      "text": "Din sande vey haffuer ieg fast kier/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 14,
      "text": "Oc vil hannem ey forgætte her/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 14,
      "text": "Dit Ord vil ieg ved bliffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 14,
      "text": "Der til setter ieg oc all min trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 14,
      "text": "Oc beder dig Herre som ieg kand bæst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 14,
      "text": "Til spot lad mig ey vorde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 14,
      "text": "Den sande vey vil ieg nu gaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 14,
      "text": "O Herre du haffuer nu trøstet saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 14,
      "text": "Mit hierte her paa Jorden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 15,
      "text": "Den Christelig Kirckis skøne naffn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 15,
      "text": "vil huer paa Jorden bære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 15,
      "text": "Guds Folck sig kalde oc giøre aff saffn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 15,
      "text": "dog de det ey monne være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 15,
      "text": "Papister/ oc den grumme Tyrck/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 15,
      "text": "Rydser/ Jøder met Lærdom mørck/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 15,
      "text": "Guds kircke sig falsklig kalde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 16,
      "text": "Den Christelig Kircke kaldis ret",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 16,
      "text": "Almindelig/ tag det vare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 16,
      "text": "Tid/ sted/ Folck/ Lærdom icke forgæt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 16,
      "text": "Disse fire det forklare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 16,
      "text": "Saa lenge som Verden stod oc staar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 16,
      "text": "Guds Søn sig samler lydige Faar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 16,
      "text": "Huo vilde hannem det forhindre?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 17,
      "text": "All Verden er foruist denne Sted/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 17,
      "text": "Som Christus selff kundgiører/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 17,
      "text": "J huilcken Guds Folck ere atspred/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 17,
      "text": "Oc it Euangelium høre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 17,
      "text": "Alle Menniske kaldis oc her til/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 17,
      "text": "Fra Dieffuelens garn oc syndsens spil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 17,
      "text": "At de kunde salig bliffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 18,
      "text": "Den Christelig Kirckis rette tegn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 18,
      "text": "Som Scrifften klarlige lærer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 18,
      "text": "Er først Guds Ord/ som alle vegn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 18,
      "text": "Om Jesu vidnisbyrd bærer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 18,
      "text": "Huor som det predickis vden all tant/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 18,
      "text": "Guds menighed findis der forsant/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 18,
      "text": "Vden fruct kand det ey være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 19,
      "text": "Huor Daabsens Sacrament saa god",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 19,
      "text": "Som Christus monne indskicke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 19,
      "text": "Oc hans Testamentis Legem oc Blod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 19,
      "text": "Som wi skulle æde oc dricke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 19,
      "text": "Huor disse tho de brugis ret",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 19,
      "text": "Foruden all Kætters fund oc sæt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 19,
      "text": "Guds Kircke vden tuil der kiendis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 20,
      "text": "Paa Lydighed imod Guds ord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 20,
      "text": "Kand wi oc Guds Folck mercke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 20,
      "text": "Som ere Guds Tempel her paa Jord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 20,
      "text": "Oc Christi Lemmer stercke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 20,
      "text": "Gud hører visselig deris bøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 20,
      "text": "Oc de giffue hannem tacksigelse skøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 20,
      "text": "De hannem ret kiende oc tiene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 21,
      "text": "Kaarssit oc modgang er foruist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 21,
      "text": "Oc Christi Bruds hoffarffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 21,
      "text": "Dog trøster du hende O Jesu Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 21,
      "text": "At hun skal Himmerig arffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 21,
      "text": "Mod Dieffuelens list oc grumme mord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 21,
      "text": "Mod Verdsens børns forargelse stor/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 21,
      "text": "Oc kiødit/ du hende beskermer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 22,
      "text": "Wkrud oc Klinte der findis fast",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 22,
      "text": "Blant Hueden her paa Jorden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 22,
      "text": "Mundchristne leffue i skam oc last/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 22,
      "text": "Paa Dommen de affskild vorde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 22,
      "text": "Guds helgen de haffue en krafftig Daab/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 22,
      "text": "En Gud/ en Herre/ en Tro/ it Haab/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 22,
      "text": "J Himmerig skulle de samlis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 23,
      "text": "Thi tacke wi dig O Jesu Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 23,
      "text": "At paa disse tegn oc flere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 23,
      "text": "Din hellige Kircke kand foruist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 23,
      "text": "Beuisis blant oss at være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 23,
      "text": "Din Lærdom/ som ved Luther igen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 23,
      "text": "Til Liusit kom/ lad bliffue reen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 23,
      "text": "Altid i disse Lande.",
      "part": false,
      "marginal_notes": []
    }
  ]
}