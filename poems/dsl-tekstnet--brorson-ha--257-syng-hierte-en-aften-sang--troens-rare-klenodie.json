  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Syng hierte! syng en aften-sang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Om den, der elsker dig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Lad alting fryde sig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Hvert suk skal give harpe-klang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Det mindste aande-drag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Skal giøre cither-slag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Sind og mood,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Liv og blod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Og hvad i mig røres kand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Fryder sig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Inderlig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "I den søde Frelser-mand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Naar jeg kun tænker paa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Den glæde jeg skal faae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Naar jeg skal JEsum see",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "I himlene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Strax utaalmodig er",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Min længsel og begier,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "At jeg dog eengang maa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "Mit ønske naae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Nu solen bag det mørke hav",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "Sin gylden straale-pragt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "Har ned i dvale lagt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "Nu verden mørknes som en grav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 1,
      "text": "Og jordens humle-boe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 1,
      "text": "Er stille og i roe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 1,
      "text": "Er mit muld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 1,
      "text": "Længsels fuld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 1,
      "text": "Efter gravens hvile-stavn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 1,
      "text": "Thi mit sind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 1,
      "text": "Haster ind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 1,
      "text": "Til sin søde himmel-havn;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 1,
      "text": "Ey, at min verdens trang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 1,
      "text": "Er mig saa tung og lang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 1,
      "text": "Den jo er honning-sød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 1,
      "text": "Ved JEsu død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 1,
      "text": "Ey, at den mørke nat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 1,
      "text": "Kand giøre sielen mat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 1,
      "text": "Saa længe JEsu saar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 1,
      "text": "Mig aaben staaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 2,
      "text": "Men jeg vil til min JEsum hiem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 2,
      "text": "I evighed at staae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 2,
      "text": "Og see hans ansigt paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 2,
      "text": "Og skulde ey dit eget lem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 2,
      "text": "O JEsu! smertelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 2,
      "text": "Dog længes efter dig?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 2,
      "text": "Seer en bruud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 2,
      "text": "Ynksom ud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 2,
      "text": "Efter hendes hierte-ven;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 2,
      "text": "Skulde da",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 2,
      "text": "Jeg ey fra",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 2,
      "text": "Verden længes til dig hen?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 2,
      "text": "Jeg bier gierne, til",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 2,
      "text": "Du selv mig hente vil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 2,
      "text": "Den tiid, jeg leve maa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 2,
      "text": "Skal snart forgaae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 2,
      "text": "Jeg ved min senge-stok",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 2,
      "text": "Har meer end glæde nok,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 2,
      "text": "At jeg kand tænke paa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 2,
      "text": "Mit sidste straa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 3,
      "text": "Saa leg dig, søvne-tunge krop,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 3,
      "text": "Tak verden gandske af,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 3,
      "text": "Og hviil som i din graf,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 3,
      "text": "Din JEsus dig skal vække op,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 3,
      "text": "Om ey før, dog eengang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 3,
      "text": "Ved Guds basunes klang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 3,
      "text": "Far og vel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 3,
      "text": "Du min siel!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 3,
      "text": "I din JEsu søde favn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 3,
      "text": "Der er trøst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 3,
      "text": "Der er lyst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 3,
      "text": "Nu god nat i JEsu navn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 3,
      "text": "Den tiid er snart forbi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 3,
      "text": "At du skalt vorde frie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 3,
      "text": "Fra kroppens fængsle-tvang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 3,
      "text": "At gaae din gang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 3,
      "text": "Til lammets brude-sal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 3,
      "text": "Til tusind englers tal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 3,
      "text": "Til din udvalde skat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 3,
      "text": "God nat! god nat!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
