  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Nøddeknækker, hvor er Du stiv!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Nødder Du knækker dit hele Liv.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Har i dit Hoved Du slet ingen Hjerne?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Smag dog engang paa den dejlige Kjærne!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "At knække Skaller den hele Dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "det maa dog være en kjedelig Sag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Nøddeknækkeren var kun af Træ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "han svarede hverken Bu eller Bæ;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "hvergang en Nød man i Gabet ham stak,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "klemte han til, saa Skallen knak;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "han agted kun lidt, at Kjærnen var lækker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "- men det var jo ogsaa en Nøddeknækker!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
