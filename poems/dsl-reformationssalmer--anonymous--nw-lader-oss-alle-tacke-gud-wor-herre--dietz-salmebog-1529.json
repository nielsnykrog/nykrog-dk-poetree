  "source": {
    "id": null,
    "title": "Een ny handbog med Psalmer oc aandelige lofsange",
    "year_published": 1529,
    "publisher": "Ludwig Dietz",
    "printer": "Ludwig Dietz",
    "place": "Rostock",
    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/dietz-salmebog-1529/5"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Nw lader oss alle tacke Gud wor Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hwilken med sÿn fødelse oss haffuer forløøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "fraa dieffuelsens macht. Loffuer Herren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Hannwm bør altÿd att wÿ siunge med Englene/",
      "part": false,
      "marginal_notes": [
        "Mat. xxiij."
      ]
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Aere oc prÿss wære Gud ÿ thet høgeste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "LOffuit wære tw Jesu Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "att tw menniske worden æst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "fød aff een Jomffru reen oc klar:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "thÿ glæder seg alle Engle skare",
      "part": false,
      "marginal_notes": [
        "Luce. ij."
      ]
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Kyrioley.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "Guds ewige faders eniste søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "er fød for oss till stor trældom/",
      "part": false,
      "marginal_notes": [
        "Phil. ij."
      ]
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "wor krenckelig natur han paa seg tog/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "ther ÿ klædde seg thet ewige gode",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Kyrioley.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "Then som all werden skal frelse aff nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "ligger ÿ thet Jomffruelig skød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "han er eet barn saa lidet oc kleint/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "som himmel oc iord opholder alleen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Kyrioley.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Thet ewige liwss gaar nw herind/",
      "part": false,
      "marginal_notes": [
        "Johan. j. viij. oc. ix."
      ]
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "som giffuer all werden eet nyt skÿn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "oc liuser mit om midnatis tÿd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "att wÿ kunde kende wor fader saa blÿd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "Kyrioley.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Gud faders søn een Gud aff artt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "eet dødeligt menniske han er worden snart/",
      "part": false,
      "marginal_notes": [
        "Luce. ij."
      ]
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "oc førde oss aff then iæmmerlig dall/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "oc giorde oss arwinge wdi himmerigs sall",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": "Kyrioley.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "Han er paa iorden kommen the arme/",
      "part": false,
      "marginal_notes": [
        "Math. xj."
      ]
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "att han wil seg offuer thennom forbarme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "oc thennom ÿ himmelen att giøre rÿge/",
      "part": false,
      "marginal_notes": [
        "Mat. xxij."
      ]
    },
    {
      "id": 33,
      "stanza_id": 7,
      "text": "hans hellige Engle att wære lÿge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 7,
      "text": "Kyrioley.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "Saadant monne han sÿne børn tilwende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "ther paa wÿ oc nw hans kierlighed kende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 8,
      "text": "Thÿ tacker hannwm all Christenhed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 8,
      "text": "oc prÿse teg Gud ÿ ewighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 8,
      "text": "Kyrioley.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "EEtt lidet barn saa ærefult/",
      "part": false,
      "marginal_notes": [
        "Mat. j. Luce. ij."
      ]
    },
    {
      "id": 41,
      "stanza_id": 9,
      "text": "ÿ dag oss føddis til helsen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 9,
      "text": "wdaff een Jomffru naadefuld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 9,
      "text": "oss arme til gienløsen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 9,
      "text": "Wore oss thet barn icke fød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 9,
      "text": "till ewige tÿd tha skulde wÿ død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 9,
      "text": "Then salighed er oss alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 9,
      "text": "Eya tw søde Jesu Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 9,
      "text": "att tw menniske worden æst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 9,
      "text": "Lad oss ey ÿ døden falde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 10,
      "text": "Then tÿd hun er nw gantske rÿg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 10,
      "text": "till Guds naffn att wÿ ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 10,
      "text": "thÿ Guds søn wdaff himmerig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 10,
      "text": "paa iorden monne wære:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 10,
      "text": "Thet er een stor ydmyghed:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 10,
      "text": "som Gud fader oss haffuer beteed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 10,
      "text": "een swend hans søn er worden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 10,
      "text": "forwden alt meen er worden oss lÿg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 10,
      "text": "ther med han giør oss alle rÿg /",
      "part": false,
      "marginal_notes": [
        "Phil. ij. Esaie. liij."
      ]
    },
    {
      "id": 59,
      "stanza_id": 10,
      "text": "Bær oss aff syndzens byrde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 11,
      "text": "Salig er then som thette tror/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 11,
      "text": "aff hiertens grund oc loffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 11,
      "text": "til ewig tÿd han salighed faar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 11,
      "text": "ÿ Christo skall han soffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 11,
      "text": "Tror han att Christus fyllist nock er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 11,
      "text": "ÿ døden for oss er giffuen eet werd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 11,
      "text": "aff Gud wor ewige fader/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 11,
      "text": "O hwilkit wnder monne thet wære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 11,
      "text": "att Christus lÿder for oss wanære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 11,
      "text": "oc all wor synd betaler.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 12,
      "text": "Thÿ tacker hannwm all Christenhed:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 12,
      "text": "for thette store gode/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 12,
      "text": "oc bede hans barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 12,
      "text": "han wilde thennom benaade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 12,
      "text": "All falske lærdom att wende wdaff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 12,
      "text": "Wor onde sedwan att giffue sÿn straff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 12,
      "text": "oc wilde oss thette forgiffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 12,
      "text": "Gud fader/ Søn/ oc Helliaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 12,
      "text": "wÿ bede teg bode qwinne oc mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 12,
      "text": "lad oss ÿ freden leffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 13,
      "text": "NW er fød oss Jesus Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 13,
      "text": "Aff een Jomffru thet er wist/",
      "part": false,
      "marginal_notes": [
        "Math. j. Luce: ij."
      ]
    },
    {
      "id": 82,
      "stanza_id": 13,
      "text": "Forwden mands beblandelse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 13,
      "text": "Er han kommen aff høgeste:",
      "part": false,
      "marginal_notes": [
        "Math. j. Luce. j. Ezech xxvij Psal. cxiij."
      ]
    },
    {
      "id": 84,
      "stanza_id": 13,
      "text": "Wor salighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 14,
      "text": "Gud med oss .",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 14,
      "text": "Then bebudede Gabriel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 14,
      "text": "Ther till er witne Ezechiel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 14,
      "text": "Han kom til oss wor frelsere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 14,
      "text": "¶ Gud faders søn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 15,
      "text": "Fuldkommen er nw Dauids dicht/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 15,
      "text": "Ther till oc saa Propheternis schrifft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 15,
      "text": "Christus er thet Engelske liwss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 15,
      "text": "Som hiwrderne soge ÿ krybben laa.",
      "part": false,
      "marginal_notes": [
        "Luce. ij."
      ]
    },
    {
      "id": 94,
      "stanza_id": 15,
      "text": "¶ Eet menniske.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 16,
      "text": "Then som kom aff himmelen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 16,
      "text": "Han atsporde mennisken/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 16,
      "text": "Ey qwinne eller nogen mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 16,
      "text": "forderffue nogen tÿd wille hand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 16,
      "text": "O miskundhed.",
      "part": false,
      "marginal_notes": [
        "j. Petri. ij."
      ]
    },
    {
      "id": 100,
      "stanza_id": 17,
      "text": "J Christne børn forsamles nw/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 17,
      "text": "Med Christ eder broder wærer glade oc froo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 17,
      "text": "Giffuer hannwm loff wor Konning wÿss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 17,
      "text": "Som oss forhwerffde then ewig prÿss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 17,
      "text": ".",
      "part": false,
      "marginal_notes": []
    }
  ]
}