  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "»To brune Øine jeg nylig saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "I dem mit Hjem og min Verden laae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Der flammede Snillet og Barnets Fred, –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Jeg glemmer det aldrig i Evighed.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "»Thalatta, Thalatta, du ewiges Meer!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "»Høit over Skyen staaer jeg her,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Dog Hjertet maa bekjende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Jeg var dog Himlen mere nær",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Dengang jeg var hos hende!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "»Gjennem disse dunkle Gange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "Snoer sig Dødens Slange!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "»Fra denne sorte Krog",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 4,
      "text": "Snoer sig Dødens Snog!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 5,
      "text": "»Dom maa der til; men den, der dømmer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 5,
      "text": "Bør mindes vel, Geniets Frugt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 5,
      "text": "Er kun et endeligt Product,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "Der, født af Tiden, med den svømmer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "Han vaage for Critikens Sag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "Hvis han et enkelt Værk berømmer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 5,
      "text": "Men overveie Nat og Dag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Før han – – fordømmer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 6,
      "text": "Thi det er let at rive ned;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 6,
      "text": "Det er ei heller svært at tage;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 6,
      "text": "Men vanskeligt i Tabets Sted",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "At give det Forglemtes Mage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Og frelse hvad der bli’er tilbage.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 7,
      "text": "Gjengangerbreve.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 8,
      "text": "En værdig Plads Du Dig berede i vor Hal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 8,
      "text": "Mens Musers høie Kald Du freidig lyde! –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 8,
      "text": "Alt spirer Laurbærgrenen ved Din Pjedestal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 8,
      "text": "Som engang skal Din Tinding herlig pryde –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 8,
      "text": "Frygt Satyr-Rappet ei, ei Fauner og Sileen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "Ei Momus Haan! Ondt kan kun Ondt fordrive!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Ved Ild, ved Slag maa Guldet luttret blive,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "Og dobbelt kostbar er den slebne Ædelsteen! –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 9,
      "text": "»Bag Ellekrattet nede, hvor Møllehjulet gaaer«.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 10,
      "text": "Flyv over Rhinen til Paris",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 10,
      "text": "Ned til Neapels Paradis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 10,
      "text": "Og hør de hulde Toner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 10,
      "text": "Som bæve der i Aftnens Luft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "Og blandes med Orangens Duft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Høit under Piniens Kroner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "Tilbed Natur og Kunst og Gud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "Men sluk ei Længslen ganske ud;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "Den er en hellig Kjerte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 10,
      "text": "Den flammer evig underfuld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 10,
      "text": "I Elskovs Perle, Venskabs Guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 10,
      "text": "En trofast, venlig Smerte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 10,
      "text": "Da veed jeg, kommer Du engang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 10,
      "text": "Til Kuben her paa Sjællands Vang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 10,
      "text": "Med Rigdom for din smukke Sang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 10,
      "text": "Med uforandret Hjerte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 11,
      "text": "Lad nu din Digterphantasie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 11,
      "text": "Omsvæve som en flittig Bi",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 11,
      "text": "Og bringe dygtig Honning frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 11,
      "text": "Imidlertid os ikke glem!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 12,
      "text": "– – Det Dybe skal det Høie bære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 12,
      "text": "Det største Skib kan ei paa Fladen staae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 12,
      "text": "Det dybt maa vandre, hvis det høit skal svinge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 12,
      "text": "I Storm og Sky, mod Stjernerne sin Vinge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 12,
      "text": "Til venlig Erindring",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 13,
      "text": "Mind Dem og glem ei Danmarks Land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 13,
      "text": "hist under Sydens varme Himmel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 13,
      "text": "glem ikke Danmark, bliv ei svimmel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 13,
      "text": "ved Arnos eller Seinens Strand!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 13,
      "text": "modtag et Raad fra den, der ærlig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 13,
      "text": "har yndet Dem og Deres Pund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 13,
      "text": "tro ei, jeg falde vil besværlig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 13,
      "text": "ved Reisens sidste Afskedsstund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 14,
      "text": "Nyt Phantasien som en Digter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 14,
      "text": "men brug Forstanden som en Mand;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 14,
      "text": "hvor høit man end til Maalet sigter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 14,
      "text": "man vandrer som i Taagers Land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 14,
      "text": "naar Flid og Kundskab ei ledsage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 14,
      "text": "paa Livets Vandring al vor Daad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 14,
      "text": "Lev vel, min Ven! reis! kom tilbage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 14,
      "text": "tilfreds og glad – antag som Plage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 14,
      "text": "ei mit velmeente lille Raad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 15,
      "text": "Eines schickt sich nicht für Alle;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 15,
      "text": "Sehe jeder, wie er treibe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 15,
      "text": "Sehe jeder, wo er bleibe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 15,
      "text": "Und wer steht, daß er nicht falle!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 16,
      "text": "Fornuften i Fornuften = det Sande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 16,
      "text": "Fornuften i Villien = det Gode,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 16,
      "text": "Fornuften i Phantasien = det Skjønne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 17,
      "text": "Hils Mignon i Orangelund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 17,
      "text": "Fra hendes Ven ved Øresund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 17,
      "text": "Og siig, at jeg – skjøndt her paa Grund –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 17,
      "text": "Er sydlig munter, nordisk sund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 17,
      "text": "Og at jeg tænker mangenstund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 17,
      "text": "(Helst naar jeg faaer et lille Blund)",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 17,
      "text": "Paa Mødet i Orangelund!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 17,
      "text": "Saa vil hun studse lidt, men smile,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 17,
      "text": "Og bryde ud: Aah!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 17,
      "text": "Fra",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 18,
      "text": "Reis og nyd med Appetit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 18,
      "text": "Glæden under Palmebuer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 18,
      "text": "Men forglem ei hvad Du skuer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 18,
      "text": "Thi Du seer det paa Credit –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 18,
      "text": "Hvad Du saae i Aar og Dage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 18,
      "text": "– Som Jurist jeg maa forpligte, –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 18,
      "text": "Giver Du os smukt tilbage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 18,
      "text": "I et Bind af smukke Digte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 18,
      "text": "Din Ven",
      "part": false,
      "marginal_notes": []
    }
  ]
}
