  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Iuncker her Errick bad till stalltenn Addellrun",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "y wienter thuo;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "ingenn mand thett weste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "och ingen thett fruo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: Men skuoffuen stander grønn, ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": ":: men skuoffuen staar alle y urtter och y blomster. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Ingenn mand thett weste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "och ingen thett fruo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "for-vden iunker herr Errick",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "och stalten Adellrun.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Saa kaam thett saa widde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "och alt saa wide y ord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "att thett kaam under thieldenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "offuer daner-kongens bord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "\"Haffuer hand iunker her Errick",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "myn datter loffuet y lønn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "saa skall thett koste hans vnge lyff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "och sa hans huide halszbieenn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Tthett wor daaner-kongen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "hand thaaller till suene thuo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "\"Y beder ham iunker her Errick",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "ind for meg gaa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Ind kam hand iuncker her Errick",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "med roser y kiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "\"Huad wilde y myg, daner-koning,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "kerr heerre mynn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "\"Hør thu thett, iuncker her Erick,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "huad ieg siger deg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "haffuer du myn datter lockitt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": "døll thett icke for meg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "Op stuod iunker her Errick,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "hand suarit for seg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "\"Ieg haffuer ret aldrig eders datter locket,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 7,
      "text": "saa sant Gud hielpe meg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "\"Daa lader y nu myn datter kom ind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "att suare for seg;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "haffuer du hender ind lockit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 8,
      "text": "hun døll det icke for meg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "Ind kaam stalten Adelron,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "saa huid som linn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "\"Huad wilde y meg, daner-koning,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 9,
      "text": "kerr fader myn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "\"Hør thu thett, myn kerr datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "huad ieg siger deg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "haffuer iuncker her Errick deg lokitt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 10,
      "text": "saa sig meg thett.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "\"Hand haffuer meg icke lockitt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "och icke lønlig loffuet;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "men mangenn lange wienters-natt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 11,
      "text": "haffuer wy til-samen soffuet.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "\"Haffuer du nu hosz myn datter soffuet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "haffuer du hinder bewilgit der-till,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 12,
      "text": "da skalt du nu giffue hender dyn tro y-dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 12,
      "text": "thett ganger, som herre Gud well.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "Der wor gled y kongens gaard",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "och halff mer gambell:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 13,
      "text": "iuncker her Errick och stalltenn Adellronn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 13,
      "text": "bleff giffuen til-samell.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "Nu leffuer buode dy unge tho",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "mett gled och fryd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 14,
      "text": "stalt Adellron fenge wed iuncker her Errick",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 14,
      "text": "dy søner thre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 14,
      "text": ":: Men skoffuen stander grøn, ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 14,
      "text": ":: men skoffuen stander al vdi ørter och vdi blomster ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}