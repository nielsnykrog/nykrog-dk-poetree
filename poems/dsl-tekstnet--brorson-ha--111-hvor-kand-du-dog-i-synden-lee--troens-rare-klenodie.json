{
  "id": null,
  "title": "111. Hvor kand du dog i synden lee",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
