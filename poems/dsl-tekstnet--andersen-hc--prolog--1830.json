  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Naar Øiet hæver sig mod Himlens Bue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Vi Livet der, som i et Huulspeil skue;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Skybjerge danne sig i Solens Flamme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "De vexle Form, men blive dog de samme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "De flygte brat paa Luftens stærke Strømme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Saa svinder ogsaa Livet og dets Drømme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Men alt, hvad her er stort i Form og Aand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Det tegner ned med trofast Haand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Og Slægt til Slægt bevarer tro dets Minde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Thi ei det sande Store kan forsvinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Naar da Iisblomsten paa vor Rude staaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Og Kunsten tryller os den svundne Vaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Da vinker Templet, som en Blomster-Have,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Hvor Aander stige fra de sjunkne Grave.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Alt Stort og Smukt, som svandt, oplives atter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Og Tidens Vexel vækker Graad og Latter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "– Hist kjæmper , er ei forladt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Kong paa Heden staaer i Storm og Nat;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Vi see begeistret at stride,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Og Valborgblegner ved sin Axels Side.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Saa viser os den høie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Hver fældet Eeg fra Livets store Scene;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Skarpt brydes Lyset i Speil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Der viser Tidens Daarskab og dens Feil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "De sjunkne Borge sees med gyldne Fløie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Og Helte vandre over Østens Høie;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Men Smukt i Dalen staae de Blomster smaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "De Roser røde og Kjærminder blaae;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Hvad Skjalden føler i sin Fryd og Smerte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "Udspringer jo, som Blomster fra hans Hjerte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "Beskedent de for Kjæmpeskaren vige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "Men er en Deel dog af det store Rige;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "Thi samler Svada hver, og kjærligt fletter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 2,
      "text": "Dem i Guirlander, Krandse og Bouketter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 2,
      "text": "Hun tolker deres Farvespil og Duft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 2,
      "text": "Mens Stjernen blinker i den rene Luft.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "O ædle Folk, hvis Bifald er min Stræben,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "Hvad dybt jeg føler bæver mig paa Læben,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "Alt aabnes Hauen, hvor med Skaber-Bliv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "Det svundne Store kaldtes tidt til Liv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 3,
      "text": "Men Helten hilser ei med Sværd og Landse,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 3,
      "text": "Jeg har kun pyntet lidt med Blomsterkrandse,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 3,
      "text": "Jeg Eder s Blomster bringe maae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 3,
      "text": "Dog I vil ei min simple Krands forsmaae!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
