  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift II",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVII75.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Kongen hand lader en haffuefru gribe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": ":: Den haffru dandzer paa tilie. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "och den lader hand y tornett ind sett.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: For hun haffde fremmitt hind wilie. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Droning kaller paa suennen to:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "\"Y beder den haffru ind for mig gaa!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Indt kam den haffru, stedis for bor:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "\"Huad vil y mig, dronning, hui send y mig ordt?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "Dronning hun klapper paa hønde blaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "\"Wilt du, haffru, her huile paa?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "\"Hui wilt du saa forraade mitt lyff?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "der liger under di huasse knyff.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "\"Wedst du dith, saa vedst du mier:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 5,
      "text": "du sig mig aff skebben fler!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "\"Du est med di sønner tre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "din unge lyff lader du for di.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "Den ene skal konning y Danmarck wer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 7,
      "text": "den anden skall kronen med røde guld ber.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "Then tride skall bliffue saa wiss en mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 8,
      "text": "dith unge lyff lader du for ham.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "Hun klede den haffru y skarlagen rødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 9,
      "text": "hun fulde hind till strand med alle hindis møer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "Den haffru satt sig paa bylli blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 10,
      "text": "dronning hind feld saa modig taar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "\"Du tørst icke gred for mig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 11,
      "text": ":: Den haffru dandzer paa tilie. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 11,
      "text": "Himmerigis dør staar oben for dig.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 11,
      "text": ":: For hun haffuer fremmitt hindis vilie. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}