  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Her Iffuer aff Lunde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hand feste synn iumfru y saa kranckenn stundde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": ":: Dett wolder mynn eggenn rose: min hiartte haffuer ey rouff. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Aff Lunde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "hand feste synn iumfru y saa kranckenn stundde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Hand feeste hynder medt saa møgle erre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "och saa luod hand synn brøllup giøre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Saa møggenn erre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "saa luod hand synn brøllup giørre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Denn føste natt, dy samell suo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "daa bleff hun medt thi søner thuo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "Dy samell suoff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "daa bleff hun med thi sønner thuo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Hanns sleffreed-wyff hun giordde dett saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "att hun skulde aldrig børrnne faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "Hun giorde thett saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "att hun skulde alldrig bønne faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Hun skulde aldrig bønen fødde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "imen hun war paa den ø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 5,
      "text": "Børnenn fødde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "imenn hun war paa denn ø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Di førgitiuffue vgger forgangen war:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "stalt Mettelild tager till at lange saa saare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 6,
      "text": "For-gangene war,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "stalt Mettelild tager till at lange saa saare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Dy fulde hynd vd, thy fulde hynd innd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "menn icke daa bleff hyndis pinne dess mindde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 7,
      "text": "Vd och innd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "menn icke daa bleff hyndis pinne diess minde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "\"Men ieg kand huerkind løffue eeller død:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "daa fører meg dyd, som y hientte meg møø!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 8,
      "text": "Løffue eller død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "daa fører meg dyd, som y hientte meg møø.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Her Iffuer hand tuog hynder y synn arum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "\"Och y toller huerckind ganger eller karum.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 9,
      "text": "I synn arum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "\"Och y thaaller huerkind ganger eller karum.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "\"Imend ieg kaand icke kaarmen lydde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "thaa well ieg paa mynn fuod hynd-skridde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 10,
      "text": "Kaarmenn lyede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "paa mynn fuod weell ieg hyen-skridde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Bortt gick stalltt Meettellild, enn rosse saa rød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "hynder fuld buodde fruer och møørr.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 11,
      "text": "Enn rose saa rød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "hynder fulde buode fruer och møørr.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Frw Giøreell hun vd aff wyenduett suo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "hun suo synn datter y lundenn gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 12,
      "text": "Wenduuett suo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "hun suo synn datter y lunddenn gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "\"Weell wuorde meg alle mynne stundde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "ieg sieer mynn daatter y rosenns-lund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 13,
      "text": "Mynn stundde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 13,
      "text": "ieg sier myn datter y rosens-lund.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "\"Sleett inthett tha thør y gleedde edder:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "for ald denn ynnck, y maa siee paa meeg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 14,
      "text": "Gleedde edder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "for ald denn ynck, y maa siee paa meeg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Bortt gyck frw Giøreeld, enn frwe saa guod:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "och saa gyck hun synn datter imuod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 15,
      "text": "Enn frue saa guod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 15,
      "text": "och saa gyck hun synn datter imuod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "\"Weell-komenn, stalltte Meettelild, datter mynn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "huy komer du saa gangind hyd?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 16,
      "text": "Datter mynn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 16,
      "text": "huy komer du saa gangind hydd?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "\"Tthett war myn here hans største harum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "thett ieg tholde huerkind ganger eller kaarum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 17,
      "text": "Sttørste harum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 17,
      "text": "thett ieg tholde huerkinnd g. e. k.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "Hyndis thieenste-møø hun suaredtt ett ord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "\"Hans sleeffred-wyff haffuer hynder forgiordtt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 18,
      "text": "Suaridtt ett ord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 18,
      "text": "\"Hans sleeffred-wyff haffuer hynder forgiordt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "Hun haffuer hinder for-giordt saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "at hun skulle aldrig barnedt faae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 19,
      "text": "For-giordt saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 19,
      "text": "at hun skulle aldrig barnedt faae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "Det hun skulle aldrig barnedt føde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "i-mens hun war paa denne øe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 20,
      "text": "Barnedt føde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 20,
      "text": "i-mens hun war paa denne øe.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "\"I tender nu op liusset brat!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "her will icke soffuis i denne nat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 21,
      "text": "Op liusset nu brat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 21,
      "text": "her will icke soffuis i denne nat.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 21,
      "text": "Thi sluo offuer hynd skaarlagenn-skieend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "saa fulde thy hinder y fruerstuoff ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 22,
      "text": "Skaarlagenn-skiend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 22,
      "text": "saa fuldde thy hyndder y fruerstuoff ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 22,
      "text": "Dy baar ind thy bollster bllaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 22,
      "text": "dy giordde staalt Mettelilds senng der-paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 23,
      "text": "Bolster blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 23,
      "text": "dy giorde stalt Meettellilds seng der-paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 23,
      "text": "\"Y recker nu op a alle edders haand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 23,
      "text": "beedder herre Gud løsse mynn haarde boonnd!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 24,
      "text": "Edders haand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 24,
      "text": "beedder herre Gud løsse mynn haarde boond!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 24,
      "text": "\"Dw wer selliff wed en fuld-guod thrøst!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 24,
      "text": "dynn haarde boond bliffuer fuld weell løst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 25,
      "text": "Enn fuld-guod thrøst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 25,
      "text": "dynn haardde boond bliffuer fuld weell løst.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 25,
      "text": "Thett skieede vdj thennd saame dag:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 25,
      "text": "staalt Meettelild føøde thi sønner smaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 26,
      "text": "Saame dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 26,
      "text": "staalltt Meettellild fødde thy sønner smaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 26,
      "text": "Stalltt Mettelild thaaller till synn muodder daa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 26,
      "text": "\"Y laadder myn herre denn thyyding faa!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 27,
      "text": "Muodder daa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 27,
      "text": "\"Y laadder mynn heerre denn thyding faa!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 27,
      "text": "Heer Iffuer hand ind aff dørrenn threend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 27,
      "text": "staltt Mettelild recker hanom hanndenn igenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 28,
      "text": "Dørenn threennd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 28,
      "text": "stalltt Mettellild reecker hanom haandenn igeenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 28,
      "text": "\"Y wer weell-kommenn, kieerre herre myn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 28,
      "text": "kerre muoder, ladder hanom mynn sønner siee!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 29,
      "text": "Herre mynn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 29,
      "text": "keerre muodder, laader hanom mynn sønner siee!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 29,
      "text": "Her Iffuer tog dennom y syn arum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 29,
      "text": "\"Och loffued werre wor heeris naffuenn!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 30,
      "text": "I synn arum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 30,
      "text": "\"Och luoffuett werre wor herris naffuen!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 30,
      "text": "For ald denn gleedde her Iffuer feeck:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 30,
      "text": "thett staltt Mettelild till synn muodder gyck.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 31,
      "text": "Her Iffuer fieck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 31,
      "text": "thett stalltt Meettelild till synn muoder gyck.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 31,
      "text": "\"Loffuett werre Gud, deeg frelste aff harum!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 31,
      "text": "Saa tuog hand stalltt Meettelild y synn arum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 32,
      "text": "\"Freelste aff harum.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 32,
      "text": "Saa tog hand stallt Mettlild i synn arum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 32,
      "text": "Hand gaff stalltt Meetteld thett guld saa rød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 32,
      "text": "synn sleffred denn luod hand brindde y glød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 32,
      "text": ":: Thett woolder y meg, en rose: mytt hiartte haffuer ey ruo. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}