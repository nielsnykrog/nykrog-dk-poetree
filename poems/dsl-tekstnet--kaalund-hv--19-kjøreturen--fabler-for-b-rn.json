  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Du, Moppe, er Prins, og jeg er din Kudsk;",
      "part": false,
      "marginal_notes": [
        "Speaker: Drengen:"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "i Hatten jeg har en Persilledusk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "saa kjøre vi ud i Byen, skal Du vide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "den dejligste Sabel jeg har ved min Side;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Du sidder i Kassen som i en Kareth -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Da skulde man Moppes Ansigt set.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Spadille alt noget til Aarene var;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "han tænkte: gid Pokker være din Nar!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Som Kudsken smurte paa Hestene kjæk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "sig listede Moppen sagte væk;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "men Drengen kjørte omkring paa Pladsen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "han troede, at Moppen sad i Kassen.",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
