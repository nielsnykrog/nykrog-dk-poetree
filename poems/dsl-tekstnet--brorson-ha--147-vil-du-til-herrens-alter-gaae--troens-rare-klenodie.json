{
  "id": null,
  "title": "147. Vil du til HErrens alter gaae",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
