  "source": {
    "id": null,
    "title": "Een ny handbog med Psalmer oc aandelige lofsange",
    "year_published": 1529,
    "publisher": "Ludwig Dietz",
    "printer": "Ludwig Dietz",
    "place": "Rostock",
    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/dietz-salmebog-1529/8/13"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "TJll teg rober ieg aff hiertens grund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "O Herre Gud tw hør mÿn røst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "lad op thÿn ørhen ÿ thenne stund/",
      "part": false,
      "marginal_notes": [
        "Psal. cxlij."
      ]
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "oc hør mÿn bøn oc wer mÿn trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Thÿ om tw wilde meg rett/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "effter mÿn ondskab som ieg haffuer fortiænt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "tha er ieg borte med alle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Hooss teg dwer ey vden miskundhed:",
      "part": false,
      "marginal_notes": [
        "Esaie. lxiiij Philip. iij."
      ]
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "wor synder att forlade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "forgiæffs er all wor hellighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "tw wilt hannwm inthet haffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "J thÿn aasiwn ey funden war/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "noghen menniske reen eller klar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "the ere synder alle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "For then skyld wil ieg sette mit haab/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "till Guds miskund oc naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "oc ey till mÿn werdskyld eller raad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "thÿ thet er ey vden waade/",
      "part": false,
      "marginal_notes": [
        "Hiere. xvij"
      ]
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Gud haffuer meg iætt then ewige roo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "thet er mÿn trøst oc stadelig tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "hans ord kan icke liwe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Oc om ieg skulde en bie til qweld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "oc indtil morgen stierne/",
      "part": false,
      "marginal_notes": [
        "Abakuk. ij. Psalm. xxj Psal. cxlij."
      ]
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "mit haab ieg aldrig forlade wil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "ieg wil hannwm tro saa gierne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Som hans folk Jsrael haffuer giord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "aff hiertens grund som wÿ haffue spord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "han wor theris haab allene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Thÿ han er mild oc miskundelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "han er all fuld aff naade/",
      "part": false,
      "marginal_notes": [
        "Psal. xxxiij"
      ]
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "han wil aff rett barmhiertighed/",
      "part": false,
      "marginal_notes": [
        "Titum. iij. Johan. j. Coloss. j."
      ]
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "wore synder alle forlade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Thÿ han er thet vskyldige lam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "som oss aff dieffuelsens fengzel nam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "oc giorde oss klare oc reene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Gud fader Søn oc then Helliaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "hannwm wille wÿ prÿse oc ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "thÿ oss haffuer ingen frelst vden hand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "som wÿ aff schrifften lære/",
      "part": false,
      "marginal_notes": [
        "Deu. xxxij. Esaie. xlij."
      ]
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "Thÿ bør hannwm loff oc tack alleen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "til ewig tÿd for vden meen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "ther til sie wÿ nw AMEN.",
      "part": false,
      "marginal_notes": []
    }
  ]
}