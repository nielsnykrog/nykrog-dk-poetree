{
  "id": null,
  "title": "Sang i Brudehuset ved Fröken Augusta Bournonvilles og Pastor M. P. Tuxens Bryllup, den 21de April 1852",
  "year_created": 1852,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1852,
    "url": "https://tekstnet.dk/books/andersen-hc_sang-i-brudehuset-ved-froeken-augusta-bournonvilles-og-pastor-m-p-tuxens-bryllup-den-21de-april-1852/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Der er en Ö, derhen fra hele Landet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "I Krigens Tid, vor Alvors-Tanke drog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "En deilig Ö, en Æblegreen paa Vandet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Et Seirens Grönt omkring vort Dannebrog.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Nu er der Fred og Solskin, Fugle-Qvidder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "I Skov og Enge mylre Blomster frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Foraaret der i Præstens Have sidder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Han og hans unge Hustru ventes hjem!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "De komme, fulgt’ af vore glade Sange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "De drage ind, i eget Hjem er bedst!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Snart Roserne igjennem Havens Gange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Vil ogsaa feire Parrets Bryllups-Fest;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Og Kukkeren vil sige: »leve længe!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "I Droslens Sang vil höres Hjertets Slag;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Hvor ret man elsker, Hjertets skjulte Strænge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Forkynde: det hver Dag er Bryllups-Dag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Det nye Hjem vi denne Skaal vil bringe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Oprul for dem et Samliv minderigt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Der Sjælen folde ud sin stærke Vinge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Jordlivet blive dem et Skjönheds-Digt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Forældres Bön som Dug velsignet falder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "I Fryd og Sorg hold fast, Gud er jo med,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Vor Sang idag, læs den i sölvgraa Alder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Den bliver ung, som Eders Kjærlighed!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Ja Tiden har en Flugt, som vore Tanker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Og Tiden ruller store Dramer op,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Men hvor i Kjærlighed to Hjerter banker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Udfolder sig hvert Haabets Rosenknop.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "– Der, hvor Kanoner löd i Krigens Dage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Nu Lærken synger, Nattergalen slaaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Med Gud ind i det nye Hjem I drage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Sölv-Bryllup der om fem og tyve Aar!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
