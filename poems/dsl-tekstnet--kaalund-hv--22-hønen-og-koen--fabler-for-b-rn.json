  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "En lille, vanskabt løjerlig Ting",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "blandt Kyllingeflokken tripped omkring.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Den var tilovers, den peb og klynked,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "og Alle, som saae den, Staklen ynked;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "kun Hønsemoderen rørte det ej,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "hun skrukked og kagled: Pak sig sin Vej!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Forstødt af sin Slægt, det fattige Kræ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "i Stalden søgte et Fristed og Læ;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "dér fik den Lov til at bygge og bo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "i Baasen hos den godmodige Ko.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Dens kjæreste Plads var paa Koens Ryg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "dér jaged den bort baade Fluer og Myg.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
