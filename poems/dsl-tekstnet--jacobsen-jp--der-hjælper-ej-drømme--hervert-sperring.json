  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Der hjælper ej Drømme saalidt som Digt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Er Fondet end aldrig saa stort og rigt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Ej Kjærlighed bærer, faar Livet ej drage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Sin Aande i Miner saavelsom i Ord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Om ikke Erindring fra levede Dage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Kan klinge deri som et tankerigt Chor.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Vel ejed' en Barndom jeg skjøn og rig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Men Barndommen er kun det ulmende Liv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Og aldrig fik levet jeg Ynglingelivet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Det drømte jeg bort, ak! i Skyggernes Land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Fik aldrig med Verden i Kast mig givet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Har ej været Yngling – og nu er jeg Mand",
      "part": false,
      "marginal_notes": []
    }
  ]
}
