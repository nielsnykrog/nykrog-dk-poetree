  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "IEgh tacker the edhlæ danskæ men",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "och loffuer oc prijsser them hwer oc en,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "the som meg skickede i koningæ macth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "saa bør hwerth quinfolk aff syn acth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "hwn giordes them alldrig som ieg nw tror.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "The mwæ wæl bæræ theris howeth høyth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "ath them haffuer sodan æræ møth:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Eth quinfolk skullæ then ære faa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Tha ieg fick kommen myn ting tijl stadh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "tha wor ieg i mith hiarthæ gladh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Wedh Slethen bygdhe ieg Hedeby",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "ath ieg skullæ haffue thet tijl ath fly.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "the willæ ey faldhe megh længher tijl fodh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "The sade the willæ faa them en mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "som raadhe kundhe bether for rygæ oc land.",
      "part": false,
      "marginal_notes": []
    }
  ]
}