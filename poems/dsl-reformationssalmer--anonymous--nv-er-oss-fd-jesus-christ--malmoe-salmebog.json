  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "NV er oss fød Jesus Christ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Aff en Jomffru det er vist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "For vden mandz beblandelse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Er han kommen aff høgeste vor salighed",
      "part": false,
      "marginal_notes": [
        "Math i Luce i Ezech xxxvii"
      ]
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Gud være met oss Emanuel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Den bebudede Gabriel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Der til er vidne Ezechiel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Han kom til oss vor frelsere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Gud faders søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Fuldkommen er nu Dauidz dict/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Der till oc saa Propheternis schrifft/",
      "part": false,
      "marginal_notes": [
        "Psa cxiiii"
      ]
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Christus er det Engelske liuss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Som hyrderne saage i krubben laa",
      "part": false,
      "marginal_notes": [
        "Luce iii"
      ]
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Jth menniske",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Den som kom aff hiemmelen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Han atspurde mennisken/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "Ey quinde eller nogen mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "forderffue nogen tid wille hand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "O miskundhed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "J Christne børn forsamles nw/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "met Christ eder broder værer glade oc fro/",
      "part": false,
      "marginal_notes": [
        "i Petri ii"
      ]
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "Giffuer hannem loff wor Konning viss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "Som oss forhuerffde den ewig priss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "Euindelig",
      "part": false,
      "marginal_notes": []
    }
  ]
}