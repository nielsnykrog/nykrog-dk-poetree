  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Herttugenn vd-aff Bronnswyg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "huor feynnder mand ienn ygenn nu slyg!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Vd-aff Bronnswyg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "huor fynnder mand ienn ygenn nu slyg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Antenn tell dyster och helder tiell huoffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "der thuorde sytt lyff saa mandelig wuoffue!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Helder tell hoffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "der thuorde sytt lyff saa mandellig wuoffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Hand stryde ind for Ørrsell-haff:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "och hand stride ind till den hellige graff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "For Ørrsell-haff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "och hand stride ind till den hellige graff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "hand stride, den herre, som hand well kunde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "hand stride ind for Babelund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "Som hand well kunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "hand stride ind for Baabelund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Hertugen wagner om mydynatt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "\"Myn hiarttens-keere, meg er icke gaatt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "Om mydynatt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 5,
      "text": "\"Myn hiarttens-keere, meg er icke gaatt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Fanger ieg icke aarloff bratt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "daa thøffuer ieg icke y denne natt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 6,
      "text": "Orluoff bratt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 6,
      "text": "daa thøffuer ieg icke y deenne natt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "\"Orluoff well ieg icke for eder spaare:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "myn edlige herre, huort well y faarre?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 7,
      "text": "For eder spaare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 7,
      "text": "myn edlige herre, huort well y faarre?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "Nar maa ieg laad brøge och blende?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "och naar well y kome hiem igen?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 8,
      "text": "Brøgge och blende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 8,
      "text": "och naar well y kome hiem igenn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "\"Om syuff aar maatt du laad brøgge och bleende:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "och daa well ieg kome hieem igenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 9,
      "text": "Brøgge och blende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 9,
      "text": "och daa well ieg kome hiem igenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "Men komer ieg icke om syuff aars frest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "da luoff denn suend, thett thu vnder best!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 10,
      "text": "Syuff aars frest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 10,
      "text": "daa luoff denn suend, thett thu vnder best!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "Men merck weell dy ord, ieg well dieg syge:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "du leeg alldrig haarre y biørnens lieee!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 11,
      "text": "Ieg well dieg syge:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 11,
      "text": "du leeg alldrig haarre y biørnens liee!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "Saa drog hand ymuod den hiedenske harrre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "fangitt bløff herttugenn, thett wor werre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 12,
      "text": "Hiedenske heerre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 12,
      "text": "fangenn bløff herttugen, thett wor werre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "Hand spenntte hanom buode y haare och pluoff:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "saa well thientte hand den hiedenske frw.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 13,
      "text": "Haarre och ploff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 13,
      "text": "saa well thientte hand thend hiennske frwe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 13,
      "text": "Ther waar hand y otte aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "med dybbe wuonder och blodig saar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 14,
      "text": "Y otte aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 14,
      "text": "med dybbe wuonder och blodig saar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "Hyndis herre skulde aff landen faare:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "aff thornitt luod hun denn hartug gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 15,
      "text": "Landitt ffaare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 15,
      "text": "aff thornitt luod hun denn hartug gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 15,
      "text": "Hun gaff hanom mad, men hand kund berre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "och skoffuen er VII ugers feerdtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 16,
      "text": "Men hand kund berre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 16,
      "text": "och skoffuen er VII vgers feerdtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 16,
      "text": "Skoffuen er VII vgers feerdtt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "vdy synn staff baar hand synn suerdtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 17,
      "text": "Vggers faard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 17,
      "text": "vdi synn stauff baar hand synn suerd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 17,
      "text": "Hertugenn gaar att wieenn fram:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "saa vnderlig thieng emthyrritt haam.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 18,
      "text": "Att wieenn fram,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 18,
      "text": "saa vnderlig thing emthyrritt ham.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 18,
      "text": "Hand suo seg op vnder ett thre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "en løffue och liende-orum fegttes der.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 19,
      "text": "Vnder ett thre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 19,
      "text": "en løffue och lynd-orum fegttis der.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 19,
      "text": "\"Well-komen, hartug Henddrik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "myn edelig herre aff Brunszuig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 20,
      "text": "Henddrik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 20,
      "text": "myn edelig herre aff Brunszuig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 20,
      "text": "Willtt thu, hertug Henddrik, hielpe meg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "saa gierne daa well ieg thiene dieg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 21,
      "text": "Hielpe meg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 21,
      "text": "saa giernne daa well ieg thienne dieg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 21,
      "text": "\"Herre Gud gyffue, ieg matte were thett waard:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 21,
      "text": "att wieee den lyndorum med mytt suerd!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 22,
      "text": "Matte were thett werd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 22,
      "text": "att wiee den lyndorum med mytt suerd.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 22,
      "text": "Thend herre huog, och løffuen bied:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 22,
      "text": "thy hog denn lynd-orum y synn sueed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 23,
      "text": "Løffuenn beed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 23,
      "text": "thy hog thend lynd-orum y syn sued.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 23,
      "text": "Thend here gyck ygiemell den lund:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 23,
      "text": "løffuenn fulde hanom som hanns brødige hund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 24,
      "text": "Ygiemell den lund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 24,
      "text": "løffuenn fulde hanom som hanns brødige hund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 24,
      "text": "Hartugenn gyck att wieen fram:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 24,
      "text": "saa vnderlig thynng wyndthyrris hand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 25,
      "text": "Wieenn fraam:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 25,
      "text": "saa vnderlig thinng wynthyris hand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 25,
      "text": "Hand suo seg op vnder ett thre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 25,
      "text": "ther saad ett iaren-mett och klaffuett seeg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 26,
      "text": "Op vnder ett thre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 26,
      "text": "ther saad ett iaren-mett och klaffuett seg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 26,
      "text": "\"Welkomen, hertug Hendrik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 26,
      "text": "du edlig her aff Brunsuig!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 27,
      "text": "Henndrick,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 27,
      "text": "du edlig herre aff Brunswig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 27,
      "text": "Du sette deg neder och huile deg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 27,
      "text": "men ieg well bedde mynn skaaber for dieeg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 28,
      "text": "Och huile deg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 28,
      "text": "men ieg well bedde mynn skaaber for dieeg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 28,
      "text": "Hand saatte seeg neder och feeck en huylle:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 28,
      "text": "engellenn baar hanom syffhundertt mylle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 29,
      "text": "Hwille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 29,
      "text": "engellenn baar hanom syuff-hundrett mylle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 29,
      "text": "Op wognett denn herre, hand bløff saa glad:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 29,
      "text": "hand hørrde en hiørde, paa thysk hand quad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 30,
      "text": "Hand bløff saa glad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 30,
      "text": "hand hørrde en hiørde, paa thysk hand quad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 30,
      "text": "\"Hør dw thett, hiørde, thu syge meg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 30,
      "text": "huesz er thett fiee, thu dryffuer for deg?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 31,
      "text": "Tthu syge meg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 31,
      "text": "huesz er thett fiee, thu dryffuer for dieg?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 31,
      "text": "\"Staadenn hieeder Brunsuig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 31,
      "text": "myn herre hand hieede hertug Hendrick.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 32,
      "text": "Brunsuig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 32,
      "text": "myn herre hand hieede hertug Hendrick.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 32,
      "text": "Syddenn vy mieste den edlige herre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 32,
      "text": "och daa stuod staaden halle waare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 33,
      "text": "Denn edelige herre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 33,
      "text": "och daa stuod stadenn halle waare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 33,
      "text": "Imorgen skall der ett brølup werre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 33,
      "text": "y Brunswig med hans hiartens-kierre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 34,
      "text": "Ett brølup werre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 34,
      "text": "y Brunswig med hans hiartens-kierre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 34,
      "text": "Ther giffues buode øll och mad:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 34,
      "text": "gack du dy! saa blyffuer du glad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 35,
      "text": "Øll och mad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 35,
      "text": "gack du dy, saa blyffuer dw glad.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 35,
      "text": "Thend harre hand gyck saa bratt att steed:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 35,
      "text": "neddre for den puortt daa saatte hand seg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 36,
      "text": "Saa bratt att steed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 36,
      "text": "neddre for den puortt daa saatte hand seg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 36,
      "text": "\"Hør dw, porttener, huad ieg sygger deg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 36,
      "text": "du bied denn brud-gum thaalle med meg!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 37,
      "text": "Sygger deeg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 37,
      "text": "dw beed denn brwdgum thaalle med meg!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 37,
      "text": "Vddenn for denn gyldene portt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 37,
      "text": "der møtte denn brudgum den pylligrim bratt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 38,
      "text": "Denn gyldene portt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 38,
      "text": "der møtte denn brudgum den pylligrim bratt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 38,
      "text": "\"Huad mone dw, pyllygrym, tell meg kyende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 38,
      "text": "men dw meg saa dreslig buoden seende?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 39,
      "text": "Kieende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 39,
      "text": "men dw meg saa drestelig buodenn seende?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 39,
      "text": "\"Saa giørllig monne dw meeg kiende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 39,
      "text": "der wy buode for plogen weende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 40,
      "text": "Dw meeg kiende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 40,
      "text": "der wy buode for plogen weende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 40,
      "text": "Der du dragst hiem, sagde, ieg war død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 40,
      "text": "och da swegst du thit rette brød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 41,
      "text": "Sagde, ieg waar død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 41,
      "text": "och daa swegst du thitt rette brød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 41,
      "text": "Raag aff mynn skieeg, skeer aff mynn haard!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 41,
      "text": "saa maatte du sie myne dybe saar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 42,
      "text": "Skeer aff mynn haar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 42,
      "text": "saa maatt du sie myne dybe saar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 42,
      "text": "Ieg weeld gyffuer deg en anden guod gaffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 42,
      "text": "och seelleff weell ieg mynn høstru haffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 43,
      "text": "Andenn guod goud gaffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 43,
      "text": "seelleff weell ieg myn høøstru haffue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 43,
      "text": "Saa glaad wor alle thi Bronsuig-mennd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 43,
      "text": "ther thy finge derris rette herre igenn.",
      "part": false,
      "marginal_notes": []
    }
  ]
}