{
  "id": null,
  "title": "Ebbe Tygesøns Dødsridt",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA124.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Ebbi hannd drømbte enn drømb om nattenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Saa thuoge thy Ebby Tyggesenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "lagde hanom paa gyldene baarre;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "eftter ryder hans festemø",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "paa denn ganger, hand bleff slaagenn paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Some thy groff graffuenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "och sume dy woxelyss snodde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "alltt suod Ebis feestemøø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "hun wordtte y hoffuenn saa muod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Some thy groff graffuenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "och some thy woxelyss theende;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "alltt saad Ebbis festemøø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "hun mone syn herre wyndtte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "\"Gud naade deg, Ebby Tygesenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "huy komer du icke hiem?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "dynn muoder haffuer faaitt saa stuor enn sorrig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "for synn kierre søster-sønn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Saatte thy thend lyge-baare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "paa thett kiercke-guold;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "frem daa gyck thy fruer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "thy offrede thett røde guld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "Frem daa gyck thy fruer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "thi offrede thett guld saa rød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "\"Staar op, Ebbis festemø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "laader myndis, eders herre er død!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "Frem gyk Ebbis feestemø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "hun løfftte op huydenn lynn;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "saa giørlig keennde hun synn feestemand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "hun daanitt tiell iord der-weed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "Thett wor Ebbis feestemøø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "hun kieendis weed hanom saa bratt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "thett well ieg for sandingenn syge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 0,
      "text": "hyndis hiartte y støcker brast.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 0,
      "text": "Thett wor ynnck att sie der-paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 0,
      "text": "forglemptt waar løst och gamell;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 0,
      "text": "Ebby och hans festemøø",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 0,
      "text": "dy kaam y graff tiell-sammell.",
      "part": false,
      "marginal_notes": []
    }
  ]
}