{
  "id": null,
  "title": "Esben og Malfred",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA120.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Der buor en fru vdy Selland,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hun haffuer icke datter for-vdenn ienn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": ":: Imenn syødenn ruor vnder. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Hun haffuer icke datter for-vdenn ienn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "hynd rige her Espenn throloffuitt hynder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "Her Oluff och hans datter thi saad offuer buord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "thy snakitt saa mangt ett gambells-ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "\"Och mynn kerre datter, du syge thett meg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "alltt om her Espenn haffuer loffuett deg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "Lenge saad staltt Maallfred och tengtte der-paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "huad an-suar hun skulde synn faader faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "Alltt som thy saad och thaalde dy ord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "ind kaam lydenn smaadreng och stedis for buord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "\"Her seeder y, her Olluff, er suøbtt y muord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "her holder en rider aff Skaane vdi wor gaard.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "Alle saad thi iumfruer saa hiemellig och luo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "men Mallfred hun rødemer som ett blod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "Her Espenn hand suøber seg hoffuett y skiend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "hand gaar y lofftt for her Olluff ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "\"Her sieder du, her Olluff, och drecker wynn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "gyff mig staalltt Mall-fred, datter dynn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 10,
      "text": "Tthett suaridtt her Olluff, een mand saa fynn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "\"Myn datter er dynn och icke mynn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 11,
      "text": "Mynn kierre datter haffuer loffuett deg thruo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "meg haabis tiell Gud, du blyffuer hynd guod.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 12,
      "text": "Tther waar glede och halleff størr gambell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "saa luod dy gyffue dy unge thuo samell.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 13,
      "text": "Vdy tholl aar thy saamell waar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "och XI børnn hun till waarden baar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 14,
      "text": "Tthett lackiede fast att thett XIII aaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "thett thøltte baarnn hun med waar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 15,
      "text": "\"Nu well ieg faare tiell frender dynn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "och byde dynn faader till barsell hiem.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 16,
      "text": "\"Her Espenn, her Espenn, y drager icke bortt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "y dragis till mynde, huad forlangenn er spaadt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 17,
      "text": "Tthett bleff mig spaadtt, ther ieg waar ung,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "att alle myn skiebben skulde blyffue mig thuonge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 18,
      "text": "Tthett bleff meg spaadtt saa lydell en møø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 18,
      "text": "vd-aff myn tholtte baarnn skulde ieg døø.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 19,
      "text": "\"Tthi spaa-quinder well wy laade sette y baand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 19,
      "text": "och thaage wor lyøcke aff heere Guds haand.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 20,
      "text": "Her Espenn vd aff gaardenn reed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 20,
      "text": "igenn stuod Mallfred, synn hender hun wred.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 21,
      "text": "Mallfred gaar seg vdi burre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 21,
      "text": "hun føder enn sønn saa prude.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 22,
      "text": "Hun føde enn sønn altt med stuor nød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 22,
      "text": "alt for dett baarnn saa matte hun død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 23,
      "text": "Der wor ønck ock halleff stør haarum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 23,
      "text": "staltt Mallfred døde y synn moders arum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 24,
      "text": "Alltt thett her Espenn y lieeding waar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 24,
      "text": "huer natt dromtte hand om syn hiarttens-kieerre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 25,
      "text": "\"Meg drømer, meg drømer, och thett er saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 25,
      "text": "saa rade Gud, huor staltt Mall-fred hun maa!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 26,
      "text": "Her Espenn hand thaaller tiell styrris-mand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 26,
      "text": "\"Du wynd op seggell, du wynde tiell land!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 27,
      "text": "Her Espenn luod styrre sytt skibb for laand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 27,
      "text": "hans søner dy gaar paa huydenn saannd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 28,
      "text": "\"Och huy daa kleder y nu saa suortt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 28,
      "text": "y waar alle rød, der ieg drog borrtt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 29,
      "text": "\"Wy haffuer for-loffuett wor kleder saa rød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 29,
      "text": "for wor kerre modder och hun er død.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 30,
      "text": "\"Och ycke well ieg thend thaalle thro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 30,
      "text": "alt førind ieg hørrer mynn muoders ord.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 31,
      "text": "Tthett wor herre Espenn, hand kaam tiell borige-lieed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 31,
      "text": "vd stuod hans kierre muoder, huiller hun seg wed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 32,
      "text": "\"Her staar y, myn kierre muoder, y er well suøbtt y skiennd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 32,
      "text": "huor lyder hynder Maallfred, aller-kiereste mynn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 33,
      "text": "\"Sttaltt Mallfred er y lofftet syg, och ilde der hun maa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 33,
      "text": "hynnd gaar fruer och staltte iumfruer buode tiel och fraa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 34,
      "text": "Her Espenn klaper synn muoder weed huiden kiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 34,
      "text": "\"Laader meg gaa tiell mynn kierest och ind.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 35,
      "text": "\"Och mynn kier sønn, ieg sygger deg nød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 35,
      "text": "stalltt Mald-fred er aff baarne død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 36,
      "text": "Hun haffuer fød en sønn buode fuor och fynn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 36,
      "text": "for hanom luod hun sytt vnge lyff.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 37,
      "text": "Her Espenn hand fallmer rosens-kyend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 37,
      "text": "\"Y lader mig sie allerkereste mynn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 38,
      "text": "Her Espenn hand gaar y stuoffuen ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 38,
      "text": "och der fand hand den lydelle kynnd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 39,
      "text": "Hand tog thett baarnn vdi synn fauffuen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 39,
      "text": "hand køste thett well thusynde gange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 40,
      "text": "Hand lagde thett baarnn paa huide lynn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 40,
      "text": "\"Rett aldrig sierr du mieere fadder dynn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 41,
      "text": "Hand sluo op offuer Mallfreedt thi huide lynn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 41,
      "text": "och død mynditt hand aller-kiereste synn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 42,
      "text": "Her Espenn hand tøgtte thett were stuor nød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 42,
      "text": "\"Stalt Malfred hun er for myn skyld død.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 43,
      "text": "Her Espenn drog vd for-gyldenne knyffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 43,
      "text": "hand skylde seg sielleff wed sytt vnge lyff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 44,
      "text": "Tthett war stuor ynck och halle miere gamell:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 44,
      "text": "thy kaam buode y en graff til-sammell.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 44,
      "text": ":: Mens sødenn rorr vnder. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}