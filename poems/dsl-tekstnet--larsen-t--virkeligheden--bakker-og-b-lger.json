{
  "id": null,
  "title": "Virkeligheden",
  "year_created": 1912,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Thøger Larsen",
    "country": null,
    "wiki": "Q323530"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Bakker Og Bølger",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1912,
    "url": "https://tekstnet.dk/books/larsen-t_bakker-og-boelger/015/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Solglimt fra de gamle Floder,",
      "part": false,
      "marginal_notes": [
        "Speaker: KVINDEKOR"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "der i Sagnets Eden flød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "ejed Moder efter Moder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "i sit Øjes Ungdomsglød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Af den Drøm, vort Køn har arvet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "blev vort eget Øje farvet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Smilets Glar og Graadens Vande",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "dølger de fortabte Lande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Muld og Hav vort Væsen drage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "med en større Klodes Skær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Jord, vi kalder: Kom os nær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "og vær vor i vore Dage!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Løndom, som i Græsset gror,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Løndom, som i Bølgen bor!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Fyld med Liv vor Længsels Skaaler!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Giv os Sjæl af dine Straaler!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Ud af Elementerne strømmer Sjælenes Kræfter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Sønner og Døtre følger Fader og Moder efter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Øjne, som Skummets Øjne ved Havets Bred,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "aabnes i Nuet og blændes af Evighed;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "de stirrer mod Jorden i Tørst efter Tingenes Sandhed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "den slaar dem med Solskinsdagens syvfarvede Blindhed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "Virkelighed! Finder vi aldrig dig?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "Ved blaa Søer gaar de blaaøjede Piger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "Lyshaarede Børn plukker Blomster paa Danmarks Diger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "Bakkerne spejler Agrenes Farver i Fjordene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "Duggede Brøl stiger i Dalen paa Hjordene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "Hvor det er fjernt og nær! En Dag af tusinde Aar –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "en Dag, i hvis Frugtbarhed alt det forgangne staar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "Virkelighed! Finder vi aldrig dig?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "Enge med dette Græs! Bølger ved disse Strande!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "Eders Hemmelighed er de fortabte Lande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 0,
      "text": "Aarmillioners Lyst skinner i Kvindernes Sang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 0,
      "text": "naar de ved Barnets Søvn holder dets Vugge i Gang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 0,
      "text": "Unge Mænd og Kvinder! Grib Nuet! Se og hør.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 0,
      "text": "Virkeligheden synes nær – som ingen Sinde før.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 0,
      "text": "Jeg staar i Dag paa Stjernens Hvælv.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 0,
      "text": "I mig dens Kræfter strømmer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 0,
      "text": "Jeg føler Stjernen i mig selv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 0,
      "text": "hvor alle Farver drømmer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 0,
      "text": "De Drifter, som i Ungdoms Sang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 0,
      "text": "mod Himlens Vidder tindre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 0,
      "text": "af dybe dulgte Kilder sprang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 0,
      "text": "i Jordens eget Indre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 0,
      "text": "Af Muld og Hav sprang Livet frem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 0,
      "text": "i fjernt forglemte Tider.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 0,
      "text": "Til Muld og Hav gaar Livet hjem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 0,
      "text": "hver Gang det Døden lider.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 0,
      "text": "Og alle Ting, jeg kommer nær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 0,
      "text": "har Dyb, jeg aldrig maaler.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 0,
      "text": "Ej røber Solen, hvad de er,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 0,
      "text": "men kun, hvordan de straaler.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 0,
      "text": "Dog nærmer Verden sig saa øm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 0,
      "text": "Og Maanen over Haven",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 0,
      "text": "er som fortabte Sjæles Drøm",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 0,
      "text": "om Solens Skin – i Graven.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 0,
      "text": "Det er, som Sø i Sommervind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 0,
      "text": "og Danmarks grønne Dale",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 0,
      "text": "staar spændt som Sluser mod mit Sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 0,
      "text": "vil briste ud i Tale.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 0,
      "text": "Det er, som Jordens Hav og Muld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 0,
      "text": "med alle deres Døde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 0,
      "text": "er med en Viden underfuld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 0,
      "text": "mig gaaet stumt i Møde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 0,
      "text": "Det uudsigelige Land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 0,
      "text": "som Genfærd søger Sjæle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 0,
      "text": "Og Stjerners Mulm og Stjerners Brand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 0,
      "text": "i mig vil have Mæle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 0,
      "text": "Unge Mænd og Kvinder! Grib Nuet! Se og hør!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 0,
      "text": "Virkeligheden synes nær – som ingen Sinde før.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 0,
      "text": "Hver ny Ungdom sætter Virkeligheden Stævne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 0,
      "text": "Gav den aldrig sig helt, gav den dog Kraft og Evne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 0,
      "text": "Hver ny Ungdom maa vinde sit Jorderige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 0,
      "text": "Derved nye Muligheder af Mørket stige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 0,
      "text": "Vejen hjem til Jorden bar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 0,
      "text": "stundom om ad andre Kloder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 0,
      "text": "Da Copernicus blev va'r",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 0,
      "text": "Jordens Dans omkring dens Moder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 0,
      "text": "sprang af Sindet andre Floder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 0,
      "text": "Den, der søger i Nuet efter den sande",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 0,
      "text": "Virkelighed, aner Fortids og Fremtids Lande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 0,
      "text": "Blodets Jernsang jubler mod bundløst Blaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 0,
      "text": "om Lykkens Nærhed. Eden vil genopstaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 0,
      "text": "Æbletræet frister med Sommergaven.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 0,
      "text": "Endnu gaar Eva stundom nøgen i Haven.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 0,
      "text": "Darwin øjned Livets Træ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 0,
      "text": "Stammen stod bag Dødens Trone.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 0,
      "text": "Fra de tabte Landes Læ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 0,
      "text": "lød en overskygget Tone.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 0,
      "text": "Men i Nuet staar dets Krone.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 0,
      "text": "Virkelighed! Paa Vejen til dig vi naaede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 0,
      "text": "rundt om Jord gennem Tvivl og Storme og Fraade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 0,
      "text": "Afstand lærte du os ved Damp og Hjul at besværge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 0,
      "text": "Vort Blik har dvælet i Skyggen af Maanens Bjerge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 0,
      "text": "I dit Navn letter Mennesket nu fra Muld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 0,
      "text": "og Luften vil mørkne og surre af de kommende Kuld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 0,
      "text": "Unge Mænd og Kvinder! Grib Nuet! Se og hør!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 0,
      "text": "Virkeligheden giver Evner – som ingen Sinde før,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 0,
      "text": "Virkeligheden, Gaaden, hvori vi lever og dør!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 0,
      "text": "Muld og Hav vort Væsen drage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 0,
      "text": "med en større Klodes Skær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 0,
      "text": "Jord, vi kalder: Kom os nær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 0,
      "text": "og vær vor i vore Dage!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 0,
      "text": "Løndom, som i Græsset gror,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 0,
      "text": "Løndom, som i Bølgen bor!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 0,
      "text": "Fyld med Liv vor Længsels Skaaler!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 0,
      "text": "Giv os Sjæl af dine Straaler!",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
