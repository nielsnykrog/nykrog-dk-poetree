  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "De higer og söger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "i gamle Böger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "i oplukte Höie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "med speidende Öie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "paa Sværd og Skiolde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "i muldne Volde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "paa Runestene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "blandt smuldnede Bene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Oldtids Bedrifter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "anede trylle;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "men i Mulm de sig hylle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "de gamle Skrifter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Blikket stirrer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "sig Tanken forvirrer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "I Taage de famle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "»I gamle gamle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "hensvundne Dage!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "da det straalte i Norden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "da Himlen var paa Jorden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "giv et Glimt tilbage!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "Skyen suser,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Natten bruser,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "Gravhöien sukker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Rosen sig lukker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "De övre Regioner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 4,
      "text": "toner!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 4,
      "text": "De sig möde, de sig möde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 4,
      "text": "de forklarede Höie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "kampfarvede, röde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "med Stierneglands i Öie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 5,
      "text": "»I som raver i blinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 5,
      "text": "skal finde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 5,
      "text": "et ældgammelt Minde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 5,
      "text": "der skal komme og svinde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 5,
      "text": "Dets gyldne Sider",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "skal Præget bære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "af de ældste Tider.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 6,
      "text": "Af det kan I lære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 6,
      "text": "Med andagtsfuld Ære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 6,
      "text": "I vor Gave belönne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 6,
      "text": "Det skiönneste Skiönne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 6,
      "text": "en Möe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "skal Helligdommen finde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "Saa synge de og svinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "Lufttonerne döe!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 7,
      "text": "Hrymfaxe den sorte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 7,
      "text": "puster og dukker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 7,
      "text": "og i Havet sig begraver.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 7,
      "text": "Morgenens Porte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 7,
      "text": "Delling oplukker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 7,
      "text": "og Skinfaxe traver",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 7,
      "text": "i straalende Lue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 7,
      "text": "paa Himlens Bue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 8,
      "text": "Og Fuglene synge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 8,
      "text": "Dugperler bade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 8,
      "text": "Blomsterblade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 8,
      "text": "som Vindene gynge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 8,
      "text": "Og med svævende Fied",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 8,
      "text": "en Möe hendandser",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 8,
      "text": "til Marken afsted.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 8,
      "text": "Violer hende krandser.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 8,
      "text": "Hendes Rosenkind brænder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 8,
      "text": "hun har Lilliehænder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 8,
      "text": "Let som en Hind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 8,
      "text": "med muntert Sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 8,
      "text": "hun svæver og smiler;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 8,
      "text": "og som hun iler",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 8,
      "text": "og paa Elskov grubler –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 8,
      "text": "hun snubler!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 8,
      "text": "og stirrer og skuer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 8,
      "text": "gyldne Luer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 8,
      "text": "og rödmer og bæver",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 8,
      "text": "og zittrende hæver",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 8,
      "text": "med undrende Aand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 8,
      "text": "af sorten Muld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 8,
      "text": "med sneehvide Haand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 8,
      "text": "det röde Guld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 9,
      "text": "En sagte Torden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 9,
      "text": "dundrer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 9,
      "text": "Hele Norden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 9,
      "text": "undrer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 9,
      "text": "Og hen de stimle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 9,
      "text": "i store Vrimle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 9,
      "text": "og grave og söge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 9,
      "text": "Skatten at foröge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 9,
      "text": "Men intet Guld!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 10,
      "text": "Deres Haab har bedraget.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 10,
      "text": "De see kun det Muld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 10,
      "text": "hvoraf de er taget.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 11,
      "text": "Et Sekel svinder!!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 12,
      "text": "Over Klippetinder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 12,
      "text": "det atter bruser.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 12,
      "text": "Stormenes Sluser",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 12,
      "text": "bryde med Vælde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 12,
      "text": "Over Norges Fielde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 12,
      "text": "til Danmarks Dale",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 12,
      "text": "i Skyernes Sale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 12,
      "text": "de forklarede Gamle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 12,
      "text": "sig atter samle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 13,
      "text": "»For de sieldne Faae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 13,
      "text": "som vor Gave forstaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 13,
      "text": "som ei Jordlænker binde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 13,
      "text": "men hvis Siele sig hæve",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 13,
      "text": "til det Eviges Tinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 13,
      "text": "som ane det Höie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 13,
      "text": "i Naturens Öie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 13,
      "text": "som tilbedende bæve",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 13,
      "text": "for Guddommens Straaler,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 13,
      "text": "i Sole, i Violer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 13,
      "text": "i det Mindste, i det Störste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 13,
      "text": "som brændende törste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 13,
      "text": "efter Livets Liv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 13,
      "text": "som – o store Aand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 13,
      "text": "for de svundne Tider!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 13,
      "text": "see dit Guddomsblik",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 13,
      "text": "paa Helligdommens Sider,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 13,
      "text": "for dem lyder atter vort Bliv!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 14,
      "text": "Naturens Sön,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 14,
      "text": "ukiendt i Lön,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 14,
      "text": "men som sine Fædre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 14,
      "text": "kraftig og stor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 14,
      "text": "dyrkende sin Jord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 14,
      "text": "ham vil vi hædre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 14,
      "text": "han skal atter finde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 14,
      "text": "Saa synge de og svinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 15,
      "text": "Hrymfaxe den sorte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 15,
      "text": "puster og dukker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 15,
      "text": "og i Havet sig begraver.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 15,
      "text": "Morgenens Porte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 15,
      "text": "Delling oplukker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 15,
      "text": "og Skinfaxe traver",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 15,
      "text": "i straalende Lue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 15,
      "text": "paa Himlens Bue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 16,
      "text": "Ved lune Skov",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 16,
      "text": "Öxnene trække",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 16,
      "text": "den tunge Plov,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 16,
      "text": "over sorten Dække.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 17,
      "text": "Da standser Ploven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 17,
      "text": "og en Gysen farer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 17,
      "text": "igiennem Skoven.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 17,
      "text": "Fugleskarer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 17,
      "text": "pludselig tier.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 17,
      "text": "Hellig Taushed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 17,
      "text": "alt indvier.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 18,
      "text": "Da klinger i Muld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 18,
      "text": "det gamle Guld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 19,
      "text": "Tvende Glimt fra Oldtidsdage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 19,
      "text": "funkler i de nye Tider.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 19,
      "text": "Selsomt vendte de tilbage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 19,
      "text": "gaadefyldt paa röde Sider.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 20,
      "text": "Mystisk Helligdom omsvæver",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 20,
      "text": "deres gamle Tegn og Mærker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 20,
      "text": "Guddomsglorien ombæver",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 20,
      "text": "Evighedens Underværker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 21,
      "text": "Hædrer dem, thi Skiebnen skalter!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 21,
      "text": "snart maaskee de er forsvunden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 21,
      "text": "Jesu Blod paa Herrens Alter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 21,
      "text": "fylde dem, som Blod i Lunden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 22,
      "text": "Men I see kun deres Lue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 22,
      "text": "ikke det ærværdigt Höie!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 22,
      "text": "Sætte dem som Pragt tilskue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 22,
      "text": "for et mat nysgierrigt Öie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 23,
      "text": "Himlen sortner, Storme brage!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 23,
      "text": "Visse Time du er kommen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 23,
      "text": "Hvad de gav de tog tilbage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 23,
      "text": "Evig bortsvandt Helligdommen.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
