    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1871,
    "url": "https://tekstnet.dk/books/andersen-hc_kantate-ved-hr-moritz-melchiors-og-fru-dorothea-melchiors-soelvbryllup-den-17de-juni-1871/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Sølvbryllupsklokkerne ringe,",
      "part": false,
      "marginal_notes": [
        "Speaker: CHOR"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Det er som en Foraarssang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Naar næste Gang de klinge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Har Klokkerne Guldets Klang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Der staaer paa Høibroplads en gammel Gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Der boede »« vil Godtfolk sige;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "I vor Tid voxte der en Rosenmaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Et Barn, en klog, velsignet lille Pige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Ung Moritz saae derop en Foraarsdag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Og i det Solskin blev hans Hjerte borte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Men ei han følte Sorg, nei stort Behag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Han fik jo eet igjen af »lille Dorthe«.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Det er saa deiligt at mødes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Hinanden ret at forstaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Livsalige Tanker fødes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "De ind i al Evighed naae!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Der gik det glade Par i Ungdomstiden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Endnu de eie hele Hjertets Vaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Skjøndt fem og tyve Aar er gaaet siden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "Hun flætted’ Myrtekrandsen i sit Haar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "Og han fornam, at Lykken var ham givet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "I Qvinden ædel, klog og hjertegod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "Gik Sorgens Skygger over Jordelivet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "Hun var det Solskin som ham ei forlod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "De dybt hinanden i Hjertet saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "Hinanden de kunde stole paa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "I Glædens og Prøvelsens Dage;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "Der lyste ind Velsignelsens Aand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "Til gjestfri Arne og hjelpsom Haand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "Til Husbond og Ægtemage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "Ved »« er voxet frem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "Et »«, et Hjertets Hjem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 0,
      "text": "Der Sølvbryllupsklokkerne ringe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 0,
      "text": "Og Børn og Børnebørns festlige Tog",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 0,
      "text": "Komme med vaiende Danebrog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 0,
      "text": "De Hilsen og Festsang bringe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 0,
      "text": "Sølvbryllupsklokkerne ringe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 0,
      "text": "Det er som en Foraarssang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 0,
      "text": "Naar næste Gang de klinge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 0,
      "text": "Har Klokkerne Guldets Klang.",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
