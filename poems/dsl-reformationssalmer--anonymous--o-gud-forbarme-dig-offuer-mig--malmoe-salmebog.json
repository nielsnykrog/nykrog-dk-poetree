  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Gud forbarme dig offuer mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "for din store barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Och for din megne miskundhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "slet aff min vretferdighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Tho du mig vel aff ondskaff min/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "och gør mig ren fra all min synd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Thi ieg kender min ondskaff nu/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "min synd er altid i min hw",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "O herre Gud mod dig all ene",
      "part": false,
      "marginal_notes": [
        "Esa xlii"
      ]
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "haffuer ieg syndit/ det kendiss ieg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Jeg haffuer giort ont i dit aasyn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "ath det er vist/ som du haffuer sagt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "ath alle skulle bede dig om miskundhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "thi vor nature er fuld aff synd/",
      "part": false,
      "marginal_notes": [
        "Rom. iii Rom. vii"
      ]
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "huad hagde wi ellers naade behoff?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "du vinder dem offuer/ som det ey tro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "See/ ieg er vdi synd fødder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "i synd vnfick mig min moder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Ret sanningen ieg ey dylger/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "løgen mot du icke høre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "du haffuer vist mig/ huordan ieg er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "fuld aff ond beger/",
      "part": false,
      "marginal_notes": [
        "Psa. v"
      ]
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "det kunde ieg icke før forstaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "før du lod mig din visdom faa",
      "part": false,
      "marginal_notes": [
        "Psa. xix"
      ]
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "O Herre stenckt du selff paa mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "met din Jsop och naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "da bliffuer ieg ren visselig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "oc quit fra synd oc waade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "din kære Søns blod er den Jsop/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "der huider en sne gør siel och kropp/",
      "part": false,
      "marginal_notes": [
        "i Petri i"
      ]
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "lad mig faa høre din gledelige ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "saa frøydis mine ben som beffuede før",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "O herre see ey til min synd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "slæt vd all min vretferdighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "och skab ith rent hierte i mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "giff en ret aand/ forny mit sind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "oc kast mig icke fra dit ansicte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "tag icke fra mig den Helligand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "giff mig glede i din frelsermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "met en sterck aand gør mig stadig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "Dine veye ieg dem lære vil",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "som vretuise ere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 5,
      "text": "ath de skulle synden offuergiffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 5,
      "text": "oc sig til dig omuende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 5,
      "text": "frelss mig o herre min salighedz Gud/",
      "part": false,
      "marginal_notes": [
        "Actor. xxvi"
      ]
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "fra ligemsens syndelig løst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "saa skall min tunge alt effter dit bud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "gladelig forkynde din retuished",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "O herre lad op mine læbe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 6,
      "text": "saa skall min mund kundgøre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 6,
      "text": "dit loff och priss oc store ære/",
      "part": false,
      "marginal_notes": [
        "Psal. xi"
      ]
    },
    {
      "id": 51,
      "stanza_id": 6,
      "text": "oc altid det framføre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 6,
      "text": "Fordi om du vilde offer haffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "al saa gerne ieg det gaffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "men du behøffuer inthit vor gerning/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "vort offer gør dig ingen forbedring",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 7,
      "text": "En sorgfuld aand oc bedrøffuit/",
      "part": false,
      "marginal_notes": [
        "Esaie lxvi"
      ]
    },
    {
      "id": 57,
      "stanza_id": 7,
      "text": "ith ydmygt hierte oc forknusit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 7,
      "text": "som for din lærdom giffuer sig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 7,
      "text": "det er dig Gud behageligt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 7,
      "text": "Och men wi kunde inthit gaat/",
      "part": false,
      "marginal_notes": [
        "ii Co. iii i Cor. iii"
      ]
    },
    {
      "id": 61,
      "stanza_id": 7,
      "text": "da Hielp du Sion/ som er dit folk/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 7,
      "text": "effter din vilge god och from/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "lad det opbyggis met din lerdom",
      "part": false,
      "marginal_notes": [
        "Psa. cii"
      ]
    },
    {
      "id": 64,
      "stanza_id": 8,
      "text": "Hierusalem din forsamling/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 8,
      "text": "naar det bliffuer fast opmurit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 8,
      "text": "met dine ord aff sende bud dine/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 8,
      "text": "saa bliffuer altsammen vel writ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 8,
      "text": "Da skalt du faa retuist offer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 8,
      "text": "som er loff/ priss/ oc tack/ och ære/",
      "part": false,
      "marginal_notes": [
        "Psa. iiii"
      ]
    },
    {
      "id": 70,
      "stanza_id": 8,
      "text": "det bør dig Gud all ene nyde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 8,
      "text": "saadant offer skulle wi dig giffue",
      "part": false,
      "marginal_notes": [
        "Psal. l"
      ]
    }
  ]
}