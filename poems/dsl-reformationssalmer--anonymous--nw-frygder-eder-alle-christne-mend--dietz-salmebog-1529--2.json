  "source": {
    "id": null,
    "title": "Een ny handbog med Psalmer oc aandelige lofsange",
    "year_published": 1529,
    "publisher": "Ludwig Dietz",
    "printer": "Ludwig Dietz",
    "place": "Rostock",
    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/dietz-salmebog-1529/2"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "NW frygder eder alle Christne mend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc lader oss frÿlig springe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "att wÿ ere trøstit alle paa een",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "med løst saa wille wÿ siunge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Hwad Gud mod oss haffuer beteed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "aff sÿn store barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "forløøst haffuer han oss dyre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "GVd fader oc Søn oc then Helliaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "hannwm bør oss prÿse oc ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "han giør miskund ÿ alle land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "som wÿ maa daglige høre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Han haffuer bewÿst stor kierlighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "mod menniskens køn saa mangeleed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "som wÿ wille faa att høre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "J dieffuelsens wold ieg fangen laa/",
      "part": false,
      "marginal_notes": [
        "Gen. iij."
      ]
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "ieg wor fordømt til døde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "mÿn synd meg qwalde bode natt oc dag/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "ieg hadde stor angist oc møde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Oc alle tÿd sanck ieg diybere nid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "ther wor ey raad ey salighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "ieg wor ÿ synden vndfangen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Mÿne gode gierning the hiolpe meg ey/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "the kunde ey døden offuerwinde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "then stercke dieffuel han sagde ney/",
      "part": false,
      "marginal_notes": [
        "Lu"
      ]
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "han wilde icke lade seg binde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Aff meg eller nogit creatur/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "ieg wor ÿ hans wald aff mÿn natur/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "fordømdt til ewige pÿne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Ther wor oc ingen ÿ werden till/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "ther meg forløse kunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "ieg weed ret aldrig hwort ieg wil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "ieg maa till heluedis grunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Guds wrede ther offuer meg er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "oc syndzens byrde ther ieg nw bær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "fortapt tha maa ieg bliffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Tha ynckede Gud ÿ ewighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "mÿn ælende offuer maade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "han tenchte paa sÿn barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "han wilde meg hielpe lade:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "Sitt faderlig hierte wende han til meg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "han kostit ther paa forwden swig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "thet kiærist ther han hadde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "Han talde til sÿn kiære søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "thet er nw tÿd att forbarme/",
      "part": false,
      "marginal_notes": [
        "Luce. j. Osee. xiij. Phil. ij. Luce. ij."
      ]
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "tw skalt thet giøre for mÿn bøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 6,
      "text": "far hæden oc frelss the arme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 6,
      "text": "Oc løøss thennom wdaff syndzens nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 6,
      "text": "oc slaa then horde død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "oc lad thennom med teg leffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 7,
      "text": "Guds søn sÿn fader lydactig war/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 7,
      "text": "han kom til meg paa iorden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 7,
      "text": "aff een Jomffru bode reen oc klar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 7,
      "text": "han wilde mÿn broder worde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 7,
      "text": "Saa lønlig førde han sÿn stads/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 7,
      "text": "leed alskens nød oc møgen plads/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 7,
      "text": "for han wilde dieffuelen fange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 8,
      "text": "Guds søn han sagde kom hÿd til meg",
      "part": false,
      "marginal_notes": [
        "Math. xj."
      ]
    },
    {
      "id": 57,
      "stanza_id": 8,
      "text": "ieg wil meg offuer teg forbarme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 8,
      "text": "ieg tolde then bittre død for teg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 8,
      "text": "ther med tw himmerig skalt ærffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 8,
      "text": "Nw er ieg thÿn oc tw æst mÿn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 8,
      "text": "oc hwor ieg er ther skal tw wære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 8,
      "text": "then fiend skall oss ey atskillie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 9,
      "text": "Hwem haffuer hørd større kierlighed/",
      "part": false,
      "marginal_notes": [
        "Roman. v."
      ]
    },
    {
      "id": 64,
      "stanza_id": 9,
      "text": "en død for vwenner att lÿde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 9,
      "text": "thet haffuer ieg eene giord fore teg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 9,
      "text": "att tw skulle med meg bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 9,
      "text": "Jeg er then eene ther hielpe kand/",
      "part": false,
      "marginal_notes": [
        "Math. xj."
      ]
    },
    {
      "id": 68,
      "stanza_id": 9,
      "text": "thÿ kommer til meg bode qwinne oc mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 9,
      "text": "oss skall rett ingen atskillie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 10,
      "text": "Mit blod thet flyder paa iorden wd/",
      "part": false,
      "marginal_notes": [
        "Johan. xix."
      ]
    },
    {
      "id": 71,
      "stanza_id": 10,
      "text": "ieg bær thet korss med møde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 10,
      "text": "ieg lÿder for teg then horde død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 10,
      "text": "tag tro oc lad teg døbe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 10,
      "text": "Mit lÿff offuerwinder then død med macht/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 10,
      "text": "all werdzens synder wore paa meg lagt/",
      "part": false,
      "marginal_notes": [
        "Esaie. liij."
      ]
    },
    {
      "id": 76,
      "stanza_id": 10,
      "text": "thÿ æstu salig worden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 11,
      "text": "Til himmels igien till fáder mÿn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 11,
      "text": "far ] herefter lakune orig. orig. ieg fraa thenne ælende /",
      "part": false,
      "marginal_notes": [
        "Johan.|xiiij. oc",
        "Johan.|xiiij. oc"
      ]
    },
    {
      "id": 79,
      "stanza_id": 11,
      "text": "ther wil ieg wære Mester thÿn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 11,
      "text": "then Helliaand teg att sende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 11,
      "text": "Som teg ÿ angiste trøste skal/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 11,
      "text": "oc teg vnderwÿse oc lære wel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 11,
      "text": "ÿ sandheds wæy att wandre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 12,
      "text": "Hwad ieg haffuer giord vnderwÿst oc lærd/",
      "part": false,
      "marginal_notes": [
        "Mat. xxiiij"
      ]
    },
    {
      "id": 85,
      "stanza_id": 12,
      "text": "thet skaltw giøre oc lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 12,
      "text": "ther med mit rÿge opfylt wort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 12,
      "text": "meg sielff til loff oc ære/",
      "part": false,
      "marginal_notes": [
        "Mat. xv. Marci. vij"
      ]
    },
    {
      "id": 88,
      "stanza_id": 12,
      "text": "Forware teg wel for menniskens sætt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 12,
      "text": "som oss forwender then Christelig rætt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 12,
      "text": "thet giffuer ieg teg til kende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 13,
      "text": "Tw skalt predicke then Christelig tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 13,
      "text": "som ieg befaler att lære/",
      "part": false,
      "marginal_notes": [
        "Matthei.|xxviij."
      ]
    },
    {
      "id": 93,
      "stanza_id": 13,
      "text": "Elsker hwer ander bode silde oc froo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 13,
      "text": "thet skal mit budord wære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 13,
      "text": "For dieffuelsens lærdom forwochte teg/",
      "part": false,
      "marginal_notes": [
        "Esaie. xl."
      ]
    },
    {
      "id": 96,
      "stanza_id": 13,
      "text": "thÿ han er falsk oc skadelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 13,
      "text": "Guds ord thet bliffuer ewindelig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 14,
      "text": "ISraels wdgang aff Egypten/",
      "part": false,
      "marginal_notes": [
        "Psal. cxiij."
      ]
    },
    {
      "id": 99,
      "stanza_id": 14,
      "text": "oc Jacobs hwss fraa thet groffue folk.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 15,
      "text": "Tha er kommen Juda til sÿn hellighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 15,
      "text": "oc Jsrael til sÿn weldighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 16,
      "text": "Thet saa haffuid oc flyde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 16,
      "text": "oc Jordan wende seg tilbage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 17,
      "text": "Biergenne haffue sprungit som bucke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 17,
      "text": "oc thuerne som the vngelam.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 18,
      "text": "O haff hwad er teg att tw flyde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 18,
      "text": "oc tw Jordan att tw komst tilbage?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 19,
      "text": "Oc ÿ bierge att ÿ haffue sprungit som bucke?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 19,
      "text": "oc ÿ thuer som the spæde lam?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 20,
      "text": "skielffuer for Herrens ansigt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 20,
      "text": "oc for Jacobs Guds ansigt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 21,
      "text": "Hwilken som haffuer wend stenen til een ssø/",
      "part": false,
      "marginal_notes": [
        "Psal. lxxvij"
      ]
    },
    {
      "id": 113,
      "stanza_id": 21,
      "text": "oc klippen til wandsens kiælder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 22,
      "text": "Jcke oss o Gud icke oss/ men thit naffn giff then ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 22,
      "text": "paa thÿn barmhiertigheds wegne oc sandheds.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 23,
      "text": "Att folkene skulle icke sige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 23,
      "text": "hwor er nw theris Gud?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 24,
      "text": "Men wor Gud er ÿ himmelen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 24,
      "text": "alting haffuer han giord effter syn wilie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 25,
      "text": "Theris affguder ere sølluff oc guld/",
      "part": false,
      "marginal_notes": [
        "Sap. xv."
      ]
    },
    {
      "id": 121,
      "stanza_id": 25,
      "text": "som ere menniskens gierninger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 26,
      "text": "The haffue mund oc kunde icke tale/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 26,
      "text": "the haffue øghne oc kunde icke see.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 27,
      "text": "The haffue ørhne oc kunde icke høre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 27,
      "text": "the haffue næse oc kunde icke luchte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 28,
      "text": "The haffue hender oc kunde icke føle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 28,
      "text": "the haffue fødder oc kunde icke gaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 28,
      "text": "the kunde icke raabe ÿ theris strube.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 29,
      "text": "Lÿg thennom skulle the bliffue som thennom haffue giord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 29,
      "text": "oc alle the som paa thennom haabe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 30,
      "text": "O Jsraels hwss haab til Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 30,
      "text": "han er thÿn hielpere oc beskermere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 31,
      "text": "O tw hwss Aarons forlad teg paa Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 31,
      "text": "han er thÿn hielpere oc beskermere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 32,
      "text": "O ÿ gudfryctige forlader eder paa Herren /",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 32,
      "text": "han er eders hielpere oc beskermere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 33,
      "text": "Herren haffuer kommid oss ÿ hw/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 33,
      "text": "oc haffuer benedidet oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 34,
      "text": "Han haffuer welsignet alle the gudfryctige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 34,
      "text": "saa wel smaa som the store.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 35,
      "text": "Gud som forøger eder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 35,
      "text": "han formere eder oc eders børn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 36,
      "text": "J ere benedidet aff Herren",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 36,
      "text": "som himmel oc iorden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 37,
      "text": "Himmelens himmel er Herrens/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 37,
      "text": "iorden haffuer han giffuit menniskens sønner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 38,
      "text": "The døde loffue teg icke Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 38,
      "text": "icke alle the som stige nidder til heluede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 39,
      "text": "Men wÿ som leffue benedide Herren/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 39,
      "text": "fraa nw oc indtil ewig tÿd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 40,
      "text": "Aere wære Gud fader oc Gud søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 40,
      "text": "oc saa Gud then helliaand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 41,
      "text": "Som wærid haffuer aff begyndelsen nw oc altÿd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 41,
      "text": "oc bliffuer til ewig tÿd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 41,
      "text": "AMEN.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 42,
      "text": "CHristum wÿ skulle loffue nw/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 42,
      "text": "Marie søn then reene Jomffru/",
      "part": false,
      "marginal_notes": [
        "Mat. j."
      ]
    },
    {
      "id": 158,
      "stanza_id": 42,
      "text": "saa wÿt som solen offuer skÿn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 42,
      "text": "bekende wÿ Jesum een Herre alleen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 43,
      "text": "Then som skapte himmel oc iord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 43,
      "text": "han tog mandom een træl han word/",
      "part": false,
      "marginal_notes": [
        "Phil. ij."
      ]
    },
    {
      "id": 162,
      "stanza_id": 43,
      "text": "att han oss icke gantske wilde fortabe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 43,
      "text": "thÿ wilde han seg til oss vmage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 44,
      "text": "Guds krafft wdaff himmelen kom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 44,
      "text": "ÿ thet Jomffruelig lÿff giorde een mandom/",
      "part": false,
      "marginal_notes": [
        "Luce. ij. Esaie. vij."
      ]
    },
    {
      "id": 166,
      "stanza_id": 44,
      "text": "then Jomffru som then naade bar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 44,
      "text": "hun wiste ey fuldkommelig hwad thet war.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 45,
      "text": "Thet kyske hiertens hwss forwist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 45,
      "text": "snarlig annam med Jesum Christ/",
      "part": false,
      "marginal_notes": [
        "Luce. j."
      ]
    },
    {
      "id": 170,
      "stanza_id": 45,
      "text": "hun bleff een Jomffru klar oc sand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 45,
      "text": "sÿn søn hun vndfick aff then helliaand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 46,
      "text": "Then ædle moder bar oss then/",
      "part": false,
      "marginal_notes": [
        "Mat. j. Luce. j."
      ]
    },
    {
      "id": 173,
      "stanza_id": 46,
      "text": "som Gabriel forkynde wdsend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 46,
      "text": "then Jomffru hun søgte Elizabet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 46,
      "text": "oc fands att haffue thet henne wor iætt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 47,
      "text": "Johannes ÿ sÿn moders barm/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 47,
      "text": "frygdet seg bode med food oc arm/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 47,
      "text": "Maria wdaff Guds samffund/",
      "part": false,
      "marginal_notes": [
        "Luce. j."
      ]
    },
    {
      "id": 179,
      "stanza_id": 47,
      "text": "sang Magnificat bode med hierte oc mund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 48,
      "text": "Then som all werden haffuer ÿ wold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 48,
      "text": "føddis ÿ een asne stold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 48,
      "text": "een liden mielk fødde hans natur/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 48,
      "text": "som føder oc wederqweger alle creatur.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 49,
      "text": "Then Engelske skare glæddis wid/",
      "part": false,
      "marginal_notes": [
        "Luce. ij:"
      ]
    },
    {
      "id": 185,
      "stanza_id": 49,
      "text": "att wor kommen aff Abrahe sæd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 49,
      "text": "thet hørde the hiyrder som wochtet theris queeg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 49,
      "text": "att Christ wor fød oss menniske lÿg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 50,
      "text": "Aere wære teg Christ med konge naffn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 50,
      "text": "som føddis aff een Jomffru werden til gaffn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 50,
      "text": "holt thÿn spÿr med kongelig acht:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 50,
      "text": "att dieffuelsens rÿge faar icke macht.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 51,
      "text": "siæl (taler Maria) ophoyer Herren.",
      "part": false,
      "marginal_notes": [
        "Luce. j."
      ]
    },
    {
      "id": 193,
      "stanza_id": 51,
      "text": "Oc mÿn aand frygder seg/ ÿ Gud mÿn frelsere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 52,
      "text": "For han saa til sÿn tiænnerskis ringhed /",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 52,
      "text": "see her aff worde meg salig sigende alle børnebørn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 53,
      "text": "Forthi then giorde meg stor ting som mectig er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 53,
      "text": "oc hans naffn er helligt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 54,
      "text": "Oc hans barmhiertighed er fraa slecht oc til slechte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 54,
      "text": "hooss thennom som hanwm frychte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 55,
      "text": "Han haffuer giort weldighed med sÿn arm/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 55,
      "text": "oc forstørned the som hofferdige ere ÿ theris hiertis sinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 56,
      "text": "Han haffuer affstøt the mechtige aff theris sæde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 56,
      "text": "oc ophøget the ydmyge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 57,
      "text": "The Hungrue opfylte han med gode ting/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 57,
      "text": "oc the rÿge forlod han thome.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 58,
      "text": "Han haffuer sÿn barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 58,
      "text": "oc sÿn tiæner Jsrael ophulpid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 59,
      "text": "Som han talde til wore forældre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 59,
      "text": "besynderlig Abraham oc hans sæd til ewig tÿd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 60,
      "text": "Aere wære Gud fader oc Gud søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 60,
      "text": "oc Gud then Helliaand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 61,
      "text": "Som haffuer wærid aff begyndelsen oc nw oc altÿd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 61,
      "text": "oc aff ewighed til ewighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 61,
      "text": "AMEN.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 62,
      "text": "Loffuer Christum wor frelsere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 62,
      "text": "Alleluia Alleluia Alleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 63,
      "text": "Gud wære loff oc ewig tack",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 63,
      "text": "Alleluia Alleluia Alleluia.",
      "part": false,
      "marginal_notes": []
    }
  ]
}