{
  "id": null,
  "title": "Paa Kongens Nytorv stod et gammelt Huus",
  "year_created": 1857,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
