{
  "id": null,
  "title": "Svend af Vollersløv",
  "year_created": 1584,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Dronning Sophias visebog",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1584,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/DRS13.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Ther boer saa høueskenn frue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "sønden ude wed aa;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "hun haffuer saa skiønnen datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "thenn skiønneste were maa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: Sell er hun stalt udi sin hog. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Stalt Mettelil gannger y hindis faders gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "alt y saa mangen goud dag;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "hinder rider belle boude thill och fra,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "och ingen dem will hun haffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Hinnder beder Suenden aff Wolder-sløff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "och hannd war konngens frennde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "hinder feste unge ien Willeom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "for hannd war beder kiennde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Thett war unngen her Willium,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "hand lod sett brøllup bo;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "syg laa Suennden aff Woldersløff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "ud-aff rett elskouuens thra.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Siug leger Suenden aff Woldersløff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "ud-aff rett elskouennss thrae;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "hanns moder och hans syster",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "thi gannger hannom thill och frae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Hanns moder och hans syster",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "thi ganger hannom thill och fra:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "\"Hør thu, Suenden aff Woldersløff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "och hui tha sørger thu saa?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Hørre thu, Suenden aff Woldersløff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "och huad ieg siger thig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "haffuer thu sout eller siuge-dom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "thu dølle thett icke for mig!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "\"Mynn sigdom hun er mig underlig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "met hierthe bliffuer alder glad:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "alt for hinn stalten iomfrue Mettelil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "hindis brollup thet stod y-dag.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "\"Hør thu thet, min kier søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "ieg rader thig radenn best:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "thu set ret alder thit sind thill thend møø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "en anden iomfrue haffuer fest!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "\"Høre y thet, kiere moder min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "thet er saa wennen møe;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "for hinder skall ungen her Willium",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "thalle saa harden død.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Thet stod saa y mannet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "och thet stod saa udi thre;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "Willium rider y rossenns-lund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "hannd agte thi diur att biede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "For red suendt ungen Willium,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "hand hagde icke suene udenn fem;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "effther red Suenden aff Woldersløff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "med femtan raske hoffmend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "\"Hør thu, ungen Willium,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "hui rider thu mig saa ner?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "thu west fulduell, thu feste thend iomfrue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 12,
      "text": "ieg hade y hierthed kier.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "\"Ieg feste hin stalten iomfrue Mettelil",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "alt met hindis frennders rad;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "thet will ieg for sanden sige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 13,
      "text": "och selff tha sagde hun meg ia.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "\"Thet skalthu mig loffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "mens wi er enne tho:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "thu skalt aller loffue thend møe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 14,
      "text": "en anden suend haffuer kier.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "Saa thog thi unngen Willium,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "the hog hannom alt saa sma",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "som liden lende-løff, y lunden laa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 15,
      "text": "saa fick hun sorich udi huff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "Ther hannd haffde weget her Willium,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "en rider alt saa skiøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "thog hand saa then liden sma-dreng",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 16,
      "text": "och sende Mettelil hiem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "\"Thu rid thill staltenn frue Mettelil:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "sig hinder thi thiding ny,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "eller bed hinder henthe her Willium hiem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 17,
      "text": "hand leger i lunden død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "Thu sig hinder thet thill angest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "thu sig hinder thett thill harom:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "død leger hindis hierthens-kiere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 18,
      "text": "for hun wilde icke wede meg then ere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "Ieg passer icke paa hindis angest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "ieg passer icke paa hindis klag;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "thet haffuer ieg hinder thill sorig giortt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 19,
      "text": "for hun wilde mig icke haffue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "Ind tha kom thend lidenn sma-dreng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "war kled y kiorthell rød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "\"I hennter hiem stalten her Willium,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 20,
      "text": "hand leger y lunden død.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 21,
      "text": "Thet melte staltenn frue Mettelil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "hun slog hindis hennder thil-sammen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 21,
      "text": "thet alle hindis gulde-ringe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 21,
      "text": "thi sprunge offuer thi skammell.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 22,
      "text": "Thet melte stalten frue Mettelil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 22,
      "text": "hun slog hindis hennder aff nød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 22,
      "text": "\"Huem haffuer mig thend soriig giortt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 22,
      "text": "och haffuer slagit min her thill død?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 23,
      "text": "Thett suarde thend liden sma-dreng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 23,
      "text": "hannd gaff thet saa lidet y agt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 23,
      "text": "\"Thet giorde Suenden aff Woldersløff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 23,
      "text": "for y wilde hannom icke haue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 24,
      "text": "Thet suarde stalten frue Mettelil",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 24,
      "text": "aff sorig och møgen nød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 24,
      "text": "\"Ennd maa thet barn were ufødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 24,
      "text": "som heffne kand hanns død.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 25,
      "text": "Thett suarde Willioms syster",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 25,
      "text": "y silcke-kiorthell rød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 25,
      "text": "\"Lenge maa thend suend leffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 25,
      "text": "for ufød barnn skall død.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 26,
      "text": "Thet stod y mannet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 26,
      "text": "och thet stod y tho;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 26,
      "text": "Suennden hand rider y konngens gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 26,
      "text": "hannd spotter hinnder daglig for had.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 27,
      "text": "Thet stod saa icke lennger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 27,
      "text": "for-uden mannet fem:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 27,
      "text": "stalt Mettelil ganger y bueret,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 27,
      "text": "hun føde saa skiønnen søn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 28,
      "text": "Fød bleff hannd en afften,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 28,
      "text": "thi christnet hannom om natt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 28,
      "text": "thi kalt hannom ungen Willium,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 28,
      "text": "thi døllet hannom, mens thi matt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 29,
      "text": "\"Nu beder ieg alle y danne-quender,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 29,
      "text": "som her staer for meg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 29,
      "text": "attj skulle icke andet sige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 29,
      "text": "ennd thet enn datter er.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 30,
      "text": "Nu beder ieg alle y danne-quender,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 30,
      "text": "som er huos meg y nød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 30,
      "text": "at y skall icke andet sige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 30,
      "text": "end thet er enn møe.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 31,
      "text": "Thet spurdiz nu saa wide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 31,
      "text": "och alt saa wide unnder øe:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 31,
      "text": "saa at staltenn frue Mettelil",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 31,
      "text": "at hun hagde fannget enn mø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 32,
      "text": "Thet war Suennden aff Woldersløff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 32,
      "text": "hannd agslett skarlagenn-skiende;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 32,
      "text": "saa gaar hannd y høger-lofft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 32,
      "text": "for danner-kongen och ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 33,
      "text": "\"Her sider y, danner-konngen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 33,
      "text": "for-wonnden er ald min nød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 33,
      "text": "thennd suennd, som mig skulde slaa y-hiell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 33,
      "text": "thet er nu wordenn en møe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 34,
      "text": "Stalt Mettelil thrued med hinders sønn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 34,
      "text": "att hand skulle sla mig thill døde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 34,
      "text": "nu haffuer her Gudt giortt min løcke saa goud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 34,
      "text": "at thet er worden en møe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 35,
      "text": "Nu haffuer Gudt giort min løcke saa goud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 35,
      "text": "at thet er wordenn enn lile-wand;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 35,
      "text": "her Gudt unde meg at leffue then dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 35,
      "text": "at ieg matte giør hinder skam.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 36,
      "text": "Thet melte Danner-kongen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 36,
      "text": "saa hannd thog paa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 36,
      "text": "\"Du thid thet kuer, Suenden aff Woldersløff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 36,
      "text": "och sig thu aller saa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 37,
      "text": "Thi quer! Suenden aff Woldersløff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 37,
      "text": "och thall thu icke slig ord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 37,
      "text": "thig spatter fruer och iomfruer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 37,
      "text": "och rider offuer wortt bord.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 38,
      "text": "Thet stod saa y wennther,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 38,
      "text": "och thet stod saa y ny;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 38,
      "text": "Williom bleff thend frommeste suend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 38,
      "text": "mand wilde med øgne see.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 39,
      "text": "Fastered hun hannom i atte aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 39,
      "text": "saa listeligenn under øe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 39,
      "text": "med fletted haer och silcke-kleder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 39,
      "text": "alt som en anden møe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 40,
      "text": "Williom och thend bonde-søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 40,
      "text": "thii legte thill-sammen under lide;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 40,
      "text": "ther kom splid y thieris leg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 40,
      "text": "saa mangen mand thil quide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 41,
      "text": "Williom slog thend bonde-søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 41,
      "text": "och drog hannom y sit har:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 41,
      "text": "\"Beder matt du haffue thin faders død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 41,
      "text": "och lade mig were ubarnn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 42,
      "text": "Thet suarde ungen Williom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 42,
      "text": "hannd bleff boude suortt och bleg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 42,
      "text": "\"Bleff min fader medt waben weget,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 42,
      "text": "bourtte er min sommers-leg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 43,
      "text": "Thet war ungen Willium,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 43,
      "text": "hand suober sit houit i skiende;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 43,
      "text": "saa gaar hannd y høger-lofft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 43,
      "text": "for sin kiere moder och inde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 44,
      "text": "\"Hør y, min kiere moder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 44,
      "text": "alt huad ieg spør eder at:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 44,
      "text": "bleff min kiere fader med waben weget,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 44,
      "text": "y døller thet icke for meg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 45,
      "text": "\"Thu est thig boude lidenn och ung,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 45,
      "text": "thin hest kant thu icke rade;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 45,
      "text": "lennge maa Suenden aff Woldersløff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 45,
      "text": "ride frii for thig aff gaarde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 46,
      "text": "Thu est thig boude liden och unng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 46,
      "text": "din hiellom kant thu ilde binde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 46,
      "text": "lennge maa Suenden aff Woldersløff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 46,
      "text": "ride felig for thig aff thinge.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 47,
      "text": "\"Icke er ieg saa liiden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 47,
      "text": "min hielom kand ieg will binde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 47,
      "text": "icke skall Suenden aff Woldersløff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 47,
      "text": "ride frii for megh thill thinnge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 48,
      "text": "I thager nu henn silcke och skarlagenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 48,
      "text": "som meg sømmer icke at bere;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 48,
      "text": "y fannger meg hiid thi brønin saa bla,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 48,
      "text": "thi sommer meg med ald ere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 49,
      "text": "I thager thager nu hen the iomfrue-kleder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 49,
      "text": "ieg will thennom icke drage;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 49,
      "text": "fannger meg suerd och brynne y hannd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 49,
      "text": "thennom løster meg nu at haffue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 50,
      "text": "Thet war ungen Willium,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 50,
      "text": "hand skreff thi breffue om-kring:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 50,
      "text": "\"Bed hannom Suenden aff Woldersløff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 50,
      "text": "møde meg y-morgen thill thinge.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 51,
      "text": "Thet war Suenden aff Woldersløff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 51,
      "text": "ther hannd thi thiding fro:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 51,
      "text": "saa monne hand saa sørge-fuld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 51,
      "text": "ind for kongen ghae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 52,
      "text": "\"Her sider i, min edelig herre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 52,
      "text": "ieg klager for ether miin wande:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 52,
      "text": "thet ieg hagde thengt, ien iomfrue hagde weret,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 52,
      "text": "thet er nu bleffuit en mand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 53,
      "text": "Stalten Mettelil bour sig ud under øe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 53,
      "text": "hun er saa harden wiff;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 53,
      "text": "hun haffuer seg saa ungen søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 53,
      "text": "hand stander fast effther mit liff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 54,
      "text": "Hør y thet, min edelig her,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 54,
      "text": "ieg klager for ether myn nød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 54,
      "text": "Willeom haffuer meg thil thinge steffnet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 54,
      "text": "alt for hanns faders død.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 55,
      "text": "\"Høre thu, Suendenn aff Woldersløff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 55,
      "text": "thu agte thet barn saa ringe:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 55,
      "text": "ieg skall lanne theg aff mine mend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 55,
      "text": "och følge theg selff thill thinge.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 56,
      "text": "Thet war Suenden aff Woldersløff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 56,
      "text": "hannd hagde thi suenne ni:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 56,
      "text": "dem klede hand y silcke rød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 56,
      "text": "hand rider thill thinge med dem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 57,
      "text": "Thet war unnge ien Willeom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 57,
      "text": "hand hagde suenne fem;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 57,
      "text": "them kleder hand y hardenn iern,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 57,
      "text": "hand rider rider thill thinge med dem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 233,
      "stanza_id": 58,
      "text": "Thet melte Suenden aff Woldersløff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 234,
      "stanza_id": 58,
      "text": "hand halder y silcke rød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 235,
      "stanza_id": 58,
      "text": "\"Huem haffuer meg thill thinge boden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 236,
      "stanza_id": 58,
      "text": "och giortt min heste thend møde?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 237,
      "stanza_id": 59,
      "text": "Thet suarde ungen Willeom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 238,
      "stanza_id": 59,
      "text": "hand hiolt under hielom hin røde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 239,
      "stanza_id": 59,
      "text": "\"Ieg haffuer thig thill thingen boden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 240,
      "stanza_id": 59,
      "text": "alt for min faders døde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 241,
      "stanza_id": 60,
      "text": "Thet suarde Suenden aff Woldersløff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 242,
      "stanza_id": 60,
      "text": "hand støtte suerd emod iorde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 243,
      "stanza_id": 60,
      "text": "\"Thu fanger aller for fader din",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 244,
      "stanza_id": 60,
      "text": "enten pennding eller goude orde!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 245,
      "stanza_id": 61,
      "text": "Thet suarde ungen Willeom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 246,
      "stanza_id": 61,
      "text": "hand støtte sit suerd emod iord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 247,
      "stanza_id": 61,
      "text": "\"Ennd skall ieg fange for fader min",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 248,
      "stanza_id": 61,
      "text": "saa høuesk en rider-boud!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 249,
      "stanza_id": 62,
      "text": "Thet war Suenden aff Woldersløff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 250,
      "stanza_id": 62,
      "text": "hand kaste sin ganger omkring:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 251,
      "stanza_id": 62,
      "text": "\"Thu fannger alder for fader din",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 252,
      "stanza_id": 62,
      "text": "enten pending eller pendings werd.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 253,
      "stanza_id": 63,
      "text": "Thet war ungen Williom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 254,
      "stanza_id": 63,
      "text": "hand sit suerd uddrog;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 255,
      "stanza_id": 63,
      "text": "thet war Suenden aff Woldersløff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 256,
      "stanza_id": 63,
      "text": "hand død paa thennget wog.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 257,
      "stanza_id": 64,
      "text": "Thet war danner-konngen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 258,
      "stanza_id": 64,
      "text": "hand raber thill alle sine mend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 259,
      "stanza_id": 64,
      "text": "\"Y griber ungen Williom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 260,
      "stanza_id": 64,
      "text": "hand haffuer giortt thinge-fred.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 261,
      "stanza_id": 65,
      "text": "\"Ieg beder eder, danner-kongen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 262,
      "stanza_id": 65,
      "text": "y lader meg fare y fred;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 263,
      "stanza_id": 65,
      "text": "ieg haffuer icke føre thill thinge weret,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 264,
      "stanza_id": 65,
      "text": "ieg weste icke aff thinge-sed.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 265,
      "stanza_id": 66,
      "text": "Thet war ungen Williom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 266,
      "stanza_id": 66,
      "text": "hand spranck thill sin hest:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 267,
      "stanza_id": 66,
      "text": "\"Nu thøckis meg y thancke min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 268,
      "stanza_id": 66,
      "text": "at skouen hun skiuller hin best.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 269,
      "stanza_id": 67,
      "text": "Thack haffue ungen Willium,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 270,
      "stanza_id": 67,
      "text": "och saa hanns liden sma-dreng:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 271,
      "stanza_id": 67,
      "text": "thi und-rende fra thinge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 272,
      "stanza_id": 67,
      "text": "for kongen och alle hanns mend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 273,
      "stanza_id": 68,
      "text": "Thack haffue ungen Williom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 274,
      "stanza_id": 68,
      "text": "saa well throde hand sin hest;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 275,
      "stanza_id": 68,
      "text": "hand bar hannom y skouen ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 276,
      "stanza_id": 68,
      "text": "som thyckennett thet war mest.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 277,
      "stanza_id": 69,
      "text": "Thet war alle thi kongens mend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 278,
      "stanza_id": 69,
      "text": "thi ganger for kongen at stannde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 279,
      "stanza_id": 69,
      "text": "\"thi giffuer thet barn sin fred igien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 280,
      "stanza_id": 69,
      "text": "thi hannom er thimet stor wander.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 281,
      "stanza_id": 70,
      "text": "Hans fader bleff hannom slagen fra,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 282,
      "stanza_id": 70,
      "text": "førend hand bleff fød;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 283,
      "stanza_id": 70,
      "text": "hagde Suenden siet sig effne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 284,
      "stanza_id": 70,
      "text": "hannd hagde hannom slet for-ød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 285,
      "stanza_id": 71,
      "text": "Nader y hannom, min edelig her,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 286,
      "stanza_id": 71,
      "text": "thi løcken haffuer werit hannom thunge;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 287,
      "stanza_id": 71,
      "text": "hand kand end enn gang bliue thend mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 288,
      "stanza_id": 71,
      "text": "ethers nade thienne kunde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 289,
      "stanza_id": 72,
      "text": "Thet giorde danner-koning",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 290,
      "stanza_id": 72,
      "text": "for alle sin goude mandtz bønn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 291,
      "stanza_id": 72,
      "text": "hand gaff Williom sin fred igien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 292,
      "stanza_id": 72,
      "text": "ther-for fick hand stour bønn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 293,
      "stanza_id": 73,
      "text": "Thet war ungen Willium,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 294,
      "stanza_id": 73,
      "text": "red y sin moders gaard;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 295,
      "stanza_id": 73,
      "text": "thet war hanns kiere moder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 296,
      "stanza_id": 73,
      "text": "hun ganger hannom ud emodt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 297,
      "stanza_id": 74,
      "text": "\"Wer well-kommen, ungen Willium,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 298,
      "stanza_id": 74,
      "text": "kiere sønne min!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 299,
      "stanza_id": 74,
      "text": "hur haffuer theg lid thill thinge y-dag?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 300,
      "stanza_id": 74,
      "text": "\"Ieg haffuer heffned min faders død, kier moder myn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 301,
      "stanza_id": 75,
      "text": "Thet war staltenn frue Mettelil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 302,
      "stanza_id": 75,
      "text": "hun thug ham y sin arom:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 303,
      "stanza_id": 75,
      "text": "\"Loffuit were Gudt-fader y himmerig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 304,
      "stanza_id": 75,
      "text": "for-wonden haffuer ieg min harom!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 305,
      "stanza_id": 76,
      "text": "Først wog hannd Suenden aff Woldersløff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 306,
      "stanza_id": 76,
      "text": "och heffnet sin faders død;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 307,
      "stanza_id": 76,
      "text": "saa red hannd thill Woldersløff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 308,
      "stanza_id": 76,
      "text": "belaa søster hans, saa wenne en mø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 309,
      "stanza_id": 77,
      "text": "Først wog hand Suenden aff Woldersløff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 310,
      "stanza_id": 77,
      "text": "och heffnet sin faders død;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 311,
      "stanza_id": 77,
      "text": "saa locket hannd hans syster,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 312,
      "stanza_id": 77,
      "text": "end bleff hand suoret y lannd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 313,
      "stanza_id": 78,
      "text": "Loffuit vere Gud-fader i himmerig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 314,
      "stanza_id": 78,
      "text": "som alle sorig kand for-wende;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 315,
      "stanza_id": 78,
      "text": "alder horde ieg en werre ferd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 316,
      "stanza_id": 78,
      "text": "som fick en beder ende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 317,
      "stanza_id": 78,
      "text": ":: Sell er hun stolt udi sin hug. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}