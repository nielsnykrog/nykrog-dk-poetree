  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Vor fader wi bede dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "som oss haffuer lært/ vor Herre Jesus Christ/",
      "part": false,
      "marginal_notes": [
        "Math vi Luce xi"
      ]
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "hør oss dine børn for din godhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "thi du vden twil ret barmhiertig est/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "i hiemmerig er din bolig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "som oss dine ord menne lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "dog stedsse din mact bode dag oc nat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "oss her paa iorden altid beskermer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Helligt worde dit naffn altid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "i huilket allene wi salige bliffue/",
      "part": false,
      "marginal_notes": [
        "Acto. iiii"
      ]
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "giff oss din krafft ath prise det/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "met ord oc gerninger Christelige leffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "tilkomine lad dit Rige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "huilkit retuished/ fred/ oc glæde er/",
      "part": false,
      "marginal_notes": [
        "Rom xiiii"
      ]
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Paa iorden vorde din vilge som i hiemmelen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Ath wi dig lyde/ vor vilge sla neder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Giff oss i dag vort daglige brød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "til liff oc siæl wi bede dig gerne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "forlad oss oc vore synder snøde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "rett lyge som wi weluillige ere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "ath forlade dem oss bryder emod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Oc led oss icke i fristelse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "at oss ey offuerwinder wor fiende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "men frelss oss fra ont altid AMEN",
      "part": false,
      "marginal_notes": []
    }
  ]
}