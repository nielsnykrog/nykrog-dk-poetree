  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1851,
    "url": "https://tekstnet.dk/books/andersen-hc_faderen-vennen-geheimeraad-jonas-collin-den-18-februar-1851/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Med Seirens Grönt Soldaterne hjemdrage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "En Jubel gjennem hele Danmark gaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Og sindrigt, smukt, just mellem disse Dage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Det være maa, din Hæders Festdag staaer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Du ogsaa ærligt kjæmped’ for det Sande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Alt Godt og Herligt tjente Du saa tro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Velsignet er rundtom i Kongens Lande",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Din Virken i Halvtredsindstyve Aar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Din Daad er gjemt i Frugter der vil trives,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Dit Navn det staaer i Slægters Kjærlighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Men ingen Kjærlighed dog större gives",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Til dig, end den, Du i vort Hjerte veed;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Vi, dine Nærmeste, vi Lykkelige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Som dagligt see Dig, dagligt staae Dig nær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Tæl os, som Sjæle i dit Hjerte-Rige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Saa inderligt vi holde af Dig hver.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "See med os mange Aar det Foraars-Grönne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Der opad Muren groer til Spurvens Ly,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Hör med os Fredens Klokker for det Skjönne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Pluk Frugter af det Gode i det Ny.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Med Seiers Blomst staaer »Vang og Vænge,«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Du ogsaa, Oldefader, evig ung;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Du leve med os, leve for os længe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Hurra! da er os ingen Sorg for tung!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
