  "title": "Faderen, Vennen Geheimeraad Jonas Collin, den 18 Februar 1851",
  "year_created": 1851,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
