{
  "id": null,
  "title": "Den rädselsfulde Time",
  "year_created": 1830,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Digte",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1830,
    "url": "https://tekstnet.dk/books/andersen-hc_digte-1830/005/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Es giebt so bange Zeiten,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Es giebt so trüben Muth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Wo alles sich vom weiten",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Gespenstisch zeigen thut.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Kom ei Rundetaarn for nær, er det Midnatstide;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Hvad mig nylig hændte der, skal I faae at vide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Paa Bibliothekethist er ei rart saa silde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Thi ved Midnat holde der Aander Dands og Gilde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Jeg om Dagen gik derop, for en Bog at laane,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Gik en Smule der omkring, og kom til at daane.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Ingen savned’ mig; de gik, jeg blev der alene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Ak, ved selve Tanken end ryste mine Bene!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Længe laae jeg i en Krog uden mindste Spratten;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Da jeg til mig selv nu kom, var det ud paa Natten.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Jeg er ingen Natte-Helt; derfor blev jeg bange;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Dybt i Kirken under mig ligge Døde mange;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Hvis De nu ved Midnatstid kom herop at læse,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "De i Nakken dreied’ mig vist min egen Næse.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Maanen skinnede saa klar, Uglen sang derude,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Maanens Skin og Uglens Sang flød igjennem Rude.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Da blev jeg poetisk stemt, Gud maa hvordan vide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "Og for Øieblikket svandt al min Hjerte-Qvide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "Ak men nu slog Klokken tolv, det var fælt at høre;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "Alle Bøger rundtomkring saae jeg sig at røre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 1,
      "text": "Nogle skjændtes, andre sang, Sproget var lidt blandet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 1,
      "text": "Som paa Babels-Taarn det klang ganske reent forbandet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 1,
      "text": "Alle sprang fra Hylderne, dandsed’ med hinanden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 1,
      "text": "Jeg var bange for at faae, nogle Bind i Panden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 1,
      "text": "See, nu blev en Contradands underligt rangeret,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 1,
      "text": "Mange Bøger dandsed’ med, skjøndt uconfirmeret. –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 1,
      "text": "Langs med Væggen stilled’ sig store Folianter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 1,
      "text": "Det var sikkert satte Folk, eller gamle Tanter. –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 1,
      "text": "Badens Fru Grammatica, smukt forgyldt paa Bagen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 1,
      "text": "Kom at engagere mig, jeg blev som et Lagen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 1,
      "text": "Ak det krilled’ i min Taa, Hjertet steeg til Halsen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 1,
      "text": "Men jeg slap. Cornelius hende bød til Valsen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 1,
      "text": "Atlas af Pontoppidan, klædt i Svinelæder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 1,
      "text": "Med Fru Flora danica hist i Dandsen træder;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 1,
      "text": "Reisers fürgterlige Bog sprang med Iliaden;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 1,
      "text": "Ak det suuste skrækkeligt, som en Storm fra Gaden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 1,
      "text": "Fra Musæet lød en Røst: »Hvad er her paa Færde?«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 1,
      "text": "Og en Landse traadte frem fulgt af tvende Sværde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 1,
      "text": "»Schwerenoth! I lærde Pak! vil I være rolig?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 1,
      "text": "Unde I ei Helten Ro i sin snevre Bolig?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 1,
      "text": "Hvad er vel en lurvet Bog mod en Pantser Plade!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 1,
      "text": "I er’ kun Peermadsens Gang, vi er’ Østergade!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 1,
      "text": "Og nu hugged’ Sværdet om, saa der Funker lyste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 1,
      "text": "Det var fælt, det kan I troe, al mit Hjerte gyste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 1,
      "text": "Bøgerne fik ogsaa Skræk, hvert et Blad jo bæved’,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 1,
      "text": "Som en broget Fuglehær De til Hjemmet svæved’,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 1,
      "text": "Og paa Hylderne i Hast deres Pladser søgte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 1,
      "text": "Men hist i Musæet, ak! det langt værre spøgte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 1,
      "text": "Op af hver en Askepot steeg de Dødes Bene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 1,
      "text": "Uh! en Ildstrøm risled’ mig gjennem hver en Sene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 1,
      "text": "Sylfelet jeg følte mig, Døren op jeg sprænger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 1,
      "text": "Ak, hvad seer jeg! – Rundetaarn er der ikke længer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 1,
      "text": "Støtten liig i Don Juan Taarnet promenerte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 1,
      "text": "Men slig Vandring kan I tro, fælt mig her generte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 1,
      "text": "Afgrund for og Aander bag værre er end Døden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 1,
      "text": "Maanen stod saa lasket feed, hjalp mig ei i Nøden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 1,
      "text": "Som en Sappho stod jeg her, Vinden tog i Kjolen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 1,
      "text": "Nede Vægteren jeg saae, blaa som Martsviolen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 1,
      "text": "Deilig var min Monolog, Ingen den kan fatte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 1,
      "text": "Først jeg selv min Død begræd, lod mig derpaa dratte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 1,
      "text": "Vinden peeb i Marv og Been, alt mit Indre raaber,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 1,
      "text": "Men til Lykke havde jeg hos mig Hoffmannsdraaber.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 1,
      "text": "Au! det var et hæsligt Stød. – – – –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 1,
      "text": "– – Himmel! see dog bare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 1,
      "text": "Jeg jo ligger i min Seng uden mindste Fare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 1,
      "text": "Alt det Hele var en Drøm, Himlen være lovet!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 1,
      "text": "Læser, gid Du vaagne maa, dersom Du har sovet!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
