  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Mig tyckis at Verden er vnderlig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hun haffuer saa meget at skencke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Met sorrig oc kummer baade falsk oc suig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "vil mand det ret betencke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "hun maa vel lignis ved det Jiss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "der mand kand snart paafalde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "huo paa hannem bygger/ hand er wuiss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "hand bliffuer besuigt met alle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "O euig Gud du styrck min tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Mit kaarss taalmodig at bære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Thi her er huercken huile eller ro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Men wi i Verden ere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Thi maa wi vel sucke oc robe til Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Oc hannem aff hiertet paakalde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Thi hand er baade mild oc god/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Hand hielper oc trøster oss alle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Det kand ieg kiende/ baade tid oc stund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "At Gud er altid tilstæde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "At hielpe aff Naade oc stor miskund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Det er min største glæde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Thi hand siger/ Kommer hid alle til mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Som bedrøffuit oc sorrigfuld ere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Jeg vil eder trøste oc vederquege/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Thi ieg er Gud eders Herre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Den tid min sorrig vaar allerstørst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Mit hierte vaar vee oc bange/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Da kom Gud mig til hielp oc trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Forløste mig arme fange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Som hand giorde ved den Gudelig mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Som wi monne Joseph kalde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Gud førde hannem gennem Egypti land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Saa hielper Gud sine Børn alle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Alle de dage ieg leffue maa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "Jeg kand ey sige til ende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "Huorledis Gud naadelig til mig saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "Der ieg vaar gantske ælende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "Som hand giorde ved Elizabeth/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "Det vaar en fattige Quinde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "Gud holder vist det hand haffuer iet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "Som wi maa daglige befinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "Jt angerfult hierte aff sorrig oc vee/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "Som Dauid monne bescriffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 5,
      "text": "Vil Gud aff sin store naade tilsee/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 5,
      "text": "Vil mand i troen bliffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 5,
      "text": "Hand vil ey andet haffue til løn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "Som scrifften monne oss lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "End it ydmygt hierte oc gudelig Bøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "Thi prise wi hannem oc ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "Jeg raader eder alle met gantske flid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 6,
      "text": "Alt baade Mand oc Quinde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 6,
      "text": "Til Gud allene setter eders lid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 6,
      "text": "Saa kunde i vel offueruinde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 6,
      "text": "Den store bedrøffuelse i Verden er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "Som wi for synden bære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "Gud reffser dem hand haffuer kier/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "Oc vil dem naadig være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 7,
      "text": "Christus Jesus baade Gud oc mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 7,
      "text": "Vor broder loed hand sig kalde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 7,
      "text": "Synd oc Døden hand offueruand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 7,
      "text": "Der met hand frelste alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 7,
      "text": "Fra Helffuedis pine oc euige død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 7,
      "text": "Som Adam monne forhuærffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 7,
      "text": "Thi hand Guds bud i Paradiss brød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "Ved Christum wi liffuit skulle arffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 8,
      "text": "Wi skulle dog alle met Jesu Christ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 8,
      "text": "J Kaarssens tuang være lige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 8,
      "text": "Om wi skulle Ærens Krune faa vist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 8,
      "text": "Met hannem i Himmerige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 8,
      "text": "Apostlernis kaarss oc salige ord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 8,
      "text": "Lærer oss det at begrunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 8,
      "text": "Met modgang oc bedrøffuelse stor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 8,
      "text": "Til Guds rige skulle wi stunde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 9,
      "text": "Om huer hand vilde betencke den tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 9,
      "text": "Naar Christus kommer at dømme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 9,
      "text": "J Guds fryct skulle huer leffue met flid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 9,
      "text": "Taalmodighed icke forglemme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 9,
      "text": "Da stod mand vel aff synd oc last/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 9,
      "text": "Som døden haffuer at føre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 9,
      "text": "Oc icke bygde paa Verden saa fast/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 9,
      "text": "Som mange diss værre nu giøre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 10,
      "text": "Brødre oc Søstre ere wi alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 10,
      "text": "Baade fattige oc Rige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 10,
      "text": "Oc naar Gud vil oss aff Verden kalde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 10,
      "text": "Da bliffue wi alle lige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 10,
      "text": "Huor er da den praal oc store Hoffmod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 10,
      "text": "Den wi oss daglig i vende?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 10,
      "text": "Der til Gerighed den onde roed?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 10,
      "text": "Det haffuer alt da en ende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 11,
      "text": "Sandhedsens Aand beuare mig nu",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 11,
      "text": "J troen at bliffue til ende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 11,
      "text": "At wi kunde baade met hierte oc hu",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 11,
      "text": "Vort sind fra Verden vende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 11,
      "text": "Oc bliffue hoss Christum vor Frelsermand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 11,
      "text": "Som er vor Gud oc Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 11,
      "text": "Besidde met hannem vort Fæderneland/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 11,
      "text": "Der er saa lystigt at være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 12,
      "text": "Loff ære være Gud i euighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 12,
      "text": "For sin Guddommelig naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 12,
      "text": "Disligest hans Søn euindelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 12,
      "text": "Som frelst haffuer oss aff vaade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 12,
      "text": "Den hellig Aand ske lige saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 12,
      "text": "Det bede wi allesammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 12,
      "text": "At hand vil trolig met oss staa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 12,
      "text": "Wi siunge aff hiertet/ Amen.",
      "part": false,
      "marginal_notes": []
    }
  ]
}