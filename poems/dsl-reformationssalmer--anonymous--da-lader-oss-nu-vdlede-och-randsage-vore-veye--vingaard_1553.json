    {
      "id": 0,
      "stanza_id": 0,
      "text": "⁕ Da lader oss nu vdlede och randsage vore Veye/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Oc vende oss om igen til Herren/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Lader oss opløffte vore Hierter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "met henderne til Gud i Hiemmelen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Vi ære bleffne affaldige oc wlydige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Det haffuer du icke villit til giffue",
      "part": false,
      "marginal_notes": []
    }
  ]
