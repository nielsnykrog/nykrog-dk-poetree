{
  "id": null,
  "title": "Adelbrand",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA157.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Der war drøck paa heelle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "der drack kemper suelle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": ":: Y-huor langtt som y weell! ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Der wor lyden Kiersteenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "der waar och staaltt Kaarrenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "Lyddenn Kierstenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "der waar och staaltt Kaarrenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Dy wor denom att thrette,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "huelckenn fierste haade haard.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "Att thrette.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "hueelckenn fieerste haadde haar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "Kieerstenn fierste haadde haar;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "huellckenn beest biyrdig waar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "Haade haar;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "huelckenn best biurdig waar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "Kierstenn waar saa wenn enn møø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "hynder bad saa rige beegle vnder øø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "Saa weenn enn møø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "hynder bad saa rige beeglle vnder øø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 5,
      "text": "Hynnder bad herttug Hyldebraand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "kongenns sønn aff Engeland.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 6,
      "text": "Hyldebrand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 6,
      "text": "konggenns sønn aff Engellannd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 6,
      "text": "Hand gaff hinder thett guld saa rød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "hand kunde icke faa den wene møø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 7,
      "text": "Guld saa rød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 7,
      "text": "hand kunde icke faa denn weene møø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 7,
      "text": "Hand gaff hynder dy gulde-rynge smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "hand kunnde icke aff thend iumfru faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 8,
      "text": "Gulde-ringe smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 8,
      "text": "hannd kunde icke aff thend iumfru faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 8,
      "text": "\"Thaa skaall ieg hynnder med woldden thagge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "men hun weell meg icke med errenn haffue!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 9,
      "text": "Wolldenn thage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 9,
      "text": "menn hun weell meg icke med errenn haffue!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 9,
      "text": "Thett stuod saa y wynntter firre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "thend iumfru thuorde icke till kierkenn ryde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 10,
      "text": "Wyntter fyrre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 10,
      "text": "denn iumfru thuorde icke till kierkenn ryde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 10,
      "text": "Thett wor om enn iylle-dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "till kieerkenn wyllde thennd speeddell kllaar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 11,
      "text": "Iulle-dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 11,
      "text": "tell kierckenn wyllde thennd speedell kllaar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 11,
      "text": "Iumfruen ogg y grønenn lund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "ther mødder hynder Hylldebrand y krannkenn stund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 12,
      "text": "Grønnenn lund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 12,
      "text": "ther møødder hynnder Hylldebrand y krannken stund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 12,
      "text": "Hand red seeg till heenggind karum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "mynditt thenn iumfru, tog hynder y arum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 13,
      "text": "Hennggind karum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 13,
      "text": "mynnditt thend iumfru, thog hynder y arum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 13,
      "text": "Hand tog iumfruenn weed huydenn haand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 13,
      "text": "hand bannd hynd till synn saadell-baanndd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 14,
      "text": "Huyddenn haannd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 14,
      "text": "hand baannd hynnd tieell synn saaddelboond.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 14,
      "text": "Buode beecke och dybbe sigge:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "thed rydder Hyllde-brannd alld tillygge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 15,
      "text": "Dybbe sygge:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 15,
      "text": "thett rydder Hyllde-braand alld teellygge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 15,
      "text": "thett wor alldder saa breed enn daam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 15,
      "text": "thett Hyllde-brands ganger io offuer saam.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 16,
      "text": "Breed enn daam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 16,
      "text": "thett Hyllde-brandthis gaanger io offuer saam.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 16,
      "text": "Thett wor aldrig saa lyddenn en quest",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 16,
      "text": "hun tog iog guldenn aff iumfruens brøst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 17,
      "text": "Lyddenn enn queest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 17,
      "text": "hun tog ioo guldenn aff iumfruens brøst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 17,
      "text": "Thett wor aldrig saa lyddenn enn ruod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 17,
      "text": "hun stuod io bloddig y iumfruens fuod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 18,
      "text": "Lyddenn enn rodd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 18,
      "text": "hun stuod io blodig y iumfruens fuod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 18,
      "text": "Der thy kaam y grønnenn lund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 18,
      "text": "der bad iumfruenn huille enn stund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 19,
      "text": "Grønnenn lund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 19,
      "text": "der baad iumfruenn huille enn stund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 19,
      "text": "\"Icke saa weell ieg huille meed dieg;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 19,
      "text": "for du wilde aldrig tro-loffue meg!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 20,
      "text": "Hwille meed dieg;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 20,
      "text": "for du wylde aldrig tro-loffue meg!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 20,
      "text": "\"Weelltt thu icke huylle med meg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 20,
      "text": "y lyffue kaand ieg icke følge dieeg!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 21,
      "text": "Huylle med meg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 21,
      "text": "i lyffue kannd ieg icke følge deeg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 21,
      "text": "Thu thaa mynn seerck saa bloddig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 21,
      "text": "och før deenn till mynn muoder!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 22,
      "text": "Saa blodig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 22,
      "text": "och før denn tieell mynn muodder!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 22,
      "text": "Du beed hynnd bleeg och tuo hynnd vd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 22,
      "text": "møde meg y-morgenn wed Strolsund!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 23,
      "text": "Och tuo hynnd vd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 23,
      "text": "møødde meg y-morgenn weed Strolsund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 23,
      "text": "Thu bed hynd thuo och bleg enn huidd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 23,
      "text": "kome y-morgenn och følgge mytt lygg!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 24,
      "text": "Och bleg en huid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 24,
      "text": "kome y-morgenn och føllge mitt lyg!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 24,
      "text": "Hyldebrand nedder fraa ganger rand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 24,
      "text": "med gylltte biedseell y huiddenn haannd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 25,
      "text": "Ganger rannd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 25,
      "text": "med gylltte biedseell y huidenn haand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 25,
      "text": "Hyllde-brannd feeck aldrig enn større quide:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 25,
      "text": "iumfruen døde alltt wed hans sydde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 26,
      "text": "Større quidde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 26,
      "text": "iumfruenn døde alltt weed hans sydde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 26,
      "text": "Hylde-brannd feeck aldrig enn større harum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 26,
      "text": "iumfruenn dødde vdi hanns arum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 27,
      "text": "Større haarum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 27,
      "text": "iumfruenn dødde vdi hanns arum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 27,
      "text": "\"Nu skaall ieg laadde thett koolde staall",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 27,
      "text": "raade for skeell och skrøffte-maall!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 28,
      "text": "Kallde staall",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 28,
      "text": "raade for skeell och skrefftte-maall!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 28,
      "text": "Nu skall ieg laade thett koolde iaarnn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 28,
      "text": "slucke buode sorrig och hiarttens harum!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 29,
      "text": "Kollde iaarnn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 29,
      "text": "sluocke buode sorig och hiartens harum!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 29,
      "text": "Hyllde-brand waar denn døø vuerdt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 29,
      "text": "hand stuock seeg paa syn egen suardtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 30,
      "text": "Død vweerdtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 30,
      "text": "hand stuock seeg paa syn eggen suerdtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
