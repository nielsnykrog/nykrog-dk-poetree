  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Som før Leander gjennem Havets Bølger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Hver Aftenstund sig skyndte til sin Mø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Saa iler, men langt oftere, min Tanke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Til dig igjennem Dagens Travlhedssø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Men ak, den er jo ikkun dog en Tanke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Naar nølende fra dig den drager bort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Og har ej Værd som hines Elskovsmøde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Var det selv mer end Tankemødet kort.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Men er det end ej andet end en Tanke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Der minder om et dybt og bittert Savn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Til dig den kold og uden Liv ej komme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Skal som Leander kom til Heros Favn.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
