{
  "id": null,
  "title": "† Digteren Adalbert von Chamisso,",
  "year_created": 1838,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1838,
    "url": "https://tekstnet.dk/books/andersen-hc_digteren-adalbert-von-chamisso/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Saa har jeg mistet Dig, Du Eiegode!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Din Trøst, Din Glæde hører jeg ei meer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Du saae i hvad vor Herre mig betroede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Saa meget – som kun Faderøiet seer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Er det forfængeligt, jeg i min Smerte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Just føler, hvad jeg ved Dit Bifald vandt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Nu, meer end før, Du læse kan mit Hjerte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Nu bedst Du seer, hvorvidt Dit Haab var sandt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Der fløi en Svane rundt om hele Jorden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Den lagde Hoved i den Vildes Skjød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Og Kjærlighed den vandt i Syd, som Norden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Fra Hermans Skove Dine Hymner lød’;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Sidst var det Føde-Egnens Friheds-Sange<button id=note1 type=button class=\"btn btn-outline-secondary btn-sm comment\" data-container=body data-toggle=popover data-template=\"<div class='popover' role='tooltip'><div class='arrow'></div><h3 class='popover-header'></h3><div class='popover-body'></div></div>\" data-placement=auto data-html=true data-content=\" <p> Chamisso var Nfødt i Frankrige af franske Forældre; hans sidste Værk er en netop Ni disse Dage udkommen Gjengivelse af .</p> \" data-title=\" Fodnote 1\">F1</button>,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Og verdenshjemlig blev hiin Melodi;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Da brast det Hjerte, hvoraf ei er’ mange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "I Sorg staae Videnskab og Poesi.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
