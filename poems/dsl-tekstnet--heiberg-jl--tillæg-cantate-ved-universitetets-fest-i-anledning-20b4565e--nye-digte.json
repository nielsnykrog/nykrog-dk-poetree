{
  "id": null,
  "title": "Tillæg. Cantate ved Universitetets Fest i Anledning af Reformationens Indførelse samt Rectorskiftet",
  "year_created": 1841,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Johan Ludvig Heiberg",
    "country": null,
    "wiki": "Q402274"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Nye Digte",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1841,
    "url": "https://tekstnet.dk/books/heiberg-jl_nye-digte/005/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Vær hilset, Lys fra Sandheds Væld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Som har i trende Secler funklet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Som aldrig vorde skal fordunklet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Men sprede Klarhed, Liv og Held!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Du strømmed ind i Verdens Øie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Og Tanken for sig selv blev klar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Og Gud for Tanken aabenbar;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "De monne sig til Eenhed føie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Lig Bækken med sit Udsprings Elv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Thi Tanken opsteg til det Høie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Dengang den nedsteg i sig selv.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Stjernen stod paa Nattens Himmel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Og fordunkled alle dem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Som til Krands om Bethlehem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Slynged sig i talløs Vrimmel.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Vise Mænd ved Stjernens Magt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Droges hen ad fjerne Veie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Knælte ved det ringe Leie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Hvorpaa Frelseren var lagt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Stjernen svandt; paanye den glimter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Efter femten hundred Aar;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "Dog paa Himlen ei den staaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "Mennesket i sig den skimter;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "Og den leder vise Mænd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 1,
      "text": "Did, hvor over alle Throner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 1,
      "text": "End den himmelske Forsoner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 1,
      "text": "Sees i Lysningen af den.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Men hiin hellige Stjerne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Som nu flammer i Menneskets Bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "Skal den ei i det Ydre, det Fjerne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "Lyse til Menneskets Trøst?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "Jo! det Lys, der flammer i det Indre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "Skal med ydre, stærke Straaler tindre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 2,
      "text": "See, det blusser, tændt af Luthers Hænder!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 2,
      "text": "Lyset har forvandlet sig til Ild;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 2,
      "text": "Baalet flammer, Pavens Bulle brænder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 2,
      "text": "Røgen slaaer mod Himlen vred og vild.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 2,
      "text": "Det er Tegnet, som til Kamp er givet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 2,
      "text": "Tegn til Kamp for Troen og for Livet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 2,
      "text": "Ras kun, Flamme! Graadig du dig slynge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 2,
      "text": "Om det Aag, som tør paa Kirken tynge!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 2,
      "text": "Vredens Element, som ei betænker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 2,
      "text": "Hvad du griber med dit røde Blus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 2,
      "text": "Viis, du kan fortære Troens Lænker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 2,
      "text": "Du, som har fortæret Johan Huss!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 2,
      "text": "See! din Straale slynges af en Svane;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 2,
      "text": "Romas Ørn dig tabte paa sin Bane.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 3,
      "text": "Det Helliges Forkynder skal ej længer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 3,
      "text": "Sig sondre fra den Verden, Gud har kjær;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 3,
      "text": "Man Klostrets Døre sprænger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 3,
      "text": "Og Munk med Nonne sig til Altret trænger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 3,
      "text": "At knytte Pagten, som for Gud har Værd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 3,
      "text": "Som første Par, der Troskabseden bringer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 3,
      "text": "Gaar Martin selv ved Catharinas Haand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 3,
      "text": "Og Kirkeklokken ringer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 3,
      "text": "Og Præsten vier dem, og Sangen klinger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 3,
      "text": "Og Pagten signet er af Herrens Aand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 3,
      "text": "Og Stat og Kirke sig forente finde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 3,
      "text": "Ved Kjærlighedens elskelige Bud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 3,
      "text": "Det Baand, som Hjerter binde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 3,
      "text": "Den frie Pagt imellem Mand og Kvinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 3,
      "text": "Familien er helliget for Gud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 4,
      "text": "Men hiin hellige Stjerne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 4,
      "text": "Som nu flammer i Menneskets Bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 4,
      "text": "Skal den ei til det Ydre, det Fjerne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 4,
      "text": "Tale med flammende Røst?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 4,
      "text": "Jo, Lyset vorde skal til Ord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 4,
      "text": "Som Ordet forhen Lys er blevet;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 4,
      "text": "Man læse skal paa viden Jord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 4,
      "text": "Hvad Aanden har med Flammer skrevet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 4,
      "text": "Og lyste Stjernen fordum hen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 4,
      "text": "Til Evangeliet i Vugge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 4,
      "text": "Saa skal den lyse nu igjen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 4,
      "text": "For Dem, som efter Ordet sukke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 5,
      "text": "I Saxernes Land en mægtig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 5,
      "text": "Skovgroet Klippe staaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 5,
      "text": "Derpaa en fordum prægtig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 5,
      "text": "Stor og fyrstelig Gaard.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 5,
      "text": "Som ringe Fuglerede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 5,
      "text": "Den hænger i Klippens Favn;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 5,
      "text": "Wartburg monne den hedde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 5,
      "text": "Wartburg er Slottets Navn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 5,
      "text": "Fra liden Celle derinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 5,
      "text": "Vendt mod en Afgrund brat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 5,
      "text": "Saae man et Lys at skinne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 5,
      "text": "Gjennem den mørke Nat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 5,
      "text": "Der sad den Troens Opliver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 5,
      "text": "Med Lampen paa sit Bord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 5,
      "text": "Og tolked med hellig Iver",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 5,
      "text": "Herrens hellige Ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 5,
      "text": "Saa vidt i Dalene trænger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 5,
      "text": "Lyset fra Vinduets Baal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 5,
      "text": "Men Ordet flyver dog længer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 5,
      "text": "Baaret af Folkets Maal.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 5,
      "text": "Det lyder for hvert et Øre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 5,
      "text": "Det toner i hvert et Bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 5,
      "text": "Det lader sin Fylde høre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 5,
      "text": "Med fyldig, levende Røst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 5,
      "text": "For Evangeliets Fugle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 5,
      "text": "Wartburg, en Rede du var,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 5,
      "text": "Hvori du mod Ravn og Ugle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 5,
      "text": "De Fjerløse vogtet har.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 5,
      "text": "Da voxte den spæde Vinge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 5,
      "text": "Den folded sig ud paa Stand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 5,
      "text": "Da monne sig Fuglene svinge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 5,
      "text": "Over det ganske Land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 6,
      "text": "Ha! men Kampens Torden ruller,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 6,
      "text": "Vaabenbulder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 6,
      "text": "Ryster Kirkens faste Grund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 6,
      "text": "Ikke nok, at Pen og Mund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 6,
      "text": "Vundne Frihed vil forsvare;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 6,
      "text": "Friheds Fare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 6,
      "text": "Samier Verdens Folk i blodig Stund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 7,
      "text": "Hil Dem, som kæmped, som med Ord og Vaaben",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 7,
      "text": "lilte til Strid!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 7,
      "text": "Freden er vunden, Himlen er nu aaben,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 7,
      "text": "Luften er blid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 7,
      "text": "Stjernen paanye i stille, klare Nætter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 7,
      "text": "Kaster paa Kirken uformørket Glands,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 7,
      "text": "Menigheden fletter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 7,
      "text": "Frihedens Krands.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 7,
      "text": "Fædreland, hil dig! Stjernen dine Strande",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 7,
      "text": "Hilste med Lyst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 7,
      "text": "Speilte sit Billed i de sølvblaae Vande",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 7,
      "text": "Trindt om din Kyst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 7,
      "text": "Sletternes Kirke Spiret mod den vendte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 7,
      "text": "Snart som en Sol den funkled over Strand;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 7,
      "text": "Sandhed du erkjendte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 7,
      "text": "Fædreneland!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 7,
      "text": "Lyset i Sjælen voved ud at stræbe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 7,
      "text": "Skranken blev sprængt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 7,
      "text": "Ordet nu toned paa den danske Læbe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 7,
      "text": "Længe fortrængt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 7,
      "text": "Tanken med egen Frihed sig forkyndte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 7,
      "text": "Mægtig den voxer paa den danske Vang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 7,
      "text": "Morgenen begyndte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 7,
      "text": "Dagen er lang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 8,
      "text": "Vær hilset, Lys fra Sandheds Væld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 8,
      "text": "Som har i trende Secler funklet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 8,
      "text": "Som aldrig vorde skal fordunklet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 8,
      "text": "Men sprede Klarhed, Liv og Held!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 8,
      "text": "Din stærke Straale gjennembryder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 8,
      "text": "Hver skal om Livets Lyst og Sorg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 8,
      "text": "Og i din rige Glands det lyder:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 8,
      "text": "»Vor Gud han er saa fast en Borg.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 9,
      "text": "Videnskabens Tempel! I din Hal",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 9,
      "text": "Takkesangen høit sig hæve skal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 9,
      "text": "Mindet dvæle ved den gode Stund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 9,
      "text": "Da Friheds ædle Ceder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 9,
      "text": "Blev plantet dybt i Kirkens Grund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 9,
      "text": "Hvori den voxte til en Lund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 9,
      "text": "Som nu om Skolen freder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 9,
      "text": "Hæv dit ranke Spiir mod høien Sky,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 9,
      "text": "Lad dit indre Liv sig frit fornye",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 9,
      "text": "Fra den Slægt som gik, til den som kom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 9,
      "text": "Og ført paa Troens Vinge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 9,
      "text": "Din Viden vorde dyb og from,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 9,
      "text": "At Tanken fra din Helligdom",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 9,
      "text": "Sig kan mod Himlen svinge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 9,
      "text": "Hellige Flamme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 9,
      "text": "Styrk i din Glands",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 9,
      "text": "Alle, som kæmpe for Musernes Krands!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 9,
      "text": "Kundskab, din Stamme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 9,
      "text": "Blomstrende staae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 9,
      "text": "Evig, mens Tiderne vexlende gaae!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
