  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift II",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVII56.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Dett vor fru Kremoldt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hun lod miøden blende:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "thet vor saa mangen fri helled,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "hun budet effter sendt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "\"Du bed dennom komme til orloff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "du bed dennom komme till krigs:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "der skal saa mangen fri helled",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "forlade sith unge liiff.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Dett vor Helli Hagens moder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "hun drømpte saa underlig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "at den gode foole styrte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "som hand skulle hen riide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "\"Denn drøm hand haffuer at sede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "kiære som møye:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "vocte dig alt fuld saare vell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "din søster forraade dig.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Dett vor Helle Hagen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "hand red fram vid den strandt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "hand fand paa den mare-viiff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "paa den huid sandt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "\"Sige mig det, god maræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "mon du est en kunstig quinde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "skal ieg paa dig hodemske landt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "forlade unge liiff min?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "\"Hør du Helli Hagen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "du est en rider god:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "nock haffuer du paa din egene landt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "de borriger alt saa gode.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "Du haffuer bode guld oc sølff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "fester oc borger rød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "kommer du i det hedenske landt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "daa bliffuer du raadd till dødt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "Dett vor Helli Hagen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "hand vredis vid de ord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "hand sla den arme mare-viff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "neder till den iord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "\"Der da maa du ligge død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "paa den huide sandt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "fuld vell vill ieg affter komme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "aff den henske land.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "De rede uden for den port,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "tho saa erlige mend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "de vore vell klede i silcke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "dieris heste vell springe kandt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "De sloge paa de porte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "dett gielde i den slott:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "\"Huor er nu den porterner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "som oss skal lade op?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "Dett daa suarid den portener",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "saa listelig under skind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "\"Ieg tør icke for min frue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "saa lade eder indt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 13,
      "text": "Hand gick til fru Kremold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "spurde hand hinde saa brat:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "\"Her holder tho riider for vor borg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "de beder mig oplade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "Her holder uden for vor gaard",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "tho saa erlige mendt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "de ere kledde i silcke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "dieris heste vel springe kand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 15,
      "text": "Den ene hand fører en fidel-bowe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "den anden fører en øffne;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "det vil ieg for sanden sige:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "det er tho kemper stercke.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 16,
      "text": "Det suarid fru Kremald,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "saa suarid hun der-till:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "\"Det er Helli Hagen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "oc Falckor Spillemandt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 16,
      "text": "bode er dett min brøder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 16,
      "text": "dett siger ieg for sant.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "Neder ginge fruer oc iomfruer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "skodde de ridders gang:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 17,
      "text": "di vore smalle i middi",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 17,
      "text": "oc vell til maade lange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "Det vor fru Kremald,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "tog offuer sig skarlogen-skind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 18,
      "text": "saa gick hun y gaarde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 18,
      "text": "oc baad de helled ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "\"Her maa ingen suerde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "paa dett slott nu drage:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 19,
      "text": "mig tyck dett saa ilde at være,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 19,
      "text": "koning Segfred hand bleff stagen.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "\"Ieg voog koning Geffred",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "met min egen haand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 20,
      "text": "ieg gaff koning Otte lin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 20,
      "text": "dett vor saa from en mandt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "Daa myste ieg min bryne god",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 21,
      "text": "i dett samme slag;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 21,
      "text": "ieg myste oc min gode hest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 21,
      "text": "for Troyen som wi laa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 22,
      "text": "Hun fulde ham paa saa stor en sall",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 22,
      "text": "till hundrit kemper fin:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 22,
      "text": "alle stod de mod de rider thoo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 22,
      "text": "met dragen suerdt i heendt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 23,
      "text": "\"Er her nogen inde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 23,
      "text": "der min broder vil vege:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 23,
      "text": "daa maa de raade hans guld oc sølff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 23,
      "text": "dertil hans borg saa rød.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 24,
      "text": "Dett hørde Falcko Spillemandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 24,
      "text": "hand snart offuer borden spranck:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 24,
      "text": "ham glede suerdt aff skeede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 24,
      "text": "de dørre aff ierne spranck;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 24,
      "text": "end fick hand udi sin haand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 24,
      "text": "saa stor en stoll-stang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 25,
      "text": "Der hand fick den store stong,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 25,
      "text": "da bleff hand saa glad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 25,
      "text": "hand slaa vel XXX kemper",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 25,
      "text": "udaff sine stercke slag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 26,
      "text": "\"Eia,\" sagde Falckor Spille-mandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 26,
      "text": "\"nu gaar min fiddel i lawe.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 26,
      "text": "Da slog Hille Hagen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 26,
      "text": "XX det same slag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 27,
      "text": "Dett vor fru Kremald,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 27,
      "text": "hun giorde sig saa vred:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 27,
      "text": "\"Beder mattu dig hieme ver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 27,
      "text": "end du her ud-red.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 28,
      "text": "Her er vel hundre encker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 28,
      "text": "før du lader denne stredt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 28,
      "text": "Dett suar Helli Hagen:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 28,
      "text": "\"Dett haffuer du selff flyed.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 29,
      "text": "Dett vor Helli Hagen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 29,
      "text": "hand løste op hielmen sin:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 29,
      "text": "\"Mig brender alt saa sare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 29,
      "text": "under haarde bryne min.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 30,
      "text": "Ieg er bode træt oc mod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 30,
      "text": "alt aff hierte min:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 30,
      "text": "giff dett Gud udi Himmerige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 30,
      "text": "ieg haffde en horn met vin.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 31,
      "text": "Hand strøg op sit hielmenet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 31,
      "text": "hand drock aff mande-blodt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 31,
      "text": "\"In nomen din\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 31,
      "text": "vor Helled Hagens ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 32,
      "text": "\"Nu ligger alle fru Kremolds kiemper",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 32,
      "text": "slagen død til iord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 32,
      "text": "oc der-til Falckor Spillemandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 32,
      "text": "min hierte kiere broder:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 32,
      "text": "ussen maa ieg sige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 32,
      "text": "dett ieg heden foer.\"",
      "part": false,
      "marginal_notes": []
    }
  ]
}