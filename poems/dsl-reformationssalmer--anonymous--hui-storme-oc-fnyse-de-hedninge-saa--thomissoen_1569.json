  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Hui storme oc fnyse de Hedninge saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc lade saa megit ilde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Wnyttige raad gaar folckene paa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "som Gud icke haffue vilde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "De Konger paa Jorden bestercke sig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "oc Førster forsamlet ere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "imod Christum din Søn oc dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Gud lad det icke saa være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Forbarme dig offuer oss Herre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Lad oss bryde sønder deris baand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Oc deris Aag bortkaste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Den som boer i Himmerigis throne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Skal det aff dem vist laste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Oc haanlige foracte saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Oc tale til dem met vrede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Oc i sin grumhed met redsel sla/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "For de vaare icke til rede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Oc hannem om naade bede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Gud haffuer sæt til Kong sin Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Offuer oss Christne alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Oc aff hannem skal tage løn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Der hand til hannem saa talde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Du est min Søn/ Jeg fødde dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "J dag/ som mig vel behagde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Jeg skal dig giffue/ eske du aff mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Hedninge til arff at haffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Oc Verden til euig gaffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Jngen skal kunde staa dig imod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Du skalt dem sønder bryde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Oc træde dem alle vnder din fod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Som dig icke vilde lyde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "J Konger værer kloge saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "Oc lader eder vnderuise/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "Som Jorderigis dom skulle bestaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "At i Gud ære oc prise/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "Saa faa i Ro oc lise.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "Tiener eders Herre Gud met fryct/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "Oc glæder eder met fare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "Anammer Guds sande Ord met tuct/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "Saa kunde i veyen beuare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "Naar hans grumhed optendis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "Da lider dem vel alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "Som icke fra hannem vendis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "Men trolige paa hannem kalde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "Gud vnde oss glæden alle.",
      "part": false,
      "marginal_notes": []
    }
  ]
}