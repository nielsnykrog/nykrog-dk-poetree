  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Solen Finns",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1936,
    "url": "https://tekstnet.dk/books/munch-petersen-g_solen-finns/065/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "våra båtar duger icke längre -,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "för bräckliga, för tunga i vattnet -,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "vårt mod är för trött för sådana fartyg -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "små, starka lätta båtar är vad vi behöver -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "vi måste berusa oss i starkt vin, att",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "vi glömmer havet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "att vi glömmer livet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "att bara giftet finns -,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "vi måste berusa oss i vin, att",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "våra lätta båtar blir väldiga skepp,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "som glömskt och obevekligt går mot kustar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "som icke ens ruset vågat nämna -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "bort måste vi -,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "andra båtar måste vi skaffa oss -,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "landet fördärvar vårt blod -",
      "part": false,
      "marginal_notes": []
    }
  ]
}
