  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Esaias den Prophet monne det saa gaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "at hand i Aanden Herren sidde saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "J den høye Throne oc klare skin/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "hans klæder opfylte det Chor omkring/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Tho Seraphin stode hoss hannem der/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Sex vinger saa hand dennem haffue huer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "met de tho skiulte de deris Ansict klar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "met tho betecte de deris Føder bar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "oc met de andre tho fløye de frijt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "mod huer andre raabte de met megen flijt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Hellig er Gud vor Herre Zebaoth/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Hellig er Gud vor Herre Zebaoth/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Hellig er Gud vor Herre Zebaoth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Som haffuer all Jorden opfylt met megit gaat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Aff det raab skalff grunduol oc bielcker suar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "oc Husit fuld aff røg oc taage vaar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "BEnedicite Domino omnes Angeli eius,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "potentes virtute,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "qui facitis verbum eius",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "ad audiendam vocem sermonum eius.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Benedic anima mea Domino:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "et omnia quæ intra me sunt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "nomini sancto eius.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Gloria Patri et Filio et Spiritui sancto:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Sicut erat in principio et nunc et semper/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "et in secula seculorum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "HAleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Concussum est mare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "et contremuit terra,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "vbi archangelus Michaël descendebat de coelo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "TE Deum laudamus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "te Dominum confitemur.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "Te æternum patrem omnis terra veneratur.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "Tibi omnes angeli,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "tibi coeli et vniuersæ potestates.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "Tibi Cherubin et Seraphin incessabili voce proclamant.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "Sanctus. Sanctus. Sanctus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "Dominus Deus sabaoth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "Pleni sunt coeli et terra maiestatis gloriæ tuæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "Te gloriosus apostolorum Chorus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "Te prophetarum laudabilis numerus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "Te martyrum candidatus laudat exercitus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "Te per orbem terrarum sancta confitetur ecclesia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 4,
      "text": "Patrem immensæ maiestatis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 4,
      "text": "Venerandum tuum verum et vnicum Filium.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 4,
      "text": "Sanctum quoque paracletum spiritum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 4,
      "text": "Tu rex gloriæ Christe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 4,
      "text": "Tu patris sempiternus es Filius.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 4,
      "text": "Tu ad liberandum suscepturus hominem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 4,
      "text": "non horruisti virginis vterum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 4,
      "text": "Tu deuicto mortis aculeo aperuisti credentibus regna coelorum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 4,
      "text": "Tu ad dexteram Dei sedes in gloria patris.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 4,
      "text": "Judex crederis esse venturus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 4,
      "text": "Te ergo quesumus famulis tuis subueni,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 4,
      "text": "quos precioso sanguine redemisti.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 4,
      "text": "Æterna fac cum sanctis tuis gloria munerari.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 4,
      "text": "Saluum fac populum tuum Domine,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 4,
      "text": "et benedic hæreditati tuæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 4,
      "text": "Et rege eos,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 4,
      "text": "et extolle illos vsque in æternum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 4,
      "text": "Per singulos dies benedicimus te.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 4,
      "text": "Et laudamus nomen tuum in seculum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 4,
      "text": "et in seculum seculi.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 4,
      "text": "Dignare Domine die isto sine peccato nos custodire.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 4,
      "text": "Miserere nostri Domine,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 4,
      "text": "miserere nostri.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 4,
      "text": "Fiat misericordia tua Domine super nos,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 4,
      "text": "quemadmodum sperauimus in te.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 4,
      "text": "Jn te Domine speraui,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 4,
      "text": "non confundar in æternum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 5,
      "text": "O Gud wi loffue dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 5,
      "text": "wi bekiende dig en Herre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 6,
      "text": "Dig en euig Fader/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 6,
      "text": "priser den gantske Verden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 7,
      "text": "Det samme giør alle Engle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 7,
      "text": "Himlene oc alle veldige Engle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 8,
      "text": "Din priss siunge Cherubin oc Seraphin/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 8,
      "text": "met it waffladeligt stemme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 9,
      "text": "Hellig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 9,
      "text": "Hellig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 9,
      "text": "Hellig est du Herre Gud Zebaoth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 10,
      "text": "Himlene oc Jorden er opfylt met din Maiestatis ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 11,
      "text": "Den er lig forsamling dine Apostlers tall/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 11,
      "text": "dig loffue oc bekiende en Herre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 12,
      "text": "Lige saa giør oc altid det hellige tall dine Propheters.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 13,
      "text": "Den gantske skare dine hellige Martirers/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 13,
      "text": "dit hellige Naffn loffue oc prise.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 14,
      "text": "Alle Gudfryctige oc vdualde loffue oc bekiende dig i all Verden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 15,
      "text": "En wbegribelig maiestatis Fader.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 16,
      "text": "Din sande ærefuld enbaarne Søn Jesum Christum/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 16,
      "text": "tro wi at være lig met dig i Guddommen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 17,
      "text": "Dertil den hellig Aand sandelig at være allis vor trøstermand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 18,
      "text": "O Herre Christe/ du est ærens Konning.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 19,
      "text": "Du est din Faders euige Søn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 20,
      "text": "Jomfruens liff vaar dig icke vederstyggelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 20,
      "text": "til at anamme Mandom oc forløse alle vdualde Menniske.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 21,
      "text": "Du haffuer offueruundet den bittre pine Dødsens sting/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 21,
      "text": "oc oplat alle som tro paa dig Himmerigis rige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 22,
      "text": "Derfor sider du nu hoss Guds høyre haand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 22,
      "text": "i euig maiestatis ære met din Fader.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 23,
      "text": "Oc saa tro wi at du her effter vorder tilkommendis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 23,
      "text": "en streng Dommere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 24,
      "text": "Derfor O Herre wi formane dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 24,
      "text": "hielp dine tro Tienere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 24,
      "text": "som du forløste met dit dyrebar Blod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 25,
      "text": "Dine venner giør deelactige i den euig ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 25,
      "text": "met dit hellige oc vdualde Folck.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 26,
      "text": "O Herre frelss dit Folck/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 26,
      "text": "oc velsigne dem som ere din Arff oc Eiedom.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 27,
      "text": "Regere oc lær dem/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 27,
      "text": "oc ophøye dem til euindelig tid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 28,
      "text": "Wi benedide dig Gud i euighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 28,
      "text": "oc ære dig dag fra dag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 29,
      "text": "Oc loffue dit naffn til euig tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 29,
      "text": "nu oc altid oc euindelig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 30,
      "text": "O Herre verdis at beuare oss i dag oc altid fra Synden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 31,
      "text": "Miskunde dig offuer oss O Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 31,
      "text": "oc forbarme dig offuer oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 32,
      "text": "O Herre din miskundhed bliffue offuer oss/",
