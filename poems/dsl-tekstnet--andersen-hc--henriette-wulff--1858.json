  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1858,
    "url": "https://tekstnet.dk/books/andersen-hc_henriette-wulff/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "I det brændende Skib, paa det rullende Hav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "I Rædsler, som ei vi udholde at høre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Har Du lidt, har Du endt, har Du fundet din Grav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Dødsmaaden og Kampen naae aldrig vort Øre!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Du dristige, kraftfulde Sjæl, Du Dig holdt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "I et skrøbeligt Legem; høit stod Du i Vrimlen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Og aldrig dit ildfulde Hjerte blev koldt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Her Faa kun forstod Dig, men Flere i Himlen!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Du var mig en Søster deeltagende stærk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Min Sjæl holdt Du oppe, naar Verden mig traadte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Du kjendte, forstod mig, og det er dit Værk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "At tit jeg ei sank, naar synke jeg maatte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Det Falske, det Tomme, det Bjældeklangs Smaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Har Hobens Beskyttelse, bæres af Strømmen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Dens Løb ei forandres –, Skumbølgerne gaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Og Jordlivet gaaer, – det er endt snart, som Drømmen!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Farvel min Veninde fra Barndommens Aar!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Du var mig meer god, end jeg det fortjente,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Nu har Du stridt ud –; hos en Broder Du staaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Med hvem alt paa Jorden Dig Længsel foreente.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Din Kiste blev Havet, det rullende Hav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Og Indskriften over Dig staaer i vort Hjerte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Din Sjæl er i Himlen, der Herren Dig gav",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "Lyksalighed tifold for Dødsstundens Smerte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "I det brændende Skib, paa det rullende Hav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "I Rædsler, som ei vi udholde at høre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Har Du lidt, har Du endt, har Du fundet din Grav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "Dødsmaaden og Kampen naae aldrig vort Øre!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
