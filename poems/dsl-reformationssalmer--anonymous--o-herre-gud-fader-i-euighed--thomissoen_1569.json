  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Herre Gud Fader i euighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "huad ieg maa idelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "til dig ælendelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "beklage/ kære den forlaarne tid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Der ieg saa daarlig haffuer fortærit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "besuærit baade Liff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "oc siel foruden skel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "met Verdslig kummer oc syndelig ijd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "All min fornufft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "met all wtuct/ fra dig vaar vend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "met Synd haffuer ieg din ære skend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "dit naffn ey kiend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Som du oc vel fornam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "at all min last oc skam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "for dig vaar leed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "fordi varst du mig saa vred/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "at ieg dig haffde giort det store fortred.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Du haffuer mig retuiselig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "giffuit din Straff for min ondskab/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "oc dit venskab.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "Du ingen forsmaar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "i naar hand vil bekiende sin nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "O Herre sød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "du vilt ingen Synders død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 1,
      "text": "Saa dierffuelig forlader ieg mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 1,
      "text": "Til dig/ min Herre Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 1,
      "text": "Foruist du vedst min brøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 1,
      "text": "Til lige maa vige for dig alle Creatur.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 1,
      "text": "Jeg er oc visse/ at ieg ey forgeffuis",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 1,
      "text": "Til dig setter min lijd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 1,
      "text": "Nogen tid/ du est saa blid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 1,
      "text": "Oc kiender denne vor skrøbelig natur.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 1,
      "text": "Din pine oc Død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 1,
      "text": "J all min nød kand hielpe mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 1,
      "text": "At Gud Fader rundelig offuer mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 1,
      "text": "Miskunder sig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 1,
      "text": "Oc giffuer tid oc stund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 1,
      "text": "At ieg aff hiertens grund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 1,
      "text": "Mig bekiender",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 1,
      "text": "Oc omuender/ skaffer i mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 1,
      "text": "En ret tro oc sand/ met sin hellig Aand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 1,
      "text": "Jeg kiendis min skyld/ Christ vær mig huld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 1,
      "text": "Vent dig til mig/ miskundelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 1,
      "text": "Min høyeste trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 1,
      "text": "Som haffuer forløst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 1,
      "text": "Mig/ met din død oc haarde nød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 1,
      "text": "For mig Herre Gud haffuer du",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 1,
      "text": "Vdstyrt dit Rosens Blod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 2,
      "text": "At tiene Gud vaar ey min ijd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 2,
      "text": "Wblid vaar hand da mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 2,
      "text": "Dog sig taalmodelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 2,
      "text": "Beteede/ fride mig lenge fra all sorrig oc nød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 2,
      "text": "Jeg leffde vdi suss aff gammel viss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 2,
      "text": "Ey loff Gud aff mig fand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 2,
      "text": "Som hand ingelund kunde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 2,
      "text": "Dem straffe der laste hans hellige Bud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 2,
      "text": "Der met haffuer ieg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 2,
      "text": "Saa skendelig bespaattet Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 2,
      "text": "Aff all mit sind værit hannem imod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 2,
      "text": "Det angrer mig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 2,
      "text": "Jeg seer hans Guddoms krafft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 2,
      "text": "Haffuer straffet min wtuct/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 2,
      "text": "Thi hand er mig kier/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 2,
      "text": "Bruger baade milt oc hart",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 2,
      "text": "Alt vdaff sin Guddoms faderlig art.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 2,
      "text": "O milde Christ/ giff mig din gunst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 2,
      "text": "Din tiener huld ieg være vil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 2,
      "text": "Nu rettelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 2,
      "text": "Haaber ieg met lyst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 2,
      "text": "At vandre for andre den forlaarne tid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 2,
      "text": "Der til hielpe mig nu Christ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 2,
      "text": "Som for oss døde vist.",
      "part": false,
      "marginal_notes": []
    }
  ]
}