  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Min Kam er meget større end din.",
      "part": false,
      "marginal_notes": [
        "Speaker: Første Hanekylling:"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Men sér Du, hvor jeg kan rejse min?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Ja vist, Du maa nok med Rette prale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Du har jo neppe et Dun til en Hale!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Hvad, lumpne Tingest, vil Du vanære mig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Jeg maa nok se, om jeg kan kurere Dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Saa fore de løs, hop, hop, hop, hop.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Men Hønen skrukkede: Børn, hold op!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Hvis ej, jeg Jer putter i Æggeskallen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Ja vist, galed Hanen højt paa Stalden;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Kykkeliky! gav begge de Smaa til Svar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "det skulde nu være som deres Fa'er.",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
