  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Uermibus hic donor stricto recubendo cubili.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Omnis transit honor, nunc puluere dormio vili.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "for inghen schal mig nøghen see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "mig sielff kan ieg ey ræckæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Myt hoffuet liggher laght, mynæ fødher ochsaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "seer ether i speghel som offuer mig staa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Hær liggher ieg meth myn wærdzens prijs,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "seer til om ieg haffuer wareht wijs,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "then tijd ieg war i liffuæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Myn graff hun er siw fødher langh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "hær schal ieg længhæ bliffuæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "Seer mig och grædher, I tørffuæ ey lee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "ieg er vdsckaath, thet mwghæ I see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "och iordhet er ieg hæræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "i iordhen giffues ieg til ormæmad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "til domædagh hær at wæræ.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
