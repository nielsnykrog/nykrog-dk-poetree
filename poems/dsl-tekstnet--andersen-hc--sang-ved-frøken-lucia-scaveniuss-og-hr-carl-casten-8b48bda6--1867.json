{
  "id": null,
  "title": "Sang ved Frøken Lucia Scavenius’s og Hr. Carl Castenschiolds Bryllup paa Basnæs den 26de October 1867",
  "year_created": 1867,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1867,
    "url": "https://tekstnet.dk/books/andersen-hc_sang-ved-froeken-lucia-scaveniuss-og-hr-carl-castenschiolds-bryllup-paa-basnaes-den-26de-october-1867/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "I gammelt Sagn, i Tider mørke, haarde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Trods den besjungne Ridder-Herlighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Da laae i Strid her disse Nabogaarde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Nu anden Slægt og Tid har Kjærlighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Fra Basnæs fører Besidder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Sin glade, unge Brud til Borreby.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Og Vinteren sneer Roser; Fugleqvidder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Forkynder Lykken i det nye Ly.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Vort Hjerteslag bliv Sang ved Bryllupsbordet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Lyd festlig glad til Kirkeklokkens Klang;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Som Blomst med Duft og Farve flyver Ordet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Carl og Lucia bringe vi vor Sang;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Som kjærlig Datter hende vi bekrandse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "I Barndomshjemmet, det hun nu gaaer fra,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Hans Navn i Danmark lød fra Dyppels Skandse,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Den tappre Landsoldat et glad Hurra!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "I hvad Vorherre Eder ogsaa sender,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Hold fast i Glæde, Prøvelse og Tro;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Husk, hvor i Troskab holde fast to Hænder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Alkjærligheden slipper ei de To.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Et Lykkens Hjem er reist paa Dannevangen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Og Solskin strømmer fra det Indre ud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Vort Hjertes Bøn, løft Dig igjennem Sangen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Henfarne Kjære synge med hos Gud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Mens Brud og Brudgom læse Sangen dæmpet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "I Bryllupsfryd er Alvors-Tanken Gjest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Udfold Dig, Dannebrog, for Dig han kjæmped’,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Prang Blomsterflor ved Eders Søsters Fest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Saa dansk, som »Skjold« og »« er i Sproget,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Saa hjertedansk er ogsaa disse To.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Følg dem med Sang, følg dem med Dannebroget,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Paa Borreby nu Lykkeblomsten groe.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
