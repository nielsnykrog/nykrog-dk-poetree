  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Frodhe hyn frackæ, thet wor mith naffn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "thet lodh ieg kændæ meth størkæ oc gaffn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "i orloff oc krij, tha slo ieg them.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Frotger koning i Norgæ, ther han thet fraa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "thet ieg ffor meth hans kemper saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "han soor iegh skullæ ey fyndhe hannum so slæth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Hans gwdh wor hannum so blijdh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "ath inghen man kunne hannum slaa i strijdh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "vthen han kunne fanghæ aff then samme iordh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "som loo vdi hans eyæth ffodspordh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "tha wi wore gangnæ i kretzen indh:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Ieg spurde om han villæ skyffthæ steth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "skioldh och swerdh och brynyæ meth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Han sade han willæ paa skiffthæ gaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Saa sprank ieg tijl oc fick then iord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "som vndher hannum laa i hans fodspord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Saa gyngæ wij sammen vdhi then kry.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Ieg hannum ther slo, han willæ ey fly.",
      "part": false,
      "marginal_notes": []
    }
  ]
}