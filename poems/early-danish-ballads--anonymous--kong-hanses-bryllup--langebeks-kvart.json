    1562
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Langebeks kvart",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1562,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/LNGK12.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Koniing hanns hannd siider paa kiøbnehaffnn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hand | Lader the lønne-breffue schriffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Oc sender hand | thennom tiill Nøre-Iutlannd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "her Erick Ottszenn | thennom att giffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: Therkommer aldrig saa rigen | Iomfrw tiill Danmarck | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Thett wor her Erick Ottszenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "ther hannd the Lønne-Breffue | saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "hannd kaste gulterninger paa borde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "oc Ladh | sadle sinn gannger graa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": ":: T. k: a: s: r: I: t: D:. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "The lidde wd hanns huide hest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Lagde paa hannom | forgÿltte mile,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Saa red hand tiill kiøbnehaffnn |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "før hannom lÿsted att huile,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": ":: T: k: a: s: r: I: t: D:. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Innd kom here Ottszenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "oc stedis hand for bord, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "huad wiill j meg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "minn Edelig herre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Medenn j | haffue senndtt meg ord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": ":: T: k: a: s: r: I: t: D:. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "Thett suoritt konninngenn her Erick",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "j ere wor | egenn mannd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "j skulle fare tiill miszenns lannd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "oc | Bede om thennd lillige-wannd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 4,
      "text": ":: T: k: a: s: r: I: t: D:. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "Thett wor her Erick ottszen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "hannd monne sinn | herre saa suare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "skall Ieg fare tiill miszenn j aar, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": "Ieg kannd icke ene were,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 5,
      "text": ":: T: k: a: s: r: I: t: D:. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "Her wernner pasberg aff holbeck",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "hannd skall metth | Etther fare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": "Ther-tiill her Claus rønnow aff | wordennborre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 6,
      "text": "Etther fÿlger saa sterck enn skare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 6,
      "text": ":: T:. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 7,
      "text": "The wunde op theris forgÿltte segell",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": "saa høgtt wdj | forgÿltthenn raa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 7,
      "text": "danmarcks wobenn, fremmerstauffn |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 7,
      "text": "the Lode tiill misszenn staa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 7,
      "text": ":: T: k: a: s: r: I: t: D:. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 8,
      "text": "Kurerenn staar paa høffuenn mure",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 8,
      "text": "oc seer hand wdj | Strande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 8,
      "text": "Ieg seer saa mange fremmede skibe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 8,
      "text": "the føre | dannmarcks fanne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 8,
      "text": ":: T: k: a: s: r: I: till: D:. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 9,
      "text": "Jeg seer saa mannge dannske skiibe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 9,
      "text": "the føre forgÿltte | fane,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 9,
      "text": "Christ sinne Etther frøckenn kirstine-lille |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 9,
      "text": "the komme Etther alle tiill hannde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 9,
      "text": ":: T: k: a: s: r:. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 10,
      "text": "Kaste the theriis acker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 10,
      "text": "altt paa thett huide sanndt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 10,
      "text": "The Edelige ridder aff dannemarck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 10,
      "text": "the throdde | ther først wdj Lannd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 10,
      "text": ":: T: k: a: s: r: I: t: D:. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 11,
      "text": "Ther the komme paa huidett sannd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 11,
      "text": "theraxslede the | theriis skinnd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 11,
      "text": "saa gaar the wdj høuitt-Lofftt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 11,
      "text": "for hertugenn aff miszenn Innd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 11,
      "text": ":: T: k: a: s: r:. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 12,
      "text": "Hell siider j hertug aff miszenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 12,
      "text": "mett Etthers hiertthenns-kiere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 12,
      "text": "Thennd wnng konning aff danmarck |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 12,
      "text": "Beder om etthers datther mett erhe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 12,
      "text": ":: T: k: a: s: r:. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 13,
      "text": "The toge wd lønne-breffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 13,
      "text": "oc thennom thennd | hertug gaff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 13,
      "text": "Saa førde the fram theriis | tale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 13,
      "text": "Som theriis herre thennom bad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 13,
      "text": ":: T: k: a. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 14,
      "text": "I Edeliige Ridder j tage nw wannd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 14,
      "text": "oc gaa metth | meg tiill bord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 14,
      "text": "Ieg wiill tøffue tiill morgenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 14,
      "text": "Oc | giffue etther gode anndsuaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 14,
      "text": ":: T: k: a: s: r: I: t: D:. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 15,
      "text": "Ther wore the j wger nÿ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 15,
      "text": "oc ennd wdj monede thre |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 15,
      "text": "Icke kunnde the Edelige riddere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 15,
      "text": "Iomfrw kirstenn-Lille | faa att see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 15,
      "text": ":: T: k: a: s: r: I: t: D:. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 16,
      "text": "Dagenn dagiis østenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 16,
      "text": "oc bøllenn blesser blaa, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 16,
      "text": "The Edelige riddere aff danmarck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 16,
      "text": "the gaa | for hertugenn att staa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 16,
      "text": ":: T: k: a: s: r: I: t: D:. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 17,
      "text": "Dagenn dagiis østenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 17,
      "text": "oc bøllen blesser j land, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 17,
      "text": "Thennd wnnge konge berer sorrig for ossz |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 17,
      "text": "att wÿ ere sunckenn tiill sannd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 17,
      "text": ":: T: k. a: s:. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 18,
      "text": "Thett wor hertugenn aff miszenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 18,
      "text": "hannd | kalder effther Riddernne sinne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 18,
      "text": "Beder j Iomfru kirstenn-lille",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 18,
      "text": "komme for ossz her-innde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 18,
      "text": ":: T:. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 19,
      "text": "Thett wor the miszeners fruer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 19,
      "text": "the monne lill | kirstenn børste och flette,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 19,
      "text": "och iiij saa wore the | forstinder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 19,
      "text": "the monne hindis hoffuitguld paasette. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 20,
      "text": "The setthe paa hinnde thett houittguld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 20,
      "text": "thett | skinnede saa røtt som lue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 20,
      "text": "Ther-tiill mannge | perler oc Eddelstene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 20,
      "text": "altt paa thend skøne Iomfrue. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 21,
      "text": "Thett wor lidenn kirstenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 21,
      "text": "hunn Innd aff døren | thrennt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 21,
      "text": "Hinndis fader oc hinndis farbroder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 21,
      "text": "The | stannde hinnde op egenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 21,
      "text": ":: T k: a: s: r: I: t: D:. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 22,
      "text": "Hindis fader oc hindis farbroderthe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 22,
      "text": "stande hinde | op emod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 22,
      "text": "The Eddelige riddere aff danmarck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 22,
      "text": "oc | The faltt hinnde tiill fod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 22,
      "text": ":: T: k: a: s: r: I: t: D:. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 23,
      "text": "Thett wor hertugenn aff Misszenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 23,
      "text": "hannd | kalder aff riddernne sinn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 23,
      "text": "Hentter meg | j hiidtt guld-skaufftaull,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 23,
      "text": "oc berer thett j stuenn Ind. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 24,
