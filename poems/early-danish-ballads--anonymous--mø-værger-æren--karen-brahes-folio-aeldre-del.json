{
  "id": null,
  "title": "Mø værger Æren",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA148.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Sttalltt Innggellyld spuorde synn muoder saa braatt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": ":: For-glleeme ycke meeg! ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "\"Maa ieg gaa till wegtt y naatt?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Hun thrad saa herlig. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "\"Huad willtt thu tiell weegtt giørre?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "dw haffuer der huerkind søster eller broder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Tthu haffuer icke broder for-vdenn meg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "mynn kerre datter, och blyff du hieeme!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "Saa leengge daa baad denn iunfru fynn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "teell hun feeck luoff aff muoder synn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "Hun thuog sieelliff Aaarenn y synn haand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "hun wylde icke thro denn styris-maand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "Tther hun kaam thill Thuors ø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 5,
      "text": "ther gyck en danntz meed fruer och møør.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "Rydder och suend begynntte enn dantzs,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "stalltt Inngellid saatte seeg, hun giordde enn krantzs.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "Tthett meelltte heer Twrre vndder ø:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 7,
      "text": "\"Huem skaall daa haffue denn kraans, du giør?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "\"Ieg giør icke kraantz tiell anddre maand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 8,
      "text": "ind till mynn broder, ieg fuld weell Aaand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "\"Sttalltt Inggelild, om deeg tøckis saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 9,
      "text": "y afftten well ieg tieell ditt bwrre gaa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "\"Du thør icke gaa tilburre mynn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 10,
      "text": "for ieg weell icke laade thieg ind.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "\"Tthett maa nu gaa, y-huor thett maa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 11,
      "text": "y affttenn skaall ieg tiell dytt burre gaa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "Sttalltt Inggellild suøber hun seeg y skiend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 12,
      "text": "hun gaar y lofftt for brodder synn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "\"Hør thu thett, kieerre brodder mynn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 13,
      "text": "y affttenn daa hieelpe du søster dynn!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "\"Ieeg skaall dieg hieelpe, ieg skaall dieg fry,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 14,
      "text": "skuld thett icke kaaste mytt vnge lyff.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "Sylldig om affttenn, røg faald paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 15,
      "text": "icke glemtte her Twrre, huor hand wild gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "Hand thuog meed sieg dy ryder ny,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 16,
      "text": "tiell staalltt Inggellilds bwrre saa ginge dy.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 16,
      "text": "Tthett giordde megg y mytt hiaartte saa muod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 16,
      "text": "mynn broder luo wieeenn for mynn fuod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 16,
      "text": "Haffdde thy weritt ind enn gang ny, och der-till fem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 16,
      "text": "saa gerne daa haffde ieg wieeett dem.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 16,
      "text": "Kongenn klaaper hynder weed huydenn kyend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 16,
      "text": "\"Saa sandellig er y enn iumfru fynn!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 16,
      "text": "Ttheend iunfru hun greed icke førr daa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 16,
      "text": "denn tid hun skulde till skrefftte gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 16,
      "text": "Hun feeck icke freeddag att faaste for-vddenn ieenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 16,
      "text": "for dy waar alle woldis-meend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 16,
      "text": "Sttalltt Ingellild red aff kongens gaard",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 16,
      "text": "med hyø guld-kronne och vd-slauffuenn haardd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 16,
      "text": "Meed hyø guld-kronne och vd-slauffuen haard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 16,
      "text": ":: For-gleem icke meeg! ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 16,
      "text": "hynder feeste enn rydder aff kongens gaard.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 16,
      "text": ":: Hun threeder saa herllig. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}