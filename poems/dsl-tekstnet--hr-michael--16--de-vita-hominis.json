  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "De Vita Hominis",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1514,
    "url": "https://tekstnet.dk/books/hr-michael_de-vita-hominis/016/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Mortuus effectus feretro dormito reclusus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Et pauper lectus sic communis petit vsus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Uærdzens leeffneth er ligherwijs",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "och achther ther længhæ ath bidhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Eht wædher kommer, slaer ijsæn smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "then bygning kan ther ey længhe staa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "han tagher tha til at sckridhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "seer til huar dødhen haffuer slaghet mig nedh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Om ieg nw waræ i liffuæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "ieg wildhæ heldher krubæ i oermælighæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "end ieg noghet mænnisckæ wildhæ swighæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "Nw liggher ieg hær, er wordhen død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "awij offuer swodan legoms nød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Myn krop, then wslæ daræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "snart schal bæres aff hwsedh wd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "for mig schullæ I ether waræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Then slæmesthæ aes som til kan wæræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "er wordhen myn krop som liggher hæræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "thet tænchtæ ieg ey til tidhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "ther ieg hadhæ fæsthæ och storæ slaat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "och gaff hannum klædher at slidhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Them sckattedhæ ieg aff then fattughæ bondhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "hanss gotz togh ieg swo manghælondhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "Hær liggher ieg nw paa thennæ bar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "huart siælen kommer worder ieg wæl war,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "mynæ gerningher schal hwn bødhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "O hærrer och førsther och godhæ qwindhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "iomffrwer och riddher och sweenæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "Swodan er wærdzens løckæ och ændhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": "ihuart wij oss i wærdhen wændhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "hær liggher ieg nw aleenæ.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
