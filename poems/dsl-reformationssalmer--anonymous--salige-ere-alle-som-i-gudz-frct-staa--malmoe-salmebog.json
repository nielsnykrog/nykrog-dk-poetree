  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "SAlige ere alle som i gudz frøct staa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Och gerne paa hans veye gaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Aff dit arbeyde nære dig met skel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Saa leffuer dw ret oc det gaar dig vel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "Jnden dit hwss skal din hustrue wære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "som en rancke met mange vindruer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Oc dine børn om din egen disk/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "Som oliue planter sund oc frisk",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "See saa velsignes huer en mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "som i Gudz frøct stonde kand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 5,
      "text": "Fra den forbandelse er han fri/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "som Adams børn føddis wdi",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 6,
      "text": "Velsigne dig Gud aff Sion/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "ath du motte see hans gode løn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 7,
      "text": "Och dine børnebørn i mange led/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "Och siden hyn rette Jsraels fred",
      "part": false,
      "marginal_notes": []
    }
  ]
}