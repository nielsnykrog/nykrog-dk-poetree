  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Dronning Sophias visebog",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1584,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/DRS64.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Her Benndicks rider sig under øø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": ":: - y roer ud, y erlige mendt! - ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "feste hannd sig saa wennen møe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Her Benndicks haffuer saa lidenn en feste-møe. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Thi førde brudenn y her Bendicks gaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "dronningen ganger hinde udt i-modt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Thi fulde bruden y sallen ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "effther gannger rider, thi baare hindes skindt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "Thi satte bruden paa brude-bennck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "for gick rider, thi baare hindis skennsk.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "Silde om affthen, ther røg falder paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "thend unge brud liuster att soffue ghaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "Thennd unge brud satte sig i senngen neder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 5,
      "text": "her Benndicks duolle icke holle lennge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "\"Hør y, her Benndicks, kiere herre min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "wille y lade mig ligge møe huos ether y natt?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "\"Io saa-mendt will ieg saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 7,
      "text": "om ether thøckes saa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "Arlig om morgen, thet wor dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 8,
      "text": "thi fruer thi gannger thill brude-hus-dør.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "Thi fruer wille sette hinde guld-huen paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 9,
      "text": "hun bad, the skulle sla udt hindis smucke haar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "\"I maa guld-kronnen well paa sette,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 10,
      "text": "her Benndicks sømmer ingen iomfruer ere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "Ieg mientte, her Benndicks, du worst enn manndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 11,
      "text": "hui lodst thu din unge brud giøre thig skamme?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "Her Benndicks drog kniff aff ermedt rødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 12,
      "text": ":: - y roer ud, i erlig mendt! - ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 12,
      "text": "hannd slog hanns unge brudt thill hindis dødt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 12,
      "text": ":: Her Benndicks haffuer saa liden en feste-møe. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}