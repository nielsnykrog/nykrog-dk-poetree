{
  "id": null,
  "title": "Karl Høvding",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift I",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVI95.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Karll Høffding hand syder paa Raffuens-søø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": ":: min hiertelig rosen och min kierist ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "hand acter att vinde saa ven en møø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Y-men hand vinder hinde saa lyden. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "\"Ieg vill mig ryde under øø",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "och feste Ingebore Rouers-dotter, saa ven en møø.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Ditt svarit den suend, som handem stod nest:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "\"Her Mogens haffuer den iomfru fest.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "Ieg saa dett paa en hellig søndag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "her Roffuer herre Mogens sin dotter gaff.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "\"Før-end hand skall den iomfru foe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "før skall dett koste min unge liff!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "Ditt suarit hans søster, den lillie-vand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 5,
      "text": "\"Lad hinde beholde hindis feste-mand!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "I-huilchen iomfru du løster att loffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "den skaltu du mett æren foe.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "\"Min kiere søster, lad fare din tale!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 7,
      "text": "den iomfru haffuer laditt mit hierte y dualle.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "Ditt suarit hans søster under øø:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 8,
      "text": "\"Christ lad dig vinde den venne møø!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "Karll Høffding hand ganger y bore-stoffue ind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 9,
      "text": "hand skencher for hoff-mend bod miød och vin.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "\"Huilchen udaff mine suenne vill mett mig fare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 10,
      "text": "och hielpe mig att vinde itt spedell klar?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "Ieg vill mig bortt-ryde under øø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 11,
      "text": "och vinde vill ieg saa ven en møø.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "\"Alle saa vill vi mett eder fare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 12,
      "text": "Christ lade eder vinde det spedell klar!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "Karl Høffding lader sin sneche boff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 13,
      "text": "tachell och toffue mett røde guld snuff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "Liden Kierstyn hun fulde hindis broder till strand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 14,
      "text": "\"Christ lade dig vinde den lillie-vand!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "Hand vandt op segell y for-gylte roo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 15,
      "text": "saa seglitt di offuer di bølle saa bloe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "Karll Høffding hand kom ichi før,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 16,
      "text": "før bruden stod for kyrchi-dør.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "Bruden hun hindis øyen opslog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 17,
      "text": "der saa hun seyll y sunden roff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 18,
      "text": "Bruden hun taler till morsøster sin:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 18,
      "text": "\"Nu syer ieg aller-kieriste min!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 19,
      "text": "\"Thi kuer, Ingebore, søster-døtter min!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 19,
      "text": "her Mogens er aller-kieriste dyn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 20,
      "text": "\"Sorigen liger mitt hierte saa ner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 20,
      "text": "ieg vid vell, huem min kieriste er.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 21,
      "text": "Ieg seer segell bode gule och bloe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 21,
      "text": "ieg syde dennom mett mine finger smaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 22,
      "text": "Ieg syde dennem mett mine finger smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 22,
      "text": "ieg vinter, Karl Høffding hand er der-opaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 23,
      "text": "Hør du, terckell, kiere broder min:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 23,
      "text": "du ryd till stranden for søster din!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 24,
      "text": "Du ryd till stranden for søster din:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 24,
      "text": "er dett Karl Høffding, daa biud hannem hiem!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 25,
      "text": "Biud ham hiem y-dag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 25,
      "text": "och driche och dantze och giøre sig glad.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 26,
      "text": "Terchell hand sprang till ganger rød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 26,
      "text": "hand red saa snart, som foglen fløff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 27,
      "text": "Der han kom till strande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 27,
      "text": "daa lagde Karll Høffding for lande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 28,
      "text": "\"Wellkomen, Terchell, kiere broder min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 28,
      "text": "huor lyder Ingebore, kiere søster din?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 29,
      "text": "\"Min søster hun er bode glad och fro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 29,
      "text": "dett er hindis første brølups-dag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 30,
      "text": "Ditt er brudens næste bøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 30,
      "text": "det du, Karll Høffding, vilt følge hinder hiem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 31,
      "text": "Følger hinder hiem y denne dag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 31,
      "text": "oc dantze och dryche oc giøre dig glad.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 32,
      "text": "\"Fuld liditt maa ditt min glæde vere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 32,
      "text": "en anden soffuer huos min hiertens-kier!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 33,
      "text": "Hør du, Terchell, huad ieg siger dig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 33,
      "text": "vylt du skyffte klæder mett mig?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 34,
      "text": "Wilt du y-dag skøfft klæder mett mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 34,
      "text": "och lade mig gaa och skenche for dig?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 35,
      "text": "Wilt du saa lonne mig ganger din,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 35,
      "text": "daa giffuer ieg dig guld-snechy min!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 36,
      "text": "\"Ieg giør dett huerchen for sølff eller guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 36,
      "text": "ieg suiger ichi her Mogens, hand er mig huld.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 37,
      "text": "\"Wilt du y-dag skyfft klæder mett mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 37,
      "text": "liden Kirstin, min søster, den giffuer ieg dig.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 38,
      "text": "\"Kand ieg liden Kierstyn, din søster, foer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 38,
      "text": "daa hielper ieg dig, y-huad ieg maa!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 39,
      "text": "Di skiffte klæder, bode sabell och mord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 39,
      "text": "saa vell daa lysnitt hans faffuer haar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 40,
      "text": "Dy red y den brude-skare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 40,
      "text": "di tenchte, dett Terchell Karl Høffding vor.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 41,
      "text": "Dy sette Terchell till benche,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 41,
      "text": "Karll Høffding gaar att skenche.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 42,
      "text": "I-huor som hand paa gullit monne gange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 42,
      "text": "brudens øyen monne effter hannem stande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 43,
      "text": "Di glædis alle, som der vor ner:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 43,
      "text": "bruden haffde sin broder saa kiær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 44,
      "text": "Karll Høffding hand luder offuer breden bord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 44,
      "text": "hand taler till bruden en aluorlig ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 45,
      "text": "\"Huad heller ville y vere her Mogens hans vyff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 45,
      "text": "helle y ville paa Raffuensøø lade eders liff?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 46,
      "text": "\"Før-end ieg vill vere her Mogens hans vyff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 46,
      "text": "før vill ieg paa Raffuen-sø lade mitt liff.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 47,
      "text": "\"Min hiertens-kier, y taler yche saa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 47,
      "text": "fuld gode rod daa ville vi foe.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 48,
      "text": "Syldig om afften, dog fald paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 48,
      "text": "bruden skulle att soffue gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 49,
      "text": "Dy satte bruden paa hønde bloe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 49,
      "text": "droningen tog hindis hoffde-guld aff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 50,
      "text": "Karll Høffding hand y brude-seng sprang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 50,
      "text": "hand sluchte ud lius mett huide hand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 51,
      "text": "Ditt melte droningen, och hun bleff vred:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 51,
      "text": "\"Huem slucher ud blus, vi skulle aff sye?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 52,
      "text": "Huem er tydendis y brude-hus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 52,
      "text": "och huem daa slucher for den unge brud blus?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 53,
      "text": "\"Ieg er iche tydende! ieg vill haffue den møø!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 53,
      "text": "ieg er Karll Høffding aff Raffuens-søø!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 54,
      "text": "Droningen vende sig till hindis møer:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 54,
      "text": "\"Och huem haffuer hørd slig under før?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 55,
      "text": "Ud gich droningen mett hindis møer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 55,
      "text": "Karll Høffding hand lucher den brud-hus-dør.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 56,
      "text": "Droningen ganger att sallen frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 56,
      "text": "hun raachte her Mogens sin huide hand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 57,
      "text": "\"Saa underlig tydende skall ieg dig bere:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 57,
      "text": "Karll Høffding soffuer huos din hiertens-kiere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 58,
      "text": "Karll Høffding soffuer huos den lillie-vand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 58,
      "text": "du heffne dett, om du est en mand!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 59,
      "text": "Her Mogens hand tager till sin knyff:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 59,
      "text": "\"Dett skall koste hans unge liff!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 60,
      "text": "Her Mogens hand rober offuer alt sin gord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 60,
      "text": "\"Mine dane-suenne, drager vaben paa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 61,
      "text": "I drager paa brynien uden all falsk!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 61,
      "text": "Karll Høffding hand er saa hord en hals.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 62,
      "text": "Dy stødte paa døren mett glauinde och spyd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 62,
      "text": "\"Stad op, Karll Hoffding, du gach hid ud!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 63,
      "text": "Karll Høffding hand ud aff vinduit saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 63,
      "text": "\"Y ere saa mange, vi ere saa faa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 64,
      "text": "I ere saa mange, vi ere saa faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 64,
      "text": "alt skall ieg lige-vell till eder gaa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 65,
      "text": "Ditt vor Karll Høffding hans meste harm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 65,
      "text": "att hand skulle aff den unge bruds arm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 66,
      "text": "Karll Høffding hand paa gullit sprang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 66,
      "text": "Inger-lille sloe sin kleder offuer ham.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 67,
      "text": "\"Her giffuer ieg eder itt brynie god,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 67,
      "text": "y-men y gaar eders finder imod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 68,
      "text": "Eder skall huerchen skade suer eller kniff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 68,
      "text": "y-men y haffuer dett paa eders liff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 69,
      "text": "Ieg giffuer eder saa gott itt suer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 69,
      "text": "y orme-blod er ditt herd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 70,
      "text": "Ingen mand eder skade kand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 70,
      "text": "y-men y haffuer ditt suer y hand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 71,
      "text": "I-men du haffuer den suerd for dig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 71,
      "text": "min hiertens-kiere, forglem ichi mig!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 72,
      "text": "Karll Høffding hand ud aff døren løb,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 72,
      "text": "sin gode suerd hand for sig skød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 73,
      "text": "Hand woff y den første skare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 73,
      "text": "hin rige her Mogens och hans fader.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 74,
      "text": "Hand woff y den første floch",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 74,
      "text": "her Mogens hans fader mett gulle loch.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 75,
      "text": "Karll Hoffding hand hug alt saa saare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 75,
      "text": "att ingen hannem styre kunde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 76,
      "text": "Terckell hand løber Karll Høffding y faffn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 76,
      "text": "\"Du still dig y Vor-herris naffn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 77,
      "text": "Du still dig y Vor-herris naffn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 77,
      "text": "min eniste søster ganger dig till gaffn!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 78,
      "text": "Hand tog Terchell udi sin faffn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 78,
      "text": "\"Du holt din ord alt som en mand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 79,
      "text": "Saa skall ieg min ord att holde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 79,
      "text": "ieg giffuer dig min søster at volde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 80,
      "text": "Saa glad vor alle Karll Høffdings mend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 80,
      "text": "di fulde den iomfru offuer grønen eng.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 81,
      "text": "Karll Høffding hand toger hinder y sin fagen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 81,
      "text": "hand løffte hinder y den frennde staffuen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 82,
      "text": "Karll Høffding hand førde sin iomfru hiem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 82,
      "text": "Terchell hand fuldis bort mett dem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 83,
      "text": "Tach haffue Karll Høffding, hand holt sin tro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 83,
      "text": "mett ere lod hand sitt brøllup boe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 84,
      "text": "Siden lod hand sig der-till lyste:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 84,
      "text": "saa gaff hand Terchell sin søster.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 85,
      "text": "Hand gaff hanem hans søster, saa ven en møø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 85,
      "text": "hand gaff hanem der-till all Raffuens-søø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 86,
      "text": "Alle daa vor di sørende, der hand drog hiem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 86,
      "text": ":: min hiertelig rosen och min kierist ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 86,
      "text": "alle vor di glade, hand kom igien.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 86,
      "text": ":: Men hand vinder hinder saa liden. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}