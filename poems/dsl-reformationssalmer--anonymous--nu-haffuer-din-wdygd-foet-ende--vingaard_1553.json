    {
      "id": 0,
      "stanza_id": 0,
      "text": "⁕ Nu haffuer din wdygd foet ende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "O daatter Sion/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Gud vil icke nu tiere lade føre dig hæden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Men din wdygd vil han besøge du Daatter Edom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Dine synder vil han blottelige obenbare",
      "part": false,
      "marginal_notes": []
    }
  ]
}