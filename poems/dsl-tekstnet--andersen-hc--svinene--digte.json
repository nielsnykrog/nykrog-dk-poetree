{
  "id": null,
  "title": "Svinene",
  "year_created": 1830,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Digte",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1830,
    "url": "https://tekstnet.dk/books/andersen-hc_digte-1830/008/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Das Menschenvolk verachtet dich vergebens,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Der weise Epikur",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Verspricht uns ja das höchste Glück des Lebens,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Wenn wir dir gleichen nur.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "For mangt et Sviin paa To, der spilledes paa Lire,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Thi vil i Dag nu jeg besynge det paa Fire.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Om hvem er mere talt? Om hvem gik flere Ord?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Nei, Svinet er en Helt, der er bekjendt paa Jord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "See vi til Mose-Lov, i den det paraderer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "(Et Djævle-Regiment, i Bugen exercerer).",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Saa mangen mægtig Mand gik over i et Sviin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Derom vi læse kan paa Græsk, som paa Latin.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Ulyssis Helteflok vi see saa lystigt svire,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "At gryntende, tilsidst, den gaaer paa alle Fire.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Ja Mange blev til Sviin, derom vi har Besked,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Men endnu mange Fleer, om hvem vi Intet veed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Thi rask, min Violin! lad dine Strænge bruse,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Saa at din Tordenrøst kan Recensenter knuse!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "– See hist ved Bondens Gaard – o hvilken Bjergetop!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "(Maaskee det var paa den, at Jeppe vaagnet op).",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Rundtom er udstrøet Halm, forgyldt af Solens Straaler;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "At see det Farvespil mit svage Blik ei taaler!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "Tys stille! hører dog, fra denne Flamme Kyst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "Det dybe Aandedrag fra Helteflokkens Bryst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 1,
      "text": "Der sees de Favn i Favn fostbroderligt at hvile,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 1,
      "text": "Og agte ei en Snuus paa Phøbi hede Pile.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 1,
      "text": "O see! ved Bøgens Rod, syv, otte, bitte Grise!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 1,
      "text": "O hvor idyllisk smukt! – et Træsnit af Luise.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 1,
      "text": "Nu nærmer Pigen sig, det er en Hebe fiin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 1,
      "text": "Hun bringer Maden frem til sine kjære Sviin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 1,
      "text": "Da reiser Flokken sig, som Helte frem de lyne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 1,
      "text": "(O see, der er en Galt, med Orden paa sin Tryne)!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 1,
      "text": "Til Taffel gaae de nu, jeg troer det skeer paa Spansk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 1,
      "text": "Samtalen føre de, som store Folk, paa Fransk. –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 1,
      "text": "Snart lyder Herrebud, det dem til Skoven kalder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 1,
      "text": "At vinde Egekrands, hvor Olden moden falder;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 1,
      "text": "Da bruges Trynerne, som Sabel og som Spade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 1,
      "text": "Saa Alferne i Hast tye hen til Bondens Lade;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 1,
      "text": "Og underfuld Musik af hver en Fugletunge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 1,
      "text": "Man seer de gamle Sviin at sværme med de unge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 1,
      "text": "Dog, ak! jeg er for svag, jeg kan det ei fortælle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 1,
      "text": "Der Stof til Epos er, og borgerlig Novelle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 1,
      "text": "Hver offrer Blodet jo til Pølse for sit Land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 1,
      "text": "O svar mig Menneske! Hvad Meer gjør nogen Mand?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 1,
      "text": "Dog miskjendt, haanet, her de arme Stakler gaae!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 1,
      "text": "Og deres Længsel – ak! – slet Ingen vil forstaae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 1,
      "text": "De grusomt bløde maae for Slagterkniven lang;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 1,
      "text": "O hjerteskjærende er deres Svanesang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 1,
      "text": "De døe – – – Mit Øie, ak! af Taarer bliver salt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 1,
      "text": "Thi hvad jeg føler nu har Ingen ret fortalt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 1,
      "text": "Jeg kan for Graad ei meer paa Violinen spille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 1,
      "text": "»La vie est un combat;« »Das Grab ist tief und stille.«",
      "part": false,
      "marginal_notes": []
    }
  ]
}
