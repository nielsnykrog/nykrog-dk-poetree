    {
      "id": 0,
      "stanza_id": 2,
      "text": "En velopdragen lille Hund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 2,
      "text": "Skal følge med og holde Mund!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 2,
      "text": "Vi lege, at vi kjøre nu,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 2,
      "text": "Og Kudsk er jeg og »Spoervogn« Du!",
      "part": false,
      "marginal_notes": []
    }
