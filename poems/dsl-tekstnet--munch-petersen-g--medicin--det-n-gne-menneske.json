      "text": "er elskovskranke ynglinges trøst–",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "jeg vil hugge sten",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "og sove –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "jeg knytter haanden i lommen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "og skyder hatten i nakken,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
