  "source": {
    "id": null,
    "title": "Een ny handbog med Psalmer oc aandelige lofsange",
    "year_published": 1529,
    "publisher": "Ludwig Dietz",
    "printer": "Ludwig Dietz",
    "place": "Rostock",
    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/dietz-salmebog-1529/8/11"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "IEsu Christ teg tacke wÿ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "tw lod oss icke fortabis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "fraa wor synd giorde tw oss frÿ/",
      "part": false,
      "marginal_notes": [
        "Philip. ij."
      ]
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "tw wilde sielff for oss plagis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Thÿ tw hadde oss inderlig kiær/",
      "part": false,
      "marginal_notes": [
        "Johan. xv"
      ]
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "wel them thet kunde besinde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "att tw for wor skyld døder er",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "ther med wÿ himmerige winde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "hadde tw icke thit blod vdgiffuit/",
      "part": false,
      "marginal_notes": [
        "Hebre. vij."
      ]
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "oc saa for oss betalid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "tha hadde wÿ alle fortabit bleffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "til heluedis grund nidfallid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Jesu Christ wÿ tacke teg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "wÿ loffue teg/ wÿ prÿse teg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Hwo haffuer hørd slig kierlighed/",
      "part": false,
      "marginal_notes": [
        "Johan. iij. Psalm. xiij Roman. v. Roman. iij Johan. iij."
      ]
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "som Gud fader haffuer oss beteed?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Wÿ som wore aff synden leed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "thÿ alle hans bud hadde wÿ forgæt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "ther fore wor han paa oss wred/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "wÿ wore hans vwenner alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Ewige pÿne hadde wÿ fortiænt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "ret bode vnge oc gamle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "Men Gud for sÿn miskundhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "monne seg offuer oss forbarme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 1,
      "text": "sÿn eneste søn sende han her nid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 1,
      "text": "att frelse oss vsle oc arme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 1,
      "text": "Jesu Christ wÿ tacke teg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 1,
      "text": "wÿ loffue teg/ wÿ prÿse teg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Ther fore skulle wÿ wære glad/",
      "part": false,
      "marginal_notes": [
        "Zacha. ix."
      ]
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "oc altÿd Gud fast loffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "han wil inthit andit haffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "for sÿn welgierning oc gaffue",
      "part": false,
      "marginal_notes": [
        "Ezech. xviij"
      ]
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "en att wÿ skulle sÿnden offuergiffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 2,
      "text": "Ther fore leed Guds søn pÿne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 2,
      "text": "att wÿ skulle nw rett Christelig leffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 2,
      "text": "hind anden ske ske] elste rettet orig. oc lÿde/",
      "part": false,
      "marginal_notes": [
        "j. Petri. ij. Johan. xiij",
        "j. Petri. ij. Johan. xiij"
      ]
    },
    {
      "id": 36,
      "stanza_id": 2,
      "text": "giøre them gott som oss giøre ont/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 2,
      "text": "ther paa kendis wÿ att wære Guds folk/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 2,
      "text": "om wÿ oss ÿ kierlighed øffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 2,
      "text": "Jesu Christ wÿ tacke teg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 2,
      "text": "wÿ loffue teg/ wÿ prÿse teg.",
      "part": false,
      "marginal_notes": []
    }
  ]
}