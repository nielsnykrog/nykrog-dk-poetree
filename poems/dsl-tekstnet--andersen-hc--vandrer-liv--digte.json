  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Gaardhunden gøer – dens Tænder ere saa skarpe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "En Qvinde træder i Forstuen ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Ak Armod sidder paa Kjole og Kind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Hun synger og spiller paa Harpe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "En ussel Hest bag Gjærdet søger sit Foder;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Hist holder Vognen med Dyne og Skuur,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Der sidder Manden i Guds Natur",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Med Barnet som skriger paa Moder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Han kysser lidt og kniber til Forandring;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Snart kommer Qvinden med Penge og Brød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Saa dier hun Barnet paa sit Skjød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Mens Manden bereder til Vandring.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
