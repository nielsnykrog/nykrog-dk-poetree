  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Til Lærredet et Billede Du bandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Fra Kampens Morgen da os Gud gav Seier,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Det staaer saa levende, saa følt, saa sandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "En Poesi fra Hjertets Dyb det eier.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Du fører os i Rækkens Kjød og Blod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "I hvert et Aasyn der staaer Mandens Tanke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "I Taarer Mange for Dit Billed stod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Det er saa dansk, som danske Hjerter banke!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
