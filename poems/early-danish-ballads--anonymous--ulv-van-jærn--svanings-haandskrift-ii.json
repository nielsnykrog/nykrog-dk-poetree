{
  "id": null,
  "title": "Ulv van Jærn",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift II",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVII45.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Det vor ungen Ulff van Iern,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hand ganger for kongen at stande:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "\"Herre, i laner mig aff eders mend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "min faders dødt at heffne.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: Det klager den suen, son fangen ligger paa heden. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "\"Ieg vill lane dig aff mine mendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "oc helst ud-aff de best:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Widerich oc stercke Tiderick,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "de kunde vell kempen freste.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Dett vor Widerich Verlandtzsøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "hand vredis icke ved dett ord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "hand hug hoffuit aff kempe thoo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "hand kaste dem for konings foed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Dett vor Viderick Verlantz-søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "hand tenckte oppaa heder oc ære:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "\"Sende wi bort vor sende-bod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "wi komme ey uforuare.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Bort daa red den sende-bud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "oc guld skind hannem paa bryst:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "hannem fulde huercken høg eller hund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "for hand da red saa fast.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Ind daa kam dett sende-bud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "oc stedis hand for bord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "hand vor snilde i tunge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "hand kunde vell føie sin ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "\"Hells sider y, koning aff Blideuinder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "en herre offuer alle førster:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "min herre haffuer eder boden sendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "hand vill eder y morgen friste.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "\"Beder daa maa din herre hiem side",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "oc giemme sin feed under lyde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "end hand sender mig bud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "med mig y morgen at stride.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Beder matte hand en orm være",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "oc krube under hiøgen hald:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "end hand ypper den same kiiff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "hans fader monne y falde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Beder motte hand en orm vere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "oc ligge under hiøge tiende:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "hands fader stod mig icke hug uden tho,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "hand stander mig halff minde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "\"Høre y, koning aff Blideuinder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "y holde tand for tunge:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "op daa voxer den racker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "med huasse tander i mund.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "\"Der vor ingen i verden till,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "der for ieg redis ville:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "foruden Viderich Verlantz-søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "oc hand er nu icke tiill.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "En sinde vor ieg paa Dorefeld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "som kempe di drycke inde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "der dreff Viderick dorespiel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 12,
      "text": "dett ganges mig aldrig aff sinde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "Till daa swaridt den sende-bud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "for det giorde koning vande:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "\"Dett er alt Widerich Vellandsøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 13,
      "text": "som striden skall for stande.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Dett svarit koning aff Blideuinder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "hand suarede som en mand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "\"Ieg møder y morgen y høffdingens storm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 14,
      "text": "om hesten mig bere kandt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "Hiem daa red den sende-bud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "rød som rossens-blomme:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "\"Widerich, y drage harns oppaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 15,
      "text": "kongen vill y morgen komme.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "De rede fram att Biertingh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "oc fram att Biertings-myre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "de vor vell attan-hundre kemper,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 16,
      "text": "vore kled y sindall hin huide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "Dett vor koning aff Blindeuinder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "hand tager till att kalle:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "\"Monne icke Viderick vere ner:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 17,
      "text": "hui monne mit folck saa falde?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "Dett vor koning aff Blide-vinder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "oc hand saa Viderick komme:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "\"inorden seer ieg den samme skiold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 18,
      "text": "som skinner aff hammer oc tang.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "Dett vor kongen aff Blide-vinder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "oc hand hug alt saa fast:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "Widerick kunde icke andet giøre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 19,
      "text": "end bøde for hans kast.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "\"Nu haffuer ieg standen deg tyue hug,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "ieg vinter, de er vell flere:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "wiltu stande mig en igen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 20,
      "text": "for ald din kongelig ær?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 21,
      "text": "Kongen tog ud en silcke-trod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "hand lagden offuer hielem hind rødt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 21,
      "text": "\"Ieg beder dig, Widerick Vellantz-søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 21,
      "text": "hug mig icke till dødt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 22,
      "text": "Widerick drog ud Memerick-tand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 22,
      "text": "dett skinde som guld hind røde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 22,
      "text": "saa hug hand kongen aff Blide-vinder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 22,
      "text": "det aaden i sadelen rørde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 23,
      "text": "Nu ligger kongen aff Blide-vinder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 23,
      "text": "oc blodet rinder ham saa rødt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 23,
      "text": "oc hiem sider unger Ulff van Iern,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 23,
      "text": "haffuer høffnit sin faders dødt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 23,
      "text": ":: Dett klager den suend, som fangen ligger paa hedenn. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}