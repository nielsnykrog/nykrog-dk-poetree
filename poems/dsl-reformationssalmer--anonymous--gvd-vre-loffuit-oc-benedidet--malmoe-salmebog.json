  "source": {
    "id": null,
    "title": "[tabt]",
    "year_published": 1533,
    "publisher": "Christiern Pedersen",
    "printer": "Joh. Hoochstraten",
    "place": "Malmø",
    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/malmoe-salmebog/3"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "GVd være loffuit oc benedidet",
      "part": false,
      "marginal_notes": [
        "i Cor. xi"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "som oss selff haffuer bespiset/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Met sit legeme och met sit blod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "det giffue oss herre Gud til gode",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Kyrieleyson",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Herre vid dit hellige legeme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "som aff din moder Maria kom",
      "part": false,
      "marginal_notes": [
        "Mat i"
      ]
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "dit hellige blod oc din død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "hielp oss o Herre aff all vor nød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Kyrieleyson",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Dit hellige legeme er for oss giffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "i døden ath wi skulle leffue/",
      "part": false,
      "marginal_notes": [
        "Luce xxii"
      ]
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Jngen større gaffue kunde han oss skencke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "der met wi hannem oc hans død betencke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Kyrieleyson",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Kerlighed o herre dig saare tuingit haffuer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "ath dit blod ey offuer oss klaff uer/",
      "part": false,
      "marginal_notes": [
        "Joan v"
      ]
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "som betalede all vor skyld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "ath oss Gud er worden huld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Kyrieleyson",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "Gud i alle gaffuer oss vil velsigne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "ath wi paa hans vey skulle bliffue/",
      "part": false,
      "marginal_notes": [
        "Heb xii"
      ]
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "J ret kerlighed oc broderlig tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "ath den mad kommer oss ey til wro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Kyrieleyson",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "Herre met din aand oss aldrig forlad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "men lad oss dig paakalle i allen stad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "Ath din arme Christenhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "maa leffue i fred oc samdrectighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": "Kyrieleyson",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "Dominus vobiscum",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "Herren være met eder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "Oc met din aand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 7,
      "text": "Lader oss nw alle bede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "Amen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 9,
      "text": "Herren være met eder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 10,
      "text": "Oc met din aand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 11,
      "text": "AMEN",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 12,
      "text": "Dominus vobiscum",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 13,
      "text": "Herren were met eder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 14,
      "text": "Oc met din aand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 15,
      "text": "Vi løffte vaare hierter op i hiemmelen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 16,
      "text": "Vi haffue dem til Herren",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 17,
      "text": "Lader oss tacke Herren",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 18,
      "text": "Det er verdigt oc retuist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 19,
      "text": "DEn tid er kommen som før spaat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 19,
      "text": "Giff mig gaat raad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 19,
      "text": "Foruar mig vel fra falske lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 19,
      "text": "thi wi en nw se och høre/ mange forføre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 19,
      "text": "oc wilde folkit fra din guddoms ære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 19,
      "text": "hielp mit din store mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 19,
      "text": "giff act",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 19,
      "text": "ath du haffuer sagt mangelund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 19,
      "text": "At falske propheter skulle bære løgn for dem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 19,
      "text": "Och aff ret falsk grund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 19,
      "text": "forraske folkit met falske fund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 20,
      "text": "WOr Gud han er saa sterck en borg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 20,
      "text": "Han er vor skiold oc værie/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 20,
      "text": "han hielper aff all nød oc sorg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 20,
      "text": "der oss vil her besnarge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 20,
      "text": "dieffuelen wor gamble fiende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 20,
      "text": "han wil oss offueruinde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 20,
      "text": "stor mact oc argelist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 20,
      "text": "bruger han mod oss vist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 20,
      "text": "paa iorden er ey hans lige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 21,
      "text": "Vor egen mact er inthet verd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 21,
      "text": "wi ere snart offueruunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 21,
      "text": "der strider for oss en wellig Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 21,
      "text": "alting maa for hannem bugne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 21,
      "text": "Spør du huo han er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 21,
      "text": "Christus han heder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 21,
      "text": "en Herre offuer alle Herer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 21,
      "text": "oc ey ere frelsere flere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 21,
      "text": "marcken vil han beholde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 22,
      "text": "Det all verden fuld aff dieffuele vore",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 22,
      "text": "oc vilde oss slet opsluge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 22,
      "text": "dem frøcte wi icke ved ith haar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 22,
      "text": "thi Gud kan dem det forbiude/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 22,
      "text": "Er verdsens første wred",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 22,
      "text": "wil oss sencke ned/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 22,
      "text": "han kan dog intid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 22,
      "text": "Christus haffuer hannem fangit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 22,
      "text": "ith Gudz ord kan hannem binde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 23,
      "text": "Det samme ord de lade vel staa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 23,
      "text": "oc der til vtack haffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 23,
      "text": "thi Gud vil selffuer hoss oss gaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 23,
      "text": "alt met sin aand och naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 23,
      "text": "tage de bort wort liff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 23,
      "text": "gotz/ ære børn oc viff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 23,
      "text": "wi passe ey der paa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 23,
      "text": "de kunde ey mere faa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 23,
      "text": "Gudz rige wi dog beholde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 24,
      "text": "O Jesu Christ som mandom tog/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 24,
      "text": "i rene Jomfru liffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 24,
      "text": "kerlighed dig der till drog",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 24,
      "text": "vort haab saa vilde du bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 24,
      "text": "du saast vaar synd oc store nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 24,
      "text": "ath oss stod fore den euige død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 24,
      "text": "helffuede stod oss aabid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 25,
      "text": "Det lost du da forbarme dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 25,
      "text": "kunde det ey lenger lide/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 25,
      "text": "ath dieffuelen tog oss saa met sig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 25,
      "text": "der fore wilde du stride/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 25,
      "text": "Gaff saa dig her i verden ned/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 25,
      "text": "oc giorde oss en euig fred/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 25,
      "text": "alt met din død och pine",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 26,
      "text": "Oc saa sagde du oss det til/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 26,
      "text": "ath wi skulle haffue troen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 26,
      "text": "Thi du est baade god oc mild/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 26,
      "text": "oc vilt oss alle frelse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 26,
      "text": "om wi sette vor tro der paa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 26,
      "text": "ath det skal met oss være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 26,
      "text": "som du oss siger faare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 27,
      "text": "Du est worden vor broder kær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 27,
      "text": "oss til stor priss oc ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 27,
      "text": "oc altid vil oss vere nær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 27,
      "text": "huad kan man mere begere?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 27,
      "text": "Er det oss icke ith stort mon/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 27,
      "text": "vor broder er Gudz eniste Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 27,
      "text": "huo kan oss nu forderffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 28,
      "text": "Priss være dig nu euindelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 28,
      "text": "som oss den naade beuiste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 28,
      "text": "ath wi ere Gudz børn met dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 28,
      "text": "o kære broder o Christe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 28,
      "text": "Saa maa nu huer mand være glad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 28,
      "text": "oc tacke Gud i allen stad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 28,
      "text": "han er vor kære fader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 29,
      "text": "O Herre Gud aff hiemmerig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 29,
      "text": "wi maa det alle klage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 29,
      "text": "ath verden er vlydig dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 29,
      "text": "det se wi alle dage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 29,
      "text": "Dine ord forsmaa det er dess ver",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 29,
      "text": "ath ingen haffuer sandhed kær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 29,
      "text": "løgen haffuer macten fangit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 30,
      "text": "Nu lærer huer sin egen dict/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 30,
      "text": "som Gud kaller menniskens skick/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 30,
      "text": "ret sandhed holler man falskhed ligt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 30,
      "text": "dog hun aff Gud haffuer sin grund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 30,
      "text": "Det seer man vel for øgen her/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 30,
      "text": "den farlige tid nw kommen er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 30,
      "text": "som Apostlene oc Christus om talede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 31,
      "text": "Gudz tieniste er vent til skrømpteri",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 31,
      "text": "synder i hiertet inde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 31,
      "text": "for Gud er det ith geckeri/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 31,
      "text": "det faa wi selffue ath finde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 31,
      "text": "Mand skal det gøre som Gud oss bød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 31,
      "text": "hielpe wor neste i all sin nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 31,
      "text": "kerlighed fuldkommer lowen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 32,
      "text": "Vi haffue lenge farit wild/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 32,
      "text": "thi ingen haffuer oss wochtid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 32,
      "text": "oc dieffuelen gaff der raadene til/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 32,
      "text": "ath Gudz ord worde foractid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 32,
      "text": "De for oss ginge vore blinde som wi/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 32,
      "text": "oc kunde ey see den vilde sti/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 32,
      "text": "der fore da motte wi falde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 33,
      "text": "Men tack være dig nu Jesu Christ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 33,
      "text": "som lod dig det forbarme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 33,
      "text": "ath dieffuelen sueg oss met sin list/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 33,
      "text": "wi vare nu fanger arme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 33,
      "text": "nu lader du oss faa dine ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 33,
      "text": "met dem ret fri ere wi nu giort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 33,
      "text": "aff dieffuelsens falske lære",
      "part": false,
      "marginal_notes": []
    }
  ]
}