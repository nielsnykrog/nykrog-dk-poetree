  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "KOm Gud skaber helligand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "besøg vort hierte met din and",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "oc met din ade forny vor sid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "at wi kunde kende skab nig din",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Dw som kallis vor trøstermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "den høyeste nogen tid være kand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "met aan i Joa delig salue/ salue oss met/",
      "part": false,
      "marginal_notes": [
        "Joan. xv"
      ]
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "ath wi met dine gaffuer bliffue beset",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Optend i oss din Guddoms ild/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "och ødeleg wor egen wild/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "giff oss ith hierte rent och pwrt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "och styrcke i oss det dw haffuer giort",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Dw est siwfold i gaffuer skøne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "dw est Gudz finger paa den rette hand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Gudz faders ord giffuer dw wel fart",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "offuer alle land ath predickis snart",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Driff fra oss nw dieffuelsens list/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "lær oss ath kende reth Jesum Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "och tage korssit aff hans milde hand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "hwilkit han atskillig giffuer alle mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Lær oss faderen ath kende vel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "som forsørger baade liff oc siel/",
      "part": false,
      "marginal_notes": [
        "Joan. iii"
      ]
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "sin Søn for oss i døden gaff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "at wi skulle icke faa euig straff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Gud fader wære loff oc hans kære Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "som oss foruerffde den euige løn/",
      "part": false,
      "marginal_notes": [
        "Galat i"
      ]
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "der til wor den Helligand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "loff priss oc ære i alle land",
      "part": false,
      "marginal_notes": []
    }
  ]
}