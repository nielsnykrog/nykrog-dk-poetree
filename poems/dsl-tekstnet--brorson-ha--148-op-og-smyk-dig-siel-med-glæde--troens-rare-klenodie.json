{
  "id": null,
  "title": "148. Op og smyk dig, siel! med glæde",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
