  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Her Peder och her Olluff dy sedder offuer boord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "dy snackitt saa mangtt ett skeempttens ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": ":: Op vndder den liend der wogner allderkieereste mynn. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Her Iffuer hand suor thett paa synn thro:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "att hand vilde locke saa manggenn stalltt iumfru.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "\"Ieg weed icke denn iumfru i werdden till:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "thett ieg wilde io hinder med myn roner for-wild.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "Her Olluff sluo synn haand imuod buord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "\"Her Peder, du sig rett aldrig slig ord!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "Alltt haffuer ieg meg enn iumfru fest:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "thw skuld hinder rett aldrig med roner frest.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "\"Der weell ieg seette wed mytt røde guld:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "ieg well locke denn iunnfru hyd till mynn burd.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "Her Peedder legtte paa synn forgyldennde harp:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "thett hørde liddenn Kierstenn offuer marcke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "Her Peedder bleste y synn forgylltte lwd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "thett hørrdde liddenn Kierstenn hiem till synn burrd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "Lennge stuod liddenn Kierstenn, hun lyde der-paa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "\"Mone ieg skulde dyd y affttenn gaa?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "Alltt stuod liddenn Kierstenn, hun tengtte weed sieg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "\"Ingenn aff myn møør thør ieg laadde føllge meg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 10,
      "text": "Lyddenn Kierstenn och hynders lidenn hund:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "saa ieene gaa dy igiemell rosenslund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 11,
      "text": "Hun klaper paa her Peedders lofftt med synn skiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "\"Statt op, her Pedder, du lad meg ind!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 12,
      "text": "Sttatt op, her Peedder, och laad meg ind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "saa wee er meg for talle dynn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 13,
      "text": "\"Est dw saa wee for thaalle mynn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "y affttenn daa kuomer du icke her innd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 14,
      "text": "Menn giernne daa willde ieg laade dieg ind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "war thett icke for her Oluff, kierre herre dynn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 15,
      "text": "Om dw haffuer meg end y hiartet kieer:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "her Oluff er oss alltt for neerr.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 16,
      "text": "\"Sttatt op, her Peeder, och lad meg ind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "her driffuer daag offuer mynn skaarlagenn-skieennd.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 17,
      "text": "\"Driffuer der nu dag offuer dynn skaarlagenn-skiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "daa wend thett vd, som førre wend inndd.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 18,
      "text": "\"I-menn du weltt icke lade meg ind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 18,
      "text": "daa laad nogen aff dyn suenne følge meg hieem.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 19,
      "text": "\"Denn maanne hun skiener buode chlaar och rieenn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 19,
      "text": "y affttenn maatt du nu ienne gaa hieem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 20,
      "text": "Denn maane hun skiener saa klaar offuer tofft:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 20,
      "text": "thu gack ind iienne hiem till dynn lofftt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 21,
      "text": "Lyddenn Kierstenn och hynndis lyddenn hund:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 21,
      "text": "saa ieene gyck dy hieem igemell rosens-lund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 22,
      "text": "Lydenn Kierstenn hun gick denn allfaar-wie:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 22,
      "text": "her Peedder hand gyck denn lønlig stid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 23,
      "text": "Der hun kaam till borige-lieed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 23,
      "text": "der stuod her Ollff, hand huiller seeg weed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 24,
      "text": "\"Weell-komen, liddenn Kierstenn, alder-kiereste mynn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 24,
      "text": "huor haffuer du weritt om natter-tidd?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 25,
      "text": "\"Ieg waar meg gangendis vde till aaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 25,
      "text": "ieg skuode dy blomster brune och blaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 26,
      "text": "Ieg skuode dy blomster brune och blaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 26,
      "text": "thett fieerste agter ieg meg att faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 27,
      "text": "Ieg skuode thi roser huide och røde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 27,
      "text": "thi staar vdj dieris alerfierste grødde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 28,
      "text": "\"For denne nattzs ganng och anddre slig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 28,
      "text": "denn daarer oss buodde saa weeselig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 29,
      "text": "For denne natzs gang och andre flere:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 29,
      "text": "saa mend, lydden Kierstenn, giørr thett icke mieerre!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 30,
      "text": "Lyddenn Kierstenn hun saatte seg y synn seng:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 30,
      "text": "stuor sorig haffde hun y hiartt och sinndde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 31,
      "text": "Denn første søffuen, her Oluff fieck:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 31,
      "text": "liddenn Kiersten aff hands aarunn gick.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 32,
      "text": "Skaam faa her Peedder hans forgylltte lw!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 32,
      "text": "den suigger saa mangen erlig brud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 33,
      "text": "Skaam faa her Olluff guld-haarpe saa rød!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 33,
      "text": "den daarer saa mangen erlig møø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 34,
      "text": "Lyddenn Kierstenn drog knyff aff erme rød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 34,
      "text": "\"Alt skaall ieg innd-nu med eren døø.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 35,
      "text": "Op wognitt her Oluff, och op hand suo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 35,
      "text": "hand saam vdj liddenn Kierstens blod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 36,
      "text": "Her Olluff saatt saa hialtenn ymuod en stieen:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 36,
      "text": "och aadenn den raadde hans hiartte mieenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 37,
      "text": "Dett well ieg nu giffue huer vngersuend for lerre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 37,
      "text": "prøffue seg alder denn wyff, der erenn haffuer kier!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 38,
      "text": "Dy bleff buodde dødde, thett wor stuor nød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 38,
      "text": "syddenn maatte her Peedder och for suerdditt døø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 38,
      "text": ":: Op vndder den liend der wogner ald-kereste myn. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}