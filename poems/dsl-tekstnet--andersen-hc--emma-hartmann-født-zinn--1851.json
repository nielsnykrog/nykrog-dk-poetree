  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1851,
    "url": "https://tekstnet.dk/books/andersen-hc_emma-hartmann-foedt-zinn/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Her et Hjerte har hørt op at banke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Som var glad i Verden og i Gud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Vid og Lune og den dybe Tanke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "For os, som et Stjerneskud, slukt ud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Bag Kistens Fjæl en Moder ligger Lig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "En Hustru, – ja, en Skat, en Skat saa rig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Blomster elsked’ hun, og Blomster være,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Som et Tæppe, over Kisten lagt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Toner elsked’ hun, og Toner bære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Vort Farvel, igjennem Taarer bragt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Mer tung end Jorden over Kistens Fjæl",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Er Sorgen, Hjertets Sorg i sligt Farvel!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Jesus Christus, Du os Trøsten bringer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Gjennem Ordet, gjennem Tankens Lys;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Hun er fri, paa Aandens Engle-Vinger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Høit hun svæver over Dødens Gys;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Sit Hjem, der staaer i Sorg, saa tomt, forladt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Hun smiler til, det hendes Jordlivs Skat!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
