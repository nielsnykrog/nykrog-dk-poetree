{
  "id": null,
  "title": "† Emma Hartmann, født Zinn",
  "year_created": 1851,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
