  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "LOffuer Gud ath han er saa god/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "ath hans miskundhed varer euindelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Saa sige och nu Jsraels folck",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "ath hanss miskunhed varer euindelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "Saa siger nu Aarons huss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "ath hans miskundhed varer euindelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Saa sige oc nu de som frycte Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "at hans miskundhed varer euindelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "J min nød kallede ieg paa Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "saa hørde Gud mig rundelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 5,
      "text": "Effterdi Gud er met mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "da frøcter ieg icke huad Mennisken kan gøre mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 6,
      "text": "Effterdi Gud er mig en hielpere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "da vil ieg vel see paa mine fiende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 7,
      "text": "Det er bedre at sette haab til Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "end forlade sig paa Menniske",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 8,
      "text": "Ja det er fast bedre at sette sit haab til Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "end at forlade sig paa Førster",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 9,
      "text": "Alle Hedninge haffue belagt mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "men i Gudz naffn vil ieg offueruinde dem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 10,
      "text": "De haffue belagt mig om oc om/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 10,
      "text": "men i Gudz naffn vil ieg offueruinde dem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 11,
      "text": "De haffue belagt mig lige som bier/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 11,
      "text": "de ere dog vdfløckte lige som Jld i torne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 12,
      "text": "Men i Gudz naffn vil ieg vel faa heffn offuer dem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 13,
      "text": "De skøde oc støtte mig at ieg skulde haffue faldet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 13,
      "text": "men Herren halp mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 14,
      "text": "Gud er min styrcke/ oc den loffuer ieg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 14,
      "text": "Han er vorden mig til salighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 15,
      "text": "Der lyder en glædelig oc salig røst i de Retferdige Menniskis Bolige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 15,
      "text": "ath Gudz høyre haand beuiser stercke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 16,
      "text": "Gudz høyre haand beuiser styrcke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 17,
      "text": "Jeg skal icke Dø men leffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 17,
      "text": "oc forkynde Gudz gerninger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 18,
      "text": "Men Gud maa vel reffse mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 18,
      "text": "dog offuer giffuer han mig icke i Døden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 19,
      "text": "Oplader mig Retferdighedens porte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 19,
      "text": "at ieg maa gaa der ind oc loffue Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 20,
      "text": "Ja det er Herrens port/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 20,
      "text": "de Retferdige mue indgaa ath hannem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 21,
      "text": "Jeg tacker dig at du hører mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 21,
      "text": "oc at du est min salighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 22,
      "text": "Den sten som bygningis mendene bortkaste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 22,
      "text": "han er vorden til en hiørne sten",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 23,
      "text": "Ja det er alt sket aff Herren",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 23,
      "text": "Oc det er vnderligt i vore øyen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 24,
      "text": "Dette er den dag som Herren haffuer skabt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 24,
      "text": "lader oss frøydis oc glædis i hannem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 25,
      "text": "O Herre hielp/ o Herre giff lycke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 25,
      "text": "velsignet vere den som kommer i Herrens naffn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 25,
      "text": "Vi velsigne eder aff Gudz huss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 26,
      "text": "Gud er en Herre/ oc han opliuser oss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 26,
      "text": "Pryder høytiden met May/ indtil Alterens hiørner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 27,
      "text": "O Herre du est min Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 27,
      "text": "oc ieg vil tacke dig o min Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 27,
      "text": "Jeg vil holde megit aff dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 28,
      "text": "Loffuer Gud at han er saa god/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 28,
      "text": "at hans miskundhed varer euindelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 29,
      "text": "Gud Fader Søn oc Helligaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 29,
      "text": "Ske priss oc ære i allen stund",
      "part": false,
      "marginal_notes": []
    }
  ]
}