  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Hwen som altijd wil heffne syn harm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Tha ieg fick spurth myn broder wor dødh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "mith hiarthæ thet brænde alt som en glødh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Ieg saffnæde folk aff allæ the by",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "som ieg hade then tijd macth vdy.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "wij sloffue hwer annen ther neth for fodh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "I then strijdh faldh hwer hælledæ godh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "i Danmark wor fødh aff konge blodh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Ther wor ey heller quinfolk igen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Iomffrw Gyreth, thet wor hennes naffn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Danmark kom hwn siden tijl gaffn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Aff henne kom konningæ slecth igen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "i Danmarks rygæ, dog wor hwn seen.",
      "part": false,
      "marginal_notes": []
    }
  ]
}