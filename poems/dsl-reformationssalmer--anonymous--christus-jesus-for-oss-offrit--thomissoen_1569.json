  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Christus Jesus for oss offrit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "den loffue wi alle Christne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Guds Lam haffuer igenløst sine Faar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Christus wskyldig haffuer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "forligt Gud Fader oc alle syndere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "Død oc liff haffue nu strid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "liffsens høffding som vaar død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Christus nu leffuer altid skal regnere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "Sig oss nu Maria huad du haffuer paa veyen seet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "Jeg saa den leffuendis Christi graff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "oc ieg saa hans ære som vaar opstanden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "Jeg saa Guds Engle oc iordeklæder til vidnisbyrd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 4,
      "text": "Christus vort haab vist opstanden er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "oc hand skal eder møde i Galilea.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 5,
      "text": "Mariæ rette vidnisbyrd er fast mere troligt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 5,
      "text": "end alle Jødernis falske ord oc løgn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 6,
      "text": "Wi det sandelige vide/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 6,
      "text": "at Christ stod op aff Døde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 6,
      "text": "O Christe Konning forbarme dig offuer oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 7,
      "text": "Haleluia.",
      "part": false,
      "marginal_notes": []
    }
  ]
}