  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "ISraels vdgang aff Egypten",
      "part": false,
      "marginal_notes": [
        "Psa. cxiiii"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "och Jacobs hwss fra det groffue folk",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Da er kommen Juda til sin hellighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "oc Jsrael til sin veldighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "Det saa haffuit oc flyde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "och Jordan vende sig til bage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Biergenne haffue sprungit som bucke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "oc thuerne som de vnge lam",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "O haff huad er dig ath du flyde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "oc du Jordan ath du komst tilbage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 5,
      "text": "Oc i bierge ath i haffue sprungit som bucke?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "oc i thuer som de spæde lam?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 6,
      "text": "Jordan skelffuer for Herrens ansicte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "oc for Jacobs Gudz ansicte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 7,
      "text": "Huilken som haffuer went stenen til en sø/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "oc klippen til wandsens kilder",
      "part": false,
      "marginal_notes": [
        "Psalmo lxxviii"
      ]
    },
    {
      "id": 16,
      "stanza_id": 8,
      "text": "Jcke oss o Gud icke oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "men dit naffn giff den ere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "paa din barmhiertighedz oc sandhedz vegne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "Ath folkene skulle icke sige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "huor er nu deris Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 10,
      "text": "Men vor Gud er i hiemmelen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "alting haffuer han giort effter sin vilge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 11,
      "text": "Deris affguder ere sølff oc guld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "som ere menniskens gerninger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 12,
      "text": "De haffue mund oc kunde icke tale",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "de haffue øgen oc kunde icke see",
      "part": false,
      "marginal_notes": [
        "Sap. xv"
      ]
    },
    {
      "id": 27,
      "stanza_id": 13,
      "text": "De haffue ørne oc kunde icke høre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "de haffue næse oc kunde icke luchte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 14,
      "text": "De haffue hender oc kunde icke føle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "de haffue føder och kunde icke gaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 14,
      "text": "de kunde icke robe i deris strube",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "Lige dem skulle de bliffue som dem haffue giort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 15,
      "text": "och alle de som paa dem haabe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "O Jsraels hwss haabe til Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 16,
      "text": "han er din hielpere oc beskermere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "O dw Aarons hwss forlad dig paa Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 17,
      "text": "han er din hielpere oc beskermere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 18,
      "text": "O i gudfrøctige forlader eder paa herren/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 18,
      "text": "thi han er eders hielpere oc beskermere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 19,
      "text": "Herren haffuer kommet oss i hw/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 19,
      "text": "och haffuer benedidet oss alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 20,
      "text": "Han haffuer velsignet alle de Gudfrøctige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 20,
      "text": "saa vel de smaa som de store",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 21,
      "text": "Gud som forøger eder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 21,
      "text": "han formere eder och alle eders børn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 22,
      "text": "J ere benedidet aff Herren som skabte hiemmelen oc iorden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 23,
      "text": "Hiemmelens hiemmel er Herrens/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 23,
      "text": "Jorden haffuer han giffuet menniskens sønner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 24,
      "text": "De døde loffue dig icke Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 24,
      "text": "icke heller alle de som til heluede ned fare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 25,
      "text": "Men wi som leffue benedide Herren",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 25,
      "text": "fra nw och ind til euig tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 26,
      "text": "ære Gud fader oc Gud søn och ud den helligand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 27,
      "text": "Som wærit haffuer aff begyndelsen nw oc altid er och bliffuer till ewig tid",
      "part": false,
      "marginal_notes": []
    }
  ]
}