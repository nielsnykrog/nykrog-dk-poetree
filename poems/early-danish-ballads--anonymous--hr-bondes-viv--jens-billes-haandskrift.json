  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Jens Billes Håndskrift",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1555,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/BILL2.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Stalt Meteliile lerde hun sønen syn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "i stuen alt som de drocke vin:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "\"Thu love theg aldri Bonens vif.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Saa rade vi hanom Iver. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Thu love theg aldri Bonens vif,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "ted er stor skade alt for ted liiff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Tu lofue theg heller en ønsker-kvine.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Thu love theg heler en ønsker-kvine,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "saa øpis din sorie rett hale mine.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Oc er hun icke saa meget bold.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "Er hun ike saa megett bol,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "taa er hun dandes oc diide-ful.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Oc er hun ike saa meget rig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "Er hun icke saa megett rig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "taa er hun dandes oc diideliig.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "Oc ike liide han siin moders rad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "Ike liide han siin moders rad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "men han leder ud siin gangere graa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "Oc sadel af sølffue saa lade han aa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 6,
      "text": "Sadel af søle oc besell af gull,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "saa rider ten herre saa friide-ful.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 6,
      "text": "Oc ther han kom thil buriled.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 7,
      "text": "Ther han kom til buriled,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "stalt Mettelile stod ther ingen vid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 7,
      "text": "\"Hel stane i, stalt Mettellile, svefft i skind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 8,
      "text": "Hel stane i, stalt Mettellile, svefft i skind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 8,
      "text": "hvor er her Bone, kiere heren din?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 8,
      "text": "\"Her Bone han red af bii i-gaar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 9,
      "text": "Her Bone han red af bii i-gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 9,
      "text": "han komer ike hiem før iul i-iar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 9,
      "text": "Hvad heler vile i først i lofted at soffue?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 10,
      "text": "Hvad heler vile i først i lofted att sofue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 10,
      "text": "eller i vile dricke miød i sede-stuen?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 10,
      "text": "\"Och først ville vi udii loffted att sofe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 11,
      "text": "Først ville wii udii lofthed at sofe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 11,
      "text": "oc siidn dricke miød udi sede-stue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 11,
      "text": "The vore ike en vell udi sengen laud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 12,
      "text": "The wore ike vel udii sengen laud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 12,
      "text": "thed vor alt fore her Bonde savt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 12,
      "text": "Her Bone han skød thed brede bor.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 13,
      "text": "Her Bone han skød thed brede bor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 13,
      "text": "then brune mød at iorden stod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 13,
      "text": "Her Bone han stander i høved-loft-svale.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 14,
      "text": "Her Bone han staner i høved-laft-svale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 14,
      "text": "oc liider han paa beges theris taler.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 14,
      "text": "\"Hør i, her Iver, kere herre min.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 15,
      "text": "Hør i, her Iver, kere herre min:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 15,
      "text": "vi velle forrade her Bonis liif.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 15,
      "text": "\"Her Bone han er saa danen man.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 16,
      "text": "Her Bone han er saa danen mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 16,
      "text": "oc ike ville vi for-rade hanem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 16,
      "text": "Her Bone han er en ædliing.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 17,
      "text": "Her Bone han er en ædliing",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 17,
      "text": "bode panne stevne oc saa paa thing.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 17,
      "text": "Her Bone han ing att døren thren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 18,
      "text": "Her Bone han ing att døren thren,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 18,
      "text": "her Iver han setthes hanem op igen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 18,
      "text": "\"Hør du, her Iver, kiere selen min.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 19,
      "text": "Hør du, her Iver, kiere selen min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 19,
      "text": "hvii sofver du hos høstren min?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 19,
      "text": "\"Forti sofuer ieg hos høstren din.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 20,
      "text": "Forti soffuer ieg hoss høstren din,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 20,
      "text": "thed vor hennis ville saa god som min.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 20,
      "text": "\"Stad op, stalt Mettelile, oc kledttu dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 21,
      "text": "Stad op, stalt Mettelile, oc kledtu deg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 21,
      "text": "du gack hiem thil thin fader fraa meg!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 21,
      "text": "\"Min fader gaff meg en te karme V.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 22,
      "text": "Min fader gaff meg en te karme V,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 22,
      "text": "min herre, i unner meg en af tem.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 22,
      "text": "\"Din fader gaf deeg en te karme nii.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 23,
      "text": "Din fader gaf teg the karme nii,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 23,
      "text": "rett aldri da fanger tu in aff de;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 23,
      "text": "rett aldri da fannger tu in af de.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 23,
      "text": ":: Saa rade vi hanem Iver. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}