  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Esaias den Prophet monne det saa gaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "at hand i Aanden Herren sidde saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "J den høye Throne oc klare skin/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "hans klæder opfylte det Chor omkring/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Tho Seraphin stode hoss hannem der/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Sex vinger saa hand dennem haffue huer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "met de tho skiulte de deris Ansict klar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "met tho betecte de deris føder bar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "oc met de andre tho fløye de frijt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "mod huer andre robte de met megen flijt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Hellig er Gud vor Herre Zebaoth/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Hellig er Gud vor Herre Zebaoth/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Hellig er Gud vor Herre Zebaoth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Som haffuer all Jorden opfylt met megit gaat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Aff det rob skalff grunduol oc bielcker suar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "oc Husit fuld aff røg oc taage vaar.",
      "part": false,
      "marginal_notes": []
    }
  ]
}