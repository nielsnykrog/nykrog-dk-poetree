  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "»Wasser ist Körper und Boden der Fluß. Das neueste Theater",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Thut in der Sonne Glanz zwischen den Ufern sich auf.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Paa Gade, Mark og Tage, nu ligger Sneen hvid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Man bliver gratulert, jo, det er en deilig Tid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "– Men tys, der kommer Posten, hør Hornet skratter lidt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Ak, hvad mon vel han bringer os nu med Sort paa Hvidt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Ja Posten ligner Aaret, og Lignelsen er smuk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Han bringer ofte Glæde, men ofte Graad og Suk.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "– Nu kommer der en Kane; hvor Alt er der galant!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "See, Hesten bærer Bjælder og flagrende Gevandt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "I Pelsværk sidder Damen, de friske Læber lee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Bag paa staaer Cavaleren, heel underlig at see.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Raskt løbes der paa Skøiter hist paa den blanke Søe;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Brødkonen staaer og fryser, en bleg, en nordisk Mø.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
