  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "En kraftig Villie og et Hjerte, stort",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Og varmt for alt det Herlige og Rette,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Fik Du af Gud. Du har din Gjerning gjort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Den paa din Grav som Monument vi sætte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Dit danske Sind var ei af mange Ord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "I Stilhed virked’ Du; nu bølger Sæden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Tak for det meget Gode! vidt det groer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Mens Du som Christen vandred’ ind til Glæden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Paa Hjemmets Arne Ilden brændte ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Nu sidder Sorg i Sammenholdets Stue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Din Længsel bar i Jesus Dig til Gud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "– En Haandfuld Aske her – hist Livsens Lue.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
