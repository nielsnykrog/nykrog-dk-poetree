{
  "id": null,
  "title": "112. Ach! vidste du, som gaaer i syndens lenke",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
