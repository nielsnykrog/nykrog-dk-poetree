  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Hwo som wil leffue Christelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc hoss Gud bliffue euindelige",
      "part": false,
      "marginal_notes": [
        "Mat xix Ezec xx"
      ]
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Han skall fuldkomme de thi bud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "som oss haffuer budit vor Herre Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Gud miskunde oss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Jeg er din Gud oc Herre all en/",
      "part": false,
      "marginal_notes": [
        "Exo xx Deu v oc vi"
      ]
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "til ingen anden haff til flucten din/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "men tro paa mig aff hiertens grund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "oc haff mig kær i alle stund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Gud miskunde oss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Mit naffn dw ey wanære skall/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "men prise oc paa kalle det i nøden all/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Dw skalt oc fire den Sabbatz dag/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "ath ieg i dig haffuer ro oc mact",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Gud miskunde oss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Der nest hedre fader och moder met flid/",
      "part": false,
      "marginal_notes": [
        "Deut v"
      ]
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "saa gaar dig vel i alle tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "Sla ingen ihiel men elsk huer mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Oc holt vel ren din ecteskabss stat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Gud miskunde oss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "En andens gotz du skalt ey stiele/",
      "part": false,
      "marginal_notes": [
        "Deut v"
      ]
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "oc ey mod hannem falst widne bære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "Du skalt oc icke hans hustru begere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "Och ey nogit aff det hans monne være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Gud miskunde oss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "Disse bud oss alle giffne ere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "ath de skulle oss vor ondskab lære/",
      "part": false,
      "marginal_notes": [
        "Rom iii"
      ]
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "Oc sige oss huad wi skulle gøre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "om wi ville Gud i hiemmerig tilhøre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": "Gud miskunde oss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "Han vil oss icke hiemmerige giffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "Vden wi ville effter hans budord leff ue/",
      "part": false,
      "marginal_notes": [
        "Mat xix Deut. v"
      ]
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "Oc gaa der icke fra ith straa brit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": "huilkit oss er alle vmugelict",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 6,
      "text": "Gud miskunde oss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "Fordi kom til oss Jesus Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 7,
      "text": "och haffuer dem opfylt for oss vist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": "Hannem bede wi alle om naade oc hielp/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 7,
      "text": "thi vor egen mact hun er inted vert",
      "part": false,
      "marginal_notes": [
        "Joan xv"
      ]
    },
    {
      "id": 39,
      "stanza_id": 7,
      "text": "Gud miskunde oss",
      "part": false,
      "marginal_notes": []
    }
  ]
}