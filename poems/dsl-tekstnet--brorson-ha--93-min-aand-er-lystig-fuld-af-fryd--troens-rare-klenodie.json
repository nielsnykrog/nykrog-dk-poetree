  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Troens Rare Klenodie",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1739,
    "url": "https://tekstnet.dk/books/brorson-ha_troens-rare-klenodie/095/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Min aand er lystig, fuld af fryd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Din herlighed tilbeder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "O! JEsu, alle dyders dyd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Fuld af fuldkommenheder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "O! store JEsu herlighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "En himmel at forlystes ved.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Hand er den viisdom, som saa net",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Og rigtig alting føyer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Hans scepter aldrig nogens ret",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "For gunst og gave bøyer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "O! store JEsu &c.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Hand er sin Fader liig i magt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Sin aand i kraft og glæde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Med begge eet i evig pragt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Og høye Guddoms sæde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "O! store JEsu &c.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "Hand er den Guddoms rosmarin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "Som blomstrer uden ende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Et speyl, hvori GUd Fader sin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Natur kand see og kiende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "O! store JEsu &c.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "Hand er sin Faders tusindskiøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "Af evighed oprunden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "Hans velbehag i denne søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Har ingen ende funden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 4,
      "text": "O! store JEsu &c.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "Hand er foruden sted og rum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "Dog allesteds til stede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "En kilde, hav og hoved-sum",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": "Af hiertets fryd og glæde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 5,
      "text": "O! store JEsu &c.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "Alt hvad fuldkommenhed formaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "Det flyder her tilsammen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": "Hans magt til evig tiid bestaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 6,
      "text": "Hans ord er ja og amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 6,
      "text": "O! store JEsu &c.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 7,
      "text": "Retfærdig, uforanderlig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": "Stor, naadig uden ende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 7,
      "text": "Mod dem, som ret af hiertet sig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 7,
      "text": "Fra syndens vey omvende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 7,
      "text": "O! store JEsu &c.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 8,
      "text": "Hand er et væsen, reent og ret,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 8,
      "text": "Høyst salig evig bliver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 8,
      "text": "Et evigt og eenfoldigt eet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 8,
      "text": "Som ingen pen beskriver.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 8,
      "text": "O! store JEsu &c.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 9,
      "text": "Hand er sig selv et paradiis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 9,
      "text": "Uendelig fornøyet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 9,
      "text": "Hand er sig selv til evig priis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 9,
      "text": "Og i sig selv ophøyet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 9,
      "text": "O! store JEsu &c.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 10,
      "text": "Hvad synger jeg, som ey engang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 10,
      "text": "Hans høyhed ret kand kiende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 10,
      "text": "End sige sette det i sang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 10,
      "text": "Som er foruden ende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 10,
      "text": "Dog bliver JEsu herlighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 10,
      "text": "Et himmerig at glædes ved.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
