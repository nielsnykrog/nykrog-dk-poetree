  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Træd hen til Kisten her! kom, fattig Mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "I din Kreds födtes han, og Du tör sige:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Han blev en Stolthed for vort Folk og Land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "En Glands han kasted’ over Danmarks Rige!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Ja, her var Rigdom, Adel, Alt fra Gud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "I Snillet hos ham Gud sig for os viste;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Hans Död vil lyde vidt i Verden ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Man priser den, der dog faaer see hans Kiste!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Sin Sendelse paa Jorden har han endt –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Vi har ham seet og kjendt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Hans Liv var lykkeligt, hans Död var smuk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Han virked’ stort og herligt uden Lige!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "I Folkets Kreds og uden Smertens Suk",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Saa sjælesund han svang sig til Guds Rige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Vi rysted’ staae, et Blink fra Gud det var!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Fra fattigt Huus det gik ud over Jorden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Et Blink, der glemmes ei! See Stenen har",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Et Præg deraf, et Storheds Præg for Norden!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Oplös dig Sorg i Sang ved Kistens Fjel!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "I Jesu Navn, sov vel!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
