    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/malmoe-salmebog/2/5"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "AF hiertens nød rober ieg til dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Herre Gud vilt du mig høre",
      "part": false,
      "marginal_notes": [
        "Psal cxxx"
      ]
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Din naadens øren vent du till mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "min røst ieg nu framfører/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Giffuer du paa vor gerning act/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "ath heffne synden met din mact",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "O Herre hwo kan det taale",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Hoss dig all ene gelder naade oc gunst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "til synden ath forlade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "naar wi dig nogen tid haffue mist/",
      "part": false,
      "marginal_notes": [
        "Roma viii Ephe ii"
      ]
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "wi vide oss ey ath raade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "For dig sig ingen rose kand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "thi maa dig frøcte alle mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "och trøste dem paa din naade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Til Gud staar alt mit haab oc trøst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "min gerning kan mig ey baade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "i det du ene haffuer mig forløst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "aff din vsielig naade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Dine ord de ere en dyrebar skat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "som du oss haffuer effter lat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "dem wille wi gerne høre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Skulle det ware fra morgen stund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "oc indtil afftens ende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "da skulle mit hierte ingelund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "fortuile eller fra dig vendis",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Saa bør ath wære reth Jsraels art/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "ath haabe oc tro aff hierted snart/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "oc naade aff dig begære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Dog synden hoss oss er mangefuld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "hoss Gud er meget mer naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "ath hielpe oss er han vel huld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "aff nød oc alskøns waade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Han er forwist den rette tolck/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "som haffuer forløst alt Jsraels folk/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "aff sorg oc synder alle",
      "part": false,
      "marginal_notes": []
    }
  ]
}