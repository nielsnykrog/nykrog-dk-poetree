  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Liglagner i Festons omkring mit Billed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Og mørk Cypres og Pil, men ingen Palmer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "En Haandfuld Lilier slidt af deres Stængel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Med graalig Aske paa de hvide Blade;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Og knuste Urner, nedadvendte Fakler,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Kridhvide Dødningben og sorte Faner;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Men ingen Hænder slutted i hinanden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Og ingen Sommerfugl i Flugt mod Himlen.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
