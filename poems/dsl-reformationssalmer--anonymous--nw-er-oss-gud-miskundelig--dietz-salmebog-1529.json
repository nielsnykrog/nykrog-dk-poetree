  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "NW er oss Gud miskundelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc han wil oss welsigne/",
      "part": false,
      "marginal_notes": [
        "Psal. lxvj."
      ]
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "sitt ansigt offuer iorderig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "thet lader han nw skine.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Att wÿ paa iorden maa forstaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "hans wæy oc hellige naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "oc Jesus Christus kende oss saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "blant folk ÿ mange maade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Gud styre for oss oc raade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Wÿ tacke Gud oc loffue teg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "thit Hedinske folk offuer alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "oc alle land the glæde seg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "thit naffn the nw paakalle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Att tw retferdig dommer æst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "lad oss icke meer wildfare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Thÿne ord kunde oss beskerme best/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "ÿ hwo thennom wil bewaare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "han leffuer for vden fare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Wÿ tacke Gud oc loffue teg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "thit folk ÿ mange maade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "thÿn iord bær frucht oc bedrer seg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "thet kand thÿne ord wel raade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Signe oss Gud fader oc Guds søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "oc signe oss Gud then Helliaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "for hannwm skall rædis alle land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "thÿ alting stander wdi hans hand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "wÿ siunge aff hiertet AMEN.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Aere wære Gud fader ÿ himmerig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "som alting monne raade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "tesligest hans søn ewindelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "som frelste oss aff waade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Oc loffuit wære then Helliaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "som giffuer oss aff sÿn naade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "Then ære haffuer wærid aff ewig tÿd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "oc bliffuer for vden all ende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "Gud oss sÿn naade sende",
      "part": false,
      "marginal_notes": []
    }
  ]
}