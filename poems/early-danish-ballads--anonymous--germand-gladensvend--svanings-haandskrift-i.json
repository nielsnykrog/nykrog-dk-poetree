    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVI26.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Wor konning oc wor wnge dronning,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "dj seilede denom offuer haff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "der bleff deris skib paa | wanden holdit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "dj kunde icke bÿrren faa, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: saa fløg handt offuer att Rinen. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Er her nogitt wnnder wandit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "som skibet holde maa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "ieg giffuer ether buode guldt oc | sølff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "ÿ lader mig børren faa. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Du haffuer icke guldt eller sølff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "som der-till | hielpe maa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "dett er altt wnder dinn | linde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "der ieg mon effter traa. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Ieg haffuer icke wnder min linde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "foruden | min nøgle smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "kommer ieg leffuendis till | lande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "ieg lader mig andre slaa. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Saa tog hun dj nøgle smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "hun kaste denom | wdÿ strande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "dj fick bør hin blide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "dj | seilede saa glade till lande. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Dronningen hun ganger paa huiden sandt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "oc hun fick fuldt-stuor harm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "hun fulde | Hermandt gladen-Suendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "att handt queg | ÿ barm. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Dett wor icke der-effter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "foruden maneder fem, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "dronninngen hun gannger ÿ høÿe-lofft, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "hun fødde en søn saa wen. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Født bleff handt om afften,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "oc christnet dj hanom | om natt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "dj kallede hannom Hermandt gladen-Suendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "dj dÿlte hanom men dj matt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Saa wel handt woxte saa wel handt treffst, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "sin hest kunde handt wel ride,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "huer hand sin | moder saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "saa saare da mon hundt quide |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "I wider mig dett kiere moder min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "oc huadt | ieg will ether bede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "huj sørger ÿ saa Iammerlig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "huer sinde ÿ mig seer. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Hør du Hermandt gladen-Suendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "ieg maa | wel for dig quide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "du wast dig saa liden, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "der du bleff trolden giffuen. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Hør ÿ dett kiere moder min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "ÿ lader buort-fare | ethers wande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "huadt lÿcke gudt mig | giffue will,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "forminer mig ingen mandt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "Dett wor om en torsdag morgen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "saa orlig | om den høst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "oben da stodt den fruerstue, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 12,
      "text": "der kom saa wen en røst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 12,
      "text": ":: saa flÿger | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "Indt daa kom den lede gam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "handt settis den | frue saa ner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 13,
      "text": "minndis ether dett allerkieriste | min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 13,
      "text": "huadt ÿ haffuer giffuit mig, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "Hun suor om gudt, hun suor om mendt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "oc alt hun suere motte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 14,
      "text": "hun wiste huer-chen | datter eller søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 14,
      "text": "der hun ÿ werden otte. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "Bort da fløÿ den lede gam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "hand gaff | saa slem en skreg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 15,
      "text": "Huor ieg finder Hermandt gladen-Suendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 15,
      "text": "da er hand giffuen mig. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "Der handt war fulde fempten aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "daa | løster handt en iomffrue att loffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 16,
      "text": "kongens dather aff engelandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 16,
      "text": "den allerskiønist iomfrue |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "Saa saare daa monne handt lengis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "hiem till | sinn møe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 17,
      "text": "min kiere moder ÿ laner mig ethers fieder-ham | ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 17,
      "text": "men ieg fløger buort wnnder øe, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "Di winge dj ære saa brede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "dj ere saa wide | om bÿe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 18,
      "text": "leffuer ieg mig till sommer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 18,
      "text": "ieg lader | mig en nÿ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 18,
      "text": ":: saa flÿger handt offuer att | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "Handt sette sig ÿ sin fieder-ham,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 19,
      "text": "hand fløg | altt saa trøst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 19,
      "text": "der handt kom møtt paa | Sundt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 19,
      "text": "der hørde handt gamme-røst. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "Wer welckommen germandt gladen-suendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 20,
      "text": "saa wel | da kiender ieg dig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 20,
      "text": "du wast alt forliden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 20,
      "text": "der | du wost giffuen mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 20,
      "text": ":: Saa fløger handt | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 21,
      "text": "Du ladt mig flÿge du ladt mig fare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 21,
      "text": "altt till | min festermøe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 21,
      "text": "først ieg kommer tilbage igen, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 21,
      "text": "wÿ findis well wnder øe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 21,
      "text": ":: Saa flÿger handt | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 22,
      "text": "Daa skall ieg dig mercke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 22,
      "text": "altt huor du flÿger | frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 22,
      "text": "men huor du kommer blant Ridder | oc Suenne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 22,
      "text": "oc kiennde saa will ieg dig, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 23,
      "text": "Handt hug aff hans høgre øÿe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 23,
      "text": "druck halt hans | hierte-blodt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 23,
      "text": "endt fløg handt till jomfruens | bure,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 23,
      "text": "for wilge hun war till. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 24,
      "text": "Handt satte sig paa dj tinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 24,
      "text": "saa gasten | oc saa bleg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 24,
      "text": "alle dj jomffruer ÿ burit war, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 24,
      "text": "dj tabte bode skiempt oc leg. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 25,
      "text": "Alle da sadt dj stolte iomffruer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 25,
      "text": "gaff dett dog | lidett igiem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 25,
      "text": "foruden stolten Siluer-ladt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 25,
      "text": "hun kaste bode sax oc søm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 25,
      "text": ":: Saa fløger | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 26,
      "text": "Hun tog wdt en sølffue-kam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 26,
      "text": "hun kiemde hans faure haar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 26,
      "text": "huer en lock hun | redde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 26,
      "text": "hun felde saa modige taare. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 27,
      "text": "Huer en lock hun redde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 27,
      "text": "hun felde saa modige taare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 27,
      "text": "altt bandit hun hans moder, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 27,
      "text": "hans løcke hagde giort saa hordt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 28,
      "text": "Hør ÿ dett jomffrue Siluer-ladt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 28,
      "text": "ÿ bander | icke moder min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 28,
      "text": "hun kunde dett inthet ÿ | wolde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 28,
      "text": "Saa kranck war lÿcken min, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 29,
      "text": "Handt satte sig ÿ sin fieder-ham,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 29,
      "text": "oc saa fløg | handt der-fra,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 29,
      "text": "hun sotte sig ÿ sin Ammer, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 29,
      "text": "hun Monne effther hannom gaa. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 30,
      "text": "Alle dj fugle hun saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 30,
      "text": "denom klippit hun | alle saa smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 30,
      "text": "foruden den lede gam, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 30,
      "text": "hanom kunde hun icke naa, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 31,
      "text": "Dett wor jomffrue Siluer-ladt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 31,
      "text": "hun fløg | wdt mett den strandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 31,
      "text": "hun fant icke aff | germandt gladen-Suendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 31,
      "text": "foruden hans | høgre handt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 31,
      "text": ":: saa fløg handt offuer att | Rinne | ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}