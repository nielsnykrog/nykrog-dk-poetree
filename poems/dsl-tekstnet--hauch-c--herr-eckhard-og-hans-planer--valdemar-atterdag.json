{
  "id": null,
  "title": "Herr Eckhard og hans Planer",
  "year_created": 1861,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Carsten Hauch",
    "country": null,
    "wiki": "Q688529"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Valdemar Atterdag",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1861,
    "url": "https://tekstnet.dk/books/hauch-c_valdemar-atterdag/008/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Den næste Morgen jaged Kong Volmer under Ø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Ham fulgte mangen Ridder samt mangen deilig Mø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "De rede paa høie Heste paa den sneedækte Vei;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Dronningen hørte Messen, hun elsked Jagten ei.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Tidlig ved første Hanegal, før Munkene holdt Bøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Hr. Eckhard blev kaldet til Kongen i Løn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "De Hofmænd lytted udenfor, dog Alt var længe tyst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Omsider hæved Volmer sin stærke Kongerøst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "»Betænk, hvad I forlanger«, mæled den høie Drot,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "»I vilde skille Danmark ved Fyen og Riberslot,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Med Brand I trued Odense, dog har sig Lykken vendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "End Odense vi eier, og Byen er ikke brændt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "De Panter, jeg har indløst, høre nu Danmark til,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Dem faaer I ei tilbage ved List og Rænkespil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Og heller ei de Borge, jeg vandt ved Lov og Dom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Selv om I der har hersket, før jeg til Verden kom.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Mit Vaaben er en Løve, dertil et liggende Skjold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Det kan jeg fuldtvel reise, naar jeg gjestes med Vold;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Og havde jeg ei standset det gamle falske Spil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Da var der ei længer nu noget Danmark til.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Hvad Hr. Eckhard svared, de Hofmænd ei forstode,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Han blev fra Jagten hjemme, han var ei vel tilmode,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Heel tankefuld han sad med Haanden under Kind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "Da traadte den unge Ditlef, hans Svend, i Hallen ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "»Min Herre, hvorfor rider I ei Kong Volmer næst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Hvi sidder I tilbage som en foragtet Gjest?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "I tidt har viist mig Tillid, I veed, jeg er Jer tro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "Saa siig, hvi her I sidder, som i en Munkebo.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "Da svared Ridder Eckhard: »Visselig var det bedre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Om Konning Volmer hviled i Muld hos sine Fædre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "Ham har den lede Djævel nu gjort til Danmarks Drot;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "Han vil for sig alene besidde Land og Slot.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "Alt hvad til os er pantsat ved Danmarks hvide Strand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Det vinder han tilbage, man veed ei selv hvordan,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "At ham de valgte til Konge, det blev vor Storheds Grav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "Han vil alene raade fra Sund til Vesterhav.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "- »Ja«, svared den unge Ditlef, »vi kjende vel hans Rygte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Der er ei den paa Jord, som vi mere maa frygte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "Thi selv naar Land og Borge han synes at give hen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "Saasnart sig Lykken vender, han tager dem igjen.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "Gjensvared Ridder Eckhard: »Du kjender ham ei slet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Heel kunstig kan han flette sin Tale som et Net,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "Snart er hans Ord heel hvasse, som det skarpeste Staal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "Snart smutter han Dig af Haanden, fast som en smidig Aal.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "Hvile han ikke kjender og lader ei Andre Ro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Nu har han ogsaa fristet Hr. Peder Vendelbo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "Hemmelig alt de samles, jeg veed det ganske vist,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "Jeg frygter, han er daaret af Dankongens List.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "Fra Fyen er vi fordrevne ved en svigefuld Pagt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "Alle de fyenske Byer er under Danmark lagt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "Svigter nu Hr. Vendelbo og følger Volmers Hær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "Da miste vi og i Jylland, hvad end vi eie der.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 13,
      "text": "- »Ja«, svared den unge Ditlef, »skal atter med Fred",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "I Danmark vi herske, maa han fra Thronen ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "Alt er det engang hændet, og det kan skee igjen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "At Danmarks Konge fanges af udlændiske Mænd.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "»Du veed«, ham svared Eckhard, »jeg tidt har tænkt derpaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Dog vogte ham hans Kæmper, hvorhen han monne gaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "Ham vogte hundred Glavind ved Nat og ved Dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "Ditlef, min gode Væbner, det bli'er en farlig Sag.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 15,
      "text": "- »Dog tidt han rider ene bag Birk og Bøgeriis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "Ei er han da forsigtig, endskjøndt han kaldes viis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "Han rider uden Følge med Høg og med Hund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "Da beder han den tamme Hind alt i den Rosenlund.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 16,
      "text": "- »Dersom alt Andet glipper, vi prøve kan derpaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "Men denne Gang, min Ditlef, ere vi altfor faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "Dog har med Lybek og Gulland han nylig yppet Tvist,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "Kan de ham overvinde, behøves ei vor List.«",
      "part": false,
      "marginal_notes": []
    }
  ]
}
