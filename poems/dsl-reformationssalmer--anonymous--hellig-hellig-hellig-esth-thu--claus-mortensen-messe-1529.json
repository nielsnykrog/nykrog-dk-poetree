    {
      "id": 0,
      "stanza_id": 0,
      "text": "HEllig Hellig Hellig esth thu",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Herre gudh sabaoth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Hymmel och iorden ere wpfylthe/ meth thin ære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Salig giør oss wdy thet øffuersthe",
      "part": false,
      "marginal_notes": [
        "Mat. xxi.",
        "Mar. xi.",
        "Luce. xix",
        "Joh. xii."
      ]
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Benedictus qui venit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Benedideth wære then",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "ther kommer y herrens naffn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
