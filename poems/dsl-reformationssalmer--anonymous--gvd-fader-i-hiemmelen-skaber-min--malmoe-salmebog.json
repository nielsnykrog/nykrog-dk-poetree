  "source": {
    "id": null,
    "title": "[tabt]",
    "year_published": 1533,
    "publisher": "Christiern Pedersen",
    "printer": "Joh. Hoochstraten",
    "place": "Malmø",
    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/malmoe-salmebog/4/11"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "GVd fader i hiemmelen skaber min/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "giff naaden din/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Opliuss mig met din Guddoms skin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "all den vildfarelse nu forblind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "som er førd ind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "See hid met naadens øgen dine/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Lad mig forstaa din hiertens grund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "min mund och hierte rober aff nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Skiwle icke for mig din Guddoms ord liffsens port/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Din Søns store pine och død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "haffuer all min sorg och angest ødt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Den tid er nær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "som førre waar spaat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "giff mig gode raad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "wente alt ont bort fra liff oc siel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "J all vor nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "da stat oss bi/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "och gør oss fri/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Och lære oss dig ath kende vel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "offuer oss alle dig forbarme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Vi arme bede dig for din Søn vor herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "Ath du lader oss din vilge ret forstaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "trøst oc all vor begere aff dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "den stund wi leffue here",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Mig er stort raad ath bede dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "forlad icke mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Du skabte alting met Guddoms fund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Oc dele met mig din visdom rig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "icke fra mig wig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "formedelst Christum rør min hiertens grund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "Om den Helligand beder ieg mest/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "du wist vel huad ieg haffuer behoff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "Alt mit haab setter ieg till dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 2,
      "text": "kom mig arme synder i hu/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 2,
      "text": "Ath ieg gør dig min herre Gud loff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "Visdom och raad och salighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "sent mig her ned/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "foruare mig fra falske lære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "som wi nw daglige see oc høre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "mit hierte røre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 3,
      "text": "Dylg icke for mig din Guddoms ære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 3,
      "text": "din Guddoms krafft her til mig sent/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 3,
      "text": "foruent ath dieffuelen oss icke forfører/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 3,
      "text": "J verdens dict/ oc menniskens fund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 3,
      "text": "Ver rund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 3,
      "text": "lad mig dig gerne høre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 3,
      "text": "och din vilge altid gerne gøre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 4,
      "text": "Liff oc siel oc alt det ieg aar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 4,
      "text": "och ieg formaar befaler ieg i dine hender/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 4,
      "text": "formere i mig den rette tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 4,
      "text": "och hoss mig bo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 4,
      "text": "Den falske mening fra mig went",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 4,
      "text": "Beuarre mig met din store mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 4,
      "text": "giff act/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 4,
      "text": "huad du haffuer førre forkynt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 4,
      "text": "Ath falske Propheter skulde gaa fram/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 4,
      "text": "J faare ham oc ere dog vlffue mund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 4,
      "text": "som skrifften oss siger den rette grund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 5,
      "text": "Din barmhiertighed monne det wolde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 5,
      "text": "din Søn han taalde/ paa korssit for oss den haarde død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 5,
      "text": "Jeg flyer til dig met ydmyghed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 5,
      "text": "for sanden ieg ved/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 5,
      "text": "Du vilt ingelunde haffue ød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 5,
      "text": "den forligelse du haffuer giort saa stor/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 5,
      "text": "Jeg rober till dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 5,
      "text": "hør nu min bøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 5,
      "text": "Forlad mig alle gerninger onde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 5,
      "text": "som kunde mig skilye vid hiemmerigis løn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 5,
      "text": "hør mig o herre formedelst din Søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 6,
      "text": "J deris samuittighed ere de brend/",
      "part": false,
      "marginal_notes": [
        "i Timot iiii"
      ]
    },
    {
      "id": 70,
      "stanza_id": 6,
      "text": "for verden kend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 6,
      "text": "Som Sancte Pouel oss førre spaade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 6,
      "text": "Den hellige scrifft aff dem foruent/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 6,
      "text": "oc aldelis skent/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 6,
      "text": "Men herre Gud giff oss din naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 6,
      "text": "See till oss neder aff din høyste trone/",
      "part": false,
      "marginal_notes": [
        "i Tim. ii"
      ]
    },
    {
      "id": 76,
      "stanza_id": 6,
      "text": "Du betalede vore synder alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 6,
      "text": "du haffuer oss met Gud fader forligt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 6,
      "text": "den dict/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 6,
      "text": "Sanctus Paulus monne dig kalde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 6,
      "text": "en megler til Gud for oss alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 7,
      "text": "Vdi hiemmelen giff oss effter din pact",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 7,
      "text": "stort velde oc mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 7,
      "text": "och stat oss bi nw oc i wor død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 7,
      "text": "oc lad dieffuelen oss icke suige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 7,
      "text": "aff troen wige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 7,
      "text": "Lad oss icke komme i den nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 7,
      "text": "naar wi komme i dødsens quale/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 7,
      "text": "hugsuale oss da met dit store wold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 7,
      "text": "Du giff oss da til lige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 7,
      "text": "dit rige for oss wost du købt och sold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 7,
      "text": "Mod dieffuelen haffue wi icke anden skiold",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 8,
      "text": "Giff oss ret Christelig forstand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 8,
      "text": "mig och alle mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 8,
      "text": "før en døden oss heden kalder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 8,
      "text": "Till din barmhiertighed wi haabe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 8,
      "text": "och til dig robe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 8,
      "text": "forførde fra dig ere wi alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 8,
      "text": "fra dig oc i vor egen fund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 8,
      "text": "aff grund bede wi/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 8,
      "text": "for du bleffst vor lige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 8,
      "text": "Du hielp oss da som du vel kant/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 8,
      "text": "forsant/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 8,
      "text": "dine ord kunde ingen suige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 8,
      "text": "Giff oss her effter det euige rige",
      "part": false,
      "marginal_notes": []
    }
  ]
}