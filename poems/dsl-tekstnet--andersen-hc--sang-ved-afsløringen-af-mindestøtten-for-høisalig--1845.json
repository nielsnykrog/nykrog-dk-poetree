  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1845,
    "url": "https://tekstnet.dk/books/andersen-hc_sang-ved-afsloeringen-af-mindestoetten-for-hoeisalig-kong-frederik-den-sjette/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Kong Frederik den Sjette, Gud gav ham mange Aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Han vilde Folkets Lykke, ved det hans Bauta staaer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Saa deiligt grønnes Skoven ved Søen blank og klar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "De tyde den Erindring, som han i Folket har.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Det er herligt at vinde hvert Hjerte!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Hans Barndoms Aar var haarde, han prøved Livet tungt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Men til hans sidste Dage blev Hjertet mildt og ungt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Hans Ord var fast som Villien, hans Hjerte var saa blødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Meer folkelig en Konge vist ingen Tid er født.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Det er herligt at vinde hvert Hjerte!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Forkuet traadt med Foden den stakkels Bonde laae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Kong Frederik ham reiste, hans Hjerte vilde saa;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Og Marken stod med Grøde og Haverne med Frugt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Og Kinderne blev røde og Tankerne fik Flugt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Det er herligt at vinde hvert Hjerte!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "En Taare i hans Øie den Sortes Lænker brød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "I Konge-Solens Straaler trygt Aandens Væxt fremskjød;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "Det var omkring sit Hjerte han Kronens Guldring bar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Det var i al hans Tanke at Folkets Lykke var.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Det er herligt at vinde hvert Hjerte!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "Og Folkeaandens Maitræe han planted før sin Død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "Ham Bonden bar til Graven, al Folkets Taare flød;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "Velsignet er hans Minde, fra Slægt til Slægt det gaaer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "Han vilde Folkets Lykke, ved det hans Bauta staaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Det er herligt at vinde hvert Hjerte!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
