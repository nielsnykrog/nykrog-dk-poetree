  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Det Fjerne",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1907,
    "url": "https://tekstnet.dk/books/larsen-t_det-fjerne/011/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Og Bølgen gaar om Hvidenæs,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "og i det tørre stride Græs",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "der træder Vind med trange Suk",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "de kolde Skyggers lange Vugg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Imod en solskinstændt Natur",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "staar Jordens Mørke spændt paa Lur.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Paa mørke Bredning gynger Skær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "og hæse Søer synger her.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Og vaade Planter drive ind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "for aabne Himles stive Vind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "De blinde Bølger sorteblaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "igennem Havets Porte gaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "med salt og søvnig Klagesang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "om alle Dages Gang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Om alt og intet Striden staar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "med Lys og Mørke Tiden gaar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Og Livet gennem Lys og Mulm",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "sig kaster frem i Gys og Svulm –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "ja, alt det lever, alt det dør",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "som Skummet over salte Søer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Den Barm, hvorved du lider bedst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "har skiftet gennem Tiders Blæst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "er kun en midlertidig Form",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "for Bølgen i en smidig Storm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 1,
      "text": "og dybt i Blodet Toner gaar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 1,
      "text": "fra Lystens Millioner Aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 1,
      "text": "en Afgrunds purpurrøde Sang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 1,
      "text": "om vildsom Grødetrang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Og Hytter staar ved Hvidenæs,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "og i det tørre, stride Græs",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "gaar Fiskergubbens magre Ko,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "ser fjerne gode Agre gro.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "Spørg Gubben om det skabtes Værd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 2,
      "text": "hans hele Liv fortabtes her.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 2,
      "text": "Med karrig Jord og vreden Sø",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 2,
      "text": "han stred og vil i Reden dø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 2,
      "text": "Han flytter snart sin Bolig ned",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 2,
      "text": "i Muldens mørke Rolighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 2,
      "text": "Man Sørgesang istemmer klart,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 2,
      "text": "men de, der lever, glemmer snart.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 2,
      "text": "O – dryppende Sekunders Sang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 2,
      "text": "om Drømmens Undergang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 3,
      "text": "Ensformig suser Søens Vind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 3,
      "text": "mod Markens Korn og Møens Kind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 3,
      "text": "en evig Flygtning i vort Blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 3,
      "text": "forglemte Røsters: »Vi forgaa!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 3,
      "text": "Den kom i Urtids Himle løs,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 3,
      "text": "da Kloden ung i Svimle gøs.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 3,
      "text": "Med Kulden skarp og Kviden vild",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 3,
      "text": "den sang i Søvne hviden Ild.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 3,
      "text": "Al Glemsels blaa Alvidenhed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 3,
      "text": "den synger gennem Tiden ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 3,
      "text": "alt Suk mod Drømmens skønne Borg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 3,
      "text": "al Efteraarets grønne Sorg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 3,
      "text": "alt Sus i alle Tiders Græs,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 3,
      "text": "som var paa Hvidenæs.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
