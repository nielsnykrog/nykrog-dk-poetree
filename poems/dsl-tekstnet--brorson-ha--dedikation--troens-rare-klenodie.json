  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Undseelighed mig ey tilstood",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Den allerstørste Lykke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Da jeg den første gang tillood",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Mit Sange-Skrift at trykke;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Jeg tænkte: KONGEN visselig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Har andet paa at tænke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "End at Hand skulde lade sig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Saa slet et Arbeyd skiænke;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Jeg vidste, Himlens store Mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Har altid Hænder fulde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Af Klager fra det heele Land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Dog just det samme skulde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Nu give mig Opmuntring til",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "At lade mine Sange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Omsider gaae den Vey, de vil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Og ikke være bange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Kand dog enhver med sit Papiir",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Saa frit til Kronen haste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Vil MAJESTÆTENS Vældes Spiir",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "Dog intet Blad forkaste;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "Er her saa stor en Naades Poort",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "For baade Tak og Sukke?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "Er dog saa stærk en Anstalt giort",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "Til alle ind at lukke?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "Hvor kunde jeg da sige ney",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "Til Bogens Længsels Smerte?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "Da her er dog en alfar Vey",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "Til KONGENS milde Hierte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "Det maae al Verden troe dig til,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "KONG CHRISTIAN DEN SIETTE,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "Du selv din Byrde bære vil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "Og alle andres lette,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 0,
      "text": "Har sat dit Hierte til et Maal",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 0,
      "text": "For hver Mands Trængsels Pile,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 0,
      "text": "At den maa være Steen og Staal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 0,
      "text": "Som kunde der paa tvile.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 0,
      "text": "O! HØY-VELSIGNEDE MONARCH!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 0,
      "text": "Hvi skulde jeg forbyde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 0,
      "text": "Da mere disse Siunge-Ark",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 0,
      "text": "Den Herlighed at nyde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 0,
      "text": "At vorde til et Offer lagt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 0,
      "text": "For DANNER KONGENS Throne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 0,
      "text": "Samt Vidnesbyrd om Troens Magt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 0,
      "text": "Dens Sverd og Skiold og Krone?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 0,
      "text": "En Samling er i dette Baand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 0,
      "text": "Af ydmyge Suppliqver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 0,
      "text": "Som Israel ved Troens Haand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 0,
      "text": "Til Himlen daglig skikker;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 0,
      "text": "De er' et Neeg og liden Høst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 0,
      "text": "Af Aandens Første-grøde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 0,
      "text": "En Tone til at gaae med Lyst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 0,
      "text": "Den sidste Dag i møde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 0,
      "text": "De viser Troens rette Grund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 0,
      "text": "Art, Frugt, Kamp, Midler, Ende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 0,
      "text": "Vel den! som kand til sidste Stund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 0,
      "text": "Dens rette Virkning kiende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 0,
      "text": "Til sligt at vise har de sat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 0,
      "text": "KONG CHRISTIAN DEN SIETTE,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 0,
      "text": "At Christenheden Troens Skat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 0,
      "text": "Desmindre skal forgiette.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 0,
      "text": "Hid! læser denne gyldne Skrift",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 0,
      "text": "Paa Bogens første Side,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 0,
      "text": "I Folk, som sætter Aandens Drift",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 0,
      "text": "Fra Troen selv til Side.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 0,
      "text": "Og du, min Bog, hvad vil man dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 0,
      "text": "Dog meget salig prise,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 0,
      "text": "At du har lært saa mesterlig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 0,
      "text": "Din Meening at bevise,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 0,
      "text": "Thi hvad du baade stort og rart",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 0,
      "text": "Om Troen kand bekiende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 0,
      "text": "Det seer man, som et Lyys saa klart",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 0,
      "text": "I KONGENS Navn at brænde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 0,
      "text": "GUD lade KONGENS Verk og lid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 0,
      "text": "Hans hele Huus og Stamme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 0,
      "text": "Fra nu og indtil evig Tiid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 0,
      "text": "Blant Troens Helte bramme!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
