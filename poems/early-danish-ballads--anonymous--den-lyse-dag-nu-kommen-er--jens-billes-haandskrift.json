  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Jens Billes Håndskrift",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1555,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/BILL16.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Den liusse dagh nu kommen er,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "forgongen er vos den natt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "thj gørs migh tiden ganske longh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "stor lenels maa iegh locker offuer migh stor mact;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "handtt haffuer migh ganske alltt offuer sett woldtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "hun mone migh saarligh haade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "mett lengelse och kommer och alskens we",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "øpes sigh mett migh i mer och mer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "och han vill migh icke forlade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Mett lenelse er iegh saa vondtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "dett maa ieg høgelige kere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "rett aller ville iegh begere mitt lyff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "skulle dett saa lenge vere;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "hun tuinger migh bode dag och natt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "som iegh kan siell besinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "iegh frycter att dett saa vel blyffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "den stundtt iegh leffue maa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "bekommen er all min sinne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Men dett saa er, som iegh fornemer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "ieg icke kan sorgen vnvere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "der-effter vill iegh sette mitt sin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "iegh vill hine troligh bere;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "till gleden haffuer iegh altt intett hob,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "han vill icke hos migh blyffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "di vill iegh lade dett saa bestaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "icke mere begere en iegh kandtt faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "endtt Gudtt handtt vill migh gyffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Herre Gudtt y himmerigh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "giffue all min lengelse och sorigh en guodtt ende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "theg ingen tingh vmuligtt er,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "all-tingh kand du foruende;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "dett ieg motte snarlige finde den,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "som all min trøst till er,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "och iegh ham aldrig forlade vill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "fordj mitt sind dett sier saa tiill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "huad heller handtt er fiern eller ner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "Dett er saa mange der acter paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "huor de skulle dett foruende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "thett vi tror hiertte offuer-giffue skall",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "och lade thett saa snartt faa ende;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "migh under, att de vell hobes der-tiill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "den tingh dem icke kandtt skade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "ieg vell ham vell aff hiertens grundtt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "dygdtt och ere saa mange-lundt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "huadtt helder dem er vell eller we.",
      "part": false,
      "marginal_notes": []
    }
  ]
}