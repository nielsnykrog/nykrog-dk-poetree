  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "HErre huem skal haffue sin bolig i dit paulun? oc hwo skall bliffue paa dit hellige bierg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 1,
      "text": "Den som vandrer foruden smitte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "oc den som gør retferdighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "och aff sit hierte taler sandhed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "Den som icke haffuer belackid met sin tunge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "oc icke giort sin neste ont oc ført hannem paa nogen haanhed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "De vfromme foractis wdi hans øgen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "men dem som frøcte Gud gør han ere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "Den som loffuer sin næste met eed oc foruandler det icke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 5,
      "text": "Den som icke vdgiffuer sine penninge paa aager/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 5,
      "text": "oc icke tager gaffuer offuer den vskyldige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 6,
      "text": "Huo som dette gør/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 6,
      "text": "han skal aldrig forfaris euindelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 7,
      "text": "Ere være Gud fader",
      "part": false,
      "marginal_notes": []
    }
  ]
}