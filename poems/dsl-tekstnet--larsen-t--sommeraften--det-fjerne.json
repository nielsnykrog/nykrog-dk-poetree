  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Det Fjerne",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1907,
    "url": "https://tekstnet.dk/books/larsen-t_det-fjerne/006/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Aftenen faldt paa den stille Jord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "med Søvn og sagtelig Daanen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Det er saa lydt, at jeg stundom tror,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "der brøler en Ko paa Maanen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Søvnens Kamre er Gryder med Mulm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "der gærer af Fortid og Drømme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "af Legemers Grøde og Barmes Svulm –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "den Skaal skal Morgenen tømme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Træets Krone har suget sig fuld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "af svalt og virkeligt Mørke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Træet fordyber sig tavst i sin Muld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "i Tidernes Regn og Tørke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Søen har Ligevægt og Ro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "ligger saa stille ved Stranden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Der høres stundom et Smæk, som af to",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "smaa Fisk, der kysser hinanden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Der sker noget skønt i det høje Hvælv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "hvor Kloder sig nærmer og fjerner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "i Længsel og Glemsel og glødende Skælv",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "og Sorg over døde Stjerner.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
