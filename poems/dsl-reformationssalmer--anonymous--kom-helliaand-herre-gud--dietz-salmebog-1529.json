  "source": {
    "id": null,
    "title": "Een ny handbog med Psalmer oc aandelige lofsange",
    "year_published": 1529,
    "publisher": "Ludwig Dietz",
    "printer": "Ludwig Dietz",
    "place": "Rostock",
    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/dietz-salmebog-1529/7/4"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "KOm Helliaand herre Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "opfyld med thÿn naade oc miskund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "thÿne Christnes hiærte/ hw/ oc sind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "thÿn brendendis kierlighed ÿ thennom optend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "O Herre med thÿn naadis liwss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "ther med bepryd wort hiertis hwss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "hent tilsamen som ÿ werden boo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "aff alle tungemaal til een tro",
      "part": false,
      "marginal_notes": [
        "Actu. ij:"
      ]
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Alleluia Alleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Tw hellige liwss oc wÿsdoms port/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "lad oss opliwsis med liffzens ordt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "oc lær oss Gud rett alle att kende/",
      "part": false,
      "marginal_notes": [
        "Math. vj. Rom. viij."
      ]
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "aff hiertens grund hannwm fader att kalde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "O Herre beskerm oss fraa fremmede lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "att wÿ ingen mestere atspørrie meere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "en Jesum Christum wor frelsere kiære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "att wor tro kunde till hannwm allene wære",
      "part": false,
      "marginal_notes": [
        "Luce. j."
      ]
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Alleluia loffuer Herren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Tw hellige ild oc søde trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "hielp oss nw ÿ all wor brøst/",
      "part": false,
      "marginal_notes": [
        "Joh. xiiij. oc. xvj."
      ]
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "thÿn wilie altÿd effter att følge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "oc ingen modgang oss lade fraa teg skillie/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "O Herre med thÿn guddoms krafft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "styrck oss vsle oc giff oss macht/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "giennom sorrig oc bedrøffuelse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "att komme til teg wor frelsere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "loffuer Herren Alleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "O sandheds kielde oc hiertens frygd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "med aandelig smycke wort hierte bepryd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "att wÿ ÿ haab oc Christelig tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "med Gud oc wor næste ÿ kierlighed boo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "O hiertens Herre oc aandelig lÿff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "bestrÿd ÿ oss all syndzens kiff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "Skenck oss thÿn gunst oc staat oss bÿ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "att wÿ ey falle ÿ then aandelig krÿ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "Alleluia loffuer Herren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "O Gud allene wor hiertens trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "aff tho ÿ oss all syndzens brøst/",
      "part": false,
      "marginal_notes": [
        "j. Pet. j."
      ]
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "Thÿn ild/ thit wand/ thit sandheds liwss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "lad brende oc tho wort aandelig hwss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "O Herre Gud ÿ ewighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "wÿ tacke thÿn barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "bewar ÿ oss thet tw haffuer giord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "med aandelig krafft oc hellige ord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "loffuer Herren Alleluia.",
      "part": false,
      "marginal_notes": []
    }
  ]
}