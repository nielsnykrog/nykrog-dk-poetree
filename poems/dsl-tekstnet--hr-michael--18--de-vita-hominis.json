  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "De Vita Hominis",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1514,
    "url": "https://tekstnet.dk/books/hr-michael_de-vita-hominis/018/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Me tuba celestis resonans vocat a monumento.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Terra sit testis, leuo de veteri tegumento.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Nw blæses then liwd som tiedhæ før,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "hwn høres fran wæsther, til østher och nør.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Hudhen giffs om the paltughæ been,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "for domeræn schal ieg gaa igeen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "hwerth hiarthæ maa therforæ blødhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Enghelæn rober, thet hører swo widhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "stander vp nw allæ dødhæ!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Ether hiælper ey gaffuæ, ey hærræbøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "hwer schal nw taghæ syn tiænthæ løn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "for domeræn schullæ I mødhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Gud nadhæ mig armæ creatwr,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "mig maa ieg saaræ weenæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Jeg schal gaa foræ then græselighæ dom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "we mig at ieg til wærdhen kom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Hwar er myn macht? Huar er myt wold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "myn pladhæ, myt pantzeræ, myt glaffuen, myt sckiold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "mynæ swønæ, mynæ karsckæ hæsthæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "myn høgh, ieg haffdhæ paa myn hand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "ther ieg mynæ tiæneræ gæsthæ?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Allæ ræddes for mig huar ieg foer fram,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "at sckatthæ then fattughæ war mig ey sckam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "fran hannum tog ieg hanss fødhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "formeenthæ hannum och at gøræ syn wærn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "fuld saaræ mwnæ ieg hannum hødhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Jeg wildhæ mig sckiwlæ, kwndhæ ieg thet gøræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "at ieg schuldhæ ey myn brødhæ høræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "Ioduth, ioduth, huar mig er wee!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": "Hanss antlæd tør ieg ickæ see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "ey høræ huad han wil siæ.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
