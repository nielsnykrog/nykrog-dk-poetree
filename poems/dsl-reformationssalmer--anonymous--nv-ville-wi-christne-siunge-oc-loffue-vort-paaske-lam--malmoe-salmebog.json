  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "NV ville wi Christne siunge oc loffue vort paaske lam",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 1,
      "text": "Christ stod op aff døde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "oc frelste all verden aff nøde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "thi ville wi alle glade være",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "och siunge Gud loff met heder oc ære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Kyrieleyss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Christus det vskildige lam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "haffuer løst faaren igen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "oc haffuer syndere flyt faderens venskaff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "Døden oc liffuit stridde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "ingen wilde anden vige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "dog haffuer Christus døden offueruundet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 4,
      "text": "Sig oss Maria huad dw haffuer seet paa veyen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "den leffuendis Jesu Chri sti graff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "oc ieg saa hans erlige opstandelse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 5,
      "text": "Oc englis vitnesbyrd/ hans suede dug oc klæder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "Christus wort haab er opstanden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "oc skal gaa for oss til Galileam",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 6,
      "text": "Megit mer skal man tro all ene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 6,
      "text": "Marie Magdalene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "en det Jøderne sige falskelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 7,
      "text": "Vi wide ath Christus er opstanden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 7,
      "text": "aff døde met sande/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "der fore giff oss herre din miskund Amen",
      "part": false,
      "marginal_notes": []
    }
  ]
}