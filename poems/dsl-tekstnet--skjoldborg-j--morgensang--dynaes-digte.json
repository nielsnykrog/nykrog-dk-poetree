    "year_published": 1915,
    "url": "https://tekstnet.dk/books/skjoldborg-j_dynaes-digte/019/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Hvem er det, der bryder Nattemørkets Dvalering?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Dagens Yngling er det, Luften hvidner vidt omkring.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Se, han kommer, Kornet duver, Duggen svinder hen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Kløverbladet staar som nyt, saa grønt og rent igen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Om hans Læbe Smilet hviler som et Sejersbud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Gyldent lyser langt hans muskelspændte brune Hud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Morgenrødens Farveskær har lagt sig paa hans Kind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Øjet skinner stort og blankt i Morgnens friske Vind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Frem han skrider, Solens Barn, med Straaler i sit Haar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Høvdingsmærket paa hans klare Pande skrevet staar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Ud af Nattens Tavshed frem i Dagens Lyd og Larm",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "bærer højt han Lysets Fakkel i sin stærke Arm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Alle Stemmer tav i Nat, de sank i Drøm og Blund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Dagens Tunger taler nu i Morgnens glade Stund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Maanen er et blegt Metal, men Solen er af Guld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Tavshed er en Skygge kun, men Talen underfuld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Natten er en Dødens Sti, men Dagen Livets Port.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Natten spørger intet om, men Dag: Hvad har du gjort?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Livet kalder paa vort Mod og paa vort Hjærtes Slag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "derfor er det dig, jeg elsker, unge stolte Dag!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
