  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Bliv hvad De er, Natur og Sandhed tro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Hold Sjælen reen og Hjertet stedse fro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Bliv Dansk, hvor Danskes Sprog ei tales meer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Og Europæisk, naar De atter Danmark seer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "L. Kruse.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 3,
      "text": "Da Danmarks Bøgeskov sprang ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Saa sprang vi med, men over Søen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "Og hvor vi kom stod Vaaren Brud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "Saa skjøn, som i vort Hjem paa Øen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "»Saa Du vil bort fra Danelund,«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "Hvor dog saa Mange for Dig dægged,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "Før Du har lagt en varig Grund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 4,
      "text": "Før ret Du krøbet er af Ægget.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "»Det er ei godt, at Sønnen gaaer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "Fra Hjemmet bort til fjerne Lande,«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "Før han sit Modersmaal forstaaer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Og saa lidt meer, det vil Du sande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "Det er ei heller ret, at Du",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "Det lille Danmark vil forlade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 5,
      "text": "Hvor dog man kjender lidt endnu",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Til dine versbemalte Blade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Det var jo dog din største Lyst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "For Folk at læse dine Sange:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "Hvem skal nu lytte til din Røst? –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "Jo, Du vil længes tusind Gange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Og husker Du, hvormangen Sang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Du trak af Lommen op og læste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "Paa gammel Torv, i Smedens Gang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "Paa Gadehjørner, hvor der blæste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": "Og husker Du, hvor mangen Thee",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "Du hjalp at gjøre mere vandet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "Naar Du opramsed’, een, to, tre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "Din Tyveknegt, din Ravn og Andet!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 7,
      "text": "Og Du vil bort fra Danelund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 7,
      "text": "Nu har jeg aldrig før hørt Mage!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "Jeg vedder, at om stakket Stund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 7,
      "text": "Du kommer med Protest tilbage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": "Du kan ei Tydsk, Du kan ei Dansk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 7,
      "text": "Og endnu meget mindre Engelsk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 7,
      "text": "Og aabner Munden Du paa Fransk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 7,
      "text": "Troer en Pariser, det er Bengelsk. o. s. v. o. s. v.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 8,
      "text": "» Hav Tak for Maaneders smukke Digt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 8,
      "text": "Jeg seer, at under hjemlig Himmels Bue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 8,
      "text": "Kjærminder fandt den kjære Hjemmets Due",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 8,
      "text": "Et nordisk Amalthea-Horn saa rigt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 8,
      "text": "Den flyver nu mod Romas Zone hen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 8,
      "text": "I Alba, Nemis Speile sig at skue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 8,
      "text": "At hæve sig ved Ætnakæmpens Lue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 8,
      "text": "Og naar vi hilse den med Fryd igjen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 8,
      "text": "Naar den i Mnemosynes Lund har blundet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 8,
      "text": "Naar den har Sydens Ild og Klarhed fundet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 8,
      "text": "Den bringer Laurens Krands til Dem, min Ven!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 8,
      "text": "Paris, Skærsommer 1833.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 8,
      "text": "Brøndsted.«",
      "part": false,
      "marginal_notes": []
    }
  ]
}
