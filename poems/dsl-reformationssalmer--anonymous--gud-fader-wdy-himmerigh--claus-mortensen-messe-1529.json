    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/claus-mortensen-messe-1529/30"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "GUD fader wdy himmerigh/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "sin villie han oss kiende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "ther han oss nedh tiill iorderigh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "the x budord wdsende *",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "* Thet første budord thet er nu saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "thet bør tigh nu ath merke/",
      "part": false,
      "marginal_notes": [
        "Deut. vi"
      ]
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "affgudher schalt thu tigh ey faa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "men en gud schalt thu dyrke * *",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "* Thu schalt oc ey forfengelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "gudz hellige naffn paa kalle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "om thu vilth ey euindeligh/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "y pynen thet vndgiældhe * *",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "* Thu schalt oc komme yhu ther nesth/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "sabbatz dag hellig ath giøre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "och tienne gud som thu kandt besth/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "gudz ord tha schalt thu høre * *",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "* Thu schalt oc hedre oc ære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "thin Fader oc thin Modher/",
      "part": false,
      "marginal_notes": [
        "Mat. xv"
      ]
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "the tigh opføddhe meth ære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "meth gudh thu salig vordher * * *",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "* Thu schalt och ingen slaa y hiæl/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "oc ey mandrab bedriffue/",
      "part": false,
      "marginal_notes": [
        "Mat. v.",
        "Roma.xiii"
      ]
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "thin broder schal thu wnde væl/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "tha maa thu salig bliffue * *",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "* Thu schalt oc ey bedriffue hor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "thet monne saa mangen daare/",
      "part": false,
      "marginal_notes": [
        "Mat. v."
      ]
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "vkyskhetz synd hun snart forgaar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "men y pynen hun væl warer *",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "* Thu schalt oc ingen stiæle fraa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "hans gotz hans heder ey ære/",
      "part": false,
      "marginal_notes": [
        "Roma.xiii"
      ]
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "y verden schalt thu leffue saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "ath thu reetuiss kand være",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "* Thu schalt ey falske vitnisbyrd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "paa thin ieffuenchristhen bære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "eller thet bliffuer tig fuld ganske dyrth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "y euig pyne ath være",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "* Ther nesth thu schalt och ey attraa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "thin broders hustru wenne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "men al then stund thu leffue maa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "thin broder schalt thu tienne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "* Theet sisthe budord thet er nu saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "thet bør tigh nu ath merke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "thin brodhers gotz thu ey attraa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "hans huss och ey hans suenne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "* Gud Fader Søn och then Helligand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "han giffue oss sin naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "ath wy maatthe wdy alle land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "hans budord væl beuare",
      "part": false,
      "marginal_notes": []
    }
  ]
}