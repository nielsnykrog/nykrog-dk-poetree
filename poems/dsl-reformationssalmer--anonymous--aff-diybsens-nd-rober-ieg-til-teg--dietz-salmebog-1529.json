  "source": {
    "id": null,
    "title": "Een ny handbog med Psalmer oc aandelige lofsange",
    "year_published": 1529,
    "publisher": "Ludwig Dietz",
    "printer": "Ludwig Dietz",
    "place": "Rostock",
    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/dietz-salmebog-1529/9"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "AFf diybsens nød rober ieg til teg/",
      "part": false,
      "marginal_notes": [
        "Psal. cxxix."
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Herre Gud wiltu meg høre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Thÿn naadzens ørhe wend tw til meg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "mÿn røøst ieg nw framfører/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Giffuer tw paa wor gierning acht/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "att heffne synden med thÿn macht/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "O Herre hwo kan thet taale?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Hooss teg allene gielder naade oc gunst/",
      "part": false,
      "marginal_notes": [
        "Roma. viij Ephe. ij."
      ]
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "til synden att forlade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "nar wÿ teg nogen tÿd haffue mist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "wÿ wide oss ey att raade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "For teg ingen seg røme kand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "thÿ maa teg frycte alle mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "oc trøste thennom paa thÿn naade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Til Gud staar all mÿn haab oc trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "mÿn gierning kan meg ey baade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "ÿ thet tw eene haffuer meg forløøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "aff thÿn vsielig naade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Thÿne ord the ere een dyrebar skatt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "som tw oss haffuer effterlatt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "thennom wille wÿ gierne høre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Skulle thet waare fraa morgen stund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "oc indtil afftens ende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "tha skulle mit hierte ingelund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "fortuile eller fraa teg wendis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Saa bør att wære rett Jsraels art/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "att haabe oc tro aff hiertet snart/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "oc naade aff hannwm begære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Dog synden hooss oss er mangefuld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "hooss Gud er møget meer naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "att hielpe oss er han wel huld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "aff nød oc alskens waade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Han er forwist then rette tolk/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "som haffuer forløøst alt Jsraels folk",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "aff sorrig oc synder alle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "KYrie Gud fader alsomhøgeste trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "tw æst wor glæde oc løst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "spar oss ælende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "bewar oss fraa synd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "forbarme teg offuer oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 6,
      "text": "Christe tw æst wor wæy oc thet sande liwss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 6,
      "text": "sandhedzens port/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "kierlighedzens speil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "alle Christnes lÿff oc raad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "tw oss til wor salighed giffuen wort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 6,
      "text": "Forbarme teg offuer oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 7,
      "text": "Kyrie Helliaand ÿ ewighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 7,
      "text": "wer hooss oss med thÿn miskundelighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 7,
      "text": "wor synd wille wÿ begræde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 7,
      "text": "lad oss ey fortabis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 7,
      "text": "wÿ paa teg nw haabe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 7,
      "text": "forbarme teg offuer oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 8,
      "text": "GLadelig wille wÿ Alleluia siunge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 8,
      "text": "med kierlighedzens begæring.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 8,
      "text": "Wort haab oc hierte till Gud skall springe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 8,
      "text": "med sÿn hellige naade oc miskund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 8,
      "text": "Som haffuer forløøst oss aff all wor synd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 8,
      "text": "til salighed oc alskens trøst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 8,
      "text": "er han oss alle oprunden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 9,
      "text": "Alting som leffuer paa iorden skal Gud ære/",
      "part": false,
      "marginal_notes": [
        "Psalm. vlti"
      ]
    },
    {
      "id": 60,
      "stanza_id": 9,
      "text": "rundelig hans naade kund giøre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 9,
      "text": "Naade/ lÿff/ styrcke/ ther til krafft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 9,
      "text": "ÿ Christo haffue wÿ macht/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 9,
      "text": "heluede død oc dieffuelsens wold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 9,
      "text": "han haffuer forderffuit for wor skyld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 9,
      "text": "Wÿ tacke teg O Herre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 10,
      "text": "Gud tilsier alle thennom sÿn naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 10,
      "text": "som seg paa hannwm forlade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 10,
      "text": "att giffue trøst mod synden aff sitt gode/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 10,
      "text": "er han thennom bistandig ÿ alle maade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 10,
      "text": "wden swig oc all bedrægelighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 10,
      "text": "som hans ord forkynde wist.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 10,
      "text": "Thÿn fred offuer oss o Herre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 11,
      "text": "Gud wære loff oc ewig ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 11,
      "text": "ther til Gud hans søn wor Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 11,
      "text": "Oc ther til then werdige aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 11,
      "text": "som Christne giør altÿd bistand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 11,
      "text": "fraa ewighed oc til ewighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 11,
      "text": "haffuer wærid oc bliffue skal",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 11,
      "text": "for vden ende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 12,
      "text": "Wÿ tro allsammen paa een Gud /",
      "part": false,
      "marginal_notes": [
        "Gene. j."
      ]
    },
    {
      "id": 81,
      "stanza_id": 12,
      "text": "himmels skabere oc iordens/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 12,
      "text": "Gud søn sÿn faders wilie giorde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 12,
      "text": "paa thet wÿ sÿne børn skulde bliffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 12,
      "text": "Han wil oss forsee wor næring/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 12,
      "text": "lÿff oc siæl ÿ hans bewaaring/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 12,
      "text": "altÿd han oss wil bewaare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 12,
      "text": "inthit ont skal oss wederfare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 12,
      "text": "han sørger for oss dag oc nat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 12,
      "text": "for han haffuer alting ÿ sÿn macht.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 13,
      "text": "Wÿ tro oc alle paa Jesum Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 13,
      "text": "som er Guds søn oc wor Herre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 13,
      "text": "Som aff then Helliaand vndfangen wor/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 13,
      "text": "aff guddommelig krafft oc ære /",
      "part": false,
      "marginal_notes": [
        "Luce. j."
      ]
    },
    {
      "id": 94,
      "stanza_id": 13,
      "text": "aff Maria then reene Jomffru/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 13,
      "text": "eet sandeligt mennisk er worden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 13,
      "text": "Pÿnt vnder Pontio Pilato/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 13,
      "text": "korsfest/ død/ oc iordet/ til heluedis foer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 13,
      "text": "",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 13,
      "text": "wor dommer er han worden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 14,
      "text": "Wÿ tro oc paa then Helliaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 14,
      "text": "lÿg med fader oc med søn/",
      "part": false,
      "marginal_notes": [
        "Johan. xv."
      ]
    },
    {
      "id": 102,
      "stanza_id": 14,
      "text": "som alle bedrøffuedis hugsualer er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 14,
      "text": "med dyrebare gaffue oc naader skøne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 14,
      "text": "All gantske Christenhed paa iorden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 14,
      "text": "eet samffund giord med sÿne orde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 14,
      "text": "med hannwm wore synder tilgiffne worde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 14,
      "text": "Wÿ menniske skulle alle opstande/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 14,
      "text": "effter thette ælende/ Eet leffnit er oss forred/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 14,
      "text": "ewigt ÿ ewighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 15,
      "text": "NW bede wÿ then Helliaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 15,
      "text": "alt om then Christelig tro oc ret forstand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 15,
      "text": "thet oss Gud bewaare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 15,
      "text": "oc sÿn naade sende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 15,
      "text": "nar wÿ hæden fare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 15,
      "text": "aff thette ælende Kyrioleys.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 16,
      "text": "Tw werdige liwss giff oss thit skÿn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 16,
      "text": "lær oss att kende Christum Jesum allen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 16,
      "text": "att wÿ med hannwm bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 16,
      "text": "wor kiære frelsermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 16,
      "text": "som oss monne indlede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 16,
      "text": "till thet foriætte land Kyrioleys.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 17,
      "text": "Tw søde aand skenck oss forwist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 17,
      "text": "att wÿ maa dricke aff thit kierligheds bryst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 17,
      "text": "att wÿ wdaff hiertet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 17,
      "text": "hwer anden elske/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 17,
      "text": "med eet sind ÿ Christo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 17,
      "text": "haffue bode fred oc roo Kyrioleys.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 18,
      "text": "Tw yperste trøster ÿ all wor nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 18,
      "text": "hielp att wÿ forsmaa werdzens spot oc vselhed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 18,
      "text": "Att wÿ bestandig bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 18,
      "text": "paa wor sÿste ende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 18,
      "text": "nar wÿ med dieffuelen kiffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 18,
      "text": "om thette ælende Kyrioleys.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 19,
      "text": "NW er oss Gud miskundelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 19,
      "text": "oc han wil oss welsigne/",
      "part": false,
      "marginal_notes": [
        "Psal. lxvj."
      ]
    },
    {
      "id": 136,
      "stanza_id": 19,
      "text": "sitt ansigt offuer iorderig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 19,
      "text": "thet lader han nw skine.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 19,
      "text": "Att wÿ paa iorden maa forstaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 19,
      "text": "hans wæy oc hellige naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 19,
      "text": "oc Jesus Christus kende oss saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 19,
      "text": "blant folk ÿ mange maade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 19,
      "text": "Gud styre for oss oc raade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 20,
      "text": "Wÿ tacke Gud oc loffue teg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 20,
      "text": "thit Hedinske folk offuer alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 20,
      "text": "oc alle land the glæde seg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 20,
      "text": "thit naffn the nw paakalle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 20,
      "text": "Att tw retferdig dommer æst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 20,
      "text": "lad oss icke meer wildfare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 20,
      "text": "Thÿne ord kunde oss beskerme best/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 20,
      "text": "ÿ hwo thennom wil bewaare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 20,
      "text": "han leffuer for vden fare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 21,
      "text": "Wÿ tacke Gud oc loffue teg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 21,
      "text": "thit folk ÿ mange maade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 21,
      "text": "thÿn iord bær frucht oc bedrer seg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 21,
      "text": "thet kand thÿne ord wel raade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 21,
      "text": "Signe oss Gud fader oc Guds søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 21,
      "text": "oc signe oss Gud then Helliaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 21,
      "text": "for hannwm skall rædis alle land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 21,
      "text": "thÿ alting stander wdi hans hand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 21,
      "text": "wÿ siunge aff hiertet AMEN.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 22,
      "text": "Aere wære Gud fader ÿ himmerig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 22,
      "text": "som alting monne raade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 22,
      "text": "tesligest hans søn ewindelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 22,
      "text": "som frelste oss aff waade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 22,
      "text": "Oc loffuit wære then Helliaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 22,
      "text": "som giffuer oss aff sÿn naade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 22,
      "text": "Then ære haffuer wærid aff ewig tÿd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 22,
      "text": "oc bliffuer for vden all ende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 22,
      "text": "Gud oss sÿn naade sende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 23,
      "text": "HEllig. Hellig. Hellig æst tw Herre Gud Sabaot.",
      "part": false,
      "marginal_notes": [
        "Esaie. vj."
      ]
    },
    {
      "id": 171,
      "stanza_id": 23,
      "text": "Himmel oc iorden er forfylt med thÿn ære Salig giør oss wdi thet offuerste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 23,
      "text": "Benedidet wære then ther kommer ÿ Herrens naffn.",
      "part": false,
      "marginal_notes": [
        "Math. x."
      ]
    },
    {
      "id": 173,
      "stanza_id": 23,
      "text": "Salig giør oss wdi thet offuerste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 24,
      "text": "TEg wære loff oc prÿss o Herre Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 24,
      "text": "benedidet er then dag for wist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 24,
      "text": "Wÿ loffue teg nw oc til ewig tÿd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 24,
      "text": "Hellig hellig hellig æst tw ÿ thet høgeste.",
      "part": false,
      "marginal_notes": [
        "Esaie. vj."
      ]
    },
    {
      "id": 178,
      "stanza_id": 25,
      "text": "Englene oc offuer engle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 25,
      "text": "tronerne oc thet himmelske herskaff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 25,
      "text": "Teg loffue Cherubin oc Seraphin.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 25,
      "text": "Hellig hellig hellig siungis ÿ thet offuerste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 26,
      "text": "Thit folk o Christe loffue teg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 26,
      "text": "Thÿn brud aff hiertet nw glæder seg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 26,
      "text": "For thÿn naade oc barmhiertighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 26,
      "text": "Hellig hellig hellig hun siunger teg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 27,
      "text": "O Guds lam som borttager alle werdzens synder:",
      "part": false,
      "marginal_notes": [
        "Johan. j."
      ]
    },
    {
      "id": 187,
      "stanza_id": 27,
      "text": "forbarme teg offuer oss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 28,
      "text": "Miskunde teg offuer oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 29,
      "text": "O Guds lam som borttager alle werdzens synder:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 29,
      "text": "Giff oss thÿn fred.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 30,
      "text": "IEsus Christus er wor salighed/",
      "part": false,
      "marginal_notes": [
        "Esaie. liij."
      ]
    },
    {
      "id": 192,
      "stanza_id": 30,
      "text": "som fraa oss tog Gud faders wrede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 30,
      "text": "med sÿn pÿne oc hellige død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 30,
      "text": "frelste han oss fraa heluedis nød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 31,
      "text": "Att wÿ aldrig thet forgæde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 31,
      "text": "gaff han oss sitt legomme att æde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 31,
      "text": "som er skiuld ÿ brødzens skÿn/",
      "part": false,
      "marginal_notes": [
        "Mat. xxvj."
      ]
    },
    {
      "id": 198,
      "stanza_id": 31,
      "text": "oc att dricke sitt blod ÿ wÿn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 32,
      "text": "Hwem aff thenne kost wil æde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 32,
      "text": "sitt hierte oc sÿn sag han ey forgæde/",
      "part": false,
      "marginal_notes": [
        "j. Corin. xj."
      ]
    },
    {
      "id": 201,
      "stanza_id": 32,
      "text": "hwem vwerdig her til gaar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 32,
      "text": "for lÿffuit tha then ewige død han faar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 33,
      "text": "Thÿ skaltw Gud fader prÿse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 33,
      "text": "att han teg saa wel wilde spÿse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 33,
      "text": "oc han for thÿn syndzens løst/",
      "part": false,
      "marginal_notes": [
        "Rom. viij."
      ]
    },
    {
      "id": 206,
      "stanza_id": 33,
      "text": "ÿ døden sÿn søn haffuer giffuit wist.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 34,
      "text": "Saadan naade oc barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 34,
      "text": "søger eet hierte ÿ stort arbeyd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 34,
      "text": "æstw karsk saa bliff her fraa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 34,
      "text": "att tw skalt icke fordømmelsen faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 35,
      "text": "Tw skalt nw bliffue ÿ stadelig tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 35,
      "text": "tha foer tw naade miskund oc roo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 35,
      "text": "aff thenne kost han haffuer giffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 35,
      "text": "oss arme til thet ewige lÿff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 36,
      "text": "Han siger sielff kommer ÿ arme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 36,
      "text": "ieg wil meg offuer eder forbarme /",
      "part": false,
      "marginal_notes": [
        "Math. xj. Math. ix:"
      ]
    },
    {
      "id": 217,
      "stanza_id": 36,
      "text": "Jngen læge haffue the karske behoff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 36,
      "text": "hans konst er thennom een spot oc wro.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 37,
      "text": "Wilde tw med thÿne gierninger fange/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 37,
      "text": "ÿ himmelen for thennom indgange/",
      "part": false,
      "marginal_notes": [
        "Galat. ij."
      ]
    },
    {
      "id": 221,
      "stanza_id": 37,
      "text": "tha wore mÿn pÿne oc død ey fyllist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 37,
      "text": "for tw teg sielluff thÿn salighed æst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 38,
      "text": "Troer tw fast aff hiertens grund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 38,
      "text": "oc bekender med thÿn mund/",
      "part": false,
      "marginal_notes": [
        "Roman. x."
      ]
    },
    {
      "id": 225,
      "stanza_id": 38,
      "text": "saa æst tw ret gantske wel skickit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 38,
      "text": "oc thenne kost thÿn siæl wederqweger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 39,
      "text": "Thenne frucht kan ey hæden wære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 39,
      "text": "brødre oc søstre skaltw ære/",
      "part": false,
      "marginal_notes": [
        "Johan. xiij"
      ]
    },
    {
      "id": 229,
      "stanza_id": 39,
      "text": "med thÿne penning gods oc iord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 39,
      "text": "ther med thennom hielpe som Gud haffuer budit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 40,
      "text": "GVd wære loffuit oc benedidet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 40,
      "text": "somoss sielff haffuer bespÿset/",
      "part": false,
      "marginal_notes": [
        "j. Corin. xj."
      ]
    },
    {
      "id": 233,
      "stanza_id": 40,
      "text": "Med sitt legom oc med sitt blod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 234,
      "stanza_id": 40,
      "text": "thet giffue oss Herre Gud til gode",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 235,
      "stanza_id": 40,
      "text": "Kyrieleyson.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 236,
      "stanza_id": 41,
      "text": "Herre wid thit hellige legom",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 237,
      "stanza_id": 41,
      "text": "thet som aff thÿn moder Maria kom/",
      "part": false,
      "marginal_notes": [
        "Math. j."
      ]
    },
    {
      "id": 238,
      "stanza_id": 41,
      "text": "thit hellige blod oc thÿn død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 239,
      "stanza_id": 41,
      "text": "hielp oss Herre aff all wor nød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 240,
      "stanza_id": 41,
      "text": "Kyrieleyson.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 241,
      "stanza_id": 42,
      "text": "Thit hellige legom er for oss giffuit/",
      "part": false,
      "marginal_notes": [
        "Luce. xxij."
      ]
    },
    {
      "id": 242,
      "stanza_id": 42,
      "text": "ÿ døden att wÿ skulle leffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 243,
      "stanza_id": 42,
      "text": "Jngen større gaffue kunde han oss skencke:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 244,
      "stanza_id": 42,
      "text": "ther med wÿ hannwm oc hans død betencke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 245,
      "stanza_id": 42,
      "text": "Kyrieleyson.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 246,
      "stanza_id": 43,
      "text": "Kierlighed o Herre teg saare thwungit haffuer/",
      "part": false,
      "marginal_notes": [
        "Johan. v."
      ]
    },
    {
      "id": 247,
      "stanza_id": 43,
      "text": "att thit blod ey offuer oss klaffuer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 248,
      "stanza_id": 43,
      "text": "oc betalid all wor skyld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 249,
      "stanza_id": 43,
      "text": "att oss Gud er worden huld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 250,
      "stanza_id": 43,
      "text": "Kyrieleyson.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 251,
      "stanza_id": 44,
      "text": "Gud ÿ alle gaffuer oss wil welsigne/",
      "part": false,
      "marginal_notes": [
        "Hebre. xij."
      ]
    },
    {
      "id": 252,
      "stanza_id": 44,
      "text": "att wÿ paa hans wæy skulle bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 253,
      "stanza_id": 44,
      "text": "ÿ rett kierlighed oc broderlig tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 254,
      "stanza_id": 44,
      "text": "att then mad kommer oss ey til wro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 255,
      "stanza_id": 44,
      "text": "Kyrieleyson.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 256,
      "stanza_id": 45,
      "text": "Herre med thÿn aand oss aldrig forlad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 257,
      "stanza_id": 45,
      "text": "men teg altÿd paakalle ÿ allen stad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 258,
      "stanza_id": 45,
      "text": "Att thÿn arme Christenhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 259,
      "stanza_id": 45,
      "text": "maa leffue/ ÿ fred oc samdrectighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 260,
      "stanza_id": 45,
      "text": "Kyrieleyson.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 261,
      "stanza_id": 46,
      "text": "Herren wære med eder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 262,
      "stanza_id": 47,
      "text": "Oc med thÿn aand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 263,
      "stanza_id": 48,
      "text": "GVd fader wdi himmerig/",
      "part": false,
      "marginal_notes": [
        "Exodi. xx. Deuter. v. Deut. vj."
      ]
    },
    {
      "id": 264,
      "stanza_id": 48,
      "text": "sÿn wilie han oss kende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 265,
      "stanza_id": 48,
      "text": "ther han oss nid til iorderig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 266,
      "stanza_id": 48,
      "text": "the. x. budord wdsende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 267,
      "stanza_id": 49,
      "text": "Thet første budord thet er nw saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 268,
      "stanza_id": 49,
      "text": "thet bør teg nw att mercke:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 269,
      "stanza_id": 49,
      "text": "affguder skaltu teg ey faa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 270,
      "stanza_id": 49,
      "text": "men een Gud skaltu dyrcke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 271,
      "stanza_id": 50,
      "text": "Tw skalt oc ey forfengelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 272,
      "stanza_id": 50,
      "text": "Guds hellige naffn paakalle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 273,
      "stanza_id": 50,
      "text": "om tw wilt ey ewindelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 274,
      "stanza_id": 50,
      "text": "ÿ pÿnen thet vngiælde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 275,
      "stanza_id": 51,
      "text": "Tw skalt oc komme ihw ther næst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 276,
      "stanza_id": 51,
      "text": "Sabbats dag hellig att giøre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 277,
      "stanza_id": 51,
      "text": "oc tiæne Gud som tw kant best/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 278,
      "stanza_id": 51,
      "text": "Guds ord tha skaltu høre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 279,
      "stanza_id": 52,
      "text": "Tw skalt oc hedre oc ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 280,
      "stanza_id": 52,
      "text": "thÿn fader oc thÿn moder/",
      "part": false,
      "marginal_notes": [
        "Math. xv."
      ]
    },
    {
      "id": 281,
      "stanza_id": 52,
      "text": "the teg opfødde med ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 282,
      "stanza_id": 52,
      "text": "med Gud tw salig worder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 283,
      "stanza_id": 53,
      "text": "Tw skalt oc ingen slaa ihiel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 284,
      "stanza_id": 53,
      "text": "oc ey mandrab bedriffue/",
      "part": false,
      "marginal_notes": [
        "Math. v. Roma. xij."
      ]
    },
    {
      "id": 285,
      "stanza_id": 53,
      "text": "thÿn broder skaltu vnde wel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 286,
      "stanza_id": 53,
      "text": "tha mottw salig bliffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 287,
      "stanza_id": 54,
      "text": "Tw skalt oc ey bedriffue hoor/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 288,
      "stanza_id": 54,
      "text": "thet monne saa mangen daare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 289,
      "stanza_id": 54,
      "text": "vkyskheds synd hun snart forgaar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 290,
      "stanza_id": 54,
      "text": "men pÿnen hun wel waarer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 291,
      "stanza_id": 55,
      "text": "Tw skalt oc ingen stiæle fraa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 292,
      "stanza_id": 55,
      "text": "hans gods/ hans heder ey ære/",
      "part": false,
      "marginal_notes": [
        "Rom. xiij."
      ]
    },
    {
      "id": 293,
      "stanza_id": 55,
      "text": "ÿ werden skaltu leffue saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 294,
      "stanza_id": 55,
      "text": "att tw retwÿss kant wære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 295,
      "stanza_id": 56,
      "text": "Tw skalt ey falske witnesbyrd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 296,
      "stanza_id": 56,
      "text": "paa thÿn ieffnchristen bære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 297,
      "stanza_id": 56,
      "text": "eller thet bliffuer teg fuld gantske dyrt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 298,
      "stanza_id": 56,
      "text": "ÿ ewig pÿne att wære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 299,
      "stanza_id": 57,
      "text": "Ther næst tw skalt oc ey attraa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 300,
      "stanza_id": 57,
      "text": "thÿn broders høstru wene:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 301,
      "stanza_id": 57,
      "text": "men all then stund tw leffue maa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 302,
      "stanza_id": 57,
      "text": "thÿn broder skaltu tiæne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 303,
      "stanza_id": 58,
      "text": "Thet sÿste budord thet er nw saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 304,
      "stanza_id": 58,
      "text": "thet hør teg nw att mercke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 305,
      "stanza_id": 58,
      "text": "thÿn broders gods tw ey attraa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 306,
      "stanza_id": 58,
      "text": "hans hwss oc ey hans swene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 307,
      "stanza_id": 59,
      "text": "Gud fader Søn oc then Helliaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 308,
      "stanza_id": 59,
      "text": "han giffue oss aff sÿn naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 309,
      "stanza_id": 59,
      "text": "att wÿ motte wdi alle land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 310,
      "stanza_id": 59,
      "text": "hans budord wel bewaare.",
      "part": false,
      "marginal_notes": []
    }
  ]
}