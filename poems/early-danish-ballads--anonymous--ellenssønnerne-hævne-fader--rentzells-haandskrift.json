{
  "id": null,
  "title": "Ellenssønnerne hævne Fader",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Rentzells Håndskrift",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/RNZ17.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Fru Ellinger boer ÿ Sielland,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hun er en | frue sielff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Thett maa well alle hinder | sønner Loffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "hun lyrer thenum alle | saa well,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: fru Elligiger, Oc hun | kand Radenne siige | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Hører i thett min kiere sønner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "i-naar | ÿ riider att gille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "ÿ loffuer ether aldrig | Encker eller møør,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "I-mod hennes | frenders wiillie |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Da wore icke Søskind wden tho,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "ieg och | min broder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "min fader satte mig y Closter | Ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "dødtt saa wor min moder |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Daa badtz mig thiill ethers kiere fader, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "oc ham saa sagde ieg Ia,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "ieg spurde icke | , Icke min fader at",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "Oc ingen mine frender | tiill raadtt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Dett wor tha min kiere fader,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "min løcke | saa wiille hand spille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "han gaff mig | en anden riider,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "der-mett saa giorde han | ilde |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Dett vor tha ethers kiere fader,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "ther han | de thidinde fiick,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "han foer siig tiill Ribe, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "den same riider hann wogh |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Der hand haffde wogitt den Riidder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "och | kongen bliiff hannom wredtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "saa foer | hand aff Landiit wd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "den første soriig | ieg fick, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Hand wor borte ÿ VIII Aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "saa kom | , hand igien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "Saa badtt hand danske | drotning",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "føre siig bruden hiem, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Tack haffue danske drotning",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "och hund | wor miig saa guodtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "saa førde hun | mig wthj hans gaardtt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "saa wor hun | mig for moder |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Vi vor samen i femthen winther,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "effther | begiis woris, gode wilig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "den leffuer icke | ÿ werden tiill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "osz hørde itt ordtt at-skilj |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Vÿ ginge i wor søøng, om natt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "Epther begis | wore guode wiilj,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "wi wognitt icke føre aff | første søffnn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "før luen giick offuer | de thelle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 10,
      "text": ":: Fru Elllin | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "Hand klapitt barnitt wiid huiden kind |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "ÿ wogen szom thett laae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "mitt hoff er tiill | din moder-broder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 11,
      "text": "han skiiller osz | icke att saa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "Hør ÿ thett min kiere moder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "oc siiger i osz | thett saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 12,
      "text": "huad da heder den riider |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 12,
      "text": "der oss tog faderen fraa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "Dett tha wiill ieg giøre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "ieg giør thett | liige-saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 13,
      "text": "dett wor etherss eniste moder-broder | ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 13,
      "text": "ther ether tog faderen fraa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "Dette wor icke vor morbroder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "wÿ ville | hanum morbroder kalle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 14,
      "text": "men hand haffuer | tagin oss faderen fraa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 14,
      "text": "oc woltt osz | sorgen mett alle, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "Suarede thett knud-lille Elline-søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "hand | suaritt for thenum alle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 15,
      "text": "alt skulle wÿ heffne | wor faders dødtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 15,
      "text": "før sollin skinner offuer | thj halle, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "Hør i thett min kiere sønner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "ÿ-huad ieg | ether beder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 16,
      "text": "maa ieg meett ether Riide, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 16,
      "text": "ÿ-naar ÿ riider diidtt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "Aff gaarden da red de fempthen ridder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "Mand | mandtt maa them well riider kalle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 17,
      "text": "Epther | redtt stoltenn fru Elliniger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 17,
      "text": "wor moder | att thenum alle, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "Dett wor herre Peder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "Oc sier hand wd saa | wiide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 18,
      "text": "hiiszet seer ieg min Søstere-sønner |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 18,
      "text": "och fempten riider Riide. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "Dett wor herre peder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "hann tog sin høstru i | arm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 19,
      "text": "kender mig nu nogen guode raadt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 19,
      "text": "vthj wor-herris hans naffn, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "Tager ÿ nu woris daniszuenne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "som riider | haffuer ethers heste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 20,
      "text": "søger ÿ nu wor stenstuffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 20,
      "text": "emeden osz threnger miest |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "Tager i nu ethers danniszuenne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 21,
      "text": "som editt | haffuer eders brødtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 21,
      "text": "søger ÿ nu wor | stenstuffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 21,
      "text": "emeden oss threnger aff | nødtt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 22,
      "text": "Vd giick stoltte fru mettelille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 22,
      "text": "herre gud | løsze wiill hindiis wonnde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 22,
      "text": "XII aff hindiis | døther for hinde gick,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 22,
      "text": "den threttinde haffde | hun ÿ handtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 22,
      "text": ":: Fru Eline, hun K. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 23,
      "text": "Meltte thett stolte fru mette-lille",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 23,
      "text": "ther hun de | børnne saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 23,
      "text": "thett motte were sielle-wonnde, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 23,
      "text": "att tage ether fader fra, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 24,
      "text": "Suarede knud-lille Elline-Sønn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 24,
      "text": "och suartt | hand thasaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 24,
      "text": "saa stor tha wor then sielle-waade | ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 24,
      "text": "att tage oss faderen fraa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 25,
      "text": "Wÿ wore boede flere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 25,
      "text": "vor och saa smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 25,
      "text": "thett | wor saa stuor Sielle-wode",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 25,
      "text": "att tage osz | faderen fraa, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 26,
      "text": "Dett sagde knud-lille Ellins-søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 26,
      "text": "handt | wor ÿ huffuen saa wredtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 26,
      "text": "Altt pleÿ-de hosbonden Gieste att suare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 26,
      "text": "och saa wor Riider-Seedtt | |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 27,
      "text": "Dett huide sølff thett Røde guld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 27,
      "text": "thett biuder hand | ether tiill bodtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 27,
      "text": "mett huer then frende ther | wy haffuer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 27,
      "text": "hand faller Ether gier-ne till | fodtt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 28,
      "text": "Dett wor herre Peder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 28,
      "text": "hand wd giennem | winduit seer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 28,
      "text": "høre ÿ thett mine kiere søster-Sønner | ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 28,
      "text": "ÿ-huad ieg Ether beder |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 29,
      "text": "Hør ÿ thett mine kiere søster-sønner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 29,
      "text": "ihuad | ieg ether beder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 29,
      "text": "ÿ wiille mig huercken hugg | eller slaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 29,
      "text": "then stund ieg thaller mett ether |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 30,
      "text": "Dett Suarede Knud-lille Ellinis-sønn, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 30,
      "text": "hand wor saa wredtt ÿ huffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 30,
      "text": "thett wiille | ÿ icke wor fader loffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 30,
      "text": "thett Anngerer osz | Endnu |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 30,
      "text": "32. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 31,
      "text": "Suarede thett stoltte Fru Elline",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 31,
      "text": "henndis | sønner liide hinde saa well,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 31,
      "text": "som mendtt | ved mine kiere sønner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 31,
      "text": "hand giorde for | ethers faders siell saa well |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 32,
      "text": "Hand søgtte siig tiill Ronne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 32,
      "text": "paa sinne | modiige beenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 32,
      "text": "hand haffuer bode bygtt | kiercke Oc kloster",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 32,
      "text": "aff thenn Malmerstin |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 33,
      "text": "Suarede thett knud-lille Ellinis-søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 33,
      "text": "oc | suaritt hand dog saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 33,
      "text": "icke weÿer ieg min | morbroder i dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 33,
      "text": "for Altt thett guotz ieg | Aaer |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 34,
      "text": "Der wor glede i her Peders gaardtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 34,
      "text": "och | halff mere Gamen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 34,
      "text": "de søskin, de søskinbørn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 34,
      "text": "de ware da komen samen |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 34,
      "text": ":: Men fru Elliniger oc hun kand | Raadenne Siige | ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}