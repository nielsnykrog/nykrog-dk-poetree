  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Dagene, Viser Og Digte",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1905,
    "url": "https://tekstnet.dk/books/larsen-t_dagene/017/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 6,
      "text": "Hør Søwren! A vil stræv' aa faa mi Ærind'forretted:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 6,
      "text": "Vi er lig' i æ Daww kommen av me' wor Piig –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 6,
      "text": "hun haaj gon aa lusked for møj om æ Nætter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 6,
      "text": "ve' Hans Peder Plystrups Kalgaard-Diig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 6,
      "text": "A vild' knusendes 'jar ha stej<button id=note26 type=button class=\"btn btn-outline-secondary btn-sm comment\" data-container=body data-toggle=popover data-template=\"<div class='popover' role='tooltip'><div class='arrow'></div><h3 class='popover-header'></h3><div class='popover-body'></div></div>\" data-placement=auto data-html=true data-content=\" <p> stej = stedt, fæstet.</p> \" data-title=\" Fodnote 26\">F26</button> di Dætter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 6,
      "text": "Vi ka snakk om æ Sager, Kræ-Tammesen! Sæt dæ!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 6,
      "text": "Naa saa er Kræ-Hansens Trine re'st fræ dæ –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 6,
      "text": "ja, a vidst' no nok, te æ Tøs war tyk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 6,
      "text": "men a trow, hun haaj faa't 'ed derned' i æ Bakker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 6,
      "text": "ve' ham den tovvele Skomagerplyk.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 6,
      "text": "Nej gu haaj hun ett. Hun haar sjel bekjend',",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 6,
      "text": "te Hans Peder Plystrups Kaal haar rend'",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 6,
      "text": "aa fjanted me' hind, den rø'skjægge Rakker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "Æ-fø'st vild' hun ett vær' ve'ed, æ sølle Skidt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "men en Daa, lig' far vi sku te' aa ombygg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "æ Staald, saah a te' hind, frank aa frit:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 6,
      "text": "»Enten er du tyk, heller osse haar du Trommsygg!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 6,
      "text": "Hun bløw bleg om æ Nev, aa me' Wand i æ Yww",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 6,
      "text": "swaard hun: »Ja de' hjælper wal ett aa lyww!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 6,
      "text": "De' er osse kywsom, te en ett ka læ vær'",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "aa flanni me' di forbannede Knæjtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 6,
      "text": "for huddn en saa læ'r si Klæjmoler skjær',",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 6,
      "text": "saa ka di sgu find' hwer Stropp aa hwer Hæjtt!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 6,
      "text": "– Naa, væk er hun kommen den triddi September.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Ka a stee di Dætter te' den fø'st November?",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
