  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "BEnade oss euig Gud som haffuer alle helgen naaden ted/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Frelss du oss O Jesu for huilke du bleffst til korssit led",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Lad oss gaa til al godhedz kilde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Lad oss en ren samittighedz øgen stille/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "paa din velde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Lad oss den visdoms drick der faa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Aff huilcken vor hw kan den euige liffs smag forstaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Lad oss ret Christendoms tro beuise/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "met kerlighedz gerninger mod vor nabo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Oc siden met en Christelig affgang/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "komme till dig vor fader fra all tuang Amen",
      "part": false,
      "marginal_notes": []
    }
  ]
}