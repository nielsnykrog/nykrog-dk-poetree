  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "HJelp Gud ath ieg nu kunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "du eddele skabere min/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Prise dig aff hiertens grunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Guddommelig ære din/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Saa gladelige begynde vil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "om dine ord ath siunge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Herre Gud hielp mig der til",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "⁕ Euindelige dine ord bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "som Esaias Prophete/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "i sin Bog monne scriffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "før skulde forgaas all slect/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Hiemmel och alt det Gud haffuer giord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "skulle det end slet forderffuis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Aldrig rygger Gud sit ord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "⁕ Jesus kom hid til Verden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "han vor Gudz ord det baald/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "giorde huer Mand stor velgerning/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "dog bleff han ynckelige saald/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Aff Juda som vor hans egen mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "bleff han forraad til døde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Jesus det menløsse Lam.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "⁕ Da Jesus hadde ædit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "met sine det Paaske Lam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "De skulle hannem ey forgæde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Tog Brødet i sin haand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "æder sagde han mit Legeme det er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "som skal for eder giffuis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "betale for eders Synder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "⁕ Han monne dem ocsaa skencke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "i Vin sit rosen Blod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "hans død der met ath betencke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "at han vor oss saa god/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Huo verdelige æder aff dette Brød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "oc dricker denne skaal/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "aldrig bliffuer han død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "⁕ Jesus tode deris føder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "dog han vaar deris Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "saa skulle i hin anden gøre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "sagde han det er min lære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "At i skulle haffue hinanden kær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "Der paa skal man det kende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "at i mit folck ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "⁕ Christus i vrtegaarden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "da han sin bøn hadde giort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "de komme met Hellebaarder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 6,
      "text": "oc ledde hannem bunden bort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 6,
      "text": "For Dommeren som vaar den tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 6,
      "text": "hudstrugen oc met Torn Kronid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "Bleff saa fordømt til døde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 7,
      "text": "⁕ Høyt paa Kaarssit ophengdis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 7,
      "text": "denne høybaarne Første/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 7,
      "text": "Effter oss hannem saare forlengdis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 7,
      "text": "thi sagde han mig tørster",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 7,
      "text": "Det vaar effter vaar salighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 7,
      "text": "aff Maria vaar fødder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 7,
      "text": "Gudz Søn i euighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 8,
      "text": "⁕ Han bøyede ned sit hoffuet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 8,
      "text": "och saa sin aand opgaff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 8,
      "text": "som Joannes haffuer vidnid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 8,
      "text": "der nest bleff tagen aff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 8,
      "text": "Kaarssit oc bleff i Graffuen lagd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 8,
      "text": "oc Tredie dag opstanden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 8,
      "text": "som han tilforn hadde sagt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 9,
      "text": "⁕ Sine Disciple da lerde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 9,
      "text": "Jesus at forkynde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 9,
      "text": "hans ord omkring all Verden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 9,
      "text": "huo sig vil omuende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 9,
      "text": "Fra Synd/ oc tro oc bliffue døbt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 9,
      "text": "han skal euindelige leffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 9,
      "text": "det haffuer hannem Christus kiøbt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 10,
      "text": "⁕ Lucas han monne scriffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 10,
      "text": "Om Christi Hiemmelfardt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 10,
      "text": "dog vil han hoss oss bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 10,
      "text": "altid som han haffuer sagt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 10,
      "text": "det er alt met sit Guddoms ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 10,
      "text": "Der kand ingen mod stride/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 10,
      "text": "Ey gantske Helffuedis port",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 11,
      "text": "⁕ En trøstere han oss sende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 11,
      "text": "som er den Helligaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 11,
      "text": "sandhed skal han oss kende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 11,
      "text": "oc styrcke oss i modgang/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 11,
      "text": "Den samme ville wi kalde paa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 11,
      "text": "han vil oss ey forlade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 11,
      "text": "men trolige met oss staa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 12,
      "text": "⁕ Lader oss for herskaff bede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 12,
      "text": "Gud Fader inderlige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 12,
      "text": "end dog wi aff dem lide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 12,
      "text": "vold wret oc wfrid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 12,
      "text": "Ath Gud vil giffue dem sin naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 12,
      "text": "haffuer Christi Martyr siungit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 12,
      "text": "der han i Fengsel sad",
      "part": false,
      "marginal_notes": []
    }
  ]
}