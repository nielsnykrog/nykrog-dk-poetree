  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Then man mo kalles vdydeligh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "som then er vthacknemmelich",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "som hanum bode heder oc æræ gør",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Iegh skilde myn broder wedh liff och landh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "iegh slo hanum meth myn eghen handh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Sithen fich iek krone och konganaffn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "danske meræ thil skade en gaffn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "ffor vthen ræth och vthen skyell.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Somme tog iegh theres gotz och fraa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "och somme tha lod ieg hugæ oc slaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Thi gik thet meg ey bedræ i hand,",
      "part": false,
      "marginal_notes": []
    }
  ]
}