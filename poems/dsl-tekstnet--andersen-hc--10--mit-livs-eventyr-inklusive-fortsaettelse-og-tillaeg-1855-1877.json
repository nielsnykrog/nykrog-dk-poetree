  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "– I Somrens Hede lædsked’ dine Pærer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Nu kastes de, som overmodne hen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Ad Aare maaskee Træet Druer bærer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Og qvæger ved sin Frugt os mildt igjen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Derfor lad Mismod ei Dit Hjerte nage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Lad Sorgen ei aftvinge Dig et Ak!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Hvormange troer Du, som Guds Gaver smage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Betænke sin Velgjører vel med Tak?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Vær selv ei utaknemlig mod din Skaber!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Du har modtaget Meget af hans Haand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "For Digteren sig ingen Idræt taber,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Han kan ei døe, thi alt hans Værk er Aand!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Hans trætte Støv er bragt til Gravens Ro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Hans stærke Aand i Kraft end meer ophøiet –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Han stod i denne Verden eensom jo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Og eensom lukked’ han i Døden Øiet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Alene var han; naar da Hjertet led,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Med Melodier Smerten han indlulled’,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "I Toner staaer hans Ungdoms Kjærlighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Den lyder i: »de klare Bølger rulled!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Han sad ved Orglet, og en egen Magt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Da løftede vor Tanke høit fra Jorden;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "En Skat af Sange har han Folket bragt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "I Toner udtalt Aandens Dyb i Norden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Hans Tale var et Væld, saa sundt og rigt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Hans Sjæl var ung; nu har han Himlens Glæde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Ak, død er Weyse! Hvilket Sørgedigt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Har Kraft som disse Ord! og dybt vi græde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "En lille Flugt herfra, kun nogle Dage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Der ligger Danmark, Bøgens, Kornets Land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Som lod en Tycho Brahe fra sig jage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Som eier Thorvaldsen og – Skov og Strand;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "Det Lyren er for Skandinaviens Riger; –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "Der blev jeg født, det danske Sprog er mit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "Der sang jeg tidt for unge danske Piger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "Der svang min Musa sig mod Himlen frit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "Der kom som Gjest tidt i min lille Stue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "Din Victors Sange, »Notre Dame« jeg saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "Hernani, Angelo og »Høstens Svale«;<button id=note13 type=button class=\"btn btn-outline-secondary btn-sm comment\" data-container=body data-toggle=popover data-template=\"<div class='popover' role='tooltip'><div class='arrow'></div><h3 class='popover-header'></h3><div class='popover-body'></div></div>\" data-placement=auto data-html=true data-content=\" <p> feuilles d’automne .</p> \" data-title=\" Fodnote 13\">F13</button>",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "Jeg elsker ham, han er mig stor og kjær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 3,
      "text": "Hans Musa kjender jeg paa Blik og Tale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 3,
      "text": "Hun, som min egen, er mit Hjerte nær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 3,
      "text": "For Dig, hans Viv, hans unge Kjærlighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 3,
      "text": "For Dig jeg lægger Sang-Bouquetten ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 3,
      "text": "Igjennem den og Dig han smukt erfare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 3,
      "text": "At han i Nord vandt mig – og vist en Skare!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 4,
      "text": "Cachez vous quelquefois dans les pages d’un livre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 4,
      "text": "une fleur du matin cueillie aux rameaux verds",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 4,
      "text": "quand vous rouvrez la page après de longs hyvers,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 4,
      "text": "aussi pur qu’au printemps son parfum vous ennyvre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 4,
      "text": "apres les jours bornés qu’ici mon nom doit vivre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 4,
      "text": "qu’un heureux souvenir sorte encore de ces vers!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 4,
      "text": "Paris 3 Mai 1843.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 4,
      "text": "Lamartine.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 5,
      "text": "Ein Lachen und Singen! Es blitzen und gaukeln",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 5,
      "text": "Die Sonnenlichter. Die Wellen schaukeln",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 5,
      "text": "Den lustigen Kahn. Ich saß darinn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 5,
      "text": "Mit lieben Freunden und leichtem Sinn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 6,
      "text": "Der Kahn zerbrach in eitel Trümmer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 6,
      "text": "Die Freunde waren schlechte Schwimmer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 6,
      "text": "Sie gingen unter im Vaterland;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 6,
      "text": "Mich warf der Sturm an den Seinestrand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 7,
      "text": "Ich hab’ ein neues Schiff bestiegen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "Mit neuen Genossen; es wogen und wiegen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 7,
      "text": "Die fremden Fluthen mich hin und her –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 7,
      "text": "Wie fern die Heimath! Mein Herz wie schwer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 8,
      "text": "Und das ist wieder ein Singen und Lachen –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 8,
      "text": "Es pfeift der Wind, die Planken krachen –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 8,
      "text": "Am Himmel erlischt der letzte Stern –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 8,
      "text": "Mein Herz wie schwer! die Heimath wie fern!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 9,
      "text": "Du bist gewiß die Storche nachgegangen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 9,
      "text": "Daß Du sie liebst, ich wußt’es lange schon.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 9,
      "text": "Sie schwirrten auf, sie sind davon geflogen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 9,
      "text": "Auf und davon – das ist ein lust’ger Ton!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 9,
      "text": "Du sahst empor: die weißen Federn wallten;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 9,
      "text": "Sie blitzten flockig in der Sonne Strahl;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 9,
      "text": "Da stand es fest! »Was laß ich hier mich halten?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 9,
      "text": "Fort in den Süden wiederum einmal!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 10,
      "text": "»Was ist des Deutschen Vaterland!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 11,
      "text": "Drum mein Lenz sollst Du nicht schweigen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 11,
      "text": "Klinge, Mai, mit Freudenschall!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 11,
      "text": "Klingt mit Pfeifen, Flöten, Geigen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 11,
      "text": "Kukuk, Lerch und Nachtigall!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 11,
      "text": "Deutschlands Frühling, er wird kommen!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 11,
      "text": "Für die Wälschen klingt Schaßab!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 11,
      "text": "Allen Guten, Tapfern, Frommen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 11,
      "text": "Leg’ ich diesem Wunsch auf’s Grab.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
