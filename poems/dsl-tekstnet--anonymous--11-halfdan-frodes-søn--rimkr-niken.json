  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Ondh atthro tijl werdens macth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Tha Frode myn fader wor laffd i iordh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "ieg tha bedreff so leth eth mordh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Ieg slo ihiel myne brødre thoo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "at ieg skullæ enæ rygeth ffoo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "them giorde ieg skade oc stort aaræth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Ieg døde paa straa oc ey i strijdh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "tha ieg fick leffueth myn alders tijdh.",
      "part": false,
      "marginal_notes": []
    }
  ]
}