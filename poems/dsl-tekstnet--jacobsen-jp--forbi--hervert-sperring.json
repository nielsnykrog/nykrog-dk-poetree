  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Saa var da Livet jeg har levet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "En tom og ussel Taagedrøm;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Thi hun kun med mig Spot har drevet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Hun, Asali, saa god og øm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Jeg har da elsket som i Drømmen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "En Skygge, der ej elsked' mig; -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Og nu forsvinder du i Strømmen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Nu, da jeg skulde favne dig.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
