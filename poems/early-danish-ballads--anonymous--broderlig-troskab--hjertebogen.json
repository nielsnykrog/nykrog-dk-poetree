{
  "id": null,
  "title": "Broderlig Troskab",
  "year_created": [
    1553,
    1555
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Hjertebogen",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1555,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/HJB63.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Thett war unge herre Karll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hand skulle aff lannitt fare;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "hand fyck her Tordt, sin broder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "sin feste-møø adt for-uare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: Sin iumfru forglemmer hand aldrigh. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "\"Hør du, her Tordtt, kyer broder myn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "yeg tror teg aller-best:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "yeg befaler tiig myn kiere feste-mø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "hund ær mig aller-kyerist.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Vyltu hynne wochte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "och wylthu hynne giemmhe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "y-meden yeg farer borth up aff land?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "yeg kommer well snarth hiem y-gienn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "\"Saa well skall yeg hynder wochte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "saa well skall yeg hynder gømme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "saa hinder skall yngen ander faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "alt for thu kommer hiem sielffuer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Ieg wyll hynder ful-well wochte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "yeg wyll hynder och well fry,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "saa hinder faer yngen anden suen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "alt om mig wynner liffuett.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Thett war unge herre Karll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "hand farer aff lannitt ud;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "epther sad hans festemø",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "mig lengis aff sorrig och huff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Hand hade ycke udaff lannett werit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "foruden end stackitt tiidt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "thett spurre herre Timand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "hand achtett hannum att giøre suig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Thett war herre Tymand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "hand beder sadell heste:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "\"Ieg wyll ride mig up aff lannitt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "her Karls iumfru att geste.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Thett war herre Tymand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "hand kom ther ryden y gard;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "ud star iumfruens fader,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "hand war well suobt y maer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "\"Her stander y, herre Peder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "y ær end mand saa fyn;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "y gyffuer mygh lyden Kyerstin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "tiill kyere hustru myn!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "\"Thett yeg gyffuer etther myn datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "daa maa y hinde ycke haffue;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "ieg haffuer giffuett hinde hin unge her Karll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "hand ær aff landen dragen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Ieg haffuer gyffueth hynde hin unge her Karll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "hand ær aff landen dragen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "thett ieg hannum myn datter gaff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "thett anger mig alle myn dage.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "\"Saa well kyender yegh hynd unge her Karll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "yeg wyll hannum aldrig foruige;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "gyffuer y meg etther kiere datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 12,
      "text": "om yeg maa were hynnes lige!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "Frem gyck herre Peder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "handh war end mand saa brad:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "gaff hand bort sin datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 13,
      "text": "spurde hind ycke tiill radth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Ind kom hynnes moder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "och saude hynne thysse ordt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "\"Thin fader haffuer teg her Tymand gyffuit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 14,
      "text": "hand ær saa riger end rydder.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "Thett suarith lyden Kierstin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "met angest och sorrig-fuld hoff:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "\"Huad skall yeg herre Karll suarde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 15,
      "text": "som yeg haffuer giffuit myn tro?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "\"Her Karll hand ær aff lannit ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "du seer hannum aldrig mere:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "herre Tymand haffuer bode slott och feste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 16,
      "text": "hand kand deg holle mett ere.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "\"Ieg achter ycke om herre Tymand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "eller hans møgen riige;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "myn fader gaff migh hind unger her Karll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 17,
      "text": "yeg wyll hannum aldrig suighe.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "Lyden Kierstin kunde huercken ede heller drycke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "saa mange-full er hyndes quide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "før hun feck ett lønlig bud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 18,
      "text": "her Tord de tyden att sye.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "Thett war lyden Kyerstin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "hund sender her Tordt saa budh:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "\"Myn fader haffuer mygh herre Tymand gyffueth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 19,
      "text": "thett ær mig sare y-modth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "Thu beder her Tord, hand tencker ther-paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "huad hand loffuit sin broder:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "om hand kand fynne raad och lempe ther-tiill",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 20,
      "text": "och skylle meg wed thend wonde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 21,
      "text": "Thett suaritt unge her Tord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "ther hand thy tiden fyck:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 21,
      "text": "\"Wyll thett Gud, yeg leffue maa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 21,
      "text": "hand skal hind aldrig faa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 22,
      "text": "Bed hynder æde och drycke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 22,
      "text": "och were udi hiarthett fry;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 22,
      "text": "ieg skall hynd wedt then angist skylle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 22,
      "text": "alth om mig winder liffuit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 23,
      "text": "Kommer yeg ycke om løffuerdagen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 23,
      "text": "tha yeg er møgit siig;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 23,
      "text": "daa skall yeg kommhe om søndagh afften,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 23,
      "text": "att føre hannum brudenn hiem!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 24,
      "text": "Rede dy tyll thett brøllup",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 24,
      "text": "y fulle dage IX;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 24,
      "text": "alt sadh bruden sorrig-fuld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 24,
      "text": "y alle samen dy.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 25,
      "text": "Alle daa sad thy brøllups-folck",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 25,
      "text": "saa glade offuer bordt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 25,
      "text": "thett war unge her Tord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 25,
      "text": "kom y den brøllups-gardth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 26,
      "text": "Slagen bleff herre Tymandh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 26,
      "text": "thett war end ynckelig ferd;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 26,
      "text": "fangen bleff unge herre Tordt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 26,
      "text": "thett hagde hand weritt u-werth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 27,
      "text": "Toge thy herre Tymandtz lig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 27,
      "text": "och lagde thy thett paa bør;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 27,
      "text": "tog thy unge herre Tordt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 27,
      "text": "sette hannum y harde iern.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 28,
      "text": "Bruden hun sidder paa bruden-benck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 28,
      "text": "hun greder aff stor nødt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 28,
      "text": "hun gred mere, for herre Tordh war fangen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 28,
      "text": "end for her Timands død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 29,
      "text": "Thett melte brudens moder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 29,
      "text": "mett angest och møgen meen:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 29,
      "text": "\"Spenner wy heste for karme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 29,
      "text": "mett sorrig saa faar wy hiem!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 30,
      "text": "Thett suartt brugomens moder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 30,
      "text": "y raaden war hun ycke seen:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 30,
      "text": "\"End har yeg end annen søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 30,
      "text": "then gyffuer wy bruden y-gien!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 31,
      "text": "\"I-gardtt war yeg end unge brudtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 31,
      "text": "y-dag end sorrig-fuld encke;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 31,
      "text": "yeg wyll ycke saa y aruff gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 31,
      "text": "y tør thett aldrig tencke!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 32,
      "text": "Thett suarde hynnis fader,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 32,
      "text": "hand war end mand saa hard:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 32,
      "text": "\"Thett skall ycke alt sammel gaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 32,
      "text": "epther thin egen raad!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 33,
      "text": "Frem gyck herre Lawe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 33,
      "text": "war kled y skarlagen sma:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 33,
      "text": "\"Her Peder, giffuer mig eders datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 33,
      "text": "men myn broder ycke loffue maa!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 34,
      "text": "Frem gyck herre Peder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 34,
      "text": "hand war en mand saa braadh;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 34,
      "text": "hand gaff hans dotter then andens broder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 34,
      "text": "for-uden hyndes egen raadt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 35,
      "text": "Thett war liden Kierstin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 35,
      "text": "hund wryder syn huiden hand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 35,
      "text": "\"Thed were Wor-herre for-kierth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 35,
      "text": "her Karll skulle fare aff landh!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 36,
      "text": "Fangen er unge her Tordt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 36,
      "text": "her Karll er udaff landt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 36,
      "text": "nu wed yegh then ycke y werden tiill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 36,
      "text": "och ther meg hielpe kand!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 37,
      "text": "\"I spenner nu heste for karme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 37,
      "text": "y lader oss fare hiem!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 37,
      "text": "leffuer wy tiill manitz-modt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 37,
      "text": "wy kommer saa glade y-gien.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 38,
      "text": "Thett melte lyden Kierstin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 38,
      "text": "der hund aff garden redt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 38,
      "text": "\"Gyffue Gud-fader y hymmerigh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 38,
      "text": "ieg kommer her aller mere!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 39,
      "text": "Stalt Mettelil mett hynnes skøne iomfruer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 39,
      "text": "thy sidder meth sylcke och guld;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 39,
      "text": "liden Kierstin hund ganger bode udh och ynd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 39,
      "text": "hindis hierte er sorrig-fuld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 40,
      "text": "Thett war stalte fru Mettelil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 40,
      "text": "hund taler tiill datter sin:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 40,
      "text": "\"Hør du, liden Kierstin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 40,
      "text": "huy falmer kynder din?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 41,
      "text": "Hør du, myn kyer datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 41,
      "text": "du lad borth-fare thin quide:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 41,
      "text": "her Laffue er then rigeste suend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 41,
      "text": "hand ær y thette rige.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 42,
      "text": "\"Ieg achter ycke om herre Laffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 42,
      "text": "eller om hans møgle rige;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 42,
      "text": "myn fader gaff migh hin unghe her Karll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 42,
      "text": "yeg wyll hannum aldrig suige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 43,
      "text": "Well maa y mygh førre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 43,
      "text": "och tiill her Laffue hiem:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 43,
      "text": "aldrig skall yeg leuendis kommhe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 43,
      "text": "udi hans brude-seng!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 44,
      "text": "\"Du thy quer, myn kyer datther,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 44,
      "text": "och sye thu ycke saa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 44,
      "text": "alt skallt thu met her Laffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 44,
      "text": "were bode glad och fro.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 45,
      "text": "Suaritt thett lyden Kyerstin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 45,
      "text": "hun war ycke møgit glad:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 45,
      "text": "\"Giff thett Gud-fader y hymmerig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 45,
      "text": "yegh leffuer ycke monitz-dagh!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 46,
      "text": "Thett war ycke ther-epther",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 46,
      "text": "dage for-uden fem:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 46,
      "text": "dam kam unge herre Karll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 46,
      "text": "seileth tiill wannet hiem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 46,
      "text": "Thett war ungenn her Karll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 46,
      "text": "kom y sinn moders gaardt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 46,
      "text": "thett war hanns kiere moder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 46,
      "text": "hun gaar hannom ud emodh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 47,
      "text": "\"Adtt saa skulle yeg spørre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 47,
      "text": "och och yeg wed ycke huilcketh førsth:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 47,
      "text": "ær min broder fangen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 47,
      "text": "och ær myn iomfru fest?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 48,
      "text": "\"Tyden skulle yeg teg syge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 48,
      "text": "thett giorde yegh ycke giernnhe:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 48,
      "text": "thin festemøø hund er encke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 48,
      "text": "thin broder ligger fangen udy yernn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 49,
      "text": "\"Er myn festemø encke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 49,
      "text": "daa staar hund tiill att faa;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 49,
      "text": "ær myn broder fangen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 49,
      "text": "ther-tiill staar mange god raad!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 50,
      "text": "\"Hør thu thett, myn kyere søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 50,
      "text": "yeg syer tegh halmere meen:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 50,
      "text": "thett ær hind unge her Laffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 50,
      "text": "hand feste thin iomfru y-gien.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 51,
      "text": "\"Haffuer her Laffue myn iomfru fest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 51,
      "text": "for hand wyll giøre myg harm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 51,
      "text": "aller skall hand leffue then dagh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 51,
      "text": "att hand skall soffue y hynnis arm!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 52,
      "text": "\"Hør thu thett, myn kyere søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 52,
      "text": "thu lad ycke lenger for-lenge:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 52,
      "text": "gyff thu liden Kierstin bud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 52,
      "text": "thett thu erst komen tiill lande!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 53,
      "text": "Thu gyff lyden Kierstin bud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 53,
      "text": "hund bær bode sorrigh och meenn;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 53,
      "text": "saa glad bliffuer hund aff hierthett,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 53,
      "text": "attu est kommhen hiem.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 54,
      "text": "Her Karll hand sende sin iomfru budh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 54,
      "text": "bad hynne huercken sørre eller quide:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 54,
      "text": "\"Yeg skall syell tiill brølluph kommhe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 54,
      "text": "alt om mig wynner lyffuett!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 55,
      "text": "Thett suaritt lyden Kyerstin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 55,
      "text": "ther hund thy tyden fraa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 55,
      "text": "\"Raade Gud-fader y hymmerigh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 55,
      "text": "huad ende legen wyll faa!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 56,
      "text": "Rede thy tiill brollup",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 56,
      "text": "y fulle dage IX;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 56,
      "text": "ald sad bruden sorrigh-fuld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 56,
      "text": "udi alle-samen thy.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 233,
      "stanza_id": 57,
      "text": "Førde thy hynd unge brud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 234,
      "stanza_id": 57,
      "text": "alt i her Laffues gaard;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 235,
      "stanza_id": 57,
      "text": "thett huide søll, thett røde guld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 236,
      "stanza_id": 57,
      "text": "ther war ther usparth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 237,
      "stanza_id": 58,
      "text": "Her Karll hand kunde huerken ede eller dricke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 238,
      "stanza_id": 58,
      "text": "ycke søffuer om natten soffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 239,
      "stanza_id": 58,
      "text": "for hand fick løst sin broder aff fange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 240,
      "stanza_id": 58,
      "text": "och wondit then skønne iomfru.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 241,
      "stanza_id": 59,
      "text": "Thett war om end hellygh søndagh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 242,
      "stanza_id": 59,
      "text": "thy preste thy leste och siunge:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 243,
      "stanza_id": 59,
      "text": "borth red unge herre Karll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 244,
      "stanza_id": 59,
      "text": "och tog sin broder aff fange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 245,
      "stanza_id": 60,
      "text": "Thett skeed om then same dagh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 246,
      "stanza_id": 60,
      "text": "før folckith dy gick tiill bords:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 247,
      "stanza_id": 60,
      "text": "thett war unge herre Karll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 248,
      "stanza_id": 60,
      "text": "hand hinte then skønne iumfru.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 249,
      "stanza_id": 61,
      "text": "Slagen bleff herre Laffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 250,
      "stanza_id": 61,
      "text": "alt offuer then breden bordh;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 251,
      "stanza_id": 61,
      "text": "thett daa war then stalte iomfru,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 252,
      "stanza_id": 61,
      "text": "hund fyck saa friit ett mod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 253,
      "stanza_id": 62,
      "text": "Tack haffue unge herre Karll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 254,
      "stanza_id": 62,
      "text": "hand war end rydder saa godt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 255,
      "stanza_id": 62,
      "text": "hinte hand hiem sind festemø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 256,
      "stanza_id": 62,
      "text": "thett war hind ycke y-modt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 257,
      "stanza_id": 63,
      "text": "Tack haffue lyden Kyerstin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 258,
      "stanza_id": 63,
      "text": "hund holt saa well sin tro!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 259,
      "stanza_id": 63,
      "text": "saa haffuer och hind unge her Tordt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 260,
      "stanza_id": 63,
      "text": "hand war hans broder god.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 261,
      "stanza_id": 64,
      "text": "Nu haffuer unge her Karll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 262,
      "stanza_id": 64,
      "text": "for-wunden alt sin harm;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 263,
      "stanza_id": 64,
      "text": "och saa haffuer liden Kierstin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 264,
      "stanza_id": 64,
      "text": "hun soffuer y hans arm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 265,
      "stanza_id": 64,
      "text": ":: Sin iomfru forglemmer hand aldrigh. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}