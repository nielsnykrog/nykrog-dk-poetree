{
  "id": null,
  "title": "Søborg og Adelkind",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA50.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Søborig wor seg saa liden en mord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "saa tiellig tha falt hind moder fraa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": ":: Laad faare bortt angist! ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Hun bleff fød en afftens-maall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "hindis moder wor død, for op rand suoll.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "Till kierke førde dy thett lig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "och efter thett barnn saa rige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "Tthett falt seg saa well y lauff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "droningen kaam til kiercke same dag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "\"Huem er osz thett lidelle kiend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "saa rig er komen y dag til kierken ind?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "\"Thend lidelle kiend hun hieder Siyborig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "saa thiellig haffuer faaitt hiartens sorrig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "I dag møder til kierke thi ligge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "thi er denom saa rige.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "Saa sorrig-fuld suarid thi fruer:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "\"Siøborig haffuer nu miiest fader och moder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "Tthi er nu alle døde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "som hinder skulde buode klede och føede.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "Tthett melte droningen vnder skiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "\"Daa giffuer y meg thett lidelle kiend!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 10,
      "text": "Fostermoder gaff hinder att dy,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "och droningen lerde hind selleff at siy.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 11,
      "text": "Hun luod hind foster y wienter ny:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "hun bleff den alluenste, nogen mand wild siee.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 12,
      "text": "Op wogsitt Siøborig saa wen en mord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "hindis lige war icke y droningens gaard.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 13,
      "text": "Droningen gaar sieg til burre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "hun lerrer Siøborig saa prude.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 14,
      "text": "\"Kom hid, Siøborig, och sied huosz meg!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "saa wel med erre da lerrer ieg deg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 15,
      "text": "Tthu wogtte theg well for munde-glaam!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "saa giør du ochsaa for drocken mand!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 16,
      "text": "Du wogte deg well for natte-gang!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "du giør icke afftens-støffue for lang!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 17,
      "text": "Wogtte deg och for her Adell-kiend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "ind-dog hand er kerre søne myn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 18,
      "text": "Allt om hand ien natt huosz theg suoffuer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 18,
      "text": "men siden hand deg rett aldrig troloffuer.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 19,
      "text": "Tthett suaredtt Siøborig hynd snylde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 19,
      "text": "\"Y lerer meg alt for silde!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 20,
      "text": "\"Sttatt op, Syøborig, och kled thu theg!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 20,
      "text": "y dag skalt thu til kierke med meg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 21,
      "text": "\"I drager til kiercke, beeder gatt for meg!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 21,
      "text": "en anden søndaag well ieg bede for eder.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 22,
      "text": "Syøborig gaar seg y stien-stoffuen ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 22,
      "text": "hun føder en sønn buode høffske och fyenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 23,
      "text": "Hun føde en søn buod fuorr och huid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 23,
      "text": "her Aadelkiend er hand saa ligg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 24,
      "text": "\"Chrest giffue, ieg haffde nu saa fuld en thro wen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 24,
      "text": "mit buod wilde berre for her Adellkiend!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 25,
      "text": "Tthett suaridtt thend falske tarne:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 25,
      "text": "\"Ieg berer eders buod saa gernne.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 26,
      "text": "\"Ttha bed hanom giøre thett for erre syn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 26,
      "text": "giffue meg att dreke vd-aff syn wynn!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 27,
      "text": "Bortt gick den taarne, klaper paa døren med skiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 27,
      "text": "\"Staar op, her Aadel-kiend, lader meg ind!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 28,
      "text": "Her seder y, her Adell-kiend, offuer eders buord!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 28,
      "text": "Siøborig, eders kerist, haffuer send eder ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 29,
      "text": "Hun legger seg y stien-stoffuen ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 29,
      "text": "hun haffuer en datter buod suortt och liee.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 30,
      "text": "Hun haffuer en datter buode suortt och liee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 30,
      "text": "wor hunde-dreng er hun saa lig.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 31,
      "text": "Tthett suared her Aadell-kiend med tuogt och ere:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 31,
      "text": "\"Thett barnn well ieg rett aldrig for-suere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 32,
      "text": "Men y desz suorter myn datter hun er,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 32,
      "text": "desz myere røde guld skall hun berre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 33,
      "text": "\"Hun bad, y skulde gørett for eders dyd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 33,
      "text": "gyffue hinder att drecke vd-aff eders wynn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 34,
      "text": "Her Aadell-kiend gaar seeg til tønde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 34,
      "text": "thett klarre wyn luod hand vdrende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 35,
      "text": "\"Tthu bedd hinder leg aff dy dyner saa graa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 35,
      "text": "hun maa wel soffue paa bolster blaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 36,
      "text": "Tthu bed hinder drecke aff winet saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 36,
      "text": "thett ald hindis sorig skal seg forgaa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 37,
      "text": "Ieg well selleff snartt hend till hinder ride,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 37,
      "text": "syden skall hun aldrig sørig ell quide.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 38,
      "text": "Tthend tarnne hun war saa suigefuld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 38,
      "text": "thett klaarre wyn saa drak hun vd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 39,
      "text": "Hun thog igen thett wand saa kold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 39,
      "text": "hun bar thett i lofft for Siøborig saa bold.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 40,
      "text": "\"Her haffuer y ett hornn med wand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 40,
      "text": "her Adellkiend eder aldrig beder annd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 41,
      "text": "Hand badd, y skulde wanditt dreke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 41,
      "text": "och ald eders sorig op-wecke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 42,
      "text": "Hand bad eder lig aff dy dyner saa graa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 42,
      "text": "y matte wel soffue y baare straae.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 43,
      "text": "Tthi weste icke anditt, ind thi war iene thuo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 43,
      "text": "her Aadelkiend liude der-paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 44,
      "text": "Her Aadelkiend sluo seg for sitt brøst:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 44,
      "text": "\"Thu leg nu, hiarthett, thu thenke well thørst!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 45,
      "text": "Droningen kaam fraa aafftens-sang:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 45,
      "text": "saa stercke thidenn kaam hinder ygenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 46,
      "text": "Droningen suøber seg hoffuet y skiend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 46,
      "text": "hun gaar i burre for Siøborig ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 47,
      "text": "Droningen ind aff døren thrend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 47,
      "text": "Siøborig hun blegner y huiden kiend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 48,
      "text": "Droningen klaper hinder wed huiden kind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 48,
      "text": "\"Thu sørge icke, Søborig, dater myn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 49,
      "text": "Syg meg, Siøborig, vnder huiden linn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 49,
      "text": "huem er fader at søne dynn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 50,
      "text": "Tthett suarid Syøborig med sorigfuld sinde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 50,
      "text": "\"Thett er hind vnge her Aadelkiend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 51,
      "text": "Gud nade,\" sagde Siøborig vnder ø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 51,
      "text": "\"thett min fader skulde saa thielig bort fra meg dø!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 52,
      "text": "Haffde ieg hafft fader och moder y lyffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 52,
      "text": "tha haffde meg aldrig thimitt den quide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 53,
      "text": "Nu well ieg sørge meg selleff til døde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 53,
      "text": "Chrest segne mynn søn fraa sorig och møde!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 54,
      "text": "Droningen klaper hinder wed huiden kiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 54,
      "text": "\"Thu sørge ike, Siøborig, dater miynn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 55,
      "text": "Mynn sønn skall anten egte deg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 55,
      "text": "helder hand skall aldrig haffue moder i meg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 56,
      "text": "Alle thi, meg mone thiene med erhre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 56,
      "text": "thi skal theg alle til thienist werre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 57,
      "text": "Tthett skall alt efter dyn wilig gaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 57,
      "text": "ieg wel deg seleff for moder staae.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 58,
      "text": "Droningenn slar offuer sieg skaarlagen smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 58,
      "text": "til her Adelkiend løste hinder att gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 59,
      "text": "Tther hun kaam till borrige-lied,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 59,
      "text": "her Adelkiend hand stuod der wed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 60,
      "text": "\"Hør du, her Adel-kiend, sønne myn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 60,
      "text": "huj stander du her om natter-thid?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 61,
      "text": "Huy stander du her saa wred y sinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 61,
      "text": "men du ber dragen suerd vnder skarlagen-skiend?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 62,
      "text": "\"Ieg staar her och wagtter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 62,
      "text": "att thiuffue dy skall icke stieelle myn datter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 63,
      "text": "Ind-dog min datter hun er suortt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 63,
      "text": "ieg wilde icke, theuffue skulde stieele hind bortt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 64,
      "text": "\"Tthu thye quer, herr Adellkiend, du sige icke saa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 64,
      "text": "thett er en søn, stalt Søbborig haar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 65,
      "text": "Tthett er en sønn, er høffsk och huid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 65,
      "text": "theg seleff, Adelkiend, er hand saa lig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 66,
      "text": "Hand haffuer kaarsz emelom haarre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 66,
      "text": "en konge saa skall hand wore.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 67,
      "text": "Hans haffuer korsz paa hygere fuod:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 67,
      "text": "alt wor angist thett rader hand buod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 68,
      "text": "Ieg beder theg, herr Adellkiend, søne myn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 68,
      "text": "att du well egtte Søøborig dater myn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 69,
      "text": "Ind-dog hun haffuer icke frender rige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 69,
      "text": "thaa er hun seleff dannis och dydelig.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 70,
      "text": "\"Fuld gierne ieg thett giorde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 70,
      "text": "om ieg for eder, kerr modder, sa thuorde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 71,
      "text": "\"Saa gerne giffuer ieg mit minde ther-till,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 71,
      "text": "thu egtte stalt Siøborig, nar du welt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 72,
      "text": "Tthu egtte Siøborig med heder och erre!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 72,
      "text": "myn kerre søn, thett er min biegierre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 73,
      "text": "Her Adel-kiend sluo offuer seg skaarlagen-skiend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 73,
      "text": "saa fuldis thi buode for Siøborig ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 74,
      "text": "Her Aadellkiend ind aff dørenn thrend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 74,
      "text": "Søborig wendis til wegenn igenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 75,
      "text": "Hand klaper hinder wed huiden kiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 75,
      "text": "\"Hui er i saa wred, alerkereste mynn?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 76,
      "text": "Ieg wed well, thend tharne haffuer forwend myn ord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 76,
      "text": "min hiartens kerre! huy wilde y thett thro!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 77,
      "text": "Tthett feck thend therne alt for hindis ord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 77,
      "text": "saa løffuende daa bliff hun sett y iord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 78,
      "text": "Her Adellkiend thager Siøborig y sin arum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 78,
      "text": "hand gaff hinder guld-kronne och droninge-naffuen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 78,
      "text": ":: Lad fare bort angest! ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}