  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Hjertebogen",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1555,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/HJB82.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Der kom ien Løwe løben-nisz",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "vdaff thenn wyllen skoff |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "then Iomfru lodt seg forfere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "saa | snart flyd hund ther-fraa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "och der | taffte hun sin Mantell huidt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "ther-aff | kom Iamer och quide. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Den Løwe fick sin vnger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "alt paa | den mantel god,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "den Mantell bleff besmi-ttet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "med sued och sorteren muld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "och saa mo-nnhe Løwen aff skouwen gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "att skou-wen mett sin vnger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "daa kom then Greffue-Sønn | |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Och der then Greue mantelen saa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "war stenth mett blodt saa rødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "hand mo-nnhe seg saa ynnerlig klage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "saa stor | war hans kier,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "A we y-men hund er død |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "hund har for myn skildt dødett",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "och lidt | thenn store nødt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "Har hund nu for myn ski-ldtt dødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "och lidet then støre nødt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "daa skall der aldrig flere Iomfruer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "for | myn skild mere død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "hynnes liff will | ieg betale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "alt mett myn egen død, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 4,
      "text": "Crist senne deg Soll och mane",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 4,
      "text": "Cri-st senne deg loff och grasz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Crist senne | deg kongelig krone,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "och altt thet Iorden | ber,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "och saa myn hierte-allerkierist,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "ther | haer for myn skildt dødt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 5,
      "text": "Hand settet hioltedt y-modt yen sten |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 5,
      "text": "och odden y-modt siitt bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 5,
      "text": "hand stack | seg y-hiell, altt paa hans Suerdt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "hand | lagde seg vnner lynnhen saa grønnhe |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "da kom then skønne Iomfru. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 6,
      "text": "Och der den Iomfru tiill kiellen kom |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 6,
      "text": "hund fanth sin kierist war død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 6,
      "text": "hun monne | seg saa ynnerlig kiere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 6,
      "text": "saa stor daa war | hennes møde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 6,
      "text": "A we myn kierist er nu død |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "hand har for myn skild dødet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "och lidt | thenn store nødt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 7,
      "text": "Har hand for myn skild | dødet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 7,
      "text": "och liitt then store nødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 7,
      "text": "hans liff | wyll yeg betale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 7,
      "text": "alt mett myn egenn | død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 7,
      "text": "Att ther skall aldrig flere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 7,
      "text": "for myn | skild mere dødt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 8,
      "text": "Crist senne deg Soll och Mane",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 8,
      "text": "Crist | senne deg loff och gras,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 8,
      "text": "Crist senne degh | kongelig krone,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 8,
      "text": "och altt thett Iorden ber |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 8,
      "text": "och saa myn hierte-alderkierist,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 8,
      "text": "ther yeg | skall nu for død. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 9,
      "text": "Hund sette hiolthet y-mod end sthenn |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 9,
      "text": "och odden y-modt siitt bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 9,
      "text": "hund stack seg | y-hiell, alt paa hans Suerd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 9,
      "text": "hund lade seg | for-ynnhen hans Armhe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 9,
      "text": "thet war stor nød | Iammer och klage. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 10,
      "text": "Thett hade weret bere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 10,
      "text": "den løwe | hade werit vfødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 10,
      "text": "end slig to | hoffueske kong-børnn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 10,
      "text": "end | slig to høuesske konge-born | .",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 10,
      "text": "saa skulle ble-uenn for-ødt. |",
      "part": false,
      "marginal_notes": []
    }
  ]
}