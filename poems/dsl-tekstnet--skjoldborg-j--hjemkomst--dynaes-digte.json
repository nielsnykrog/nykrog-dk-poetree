{
  "id": null,
  "title": "Hjemkomst",
  "year_created": 1915,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Johan Skjoldborg",
    "country": null,
    "wiki": "Q1490327"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Dynæs Digte",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1915,
    "url": "https://tekstnet.dk/books/skjoldborg-j_dynaes-digte/007/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Nu staar jeg her, hvor jeg saa ofte stod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "ved Laven grønne Landingssted,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "hvis Bolværk Hjulsø skvulper mod ...",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Der ligger Dynæs!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Endnu det i mit Hoved tumler,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Ekspres-Spektaklet, Hjul, der rumler",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "evindeligt svabakki — bakki — bakki,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "og jeg har Støv og Lugt af Kul i mine Klæder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "i Sind de døde Pletter, Rejse-Rusten æder ...",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Hvad har jeg med til Hjemmets stille Kyst?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Min Længsel, ak, kun den jeg har,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "kun denne Sugen i mit Bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Dynæs!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Min Baad den ligger klar, og rask ombord jeg springer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "jeg hastig hejser Sejl og Hatten svinger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Min Baad mig bærer over dybe Vande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "som Fuglen af sin Vinge løftes",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "igennem den høje Luft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "hen, bort fra Verdens Larm mod stille Strande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "saa blidt, som Græssets Straa af Vinden vugges",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "i dunkle, urtidsfjærne Drømme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "ved Hjulsøens stille Bred,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "hvor det af Bølgestænk paa Dynæs dugges.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "Naar blev jeg saadan, let og fri for Sorgen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 1,
      "text": "og Døgnets tunge Skygger baaret",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 1,
      "text": "som gennem en hellig Luft?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 1,
      "text": "Det var i Barnetidens skønne Morgen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 1,
      "text": "Min Baad herefter Moders Navn skal bære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 1,
      "text": "fordi du bar mig ved dit Hjærte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 1,
      "text": "og siden i Kærlighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 1,
      "text": "min lille gode, elskte Moder kære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "Du var en lille, stille Kvinde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "med Hvergarnskjole paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 2,
      "text": "og over Haaret Sirtseshuen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 2,
      "text": "saa smukt om Panden laa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 2,
      "text": "I vore to smaa, pæne Stuer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 2,
      "text": "du færdedes omkring;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 2,
      "text": "dit Virke øved du saa stille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 2,
      "text": "som var det ingenting.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 2,
      "text": "Du satte dig om Dagen trolig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 2,
      "text": "til Vindvet hen at sy;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 2,
      "text": "i Kone-Selskab kom du aldrig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 2,
      "text": "og aldrig fjærnt af By.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 2,
      "text": "De mange smaa og store Skibe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 2,
      "text": "du saa bag Fjordens Strand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 2,
      "text": "saa æventyrlig svandt derude",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 2,
      "text": "ved Mors og Himmerland.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 2,
      "text": "De hvide Sejl du langsomt fulgte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 2,
      "text": "med Længslen i dit Bryst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 2,
      "text": "og drømte om en ukendt, herlig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 2,
      "text": "vidunderdejlig Kyst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 2,
      "text": "Naar jeg kom hjem, jeg saa bag Ruden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 2,
      "text": "du sad i Bænkekrog",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 2,
      "text": "saa stille for dig selv og læste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 2,
      "text": "den gamle Salmebog.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 2,
      "text": "Du løfted, kære Mor, dit Øje",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 2,
      "text": "og stirred over Jord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 2,
      "text": "hvor nu omkring i vide Verden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 2,
      "text": "vel dine Sønner for.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 2,
      "text": "Saa folded du, min gode Moder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 2,
      "text": "der hvor du sad i Løn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 2,
      "text": "de knokkeltørre, kære Hænder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 2,
      "text": "og bad saa fast en Bøn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 2,
      "text": "Og dine dybe, rene Øjne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 2,
      "text": "jeg glemmer heller ej.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 2,
      "text": "De siden leded mig og lyste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 2,
      "text": "som Stjærner paa min Vej.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 2,
      "text": "Ak Mor, hvad er vel Sønnens Sange?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 2,
      "text": "Kun Blomster paa din Grav.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 2,
      "text": "Men Kærligheden i mit Hjærte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 2,
      "text": "den blomstrer aldrig af.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 3,
      "text": "Min Far, min frie, stolte Far,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 3,
      "text": "der bar saa højt din Pande",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 3,
      "text": "op over Mængdens jævne Med",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 3,
      "text": "og Tidens stride Vande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 3,
      "text": "fordi du havde i dig selv",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 3,
      "text": "saa fri og glad og høj en Sjæl,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 3,
      "text": "der løfted dig mod Himlen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 3,
      "text": "Du aabnede din Hyttedør",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 3,
      "text": "for —ismer og for —aner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 3,
      "text": "for Præster, Rigsdagsmænd saavel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 3,
      "text": "som Landevejs-Kumpaner;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 3,
      "text": "de var dig alle lige kær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 3,
      "text": "naar ved vort Bord de sad dig nær",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 3,
      "text": "og Skæmt med Alvor skifted.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 3,
      "text": "Da gik din Tale stundom dybt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 3,
      "text": "og var den mørk til Tykke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 3,
      "text": "du hented dog til Lyset op",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 3,
      "text": "saa mangt et ædelt Smykke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 3,
      "text": "og af din rige, lyse Aand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 3,
      "text": "du strøede med saa rund en Haand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 3,
      "text": "dit Guld til alle Sider.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 3,
      "text": "Til Tider var din Tale hvas,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 3,
      "text": "i Hjærtets Flamme hærdet;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 3,
      "text": "da skar den gennem Lavsinds Værk",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 3,
      "text": "saa kæk og uforfærdet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 3,
      "text": "Du en usynlig Krone bar;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 3,
      "text": "man følte straks hos dig, du var",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 3,
      "text": "en Konge i en Hytte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 4,
      "text": "Se, de har Flaget hejst, de ved, jeg kommer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 4,
      "text": "saa festligt vajer det og vinker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 4,
      "text": "højt over Hjemmets Tag ...",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 4,
      "text": "Aa, hvad i Verden er som Dynæs Sommer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 4,
      "text": "Det gamle Æbletræ har lyst sin Krone",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 4,
      "text": "med foraars-skære Blomster smykket,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 4,
      "text": "og oppe fra Kuplens Top",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 4,
      "text": "ud til mig klinger Droslens klare Tone,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 4,
      "text": "mens Baaden over Bølgekamme skrider,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 4,
      "text": "som Buen over spændte Strenge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 4,
      "text": "og Søernes friske Sus",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 4,
      "text": "i Sommertoner stryger Stævnens Sider.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 4,
      "text": "Det ogsaa festligt i mit Hjærte synger;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 4,
      "text": "ti under høje Popler ser jeg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 4,
      "text": "mit lille, mit hvide Hus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 4,
      "text": "hvor Roser tæt sig op ad Muren slynger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 4,
      "text": "De blanke Ruder gennem Løvet smiler",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 4,
      "text": "med Solskinsblink og Velkomsthilsen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 4,
      "text": "og gennem den aabne Dør",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 4,
      "text": "min lille Edith ned mod Broen iler.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 5,
      "text": "Bølgerne nynner ved grønklædte Strand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 5,
      "text": "Her har jeg drømt og har leget i Græsset,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
