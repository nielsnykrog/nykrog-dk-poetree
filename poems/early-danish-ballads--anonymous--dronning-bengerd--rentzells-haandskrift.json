    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/RNZ1A.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Morgens-gaffue hun kraffde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "\"Giffue i mig nu Samsø",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "oc en guldkrune aff huer mø!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Kongen suarede han Berngerd saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "\"Ther er saa mangen fattig mø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "hun kand thet ey for sin død.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "\"Min kiere, lader thet saa være:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "i lader icke fruer skarlagen bære!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "R. Rxt.:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "\"Kand hun thet leste at kiøbe for sig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "fuld-vel skal hun thet slide for mig.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "\"Min kiere herre, lader thet bliffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 4,
      "text": "lader aldri bonde-søn god hest ride!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 5,
      "text": "\"Kand hand den læste at holde for sig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 5,
      "text": "vel skal hand ride den for mig.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "\"Kiere herre, i lader thet saa gaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 6,
      "text": "i lader vor lande i iern slaa!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 7,
      "text": "\"Huor skal ieg thet iern faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 7,
      "text": "ieg skulde vore lande i slaa?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 8,
      "text": "\"Wi ville fare oss til Ribe i aar:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 8,
      "text": "wi ville vel smede til lande faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 9,
      "text": "Huad tør bonden mere ved,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 9,
      "text": "end vendre-dør oc flagre-leed?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 10,
      "text": "Huad skal bonden met mere i bo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 10,
      "text": "end to øxen oc en ko?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 11,
      "text": "Huilcken bonde-kone ther søn faar sig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 11,
      "text": "en øre guld giffuer hun mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 11,
      "text": "en orthe for en daatter.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 12,
      "text": "Then første søffn, kongen fick,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 12,
      "text": "apparuit ei Dagmar droning.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 13,
      "text": "In leding proficiscens, non domi dronning Berngerd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 14,
      "text": "\"Bliffuer Berngerd hiemme i aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 14,
      "text": "tha thveer thet barn vogse ligh.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 15,
      "text": "\"Stat op et vesti te!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "Then første piil, i leding var skudt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 16,
      "text": "hun vor i Berngerds hierte brot.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "Nu ligger Berngerd i sorten iord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 17,
      "text": "endh haffuer bonden baade oxe oc ko.",
      "part": false,
      "marginal_notes": []
    }
  ]
}