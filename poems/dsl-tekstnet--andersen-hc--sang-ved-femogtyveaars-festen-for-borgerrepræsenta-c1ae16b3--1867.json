  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1867,
    "url": "https://tekstnet.dk/books/andersen-hc_sang-ved-femogtyveaars-festen-for-borgerrepraesentant-n-f-bonnesen-og-raadmand-b-petersen-den-24de-februar-1867/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Vor Fødsel og vor Fremtid vi ei vide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "I Verden stilles man som i en Leg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Een vinder Fløiel, Een maa Vadmel slide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Men indenfra faaer man sit Navn, sit Præg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Det deiligt er for den, Gud det vil give,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "At eie Dygtighed og Hjertelag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Sit eget Adels-Brev at kunne skrive,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Forstaaes, erkjendes i det Godes Sag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Hold fast paa Gud, Dig selv og Fædrelandet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Om nok saa tunge Søer rulle frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Da groer Velsignelse, den kan ei andet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Vil Du Exempler, vi kan nævne dem!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Veltalenhed og Hjertelag tag Ordet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Forkynd den Kraft, det Sind, det Hjertelag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "De to, der her fik Hædersplads ved Bordet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Udfoldet har, mens Aaringer hengled.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Saa freidig glad, som Ungersvend i Dandsen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "De stræbte, stred, det Godes Strid de stred;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Om deres Pande snoe sig Borgerkrandsen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "De faae den Guldmynt: sand Taknemlighed!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Igjennem Tanken Mindets Svaner drage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Hver Stræben og hver Gjerning klart der staaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Vort hele varme Hjertes Tak modtage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "I for de femogtyve Hæders-Aar!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
