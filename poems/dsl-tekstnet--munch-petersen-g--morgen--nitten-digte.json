      "text": "tramper mod Havnens Lygte –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Motorers Dunk trækker usynlige Baade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
