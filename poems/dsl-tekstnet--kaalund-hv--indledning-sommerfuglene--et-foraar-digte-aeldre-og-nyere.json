  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "En Sommerfuglesamling er disse mine Sange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "De flagred i mit Indre, dér tog jeg dem tilfange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Jeg vilde dem med Jubel i Verden udsende;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "men ak, da var de døde - jeg kunde dem ej kjende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Dog synes mig nu, da jeg atter dem bringer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "som spiller af min Ungdom et Skjær paa deres Vinger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Sé; derfor har jeg draget dem frem for Lysets Straale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "de blege Falæner, og stukket dem paa Naale.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Ja, stukket dem paa Naale! Og nu vil Verden dømme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "fra disse døde Sange til mine Digterdrømme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Og den vil tro mig fattig, og den vil haanligt tænke:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "\"Er det din hele Rigdom, det Bedste, Du kan skjænke?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Det er jo kun Frostmøl fra din Vaar den forsvundne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "kun Tusmørkesværmere i Dæmringen fundne;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "selv, efter lange Aar, Du atter Dig nærmer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "og er kun hvad Du var - kun en Tusmørkesværmer.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "O nej! o tro det ikke! o vent til de næste!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "De rører sig derinde! der gjemmer jeg de bedste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Som Pupper har jeg baaret dem skjult i mit Hjerte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "som vingeløse Orme, som Tvivl og som Smerte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "De krøb mig ind i Sjælen med Livets Strid og Jammer -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "og hvad jeg led, det véd kun mit ensomme Kammer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "Men af de stille Pupper og af de blege Larver",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "kan blive Sommerfugle med alle Livets Farver.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "Jeg synes, jeg mærker, Forvandlingen er omme;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "jeg venter kun den varmende Solstraales Komme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "Som store Sommerfugle de røre sig derinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "med alle Livets Farver, med Vinger, som skinne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "Maaske skal det mig lykkes engang dem at fange;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "maaske skal ud de flyve som jublende Sange!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
