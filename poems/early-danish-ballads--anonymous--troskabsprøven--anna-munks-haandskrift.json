  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Anna Munks Håndskrift",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1591,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/MUNK26.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Dy ledinngs-menndt dy legir unnder øe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": ":: Der legis villige mynn. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "och dy threttis om saa venn enn møe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Hunn loffuit hannom thro synn. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "\"Thett thør ieg setthe vedt mitt guldt saa rødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "dett liidenn Kierstinn skiøtte icki, herre Urmannd var dødt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "\"Tha thør ieg sethe ved minn huyde hals:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "liidenn Kierstinn var aldrig her Urmannd saa falsk.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "Herre Urmandt hand stodt och lyde der-paa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "\"Altt skall ieg prøffue beges dieris ordt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "Herre Urmanndt klede sig y silckitt rød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "hanndt lagde siig y skibett, som hanndt var dødt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "Thi konngenns mennd styrde dieris sneki thill lanndt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 5,
      "text": "lidenn Kierstinn hunn gannger paa huydenn sanndt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "\"I vere velkommen, y konngenns menndt, och hiem!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "hure haffuer eder liidt y ledinnge och hiem?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "\"Saa vell haffuer oss liidt y ledinnge och hiem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 7,
      "text": "haffde vy icki mist saa finn enn manndt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "Haffde vy icki mist saa finn enn mannd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 8,
      "text": "hinn unnge her Urmanndt saa hiede hanndt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "Altt stod liidenn Kierstinn, hun lyde paa begis dieris ordt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 9,
      "text": "hunn daanidt vell thi gannge neder thill yordt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "\"Ere dett nu sanndenn, her Urmannd er dødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 10,
      "text": "da skall ieg bøge offuer hannom kirckenn saa rødt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "Kierckenn aff graa malmer-stienn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 11,
      "text": "och graffuenn ud-aff dett huide huals-bienn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "Ieg skall lade hanns kiste mett dett huide sølff beslaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 12,
      "text": "och skriue der-paa for-gyldenne bogstauff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "Saa siger de alle, som der rider fram:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 13,
      "text": "hisett liger lidenn Kierstinn hindis festermanndt!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "Op stodt herre Urmanndt, kunnde icky lenger liide denn harum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 14,
      "text": "hanndt thog liidenn Kierstenn vell thusinndt ganng y arum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "Tacke haffue herre Urmanndt, hanndt holthe synn thro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 15,
      "text": "mett ære lodt hanndt sytt brølup bou!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "Tacke saa haffue denn skiønne iomffru,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 16,
      "text": "for hunn var herre Urmanndt buode thro och huldt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "Nu haffuer denn iomffru for-wunden synn harum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 17,
      "text": ":: Der legthis villige mynn. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 17,
      "text": "hun soffuer huer natt y herre Urmandz arum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 17,
      "text": ":: Hunn loffuitt hannom tro synn. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}