  "body": [
    {
      "id": 0,
      "stanza_id": 6,
      "text": "Hielpen jeg dig gierne giver,",
      "part": false,
      "marginal_notes": [
        "Speaker: Svar:"
      ]
    },
    {
      "id": 1,
      "stanza_id": 6,
      "text": "Hav mig kier,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 6,
      "text": "Taalig vær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 6,
      "text": "Til du rodfæst i mig bliver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 6,
      "text": "Da jeg dig forløsning skenker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 6,
      "text": "Før du tænker.",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
