  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Iek tacker them i Iutlandh haffue boedh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "the haffue meg til there koning beroedh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Fæggæ, myn broder, hanum thet fortrødh;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "mith hiartheblod han therfore vtgødh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "oc hade henne siden thil husfrwa sien.",
      "part": false,
      "marginal_notes": []
    }
  ]
}