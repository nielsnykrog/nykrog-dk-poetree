{
  "id": null,
  "title": "Paa Andreas Ludwig Brandt’s og Debora Petronella Brandt’s Sölvbryllup",
  "year_created": 1869,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1869,
    "url": "https://tekstnet.dk/books/andersen-hc_paa-andreas-ludwig-brandts-og-debora-petronella-brandts-soelvbryllup/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Hollænderen og Dansken, Gud dem signe!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "For Dem blev Havet »Vei til Roes og Magt.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "I Daad og Hjerte de hinanden ligne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Og let og snart da sluttes Hjertets Pagt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Hollændere forvandlede til Have",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Den danske Ö Amager, og fra den",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Gav i vor Tid et Hjerte Hjerte-Gave,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Og Holland gav en Hjerte-Skat igjen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "I mindes Dagen! – Tid er gaaet siden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Med Alvors Uger og med glade Aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "De fem og tyve Vingeslag af Tiden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Der flyver frem mod Evighedens Vaar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "I holdt hinanden fast i begge Hænder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "I Kjerlighed i Prövelse og Troe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Vorherre altid da sit Solskin sender,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Og Minderne heelt ind i Himlen groe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "De lyse frem i Dag i Alvors Tanker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Sölvbryllups Dag har Mindernes Musik.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Löft Dig vor Sang! saa festligt Hjertet banker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Og jubler Skaalen efter gammel Skik;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Hil Brud og Brudgom! hil de altid Unge!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "I Kjerlighed er Hjertet ungt hver Dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Om fem og tyve Aar Guldbryllup runge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "I Hurra under dansk og hollandsk Flag.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
