  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Englen indgangen til Jomfru Marie/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "sagde Helsel fuld met Naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Herren met dig du est benedide/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "blant quinder i mange maade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Elizabeth sagde oc met tuct/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Velsignet er din Liffsens fruct/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Det tro wi allesammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Den Marie flyde naade/ frelste oss aff vaade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Jesus Christus Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Adam oc Eua der de bleffue skabte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Effter Guds egit Billede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Aff Dieffuelens had bleffue de fortabte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Der de hans løgn beuilgede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Gud truede Slangen dem til glæde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Oc sagde quindens sæd skulde hans hoffuit træde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Det tro wi oc allesammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Den Adam flyde naade/ frelste oss aff vaade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Jesus Christus/ Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Cain oc Abel giorde Gud skæl paa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Der hand Cain fordømte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Men Abels Offer hand gierne tilsaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "For hand vaar vden skrømpte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Cains vantro Manddemord bedreff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Men Abels Tro til salighed bleff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Det tro wi oc allesammen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Den Abel flyde naade/ frelste oss aff vaade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Jesus Christus/ Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Enoch siuende mand effter Adam kom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Predickede denne Tro/ oc spaade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Om Guds vrede oc strenge dom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Thi lidde hand spot oc vaade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Men Gud gemde hannem met krop oc skind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "Oc loed saa Verden fare blind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "Det tro wi oc allesammen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "Den Enoch flyde naade/ frelste oss aff vaade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "Jesus Christus/ Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "Noe predickede i hundrede Aar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "Der folck bleffue flere oc verre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "Alle troløse oc Kødelige vaare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "Huer vaar sin egen herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "Thi plaffuede dem Gud met vandflod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "Vden Arcken vand offuer Verden stod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "Det tro wi oc allesammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "Den Noe flyde naade/ frelste oss aff vaade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "Jesus Christus/ Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "Loth gode mand i Sodoma/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "J troen lidde hand stor drøffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "Ti Guds venner kunde mand ey faa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 5,
      "text": "Der Gud vilde dennem prøffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 5,
      "text": "Met Jld plaffuede Gud de wfromme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 5,
      "text": "Loth met sine Døtter lod hand vndkomme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 5,
      "text": "Det tro wi oc allesammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 5,
      "text": "Den Loth flyde naade/ frelste oss aff vaade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 5,
      "text": "Jesus Christus/ Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "Abraham bleff oc en Guds mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "For hand Guds løffte trode/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 6,
      "text": "At aff hans Sæd skulde fødis hand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 6,
      "text": "J huilcken Gud salighed loffuede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 6,
      "text": "Der i fulde hannem oc Jsaac/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 6,
      "text": "Oc Jacob trode den samme snack.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 6,
      "text": "Det tro wi oc allesammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 6,
      "text": "Den dem flyde naade/ frelste oss aff vaade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 6,
      "text": "Jesus Christus/ Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "Joseph den yngste blant Jacobs børn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 7,
      "text": "Bleff alle de andris herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 7,
      "text": "Der de sluppe hannem for Vgle oc Ørn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 7,
      "text": "Hans lycke bleff ey diss verre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 7,
      "text": "Aff dem komme alle Jsraels folck/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 7,
      "text": "Moses oc Aaron bleffue deris Tolck.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 7,
      "text": "Det tro wi oc allesammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 7,
      "text": "Den dem flyde naade/ frelste oss aff vaade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 7,
      "text": "Jesus Christus/ Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 8,
      "text": "Kong Pharao lod Gud beplaffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 8,
      "text": "Oc fride sit folck aff fengsel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 8,
      "text": "Der de vilde fremmede Guder haffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 8,
      "text": "Da giorde hand dem oc trengsel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 8,
      "text": "At de skulde ey i Canaan bo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 8,
      "text": "Vden Josue oc Caleb ene to.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 8,
      "text": "Det tro wi oc allesammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 8,
      "text": "Den dem flyde naade/ frelste oss aff vaade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 8,
      "text": "Jesus Christus/ Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 9,
      "text": "Paa Sinai bierg lod Gud dem giffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 9,
      "text": "Sine hellige ti budorde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 9,
      "text": "At de skulde i gode gierninger bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 9,
      "text": "Oc kiende huad Synder de giorde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 9,
      "text": "Dog kunde dem ingen holde foruist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 9,
      "text": "Vden de der trode paa Jesum Christ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 9,
      "text": "Det tro wi oc allesammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 9,
      "text": "Den dem flyde naade/ frelste oss aff vaade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 9,
      "text": "Jesus Christus/ Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 10,
      "text": "At de skulde sig ey selffuer leffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 10,
      "text": "Gaff Gud dem Dommere oc Konger/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 10,
      "text": "Der til Propheter som Guds ord screffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 10,
      "text": "Oc truede met plaffue oc hunger/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 10,
      "text": "Der effter vdlagde Guds hellige bud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 10,
      "text": "Oc spaade om Christo mand oc Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 10,
      "text": "Det tro wi oc allesammen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 10,
      "text": "Den dem flyde naade/ frelste oss aff vaade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 10,
      "text": "Jesus Christus/ Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 11,
      "text": "Dauid oc andre ihuad de hede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 11,
      "text": "Som Scrifften oss forkynder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 11,
      "text": "Huad kunde wi andet om dem vdlede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 11,
      "text": "End at de vaare Syndere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 11,
      "text": "Men at de komme aff Synd oc nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 11,
      "text": "Det skede for Christi pine oc død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 11,
      "text": "Det tro wi oc allesammen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 11,
      "text": "Den dem flyde naade/ frelste oss aff vaade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 11,
      "text": "Jesus Christus/ Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 12,
      "text": "Alt det gamle Testamente/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 12,
      "text": "Visde oss Christ som skulde komme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 12,
      "text": "Den Gud haffuer nu til Verden send/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 12,
      "text": "Oss alle til glæde oc fromme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 12,
      "text": "Saa er det gamle bleffuit det ny/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 12,
      "text": "Der predickis i Land baade egn oc By/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 12,
      "text": "Dess loffue wi Gud allesammen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 12,
      "text": "Emanuel/ som Gabriel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 12,
      "text": "Bebudet Marie/ Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 13,
      "text": "Wi bede vor Fader den Himmelske Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 13,
      "text": "Om Siels oc Liffs nødtørffte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 13,
      "text": "At wi kunde fire hans Ord oc Bud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 13,
      "text": "Oc styres til dyd aff hierte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 13,
      "text": "Der met at giøre oc lide hans villie/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 13,
      "text": "Oc oss dog ingen fra næringen skillie/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 13,
      "text": "Men nyde hans naade allesammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 13,
      "text": "Aldrig met alle i fristelse falde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 13,
      "text": "Men frelsis fra Dieffuelen/ Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 14,
      "text": "Naar som wi ret paa en Gud tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 14,
      "text": "Fader som alting skabte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 14,
      "text": "Oc paa hans Søn i Himmelen boer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 14,
      "text": "Som frelste oss fortabte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 14,
      "text": "Oc wi tro paa den Hellig Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 14,
      "text": "Som hellig giør baade Quinde oc mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 14,
      "text": "Der hand til Troen fører sammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 14,
      "text": "Oc siden vecker op met Siæl oc Krop",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 14,
      "text": "Til det euige Liff/ Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 15,
      "text": "Huo der Troer oc bliffuer døbt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 15,
      "text": "Hand skal vist salig bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 15,
      "text": "Men huo met andet vil være igenkiøbt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 15,
      "text": "Til pine vil Christ hannem driffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 15,
      "text": "Der paa giffuer hand besegling god/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 15,
      "text": "Sit Legeme oc sit hellige Blod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 15,
      "text": "Det vnde oss Gud allesammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 15,
      "text": "At wi saa Tro/ det wi maa bo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 15,
      "text": "Met Jesu Christo/ Amen.",
      "part": false,
      "marginal_notes": []
    }
  ]
}