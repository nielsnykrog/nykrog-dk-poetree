  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Kyrie Gud Fader forbarme dig offuer oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Christe du est vort liff oc opstandelse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "forbarme dig offuer oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Kyrie Hellig Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "hielp oss vor trøstermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Forbarme dig offuer oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Resurrexit Christus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "qui pro nobis passus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "in passione cuius",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "liberati sumus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Kyrieleis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Christ stod op aff døde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "oc frelste oss alle aff nøde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Thi ville wi alle være glad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "oc loffue vor Herre i allen stad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Kyrieleis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "Christus Jesus for oss offrit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "den loffue wi alle Christne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Guds Lam haffuer igenløst sine Faar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Christus wskyldig haffuer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "forligt Gud Fader oc alle syndere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Død oc liff haffue nu strid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "liffsens høffding som vaar død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "Christus nu leffuer altid skal regnere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Sig oss nu Maria huad du haffuer paa veyen seet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Jeg saa den leffuendis Christi graff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "oc ieg saa hans ære som vaar opstanden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 7,
      "text": "Jeg saa Guds Engle oc iordeklæder til vidnisbyrd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "Christus vort haab vist opstanden er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "oc hand skal eder møde i Galilea.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 8,
      "text": "Mariæ rette vidnisbyrd er fast mere troligt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 8,
      "text": "end alle Jødernis falske ord oc løgn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 9,
      "text": "Wi det sandelige vide/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 9,
      "text": "at Christ stod op aff Døde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 9,
      "text": "O Christe Konning forbarme dig offuer oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 10,
      "text": "Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 11,
      "text": "Christus som for oss hid til Jorderig kom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 11,
      "text": "oc aff Maria tog mandom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 11,
      "text": "hand lidde for oss den forsmælig død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 11,
      "text": "oc der met fuldkommelig bøtte det Adam brød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 11,
      "text": "oc frelste oss saa aff Helffuedis nød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 12,
      "text": "Hand beuiste stor Guddommelig Mandom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 12,
      "text": "til Helffuede hand foer oc igienkom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 12,
      "text": "oc opstod som en Konning from.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 13,
      "text": "Hand brød Helffuede oc Dødsens baand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 13,
      "text": "hand bant Dieffuelen vor Fiende den onde Aand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 14,
      "text": "Nu haffuer hand vore fiende vndertraad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 14,
      "text": "oc Døden stunget met sin egen braad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 14,
      "text": "at all vor wlycke er forraad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 14,
      "text": "Saa at alting er nu fremgaaet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 14,
      "text": "som Propheterne haffde om spaad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 14,
      "text": "det haffuer oss Christus baat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 15,
      "text": "Derfor glæder eder nu menige Christne alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 15,
      "text": "at Dieffuelen ey maa nu eder offuerfalde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 15,
      "text": "men Christum hand skal sin Herre kalde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 15,
      "text": "hand haffuer oss frelst aff Synd oc nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 15,
      "text": "oc frid oss fra den euige død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 15,
      "text": "oc lid for det Adam brød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 16,
      "text": "Det gamle Fædre haffde forlange attraad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 16,
      "text": "det haffuer Gud nu vel vdberaad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 16,
      "text": "som Propheterne haffde spaad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 16,
      "text": "saa er Christus vnder skrøbelighed hid til Verden gaaet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 16,
      "text": "at wi i hannem haffue Naade faaet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 17,
      "text": "Thi lader oss alle tacke Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 17,
      "text": "oc være ved it frit mod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 17,
      "text": "prise hannem oc holde hans Bud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 17,
      "text": "hand er nu bleffuen Syndsens Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 17,
      "text": "at wi Syndeløse maa være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 18,
      "text": "Oc tiene Gud vdi en fri Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 18,
      "text": "oc loffue Gud som oss er saa rund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 18,
      "text": "oc siunge met en mund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 18,
      "text": "Haleluia/ loffuer Herren/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 18,
      "text": "Haleluia/ loffuer Herren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 19,
      "text": "Guds Engel sidder hoss graffuen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 19,
      "text": "er iførd klarhedsens klædebon/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 19,
      "text": "Huilcken Quinderne saae/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 19,
      "text": "oc bleffue forfærrede aff megen redsle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "staaendis langt fra.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 20,
      "text": "Da talede Engelen sigendis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 21,
      "text": "Frycter icke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 21,
      "text": "ieg siger eder det/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 21,
      "text": "at den leffuer huilcken i lede effter/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 21,
      "text": "menendis død at være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 22,
      "text": "Oc Menniskens liff er opstaaed met hannem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 23,
      "text": "Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 24,
      "text": "Den Kaarsfeste paa mandommen loffuer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 24,
      "text": "oc den iordede for eders skyld ærefuld giøre i/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 24,
      "text": "den som op stod aff døden tilbeder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 25,
      "text": "",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 26,
      "text": "Guds Engel klar oc huid/ aff Himmelen foer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 26,
      "text": "oplod graffuen oc forfærde Vecten met Jordskel stor.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 26,
      "text": "Aarlig om morgen der Soel gick op/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 26,
      "text": "ginge Quinderne til graffuen at smøre Jesu døde krop.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 27,
      "text": "Engelen i Graffuen trøstede dem alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 27,
      "text": "hand bad dem ey frycte/ men glade være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 27,
      "text": "Thi Jesus aff Nazareth vaar opstanden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 27,
      "text": "den de søgte i dødsens baande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 28,
      "text": "Det siger hans Disciple foruist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 28,
      "text": "J Galilea de see den Christ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 29,
      "text": "Maria græd oc i Graffuen saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 29,
      "text": "stæden som Jesu Legem laa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 29,
      "text": "bag sig hun saa en leffuendis Mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 29,
      "text": "haffuer du icke (sagde hun) taget hannem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 30,
      "text": "Jesus det vaar/ Thi sagde hand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 30,
      "text": "Sige Maria mine huer Mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 30,
      "text": "at ieg vil til Himmels fare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 30,
      "text": "til min oc eders Herre Gud oc Fader/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 30,
      "text": "mine Brødre skulle i være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 30,
      "text": "oc min Faders børn kiere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 31,
      "text": "Quinderne til Graffuen komme igen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 31,
      "text": "der maatte de atter see Engle siun.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 32,
      "text": "Saa vist vilde Gud oss det være kiend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 32,
      "text": "at Christus for oss hid vdsend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 32,
      "text": "leffuer nu vden all ende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 33,
      "text": "Engelen sagde/ ah frycte ey saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 33,
      "text": "Thi ieg lader eder nu god tiende forstaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 33,
      "text": "Christus den Kaarsfeste den i søge hoss de døde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 33,
      "text": "er nu opstanden fra all møde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 33,
      "text": "kommer oc seer stæden der hand i laa/ Graffuen er tom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 33,
      "text": "hand leffuer i krafft som en Konning from.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 34,
      "text": "",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 35,
      "text": "Jesus kom oc sagde selff det samme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 35,
      "text": "Helsel gode quinder/ værer ey saa bange/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 35,
      "text": "Tror en leffuendis Mand/ det see oc føle i vel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 35,
      "text": "ieg haffuer paa mig baade krop oc siel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 35,
      "text": "Thi siger mine Brødre/ at de sig ey møye/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 35,
      "text": "Jeg vil dem i Galilea møde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 36,
      "text": "",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 37,
      "text": "Cleophas gick til Emmaus heden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 37,
      "text": "aff medynck hand om Jesu talede met sin ven/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 37,
      "text": "Jesus holt sig til dem/ oc lærde dem saa Scrifften/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 37,
      "text": "at de maatte Sagen ret forstaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 37,
      "text": "met tegn oc hiertens brynde/ loed hand sig kiende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 37,
      "text": "at de vel fornumme huort de vaare vende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 38,
      "text": "",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 39,
      "text": "Som Cleophas met Apostlerne talede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 39,
      "text": "da traadde Jesus mit ind til dem oc sagde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 39,
      "text": "Fred met eder/ Fred være met eder allesammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 39,
      "text": "met glæde oc fryd euindelig Amen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 39,
      "text": "hand aad met dem hand lod dem see oc træffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 39,
      "text": "at mand ey mere skulle paa hannem tuiffle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 40,
      "text": "",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 41,
      "text": "Christ laa i Dødsens baande/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 41,
      "text": "for vore Synder giffuen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 41,
      "text": "Hand er igen opstanden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 41,
      "text": "bar oss det euige leffnet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 41,
      "text": "At wi skulle altid være glad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 41,
      "text": "hannem tacke oc prise i allen stad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 41,
      "text": "oc siunge Haleluia/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 41,
      "text": "Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 42,
      "text": "Døden kunde ingen tuinge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 42,
      "text": "Blant alle Menniskens Sønner/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 42,
      "text": "Det giorde alt vore synder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 42,
      "text": "Jngen wskyldig vaar at finde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 42,
      "text": "Der aff da kom den Død saa snart/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 42,
      "text": "Fick mact offuer oss met en fart/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 42,
      "text": "Holt oss i sit Rige fangne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 42,
      "text": "Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 43,
      "text": "Jesus Christus Gud Faders Søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 43,
      "text": "Vdi vort sted er kommen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 43,
      "text": "Ved hannem faa wi den euige løn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 43,
      "text": "Oc Døden er offueruunden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 43,
      "text": "All sin Ret oc all sin mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 43,
      "text": "Som wi vaare vnderlagt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 43,
      "text": "Borttog Christi Død allene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 43,
      "text": "Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 44,
      "text": "Det vaar en gantske vnderlig krig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 44,
      "text": "Der Døden oc Liffuit stridde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 44,
      "text": "Liffuit fick mact oc offuer haand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 44,
      "text": "Oc monne Døden affliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 44,
      "text": "Scrifften haffuer oss det kundgiort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 44,
      "text": "At Christi Død bedreff det mord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 44,
      "text": "En spot aff Døden er vorden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 44,
      "text": "Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 45,
      "text": "Her er det rette Paaskelam",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 45,
      "text": "Om huilckit Gud haffuer budit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 45,
      "text": "Det er det som paa Kaarssit kom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 45,
      "text": "For vor skyld stegt oc dødet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 45,
      "text": "Dets Blod stenckis paa vore Dørre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 45,
      "text": "Oc holder Døden vden faare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 45,
      "text": "Den Mordener kand oss ey røre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 45,
      "text": "Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 46,
      "text": "Saa holde wi det høye Fest",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 46,
      "text": "Met hiertens fryd oc glæde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 46,
      "text": "At Jesus Christus er oss nest/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 46,
      "text": "Sin Naadis skin oss beteede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 46,
      "text": "Hand er selff Retuishedsens liuss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 46,
      "text": "Som opliuser vor hiertis Huss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 46,
      "text": "Syndsens Nat hun er bortgangen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 46,
      "text": "Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 47,
      "text": "Aff det sande Paaskelam",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 47,
      "text": "Æde wi/ ocsaa leffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 47,
      "text": "Den gamle Surdey/ Menniskens lærdom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 47,
      "text": "Guds ord skal hand nu vige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 47,
      "text": "Christus hand er den sande Mad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 47,
      "text": "Som bespiser den Christne stad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 47,
      "text": "Troen kand ey andet lide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 47,
      "text": "Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 48,
      "text": "Hand frelste oss fra død oc synd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 48,
      "text": "Alt met sin bittre pine/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 48,
      "text": "Hand er bleffuen opstandelsen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 48,
      "text": "Retfærdighed monne hand giffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 48,
      "text": "Stat op aff søffne all Christenhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 48,
      "text": "Lad mørckens gerninger være dig leed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 48,
      "text": "Retfærdelig leff i Christo Jesu.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 48,
      "text": "Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 49,
      "text": "Pharaonis mact den grumme Mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 49,
      "text": "Er nu fordømt met alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 49,
      "text": "Ved Jesum Christ vor Frelser sand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 49,
      "text": "Oss aff Egypten hand kalde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 49,
      "text": "Her haffue wi den sande Mosen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 49,
      "text": "Som vdledde all Jsraels kiøn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 49,
      "text": "Fra Syndsens trældom til hiertens lise.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 49,
      "text": "Hale:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 50,
      "text": "Loff priss oc ære være dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 50,
      "text": "Dauid/ O Christe vor Konning/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 50,
      "text": "Som stridde for oss mandelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 50,
      "text": "Goliath er offueruunden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 50,
      "text": "Som lagde vind paa met all sin vold",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 50,
      "text": "At fordærffue Jsraels skiold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 50,
      "text": "Dit Aandelig Jsraels folck sig glæder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 50,
      "text": "Hale:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 51,
      "text": "Jesus Christ vor Frelsermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 51,
      "text": "den som Døden offueruand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 51,
      "text": "hand er opstanden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 51,
      "text": "Synden haffuer hand fangen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 51,
      "text": "Kyrieleison/ O Herre miskunde oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 52,
      "text": "Den vden all Synd fødder vaar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 52,
      "text": "Guds vrede hand for oss bar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 52,
      "text": "Oc flyde oss venskab/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 52,
      "text": "At Gud vil oss nu kier haffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 52,
      "text": "Kyrieleison/ O Herre miskunde oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 53,
      "text": "Død Synd Liff oc all naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 233,
      "stanza_id": 53,
      "text": "Monne hand allene offuer raade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 234,
      "stanza_id": 53,
      "text": "Hand vil redde alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 235,
      "stanza_id": 53,
      "text": "Som hannem trolig paakalde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 236,
      "stanza_id": 53,
      "text": "Kyrieleison/ O Herre miskunde oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 237,
      "stanza_id": 54,
      "text": "Ærens Konning O Christe Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 238,
      "stanza_id": 55,
      "text": "O Fader vdi Himmelen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 239,
      "stanza_id": 55,
      "text": "ved din Søn hør vor bøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 240,
      "stanza_id": 55,
      "text": "hand er oss fød oc giffuen vist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 241,
      "stanza_id": 55,
      "text": "til all vor hielp oc trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 242,
      "stanza_id": 55,
      "text": "Vær oss mild O Fader/ Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 243,
      "stanza_id": 56,
      "text": "Huilcken som vaar død oc for oss giffuen. Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 244,
      "stanza_id": 57,
      "text": "O Christe Konning i euighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 245,
      "stanza_id": 57,
      "text": "wi bede dig vær oss blid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 246,
      "stanza_id": 57,
      "text": "du som Døden haffuer fordærffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 247,
      "stanza_id": 57,
      "text": "oss salighed forhuærffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 248,
      "stanza_id": 57,
      "text": "bønhør oss O Herre. Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 249,
      "stanza_id": 58,
      "text": "Hand er opstandenopfaren som hand sagde/ Loffuer Herren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 250,
      "stanza_id": 59,
      "text": "Hellig Aand vor Bøn til dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 251,
      "stanza_id": 59,
      "text": "O Gud vor trøstermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 252,
      "stanza_id": 59,
      "text": "Samuittighedsens trøst/ hiertens lyst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 253,
      "stanza_id": 59,
      "text": "Affslet alle Christnis brøst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 254,
      "stanza_id": 59,
      "text": "Fred oc glæde giff oss. Loffuer Herren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 255,
      "stanza_id": 60,
      "text": "Bed Gud for oss. Haleluia/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 256,
      "stanza_id": 60,
      "text": "Loffuer Herren. Haleluia. Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 257,
      "stanza_id": 61,
      "text": "Konningens Daatter aff euighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 258,
      "stanza_id": 61,
      "text": "Christi Brud glæder sig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 259,
      "stanza_id": 61,
      "text": "For den hun haffuer i Aanden vndfangen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 260,
      "stanza_id": 61,
      "text": "hand er som hand sagde opstandenopfaren",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 261,
      "stanza_id": 61,
      "text": "hun sig paa Gud forlader/ Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 262,
      "stanza_id": 62,
      "text": "Christ haffue loff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 263,
      "stanza_id": 62,
      "text": "en Keyser offuer alle Konger/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 264,
      "stanza_id": 62,
      "text": "loffue wi Christ Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 265,
      "stanza_id": 62,
      "text": "loffuit være hans dag/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 266,
      "stanza_id": 62,
      "text": "Christ raade for oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 267,
      "stanza_id": 62,
      "text": "Christ være met oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 268,
      "stanza_id": 62,
      "text": "Kyrieleis.",
      "part": false,
      "marginal_notes": []
    }
  ]
}