{
  "id": null,
  "title": "Far vel, du ædle nattergal",
  "year_created": [
    1570,
    1573
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Langebeks kvart",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1573,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/LNGK59.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Far-well thü Edelige Nagtegall |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "din søde och Røde sanng |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "far til min herris kongelig saall |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Thu klage for hannem min tuang |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Min pine hun er saa Iammerlig sterck |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Ieg brender ÿ kierligheds-Ildtt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "och er bespenntt mett hiertens werck |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "thu beedt hannum were mig mildtt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Edelige krone thu giff paa acth |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "och wenntt til mig thin gunst, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Emodtt thin wille och herre-magtt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Sa Ringe tha er min kunst |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Thin byrdtt er høg och min er lauff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Ieg thet bekiende maa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Thij lignis icke mere endt natt och dag |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "ther-y wille meg forsmaa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Trost mig du Edelig Stemme |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "och Nadelig till meg see |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Losz meg aff Elschouens klemme |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "thitt andsict Ladt mig bethee |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "for thin skÿldtt vil Ieg Lide |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "och thale then horde dødtt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Ther-for will Ieg thiig biide |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "hielp meg wthij min nødtt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Wiiste thu min store plaffue |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "och stercke kierlighet-yldtt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Torde Ieg meg for thiig klaffue |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Ma-schee thu bleffue meg mildt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Lade meg thet icke undgielle |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Aat ieg er ringe och Arm |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Men trøst mig mett thin ville |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "och Løsz min pine och harm, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Min øgen thij mig skende |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "formededst thin firstelig schicke |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "der thu paa banen Rennde |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "Ieg fick ther-aff ett knick |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "Thin firstelig waaben och tøcke, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "Thin skioldtt och Ridderlig stang |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "Mitt hiartte monne thij opwecke |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "Til kierligheds pine och tuang |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "Mitt hiarte haffuer thu boned",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "vdt-aff | stor kierlighet |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 5,
      "text": "Lieg er platt offueruonden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 5,
      "text": "aff Elskuens bitterhed |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 5,
      "text": "Ieg wedt mig Intitt att raade |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "Min Pine er meg Manefold |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "ther thu wiltt mig benaade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "thet stander y thin woldtt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "Ieg tor icke obenbare |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 6,
      "text": "min sorig for nogen mand |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 6,
      "text": "Ieg setter meg y then fare |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 6,
      "text": "ohm nogen thet rett befandt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 6,
      "text": "Att Ieg rade mig fordriste |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "att elske saa høigtt itt blott |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "de spottett mig alle thet wiiste |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "Ieg fik icke anden baadt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 7,
      "text": "Du Ladtt thin gunst forbarme |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 7,
      "text": "Idmig Ieg maner teg |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 7,
      "text": "offuer mig elendig och Arme |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 7,
      "text": "Se thill meg Nadelig |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 7,
      "text": "Ieg vil Icke anditt begiere |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 7,
      "text": "End see ditt Andsict klar |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 7,
      "text": "Och støndom høusz att were |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "Giff meg et Naadeligtt suar, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 8,
      "text": "O herre wdvoldtt for alle |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 8,
      "text": "Thin gunst er mig saa sødtt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 8,
      "text": "Wiltu mig thiill tiig kalle |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 8,
      "text": "Saa willIeg gierne døø |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 8,
      "text": "Gud naade meg Arme Pige |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 8,
      "text": "min thiid er mig saa lang |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 8,
      "text": "Icke khand Ieg were thin Liige |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 8,
      "text": "Thett giør mitt hierte tuang |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 9,
      "text": "Nattegall willtu tiig skynde |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 9,
      "text": "Tha skint teg fast och bratt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 9,
      "text": "Min herre thet att forkynde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 9,
      "text": "ÿ thenne same natt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 9,
      "text": "Att siung aff kierlighet |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 9,
      "text": "Ieg er och sorrigfuld |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 9,
      "text": "for hanum er thet alleniste skeet |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 9,
      "text": "thu beedtt hannum were mig huldt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 9,
      "text": "Finnis |",
      "part": false,
      "marginal_notes": []
    }
  ]
}