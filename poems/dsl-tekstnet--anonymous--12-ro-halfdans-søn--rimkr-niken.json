  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Thet bør hwer førstæ oc hwer fformand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "och skickæ alting wed læylighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "och mest nar han kan leffue i fred.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Ieg leffdhe mith liff fforvdhen strijdh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "thi tog ieg meg ey annen ydh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "ieg Høgækøbing fflyttæ tijl Ysefiord haffn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "forti han loo ther ey wel tijl max",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "ath skybæ ther gotz oc seylæ saa strax.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Ieg hannum Roskylde kallæ lodh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Halworth aff Swerigæ slo meg ihiel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "thet heffnde myn broder Heliæ wel.",
      "part": false,
      "marginal_notes": []
    }
  ]
}