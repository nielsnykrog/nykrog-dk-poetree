{
  "id": null,
  "title": "Stambogsblade",
  "year_created": 1876,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Af Samlede Skrifter. Tre Og Tredivte Bind",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1876,
    "url": "https://tekstnet.dk/books/andersen-hc_af-samlede-skrifter-tre-og-tredivte-bind/025/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Til mig Du kom som Lille, barnlig-glad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Hvor lyste Dine Øine uskyldsklare!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Du bad mig skrive her paa dette Blad;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Mon vel som Ældre Du det vil bevare?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Maaskee! – Gid da endnu med Barne-Sind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Du føle Livets Solskin paa din Kind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Og i dit Hjerte! – Tiden snart forsvinder;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Det nyligt skrevne Blad er – gamle Minder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Fra Vesterhavets Lande",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Hen over dybe Vande",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Du kom til Danmarks Strande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Hvor Guld paa Marken groer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Her Du i Bøgesalen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Tidt hørte Nattergalen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Og saae, ved Taget Svalen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Symbol paa Troskab, boer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Paa Svalens Ryg der sidder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Gud Amor, klædt som Ridder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Forstaaer Du Fugleqvidder?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Jeg næstendeels det troer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "En Hilsen! Hvad? Og hvor?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Naar Hyacinthens fine Klokker klinge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Og Alfen om sin Slægt fortæller der,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Jeg husker Dig – og Tanken paa sin Vinge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Staaer ved St. Goars kjendte Morbærtræer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Du som en Huusalf stille sysler inde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "I Stuen, hvor der var saa hyggeligt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Saa riig paa Hjerte er den tydske Qvinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Men altfor fattigt her mit danske Digt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "Dit Barne-Smiil, dit tankefulde Øie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "Er Billed af den Sjæl, som i Dig boer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "Min Tanke bærer det til Nordens Høje,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Hvor duftende Erindrings-Blomsten groer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "De gode Timer glemmer Hjertet ei.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "Det Søndags-Solskin selv ved Loreley.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Bogen kom først, og jeg kom sidst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "Det for mig selv var det Bedste vist;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "Skudsmaalet først, Personen siden!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "Hold lidt venligt paa Begge i Tiden!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 6,
      "text": "Fra Strængene flyver en Fuglehær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 6,
      "text": "Den synger med Hjerte og Tunge;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 6,
      "text": "Vi Hjerteslaget fornemmer i hver;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "Thi griber det Gamle og Unge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "Min Tak er saa ringe, en fattig Sang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "Men tro mig, den ogsaa har Hjerte-Klang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 7,
      "text": "Den slanke Lilie, den hvide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 7,
      "text": "Terpsichore gav Vinger paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 7,
      "text": "Og Blomsten blev en Sylphide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 7,
      "text": "Og Verden dit Billede saae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 8,
      "text": "Din Vuggegænge blev sat i Gang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 8,
      "text": "Hvor Haydn, Gluck og Mozart sang;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 8,
      "text": "Men Arnen, hvor Dit Huusliv groer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 8,
      "text": "Er under Bøgen frisk og stor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 8,
      "text": "I Danevang. Led Sønnens Haand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 8,
      "text": "Mens over ham gaaer Sangens Aand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 8,
      "text": "At han dit Navn i sit maa skjære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 8,
      "text": "I Træets Bark, til Slægtens Ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 9,
      "text": "Lunets lystige Skalmeie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 9,
      "text": "Orglets dybe, stærke Klang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 9,
      "text": "Barnesindet – blev Dit Eie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 9,
      "text": "Og det gav Du os i Sang:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 9,
      "text": "Humor, Smerte!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 9,
      "text": "– Du har vundet heelt vort Hjerte!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 10,
      "text": "Flyv mod Syd, drik Solskin og folkelig Sang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 10,
      "text": "Bliv Dig selv, ja selv, ja, helst ikke Andet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 10,
      "text": "Men gro, fortjen Dig en Beethovens Rang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 10,
      "text": "Du Søn fra Tonelandet!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 11,
      "text": "Lad Dig i Smerten selve Smerten sige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 11,
      "text": "Den er et Forsyns store Kjærlighed;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 11,
      "text": "Og kaldte han forud den unge Pige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 11,
      "text": "Før Moderen – hvad der er bedst, han veed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 11,
      "text": "Lad Troen være Dig din Jacobs-Stige;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 11,
      "text": "I hendes Bortgang var det Dig, der led; –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 11,
      "text": "En Engel har Du mere i Guds Rige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 11,
      "text": "En Stjerne mere lyser til Dig ned.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 12,
      "text": "Der synges i By, paa Mark og i Skov,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 12,
      "text": "Der synges den danske Landsoldats Lov!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 12,
      "text": "Det Hverdags og Smaalige svinder og døer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 12,
      "text": "Men Hæderens Fugl, den har Næb, den har Kløer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 12,
      "text": "Den har Du alt fanget, det monne Dig hue;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 12,
      "text": "Du straaler i Sundhed; hvad siger lidt Snue?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 12,
      "text": "Selv den faaer Du næppe; Du boer som en Bæver",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 12,
      "text": "Med Voldgrav om Huset. En Hustru saa væver",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 12,
      "text": "Forvandle til Himlen dit Borreby!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 12,
      "text": "Om det og om Eder vi synger i Sky.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 13,
      "text": "Vi er som to Strømme af modsat Løb,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 13,
      "text": "Og dog blev vi lagt i det samme Svøb;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 13,
      "text": "Jeg først født, Du siden, det fryder Dig lidt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 13,
      "text": "Om Alderens Forskjel Du taler saa tidt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 13,
      "text": "Hvad gjør den? Mit Hjerte groer dog ind i dit!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 13,
      "text": "Din Aands Kraft jeg troer paa; den er ikke liden;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 13,
      "text": "Vorherre den lade ret groe ind i Tiden!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 13,
      "text": "Og naar Du saa naaer mig i Alder og Aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 13,
      "text": "Staa Du da saa ung, som jeg nu for Dig staaer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 14,
      "text": "Bag Sorø Sø ved Skoven",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 14,
      "text": "Bonden gik bag Ploven;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 14,
      "text": "Jeg kom med Ingemann og med hans Frue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 14,
      "text": "I Præstegaardens Stue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 14,
      "text": "De glade Børnestemmer klang;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 14,
      "text": "En lille Pige mindes jeg især,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 14,
      "text": "Med store, milde Øjne sad hun der,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 14,
      "text": "Jeg troer endnu at høre hendes Sang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 15,
      "text": "Til Tak for den nu efter mange Aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 15,
      "text": "Af mig igjen en lille Sang hun faaer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 15,
      "text": "I den vi Præstegaarden vil besøge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 15,
      "text": "Og gjensee Alle, som vi mødte der;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 15,
      "text": "Saa vandre vi med Sang bag Skovens Bøge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 15,
      "text": "Heelt ned til Sorø Sø, – nu er vi her!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 15,
      "text": "Fuldmaanen skinner, Nattergalen slaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 15,
      "text": "– Det lyder gjennem alle Livsens Aar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 15,
      "text": "Der spirer Blomster fra det mindste Frø;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 15,
      "text": "Hvad smukt og godt er, det kan aldrig døe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 16,
      "text": "Flyv ungdomssund til den evige Stad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 16,
      "text": "Kom Dig selv og begeistret tilbage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 16,
      "text": "Og Norden ved Dig faae et Toneqvad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 16,
      "text": "For tusinde Aar og Dage!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 17,
      "text": "En Fader kom med sin lille Søn i Reitzels Boutik;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 17,
      "text": "Den Lille loved jeg Eventyr, men ingen han fik.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 17,
      "text": "Nu er han alt Mand og i Brudgoms Dragt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 17,
      "text": "Nu bliver ham Bogen af Bruden bragt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 17,
      "text": "De læse den sammen i Sorøskove,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 17,
      "text": "Hvor Absalon, Holberg og Ingemannsove,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 17,
      "text": "Hvor Solen skinner, og Øinenes Fyr",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 17,
      "text": "Fortæller det deiligste Eventyr.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 18,
      "text": "Erindrer Du, ja, det er noget siden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 18,
      "text": "– Da var Du mindre – husk en Sommerdag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 18,
      "text": "Dit Barneøie lyste, og skjøndt liden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 18,
      "text": "Stor som en Ven Du kom med glad Goddag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 18,
      "text": "Og vel var det hos Bedstefaer, vi mødtes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 18,
      "text": "Men dog ei i vort eget, danske Land;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 18,
      "text": "Du følte det Beslægtede, der fødtes",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 18,
      "text": "Og adler og forener Mand med Mand;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 18,
      "text": "Det var en Dansk, Du saae, og netop Den,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 18,
      "text": "Med hvem i Eventyret Du var bleven Ven.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 18,
      "text": "Behold det samme Sind i Livsens Dage!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 18,
      "text": "Vær flink og kjæk! Alt Godt! Kun ei forsage!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 19,
      "text": "Paa Livets Tangenter, de sorte og hvide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 19,
      "text": "Du lystigt fra Barndoms-Landet udride!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 19,
      "text": "De svulme og bæve i sød Harmoni!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 19,
      "text": "Hvad nu kun de drømme, i Klarhed vil stige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 19,
      "text": "Dig Gud gav den Lykke i Toner at sige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 19,
      "text": "Hvert Hjerte den qvægende Poesi.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 20,
      "text": "Du Hjemmet vil huske med Frugttræer og Birke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 20,
      "text": "Den duftende Eng med den blegrøde Kirke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 20,
      "text": "Og Storken og Svalen, som fløi Dig forbi.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 20,
      "text": "Men mon Du vil huske den Trækfugl, som bragte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 20,
      "text": "En Hilsen til Dig og et Blomsterblad lagde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 20,
      "text": "Foran Dig til Tak for hver Melodi?",
      "part": false,
      "marginal_notes": []
    }
  ]
}
