{
  "id": null,
  "title": "Niels Ebbesen",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift II",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVII65.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Greffuen drog i Danmarck ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hannem fulde saa stor en skare:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "fire bannere och firesindtz-tyffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "huem torde emod hannem fare!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Greffuen skulle thil Randers ride,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "och did lod hand sig rabe:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "det vor hannem for langen tid spaad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "hand skulle sit liff ther thabe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Icke vilde hand det lade fordi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "endog ville hand det freste:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "ridder och suenne, bønder och boemend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "thennem vilde hand hieme gieste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Greffuen sender Niels Ebbessen bud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "bad, hand skulle till sig ride:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "\"Sig, hand skall mig felig være",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "nu paa thenne tidt!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Greffuen møtte Niels Ebbessen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "norden ved den strand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "\"Vel møtte, god Niels Ebbissen!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "och huad legger tro till haandt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Vell maathu, gode Niels Ebbissøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "och kiere frende myn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "huor staar haaben i Nør-Iutlandt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "och huor lider frenderne din?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "\"Nock haffuer ieg i Nør-Iutlandt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "baade frender och maffre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "thi skulle ethers naade til rede vere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "ihuort i ville thennem haffue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "\"Hør du det, Niels Ebbissøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "du skalt mit erinde bort riide:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "mange suenne haffuer du met dig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "och nu paa thenne tide.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "\"Alt haffuer ieg XXX suenne met mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "saadanne som de ere:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "ere de anten flere eller færre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "ieg haffuer thennem alle fuld kiere.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "\"Haffuer du tredue suenne met digh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "thet er saa vel til maade:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "i gaar holt du i her Buggis hoff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "mett hundritt hoffmend i plade.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "Niels Ebbissønn trinde en fod fra hannem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "hand suarit och ey lenger tauff:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "\"Er det enthen ridder eller suennd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "som mig haffuer det paa sagdt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "Er hand enthen ridder eller suendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "som mig det tilsige vill:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "ieg skall aldrig gaa foed fra hannem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "før ieg faar suarit der-thill.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "\"Hør thu det, Niels Ebbessen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "wi ville icke lenger der-om thale:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "du skalt mit erinde thill her Bugge ride,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "om hand vil venskab aff oss haffue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 13,
      "text": "\"Skal ieg til her Buggi ridde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "och hannem ethers vilie forgiffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "tha skall i mig till kiende giffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "huad ieg skall hannem sige.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "\"Flere ieg haffuer til gode giort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "the ville migh nu forsmaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "lyed fast paa her Buggis raad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "och see, huor det vill gaa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 15,
      "text": "Her Buggi hand haffuer mig lenge undsagd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "och saa hand Pouill Glob:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "Anders Frost er en aff thennem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "och fremmerst i eders haab.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 16,
      "text": "\"Anders Frost er eders tienere tro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "i skulle icki andit spørie:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "om en suend vil orloff haffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "hue maa hand det ey giøre?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 17,
      "text": "Det er sæd i Danmarck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "haffuer verit aff gamel dage:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "i-huilcken suend som icke vill tiene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "hand maa vel orloff haffue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 18,
      "text": "Thet da suaridt hannem greffue her Giertt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "hannem lyste det icke att høre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "\"Ingen maa fra sin herre fly,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "men hand lyster hannem att føre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 19,
      "text": "\"Ther er ingen samell veiet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "uden muncken thill sin kappe:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "hoffmand ridder, och hoffmand kommer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "huilcken best kand tiene til tacke.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 20,
      "text": "\"Hør thu det, Niels Ebbissøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "du snacker alt-for lenge:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "du skalt enthen aff Danmarck rømme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "eller ieg skall lade dig henge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 21,
      "text": "\"Skall ieg ud aff Danmarck rømme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 21,
      "text": "fra høstrue och barn saa smaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "tha skalt du ussell sige det,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 21,
      "text": "att du mig nogen tid saae.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 22,
      "text": "\"Hør thu det, Niels Ebbissen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 22,
      "text": "och vilt du migh icke høre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 22,
      "text": "da skall ieg bryde min leiden offuer dig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 22,
      "text": "som ieg tør fuld-vell giøre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 23,
      "text": "\"Aldrig saae du mig saa reed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 23,
      "text": "och det ieg torde io skielffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 23,
      "text": "greffue her Giert, du see vell till,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 23,
      "text": "mandelig leyde sig sielff.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 24,
      "text": "\"Niels Ebbessen, du taler mig altid imod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 24,
      "text": "baade nu och alle tide:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 24,
      "text": "i afften skalt du mig feligh vere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 24,
      "text": "i morgen, til solen ganger neder.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 25,
      "text": "Niels Ebbesen slo op met huiden haandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 25,
      "text": "hand kaste sin hest omkring:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 25,
      "text": "\"Far vell, greffue Gert och alle din mendt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 25,
      "text": "thu skalt acte mig snart igienn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 26,
      "text": "Niels Ebbessen red att veien frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 26,
      "text": "hand hug sin hest met spore:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 26,
      "text": "effter holt greffuen och alle hans mend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 26,
      "text": "och ingen effther hannem thorde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 27,
      "text": "Tet da vor Niels Ebbissønn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 27,
      "text": "hand red till sin egen gaardt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 27,
      "text": "emod gaar hannem hans venne høstru,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 27,
      "text": "hand spurde hinde om gode raadt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 28,
      "text": "\"Hør i det, min venne høstru,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 28,
      "text": "huad raadt kunde i mig kiende?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 28,
      "text": "ieg skal anthen aff Danmarck rømme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 28,
      "text": "eller greffuen vill lade mig henge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 29,
      "text": "Greffuen loffuit mig thuinde koor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 29,
      "text": "och de vaare ingen gode:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 29,
      "text": "heller ieg ville aff Danmarck rømme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 29,
      "text": "fra alt det godz, ieg aae.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 30,
      "text": "\"Huad raad kand ieg ether giffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 30,
      "text": "ieg er en hæbelig quinde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 30,
      "text": "de verste raad de ere de beste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 30,
      "text": "om i kand thennem paa finde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 31,
      "text": "De verste raad de ere de beste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 31,
      "text": "om i kunde thennem offueruinde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 31,
      "text": "enthen greffue aff liffue thage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 31,
      "text": "eller lade hannem inde brende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 32,
      "text": "I lader eders heste till smidie sende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 32,
      "text": "och lader i thennem beslaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 32,
      "text": "alle hagerne vende i frem!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 32,
      "text": "det giffuer ieg ether for raadt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 33,
      "text": "Alle hagerne vender i frem!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 33,
      "text": "paa spor eder ingen monne kiende:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 33,
      "text": "i lader det ingen aff eder spørie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 33,
      "text": "i lerde det raad aff en quinde!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 34,
      "text": "\"I æde och dricke, min danne-suenne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 34,
      "text": "i giører eder rosens-glade:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 34,
      "text": "først thenne nat forgangen er,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 34,
      "text": "saa kommer dagen i stade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 35,
      "text": "Dagen den kommer, for solen stander op,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 35,
      "text": "saa fanger vi tidende paa nye:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 35,
      "text": "i-huilcken suend sin herre er tro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 35,
      "text": "hand maa icke fraa hannem flye.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 36,
      "text": "Op da stode de gode hoffmend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 36,
      "text": "de toge alle tieniste paa ny:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 36,
      "text": "uden Niels Ebbesens søster-sønn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 36,
      "text": "hand vilde da fra hannem fly.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 37,
      "text": "Saa red de til Fruer-lund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 37,
      "text": "och der bant de deris heste:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 37,
      "text": "saa gick di thennem i Randers indt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 37,
      "text": "greffue Giertt hannem vilde de gieste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 38,
      "text": "The bant deris heste udi Fruer-lund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 38,
      "text": "de ginge offuer Randers-bro:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 38,
      "text": "saa bleffue de greffue her Giertt hans gest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 38,
      "text": "det vor it sellskab tro.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 39,
      "text": "Niels Ebbissen sielff til døren red,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 39,
      "text": "som hand fick da udi sind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 39,
      "text": "\"Ieg er hertug Henrichs budt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 39,
      "text": "bed greffuen lade mig iindt!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 40,
      "text": "\"Est du hertug Hendrichs bud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 40,
      "text": "da lad dig icke forlange:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 40,
      "text": "mød mig i morgen i brødre-kiercke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 40,
      "text": "mellem messe och othe-sangh!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 41,
      "text": "\"Da lader eders budt til døren gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 41,
      "text": "thage breffuit, eders sønn eder sende!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 41,
      "text": "Ribe haffuer hand bestollet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 41,
      "text": "och Kolding den er brendt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 42,
      "text": "Greffuen hand ud aff vinduit saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 42,
      "text": "hand saae de blancke spiude:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 42,
      "text": "\"Ussell ieg til Danmarck kom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 42,
      "text": "Niels Ebbissøn holder her ude!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 43,
      "text": "De støtte paa dør met glaffuen och spiud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 43,
      "text": "det naglerne ginge alle i støcke:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 43,
      "text": "\"Vaag op, greffue Gert! est du her inde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 43,
      "text": "vi ville dig en skaale til-dricke.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 44,
      "text": "\"Set dig neder paa min seng!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 44,
      "text": "vi ville oss bedre forlige:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 44,
      "text": "vi steder bud effter hertug Hendrik",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 44,
      "text": "och her Claus Krumedige.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 45,
      "text": "Det suaret greffuens liden smaa-dreng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 45,
      "text": "hand vaar Niels Ebbessens frende:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 45,
      "text": "\"Lader du greffuen dig giecke i dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 45,
      "text": "huer mand da vorder i skende.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 46,
      "text": "\"Ieg haffuer huercken slot eller feeste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 46,
      "text": "att gieme saa rig en fange:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 46,
      "text": "bruger nu baade suerdt och spiud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 46,
      "text": "och lader dennem haffue deris gang!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 47,
      "text": "Thend tid greffuen hand vor død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 47,
      "text": "och da slo de paa tromme:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 47,
      "text": "thet da vor Niels Ebbissøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 47,
      "text": "hand vilde aff byen gange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 48,
      "text": "Thet da vor Niels Ebbissen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 48,
      "text": "hand vilde aff byen fly:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 48,
      "text": "der møtte hannem her Aage Hass,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 48,
      "text": "hand vilde hannem det forbiude.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 49,
      "text": "\"Hør du det, her Aage Hass,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 49,
      "text": "lad mig min vie bort fare!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 49,
      "text": "du vedst fuld uell, du est min suager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 49,
      "text": "thu matte mig inthet skade.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 50,
      "text": "\"Alt er det sanden, ieg haffuer din frencke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 50,
      "text": "och vi burde venner att vere:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 50,
      "text": "du haffuer slagit min herre ihiell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 50,
      "text": "iegh maa det icke gøre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 51,
      "text": "Saa droge de ud deris gode suerde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 51,
      "text": "Niels Ebbissen vilde icke vige:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 51,
      "text": "her Aage Hass hand hoffuitt fra hug,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 51,
      "text": "saa lagde de det tillige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 52,
      "text": "Thack haffue Niels Ebbissøns søstersønn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 52,
      "text": "hand var hannem en tiener tro:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 52,
      "text": "hand kaste op fiælene for greffuens mendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 52,
      "text": "som vilde offuer Randers-broe.",
      "part": false,
      "marginal_notes": []
    }
  ]
}