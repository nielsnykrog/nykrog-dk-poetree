  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "HVor faare stormede de Hedninge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc Folckene berammede wnytige raad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Jørderigis Konger haffue sig bestercket/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "och ære forsamlede mod Herren och hans smurde Mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "⁕ Lad oss sønderbryde deris baand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "oc bortkaste deris Aag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "⁕ Den som haffuer sin Bolig vdi Hiemmelen skal dem bespaatte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "och Herren skall dem haanlige foriage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "⁕ Da skal han dem vredelige tiltale/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "oc dem i sin grundhed forskrecke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 5,
      "text": "⁕ Men ieg haffuer skicked min Kong offuer mit hellige Bierg Sion",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 6,
      "text": "⁕ Jeg skal predicke Gudz bud at Herren sagde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 6,
      "text": "du est min Søn i dag fødde ieg dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 7,
      "text": "⁕ Eske aff mig oc ieg skal giffue dig de Hedninge til en Arff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 7,
      "text": "och almuen til en Eyedom.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 8,
      "text": "⁕ Dem skalt du sønder bryde met en Jern spire/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 8,
      "text": "oc som ith Lerkar søndersla",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 9,
      "text": "⁕ Saa skulle i Konger nu vere kloge oc lader eder vnderuise som ere Jorderigis Dommere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 10,
      "text": "⁕ Tiener Herren i fryct/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 10,
      "text": "och glæder eder i hannem met en skelffuende fare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 11,
      "text": "⁕ Kysser Sønnen ath han icke vorder vred/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 11,
      "text": "oc at i ey saa tabis aff Veyen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 12,
      "text": "⁕ Naar hans grumhed begynder nogit at brende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 12,
      "text": "da lider dem vel som sette deris loffue til hannem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 13,
      "text": "⁕ Ere vere Gud Fader oc Gud Søn oc Gud den Helligaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 13,
      "text": "Som verit haffuer aff begyndelsen nu oc altid er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 13,
      "text": "Och bliffuer euindelige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 13,
      "text": "Amen",
      "part": false,
      "marginal_notes": []
    }
  ]
}