  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Ren og klar stod Himlens hvalte Bue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Havet brusende mod Stranden brød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Dog i Et ved Solens stærke Lue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Havets Kraft og Himlens Mildhed flød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Henrykt nød jeg dette stolte Skue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Thi det paa mit Spørgsmaal bragte Svar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Kan vel Kjerlighedens stærke Lue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Smelte sammen sligt et Sjælepar?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Kan vel hendes stille, lyse Mildhed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Hendes Tanke rolig, høj og klar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Enes med mit Hjertes mørke Vildhed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Og min Tanke, der ej Hvile har?",
      "part": false,
      "marginal_notes": []
    }
  ]
}
