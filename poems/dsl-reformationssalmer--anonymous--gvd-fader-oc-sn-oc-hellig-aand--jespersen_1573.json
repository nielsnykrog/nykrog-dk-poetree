  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "GVd Fader oc Søn oc Hellig Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hannem bør oss prise oc ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Hand giør miskund i alle Land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "som wi maa daglige lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Hand haffuer beuist stor kierlighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "mod Menniskens køn saa mange led/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "som wi ville faa at høre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "J Dieffuelens vold ieg fangen laa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Jeg vaar fordømt til døde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Min synd mig qualde baade nat oc dag/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Jeg haffde stor angist oc møde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Oc altid sanck ieg dyber ned/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Der vaar ey raad ey salighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Jeg vaar i Synden vndfangen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Min gode gierninger de hiulpe mig ey/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "De kunde ey døden offueruinde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Den stercke Dieffuel hand sagde ney/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Hand vilde ey lade sig binde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Aff mig eller noget Creatur/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Jeg vaar i hans vold aff min natur",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Fordømt til euig pine.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Der vaar oc ingen i Verden til/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "Der mig forløse kunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Jeg veed ret aldrig huort ieg vil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Jeg maa til Helffuedis grunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "For Guds vrede der offuer mig er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Oc syndsens byrde der ieg nu bær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Fortabit maa ieg bliffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Da ynckede Gud i euighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "Min ælende offuer maade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "Hand tenckte paa sin Barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "Hand vilde mig hielpe lade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Sit Faderligt hierte vende hand til mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "Hand kaaste der paa foruden suig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "Det kieriste der hand haffde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Hand talede til sin kiere Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "Det er nu tid at forbarme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "Du skalt det giøre for min bøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "Far heden oc frels de arme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "Oc løss dem vdaff Syndsens nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "Oc sla ihiel den haarde død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "Oc lad dem met dig leffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "Guds Søn sin Fader lydactig vaar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "Hand kom til mig paa Jorden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "Aff en Jomfru baade reen oc klar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 6,
      "text": "Hand vilde min Broder vorde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 6,
      "text": "Saa lønlige førde hand sin stat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 6,
      "text": "Leed alskens nød oc megen platz/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "For hand vilde Dieffuelen fange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 7,
      "text": "Guds Søn hand sagde/ kom hid til mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 7,
      "text": "Jeg vil mig offuer dig forbarme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 7,
      "text": "Jeg taalde den bittre død for dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 7,
      "text": "Der met du Himmerige skalt arffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 7,
      "text": "Nu er ieg din oc du est min/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 7,
      "text": "Oc huor ieg er der skalt du være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 7,
      "text": "Den fiende skal oss ey atskillie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 8,
      "text": "Huem haffuer hørt større kierlighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 8,
      "text": "End døden for wuenner at lide?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 8,
      "text": "Det haffuer ieg ene giort for dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 8,
      "text": "At du skulde met mig bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 8,
      "text": "Jeg er den ene der hielpe kand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 8,
      "text": "Thi kommer til mig baade quinde oc mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 8,
      "text": "Oss skal ret ingen atskillie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 9,
      "text": "Mit blod det flyder paa Jorden vd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 9,
      "text": "Jeg bær det kaarss met møde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 9,
      "text": "Jeg lider for dig den haarde død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 9,
      "text": "Tag tro oc lad dig døbe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 9,
      "text": "Mit liff offueruinder den død met mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 9,
      "text": "All Verdsens synder er paa mig lagt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 9,
      "text": "Thi est du salig vorden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 10,
      "text": "Til Himmels igen til Fader min/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 10,
      "text": "Far ieg fra denne ælende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 10,
      "text": "Der vil ieg være Mester din/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 10,
      "text": "Den hellig Aand dig at sende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 10,
      "text": "Som dig i angiste trøste skal/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 10,
      "text": "Oc dig vnderuise oc lære vel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 10,
      "text": "J sandheds vey at vandre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 11,
      "text": "Huad ieg haffuer giort vnderuist oc lærd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 11,
      "text": "Det skalt du giøre oc lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 11,
      "text": "Der met mit Rige opfylt bliffuer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 11,
      "text": "Mig selff til loff oc ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 11,
      "text": "Foruare dig vel for Menniskens sæt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 11,
      "text": "Som oss foruender den Christelige ræt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 11,
      "text": "Det giffuer ieg dig tilkiende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 12,
      "text": "Du skalt predicke den Christelige tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 12,
      "text": "Som ieg befaler at lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 12,
      "text": "Elsker huer andre baade silde oc fro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 12,
      "text": "Det skal mit Budord være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 12,
      "text": "For Dieffuelens lærdom vocte dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 12,
      "text": "Thi hand er falsk oc skadelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 12,
      "text": "Guds ord det bliffuer euindelig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 13,
      "text": "Thi ville wi prise i euighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 13,
      "text": "Oc loffue foruden all ende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 13,
      "text": "Gud Faders store barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 13,
      "text": "Som oss den naade sende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 13,
      "text": "Oc nederslog i Christi død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 13,
      "text": "Helffuede Synd oc Dødsens nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 13,
      "text": "Huo kand oss nu fordærffue?",
      "part": false,
      "marginal_notes": []
    }
  ]
}