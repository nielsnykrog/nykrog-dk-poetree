{
  "id": null,
  "title": "Mellem Træerne ved Bommen",
  "year_created": 1803,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Adam Oehlenschläger",
    "country": null,
    "wiki": "Q168356"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Digte",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1803,
    "url": "https://tekstnet.dk/books/oehlenschlaeger-a_digte/047/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Der har De jo faaet en prægtig Hest.",
      "part": false,
      "marginal_notes": [
        "Speaker: EN UNG FYR til en anden."
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Rid med til Bellevue og vær min Giest.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Ih ja gu vel! Tak den som byder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Slige Tilbud jeg aldrig forskyder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Lad mig först komme frem. Hold lidt! stop!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Maa jeg hielpe Frökenen op?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Jeg takker for deres Artighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Du skal altid hielpes op og ned.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Kan du ikke hielpe dig selv, min Pige?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Naa kiere Kone, hvad vil det sige?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Adieu, adieu! Denne Dag var smuk.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Sluk Lysene ud og Dören luk!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Mat og ene, bleg og ene",
      "part": false,
      "marginal_notes": [
        "Speaker: LUDVIG"
      ]
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "sidder jeg blandt Skovens Kroner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Ene, paa de kolde Stene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "toner Harpen Veemodstoner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Dysses ikke hen i Slummer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "kielne Sangersker, som rörte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "nys den blege Mand, hvis Kummer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "dulmed da han Eder hörte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "Kunde disse dunkle Lunde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "lettere mit Hierte hæve,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "o da skulde Harpen bæve",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Glædeslyd som Eders Munde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Men det böder og forsöder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 4,
      "text": "i sin Smerte södt sin Smerte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 4,
      "text": "möder Anelser og föder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 4,
      "text": "svage Haab, det arme Hierte!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "Hvad er Nattens Stiernehimmel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": "naar ei Elskovs skiönne Stierne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 5,
      "text": "blinker venligt i det Fierne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 5,
      "text": "fra den lyse Stiernevrimmel?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "Hvad er Livet, naar ei Livet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": "lifligt hen i Elskov rinder?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 6,
      "text": "Hvad er Livet, naar ei Livet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 6,
      "text": "södt i Favnetag forsvinder?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 7,
      "text": "Aftenvind! i Aftenröden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": "du, som Nattens Taushed bryder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 7,
      "text": "for mit Öre tungt du lyder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 7,
      "text": "som det sidste Suk i Döden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 8,
      "text": "Skyggerne voxe i Lunden,",
      "part": false,
      "marginal_notes": [
        "Speaker: MARIA kommer."
      ]
    },
    {
      "id": 41,
      "stanza_id": 8,
      "text": "den lyse Dag er forsvunden;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 8,
      "text": "mildt skyller de mörke Vover.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 8,
      "text": "Naturen blideligt sover.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 9,
      "text": "Mens Pigen hurtig heniler,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 9,
      "text": "den bleggule Maane smiler;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 9,
      "text": "bag sorte Stammer, i Taage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 9,
      "text": "de lumske Rövere vaage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 10,
      "text": "Hvor underligt Espen skielver!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 10,
      "text": "Som en Kirke sig Skoven hvælver!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 10,
      "text": "som en Kirke ved Midnatstide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 10,
      "text": "Hist svæve Dödninger hvide!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 11,
      "text": "Hvi skielver ei frygtsomme Pige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 11,
      "text": "mens Morderne lumske sig snige?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 11,
      "text": "Hvi springer hun kiek og forvoven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 11,
      "text": "gjennem sorteste Buske i Skoven?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 12,
      "text": "Hun frygter ei for de Döde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 12,
      "text": "hun gierne for Dolken vil blöde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 12,
      "text": "naar hun i sin sidste Smerte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 12,
      "text": "kan synke til Ludvigs Hierte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 12,
      "text": "Tryllende Harmonie!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 12,
      "text": "i midnatsdunkle Jord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 12,
      "text": "Salige Sympathie!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 12,
      "text": "Hellige Poesie!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 12,
      "text": "uden Ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 12,
      "text": "Samsmeltning af Lund og Söe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 12,
      "text": "Favn mod Favn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 12,
      "text": "tolker hele Naturen Kierligheds Navn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 12,
      "text": "Her har jeg staaet i hundrede Aar;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 12,
      "text": "om Vintren med Snee paa mit Bryst;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 12,
      "text": "mellem Blomster i grönne Vaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 12,
      "text": "mellem egne Löv i den brune Höst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 12,
      "text": "Min stolte Top har jeg reist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 12,
      "text": "og kneist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 12,
      "text": "ud over den vide Natur,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 12,
      "text": "som omslynger Træernes tætte Muur.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 12,
      "text": "Da blev jeg saa mod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 12,
      "text": "Jeg kunde ei flytte min Fod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 12,
      "text": "Stille maatte jeg staae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 12,
      "text": "og vilde saa gierne, saa gierne gaae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 12,
      "text": "Engang de fældte min Broder her,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 12,
      "text": "som hæved sig rank over Stubben der!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 12,
      "text": "Han er lykkelig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 12,
      "text": "Som en Planke i Skibet tumler han sig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 12,
      "text": "som en Slange han sig giennem Bölgerne snoer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 12,
      "text": "om den hele Jord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 12,
      "text": "Jeg staaer hvor jeg blev föd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 12,
      "text": "til min Död!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 12,
      "text": "För var jeg for stolt til at klage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 12,
      "text": "man bliver blöd paa de gamle Dage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 12,
      "text": "Derfor suser",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 12,
      "text": "nu Vemod i mit Löv, naar Stormen bruser.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 12,
      "text": "Denne Nat er söd!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 12,
      "text": "Toner löd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 12,
      "text": "ved min gamle Fod;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 12,
      "text": "og paa min Rod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 12,
      "text": "sidder Elskende to",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 12,
      "text": "i kierlig Roe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 12,
      "text": "Saadan en Vaar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 12,
      "text": "har jeg ikke oplevet i hundrede Aar!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 12,
      "text": "Du er hundrede Aar!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 12,
      "text": "Jeg kun en Dag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 12,
      "text": "Dit Liv er langsomt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 12,
      "text": "koldt, stærkt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 12,
      "text": "Mit er hurtigt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 12,
      "text": "brændende, begeistret!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 12,
      "text": "Lutter Glöd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 12,
      "text": "levende, bevægelig Glöd!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 12,
      "text": "Et Öieblik mellem Födsel og Död.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 12,
      "text": "Jeg bytter ikke med dig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 13,
      "text": "Een, to , tree!",
      "part": false,
      "marginal_notes": [
        "Speaker: HYMNE"
      ]
    },
    {
      "id": 111,
      "stanza_id": 13,
      "text": "I ranglende Dands!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 13,
      "text": "I danglende Dands!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 13,
      "text": "Med skimtende Lee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 13,
      "text": "i Maaneglands!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 14,
      "text": "Een, to, tree!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 14,
      "text": "Med ringlende Been,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 14,
      "text": "med dinglende Been!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 14,
      "text": "Jeg har hvæsset min Lee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 14,
      "text": "paa Gravens Steen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 15,
      "text": "Een, to, tree!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 15,
      "text": "Fra den sorte Grav!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 15,
      "text": "Med blinkende Lee",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 15,
      "text": "mens Maanen leer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 15,
      "text": "Jeg kommer tilpas!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 15,
      "text": "Du rinder ei meer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 15,
      "text": "mit Timeglas!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 16,
      "text": "Afsted, afsted,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 16,
      "text": "med hurtige Fied,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 16,
      "text": "i Taage mellem Snoge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 16,
      "text": "over Engen hen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 16,
      "text": "mellem Lygtemænd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 17,
      "text": "Een, to, tree!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 17,
      "text": "I ranglende Dands!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 17,
      "text": "I danglende Dands!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 17,
      "text": "Med skimtende Lee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 17,
      "text": "i Maaneglands!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 17,
      "text": "Ellepige! Ellepige!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 17,
      "text": "Hvad har du at sige?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 17,
      "text": "Tag vare, tag vare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 17,
      "text": "paa Bölgerne klare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 17,
      "text": "at ingen fordunkle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 17,
      "text": "de Perler som funkle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 17,
      "text": "at aldrig de nöle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 17,
      "text": "i bælmörke Gange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 17,
      "text": "at de fremspringe kiöle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 17,
      "text": "milde og mange!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 17,
      "text": "ELLEPIGEN",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 17,
      "text": "Jeg skal dem bevare;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 17,
      "text": "men du maa dem klare!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 17,
      "text": "Dobbelt lyst vi nu rinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 17,
      "text": "Farvel, vor Veninde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 17,
      "text": "Hist i Taarnet alt Klokken slaaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 17,
      "text": "Stiernen blinker!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 17,
      "text": "Elskte Maria! du fra mig gaaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 17,
      "text": "Himlen vinker!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 17,
      "text": "Underligt bange mit Hierte slaaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 17,
      "text": "Stiernen blinker!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 17,
      "text": "O hvad dog Kierlighed formaaer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 17,
      "text": "Himlen vinker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 17,
      "text": "Deiligt bölger dit lange Haar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 17,
      "text": "Stiernen blinker!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 17,
      "text": "Til Himlen dit klare Öie du slaaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 17,
      "text": "Himlen vinker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 17,
      "text": "Pleieforældre med sölvgraae Haar –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 17,
      "text": "Stiernen blinker!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 17,
      "text": "I ledende nu i Skoven gaaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 17,
      "text": "Skiebnen vinker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 17,
      "text": "Jeg forbittrer dine Ungdoms Aar!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 17,
      "text": "Stiernen blinker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 17,
      "text": "Gid jeg laae paa den sorte Baar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 17,
      "text": "Himlen vinker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 17,
      "text": "Hisset tælle vi ingen Aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 17,
      "text": "hvor Stiernen blinker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 17,
      "text": "Hist vi evig paa Roser gaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 17,
      "text": "naar Himlen vinker!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 20,
      "text": "Det er mig kiert de stöier ei meer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 20,
      "text": "Den brogede Sværm ei gierne jeg seer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 20,
      "text": "Det giör mig ondt for min gode Skov",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 20,
      "text": "at til det Væsen de skal have Lov.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 20,
      "text": "Jeg vanker helst mellem tause Stammer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 20,
      "text": "sigter og skyder og Hiorten rammer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 20,
      "text": "Jeg gider kun levet med mig selv.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 20,
      "text": "Naar i Natten suser den kolde Elv",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 20,
      "text": "sætter jeg mig ved Træets Rod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 20,
      "text": "med min Trofast liggende ved min Fod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 20,
      "text": "og stirrer hen i den blege Stierne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 20,
      "text": "som glimter saa underligt i det Fierne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 20,
      "text": "Og naar da ligesom den luer i mit Bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 20,
      "text": "saa faaer jeg til at blæse Lyst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 20,
      "text": "saa griber jeg om den krumme Luur",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 20,
      "text": "og blæser ud i den vilde Natur!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 20,
      "text": "Og naar da Skraldet runger over Jord og Hav",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 20,
      "text": "tænker jeg paa min Död og min Grav.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 20,
      "text": "Her sad nylig forelskede To.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 20,
      "text": "Jeg lider ei Kierligheds kielne Roe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 20,
      "text": "Den hele Natur er min Elskerinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 20,
      "text": "Gid jeg som de hvinende Vinde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 20,
      "text": "kunde styrte höit fra Skyerne ned",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 20,
      "text": "og favne alt! Det var Kierlighed!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 20,
      "text": "I Maaneskin titter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 20,
      "text": "vi Fugle saa smaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 20,
      "text": "bag Grenenes Gitter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 20,
      "text": "til hinanden og slaae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 20,
      "text": "Gudskelov vi er ene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 20,
      "text": "paa vore smaa Grene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 20,
      "text": "Naar kun vi har Roe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 20,
      "text": "til at hoppe frit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 20,
      "text": "o da er vi saa froe!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 20,
      "text": "saa froe! saa froe!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 20,
      "text": "Qvirilit! Qvirilit!",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
