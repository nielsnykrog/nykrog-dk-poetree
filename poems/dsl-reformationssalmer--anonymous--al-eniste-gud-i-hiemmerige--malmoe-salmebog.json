  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "AL eniste Gud i hiemmerige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "være loff oc priss for al sin naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "der han haffuer giort i iørderige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "i disse samme naadelige dage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Paa iorden er kommen stor glede och fred/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "menniskene mue vel gledis ved/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Gudz ynnist oc gode vilge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Vi loffue/ wi prise/ wi ære dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "wi tacke dig/ for din erlighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "O Herre Gud fader i hiemmerig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "du haffuer oss giort stor kerlighed/",
      "part": false,
      "marginal_notes": [
        "Roma v ii Pa xx"
      ]
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Alting haffuer du i din mact oc wold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "huad du vilt haffue fram/ kan ingen forholde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "vel dem som dig kunde frøcte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "O Jhesu Christ Gudz eniste Søn/",
      "part": false,
      "marginal_notes": [
        "Johan iii i Petri iii"
      ]
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "som hoss Gud Fader sider/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "du som haffuer frelst all menniskens køn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "oc oss met Gud forliget/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "formedelst dit blod och haarde død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "haffuer du oss løst aff synd och nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "giff naade wi i din tro bliffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Du est all ene vor frelsermand/",
      "part": false,
      "marginal_notes": [
        "Esa xliii Johan i Esaie lv Johan i"
      ]
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "der oss vil hiemmerige giffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "du est Gudz faders vskyldige lam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "der for oss døden vilde lide/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Du est all ene vor salighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "for din skyld haffue alle naade fangit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "almectiste Jesu Christe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "O helligand vor trøstermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "som oss all sandhed kan lære/",
      "part": false,
      "marginal_notes": [
        "Joan xiiii xv oc xvi i Petr v"
      ]
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "hielp oss ath bliffue ved din lærdom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "Gud fader oc Søn oc dig ere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "beskerm oss fra dieffuelsens falske list/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "hielp oss ath tro paa Jesum Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "nu oc euindelige Amen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Dominus vobiscum",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "Herren være met eder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 6,
      "text": "Oc met din aand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 7,
      "text": "Lader oss nu alle bede",
      "part": false,
      "marginal_notes": []
    }
  ]
}