{
  "id": null,
  "title": "122. Forsøger eder selv, om I i troen ere",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
