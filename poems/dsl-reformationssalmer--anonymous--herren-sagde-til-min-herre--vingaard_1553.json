  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "HErren sagde til min Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "sid hoss min høgre haand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Saa lenge ieg legger dine fiende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "til en fodskammel vnder dine føder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "⁕ Herren skal vdsende aff Sion din sterckhedz spire/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "haff herredømme mit iblant dine fiende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "⁕ Dit folck skal der vere veluillige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "hellige smycke paa din sterckhedz dage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "vd aff Moders Liff skal komme din fødzels dug met Morgen stund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "⁕ Herren haffuer sorid och det angrer hannem icke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "du est effter Melchizedecks skick en Prest euindelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "⁕ Herren vid din høgre haand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "skall sla Kongerne paa sin grumhedz Dag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "⁕ Han skal dømme iblant Hedningerne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "oc opfylde Dale met døde kroppe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "oc sønder sla ith hoffuit offuer mange Land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "⁕ Han skal dricke paa Veyen aff en beck/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 7,
      "text": "Derfaare skal han opløffte hoffuedet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "⁕ Ere vere Gud Fader och Gud Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 8,
      "text": "Ocsaa Gud den Helligaand",
      "part": false,
      "marginal_notes": []
    }
  ]
}