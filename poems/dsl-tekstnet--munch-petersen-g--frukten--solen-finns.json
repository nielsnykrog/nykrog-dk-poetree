  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "tungt andas kölden -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "djupt, djupt sänder jag mina rötter -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "- står luften ännu bunden vid horisonten,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "sover solen ännu så fjärran,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "att mina blommor måste längta mot rotens kyssar -,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "sover solen ännu så fjärran, att",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "kölden inget har att frukta -?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "- mina blommor börjar hata sin rot -",
      "part": false,
      "marginal_notes": []
    }
  ]
}
