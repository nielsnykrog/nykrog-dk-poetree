{
  "id": null,
  "title": "Gralver Kongesøn",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift II",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVII69.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Tet vaar Gralffuer kongens-sønn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hand skulle til Bern udride:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "der fant hand paa den lede orm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "i gresset saa monne hand skride.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: Det saae hand Gralffuer kongens-sønn under liden. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "\"Hør du, Gralffuer kongens-sønn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "huortt da vilt du ride?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "huem kiende dig den lønlige sti",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "under thisse grøne lide?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": ":: Tha suarid Gralffuer kongens sønn under liden. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "\"Alle de steder, der ieg kand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "thennem haffuer mig kiend vor frue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "end skal ieg weige din liede orm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "som guld skinner offuer din boffue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "\"Hør du, Gralffuer kongens-søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "vredis du icke ved mig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "see du under din sadel-bouff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "du rader endt beder dig.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": ":: Det giorde hand Gralffuer kongens søn under liden. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Hand saae under sin sadel-bonff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "de guld-nøgle saa smaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "\"Der-met skalt du til biergit gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "frelse din iomfrue saa god.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": ":: Da laa hand Gralffuer kongens søn under liden. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "Saa tog hand de nøgle saa smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "hand gick i biergit ind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "ther saae hand stalten Sylffuerlad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "hoss thend orm saa ledt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": ":: Det giorde Gralffuer kongens søn under liden. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": "\"Welkommen, Gralffuer kongens-søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "du est en rider med ære:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "Gud vere loffuit, du hiid kommen er,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "om du mig frelser tør.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": ":: Ia, sagde hand Gralffuer kongens søn under liden. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 7,
      "text": "Thet bleff saa mørct i biergit ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "hand kunde aldel intet see:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 7,
      "text": "saa saare hugh Gralffuer kongen-søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": "hand vor aff hiertet vee.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 7,
      "text": ":: Det giorde Gralffuer kongens søn under liden. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 8,
      "text": "Den iomfru fick hannem steen i haandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 8,
      "text": "den vaar som brendendis loffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 8,
      "text": "handt saae det guld, i bierget vaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 8,
      "text": "met glede och frydendis hoffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 8,
      "text": ":: Tha gledis Gralffuer kongens søn under liden. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 9,
      "text": "Det suarde iomfru Sylffuerlad:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 9,
      "text": "\"Men i haffue lidet den vonde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 9,
      "text": "ieg vill ether giffue thette møgle guld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 9,
      "text": "och vil gaa ether till haandt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 9,
      "text": ":: Tha suor Gralffuer kongens søn under liden. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 10,
      "text": "\"Ieg haffuer mig en iomfru loffuit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 10,
      "text": "i øster-kongens rige:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 10,
      "text": "ieg loffuit paa min christeligh tro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 10,
      "text": "ieg vilde hinde aldrig suige.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 10,
      "text": ":: Thet sagde Gralffuer kongens søn under liden. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 11,
      "text": "\"Ieg vil faa ether guld och sølff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 11,
      "text": "och der-til ridder och suenne:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 11,
      "text": "farer i ether til øster-kongens rige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 11,
      "text": "i henter eders tro igien.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 11,
      "text": ":: Thet sagde hun stalten Sylffuer-lad under liden. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 12,
      "text": "\"Hør i det, min skønne iomfru,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 12,
      "text": "ieg vil icke bryde min tro:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 12,
      "text": "ieg vil ether giffue saa høuisk enn ridder:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 12,
      "text": "Benedict, min yngiste broder.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 12,
      "text": ":: Thet sagde hand Gralffuer kongens søn under liden. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 13,
      "text": "\"Noch haffuer ieg baade guld och sølff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 13,
      "text": "och der-til riger och lande:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 13,
      "text": "maatte ieg ether sielffuer faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 13,
      "text": "foruonden vor al min vonde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 13,
      "text": ":: Det sagde hun stalten Sylffuerlad under liden. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 14,
      "text": "Saa gaff hun hannem saa megit guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 14,
      "text": "som hand vilde miest begiere:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 14,
      "text": "saa gaff handt hinde sin broder igien",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 14,
      "text": "met megen tuct och ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 14,
      "text": ":: Det giorde handt Gralffuer kongens søn under liden. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 15,
      "text": "Nu haffuer den rider och den stolte iomfrue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 15,
      "text": "foruanden al theris vande:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 15,
      "text": "nu soffuer hand hoss sin festemøe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 15,
      "text": "och hun hoss sin festemand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 15,
      "text": ":: Thet volde hand Gralffuer kongen-sønn under liden. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}