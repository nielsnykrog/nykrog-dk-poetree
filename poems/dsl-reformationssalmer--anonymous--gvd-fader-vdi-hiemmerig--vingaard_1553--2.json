  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "GVd Fader vdi hiemmerig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Gud Søn met HelligAand til lig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Du hellige Trefoldighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "en enniste Gud i euighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "paa din foriet bede wi deg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "At du vilt høre oss naadelig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "⁕ Spar oss o Gud oc hør vor Bøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "effter vor skyld giff oss icke løn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "forbarme deg offuer oss met din naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Liff Godz oc ære beuar fra skade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "O Herre ver oss naadig oc blid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "forkast oss icke til euig tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "⁕ Vent bort Satan den lede skand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "oc lad ham icke faa offuer hand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Men fri oss fra hans list oc suig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Lad Kødzens list ey drage oss fra dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "forlad oss icke slet met alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "om Verden vil oss offuerfalde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "⁕ Beuar oss Gud stat met oss fast/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "fri oss fra vildelse Synd oc last/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "fra krig oc strid oc affuind oc had/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "fra Vand oc Jld oc dyrtidz vrag/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "fra Pestelentz oc Siugdom mest/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "fra wtimelig veer oc blest.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "⁕ Frels oss Herre aff all vor nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 4,
      "text": "fra offuerfald skade oc brad død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 4,
      "text": "forkast oss icke slet met alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 4,
      "text": "naar du vilt oss til domme dag kalle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "fri oss fra euig dødzens fare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "O kære Gud oss vel beuare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 5,
      "text": "⁕ Vi arme Synder bede dig mær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 5,
      "text": "O Jesu Christe Herre kær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 5,
      "text": "for din fødzels skyld hielp oss snart/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 5,
      "text": "for din Opstandelse oc Hiemmelfard/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 5,
      "text": "for dit Blod pine och suare nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "for din Sued Kaarss oc Bitter Død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 6,
      "text": "⁕ Din Hellig Christelig Kircke reger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 6,
      "text": "styr hinne met ord oc rene ler/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 6,
      "text": "hennis forstander oc Predicker/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 6,
      "text": "Lad leffue et helligt leffnit met ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 6,
      "text": "met dit ord giff din Aand oc krafft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 6,
      "text": "at det gør fruct oc er vid mact.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 7,
      "text": "⁕ J din høst tro arbeder send/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 7,
      "text": "Sechter oc Ketteri affuend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 7,
      "text": "driff bort all falske fund oc lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 7,
      "text": "ath vildfarelse icke kommer mere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 7,
      "text": "hielp at vildfarelse oc ond rey/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 7,
      "text": "maa omuendis til sandhedz vey",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 8,
      "text": "⁕ Forstør dem met din veldige haand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 8,
      "text": "alle som din ord ville gøre modstand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 8,
      "text": "fri oss fra Tyrckens Tyranni/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 8,
      "text": "beholt din Kircke oc Rige fri/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 8,
      "text": "som Kaarss oc modgang lider her/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 8,
      "text": "thi det for dig behageligt er.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 9,
      "text": "⁕ Beskerme oc saa vort godz oc Liff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 9,
      "text": "vend bort all oprør Krig och kiff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 9,
      "text": "Keyser Konger oc alle Førster/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 9,
      "text": "giff naade at de maa ret regere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 9,
      "text": "vnd dem ath leffue met fred altid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 9,
      "text": "foruar dem fra tuedract oc strid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 10,
      "text": "⁕ Giff vor Herre oc Konning lycke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 10,
      "text": "at modstaa fiendernis mact oc tycke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 10,
      "text": "Hans Vndersot beskick oc saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 10,
      "text": "ath di maa vere hannem huld oc Tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 10,
      "text": "Rigens raad byer oc menige Mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 10,
      "text": "beskerm Gud met din Miskundz haand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 11,
      "text": "⁕ Alle dem som ære i nød oc fare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 11,
      "text": "send dem din hielp oc vel beuar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 11,
      "text": "trøst alle dem som bedrøffuit ere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 11,
      "text": "Deris anger fuld hierte for dig beter/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 11,
      "text": "Faderløse Børn oc Encker met/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 11,
      "text": "forse dem vel huer i sit stedt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 12,
      "text": "⁕ Siugelige Quindfolck hielp oc saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 12,
      "text": "met diende Børn oc andre smaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 12,
      "text": "och alle som ere skrøbelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 12,
      "text": "Som setter deris trøst all ene til dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 12,
      "text": "gør dem til Siælen karsk oc sund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 12,
      "text": "stat met dem i deris siste stund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 13,
      "text": "⁕ O Kære Herre giff dem gaat taal/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 13,
      "text": "som lider forfylgelse vden brøden all/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 13,
      "text": "och red dem aff deris Fienders vold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 13,
      "text": "lad fengsellit dem ey lenger hold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 13,
      "text": "trøst dem oc saa i døzens kiff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 13,
      "text": "som for nogen sag skal lade deris Liff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 14,
      "text": "⁕ Alle dem som monne vore fiender vere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 14,
      "text": "forlad deris Synd er vor begere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 14,
      "text": "vnd oss at wi oc gierne til giffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 14,
      "text": "oc kerlig met huer mand at leffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 14,
      "text": "hielp vaare fiender sig om at kere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 14,
      "text": "oc aff hiertet din naade begere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 15,
      "text": "⁕ O Herre giff fruct vdi vaare Land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 15,
      "text": "oc signe hinde met din milde haand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 15,
      "text": "beuar hinde fra wuenner oc skade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 15,
      "text": "at bruge hinde ret giff oss din nade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 15,
      "text": "ath hun skulle icke vore hierter besuare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 15,
      "text": "saa wi tage hinde for megit vare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 16,
      "text": "⁕ O Jesu Christ Gud Faders Søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 16,
      "text": "O Jesu Christe naadzens thron/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 16,
      "text": "O Jesu Christ Gudz Hellige Lam",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 16,
      "text": "som alle Verdzens Synder bort nam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 16,
      "text": "du velsignet sæd hør vor Bøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 16,
      "text": "forbarme dig offuer oss alle AMEN.",
      "part": false,
      "marginal_notes": []
    }
  ]
}