  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Her visiteres paa dette Sted.",
      "part": false,
      "marginal_notes": [
        "Speaker: VISITEUREN"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Siig mig derfor, hvad De bringer med?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Jeg vil Dem tro; Deres Ord er sandt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Bringer De intet contrabandt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Kostbare Sager er i min Vold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Dog vil jeg tro, jeg slipper for Told!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Jeg eier Drømme, Længsel og Lyst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Tegnet med Sort, dybt i mit Bryst;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Brogede Blomster, som Hjertet har skabt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Den Gang det følte de jordiske tabt’!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Kjærligheds Perle bringer jeg med;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Den har jeg kjøbt for min Ro og Fred!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Perlen er dunkel, men straaler dog klar, –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Alle de andre Skatte jeg har,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Flettes de end i den yndigste Krands,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Faae dog alene fra denne sin Glands!",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
