  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Før drømte jeg fast hver eneste Nat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Jeg havde dit Hjerte vundet;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Ak, hvor var Dagen da mørk og mat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Naar Mulmet igjen var svundet!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Nu plager en Drøm mig saa tung og svar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Den at jeg dit Hjerte har mistet;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "O, hvor er Dagen da lys og klar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Naar Mørket sig bort har listet!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
