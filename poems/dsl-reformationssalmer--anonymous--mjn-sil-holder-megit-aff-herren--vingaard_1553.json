  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "MJn Siæl holder megit aff Herren/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Och min Aand frøyder sig i Gud min Frelsere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Thi han haffuer seet till sin Tiænerindis fornedering/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "derfaare/ see/ nu fra denne tid skulle alle slecter sige mig at vere salig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "Thi han haffuer giort merckelige mod mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "som er mectig/ huess naffn er oc helligt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Oc hans miskundhed recker fra den ene slect oc til den anden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "offuer den som frycte hannem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "Han haffuer giort mectige Gerninger met sin Arm/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "han haffuer forspred de hustolte aff deris hiertens grund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 5,
      "text": "Han haffuer neder støt de veldige aff sædet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "oc de fornedrede haffuer han ophøyt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 6,
      "text": "De hungrue haffuer han mettet met det som gaat er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "och de Rige haffuer han forladet Tombugede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 7,
      "text": "Han haffuer tenckt paa sin miskundhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "oc ophulpet sin Tiænere Jsrael",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 8,
      "text": "Som han tilforn haffde tilsagt vore forfædre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "Abraham oc hans affødinge at holde euindelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 9,
      "text": "Ere vere Gud Fader oc Søn oc den Helligaand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "Som haffuer verit aff begyndelsen och nu och altid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "Fra euighed och till euighed Amen",
      "part": false,
      "marginal_notes": []
    }
  ]
}