  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "NAar Gud fonger løst Sions fengsel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "som en Drøm da skal synis vort trengsel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Da fyldis wi saa aff glæde oc frøyd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "at mand maa sige/ Gud haffuer oss ophøyd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "⁕ Gud haffuer oc nu beuist sig vel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "At wi mue glæde oss met skel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Men vilde Gud plat ende vor Synd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "som Becke tyrckis aff Solens brynde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "Da vilde wi gerne grædelige saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "paa det wi motte fruct met glæde faa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 5,
      "text": "Thi saadant arbeyde hør her til/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "huo som liffuit haffue vil",
      "part": false,
      "marginal_notes": []
    }
  ]
}