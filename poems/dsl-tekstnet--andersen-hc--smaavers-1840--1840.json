  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Du elsked’ Een før mig, jeg det nok veed –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Jeg skjænker Dig Din første Kjærlighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Sad her et lille Speil i Krogen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Og De, min Frøken, saae deri,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Det bedste Billede i Bogen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Det stod da her – her forrest i!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Et lille Vers jeg gjerne sige vilde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Men De maa love mig: bliv ikke rød!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Hvis Holberg havde seet Dem som Pernille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Han var bestemt som Pebersvend ei død.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
