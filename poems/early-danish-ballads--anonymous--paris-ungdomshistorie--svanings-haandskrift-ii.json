{
  "id": null,
  "title": "Paris' Ungdomshistorie",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift II",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVII58.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Priami droning drømpte om natten en drøm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "der hun skulle søffuen soffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Priamus koning rade det bratt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "saa lidet motte hun de loffue;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "hun drømpte en brand fall aff hindis haandt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "oc brende op Troeborg oc alt dett landt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "den drøm vor raadt, før Paris bleff født,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "at Troyborg bleff for ham øød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": ":: Min kiere frowe, hielper aff eders formue. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Saa bratt som Paris hand vor fødd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "den eddelige creatur,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "saa snart bleff hand till skowen ført,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "blant løffuer oc vilde diur;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "fruer oc iomffruer ham bort bar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "ridder oc suenne vor der udi raadt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "de strød offuer ham løff oc gress,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "di gick til liy;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "mangen mand kand for skiælien syne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "hand kand dog icke fly.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Den møller giende sin fee paa marck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "som hand vor von at giøre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "saa fand hand paa den eddelige barn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "saa vell mone hand om lade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "y silcke god da vor hand suøbt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "saa vel daa bleff den møller aff bøtt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "hand tog ham op, hand bar ham hiem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "hand lod vell om:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "\"Kye du nu den eddelig art,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "du est aff kommen.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Paris hand voxid, saa vel hand trøffuis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "oc mølleren ham vel føde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "med bønder da vocte hand fee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "bleff stercker mand oc stor;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "Paris ypped dem en laug,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "alle de andre der vid tog:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "\"Wy ville lade vore tiure til samen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "oc fecte paa it heste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "wi staa saa nær, vi see der paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "y huilcken her haffuer best.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "Det skeede sig saa, den møller tiur",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "bleff høffding for dem alle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "saa barr de der lodder om,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "y huem som koning skulle kaldis;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "alt daa fald de lodder saa till,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "at Paris bleff koning oc skickett dem skiell:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 4,
      "text": "\"Er her nogen der stiele vill oc giørre osz men,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 4,
      "text": "ham henger wi i høggen green.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "Den ene bleff sig icke vilder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 5,
      "text": "for hand staal sig en kniff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 5,
      "text": "hand motte icke met mindre vndkomme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 5,
      "text": "en dett skulle gielde hans liff:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 5,
      "text": "\"Kiere her Paris, i retter her paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 5,
      "text": "ieg er den første, der skaaden mone faa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 5,
      "text": "Lenge stod Paris oc tencte ved sig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 5,
      "text": "\"Suenne, i læder oc spørger att den,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 5,
      "text": "som stielle vill oc ende.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 6,
      "text": "Den beste bonde søn y den hob",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 6,
      "text": "da bleff den kniff met funden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 6,
      "text": "de lætte op den feirste træ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 6,
      "text": "som fraa roden vor oprunden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 6,
      "text": "de hende ham i galli oc træ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 6,
      "text": "de løste ham ey for guld eller fæ;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 6,
      "text": "saa brat alt som den gierning vor giort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 6,
      "text": "saa snart vor det for bonden førdt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 6,
      "text": "\"Paris heder den møller søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 6,
      "text": "som dett haffuer giort oc er.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 7,
      "text": "Bonde god samblit sine mendt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 7,
      "text": "til møller husz at fare:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 7,
      "text": "\"Huor estw becke møller,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 7,
      "text": "din søn haffuer giort stor skaade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 7,
      "text": "din søn haffuer ilde giort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 7,
      "text": "hand haffuer min søn til gallin ført.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 7,
      "text": "Op stod mølleren hand bød for log",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 7,
      "text": "oc gick til suars:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 7,
      "text": "\"Priamus kong aff Troyeborg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 7,
      "text": "hans fader er oc end.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 8,
      "text": "Paris bleff met mact bort førd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 8,
      "text": "till Priami konings gaard oc adspurd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 8,
      "text": "\"Huor haffuer du numid den stercked log,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 8,
      "text": "du haffuer i landet giort.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 8,
      "text": "\"Min kier fader, er det icke skiel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 8,
      "text": "at henge op den, der stiele vill.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 8,
      "text": "Daa ville op de lønlige tale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 8,
      "text": "som lenge haffuer vered y duale:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 8,
      "text": "Paris vor icke møller søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 8,
      "text": "end dog hand vor saa kalled.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 9,
      "text": "Hans fader gaff ham sadel oc hest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 9,
      "text": "hand sende ham vdaff lande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 9,
      "text": "hand sende ham til Grækenlandt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 9,
      "text": "hin rige kong Nielus paa haandt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 9,
      "text": "Paris udaff landet foer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 9,
      "text": "dett bleff kong Nielus til sorrig stor;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 9,
      "text": "hand gick i gaarde, hand tog vid troo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 9,
      "text": "hand gaff ham suerdt, met suig hand tog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 9,
      "text": "hand tiente hannem met lønlig suig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 10,
      "text": "Paris lagde vind der paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 10,
      "text": "droning Ellin ville hand gilli,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 10,
      "text": "det giorde hun for hans skønheds skyldt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 10,
      "text": "hand fremid all sin villie;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 10,
      "text": "saa brat kong Nielus dett fraa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 10,
      "text": "saa vred bleff hand paa Paris da;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 10,
      "text": "saa snart droning Ellin vreden kiende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 10,
      "text": "saa snart hun Paris til closter sende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 10,
      "text": "Her skulle y closter bliffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 10,
      "text": "der mone hand euentyr driffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 11,
      "text": "Paris lod sig kleder skiere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 11,
      "text": "all vdi nunne legge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 11,
      "text": "fruer oc iomffruer de tiente ham vel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 11,
      "text": "de vilde icke fra ham vige;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 11,
      "text": "de tiente ham saa lenge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 11,
      "text": "de baare kinder bleege,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 11,
      "text": "stor skiempt hand met dem dreff;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 11,
      "text": "saa monne hand met dem leege,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 11,
      "text": "alle fick fruer lastin hin store,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 11,
      "text": "oc ingen fick bod *.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 12,
      "text": "Koning Nielus sidder offuer breden bordt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 12,
      "text": "oc lader hand spørre saa viide:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 12,
      "text": "\"Viderick, i er i veyen viisz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 12,
      "text": "viser mig herre Paris.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 12,
      "text": "Lenge saadd Viderick, den eddelig mandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 12,
      "text": "hand suarid der till:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 12,
      "text": "\"Paris er i iomffru closter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 12,
      "text": "hand giør gott skiel.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 13,
      "text": "Slig er Paris for andre mendt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 13,
      "text": "som leffue for vilden diur;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 13,
      "text": "i huad hand vill, y huad hand maa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 13,
      "text": "alle de fruer der ham saa;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 13,
      "text": "hans how er mild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 13,
      "text": "hans hierte er vell met elskow begaffuit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 13,
      "text": "blant scriffuere eller klercke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 13,
      "text": "daa er ey hans lige till vercke.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 13,
      "text": ":: Kiere fruer, hielper, om y moue. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}