  "source": {
    "id": null,
    "title": "Een ny handbog med Psalmer oc aandelige lofsange",
    "year_published": 1529,
    "publisher": "Ludwig Dietz",
    "printer": "Ludwig Dietz",
    "place": "Rostock",
    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/dietz-salmebog-1529/6"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "CHrist laa ÿ dødzens bond/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "for wore synder giffuen/",
      "part": false,
      "marginal_notes": [
        "Mat xxviij"
      ]
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Han er igien opstanden:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "bar oss thet ewige leffnid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "att wÿ skulle alltÿd wære glad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "hanwm tacke oc prÿse ÿ allen stad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "oc siunge Alleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Døden kunde ingen twinge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "blant alle menniskens sønner/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Thet giorde alt wore synder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "ingen wskyldig wor att finde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Ther aff tha kom then død saa snart/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "fick macht offuer oss med een fart/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "holt oss ÿ sitt rÿge fangne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Jesus Christus Gud faders søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "ÿ wort stæd er kommen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "wid hanwm faa wÿ then ewige løn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "oc døden er offuerwunden/",
      "part": false,
      "marginal_notes": [
        "Osee. xiij."
      ]
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "All sÿn rett oc all sÿn macht/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "som wÿ wore vnderlagt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "borttog Christi død allene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Ther wor een gantske vnderlig krÿ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "ther døden oc lÿff the stridde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "liffuit fick tha macht oc offuerhand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "oc monne døden afliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Schrifften haffuer oss thet kund giord/",
      "part": false,
      "marginal_notes": [
        "Osee. xiij. j. Corin. xv Exodi. xj. j. Petri. j."
      ]
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "att Christi død bedreff thet mord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "eet spott aff døden er worden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Her er thet rette paaschelam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "om huilkit Gud haffuer budit:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "Thet er thet som paa korsit kom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "for wor skyld stegt oc dødet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "thets blod stenckis paa wore dørre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "oc holler døden wdenfore/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "Then mørdenær kan oss ey røre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Saa fÿre wÿ thet høge fest/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "med hiertens frygd oc winde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "att Jesus Christus er oss næst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "sÿn naade lader han oss skine:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "Han er sielff rettwÿshedzens liwss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "som opliwser wor hiertis hwss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "Syndzens natt hun er bortgangen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "Aff thet sande paaschelam",
      "part": false,
      "marginal_notes": [
        "j. Corin. v. Math. xv. Johan. vj."
      ]
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "æde wÿ oc saa leffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "then gamle swrdey menniskens lærdom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 6,
      "text": "Guds ord skall han nw wÿge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 6,
      "text": "Christus han er then sande mad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 6,
      "text": "som bespÿser then Christne stad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "Troen kan ey andet lÿde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 7,
      "text": "Han frelste oss fraa død oc synd/",
      "part": false,
      "marginal_notes": [
        "Esaie. liij."
      ]
    },
    {
      "id": 50,
      "stanza_id": 7,
      "text": "alt med sÿn bittre pÿne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 7,
      "text": "Er han oss bleffuen opstandelsen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 7,
      "text": "retferdighed monne han giffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 7,
      "text": "Stat op aff søffne all Christenhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 7,
      "text": "lad mørckens gierninger wære teg leed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 7,
      "text": "Retferdelig leff ÿ Christo Jesu.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 8,
      "text": "Pharaonis machtt then grumme mand/",
      "part": false,
      "marginal_notes": [
        "Exodi. xv. oc. xvij."
      ]
    },
    {
      "id": 57,
      "stanza_id": 8,
      "text": "er fordømdt med alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 8,
      "text": "Wid Jesum Christ wor frelsermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 8,
      "text": "oss aff Egypten han kalde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 8,
      "text": "Her haffue wÿ sand Mosen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 8,
      "text": "som wdledde alt Jsraels køn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 8,
      "text": "fraa syndzens trældom til hiertens lÿse.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 9,
      "text": "Loff prÿss oc ære wære teg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 9,
      "text": "Dauid/ O Christe wor Konning/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 9,
      "text": "som stridde for oss mandelig/",
      "part": false,
      "marginal_notes": [
        "Actu. vij."
      ]
    },
    {
      "id": 66,
      "stanza_id": 9,
      "text": "Goliat er offuerwunden/",
      "part": false,
      "marginal_notes": [
        "j. Reg. xvij"
      ]
    },
    {
      "id": 67,
      "stanza_id": 9,
      "text": "som lagde wind paa med all sÿn wold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 9,
      "text": "att forderffue Jsraels skiold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 9,
      "text": "Thit aandelig Jsraels folk seg glæder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 10,
      "text": "KYrie Gud fader forbarme teg offuer oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 10,
      "text": "Christe tw æst wort lÿff oc opstandelse /",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 10,
      "text": "forbarme teg offuer oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 10,
      "text": "Kyrie Helliaand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 10,
      "text": "hielp oss wor trøstermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 10,
      "text": "forbarme teg offuer oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 10,
      "text": "Kyrie wor Gud oc Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 10,
      "text": "miskunde teg offuer oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 11,
      "text": "GVds Engel sidder hooss graffuen/",
      "part": false,
      "marginal_notes": [
        "Matthei. xxviij. Marci. xvj"
      ]
    },
    {
      "id": 79,
      "stanza_id": 11,
      "text": "Er ÿførd klarhedzens klædebon/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 11,
      "text": "Hwilken qwinnerne soghe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 11,
      "text": "oc bleffue forfærede aff meghen rædzle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 11,
      "text": "stoendis langt fraa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 12,
      "text": "Aerens konnig o Christe Alleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 13,
      "text": "O Fader wdi himmelen/",
      "part": false,
      "marginal_notes": [
        "Math. vj."
      ]
    },
    {
      "id": 85,
      "stanza_id": 13,
      "text": "wid thÿn søn hør wor bøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 13,
      "text": "Han er oss fød oc giffuen wist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 13,
      "text": "till all wor hielp oc trøst/",
      "part": false,
      "marginal_notes": [
        "Luce. xj."
      ]
    },
    {
      "id": 88,
      "stanza_id": 13,
      "text": "wer oss mild o fader Alleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 14,
      "text": "Hwilken som wor død oc for oss giffuen Alleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 15,
      "text": "O Christe Konning ÿ ewighed/",
      "part": false,
      "marginal_notes": [
        "Psalmo. ij."
      ]
    },
    {
      "id": 91,
      "stanza_id": 15,
      "text": "Wÿ bede wær oss blÿd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 15,
      "text": "Tw som døden haffuer forderffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 15,
      "text": "oss salighed forhuerffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 15,
      "text": "bønhør oss o Herre Alleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 16,
      "text": "Han er opstanden som han sagde/",
      "part": false,
      "marginal_notes": [
        "Matthei xxviij."
      ]
    },
    {
      "id": 96,
      "stanza_id": 16,
      "text": "Han er opfaren som han sagde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 17,
      "text": "¶ Loffuer Herren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 18,
      "text": "Helliaand wor bøn til teg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 18,
      "text": "O Gud wor trøstermand/",
      "part": false,
      "marginal_notes": [
        "Joh: xiiij. oc. xvj."
      ]
    },
    {
      "id": 100,
      "stanza_id": 18,
      "text": "Samwittighedzens trøst/ hiertens løst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 18,
      "text": "Affslætt alle Christens brøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 18,
      "text": "Fred oc glæde giff oss. ¶ Loffuer Herren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 19,
      "text": "Bed Gud for oss Alleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 19,
      "text": "Loffuer Herren Alleluia Alleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 20,
      "text": "Konningens dother aff ewighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 20,
      "text": "Christi brud glæder seg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 20,
      "text": "For then hun haffuer ÿ aanden vndfangen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 20,
      "text": "han er som han sagde opstanden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 21,
      "text": "Han er som han sagde opfaren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 22,
      "text": "Hun seg paa Gud forlader Alleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 23,
      "text": "CHristus Jesus for oss offrid /",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 23,
      "text": "then loffue wÿ alle Christne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 23,
      "text": "Guds lam haffuer igienløøst sÿne faar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 23,
      "text": "Christus vskyldig haffuer forlÿgt Gud fader oss alle syndere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 24,
      "text": "Død oc lÿff haffue nw strid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 24,
      "text": "lÿffzens høffding som war død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 24,
      "text": "Christus nw leffuer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 24,
      "text": "altÿd skall regnere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 25,
      "text": "Sig oss nw Maria/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 25,
      "text": "hwad tw haffuer paa wæyen seet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 25,
      "text": "Jeg saa then leffuendis Christi graff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 25,
      "text": "Oc ieg saa hans ære som war opstanden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 26,
      "text": "Jeg saa Guds Engle oc iordeklæder till witnesbyrd: Christus wort haab wist opstanden er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 26,
      "text": "oc han skall eder møde ÿ Galilea.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 27,
      "text": "Marie rette witnesbyrd er fast meere troligt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 27,
      "text": "en alle Jødernis falske ord oc løgen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 28,
      "text": "Wÿ thet sandelig wÿde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 28,
      "text": "att Christ stod op aff døde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 28,
      "text": "o Christe Konning forbarme teg offuer oss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 28,
      "text": "Alleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 29,
      "text": "CHrist stod op aff døde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 29,
      "text": "Frelste all werden aff nøde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 29,
      "text": "Thÿ maa wÿ alle glade wære/",
      "part": false,
      "marginal_notes": [
        "Matthei. xxviij."
      ]
    },
    {
      "id": 134,
      "stanza_id": 29,
      "text": "oc siunge Christ loff med heder oc ære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 29,
      "text": "Kyrioley.",
      "part": false,
      "marginal_notes": []
    }
  ]
}