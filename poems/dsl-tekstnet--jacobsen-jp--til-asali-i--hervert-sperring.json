  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Jeg var et Rov for vilde Sandsedrømme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Min Vilje svag var og min Tanke sløv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Og uden Modstand ned ad Syndens Strømme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Jeg gled for hver en Frelse blind og døv.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Men da saa mig din friske Purpurlæbe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "At du mig elsked, fik i Kysset sagt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Da følte undrende jeg i mig stræbe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Mod Lyset frem en hidtil ukjendt Magt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Jeg følte, stolt ved, at en saadan Kvinde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Sin Skjæbne voved lægge i min Haand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "At nu i Livets Kamp jeg kunde vinde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Opmuntret, elsket af en saadan Aand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Og derfor er min Gjæld til dig saa vægtig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "At ej den løses kan med Livet selv;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Thi du for Evighed mig frelste mægtig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Idet du gav mig Troen paa mig selv.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
