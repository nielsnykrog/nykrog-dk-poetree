  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Min Siel ophøyer Herren/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc min Aand glæder sig i Gud min Frelsere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Thi hand haffuer anseet sin ælendige Tienerinde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "See her effter skulle alle Børns børn prise mig Salig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "Thi hand haffuer giort store ting mod mig/ som er mectig: Oc hans Naffn er helligt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 3,
      "text": "Oc hans Barmhiertighed varer vden affladelse stedse oc altid/ Hoss dem som hannem frycte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 4,
      "text": "Hand bruger Mact met sin Arm/ Oc atspreder dem som ere Hoffmodige i deris Hiertis sind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 5,
      "text": "Hand støder de Mectige aff stolen/ Oc ophøyer de Ælendige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 6,
      "text": "De Hungrige fylder hand met gaat/ Oc lader de Rige tomme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 7,
      "text": "Hand tencker paa Barmhiertighed/ Oc hielper sin Tienere Jsrael op.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 8,
      "text": "Som hand sagde til vore Fædre/ Abraham oc hans Sæd euindelige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 9,
      "text": "Christum vor Salighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 9,
      "text": "euige Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 9,
      "text": "Mariæ Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 9,
      "text": "prise wi vdi euighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 9,
      "text": "Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 10,
      "text": "Herre/ lad nu din Tienere fare i Fred/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 10,
      "text": "lige som du haffuer sagd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 10,
      "text": "Thi mine øyen haffue seet din Frelsere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 10,
      "text": "huilcken du beredde for alle Folck.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 10,
      "text": "Jt liuss at opliuse Hedningene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 10,
      "text": "oc dit Folck Jsrael til en Herlighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "Ære være Fader oc Søn oc den hellig Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 10,
      "text": "som det vaar i begyndelsen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 10,
      "text": "oc bliffuer nu oc altid i euighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 10,
      "text": "Amen.",
      "part": false,
      "marginal_notes": []
    }
  ]
}