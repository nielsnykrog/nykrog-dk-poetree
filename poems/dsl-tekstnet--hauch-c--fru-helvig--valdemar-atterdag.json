{
  "id": null,
  "title": "Fru Helvig",
  "year_created": 1861,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Carsten Hauch",
    "country": null,
    "wiki": "Q688529"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Valdemar Atterdag",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1861,
    "url": "https://tekstnet.dk/books/hauch-c_valdemar-atterdag/010/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Hr. Eckhard og Fru Helvig heel tidt hinanden saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "De mødtes i Hallen, naar Mørket faldt paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "De mødtes og i Lunden paa den eensomme Vei,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Men Dankongen lod, som han mærked det ei.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "En Aften da Hr. Eckhard hos Dronningen sad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Han hvisked: »Eders Herre gjør Jer nok lidet glad;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Dog stol paa Jer Broder, der ved Slien mon boe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Dertil paa Holsteens Grever, de er Jer huld og troe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Hvis I da mærker Noget til Dankongens Spil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "I bør det ei fordølge, men skrive dem det til,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Og vil I da blot lyde vort hemmelige Raad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Visselig skal vi standse Jer Kummer og Graad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Jer Andagt og Jer Gudsfrygt er vidt i Landet kjendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Men med Kong Volmers Fromhed er det nok slet bevendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Og turde han det vove, han lagde Kirken øde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Han raner ofte Kalk og Disk for sine Mænd at føde.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Sukkende svared Helvig: »Det tidt mig voldte Sorg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "At sanke Guld og Rigdom, at vinde Slot og Borg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Derefter kun han higer, kun Eet han tænker paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "At samle det delte Danmark, hvordan det saa skal gaae.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Svared Hr. Eckhard listig: »Han tænker Eet endnu,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "At tale med Fru Tove, dertil staaer hans Hu,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Skeer det ei ved Dagslys, det skeer ved Midnatstide.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "Da blev Fru Helvigs Kinder som et Liinklæde hvide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Hun reiste sig og iled til Vinduet hen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Hun sagde: »Der seer jeg Kongen, han rider ud igjen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Hvor rider han saa silde, jeg kan det ei forstaae?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "Er det nu Tid at jage, da Natten falder paa?«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "- »I ligner de tause Stjerner paa Himmelens Vei,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "I gaaer Jer stille Bane og taler derom ei,«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "Saa mæled Ridder Eckhard, »det er Jer vante Skik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "Dog læser jeg skjulte Tanker i Jert tindrende Blik.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "Kong Volmer, Eders Herre, har vist en stor Forstand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Muligt, at dog han finder i Jer sin Overmand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "Han bruger mange Kunster, han kjender mangen List,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "Dog i den Kunst at tie I overgaaer ham vist.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "Pludselig udbrød Helvig: »Jeg er vel nødt dertil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Jeg maa min Tanke skjule, dog nu jeg tale vil:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "Hun eller jeg maa falde, nu Ordet er sagt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "Hun har omspundet Kongen med farlig Tryllemagt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "Der gives stærke Runer, kastes de for vor Fod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Det næsten er umuligt at staae dem imod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "Dem har hun lært tilvisse, dem monne hun vel forstaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "Bliver hun her i Danmark, maa jeg til Grunde gaae.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "Gjensvared Hr. Eckhard: »Det er en farlig Sag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Hr. Henning hende vogter ved Nat og ved Dag;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "Mens Kongen er i Leding, Henning hans Høvedsmand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "Skal blive her tilbage og værne Sjællands Strand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "Mig følger kun min Væbner og dertil tvende Mænd;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "Men hvis I kan vente, til jeg kommer igjen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "Med flere stærke Kæmper, og I mig hjelpe vil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "Muligt kan da det lykkes, hvad Eders Hu staaer til.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 13,
      "text": "Ham svared Fru Helvig: »Hun her ei blive kan,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "Gift hende med en Træl, der boer i et andet Land!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "Dog jeg maa synes reen og for Mistanke fri,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "Det kunde blive farligt, hvis jeg blanded mig deri.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "- »Naar Volmer først er borte, kan hun ei skade Dig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Men vender han tilbage, da stol kun paa mig!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "Saa mæled Ridder Eckhard, han Hallen forlod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "Det syntes, som Kong Volmer ei deres Færd forstod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 15,
      "text": "Da mødte Herr Eckhard Ditlef, sin gode Svend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "Han sagde: »Vi har ved Hoffet endnu dog en Ven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "Saa siger et gammelt Ordsprog: Mands List er vel behænde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "Men Qvindelist er større, thi den er uden Ende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 16,
      "text": "Muligt dog det Ordsprog vil denne Gang slaae feil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "Tovelil vil hun fange, det klare Jomfruspeil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "Dog vi vil fange Kongen, det er et bedre Spil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "Og uden at hun veed det, skal hun hielpe dertil.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 17,
      "text": "Thi uden Guld og Pendinge ei vindes denne Krig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "Men Helvig eier Skatte, hun synes meget rig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "Jeg vil da samle Stridsmænd i Tydskland, vort Hjem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "Men det er saare billigt, at hun betaler dem.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 18,
      "text": "- Fru Helvig lod en Troldqvinde hente til sin Borg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "Ei heller for hende hun dulgte sin Sorg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "Da neied sig og sagde den alderstegne Qvind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "»Vel kjender jeg den, der kan vende Kongens Sind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 19,
      "text": "Jeg kjender vel en Mester, han Kunsten forstaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "I Vælskland han fødtes, heel Meget han formaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "Paa Vindens Hest han rider over Krat, over Torn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "Han seiler over Havet paa Eisdyrets Horn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 20,
      "text": "Og han kan vende Veiret blot ved sin Stemmes Klang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "Og han kan standse Stormens og Stjernernes Gang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "Og lære Skovens Ulve at trække Bondens Plov.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "- »Ja«, svared Fru Helvig, »jeg har alt hørt hans Lov.«",
      "part": false,
      "marginal_notes": []
    }
  ]
}
