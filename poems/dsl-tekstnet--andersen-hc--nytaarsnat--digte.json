    "url": "https://tekstnet.dk/books/andersen-hc_digte-1830/006/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "– Nu slumrer Hoben i den store Stad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "I usle Vraa den Arme drømmer glad;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Ham Natten dækker med de dunkle Vinger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Og ei han drømmer, hvad ham Dagen bringer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Et Nu – og Aaret synker i sin Grav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Det nye stiger frem af Tidens Hav –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Seer Du hvor bleeg, hvor kraftløs Gubben staaer?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Tolv Maaneder alt hvidnede hans Haar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Den korte Tid Dig ikke undre maa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Een Nat, blot een, kan gjøre Lokken graa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Farvel, Du Gubbe med Din Børneflok,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Du gaaer til Hvile, Du har kjæmpet nok,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Din Ild er slukket, brudt Din Vandrings-Stav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Snart visner ogsaa Krandsen paa Din Grav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Dens Blomster flagre hen i Nattens Vinde; –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Var det hiint store Maal Du vilde finde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Hvad hjalp nu al Din Stræben, al Din Lyst?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Et Aar – og Døden isnede Dit Bryst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Vort hele Liv er jo saa brat, saa brat;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "– Et Stjerneskud i Evighedens Nat –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "Et Skridt fra Intet til et Intet atter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "Hvad eller til – hvad ikke Tanken fatter!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "See, fra den Dødes Grav et Barn fremstaaer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "Med friske Blomster i det lyse Haar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "Kan Gravens Søn vel bringe Haab og Lyst?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "Nei, isne vil han mangen Broders Bryst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "– Dog skee hvad vil! – Hvo kan mod Aander kjæmpe?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "Kun Dødens Iis kan Hjertets Flamme dæmpe! –",
      "part": false,
      "marginal_notes": []
    }
  ]
}
