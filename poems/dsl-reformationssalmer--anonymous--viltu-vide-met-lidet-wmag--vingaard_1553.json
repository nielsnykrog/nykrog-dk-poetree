  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "⁕ Viltu vide met lidet wmag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Første ny effter Kyndermisse dag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "⁕ Første Onssdag nest effter kommer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Da haffuer du Faste met kuld oc hunger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "⁕ Der faare kan ingen sige ney",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Huad heller det er skudaar eller ey.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Vor Herris Aduent hun oss paa gaar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Den Søndag for Barbare men verden staar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Onsdagen effter aske wi Tamperdage faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Onsdagen i Pinds wge lige saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Onsdagen effter hellig kaarssis fest",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Onsdagen effter Lucie komme tamperdagene vist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Lamberti oc paa Gregorii tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Er dagen oc natten lige vid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "Sancte Clemind vil oss Vinteren giffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "Sancte Peder vil oss mayen vddriffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Sommeren fører sancte Vrban",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Men høsten sancte Symphorian",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "At æde oc dricke oc gøre sig glad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 5,
      "text": "vdi vermme oc met løst det er mit raad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Lad icke aarer/ ey smør dine been",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Om du vilt leffue for vden meen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Men temmer at hugge oc huss at bygge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "Loffuer ieg dig met alle trygge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Jeg heder Blidel kender du meg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Men gaar du nøgen det angrer deg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "J min tid maat du blodit lade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "oc tære vel til redelig maade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "Fødderne smørre oc dennem viske",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": "steder icke tegnet som kallis Fiske",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "Jeg snider vintre oc renser min haue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "oc less min Eng i disse daue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "J min tid skalt du blod ey lade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 7,
      "text": "men det er sunt vel varmt at bade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 7,
      "text": "Lad ey aarer paa dit Hoffuit slaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "nar Vædren monne vdi mig i gaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "⁕ Faare Maane det er mit naffn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 8,
      "text": "met plogen gøre da Bønder gaffn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 8,
      "text": "Vdi min tid da tag dig an",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 8,
      "text": "at lade sla din Median",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 8,
      "text": "Dine ørne at lade kan dig ey baade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 8,
      "text": "Dit skæg at rage vil ieg ey raade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 9,
      "text": "Her kommer ieg May bode stolt oc bold",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 9,
      "text": "met grøne Vrter saa mange fold",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 9,
      "text": "J mit skyn man siunge oc springe maa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 9,
      "text": "baade dag oc nat i Dantzen at gaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 9,
      "text": "Naar ieg er vdi Tuillings gade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 9,
      "text": "da skalt du ey blod aff Armene lade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 10,
      "text": "⁕ Her skal Bonden fare til skou",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 10,
      "text": "oc hente sin Ved met megen vrou",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 10,
      "text": "Mand pleyer ey gierne Aarer at slaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 10,
      "text": "i min tid/ eller ørckeløss gaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 10,
      "text": "J Krabbens tegen haffuer ingen lyst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 10,
      "text": "din Lunge Aare lade/ Leffuer eller bryst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 11,
      "text": "¶ Her skalt du gaa paa Marck met Lee",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 11,
      "text": "det er saa tid det kant du see",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 11,
      "text": "Sky da Lægedom/ lad ey dit blod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 11,
      "text": "naar Løuen besuarer din hierte rod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 11,
      "text": "Før dig icke vdi klæder ny",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 11,
      "text": "du skalt oc alle Gestebud fly",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 12,
      "text": "⁕ Her skal Bonden gaa at skære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 12,
      "text": "met glæde sit korn til sammen bære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 12,
      "text": "Oc haffue om høsten arbeyd oc møde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 12,
      "text": "oc dricke om vinteren Miøden hind søde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 12,
      "text": "Naar Jomffruen monne i maanen staa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 12,
      "text": "da skalt du icke i æchteskab gaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 13,
      "text": "¶ Her skal Bonden terske sit Korn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 13,
      "text": "oc prøffue huad han haffuer affled til forn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 13,
      "text": "Her samler man Eble oc Fructene mode",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 13,
      "text": "met siugdom kommer da dagene vode",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 13,
      "text": "Vochte din lønlig ting oc Nyre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 13,
      "text": "J Væchten for lægedom oc Saluen dyre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 14,
      "text": "⁕ Her pløye oc Saa din Vinter Ru",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 14,
      "text": "oc samle Vindruer i Korffue oc Tru",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 14,
      "text": "J min tid mot du met glæde gaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 14,
      "text": "oc lade dig dine Aarer slaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 14,
      "text": "Jnge saar skalt du lade læge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 14,
      "text": "oc Legomens velløst vil oc spæge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 15,
      "text": "¶ Her slagter man øxne oc Galtene fede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 15,
      "text": "oc hugger brende oc legger til rede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 15,
      "text": "Mod vinterens tuang oc haarde kny",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 15,
      "text": "naar skytten bær frost oc hoste til by",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 15,
      "text": "Rage din skæg lad armene lade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 15,
      "text": "det er oc sunt fuld vel at bade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 16,
      "text": "⁕ Nu vil ieg leffue oc vere fro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 16,
      "text": "oc slagte mod Jul baade Oxe oc Ko",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 16,
      "text": "At ieg maa metter oc salig bliffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 16,
      "text": "den stund ieg er her vdi liffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 16,
      "text": "Stenbucken reger dine knæ foruist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 16,
      "text": "thi foruar dennem vel for brøst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 17,
      "text": "Viltu leffue sund i naturlig tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 17,
      "text": "Merck de xii Tegen paa menniskens liff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 17,
      "text": "Synderlig met Kaapper oc Aare slau",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 17,
      "text": "Da løffuer Blodet i sin rette lau",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 18,
      "text": "Marcelli Paues oc den dag Siluestri.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 18,
      "text": "Oc til det fengsel Sancti Petri.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 18,
      "text": "Huilcken da lader sine Aarer slaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 18,
      "text": "Jeg wil ham ey for leffnedet staa.",
      "part": false,
      "marginal_notes": []
    }
  ]
}