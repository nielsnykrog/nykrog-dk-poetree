  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Gud aff himmelen see her til/",
      "part": false,
      "marginal_notes": [
        "Psalm. xj."
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc lad teg thet forbarme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Gantske faa tha ere thÿne tiæner till/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "beswigne ere wÿ arme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Thÿne ord wil man ey giffue macht/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "oc troen er skøtt gantske forlatt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "hooss alle menniskens sønner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "The lære idel falsk oc swig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "hwad theris wÿsdom paafinder/",
      "part": false,
      "marginal_notes": [
        "ij. Tim. iij."
      ]
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "theris hierte er icke samdrectelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "til Guds ord att forkynde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "then ene wil thette/ then anden wil thet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "bedrage oss med menniskens set/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "oc siunes dog hellig vdwortis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Gud wil then schrifft med roden oprycke/",
      "part": false,
      "marginal_notes": [
        "Math: xv: oc. xxiij."
      ]
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "som falsk hellighed oss lærer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "ther till theris tunge staalt obenbare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "taler stort wÿ wille oss wærie/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "wÿ haffue rett oc macht ÿ hand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "hwad wÿ beschriffue thet skall gaa fram/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "hwem er ther wil oss straffe?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Ther fore tall Gud ieg wil opsee/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "the arme leggis fast øde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "theris suck oc sorrig the meg bethee/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "ieg wil theris kæremaal høre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Mÿne salige ord the skulle nw fram:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "begiærlig the annamme them/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "paa thennom the arme seg trøste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Man prøffuer sølff med ilden wel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "saa worder thet klart befundet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "paa Guds ord man wel wochte skall/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "tesligest ÿ alle stunde/",
      "part": false,
      "marginal_notes": [
        "Math. v. oc. x."
      ]
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "thet wil med korsit beskermis best/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "saa lærer oss then hellige læst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "thets krafft luchter ÿ alle lande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "O milde Gud bewaare thÿne ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "fraa alle falske lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "att alle wÿ her sammen boo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "tw wilt wor beskermer wære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "The Guds forgangne monne tw her finde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "thit folk achte the nw offuer att winde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "o Gud forbiwd thennom thet AMEN.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "Aere wære teg fader ewindelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "oc Christ thÿn søn wor Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "ther til wor trøster then Helliaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 6,
      "text": "aff hiertet wÿ thet begiære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 6,
      "text": "Giff oss thÿn naade oc styrcke wor tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 6,
      "text": "att wÿ tilsamen med kierlighed boo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "ÿ eet sind effter thÿn wilie.",
      "part": false,
      "marginal_notes": []
    }
  ]
}