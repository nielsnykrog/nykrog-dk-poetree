{
  "id": null,
  "title": "Arabesk til en Haandtegning af Michel Angelo",
  "year_created": 1924,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Jens Peter Jacobsen",
    "country": null,
    "wiki": "Q370246"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Lyriske Digte",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1924,
    "url": "https://tekstnet.dk/books/jacobsen-jp_lyriske-digte/028/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Tog Bølgen Land?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Tog den Land og sived langsomt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Rallende med Grusets Perler",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Atter ud i Bølgers Verden?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Nej! den stejled' som en Ganger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Løfted' højt sin vaade Bringe;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Gjennem Manken gnistred' Skummet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Snehvidt som en Svanes Ryg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Straalestøv og Regnbu'taage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Sittred op igjennem Luften:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Ham den kasted',",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Ham den skifted',",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Fløj paa brede Svanevinger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Gjennem Solens hvide Lys.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Jeg kjender din Flugt, du flyvende Bølge;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Men den gyldne Dag vil segne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Vil, svøbt i Nattens dunkle Kappe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Lægge sig træt til Hvile,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Og Duggen vil glimte i hans Aande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Blomsterne lukke sig om hans Leje,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Før du naaer dit Maal.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "- Og har du naa't det gyldne Gitter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "Og stryger tyst paa spredte Vinger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "Henover Havens brede Gange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 1,
      "text": "Henover Lavrers og Myrthers Vover,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 1,
      "text": "Over Magnoliens dunkle Krone,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 1,
      "text": "Fulgt af dens lyse, roligt-blinkende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 1,
      "text": "Fulgt af dens stirrende Blomsterøjne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 1,
      "text": "Nedover hemmeligt-hvidskende Iris,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 1,
      "text": "Baaret og dysset i graadmilde Drømme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 1,
      "text": "Af Geraniernes Duft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 1,
      "text": "Af Tuberosers og Jasminers tungtaandende Duft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 1,
      "text": "Baaret mod den hvide Villa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 1,
      "text": "Med de maanelyste Ruder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 1,
      "text": "Med dens Vagt af høje, dunkle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 1,
      "text": "Høje, rolige Cypresser,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 1,
      "text": "Da forgaaer du i Anelsers Angst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 1,
      "text": "Brændes op af din skjælvende Længsel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 1,
      "text": "Glider frem som en Luftning fra Havet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 1,
      "text": "Og du døer mellem Vinrankens Løv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 1,
      "text": "Vinrankens susende Løv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 1,
      "text": "Paa Balkonens Marmortærskel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 1,
      "text": "Mens Balkongardinets kolde Silke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 1,
      "text": "Langsomt vugger sig i tunge Folder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 1,
      "text": "Og de gyldne Drueklaser",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 1,
      "text": "Fra de angstfuldt-vredne Ranker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 1,
      "text": "Fældes ned i Havens Græs.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 2,
      "text": "Glødende Nat!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 2,
      "text": "Langsomt brænder du henover Jorden;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 2,
      "text": "Drømmenes sælsomt skiftende Røg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 2,
      "text": "Flakker og hvirvles afsted i dit Spor.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 2,
      "text": "Glødende Nat!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 2,
      "text": "- Viljer er Voks i din bløde Haand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 2,
      "text": "Og Troskab Siv kun for din Aandes Pust,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 2,
      "text": "Og hvad er Klogskab lænet mod din Barm?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 2,
      "text": "Og hvad er Uskyld daaret af dit Blik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 2,
      "text": "Der Intet seer, men suger vildt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 2,
      "text": "Til Stormflod Aarens røde Strøm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 2,
      "text": "Som Maanen suger Havets kolde Vande?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 2,
      "text": "- Glødende Nat!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 2,
      "text": "Vældige, blinde Mænade!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 2,
      "text": "Frem gjennem Mulmet blinker og skummer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 2,
      "text": "Sælsomme Bølger af sælsom Lyd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 2,
      "text": "Bægeres Klang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 2,
      "text": "Staalets hurtige, syngende Klang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 2,
      "text": "Blodets Dryppen og Blødendes Rallen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 2,
      "text": "Og tykmælt Vanvids Brølen blandet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 2,
      "text": "Med purpurrøde Attraaes hæse Skrig ...",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 2,
      "text": "- Men Sukket, glødende Nat?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 2,
      "text": "Sukket, der svulmer og døer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 2,
      "text": "Døer for at fødes paany,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 2,
      "text": "Sukket, du glødende Nat?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 3,
      "text": "Se, Gardinets Silkevover skilles,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 3,
      "text": "Og en Kvinde høj og herlig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 3,
      "text": "Tegner mørk sig mod den mørke Luft.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 3,
      "text": "- Hellige Sorg i dit Blik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 3,
      "text": "Sorg, der ej kan hjælpes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 3,
      "text": "Haabløs Sorg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 3,
      "text": "Brændende, tvivlende Sorg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 3,
      "text": "- Nætter og Dage summe over Jorden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 3,
      "text": "Aarstider skifte som Farver paa Kind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 3,
      "text": "Slægter paa Slægt i lange, mørke Bølger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 3,
      "text": "Rulle over Jord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 3,
      "text": "Rulle og forgaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 3,
      "text": "Medens langsomt Tiden døer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 3,
      "text": "Hvorfor Livet?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 3,
      "text": "Hvorfor Døden?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 3,
      "text": "Hvorfor leve, naar vi dog skal dø?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 3,
      "text": "Hvorfor kæmpe, naar vi veed, at Sværdet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 3,
      "text": "Dog skal vristes af vor Haand en Gang?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 3,
      "text": "Hvortil disse Baal af Kval og Smerte:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 3,
      "text": "Tusind Timers Liv i langsom Liden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 3,
      "text": "Langsom Løben ud i Dødens Liden?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 4,
      "text": "Er det din Tanke, høje Kvinde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 5,
      "text": "Tavs og rolig staaer hun paa Balkonen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 5,
      "text": "Har ej Ord, ej Suk, ej Klage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 5,
      "text": "Tegner mørk sig mod den mørke Luft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 5,
      "text": "Som et Sværd igjennem Nattens Hjerte.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
