{
  "id": null,
  "title": "Vægtervise VII",
  "year_created": [
    1553,
    1555
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Hjertebogen",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1555,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/HJB64.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "End rydder om yen morgen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "spaszere saa wylle hand gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "huad santh hand vforborgen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "yen skøne yumfrw staa;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "hand grøszet hind mett stor ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "hand kalleth hynd kieriste sin:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "\"Wyll y nu hos mig were,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "thett ær myn høgeste begiere.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Thett sagde then rydder fyn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Then iomfrw suareth hannum mett tuckte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "sin ord hund fulwell kunne:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "\"Att gange mett etther end liden stund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "thett kunne mig lideth fromme;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "ther ær saa mange y werden tiill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "ther meg thett wyll forkiere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "att liffue migh fraa heder och ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "thett wyll y ycke begiere.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "\"Hør y thett, myn skønne iomfrw,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "y skall ycke grunde saa witt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "y ganger mett mig end liden stundh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "hoss mig gielder yngen striidt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "yeg will mig giernne holle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "huad y aff mig begiere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "y lader ett tro hierte raade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "ycke mig saa høgelig forsmaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "ycke megh sa hart forsuerge.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Then iomfrw hun hannum vnner øgen saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "saa spodskelig hun hannum suareth:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "\"Mig siunes y ær end vnger-suend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "etthers ord kand y ycke forware;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "yeg tør thett well betro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "then sag er y ycke wis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "yeg wyll eder beder beskode:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "om y end rydder-skenck tør woge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "om y fører ridder-prysz.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "\"Skøn iomfrw, lader megh ycke vndgielle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "thett yeg saa vngh mand ær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "yeg wyll myth hierte stielle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "epther eders egen begier;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "faar mig etthers huide hand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "besuer mig liff och syell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "trofast aff hierthe och synde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "then stund mig liffuett kand wynne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "yegh aldrig andeth begier.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 5,
      "text": "\"Vnger-suend, thu est behendelygh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "thu siiger well aff then ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "som tegh rett aldrig kand hendis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "saa mange tro hierthe forkier",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 5,
      "text": "ther-paa wyll yegh betencke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 5,
      "text": "huad sligt haffuer ynd att bere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 5,
      "text": "attu mig ycke forkrencke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 5,
      "text": "mett thinne løstelige suencke;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 5,
      "text": "forgeues er thin begier.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "\"Kand yeg ether ycke beuighe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "thett ær mith høgeligh klage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "yeg wyll etther aldrig suige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 6,
      "text": "alle myn liffsens dage;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 6,
      "text": "faar mig etthers huide hand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 6,
      "text": "yeg naden aff eder begier:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 6,
      "text": "lader mig rett aldrig forsuinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 6,
      "text": "lade mig trohedenn befynne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 6,
      "text": "yeg aldrig andet begier.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 7,
      "text": "Then iomfrw wende siigh om y-gien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "hun hørde then rydders klage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 7,
      "text": "hun tenckte alt saa ynderlig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 7,
      "text": "huad hun hannum wylle suare:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 7,
      "text": "\"Faar mig etthrs huide hand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 7,
      "text": "besuer mig liff och syell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 7,
      "text": "trofast aff hiarthe och sinde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 7,
      "text": "then stund ther liffuett kand winne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 7,
      "text": "du vnner mig hiartelig well.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 8,
      "text": "Then vngersuend suareth mett ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 8,
      "text": "hand haffde saa friith ett mod:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 8,
      "text": "\"Myn kieriste, yeg er etthers egen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 8,
      "text": "mitt liiff och allt mytt godtz;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 8,
      "text": "yngen skall oss att-skyllie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 8,
      "text": "then stund yeg leffue maa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 8,
      "text": "forvden Gud all-yenne:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 8,
      "text": "hand rader for waade och synde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 8,
      "text": "all-tingest tiill hannum staar.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 9,
      "text": "Then iomfrw suareth mett lempe:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 9,
      "text": "\"Sin lycke kand yngen forwende;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 9,
      "text": "men thu wylt trofast were,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 9,
      "text": "skaltu migh trofast fynne;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 9,
      "text": "yeg gyffuer tyg mod och synde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 9,
      "text": "gandske vnner thin forplicht,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 9,
      "text": "skaltu mig trofast fynne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 9,
      "text": "then stund yeg liffuett kand wynne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 9,
      "text": "ther-epther wyl yeg mig berede.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 10,
      "text": "Ther bleff thy bode tiill-samen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 10,
      "text": "mett aller-erligste suencker;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 10,
      "text": "huad ther-om bleff fordelett,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 10,
      "text": "thett staar well tiill att tencke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 10,
      "text": "Then wechter paa then muer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 10,
      "text": "hand bleste sin syncke saa høgt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 10,
      "text": "hand sagde then dagens komme;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 10,
      "text": "war thennum saa lydeth tiill fromme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 10,
      "text": "theris glede bleff thennum forrøgt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 11,
      "text": "Arlyg om morgen, thett war dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 11,
      "text": "then rydder løste att ryde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 11,
      "text": "hand klagede siig y-saa ynderligh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 11,
      "text": "att hand ey lenger kunne biide;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 11,
      "text": "hand tog hind y sin arm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 11,
      "text": "hand gaff hende siit hiarte tiill kenne:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 11,
      "text": "\"Y lader eder ycke forlenge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 11,
      "text": "y giør well end annen saa bange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 11,
      "text": "thett krencker ey etther synne.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 12,
      "text": "Then iomfrw slo hannum fraa hiertett,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 12,
      "text": "hund hørde thett falske sned:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 12,
      "text": "\"Thett skall end annen vnd-gielle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 12,
      "text": "første yegh kommer wedth.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 12,
      "text": "Man skulle siig wel betencke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 12,
      "text": "huad epther komme kand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 12,
      "text": "ware siig for falske klaffer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 12,
      "text": "tro ey paa løstelige suæncker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 12,
      "text": "see huem hand tager wed hand.",
      "part": false,
      "marginal_notes": []
    }
  ]
}