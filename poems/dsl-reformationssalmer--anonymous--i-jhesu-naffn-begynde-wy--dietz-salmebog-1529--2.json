    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/dietz-salmebog-1529/1"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "I JHesu naffn begynde wÿ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "thet beste ther wÿ kunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "alt om Guds ord tha siunge wÿ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "hør til ÿ qwinner oc ÿ mend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "hwor mand skal salighed finde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Troen thet giør ieg sier eder sant/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "wid henne faa wÿ then Helliaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "til Guds ord att annamme/",
      "part": false,
      "marginal_notes": [
        "Johan. iij."
      ]
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "saa lærer oss then ædle schrifft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "man kan ey andet finde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Johannis ÿ thet tredie ÿ skulle forstaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "schriffuis att Gud elste werden saa/",
      "part": false,
      "marginal_notes": [
        "Johan. iij. j. Joh. iiij."
      ]
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "søn for henne haffuer giffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "hwo ther tror paa Jesum Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "skal med hannwm salig bliffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Til the Romersche ÿ thet tredie hører meer/",
      "part": false,
      "marginal_notes": [
        "Roman. iij"
      ]
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "ingen bliffuer salig for lofsens gierninger skeer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "men synden wÿ wid henne kende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "med troen komme wÿ til thett foriætte land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "som oss Paulus bewÿse kand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "Guds retwÿshed oss kommer wid Jesum Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "salig er then som thette tror wist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "seg ganske ther paa forlader/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "forthi hans synder beteckis tha/",
      "part": false,
      "marginal_notes": [
        "Rom. viij. j. Johan. ij."
      ]
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "ey regnis hwad heller the ere store eller smaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "Christ er død for wor ondskab oc sind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "hooss Gud wor naade er han oc miskund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "wore han icke menniske bleffuen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "tha hadde wÿ alle wærid fortapte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": "til ewig tÿd forderffuen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "Abraham giorde Gud tilbørlig ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "ther han trode Guds ord sande att wære/",
      "part": false,
      "marginal_notes": [
        "Rom. iiij."
      ]
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "til the Romersche ÿ thet fierde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": "haffuer troen hannwm retwÿshed tillagt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 6,
      "text": "oss til een ewig lære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "Att wÿ tro paa Christ/ Guds gierning monne wære/",
      "part": false,
      "marginal_notes": [
        "Johan. vj. Luce. ij."
      ]
    },
    {
      "id": 36,
      "stanza_id": 7,
      "text": "Johannis wdi thet siette",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": "han er oss fød oc giffuen gantsk/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 7,
      "text": "kom aff een Jomffru reen oc klar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 7,
      "text": "som ÿ mands wære aldrig fands.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 8,
      "text": "Om tw haffuer een rett Christelig tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 8,
      "text": "saa bewÿss tw teg een tiæner tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 8,
      "text": "ÿ kierligheds gierning næste/",
      "part": false,
      "marginal_notes": [
        "Math. v. Rom. xij."
      ]
    },
    {
      "id": 43,
      "stanza_id": 8,
      "text": "alt saa som Gud haffuer teg bewÿst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 8,
      "text": "mod onde oc gode menniske.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 9,
      "text": "Nw hører hwad Gud wid Mosen haffuer budit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 9,
      "text": "er nogen arm ÿ eders land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 9,
      "text": "tha lad hanwm op thÿn miskunds hand",
      "part": false,
      "marginal_notes": [
        "Deut. xv."
      ]
    },
    {
      "id": 48,
      "stanza_id": 9,
      "text": "hans nød oc modgang lad wære thÿn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 9,
      "text": "bewÿss paa hanwm Christen tro sÿden:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 10,
      "text": "Rober nogen ÿ himmelen til meg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 10,
      "text": "til synd tha skal thet leggis teg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 10,
      "text": "med aager skaltw worde frÿ/",
      "part": false,
      "marginal_notes": [
        "Luce. vj."
      ]
    },
    {
      "id": 53,
      "stanza_id": 10,
      "text": "Gud wil thet haffue att saa skal skee/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 10,
      "text": "ellers bliffuer tw fattig ÿ ewig wee.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 11,
      "text": "J thet femte Matthei lesse wÿ saa/",
      "part": false,
      "marginal_notes": [
        "Math. v."
      ]
    },
    {
      "id": 56,
      "stanza_id": 11,
      "text": "oss biwdis om wÿ thet ret wille forstaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 11,
      "text": "wil nogen aff teg borge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 11,
      "text": "giff hanwm freest/ wore thet en wist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 11,
      "text": "han monne thÿn fiende were.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 12,
      "text": "The aandelige fattig hør himmerig til/",
      "part": false,
      "marginal_notes": [
        "Math. v."
      ]
    },
    {
      "id": 61,
      "stanza_id": 12,
      "text": "thet skaltu wide til wisse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 12,
      "text": "for penning afflad oc ey for gecke spil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 12,
      "text": "thee kierlighed thÿn broder/ mod Gud thÿn tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 12,
      "text": "saa skaltw ther ewindelig boo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 13,
      "text": "Tw staar eller gaar ÿ by eller marck/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 13,
      "text": "som Gud wid Mosen haffuer sagt/",
      "part": false,
      "marginal_notes": [
        "Deute. vj."
      ]
    },
    {
      "id": 67,
      "stanza_id": 13,
      "text": "hans gunst oc naade betrachte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 13,
      "text": "teg haffuer bewÿst wid Jesum Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 13,
      "text": "loffuen fuldkom for alle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 14,
      "text": "Een anden ting ieg teg sige wil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 14,
      "text": "Guds Ridder om tw wilt wære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 14,
      "text": "spot/ skam/ nød/ skaltw bære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 14,
      "text": "med Christo wor herre thÿn høwitzmand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 14,
      "text": "wilt tw hooss fennicken wære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 15,
      "text": "Thÿne waaben skulle wære altÿd paa teg/",
      "part": false,
      "marginal_notes": [
        "Ephe. vj."
      ]
    },
    {
      "id": 76,
      "stanza_id": 15,
      "text": "saa monne oss Paulus lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 15,
      "text": "skiold/ hielm/ pantzer skulle nw teg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 15,
      "text": "ther til eet swerd/ Guds ord thet er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 15,
      "text": "thy Satan thÿn grumme fiende er.",
      "part": false,
      "marginal_notes": [
        "j Petri. v."
      ]
    },
    {
      "id": 80,
      "stanza_id": 16,
      "text": "Att wære Christi Ridder forsage thet ey/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 16,
      "text": "ÿ pÿne/ drøffuelse/ oc all thÿn wæy/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 16,
      "text": "hooss teg iætte han att wære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 16,
      "text": "til hannwm thÿn lÿd sett haab oc trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 16,
      "text": "saa finder tw hannwm thÿn Jesum wist.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 17,
      "text": "Han haffuer offuerwundit synd/ heluede/ oc nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 17,
      "text": "oc frelst fraa then ewige død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 17,
      "text": "oss alle til glæde oc fromme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 17,
      "text": "hans børn the hadis fortryckis her/",
      "part": false,
      "marginal_notes": [
        "j. Pet. iiij."
      ]
    },
    {
      "id": 89,
      "stanza_id": 17,
      "text": "før the til himmerig komme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 18,
      "text": "Nw lader oss bliffue ÿ thette mod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 18,
      "text": "Christ herre wor Gud falle wÿ til fod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 18,
      "text": "som alles wor trøster monne wære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 18,
      "text": "aff alt ont haffuer han oss løøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 18,
      "text": "han er wor trøst oc ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 19,
      "text": "Deel med oss thit daglige brød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 19,
      "text": "spÿss oss thÿne ord oc naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 19,
      "text": "att kende swrdey oc raadit brød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 19,
      "text": "lær oss thet wel/ thet forderffuer wor siæl/",
      "part": false,
      "marginal_notes": [
        "Mat. vj. Mat. xv."
      ]
    },
    {
      "id": 99,
      "stanza_id": 19,
      "text": "ieg meen all menniskens lære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 20,
      "text": "Gud fader wære loff ÿ thet høgeste/",
      "part": false,
      "marginal_notes": [
        "Luce. ij."
      ]
    },
    {
      "id": 101,
      "stanza_id": 20,
      "text": "ther til hans søn o Christe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 20,
      "text": "med thennom lÿge then Helliaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 20,
      "text": "loff prÿss oc ære ÿ alle land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 20,
      "text": "er wor begæring alle mand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 21,
      "text": "O Gud wÿ loffue teg/ wÿ bekende teg een Herre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 21,
      "text": "Teg een ewig fader/ prÿser then ganske werden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 21,
      "text": "Thet samme giøre alle Engle/ himlene oc alle weldige Engle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 21,
      "text": "Thÿn prÿss siunge Cherubin oc Seraphin/ med eet waffladeligt stæmme.",
      "part": false,
      "marginal_notes": [
        "Esaie. vj."
      ]
    },
    {
      "id": 109,
      "stanza_id": 21,
      "text": "Hellig. Hellig. Hellig æstu Herre Gud Sabaot.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 21,
      "text": "Himlene oc iorden ere opfylt med thÿn Maiestetis ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 21,
      "text": "Then erlig forsambling thÿne Apostlers tall/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 21,
      "text": "teg loffue oc bekende een Herre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 21,
      "text": "Lÿge saa giør oc altÿd thit hellige tall thÿne Propheters.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 21,
      "text": "Then gantske skare thÿne hellige Martirers/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 21,
      "text": "thit hellige naffn loffue oc prÿse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 21,
      "text": "alle gudfryctige oc vdwalde loffue oc bekende teg ÿ all werden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 21,
      "text": "Een wbegribelig Maiestetis fader.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 21,
      "text": "Thÿn sande ærefulde eenborne søn Jesum Christum",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 21,
      "text": "tro wÿ att wære lÿge med teg ÿ Guddommen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 21,
      "text": "Ther til then helliaand sandelig att wære alles wore trøstermand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 21,
      "text": "O Herre Christe tw æst ærens Konning.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 21,
      "text": "Tw æst thÿn faders ewige søn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 21,
      "text": "Iomffruens wor teg icke wederstyggeligt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 21,
      "text": "til att annamme mandom oc forløse alle vdwalde menniske.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 21,
      "text": "Tw haffuer offuerwundet then bittre pÿne dødzens sting/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 21,
      "text": "oc oplat alle som tro paa teg himmerigis rÿge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 21,
      "text": "Ther fore sidder tw nw paa Guds høgre hand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 21,
      "text": "ÿ ewig Maiestetis ære med thÿn fader.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 21,
      "text": "Oc tro wÿ att tw her effter worder tilkommendis",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 21,
      "text": "een streng dommere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 21,
      "text": "Ther fore o Herre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 21,
      "text": "hielp thÿne tro tiænere/ som tw forløøste med thit direbare blod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 21,
      "text": "Thÿne wenner giør deelactige ÿ then ewige ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 21,
      "text": "med thit hellige oc vdwalde folk.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 21,
      "text": "O herre frelss thit folk",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 21,
      "text": "oc welsigne the som ere arff oc eyedom.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 21,
      "text": "Reghere oc lær thennom/ oc ophoye thennom til ewindelig tÿd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 21,
      "text": "Wÿ benedide teg Gud ÿ ewighed/ oc ære teg dag fraa dag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 21,
      "text": "Oc loffue thit naffn ewindelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 21,
      "text": "nw oc altÿd oc ewindelig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 21,
      "text": "O Herre werdis att beware oss altÿd fraa synden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 21,
      "text": "Miskunde teg offuer oss o Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 21,
      "text": "oc forbarme teg offuer oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 21,
      "text": "O Herre thÿn miskund bliffuer offuer oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 21,
      "text": "saa som wÿ oss paa teg forlade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 21,
      "text": "Till teg Herre staar alt wort haab/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 21,
      "text": "ther fore lad oss icke bliffue till skendzel ewindelig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 22,
      "text": "KOm Gud skaber helligeaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 22,
      "text": "besøg wort hierte med thÿn miskund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 22,
      "text": "med thÿn naade forny wor sind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 22,
      "text": "att wÿ kunde kende skabning thÿn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 23,
      "text": "Tw som kallis wor trøstermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 23,
      "text": "then høgeste nogen tÿd wære kand/",
      "part": false,
      "marginal_notes": [
        "Johan. xvj. j. Johan. ij."
      ]
    },
    {
      "id": 154,
      "stanza_id": 23,
      "text": "een aandelig salwe/ salwe oss med/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 23,
      "text": "att wÿ med thÿne gaffuer bliffue besett.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 24,
      "text": "Optend ÿ oss thÿn Guddoms ild/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 24,
      "text": "oc ødeleg wor eghen wild/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 24,
      "text": "giff oss ett hierte reent oc pwrt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 24,
      "text": "oc styrcke ÿ oss thet tw haffuer giort.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 25,
      "text": "Tw æst siwfold ÿ gaffuer skøne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 25,
      "text": "tw æst Guds finger paa then rette hand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 25,
      "text": "Guds faders ord giffuer tw wel fart/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 25,
      "text": "offuer alle land at predickis snart.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 26,
      "text": "Drÿff fraa oss nw dieuelsens list/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 26,
      "text": "lær oss att kende rett Jesum Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 26,
      "text": "oc tage korssit aff hans milde hand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 26,
      "text": "hwilkid han atskillig giffuer alle mand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 27,
      "text": "Lær oss faderen att kende wel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 27,
      "text": "som oss forsørger bode lÿff oc siæl/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 27,
      "text": "sÿn søn for oss ÿ døden gaff/",
      "part": false,
      "marginal_notes": [
        "Johan. iij."
      ]
    },
    {
      "id": 171,
      "stanza_id": 27,
      "text": "att wÿ skulde icke faa ewig straff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 28,
      "text": "Gud fader wære loff oc hans kiære søn",
      "part": false,
      "marginal_notes": [
        "Gala. j."
      ]
    },
    {
      "id": 173,
      "stanza_id": 28,
      "text": "som oss forhwerffde then ewig løn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 28,
      "text": "ther til wor trøster then Helliaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 28,
      "text": "loff prÿss oc ære ÿ alle land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 29,
      "text": "BEnedidet wære Jsraels Gud oc Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 29,
      "text": "forthi han haffuer søgt oc forløøst sitt folk.",
      "part": false,
      "marginal_notes": [
        "Luc. j."
      ]
    },
    {
      "id": 178,
      "stanza_id": 30,
      "text": "Oc han haffuer opræt oss salighedzens horn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 30,
      "text": "ÿ Dauids hwss sÿn tiæneris.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 31,
      "text": "Som han haffuer talid igiennom sÿne propheters mund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 31,
      "text": "hwilke som ere aff gammel .",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 32,
      "text": "Thet skulde skee att wÿ skulde frelsis fraa wore vwenner/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 32,
      "text": "oc aff alle theris hand hwilke oss hadede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 33,
      "text": "Paa thet han skulde bruge sÿn miskundhed med wore forældre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 33,
      "text": "oc wære ihu komende sitt Testament oc løffte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 34,
      "text": "Oc fuldkomme then eed han soor Abraham wor fader/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 34,
      "text": "oc han skulde giffue oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 35,
      "text": "Paa thet att wÿ som wore frelste aff wore vwenners hender/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 35,
      "text": "skulle tiæne hannwm wden rædtzel.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 36,
      "text": "Med hellighed oc retferdighed for hans ansigt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 36,
      "text": "all wor lÿffs tÿd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 37,
      "text": "Oc tw barn skall kallis then høgestis Prophete/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 37,
      "text": "thÿ tw skalt gaa for Herrens ansigt/ oc berede hans wæy.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 38,
      "text": "Till att giffue hans folk saligheds lærdom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 38,
      "text": "til theris synders forladelse.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 39,
      "text": "Wid wor Guds then hierte grunde barmhiertighed med hwilken han søgte oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 39,
      "text": "oprunden aff thet høgeste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 40,
      "text": "Att han skulle liwse thennom som sidde wdi mørckid oc dødzens skygge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 40,
      "text": "att stille wore fødder til fredzens wæy.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 41,
      "text": "Aere wære Gud fader oc Gud Søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 41,
      "text": "oc saa Gud then helliaand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 42,
      "text": "Som wærid haffuer aff begyndelsen nw oc altÿd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 42,
      "text": "oc bliffuer til ewighed amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 43,
      "text": "Loffuer Gud wor Herre Alleluia/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 43,
      "text": "loffuer Herren Alleluia Alleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 44,
      "text": "Gud wære ewige tack Alleluia/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 44,
      "text": "Loffuer Herren Alleluia Alleluia.",
      "part": false,
      "marginal_notes": []
    }
  ]
}