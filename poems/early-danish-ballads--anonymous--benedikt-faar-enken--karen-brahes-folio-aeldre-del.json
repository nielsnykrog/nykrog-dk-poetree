    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA51.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Saa liden war Blidellild Erricks-datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "der hinder falt fader fraa;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "hun war seg saa liden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "ther hun monne styffader faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: Saa kold daa falder der rimen. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Tthett wor Blidellils styffader,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "seder offuer sit brede boord;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "hand thaller om Blidelild Ericks-datter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "saa mangtet erligt ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Tthett wor here Elie Bunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "hand buor seg vde wed aaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "hand war biellit til den møø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "hand wor icke agt at faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Tthett wor her Elie Bunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "hand beder leg saadel paa hest:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "\"Ieg well ride meg op att land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "hind rige her Erick at geste.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Tthett wor herre Ellie Bunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "hand kaam der riden y gard;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "wd staar rige her Erick,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "hand war well suøbtt y mordt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "\"Wer well-komen, her Ellie Bunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "wer welkomen y min gard;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "thett brune mød, thend klare wyn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "skal were for eder vspartt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "\"Beholder y seleff eders brune mød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "och saa eders klare wyn;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "giffuer meg iumfrw Blidelild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "som er kerr styffdatter dyn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "\"Ttha gack thu theg y stoffuen ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "och dreck buode mød och wyn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "men ieg gar meg y hyffuelofft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "och rader med stolt Blidelild.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "\"Her seeder thu, stalttenn Blidelild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "och kerre datter myn;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "theg bedis her Elie Bunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "rige biele dyn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Tthett suaridtt Blidelild Ericks-datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "hun suaridtt hanom aff stuor nød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "\"Y giffuer meg icke den gamble mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "ieg sørger meg selff til død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Giffuer meg icke denn gamble mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "ieg wel hanom icke haffue;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "y giffuer meg helder y chloster ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "ieg bliffuer ther helder all mine dage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Med myn sags och med myn søm",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "kand ieg ther fuld well winde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "ieg kand buode skerre och siy",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "och spiende thett silcke-thuinde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "\"Tthu kand langtt bedere y Bundens booe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "och merre med erenn winde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "hand holder huer dag offuer sitt bord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 12,
      "text": "buod mørr och høffsken quinde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "Suaridtt thett hindis kerre moder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "vdi thett fløffuell blatt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "\"Thett er hanom Hagen Bendigtsenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 13,
      "text": "ther alld din hoff til starr.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Tthett er hanom Hagenn Bendigttsen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "thett all min huoff til staar;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "war hand ind her y affttenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 14,
      "text": "du skulde hanom dog aldrig faa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "Melltte hindis kerr moder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "hun suaritt et ord saa bratt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "\"Thu skalt sige iad til den gamble mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 15,
      "text": "thu est hanom for langen iett.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "Alltt om thu fielder thaarre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "vnder ditt hoffuit-guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "thu lad hanom aldrig mercke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 16,
      "text": "at thu welt hanom were vhuld.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "Tthett suarid Blidelild Ericks-datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "hun feldit saa muodige tare:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "\"Buod nu och allen tide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 17,
      "text": "tha thuinger y meg saa sarre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "Saa thog thi Blidelild Ericks-datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "fuld hinder y stoffuen ind;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "thi gaff hinder her Eli Bunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 18,
      "text": "muod ald hindis iaa och mynde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "Tthett wor Blidelild Ericksdatter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "hun ind aff døren thrend;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "thett wor herre Ellie Bunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 19,
      "text": "hand stuod hind op igenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "Tthett wor herr Ellie Bunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "hand tog hind y sin arum;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "hand gaff hinder ett kronne aff røde guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 20,
      "text": "der-til et røde guld-baann.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 21,
      "text": "Tthi bøød til hindis brølup",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "thett beste folck, thi kund faa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 21,
      "text": "thi biød hinn lidenn Kiersten",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 21,
      "text": "och hindis døtter buode.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 22,
      "text": "Ind kaam liden Kiersten,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 22,
      "text": "och stedis hun for buord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 22,
      "text": "\"Mindis y, Blidelild Erriks-datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 22,
      "text": "huad thalitt war y fiørrd?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 23,
      "text": "Mindis y, Blidellild Ericks-dater,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 23,
      "text": "huad thallitt war y-fiorrd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 23,
      "text": "thett wor wor hanom Hagen Bendixsen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 23,
      "text": "som y haffuer loffuet eders thro.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 24,
      "text": "\"Saa giørlig ieg thett mindis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 24,
      "text": "som thett haffde wert y-gaar:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 24,
      "text": "thi haffuer nu giffuet meg den gamble mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 24,
      "text": "thett er imod ald myn radtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 25,
      "text": "Tthett er hanom Hagenn Benditt-sen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 25,
      "text": "som ieg haffuer loffuet myn thro;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 25,
      "text": "hand giorde thett aff god-wilig sinn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 25,
      "text": "løst ind mynn fiernne-iord.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 26,
      "text": "Saa drack thi thett brølup",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 26,
      "text": "y fulde dage ny;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 26,
      "text": "saa saar gred Blidelild Eriks-dater,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 26,
      "text": "hun gred y alle dy.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 27,
      "text": "Drocke thi thett brøllup",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 27,
      "text": "y fulde dage fem;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 27,
      "text": "saa saare gred Blidelil Erkis-datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 27,
      "text": "for hun skuld følge hiem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 28,
      "text": "Tthett wor hindis kerr moder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 28,
      "text": "hun tog stalt Blidelil att lerre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 28,
      "text": "\"Første thu komer y her Bundis buo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 28,
      "text": "thu tenck paa dyd och erre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 29,
      "text": "Komer thieg sorrigen y hoffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 29,
      "text": "och er thitt hiartte vglad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 29,
      "text": "dog skalt thu med mange edeling",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 29,
      "text": "buode skemptte och talle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 30,
      "text": "Riender theg sorigenn y hoffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 30,
      "text": "och giors thit hiartte wie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 30,
      "text": "dog skalt thu med mange edeling",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 30,
      "text": "buode lege och liee.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 31,
      "text": "Tthett mellte Blidelild Ericks-datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 31,
      "text": "saa hiarte-lig mone hun sørge:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 31,
      "text": "\"Meg skall rett aldrig saa ilde lidde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 31,
      "text": "att nogen skal thett kund sporige.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 32,
      "text": "Tthett wor Hagenn Bendigt-senn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 32,
      "text": "hand kaam fraa lieding hiem;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 32,
      "text": "saa sterke war dy thiding,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 32,
      "text": "ther hanom gick daa igenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 33,
      "text": "Tthett wor Hagenn Bendigt-senn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 33,
      "text": "red y sin søsters gard;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 33,
      "text": "vd staar liden Kierstenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 33,
      "text": "suøbtt war hun y moor.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 34,
      "text": "\"Her stander thu, lidenn Kirstenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 34,
      "text": "och kerre søster myn;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 34,
      "text": "huor lider Blidelild Ericks-datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 34,
      "text": "er hun nu mand-giffuen?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 35,
      "text": "Tthett suarde liden Kirsten,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 35,
      "text": "vnder sinn skaarrlagenn mord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 35,
      "text": "\"Thi haffuer giffuet hinder saa gamble en mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 35,
      "text": "mod ald hindis rad.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 36,
      "text": "Tthett wor Hagenn Bendittsenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 36,
      "text": "hand red y den frwes gard;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 36,
      "text": "vd stuod her Elli Bunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 36,
      "text": "hand wor well suøbtt y mord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 37,
      "text": "\"Her staar y, her Elli Bunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 37,
      "text": "y er well suøbtt y skiend;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 37,
      "text": "huor er Blidelild Errikes-datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 37,
      "text": "som før wor kereste mynn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 38,
      "text": "\"Gaar y eder y stioffuen ind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 38,
      "text": "med tuogt och guode sinnde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 38,
      "text": "ther finder y Blidelil Ierikes-datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 38,
      "text": "hun spinder silcke-thuinde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 39,
      "text": "Tthett wor Hagen Bendittsenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 39,
      "text": "hand ind aff doren thrennd;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 39,
      "text": "thett wor Blidelild Eriks-dater,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 39,
      "text": "hun staar hanom op igenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 40,
      "text": "\"Myndis y, Blidelild Ericks-datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 40,
      "text": "huad thaallitt war y-fiordtt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 40,
      "text": "ieg mintte, y haade meg loffuet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 40,
      "text": "y wilde meg giffue ethers thro.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 41,
      "text": "Will y nu, Blidelild Ericks-datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 41,
      "text": "følge meg till fremede land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 41,
      "text": "tha well ieg slaa herre Eelbunde ihiell",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 41,
      "text": "och skelle eder wed thend harum.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 42,
      "text": "\"Hielp meg Gud-fader y hemerrig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 42,
      "text": "som ieg thett icke will!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 42,
      "text": "thend same Gud, wosz samell kaam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 42,
      "text": "hand kand osz bedere at-skielle.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 43,
      "text": "Sidenn war di samell y wenter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 43,
      "text": "och thi war sanell y ny;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 43,
      "text": "stollt Blidelild daufflig sorrig bar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 43,
      "text": "hun bar thett well y dy.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 44,
      "text": "Tthend første thid ther efter kaam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 44,
      "text": "thett war alt om en wuorr;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 44,
      "text": "thett wor herr Eli Bunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 44,
      "text": "hand feck saa sterk ett suott.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 45,
      "text": "Tthett wor her Elli Bunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 45,
      "text": "feck suott, och siug hand luo;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 45,
      "text": "saa stalt wor wor Blidelild Ericks-datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 45,
      "text": "hun gik hanom til och faraa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 46,
      "text": "Tthett melltte herre Elli Bunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 46,
      "text": "ham tøckte thett were stuor harum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 46,
      "text": "\"Gud nade theg, Blidelild Ericks-datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 46,
      "text": "wi haffde icke samell et barnn!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 47,
      "text": "Suaridtt thett Blidelild Ericks-datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 47,
      "text": "hun smiller vnder skiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 47,
      "text": "\"Saa rige daa bliffuer eders frender,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 47,
      "text": "men skaden den er minn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 48,
      "text": "Tthett wor herr Elli Bunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 48,
      "text": "hand satte sieg skrinn for kniee:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 48,
      "text": "saa gaff hand Blidelild Ericks-datter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 48,
      "text": "buode guld och fiee.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 49,
      "text": "Gaff hand Blidelild Erricks-datter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 49,
      "text": "femten snecke paa wande;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 49,
      "text": "saa gaff hand Blidelild Eriks-datter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 49,
      "text": "femtenn garde y lande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 50,
      "text": "Saa gaff hand Blidelild Erikes-datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 50,
      "text": "gaff hinder thi møller siyu;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 50,
      "text": "thett gaff hand stalten Blidelild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 50,
      "text": "for hun hade weritt hans wyff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 51,
      "text": "Hand gaff hinder dy røde guld-boond,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 51,
      "text": "der-til ett guld-skru;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 51,
      "text": "thett gaff hand Blidelild Erkis-datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 51,
      "text": "for hun haffde werit hansz frue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 52,
      "text": "Gaff hand hinder thi guld-baann,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 52,
      "text": "och thi war flere ind ny;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 52,
      "text": "thett fortrød hans rige frender,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 52,
      "text": "thi wilde icke haffue vnt hind dy.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 53,
      "text": "Hand gaff hinder thi gulderinge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 53,
      "text": "thi war buode høffske och bold:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 53,
      "text": "\"Thu mindis meg, stalltten Blidelild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 53,
      "text": "nar ieg lieger vnder suortten moldd.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 54,
      "text": "Tthett wor her Elli Buonde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 54,
      "text": "hand wendis till senge-fiell;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 54,
      "text": "saa fuorlig skiffte hand waerden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 54,
      "text": "vdi thend same thaalle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 55,
      "text": "Ind saa kam denn lidell smaa-dreng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 55,
      "text": "och sagde hand daa saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 55,
      "text": "\"Nu renger thett for her Elli Bunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 55,
      "text": "hand buode her vde ved aae.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 56,
      "text": "Saa glad wor Hagenn Benditsenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 56,
      "text": "hand sluog den thauffelbuordtt samell:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 56,
      "text": "\"Herre Gud for-farme seg offuer hans seell!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 56,
      "text": "menn nock daa wor hand gambell.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 57,
      "text": "Tthett wor Hagenn Benditt-senn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 57,
      "text": "red y thend frues gaard;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 57,
      "text": "vd stuod stallten Blidelild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 57,
      "text": "och suobtt war hun y mor.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 233,
      "stanza_id": 58,
      "text": "\"Her stander y, stallten Blidelild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 234,
      "stanza_id": 58,
      "text": "myn kierest wnder ø;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 235,
      "stanza_id": 58,
      "text": "well y mig nu encke loffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 236,
      "stanza_id": 58,
      "text": "y-men y motte icke møø?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 237,
      "stanza_id": 59,
      "text": "\"Hør y thett, Hagenn Bendittsenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 238,
      "stanza_id": 59,
      "text": "følger meg y hyffuelofft ind;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 239,
      "stanza_id": 59,
      "text": "ieg rader med fader och moder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 240,
      "stanza_id": 59,
      "text": "om thett er med deris minde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 241,
      "stanza_id": 60,
      "text": "Ind kaam Blidelild Ericksdatter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 242,
      "stanza_id": 60,
      "text": "saa smaall som en lillie-wand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 243,
      "stanza_id": 60,
      "text": "\"Huad rader y meg, ker fader mynn?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 244,
      "stanza_id": 60,
      "text": "meg bedis Hagen Bendigtsenn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 245,
      "stanza_id": 61,
      "text": "Tthett suaridtt hindis kerre moder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 246,
      "stanza_id": 61,
      "text": "for inden syn skaarlagen sma:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 247,
      "stanza_id": 61,
      "text": "\"Saa-men, du myn kerr datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 248,
      "stanza_id": 61,
      "text": "saa well skalt du hanom faa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 249,
      "stanza_id": 62,
      "text": "Sttalt Blidelild smiler vnder skiend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 250,
      "stanza_id": 62,
      "text": "hun til sin moder suo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 251,
      "stanza_id": 62,
      "text": "\"Alt er thett Hagen Bendit-sen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 252,
      "stanza_id": 62,
      "text": "y sagde, ieg skuld aldrig faa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 253,
      "stanza_id": 63,
      "text": "Saa hellig thaa wor den søndag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 254,
      "stanza_id": 63,
      "text": "den lili hun bleff fest;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 255,
      "stanza_id": 63,
      "text": "manitzs-dag, der efter kaam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 256,
      "stanza_id": 63,
      "text": "bød thi til brølupskaast.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 257,
      "stanza_id": 64,
      "text": "Nu løffuer stalltenn Blidelild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 258,
      "stanza_id": 64,
      "text": "hun haffuer forwonden sin harum;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 259,
      "stanza_id": 64,
      "text": "saa haffuer och Haagen Benditt-sen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 260,
      "stanza_id": 64,
      "text": "hun soffuer vdi hans arum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 261,
      "stanza_id": 64,
      "text": ":: Saa koolde falder thend rime. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}