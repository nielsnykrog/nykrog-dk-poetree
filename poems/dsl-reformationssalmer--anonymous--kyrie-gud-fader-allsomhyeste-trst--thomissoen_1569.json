  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Kyrie. Gud Fader allsomhøyeste trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "du est vor glæde oc lyst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "spar oss ælende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "beuar oss fra Synd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Forbarme dig offuer oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Christe. Du est vor vey oc det sande liuss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Sandhedsens port/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "kierlighedsens speil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "alle Christnes liff oc raad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Du oss til vor salighed giffuen vaarst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Forbarme dig offuer oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Kyrie. Hellig Aand i euighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "vær hoss oss met din miskundelighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "vor synd ville wi begræde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "lad oss ey fortabis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "wi paa dig nu haabe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Forbarme dig offuer oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "CHristus nos reuisit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Paracletum misit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "In cordibus clamantem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "Abba pater sonantem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Kyrieleis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "CHrist den hellig Aand sende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "At wi hans Ord kunde kiende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Oc trøste oss i all vor nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 4,
      "text": "Besynderlig naar wi komme i død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 4,
      "text": "Kyrieleis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "Nu bede wi den hellig Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "alt om den Christelig Tro oc ret forstand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": "det oss Gud beuare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 5,
      "text": "oc sin Naade sende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 5,
      "text": "naar wi heden fare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 5,
      "text": "aff dette ælende/ Kyrieleis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": "Du verdige Liuss giff oss dit skin/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 6,
      "text": "Lær oss at kiende Christum Jesum allene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 6,
      "text": "At wi met hannem bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 6,
      "text": "Vor kiere Frelsermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 6,
      "text": "Som oss monne indlede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 6,
      "text": "Til det Foriette land. Kyrieleis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 7,
      "text": "Du søde Aand skenck oss foruist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 7,
      "text": "At wi maa dricke aff dit kierlighedsens bryst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 7,
      "text": "At wi vdaff hiertet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 7,
      "text": "Huer anden elske/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 7,
      "text": "Met it sind vdi Christo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 7,
      "text": "Oc haffue baade fred oc ro. Kyrieleis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 8,
      "text": "Du ypperste Trøstere i all vor nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 8,
      "text": "Hielp at wi forsmaa Verdsens spot oc wselhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 8,
      "text": "At wi bestandige bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 8,
      "text": "Paa vor siste ende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 8,
      "text": "Naar wi met Dieffuelen kiffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 8,
      "text": "Om dette ælende. Kyrieleis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 9,
      "text": "Wi arme Adams børn alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 9,
      "text": "wi ere saa dybt i Synden faldne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 9,
      "text": "Thi ville wi alle Gud paakalle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 10,
      "text": "Nu bede wi den hellig Aand etc.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 11,
      "text": "Vor natur er baade mørck oc blind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 11,
      "text": "met all forstand skæl siel oc sind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 11,
      "text": "Thi ville wi alle til Gud falde ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 12,
      "text": "Du værdige liuss giff oss dit skin etc.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 13,
      "text": "Wi hade alt det oss er imod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 13,
      "text": "En vil ey være den anden god/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 13,
      "text": "Thi giff du oss it bedre mod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 14,
      "text": "Du søde Aand skenck etc.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "Huer er gantske forfengelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 15,
      "text": "ey vden kiød oc blod met falsk oc suig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 15,
      "text": "Thi ville wi nu alle bede dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "Du ypperste trøstereetc.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 17,
      "text": "Kom hellig Aand Herre Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 17,
      "text": "aff Himmelen send oss vd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "dit liusis klare skin.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 18,
      "text": "Kom alle fattigis Fader kom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 18,
      "text": "kom der giffuer Naadens gaffuer kom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 18,
      "text": "kom O all vor hiertens liuss kom.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 19,
      "text": "Du geffueste trøstermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 19,
      "text": "den sødeste Gæst vdi vor Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 19,
      "text": "saa sødelig vor Siel forlæske kand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 20,
      "text": "J all møde giffuer du trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 20,
      "text": "vdslycker all Synds brynde oc brøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 20,
      "text": "husualer all vor sorg oc graad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 21,
      "text": "O du allerhelligste liuss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 21,
      "text": "optend hiertens inderste huss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 21,
      "text": "J alle dine Christne børn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 22,
      "text": "Thi at vden din Guddoms krafft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 22,
      "text": "haffuer liusit i oss ingen mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 22,
      "text": "men blindhed oc synd i oss er.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 23,
      "text": "Toe alt det som besmittet er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 23,
      "text": "giør det vaat som fortyrcket er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 23,
      "text": "hele det som brødit er.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 24,
      "text": "Blødgiør det som forhærdet er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 24,
      "text": "optend det som forkølet er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 24,
      "text": "hielp det som vildfarend er.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 25,
      "text": "Du giff alle Christne din/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 25,
      "text": "til dig der sette Troen sin/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 25,
      "text": "dine mangfold gaffuer skøn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 26,
      "text": "At wi Christi verdskyld nyde maa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 26,
      "text": "vor Siels salighed lad oss faa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 26,
      "text": "Oc det euige liff til løn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 27,
      "text": "Kom O Herre hellig Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 27,
      "text": "opfyld din Christnes hierte met ret forstand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 27,
      "text": "Oc din brendendis kierlighed i dennem optend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 27,
      "text": "du som atskillige tungemaal sender/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 27,
      "text": "oc der ved Hedninger til Troens endrectighed omuender.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 27,
      "text": "Haleluia/ Loffuer Herren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 28,
      "text": "Kom hellig Aand O Herre Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 28,
      "text": "opfyld met din Naade oc miskund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 28,
      "text": "Dine Christnes hierte hu oc sind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 28,
      "text": "din brendendis kierlighed i dem optend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 28,
      "text": "O Herre met din Naadis liuss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 28,
      "text": "der met bepryd vort hiertis huss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 28,
      "text": "hent dem tilsammen i Verden bo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 28,
      "text": "aff alle tungemaal til en tro.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 28,
      "text": "Haleluia/ Loffuer Herren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 29,
      "text": "Du hellige Liuss oc Vissdoms port/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 29,
      "text": "Lad oss opliusis met Liffsens ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 29,
      "text": "Oc lær oss Gud ret at kiende alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 29,
      "text": "Aff hiertens grund hannem Fader at kalde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 29,
      "text": "O Herre beskerme oss fra fremmede lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 29,
      "text": "At wi ingen Mestere atspørge mere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 29,
      "text": "End Jesum Christ vor Frelsere kiere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 29,
      "text": "At vor Tro kunde til hannem allene være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 29,
      "text": "Haleluia/ Loffuer Herren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 30,
      "text": "Du hellige Jld oc søde trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 30,
      "text": "Hielp oss nu vdi all vor brøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 30,
      "text": "Din villie altid effter at følge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 30,
      "text": "Oc lad ingen modgang oss fra dig skillie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 30,
      "text": "O Herre met din Guddoms krafft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 30,
      "text": "Styrcke oss vsle/ oc giff oss mact",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 30,
      "text": "Gennem sorrig oc bedrøffuelse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 30,
      "text": "At komme til dig vor Frelsere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 30,
      "text": "Haleluia/ Loffuer Herren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 31,
      "text": "O sandheds Kilde oc hiertens fryd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 31,
      "text": "Met aandelig smycke vore hierte bepryd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 31,
      "text": "At wi i Haab oc christelig Tro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 31,
      "text": "Met Gud oc vor Neste i kierlighed bo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 31,
      "text": "O hiertens Herre oc aandelige Liff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 31,
      "text": "Bestrid i oss all Syndsens kiff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 31,
      "text": "Skenck oss din gunst oc stat oss bi/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 31,
      "text": "At wi ey falde i den aandelige Kri.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 31,
      "text": "Haleluia/ Loffuer Herren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 32,
      "text": "O Gud allene vor hiertens trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 32,
      "text": "Afftoe i oss all Syndsens brøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 32,
      "text": "Din Jld/ dit Vand/ dit sandheds Liuss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 32,
      "text": "Lad brende oc toe vort aandelig huss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 32,
      "text": "O Herre Gud i euighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 32,
      "text": "Wi tacke din Barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 32,
      "text": "Beuar i oss det du haffuer giort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 32,
      "text": "Met Aandelig krafft oc hellige Ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 32,
      "text": "Haleluia/ Loffuer Herren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 33,
      "text": "Kom Gud skaber O hellig Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 33,
      "text": "besøg vort hierte met din miskund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 33,
      "text": "met din naade forny vor sind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 33,
      "text": "At wi kunde kiende skabning din.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 34,
      "text": "Du som kaldis vor Trøstermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 34,
      "text": "Den høyeste nogen tid være kand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 34,
      "text": "Met aandelig Salue salue oss met/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 34,
      "text": "At wi met dine gaffuer bliffue besæt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 35,
      "text": "Optend i oss din Guddoms Jld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 35,
      "text": "Oc ødeleg vor egen vild/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 35,
      "text": "Giff oss it hierte rent oc purt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 35,
      "text": "Oc styrcke i oss det du haffuer giort.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 36,
      "text": "Du est siufold i gaffuer skiøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 36,
      "text": "Du est Guds Finger paa den rette haand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 36,
      "text": "Gud Faders ord giffuer du vel fart/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 36,
      "text": "Offuer alle land at predickis snart.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 37,
      "text": "Driff fra oss nu Dieffuelens list/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 37,
      "text": "Lær oss at kiende ret Jesum Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 37,
      "text": "Oc tage Kaarssit aff hans milde haand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 37,
      "text": "Huilckit hand atskillig giffuer alle mand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 38,
      "text": "Lær oss Faderen at kiende vel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 38,
      "text": "Som oss forsørger baade Liff oc Siel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 38,
      "text": "Sin Søn for oss i Døden gaff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 38,
      "text": "At wi skulle icke faa euig straff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 39,
      "text": "Gud Fader være loff oc hans kiere Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 39,
      "text": "Som oss forhuerffde den euige løn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 39,
      "text": "Der til vor trøstere den hellig Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 39,
      "text": "Loff priss oc ære i alle Land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 40,
      "text": "Kom hellig Aand o Herre Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 40,
      "text": "besøg vore hierter oc giff oss mod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 40,
      "text": "du lad oss faa din hellige naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 40,
      "text": "Du lad oss faa din hellige naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 40,
      "text": "oc vær met oss i raad oc daad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 41,
      "text": "For en sand trøst du kiender est/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 41,
      "text": "Salig er den Mand som du est nest/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 41,
      "text": "De haarde hierter giør du veeg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 41,
      "text": "De haarde hierter giør du veeg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 41,
      "text": "Oc giffuer dem en ret kierlighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 42,
      "text": "Dit liuss optend i vor mørcke sind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 42,
      "text": "Giff kierlighed vdi hiertet ind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 42,
      "text": "J huad oss feiler eller bryste maa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 42,
      "text": "J huad oss feiler eller bryste maa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 42,
      "text": "Lad oss aff din naade faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 43,
      "text": "J dine gaffuer est du mangefold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 43,
      "text": "Guds høyre haands Finger vduold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 43,
      "text": "Du lærer Christi Discipler/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 43,
      "text": "Du lærer Christi Discipler/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 43,
      "text": "At prise Gud met mange tunger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 44,
      "text": "Vore Fiender driff oss fra/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 44,
      "text": "At wi Freden nyde maa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 44,
      "text": "Ledsage oss i allen stund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 44,
      "text": "Ledsage oss i allen stund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 44,
      "text": "At wi maa vndfly Dieffuelens fund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 45,
      "text": "Du oss Gud Fader kiende lær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 45,
      "text": "Oc Sønnen som vor Frelsere er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 45,
      "text": "Lad oss oc lære det der nest/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 45,
      "text": "Lad oss oc lære det der nest/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 45,
      "text": "At du aff dem vdgangen est.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 46,
      "text": "Gud Fader oc hans eniste Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 46,
      "text": "Skal være priset i Himmels thron/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 46,
      "text": "Den hellig Aand oc lige saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 46,
      "text": "Den hellig Aand oc lige saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 46,
      "text": "Hand lader oss sin naade faa.",
      "part": false,
      "marginal_notes": []
    }
  ]
}