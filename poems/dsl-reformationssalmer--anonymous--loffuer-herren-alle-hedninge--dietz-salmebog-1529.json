  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "LOffuer Herren alle hedninge:",
      "part": false,
      "marginal_notes": [
        "Psal. cxvj."
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc tilhaabe loffuer Gud alle folk.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Forthi hans miskundhed er stadfest offuer oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "oc Herrens sandhed bliffuer ewindelig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "Aere wære Gud fader oc hans søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "oc saa Gud then Helliaand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Som wærid haffuer aff begyndelsen nw oc altÿd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "fraa ewighed oc til ewighed AMEN.",
      "part": false,
      "marginal_notes": []
    }
  ]
}