  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Jcke oss icke oss min Gud oc Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "men dit naffn skee loff priss oc ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Din naade oc miskund hialp oss her/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "fra vore Fienders grumme begær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "at vore wuenner skal icke sige nu/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "de haffue intet aff deris Herre oc Gud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Dog det siuntis langt at vente bod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Vort haab til Gud allene stod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Huilcken øffuerst vdi Himmelen boer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Haffuer herredom offuer alle Engle Chor/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Regerer oc giør alt hues hand vil",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Paa Jorden/ som wi maa høre til.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Wi din godhed i naaden fand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Hoss oss/ met din frimodig Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Der Fienderne allesteds trengde oss paa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Anden vndsetning kunde wi icke faa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "De komme paa høyre oc venstre side/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Du allene oss hialpst aff den quide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Huilcken der setter sit haab til Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "J hans fryct leffuer effter hans Bud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "Forlader sig paa vor Herre Christ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Som Guds Low for oss opfylte vist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "Hand er deris hielp oc Frelser god",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Som for oss vdstyrte sit Rosens blod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Dem glemmer du icke i deris nød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 4,
      "text": "O Gud/ er det i liff eller død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 4,
      "text": "Du velsignet Aaron din tiener god",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 4,
      "text": "Oc Jsrael/ sig paa dig forloed:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Saa hialpst du oss fattige Synder alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "Der wi i nøden monne paa dig kalde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 5,
      "text": "Det bekiende wi nu foruden suig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 5,
      "text": "J denne forsamling fattig oc Rig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 5,
      "text": "Du beteede oss din villie god/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 5,
      "text": "Vende all wlycke vore Fiender imod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 5,
      "text": "Paa huilcken side de til oss komme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Da stridde du mod dem oss til fromme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 6,
      "text": "Der met beuiste din Guddoms krafft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 6,
      "text": "Met din veldige styrckis mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 6,
      "text": "Saa wi maatte paa vore Fiender see/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 6,
      "text": "At de kunde oss ey mere giøre vee/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 6,
      "text": "Paa det siste vigte de oss fra/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 6,
      "text": "For din mact kunde de icke bestaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 7,
      "text": "Som du hialpst oss i den ringe nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 7,
      "text": "Saa fri oss fra den euige død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 7,
      "text": "Fra Sathan/ vellyst oc sligt mere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 7,
      "text": "Onde forargelse oc Legems begære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 7,
      "text": "At de Fiender oss icke forblinder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 7,
      "text": "Oc vilder/ fra vor enist Frelser kier.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 8,
      "text": "Wi raade alle i nød huer oc en",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 8,
      "text": "At forlade sig paa Gud allen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 8,
      "text": "Jcke paa Affguder aff stock oc sten/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 8,
      "text": "Egen mact/ som ey kand hielpe aff meen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 8,
      "text": "Jcke heller paa Menniskens børn i nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 8,
      "text": "J dag de leffue/ i morgen ere døde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 9,
      "text": "Wi tacke Gud oc vor Frelser kier/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 9,
      "text": "Loffue dem/ for de all ære er verd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 9,
      "text": "Met den hellig Aand vor trøstermand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 9,
      "text": "Som wi her i nøden hoss oss fand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 9,
      "text": "Wi prise dem nu oc til euig tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 9,
      "text": "For vor eniste Gud oc Herre blid.",
      "part": false,
      "marginal_notes": []
    }
  ]
}