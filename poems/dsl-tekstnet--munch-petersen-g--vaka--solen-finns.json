  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "tänd inga bål på länge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "låt mörkret brinna ut,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "flämtande och sent, som det vill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "tänd inga ljus, förrän",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "mörkret rodnande har brunnit ut -,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "låt mörkret stråla sitt svarta ljus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "så länge oljan droppande kan brinna -,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "tänd ingen eld, förrän allt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "sover svart hungerns bidan -",
      "part": false,
      "marginal_notes": []
    }
  ]
}
