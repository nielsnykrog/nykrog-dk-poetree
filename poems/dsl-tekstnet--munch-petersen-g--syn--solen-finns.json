  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "tvenne kannor möttes -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "den ena var rund och",
      "part": false,
