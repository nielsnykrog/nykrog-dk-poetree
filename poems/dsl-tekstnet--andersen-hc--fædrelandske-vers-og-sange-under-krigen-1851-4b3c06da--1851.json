{
  "id": null,
  "title": "Fædrelandske Vers og Sange under Krigen 1851",
  "year_created": 1851,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1851,
    "url": "https://tekstnet.dk/books/andersen-hc_faedrelandske-vers-og-sange-under-krigen-1851/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Det er en stor alvorlig Tid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Men fast til Gud staaer al vor Lid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Vi stride jo den gode Strid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "For Danmark!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Vi vil vor Ret, og ikke meer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Vor Herre vil, det bedste skeer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Thi freidig fremad hver Mand seer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "For Danmark!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Paa Marken, ved det aabne Hav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Staaer mangen gammel Kjæmpe-Grav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Om Kraften i os Vink den gav",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "For Danmark!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "I Landets Vaaben altid stod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Tre Løver, de betyde Mod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Ni Hjerter, det er ærligt Blod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "For Danmark!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Og som af Krøniken vi saae:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Een Mand kan tolv Mænds styrke faae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Ved Enighed vi den vil naae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "For Danmark!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Jeg kan ikke blive, jeg har ingen Ro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Jeg maa med de andre til Leiren!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Vor Sag er retfærdig, og Gud tør vi troe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": ":|: Er med os, han giver os Seiren. :|:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Aarhundreder Danmark var mægtigt og stort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Men saa blev det plukket og plukket.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Nu skal de ei gjøre, hvad før de har gjort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": ":|: For længe har Danmark nu sukket. :|:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "De kan overvælde vort lille Land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Men rokke ei Mod eller Villie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "Thi nu slaae vi alle til yderste Mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": ":|: Vort Skjold er saa reent som en Lilie. :|:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "Jeg føler mig stærk, og jeg kan holde ud!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Tak Moder, Du vil, jeg maa stride.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "Med mig er din Tanke og med mig er Gud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": ":|: Hvad troer du din Søn da kan lide. :|:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "Farvel Allesammen! Jeg har ingen Ro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Jeg maa med de Andre til Leiren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "Vor Sag er retfærdig, og Gud tør vi troe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": ":|: Er med os, han giver os Seiren. :|:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "Som Tegn om gamle Tider hjemme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Om Ridderborg og Ridder-Mod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "Vor Bøsse løfte skal sin Stemme;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "For gamle Danmark Ungdoms Blod!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "Mand staaer ved Mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 10,
      "text": "»Med Gud for Konge og Fædreland!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 10,
      "text": "Nu kommer Herregaards-Skytten!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "Det er den sorte Jæger-Skare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "Med dansk Cocarde og Hanefjer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 11,
      "text": "Blandt Fjendens Flokke skal vi klare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 11,
      "text": "Vort Øie Hjertestedet seer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 11,
      "text": "Mand staaer ved Mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 11,
      "text": "»Med Gud, for Konge og Fædreland!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 11,
      "text": "Nu kommer Herregaards-Skytten!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 12,
      "text": "Tro ikke, Landet er ei lukket,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 12,
      "text": "I Folket staaer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 12,
      "text": "Hver fjendtlig Fugl skal blive plukket,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 12,
      "text": "Hvis Vinge over Gjærdet slaaer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 12,
      "text": "Mand staaer ved Mand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 12,
      "text": "»Med Gud, for Konge og Fædreland!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 12,
      "text": "Nu kommer Herrregaards-Skytten!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 13,
      "text": "Fremad! frem, I danske Drenge!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 13,
      "text": "Husk, I værne maae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 13,
      "text": ",",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 13,
      "text": "Blomst paa Havets Blaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 13,
      "text": "Værne skulle I med Staalet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 13,
      "text": "Danmarks Ret og Modersmaalet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 13,
      "text": "Saa det aldrig glemmes siden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 13,
      "text": "Gud er med i Striden!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 14,
      "text": "Ærlighed til Skjold I føre!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 14,
      "text": "Fjenderne I slaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 14,
      "text": "Saa at det for Verdens Øre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 14,
      "text": "Rigtigt runge maa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 14,
      "text": "Under Kampen Sværdet raade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 14,
      "text": "Efter Kampen Mildhed, Naade!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 14,
      "text": "Fremad! frem, I danske Drenge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 14,
      "text": "Værner Vang og Vænge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 15,
      "text": "Min Lussing skal jeg give,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 15,
      "text": "Som dansk Matros!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 15,
      "text": "Og skulde i Kampen jeg blive,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 15,
      "text": "Er Gud min Lods!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 16,
      "text": "Farvel, farvel, Du gamle Aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 16,
      "text": "Din Bortgangs Skaal vi drikke!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 16,
      "text": "Din Virken dyb alvorlig staaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 16,
      "text": "Dig glemmer Verden ikke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 16,
      "text": "Det nye Aar nu banker paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 16,
      "text": "Kom ind! velkommen være!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 16,
      "text": "Du Barn, som endnu Ondt ei saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 16,
      "text": "Du Freden til os bære!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 17,
      "text": "Fred over Dig, vort Fædreland,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 17,
      "text": "Og dine aabne Strande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 17,
      "text": "Fred i hvert Hjerte, i hver Stand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 17,
      "text": "Fred over alle Lande!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 17,
      "text": "Læg Du de Saar, din Broder slog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 17,
      "text": "Beskjærm os vore Kjære!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 17,
      "text": "Med Hurra og med Dannebrog",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 17,
      "text": "Du af os hilset være!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 18,
      "text": "I Danmark er jeg født, der har jeg hjemme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 18,
      "text": "Der har jeg Rod, derfra min Verden gaaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 18,
      "text": "Du danske Sprog, Du er min Moders Stemme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 18,
      "text": "Saa sødt velsignet Du mit Hjerte naaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 18,
      "text": "Du danske friske Strand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 18,
      "text": "Hvor Oldtids Kjæmpegrave",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 18,
      "text": "Staae mellem Æblegaard og Humlehave,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 18,
      "text": "Dig elsker jeg! – Danmark, mit Fædreland!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 19,
      "text": "Hvor reder Sommeren vel Blomstersengen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 19,
      "text": "Meer rigt end her, ned til den aabne Strand?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 19,
      "text": "Hvor staaer Fuldmaanen over Kløver-Engen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 19,
      "text": "Saa deilig, som i Bøgens Fædreland?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 19,
      "text": "Du danske friske Strand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 19,
      "text": "Hvor Dannebrogen vaier, –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 19,
      "text": "Gud gav os den – Gud giv den bedste Seier! –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 19,
      "text": "Dig elsker jeg! – Danmark, mit Fædreland!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 20,
      "text": "Engang Du Herre var i hele Norden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 20,
      "text": "Bød over England – nu Du kaldes svag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 20,
      "text": "Et lille Land, – og dog saa vidt om Jorden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 20,
      "text": "End høres Danskens Sang og Meiselslag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 20,
      "text": "Du danske friske Strand, –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 20,
      "text": "Plovjernet Guldhorn finder, –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 20,
      "text": "Gud giv Dig Fremtid, som han gav Dig Minder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 20,
      "text": "Dig elsker jeg! – Danmark, mit Fædreland!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 21,
      "text": "Du Land, hvor jeg blev født, hvor jeg har hjemme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 21,
      "text": "Hvor jeg har Rod, hvorfra min Verden gaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 21,
      "text": "Hvor Sproget er min Moders bløde Stemme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 21,
      "text": "Og som en sød Musik mit Hjerte naaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 21,
      "text": "Du danske friske Strand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 21,
      "text": "Med vilde Svaners Rede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 21,
      "text": "I grønne Øer, mit Hjertes Hjem hernede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 21,
      "text": "Dig elsker jeg! – Danmark, mit Fædreland!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 22,
      "text": "Vor gamle Fane, vort Dannebrog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 22,
      "text": "Som Himlen gav os med Seier,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 22,
      "text": "Dig har jeg elsket fra lille Pog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 22,
      "text": "Mit hele Hjerte Du eier.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 23,
      "text": "Du hellige Fane, Du danske Flag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 23,
      "text": "Om Dig straaler Mindernes Glorie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 23,
      "text": "Med Gud og med Dig hos den ærligste Sag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 23,
      "text": "Staaer Danmark i Verdens Historie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 24,
      "text": "De gloende Kugler kan svie din Flig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 24,
      "text": "Men det kun en Stund os bedrøver;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 24,
      "text": "Den danske Matros er og bliver sig lig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 24,
      "text": "Som VaabenetHjerter og Løver.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 25,
      "text": "Hvis selv jeg falder paa Kampens Dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 25,
      "text": "I Kampen for Danmark, for Norden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 25,
      "text": "Saa svøb mig blot i et Dannebrogs Flag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 25,
      "text": "I det vil jeg lægges i Jorden!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 26,
      "text": "Paa Valpladsen faldt Du for Danmarks Sag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 26,
      "text": "Der brast Dit ildfulde Hjerte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 26,
      "text": "Din Aand var klar som den lyse Dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 26,
      "text": "Med »fremad!« den steg i det blodige Slag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 26,
      "text": "Saae Danskens Seier og – Smerte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 27,
      "text": "Græd stakkels Moder, nedbøiet tungt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 27,
      "text": "»Hans Liv var saa ungt!« – men evig ungt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 27,
      "text": "Staaer ogsaa hans Eftermæle!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 28,
      "text": "Vor Tanke flyver til Leiren,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 28,
      "text": "Til Dig i Kamp og paa Vagt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 28,
      "text": "Vor Herre giver Dig Seiren,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 28,
      "text": "Du Danmark har Hæder bragt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 29,
      "text": "Selv Barnet i Aftenbønnen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 29,
      "text": "Høit beder for Dig en Bøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 29,
      "text": "Moderen beder for Sønnen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 29,
      "text": "Du brave, Du herlige Søn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 30,
      "text": "For hvad Du maa prøve og døie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 30,
      "text": "I Kamp, paa Vagt og i Slud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 30,
      "text": "Staae Taarer i mangt et Øie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 30,
      "text": "Gud signe Dig! – Du holder ud!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 31,
      "text": "Danmark deiligst Vang og Vænge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 31,
      "text": "Du vort Fædreland!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 31,
      "text": "Ærligt dine danske Drenge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 31,
      "text": "Sætte skal istand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 31,
      "text": "Ledet, som er bragt af Lave,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 31,
      "text": "Ledet for vor rige Have;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 31,
      "text": "Glædens Julekrands vi flette",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 31,
      "text": "Og paa Gjærdet sætte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 32,
      "text": "Juletræ er tændt derhjemme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 32,
      "text": "Tanken flyver did!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 32,
      "text": "Danske Sprog, Du Hjertets Stemme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 32,
      "text": "Tryl os Julens Tid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 32,
      "text": "– Forpost ude, Stjernevrimlen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 32,
      "text": "Er Dig Julelys paa Himlen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 32,
      "text": "Du staaer under Træets Grene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 32,
      "text": "Om end ude, ene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 33,
      "text": "Lad i Sang og Fryd og Skaaler",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 33,
      "text": "Juleaften gaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 33,
      "text": "Eengang i Erindring straaler",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 33,
      "text": "Deiligt den, som faa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 33,
      "text": "Juleaftenen ved Slien –,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 33,
      "text": "Hjertet blødt og Melodien:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 33,
      "text": "»Danmark deiligst Vang og Vænge!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 33,
      "text": "– Danmark leve længe!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 34,
      "text": "Endnu en Sang i dette Aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 34,
      "text": "Snart har det selv udsjunget,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 34,
      "text": "Men det har sjunget: Dansken slaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 34,
      "text": "Saa det i Verden runged’.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 35,
      "text": "I Slægter lyde skal det Qvad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 35,
      "text": "Hvad Landsoldaten kunde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 35,
      "text": "Ved og ved Frederiksstad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 35,
      "text": "Foruden ved .",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 36,
      "text": "Tak gamle Aar, flyv fri og let!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 36,
      "text": "Hvad vil din Broder bringe?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 36,
      "text": "– Det Øie lee, som før har grædt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 36,
      "text": "Og Fredens Harper klinge!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 37,
      "text": "Det er som en Festdag hver evige Dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 37,
      "text": "Vor Landsoldat kommer tilbage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 37,
      "text": "Fra Huus og til Huus hænge Krandse og Flag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 37,
      "text": "Folk juble fra Gader og Tage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 37,
      "text": "Hvert Laug har sin Fane, Musiken er med,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 37,
      "text": "Og Hurra og Jubel hvert evige Sted.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 37,
      "text": "»Nu komme de! hør fra Voldene Skud!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 37,
      "text": "Saa sunde, saa prægtige see de ud!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 37,
      "text": "Hurra! Hurra! I herlige, brave Soldater!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 38,
      "text": "De komme med Blomster paa Hat og Gevær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 38,
      "text": "Et vandrende Foraar de ligne;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 38,
      "text": "Gaae ind imellem dem, tal med hver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 38,
      "text": "Det er de Mænd, vi velsigne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 38,
      "text": "De stred og døied og udholdt som Faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 38,
      "text": "Og vide selv ikke, hvor store de staae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 38,
      "text": "Den fineste Frøkens Rosenmund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 38,
      "text": "Kunde kysse Soldaten i denne Stund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 38,
      "text": "Hurra! Hurra! I herlige, brave Soldater!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 39,
      "text": "Velsignet er den Dag i Dag!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 39,
      "text": "Velkommen Kammerater, brave!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 39,
      "text": "I har sat Danmarks Led i Lave,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 39,
      "text": "Stærkt Gjærdet blev ved hvert et Slag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 39,
      "text": "– Glad Norsk og Svensk sig stilled’ begge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 39,
      "text": "Med Dannebrog i Danskens Række;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 39,
      "text": ":|: Fostbroderligt flød Nordens Blod;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 39,
      "text": "Vi er jo samme Slægt og Rod. :|:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 40,
      "text": "Og derfor nu med Hjemmets Flag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 40,
      "text": "Som mellem Dannebrog vi svinge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 40,
      "text": "Vi Hilsner fra vor Hjemstavn bringe;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 40,
      "text": "Gud var med Danmarks gode Sag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 40,
      "text": "Høit Glædens Kirkeklokker klinge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 40,
      "text": "De Løver mellem Hjerter springe;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 233,
      "stanza_id": 40,
      "text": ":|: Den Graad, som nu i Øiet staaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 234,
      "stanza_id": 40,
      "text": "I Sang vil straale tusind’ Aar. :|:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 235,
      "stanza_id": 41,
      "text": "Naar Sørgebud fra Danmark klang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 236,
      "stanza_id": 41,
      "text": "Hvor Birken groer og under Fjeldet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 237,
      "stanza_id": 41,
      "text": "For Danmarks Nød blev Taarer fælded’;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 238,
      "stanza_id": 41,
      "text": "Nu lyder Nordens Fryde-Sang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 239,
      "stanza_id": 41,
      "text": "Igjennem Kattegat og Sundet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 240,
      "stanza_id": 41,
      "text": "Den bruser: »Dansken Sei’r har vundet!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 241,
      "stanza_id": 41,
      "text": ":|: Velkommen brave Kammerat!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 242,
      "stanza_id": 41,
      "text": "Hurra, den tappre Landsoldat! :|:",
      "part": false,
      "marginal_notes": []
    }
  ]
}
