  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Det dagis nu i Østen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Det liusner offuer alt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Gud beuar oss fra syndsens brøste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Helffuedis pine oc qual/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "At wi maa Christelig leffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "vort gantske liff til ende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "intet syndeligt verck at øffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "dertil Gud oss naaden sende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Jeg tacker dig milde Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Du haffuer saa naadelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Mig denne Nat beuarit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Oc all forgangen tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Met din naade opholdit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Til denne neruærendis stund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Dieffuelen ey fordærffue skulde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Mig/ met sin listige fund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Jeg beder aff hiertet gierne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Du vilde oc fremdelis",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Mig naadelig beskerme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Som du haffuer til diss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Vnder dine vinger beuare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Som Hønen giør kylinge smaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Jntet ont lad mig vederfaris/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Til dig haffuer ieg min tro.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Vilde mig i dag opliuse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Obne min blinde forstand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Kunde regere mit folck oc huse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Det onde vende dem fra haand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "J mit hierte maatte optendis",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Din hellig Aands liuss oc skin/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Jeg kunde denne dag vel ende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Vden alle laster oc synd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "All kiødelig løse begæring",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "Vilde aff mit hierte vddriffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "At syndelig hantering",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "Maatte fra mit leffnit bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "Jeg maatte retfærdig vorde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "Formedelst en stadig tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "Aff hiertet mine synder at rue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "Baade Siel oc liff til ro.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "Herre Christ min ledsager vilt være",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "J denne Jammerdal/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 5,
      "text": "Dieffuelen mig ey forføre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 5,
      "text": "Fra dit hellig Ord at falde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 5,
      "text": "Hielp stadelig at bekiende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "Dig enist vor Frelser blid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "Der til aff Gud fader vdsender",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "At løse oss fra euig død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "Mig maatte ey meer bedrage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 6,
      "text": "Menniskens fund oc tant/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 6,
      "text": "Aff Dieffuelen løgnens fader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 6,
      "text": "En falsk Guds tieniste optenckt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 6,
      "text": "Men dig stedse dyrcke oc tiene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "J Aanden oc sandhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "J leffnit oc troen den rene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "Alt til min ende oc død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 7,
      "text": "Mig stedse i Guds fryct øffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 7,
      "text": "Vare min befalning oc kald:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 7,
      "text": "Øffrighed tro tienist at pleie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 7,
      "text": "Som Gud haffuer mig befald:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 7,
      "text": "Min villie oc effne hen strecke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 7,
      "text": "At fremme det menige bæste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 7,
      "text": "Til den Arme min haand vdrecke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "Der til Gud mig naaden leste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 8,
      "text": "At dig min Himmelske Fader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 8,
      "text": "Maatte ske loff ære oc priss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 8,
      "text": "Dig Christe Verdsens Frelser",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 8,
      "text": "Ved din tienere ligeruiss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 8,
      "text": "Der til den hellig Aande",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 8,
      "text": "Vor kiere Husualer blid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 8,
      "text": "Jeg kunde gennem kaarss oc vaande",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 8,
      "text": "Omsier faa euig fryd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 9,
      "text": "Det giffue Gud alle Christne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 9,
      "text": "Øffrighed oc Vndersaatte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 9,
      "text": "At troen ey maatte visne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 9,
      "text": "Men brende i Kierligheds daad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 9,
      "text": "For Euangelij liuss der skinner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 9,
      "text": "Tacke Gud allesammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 9,
      "text": "At bliffue Christi Lemmer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 9,
      "text": "J Himmerig giffue Gud/ Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 10,
      "text": "Den signede dag som wi nu see/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 10,
      "text": "ned til oss aff Himmelen komme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 10,
      "text": "Gud liuser for oss io lenger oc meer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 10,
      "text": "oss alle til glæde oc fromme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 10,
      "text": "Gud lade oss icke skee i dag/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 10,
      "text": "huercken last skam eller vaande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 11,
      "text": "Den signede dag den signede tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 11,
      "text": "Vor Herre hans fødzels time/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 11,
      "text": "Da kom der Liuss aff Himmelen ned",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 11,
      "text": "Saa vijt offuer Verden at skinne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 11,
      "text": "Det liuser for oss euindelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 11,
      "text": "Nu oc foruden all ende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 12,
      "text": "Gud Fader Søn oc den hellig Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 12,
      "text": "Met alle sine Engle skare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 12,
      "text": "Beuare oss i dag oc allen stund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 12,
      "text": "Fra alskens Dieffuelens snare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 12,
      "text": "Fra all den affuind hand til oss bær",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 12,
      "text": "Vor Siel oc liff til fare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 13,
      "text": "Det Kaarss vor Herre hand bar for oss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 13,
      "text": "For vore Synd oc icke for sine/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 13,
      "text": "Det setter ieg i dag mellem Dieffuelen oc mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 13,
      "text": "Jeg meener Guds verdige pine/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 13,
      "text": "Det blod der ned paa Kaarssit rand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 13,
      "text": "Det slycker vd synder mine.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 14,
      "text": "Vaar alle de træ i Verden er",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 14,
      "text": "Løff gress oc Sand paa haffsens bonde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 14,
      "text": "Haffde de maal oc kunde de tale",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 14,
      "text": "Oc siunge met Engle stemme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 14,
      "text": "Da kunde de aldrig til fulde loffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 14,
      "text": "Jesum Mariæ Søn den rene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 15,
      "text": "Den lille Fuel hand fluer saa høyt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 15,
      "text": "Oc Værit bær vnder hans vinger/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 15,
      "text": "Det er fuld ont met liden mact",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 15,
      "text": "Mod høye bierg at springe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 15,
      "text": "De strømme de rinde saa frydelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 15,
      "text": "Op vnder de grøne Linde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 16,
      "text": "Dagen hand er aldrig saa lang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 16,
      "text": "At afftenen maa wi io vente/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 16,
      "text": "Liffuit det endis met dødsens tuang/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 16,
      "text": "Huem det vil rettelig betencke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 16,
      "text": "Wi bliffue vdt fuss oc graffuen giøris trang/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 16,
      "text": "Oss følger ingen anden ende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 17,
      "text": "Da giffue det Gud wi haffue saa tient",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 17,
      "text": "J Verden vel til maade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 17,
      "text": "J troen at wi Guds Søn haffue kient",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 17,
      "text": "Saa wi miste icke Guds naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 17,
      "text": "Naar verden haffuer oss sin bag tiluent",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 17,
      "text": "At wi da faa euig Bade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 18,
      "text": "Naar wi skulle til vort Fæderne Land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 18,
      "text": "Oc skillies ved dette ælende:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 18,
      "text": "Da befaler ieg Gud min Siel i haand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 18,
      "text": "J himmerigis glæde at sende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 18,
      "text": "Gud Fader Søn oc den hellig Aand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 18,
      "text": "Hand giffue vort maal god ende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 19,
      "text": "Dig tacker ieg kiere Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 19,
      "text": "at du mig haffuer foruart/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 19,
      "text": "J denne nattis fare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 19,
      "text": "der inde ieg laa saa hart/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 19,
      "text": "met mørckhed ombefangen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 19,
      "text": "dertil vdi stor nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 19,
      "text": "at ieg er det vndgangen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 19,
      "text": "oc fri fra euig død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 20,
      "text": "Jeg vil dig tacken giøre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 20,
      "text": "O du min Herre oc Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 20,
      "text": "Du vilt oc gierne høre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 20,
      "text": "Paa Jorden kunde holdis dit bud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 20,
      "text": "Derfor ieg dig nu beder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 20,
      "text": "Lad ske nu villien din:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 20,
      "text": "Leed mig i dine seder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 20,
      "text": "Oc bryd du villien min.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 21,
      "text": "At ieg nu ey bortuiger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 21,
      "text": "Dine hellige Ord slet fra/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 21,
      "text": "Oc Dieffuelen mig besuiger/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 21,
      "text": "Saa ieg da vild maatte gaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 21,
      "text": "Beholt mig for din ære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 21,
      "text": "Det beder ieg storlige dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 21,
      "text": "Fra Dieffuelens list oc lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 21,
      "text": "Saa offte hand frister mig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 22,
      "text": "Den rette tro mig giffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 22,
      "text": "Paa din Søn Jesum Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 22,
      "text": "Den stund ieg er i liffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 22,
      "text": "Min synd forlad mig vist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 22,
      "text": "O Gud du ey forsager",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 22,
      "text": "Huess du haffuer loffuit fast/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 22,
      "text": "At hand min Synd borttager/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 22,
      "text": "Frier mig fra hendis last.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 23,
      "text": "Jt Christeligt haab mig skencke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 23,
      "text": "For du ret Sandhed est/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 23,
      "text": "J kierlighed mig belencke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 23,
      "text": "Til dem som mig giør værst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 23,
      "text": "At ieg aff dyd mon skinne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 23,
      "text": "Begære ey ære min:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 23,
      "text": "Elske dem aff all min sinde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 23,
      "text": "Effter god villien din.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 24,
      "text": "Dit Ord lad mig blant alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 24,
      "text": "Bekiende/ aff hu oc act/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 24,
      "text": "Oc mig din tienere kalde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 24,
      "text": "Ey frycte vold ey mact",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 24,
      "text": "Huad mig kunde snart omuende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 24,
      "text": "Bort fra din sandhed klar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 24,
      "text": "Men mig paa siste ende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 24,
      "text": "Skick i din Engle skar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 25,
      "text": "Lad mig denne dag fuldende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 25,
      "text": "Oc loffue dit naffn saa fin/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 25,
      "text": "Oc mig ey fra dig vende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 25,
      "text": "Paa yderste ende min/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 25,
      "text": "Beuar mit liff oc",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 25,
      "text": "Oc fructen i disse Land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 25,
      "text": "Huad du mig haffuer giffuit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 25,
      "text": "Staar alt vdi din haand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 26,
      "text": "Herre Christ ieg vil dig prise",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 26,
      "text": "For dine vergierning all/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 26,
      "text": "Som du i ro oc lise",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 26,
      "text": "Mig giffuit haffuer oc skal/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 26,
      "text": "Dit naffn det vil ieg prise",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 26,
      "text": "For du allene est god/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 26,
      "text": "Mig met dit Legeme spise",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 26,
      "text": "Oc skenck mig met dit Blod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 27,
      "text": "O Herre Gud offuer alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 27,
      "text": "Bør dig baade loff oc priss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 27,
      "text": "Jnderlig wi dig paakalde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 27,
      "text": "Din gunst du oss beuiss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 27,
      "text": "At wi i fred maa leffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 27,
      "text": "Din naade giff oss der til/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 27,
      "text": "Met troens vabn oss vebne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 27,
      "text": "For Sathans listige pil.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 28,
      "text": "Loff tack priss heder oc ære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 28,
      "text": "Være dig Gud Fader bold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 28,
      "text": "Oc Christ din Søn vor Herre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 28,
      "text": "For sin godhed mangefold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 28,
      "text": "Aff hiertet i samme maade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 28,
      "text": "Wi loffue den hellig Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 28,
      "text": "Som met sin gunst oc naade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 28,
      "text": "All vor sorrig husuale kand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 29,
      "text": "DEn klare Soel nu skinner fri/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 29,
      "text": "Gladelig aff søffn opstande wi/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 29,
      "text": "Gud ske loff som oss i denne nat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 29,
      "text": "Beskermede fra all Dieffuelens mact.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 30,
      "text": "J dag beuar oss Jesu Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 30,
      "text": "Fra synd oc skam oc Sathans list/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 30,
      "text": "Lad dine hellige Englers skare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 30,
      "text": "Vore vectere være oc oss beuare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 31,
      "text": "At dig vort hierte lyde kand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 31,
      "text": "Dit ord oc villie ey giøre modstand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 31,
      "text": "For øyen at wi dig haffue maa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 31,
      "text": "Vdi alt det som wi slaar paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 32,
      "text": "Lad fremmis vel vor gierning all",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 32,
      "text": "Som huer aff oss vdrette skal/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 32,
      "text": "Saa at vort arbeid møye oc flid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 32,
      "text": "Til loff oc priss dig skeer altid.",
      "part": false,
      "marginal_notes": []
    }
  ]
}