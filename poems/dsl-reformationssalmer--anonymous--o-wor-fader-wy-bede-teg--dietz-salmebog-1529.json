  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Wor fader wÿ bede teg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "som oss haffuer lærd wor Herre Jesus Christ:",
      "part": false,
      "marginal_notes": [
        "Math. vj. Luce. xj."
      ]
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "hør oss thin børn for thin godhed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "thÿ tw vden twil ret barmhiertig æst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "ÿ himmerig er thÿn bolig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "som oss thÿn ord monne lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "dog stædis thÿn macht bode dag oc natt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "oss her paa iorden altÿd beskermer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Helligt worde thit naffn altÿd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "ÿ hwilket allene wÿ salige bliffue/",
      "part": false,
      "marginal_notes": [
        "Acto. iiij."
      ]
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "giff oss thÿn krafft att prÿse thet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "med ord oc gierninger Christelige leffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "tilkomme lad thit rÿge/",
      "part": false,
      "marginal_notes": [
        "Rom. xiiij:"
      ]
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "hwilkit retwÿshed/ fred/ oc glæde er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Paa iorden worde thÿn wilie som ÿ himmelen:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "att wÿ teg lyde wor wilie slaa neder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Giff oss ÿ dag wort daglige brød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "till liff oc siæl wÿ bede teg gierne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Forlad oss oc wore synder snøde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "rett lÿge som wÿ weluilige ere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "att forlade them oss bryde emod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Oc leed oss ey ÿ frelstelse ind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "att oss ey offuerwinder wor fiend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "men frelss oss fraa ont altÿd AMEN.",
      "part": false,
      "marginal_notes": []
    }
  ]
}