  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA13.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Datter och synn moder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "dy sedder y derris bure.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Datter spurde hun moder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Saa orllig om sommer. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Synn moder:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "\"Haffde ieg ingenn broder?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "\"Thu haffde broder bolde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": ":: Saa orlig om someren. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Bolde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "dog hand bleff grebenn paa wollde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "\"Daa laaner meg suerdt och laner meg spiud!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "Lanner meg spiud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "selff well ieg heintte mynn broder vd.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Och der hun kaam till borge-led.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "Tiill borgge-lied,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "greffuens frw hun stuod der-wed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "\"Her stander y greffuens frw saa fynn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "Frw saa fynn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "huor er greffuen, herre dynn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 5,
      "text": "\"Mynn herre er paa thienge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "Paa tinnge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 6,
      "text": "dy rigge fanger att døme.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 6,
      "text": "\"Huor-for well hand dem døme?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "Dennom dømme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 7,
      "text": "dy haffuer io inthett staallitt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 7,
      "text": "I wyser meg, huor thett husz thett er!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 8,
      "text": "Thett hus thett er,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 8,
      "text": "alltt som dy rigge fanger y er!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 8,
      "text": "\"Tthett husz stander for nuorden y wor gaard.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 9,
      "text": "Nuordenn y wor gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 9,
      "text": "thett er saa well for quinder bewart.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 9,
      "text": "Der er for laasz och iarnne-pien.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 10,
      "text": "Iiarnne-peenne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 10,
      "text": "der-for kand ingenn quinder kom ind.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 10,
      "text": "Hun støtte paa dørenn med sinn fuod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 11,
      "text": "Med synn fuod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 11,
      "text": "alle stack dy naffler hindis broder imod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 11,
      "text": "\"Broder, est du inde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 12,
      "text": "Est du inde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 12,
      "text": "och hui luodst du deg biennde?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 12,
      "text": "\"Meg band icke fyrre, meg baannd icke fem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 13,
      "text": "Meg band icke fem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 13,
      "text": "meg bannd well XV af greøffuens mend.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 13,
      "text": "\"Tha staar ieg nu her enn møø for deg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 14,
      "text": "Enn møø for deg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 14,
      "text": "ther skulde icke XV binde meg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 14,
      "text": "Meg skulde icke XXX threde saa ner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 15,
      "text": "Threde saa ner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 15,
      "text": "der skuld røre den dog-skuoff paa min suerdtt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 15,
      "text": "Hun slog synder buode boltte och iiarnn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 16,
      "text": "Bolltt och iiarnn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 16,
      "text": "hun frelsett synn brodder alltt saa gierne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 16,
      "text": "Hun thog her Strange wed huiden hand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 17,
      "text": "Huide hannd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 17,
      "text": "Saa mone hun aff garden gange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 17,
      "text": "Och der dy kaam till borig-leed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 18,
      "text": "Tiill borge-lied,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 18,
      "text": "greffuenns frw hun stuod der-weed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 18,
      "text": "\"Y siger eders harre, nar i komer hiem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 19,
      "text": "Naar hand komer hiem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 19,
      "text": "her waar en møø, hun hienntte enn suend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 19,
      "text": "Men der-som hand well haffue anden buod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 20,
      "text": "Andenn buod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 20,
      "text": "tha bedder hanom mødde meg y marcken vd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 20,
      "text": "bode med skiolld och saa med spiud!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 21,
      "text": "Och saa med spiud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 21,
      "text": "Y bedder hanom mødde meg enne!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 21,
      "text": "for meg følger ingenn suenne.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 21,
      "text": ":: Saa aarllig om somerenn. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}