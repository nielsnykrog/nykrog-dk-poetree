      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 12,
      "text": "Hannem være evig lov",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 12,
      "text": "For hans mange store gaver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 12,
      "text": "Gud, som er saa mild og bliid,",
