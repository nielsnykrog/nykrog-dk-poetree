{
  "id": null,
  "title": "96. JEsu, du min deel i livet",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
    "wiki": "Q348003"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Troens Rare Klenodie",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1739,
    "url": "https://tekstnet.dk/books/brorson-ha_troens-rare-klenodie/098/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "JEsu, du min deel i livet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Brudgom meer end honning sød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Du, som dig for mig har givet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Til den bittre korsets død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "JEsu, du mit hierte fryder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "O mit haab og dyre skat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Min forlængsel dag og nat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Som for Gud mig deylig pryder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Ach hvor skal jeg værdelig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Søde JEsu, prise dig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "O du rige naades kilde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Himlens ære, glands og lyst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Som din fader skikke vilde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Os til frelse, hielp og trøst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Ach! jeg bliver her i live",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Aldrig hellig, god og reen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Men er død som stok og steen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Uden du mig kraft vil give,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Aldrig kand jeg kalde mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Ret en Christen, uden dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Kom, al verdens lyst og længsel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Kom dog hid at styrke mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Kom, at trøste mig i trængsel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Kom, og hielp mig naadelig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Skynd dig til mig hid, min læge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Gud, mit hierte er bered",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Til at tage mod din fred,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Kom, mig snart at vederqvæge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Kom, mit klare lys og skin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "At oplyse mine trin.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Kom, min brudgom, lad mig skue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Din livsalige gestalt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "Sød og liflig som en drue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "Rosen-yndig over alt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "Kom, du lys for alle blinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "Kom, lad see dit lys og glands,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "Kom, min smukke rosen-krands.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "Lad min siel din balsom finde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "Lad mig, søde livets træ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "Hos dig finde ly og læ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "Ach! hvor skal dit milde øye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "O mit smukke hierte-blad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "Mig saa inderlig fornøye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "Giøre mig saa hierte-glad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "At jeg selv skal neppe vide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 4,
      "text": "Hvor jeg vil for glæde hen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 4,
      "text": "Saa livsalig er min ven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 4,
      "text": "Naar jeg faaer hans milde, blide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 4,
      "text": "Smukke øye ret at see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 4,
      "text": "Kand jeg midt i trængsel lee.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 5,
      "text": "Giv mig her den lyst og ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 5,
      "text": "At jeg som en frugtbar qvist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 5,
      "text": "Maa i dig indpodet være,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 5,
      "text": "Denne prydelse er vist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 5,
      "text": "Mere herlig end rubiner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 5,
      "text": "Dyrere end gylden-dragt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 5,
      "text": "Smukkere end demant-pragt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 5,
      "text": "Sødere end rosmariner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 5,
      "text": "Ædlere end perle-snoer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 5,
      "text": "Det er dog kun muld og jord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 6,
      "text": "Her er paradises glæde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 6,
      "text": "I min JEsu vunders læ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 6,
      "text": "Her er sommer-frugt at æde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 6,
      "text": "Af mit skiønne livets træ;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 6,
      "text": "O! hvor sød hans frugt mig smager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 6,
      "text": "O! hvor liflig er den stund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 6,
      "text": "Naar hand rekker mig sin mund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 6,
      "text": "Og saa heftig favnetager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 6,
      "text": "Kys mig, søde siele-ven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 6,
      "text": "Saa er sielen sund igien.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 7,
      "text": "Kom, mit hierte ret at vie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 7,
      "text": "Til din egen tempel ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 7,
      "text": "Verden i mig stille tie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 7,
      "text": "Tael du ene i mit sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 7,
      "text": "At jeg ret mig til dig vender,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 7,
      "text": "At dit legems skat kand faae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 7,
      "text": "Rum udi mit hiertes vraae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 7,
      "text": "At jeg ret din sandhed kiender,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 7,
      "text": "At jeg, fri fra syndens stand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 7,
      "text": "Dig min Gud behage kand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 8,
      "text": "Liflig er din boligs sæde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 8,
      "text": "Fuld af naade, liv og got,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 8,
      "text": "Fred, retfærdighed og glæde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 8,
      "text": "Flyder til os fra dit slot,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 8,
      "text": "Gud, mit hiertes grund forlanger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 8,
      "text": "At jeg giennem tidens vee",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 8,
      "text": "Maa med skarpe øyne see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 8,
      "text": "Hvor din høye bolig pranger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 8,
      "text": "Da i dig saa inderlig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 8,
      "text": "Liv og siel forlyster sig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 9,
      "text": "Vel da den, sin siel forlyster",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 9,
      "text": "Daglig i at prise Gud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 9,
      "text": "Paa hans naade sig fortrøster,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 9,
      "text": "Gaaer frimodig ind og ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 9,
      "text": "Som dig holder for sin klippe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 9,
      "text": "Som i dyd og stilhed vil",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 9,
      "text": "Deres levnet bringe til,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 9,
      "text": "Som vil aldrig JEsum slippe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 9,
      "text": "Hvo saaledes vandrer frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 9,
      "text": "Hand skal finde himlens hiem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 10,
      "text": "Saadan ret til sinds at blive",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 10,
      "text": "Giør min JEsu kierlighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 10,
      "text": "Som ham selv har kundet drive",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 10,
      "text": "Fra sin himmel til os ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 10,
      "text": "O! hvor kand hans død os glæde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 10,
      "text": "O! hvor fryder os hans ord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 10,
      "text": "At vi paa den usle jord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 10,
      "text": "Seer Guds skiønne himmel-sæde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 10,
      "text": "Og af livets strøm og aae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 10,
      "text": "Stundum nogle draaber faae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 11,
      "text": "Lukker alle høye porte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 11,
      "text": "Op i verdens vide land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 11,
      "text": "Fiendens frygt og magt er borte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 11,
      "text": "Ønsker lykke alle mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 11,
      "text": "Ærens konge af det høye",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 11,
      "text": "Kommer i sin herre-pragt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 11,
      "text": "Drager til os ind med magt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 11,
      "text": "Derfor alle sig bemøye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 11,
      "text": "At hans priis kand blive stor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 11,
      "text": "Paa den gandske verdens jord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 12,
      "text": "Lover alle og tilbeder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 12,
      "text": "Denne stærke HErre Gud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 12,
      "text": "Som sit riges grendser breder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 12,
      "text": "Ved sin naade daglig ud;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 12,
      "text": "Hand er Gud, af ham vi haver",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 12,
      "text": "Hvad vi er og har behov,",
