{
  "id": null,
  "title": "Jomfruen og Dværgen",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift I",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVI47.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Ieg wed saa riig en rider",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "en herthugindes datter | saa god",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "med elskoffuen och god willie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "dieris huf | thill samen stod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "och ingen mand thet froe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "thet waar | denn skiønist Iomfru",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "der nogenn med øgenn saa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Hør ÿ thet mÿn skiønne Iomfrue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "i giffuer mig | ethers tro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "ieg will ether elske och ere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "the dage ieg | leffue maa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "for eder mit wif",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "suige hannom chri-st ÿ himerigh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "ther eder haffuer ÿ act att suige |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Giffuer ieg eder mÿn tro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "och suiger ÿ mig saa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "daa er ieg en sorrigfuld meniske",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "af wenner och | frennder for smaadt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "af fader och af moder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "the | driffuer mig alle for haedt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "I tider nu kuer min skiønne Iomfru",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "i siger icke | sliigth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "thenn onnde och denn gode",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "skulde icke samell | were ligt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "bliffue hand baade vsell och arm",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "suig | hannom christ ÿ himerig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "der giør eder denn harm |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 4,
      "text": "Troen der di gaffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "wdi then samme stund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "och | stefnnen di datt saatte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "wdi thenn grønne lund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "hui | kommer wÿ thet thill weie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "then wecter er mÿnn | wenn saa god",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "ieg will thet for hannom sie |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 5,
      "text": "Denn Iomfru gick ad di borge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "och baade till och fra |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "saa giørlig kunde hun thet wocte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "att ingenn | mand thet saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "o wecther wille du migh loffue |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "en lidenn stundt ÿ grønnen lundt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "snacke | med enn Rider saa skiønne |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 6,
      "text": "I tier nu kuer mÿn skiønne iomfrue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "ÿ siger | icke saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "ethers fader er min rete brød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "ieg thet | iche giøre maa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 6,
      "text": "saa bliffuer wii baade forød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 6,
      "text": "ÿ | eders ere och ieg min lif",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 6,
      "text": "wii wore lanngt beder | wfødt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 7,
      "text": "Hun tog guld korset af sin brÿst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 7,
      "text": "guld ringe af | huiden hand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 7,
      "text": "thenn gaf hun then wecther",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 7,
      "text": "thill | af mÿndels panndt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 7,
      "text": "sie wecter huad ieg thig and |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 7,
      "text": "tøffuer ieg noget forlennge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 7,
      "text": "du kaller mig med | din sanngh |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 8,
      "text": "Then Iomfrw gick ad de borriger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 8,
      "text": "Alt som de dÿr | de spronge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 8,
      "text": "wdi den same grønne lund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 8,
      "text": "Alt som | de Nattegall sange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 8,
      "text": "Hun trøstede sig ved deris sang |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 8,
      "text": "Den rider som ieg i hierted vel vnd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 8,
      "text": "giøris mig | tiden vel lang. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 9,
      "text": "I skoffuen stod den vilde Duerffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 9,
      "text": "oc lydde | hand der paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 9,
      "text": "Min herre haffuer mig til | eder sendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 9,
      "text": "bad i skulle til hannem gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 9,
      "text": "Christ | giffue den bod er vist,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 9,
      "text": "Hun tog aff sin | perle krands,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 9,
      "text": "Hengde den paa Linde Quist. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 10,
      "text": "Saa tog hand den skøne Iomfrw.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 10,
      "text": "Hand | løffte hinde paa sin hest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 10,
      "text": "saa førde hand | hende i bierget,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 10,
      "text": "Alt som hand kunde best, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 10,
      "text": "Se Moder huad ieg haffuer eder førdt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 10,
      "text": "Den | allerskøniste Iomfrw,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 10,
      "text": "I haffuer anten sett | eller hørt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 11,
      "text": "Hør du det min kiere søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 11,
      "text": "Du est hende | icke verd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 11,
      "text": "Hendis fader er en Hertug god |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 11,
      "text": "Hendis Moder aff keiserlig blod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 11,
      "text": "Hun | er saa venne en wiff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 11,
      "text": "Du fører hende | aller saa snart igien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 11,
      "text": "Der lader io fire | deris liff. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 12,
      "text": "I skoffuen kom den Ridder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 12,
      "text": "Vdi den same | stund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 12,
      "text": "da fandt hand Iomfruens perle krands |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 12,
      "text": "Henge i den grønne lund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 12,
      "text": "Hand frøcted det hun | vor mørdt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 12,
      "text": "Hand stack sig paa sinn egen Suerd |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 12,
      "text": "Saa falt hand til Iorden død. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 13,
      "text": "Den duerig hand tog den skøne Iomfrw,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 13,
      "text": "Hand | løffte hende paa sin hest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 13,
      "text": "Saa førde hand | hinde til bage igien",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 13,
      "text": "Alt som hand kunde best, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 13,
      "text": "Der fandt hun Ridderen død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 13,
      "text": "Herre gud | trøst alle de sorrigfuld ere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 13,
      "text": "Husuale mig | bedreffuede mø. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 14,
      "text": "Det vaar stor ynck at høre der paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 14,
      "text": "saa ynkelig vor hendis lade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 14,
      "text": "Der al min hielp oc | trøst tilstod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 14,
      "text": "som mig skulde stÿre oc raade |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 14,
      "text": "Hand ligger nu her for mig død |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 15,
      "text": "Min fader oc min moder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 15,
      "text": "Gud nade dem | sorig fuld baade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 15,
      "text": "Oc saa den arme vecter |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 15,
      "text": "i nar de spørger det saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 15,
      "text": "Det hand vor mig | saa huld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 15,
      "text": "Den Troskaff der hand mig beuiste |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 15,
      "text": "Hun bliffuer hannen ilde betald. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 16,
      "text": "Den Iomfrw fick icke bedre til raad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 16,
      "text": "end i | maa alle høre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 16,
      "text": "Den verste raad tog hun aapaa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 16,
      "text": "som snarist er at spørge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 16,
      "text": "Vdaff stor sorrig oc | harm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 16,
      "text": "Hun stack sig paa den Ridders Suerd |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 16,
      "text": "fald død ned i hans Arm. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 17,
      "text": "I skoffuen stod den wilde Duerff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 17,
      "text": "Oc der | saa hand Aapaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 17,
      "text": "Alder saa han tho konge | Børn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 17,
      "text": "Der verre skebben monne faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 17,
      "text": "hand | tÿcker det vere stor Meen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 17,
      "text": "Saa gick hand | der lidet fraa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 17,
      "text": "Hand hengde sig vdi en green. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 18,
      "text": "Den Veckter begÿnte en vise oc kuad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 18,
      "text": "paa | Muren som hand monne gange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 18,
      "text": "I fulde femten | Vinter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 18,
      "text": "Var natten mig icke saa lang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 18,
      "text": "Gud | raade huor det vil gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 18,
      "text": "Disze stercke drømme |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 18,
      "text": "ieg haffuer drømpt i Aar. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 19,
      "text": "Vaagen loe den Hertuginde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 19,
      "text": "Oc liudde hun | der paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 19,
      "text": "I vogner nu aap min Ædelig | Herre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 19,
      "text": "Den veckter klager sig saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 19,
      "text": "Gud raade | huor det vil gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 19,
      "text": "Rade Gud fader i Himmerig |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 19,
      "text": "Ehuor vor Eniste daatter nu maar. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 20,
      "text": "Aap da stod den Hertug god,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 20,
      "text": "Bedrøffuid i al | sin sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 20,
      "text": "Saa gick hand til den same husz |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 20,
      "text": "Hand acted sin daatter at finde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 20,
      "text": "Lenge hand | lette oc intet hand fandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 20,
      "text": "Borte vaar hans | Eniste daatter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 20,
      "text": "oc hunn vaar vanter end hand |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 21,
      "text": "Det da vor den Hertug god,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 21,
      "text": "Tog veckteren | i halsz oc haar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 21,
      "text": "Oc nu skalt du mig vise |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 21,
      "text": "Alt huor min daatter hun maa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 21,
      "text": "Herre ieg | hender icke saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 21,
      "text": "siden vdi afftis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 21,
      "text": "Hund | maanne ad Lunden spazere gaa. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 22,
      "text": "Den Ridder oc den skøne Iomfrw,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 22,
      "text": "for troskaff lod de deris Liff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 22,
      "text": "Oc saa giorde oc | den veckter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 22,
      "text": "alt i den same tid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 22,
      "text": "Ieg viste | det vel for lang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 22,
      "text": "Ieg sagde det alt den skøne | Iomfrw,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 22,
      "text": "Det skulle osz offuergange. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 23,
      "text": "Det da giorde den Hertug god,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 23,
      "text": "Vdaff stor | sorrig oc Nød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 23,
      "text": "Hand drog vd sitt forgÿlte | suerd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 23,
      "text": "Hand stack den veckter al død |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 23,
      "text": "Der effter en stackede stund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 23,
      "text": "fandt de den | Ridder oc den skøne Iomfrw,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 23,
      "text": "Ligge død | vdi Rosens Lund. |",
      "part": false,
      "marginal_notes": []
    }
  ]
}