{
  "id": null,
  "title": "Tyrus og Philomela",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift II",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVII35.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Der boer en koninng i Tracie land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Tyrus ved naffn saa hede hand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "hand hialp der mange, det forste di kam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "der hand deris nød och trang fornam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "hand gaff dennem landzknect, skib och skude,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "och sielff drog handt y striden vd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "De finder op att Parding stodt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "da vilde hand trede dennom vnder foed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "thi kom hand der met stor krigs mact",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "och hialp de herrer med stor act",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "for abed och megenn vmage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "som Tyrus drog frem i disze dage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Parding haffde daatter tho,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "de skøniste mand vilde sette øyen paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "den ene hede Prona ved sit naffn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "hende ganger aff saa vide saffn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "den anden heder Philomela fyn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "er langt berømt for tungemaall sin.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Den sinde den striid haffde fanget ende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Perding bud effter Tyrus sende:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "\"Bed hannem komme med en hast,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "ieg vil betale hannem striden strax",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "for arbed och møgen wmagh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "som vaar draget frem i disze daghe.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Tyrus hand giorde Sextus vred,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 4,
      "text": "guld sadel hand paa hesten mone brede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 4,
      "text": "hand faar offuer søe och salten vand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 4,
      "text": "oc kom saa til Colatinus landt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "hand vor vel glad i hierte och sind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "och red saa strax i staden ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 5,
      "text": "Perding kom aff slotten ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 5,
      "text": "och mange rider effter hannem red,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 5,
      "text": "vel vor hand kled i guld och mord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 5,
      "text": "for hannem da maatte ristis iord;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 5,
      "text": "thi anamit hannem met stor ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "for hand skulle en lang tid hosz denom vere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 6,
      "text": "De fryctit hannem met stor verdighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 6,
      "text": "the tackit Gud, det kunde saa skee:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 6,
      "text": "\"Prona min daatter skalt du haffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 6,
      "text": "och der til konst och gode gaffue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 6,
      "text": "De drock brøllup i maanit sex,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 6,
      "text": "och Prona och Tyrus droge til veis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 7,
      "text": "Hand gaff hannom skib och diur vdj,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 7,
      "text": "attskillige slags er huer aff de,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 7,
      "text": "hand gaff hannem ridder, iomfruer och suene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 7,
      "text": "Perding lod hannom icke fare ene;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 7,
      "text": "hand satte hans skib fra Perding porte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 7,
      "text": "hand kom til Tratia land vel korte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 8,
      "text": "Tha stod der vde baade mand och quinde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 8,
      "text": "vell glad i hierte i hierte och saa i sinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 8,
      "text": "for Thyrus vor kommen igien",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 8,
      "text": "met Prona hans kieriste gode ven;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 8,
      "text": "der sex aar haffde fangit ende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 8,
      "text": "Proma och hin anden kende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 9,
      "text": "Paa hindis kinder der rinder taare:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 9,
      "text": "\"Effter Philomela lenger ieg saa saare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 9,
      "text": "att ieg kunde en sinde ved hinde tale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 9,
      "text": "da maatte forgaa alle bangheds qualle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 9,
      "text": "att ieg aldrig mere skulle lide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 9,
      "text": "for hindis skyld enthen sorig eller quide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 10,
      "text": "Min edelig herre, i giør nu slig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 10,
      "text": "att thet er mig tacknnemeligh.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 10,
      "text": "Hand skød hans skib fra Tratie land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 10,
      "text": "opfylt med mange veldige mandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 10,
      "text": "hand fore til søe och salten vandt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 10,
      "text": "och kam saa til Colatini landt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 11,
      "text": "Guld seill handt neder stige lodt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 11,
      "text": "och strax satte hand sin fod paa iordt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 11,
      "text": "hand drog saa strax til suager sin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 11,
      "text": "till Philomela den quinde finn;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 11,
      "text": "Tyrus saa strax sin tale fremlagde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 11,
      "text": "huad hand schulle der i disze dage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 12,
      "text": "Hand sagde: \"Det er Prona vilie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 12,
      "text": "att Philomela skal mig følge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 12,
      "text": "att hun kunde en sinde ved hinde tale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 12,
      "text": "da maatte forgaa all bangheds quale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 12,
      "text": "att hun skulle aldrig mere lye",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 12,
      "text": "for hindis skyld ey sorig eller quide.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 13,
      "text": "Den sinde hand saae den quinde saa fin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 13,
      "text": "da monne hans hierte op til hende tende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 13,
      "text": "hans hierte den maatte op til hende staa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 13,
      "text": "som ild der tendis och liggis oppaa;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 13,
      "text": "hand mone hans øyen fra hinde vende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 13,
      "text": "fordi hand actet hindet snarlig att skende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 14,
      "text": "Der solen vaar nedganget til iord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 14,
      "text": "da satte de herrer dennem til bord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 14,
      "text": "der bredis dug, der settis paa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 14,
      "text": "forgylden retter, de vaar ey smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 14,
      "text": "forgylde retter de komme til hobe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 14,
      "text": "oc vin wdj forgylte stobe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 15,
      "text": "Der klocken vaar nu slage nj",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 15,
      "text": "till sengen da gick da gick huer aff dj,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 15,
      "text": "de huilit dennem i søffn hinde søde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 15,
      "text": "vden Tyrus lide baade pine och møde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 15,
      "text": "Tyrus grundit i saa saare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 15,
      "text": "huorledis hand kunde den iomfrue dare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 16,
      "text": "Det sinde det togs til att dage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 16,
      "text": "Perding hand til Tyrus sagde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 16,
      "text": "\"Min daatter schal nu met dig fare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 16,
      "text": "for skam och skade du hende beuare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 16,
      "text": "det er saa ont att bygge och boe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 16,
      "text": "och sette sin borg paa fremede iord.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 17,
      "text": "Den sinde Perding vaar til fred,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 17,
      "text": "att Philomela maatte følge met,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 17,
      "text": "hun gaff hannom skenck, hun gaff hannom kyst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 17,
      "text": "hun tog hannem inderlig til sin brøst:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 17,
      "text": "\"Eia, eia, ieg er lystig och glad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 17,
      "text": "att nu er latter, som føre vaar gradt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 18,
      "text": "\"Hør du Philomela, daatter min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 18,
      "text": "kom snart igien til fader din;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 18,
      "text": "bliffuer du i fremede land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 18,
      "text": "sørger ieg mig død, min fattige mand;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 18,
      "text": "du skalt min alderdoms kiep vel vere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 18,
      "text": "och trøste mig nu i angist here.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 19,
      "text": "\"Ieg loffuer eder paa myn kongelig ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 19,
      "text": "att hun skall snart alt huos eder være.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 19,
      "text": "Hun viste det icke, den vsle quinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 19,
      "text": "att Tyrus hagde saa verit i sinde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 19,
      "text": "\"Nu haffuer ieg faatt en dyr i min garn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 19,
      "text": "som ieg haffuer lang vey effter Iegen.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 20,
      "text": "Der di kom i skoffuen ind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 20,
      "text": "den iomfrue hand med vold bortog;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 20,
      "text": "hun robte paa hindis fader och moder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 20,
      "text": "hun robte paa Prona, hindis søster god,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 20,
      "text": "hun robte allermeist paa Gud offuer all,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 20,
      "text": "der hand monne hinde meist offuer falde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 21,
      "text": "Der hand haffde styrit sin onde lyst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 21,
      "text": "da slog den iomfru sig for sin brøst:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 21,
      "text": "\"Eia, eia, mig arme quinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 21,
      "text": "att ieg haffuer seet eder nogen sinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 21,
      "text": "ieg skal eders gierning saa vitt omføre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 21,
      "text": "endog det er mig skam att høre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 22,
      "text": "I actit icke om mynn faders ord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 22,
      "text": "huad hand eder bad med hierte oc mund.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 22,
      "text": "\"I huo som lieder, hand mone finde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 22,
      "text": "meden treer och steen skal met dig vintne;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 22,
      "text": "nu skalt du se din siste ende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 22,
      "text": "thaler du om det, ieg dig skende.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 23,
      "text": "Hand tog hans kniff, hinde tunge affskaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 23,
      "text": "hand kunde hinde icke nere gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 23,
      "text": "hand lotte hinde i en gamel stald,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 23,
      "text": "som hand der vden tog hinde met vold;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 23,
      "text": "saa tog hun en linden klæde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 23,
      "text": "paa hende skødt mon hun den brede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 24,
      "text": "Den last och den synd syit hun der paa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 24,
      "text": "met naal och saa met rød silcke traa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 24,
      "text": "hun hende den vd i linde quist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 24,
      "text": "for den synd och last och det var vist;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 24,
      "text": "Tyrus ganger aff slotten op,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 24,
      "text": "Prona ganger hannom vdi modt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 25,
      "text": "\"Velkomen herre, baade fauer och fin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 25,
      "text": "huor er Philomela, syster min?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 25,
      "text": "\"Den vrede vand och den salten søe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 25,
      "text": "paa veien bleff hun for mig all død.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 25,
      "text": "Sølff och guld der hun aff tog;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 25,
      "text": "och sorge kleder der hun paa drog.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 26,
      "text": "\"Hun er begraffuit met heder och ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 26,
      "text": "vi lader nu alle det saa were.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 26,
      "text": "Der kom en aff Prona quinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 26,
      "text": "den klede monne de i quisten finde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 26,
      "text": "hun baar den hiem, hun der i soe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 26,
      "text": "saa vnderlig der schreffuit i stodt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 27,
      "text": "Hun samlit vaben, bøsze och pill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 27,
      "text": "hun sagde, hun skulle til rytteri:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 27,
      "text": "\"Nu skal ieg liede her inde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 27,
      "text": "alt om ieg kand min syster fynde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 27,
      "text": "Den store steen hun fra døren tog;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 27,
      "text": "meden hun himdis der vdtog.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 28,
      "text": "Tha gred hun taare som vand i haff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 28,
      "text": "\"Min kiere søster, du lader nu aff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 28,
      "text": "ieg skal hugge hannem saa smaa som sand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 28,
      "text": "der paa fanger ieg dig min haandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 28,
      "text": "ieg skal min kongelig vrede optende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 28,
      "text": "den slott den skal ieg offuer hannom skende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 29,
      "text": "Prona gaar aff slotten op,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 29,
      "text": "Ittus hindis liden sønn gaar hind emod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 29,
      "text": "hans huide arm om hindis hals spent,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 29,
      "text": "och søde køsz hand hinde met skenct;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 29,
      "text": "hun stock til hannom met en kniff saare snid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 29,
      "text": "att odden dreff igiemen kiød och skind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 30,
      "text": "Halff part hun sød, halff part hun stegt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 30,
      "text": "en hiemelig maltid hun hannom bered",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 30,
      "text": "met høe ord och stercke stemme:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 30,
      "text": "\"Ittus vor liden sønn icke forglemme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 30,
      "text": "thu mon nu met sielff ede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 30,
      "text": "thet som du monne effter lede.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 31,
      "text": "\"Eia, eia, ieg arme mandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 31,
      "text": "er ieg nu vorden min søns graff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 31,
      "text": "da skal ieg min krop i sønder riffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 31,
      "text": "den kost skal ieg vdaff mig driffue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 31,
      "text": "Hand bleff forsiagit i same stund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 31,
      "text": "och icke talet mere met hans mundt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 32,
      "text": "Prona inboer Ittus hoffuit pande same sinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 32,
      "text": "slog hannom der met ved hans kinde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 32,
      "text": "oc strax fulde effter med en kniff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 32,
      "text": "som hun stack igiemen hans liff;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 32,
      "text": "det fick hand for ondskaff sin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 32,
      "text": "oc lide der for saa hord en pin.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 33,
      "text": "Prona sielff slotten met ild optend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 33,
      "text": "oc saa hosz hannom der inde brende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 33,
      "text": "Der vor en skoff icke langt der fra,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 33,
      "text": "som skoff røffuer pleier idelig att gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 33,
      "text": "der de soe den slot opbrende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 33,
      "text": "tog de der vd huad der vor inde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 34,
      "text": "Ther Philomela det fornam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 34,
      "text": "att denne iamerlig handel gick frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 34,
      "text": "vende hun hiem til hindis faders land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 34,
      "text": "geste paa veien en edell mandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 34,
      "text": "som haffde tilforne hosz fader sin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 34,
      "text": "hør hinde siunge lystig och fin.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 35,
      "text": "Same iuncker hagde i sin husz",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 35,
      "text": "mange heremend der haffde en rusz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 35,
      "text": "bod Philomelam for dem siunge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 35,
      "text": "saa ilde kunde hun sangen begynde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 35,
      "text": "huor vdaff mand bleff megit vred",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 35,
      "text": "och mente, hun giorde aff dennem sped.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 36,
      "text": "Hand viste icke hinde tungeløsz at vere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 36,
      "text": "huor for de giorde hinde megen vanære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 36,
      "text": "hun begynte att sludre det beste hun kunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 36,
      "text": "sloge de hende ihiel som gromme hunde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 36,
      "text": "det bleff hinde endeligt same sinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 36,
      "text": "det vaar stor iammer, den med denne quinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 37,
      "text": "Ther Perding mone disze tidende høre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 37,
      "text": "stor sorigh mon thet hannom paa føre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 37,
      "text": "att hans børn i saa elendig en vaade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 37,
      "text": "vaar kommen i stor iammer och skade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 37,
      "text": "bleff hans lyst och glede borte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 37,
      "text": "liggis der effter i iorden hin sorte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 38,
      "text": "Aff denne vise vi lære skall",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 38,
      "text": "christelig att leffue och skicke osz vell",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 38,
      "text": "osz icke i horerj och løszactighedt vende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 38,
      "text": "eller sorig kommer osz snart til hende;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 38,
      "text": "fryct Gud och holt hans buud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 233,
      "stanza_id": 38,
      "text": "saa hielper hand dig aff sorig vdt.",
      "part": false,
      "marginal_notes": []
    }
  ]
}