  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Ihesus christus er wor salighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "som fraa oss tog gud faders vredhe/",
      "part": false,
      "marginal_notes": [
        "Esaie. liii."
      ]
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "meth sin pine och hellige død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "frelste han oss fraa heluedis nødh",
      "part": false,
      "marginal_notes": [
        "Mat. xxvi."
      ]
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "* Ath vy aldrigh thet forgiæde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "gaff han oss sytth legom ath ædhe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "som er skyuld y brødsens skin/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "oc ath dricke sitt blod y vyn * *",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "* Huem aff thenne kaasth vil ædhe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "sith hierte och Cor. xi. sin sag han ey forgiæde/",
      "part": false,
      "marginal_notes": [
        "i."
      ]
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "huem wverdig her til gaar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "for liffuet tha then euige død han for * *",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "* Thy schal thu gud fadher prise/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "ath han tig saa væl ville spise/",
      "part": false,
      "marginal_notes": [
        "Joh. iii.",
        "Rom. viii."
      ]
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "ath han for thin syndsens løsth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "y døden sin søn haffuer giffueth wisth * *",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "* Saadan naade oc barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "søger eth hierthe y stort arbeid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "esth thu karsk saa bliff her fraa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "ath thu schalt icke fordømmelsen faa *",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "* Thu schalt nu bliffue y stadelig thro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "tha for thu naade mischund och ro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "aff thenne kaasth han haffuer giffueth/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "oss arme til thet euige liff * *",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Han siger selff kommer y arme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "ieg vil meg offuer eder forbarme/",
      "part": false,
      "marginal_notes": [
        "Mat. xi."
      ]
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "ingen læge haffue the karske behoff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "hans kaansth er thennom en spaat och wroo *",
      "part": false,
      "marginal_notes": [
        "Mat. ix."
      ]
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "* Uille thu meth thin gierning fanghe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "y hymmelen for thennom ingange/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "tha wore myn pyne och dødh ey fyllesth/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "for thu tig selff thin salighed esth *",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "* Thror thu fasth aff hiertens grundt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "och bekiender meth thin mund/",
      "part": false,
      "marginal_notes": [
        "Roma. ix."
      ]
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "saa esth thu reeth gansk wæl skickedh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "och thenne kaasth thin siæl wederqueger *",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "* Thenne fructh kan ey hæden være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "brødhre och søstre schal thu ære",
      "part": false,
      "marginal_notes": [
        "Joh. xiii."
      ]
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "meth thin penningh gotz och iordh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "ther meth thennom hielp som gud haffuer boeth *",
      "part": false,
      "marginal_notes": []
    }
  ]
}