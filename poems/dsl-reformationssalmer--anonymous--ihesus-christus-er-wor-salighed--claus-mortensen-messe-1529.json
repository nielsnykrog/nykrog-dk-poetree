    "title": "Thet cristelighe mesẞeembedhe",
    "year_published": 1529,
    "publisher": "Claus Mortensen Tøndebinder",
    "printer": "Oluf Ulriksen",
    "place": "Malmø",
    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
