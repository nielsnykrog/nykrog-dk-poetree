  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Israels Folk forsamlet var i Skolen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Ind af Ruden skinned Sommersolen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Rabbi Mejer stod paa Talerstolen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Silkekjolen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Faldt om ham i prægtigt Draperi.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Vandringen i Ørk’nen han udmalte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Manna blev hvert Ord, hans Tunge talte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Hjertets Sprog sødt Hjerterne husvalte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Mod den hvalte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Høie Himmel svang sig Tanken fri.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "»For den unge Slægt hæv Eders Bønner!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Jehova med Canaans-Landet lønner;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "I de friske Skud vort Haab sig grønner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Vore Sønner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Høste vil den Sæd, vi har nedlagt!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Mens han talte, kom i broget Skare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "Folk mod Byen, tvende Liig de bare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "Bølgen kun sit dræbte Rov lod fare;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Siig, hvo vare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Disse Liig? O, Rabbi! Israels Pragt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "Rabbis Sønner, kyndige i Loven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "Kraftige, som Cederen i Skoven;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "Øinene var’ Stjernen liig deroven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "Under Voven",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Slukt, udslukt, nu kun det døde Leer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "Ei fra Dødens Cherub vristes Rovet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "Rabbis Hustru bøiede sit Hoved:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "»Herren gav, han tog, han være lovet!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "Sødt hensoved’",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": "Laae de, for ei her at vaagne meer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "Over hendes Øines bedste Glæde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "Bredte hun det hvide Dødning-Klæde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "Græd, det er en Trøst at kunne græde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": "Nu indtræde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 6,
      "text": "Saae hun Rabbi, og hun smilte da.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "Kjærligt han paa Panden kyssed’ hende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 7,
      "text": "Dagen og dens Virken var tilende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": "Og han hjalp Sølvlamperne at tænde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 7,
      "text": "Snart de brænde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 7,
      "text": "»Mine Sønner gaaet er herfra?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 8,
      "text": "Siig, hvorfor de ikke er herinde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 8,
      "text": "Ei jeg kunde dem i Skolen finde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 8,
      "text": "Der de savnedes jo ingensinde.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 8,
      "text": "Rabbis Qvinde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 8,
      "text": "Svarede: »De ere tæt herved!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 9,
      "text": "Nadver-Dugen hun paa Bordet lagde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 9,
      "text": "Bægeret med Viin hun Manden rakte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 9,
      "text": "Gud han takked’ for hvad Dagen bragte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 9,
      "text": "Atter sagde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 9,
      "text": "Han: »Kald begge mine Sønner ned!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 10,
      "text": "Hun mod Himlen saae, som en Forklaret;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 10,
      "text": "Qvindens Tro ei briste kan som Glaret.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 10,
      "text": "»De er ikke langt herfra!« hun svared’,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 10,
      "text": "»Sødt bevaret",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 10,
      "text": "Er for os vor Stammes Blomsterblad.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 11,
      "text": "Rabbi smilte, var saa vel tilmode,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 11,
      "text": "Livets bedste Timer for ham stode,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 11,
      "text": "Herren takked’ han for alt det Gode.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 11,
      "text": "Denne Klode",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 11,
      "text": "Er velsignet. Takkebøn han bad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 12,
      "text": "»Kald dog mine Sønner!« – »Tilgiv Kjære!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 12,
      "text": "Sagde hun: »Du maa mig først belære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 12,
      "text": "Du er min Forstand, mit Lys, min Ære, –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 12,
      "text": "Maa mig være",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 12,
      "text": "Her forundt et Spørgsmaal?« – »Tael Du kun!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 13,
      "text": "– »Et Klenodie, der knap fik Mage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 13,
      "text": "Blev betroet min for nogle Dage;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 13,
      "text": "Hjem igjen vil Eieren det tage:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 13,
      "text": "Skal tilbage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 13,
      "text": "Jeg vel give denne sjeldne Skat?« –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 14,
      "text": "– »Kan om Sligt Du spørge, Israels Datter?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 14,
      "text": "Tage i Betænkning? Giv det atter!« –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 14,
      "text": "– »Rabbi, ei min Sjælekamp Du fatter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 14,
      "text": "Jeg det skatter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 14,
      "text": "Det har fyldt min Tanke Dag og Nat!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 15,
      "text": "»Giv tilbage hvad Dig ei tilhører!« –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 15,
      "text": "Med sin Læbe hun hans Kind berører,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 15,
      "text": "Kjærligt, mildt hun ham til Leiet fører,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 15,
      "text": "Der afslører",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 15,
      "text": "Hun de kjære Liig; de blunde sødt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 16,
      "text": "»Mine Sønner! O hvad er min Brøde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 16,
      "text": "Mine Sønner!« Og hans Taarer fløde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 16,
      "text": "»Livets Aften er mig nu saa øde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 16,
      "text": "Døde, døde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 16,
      "text": "Ere de! mit Haab, mit Alt er dødt!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 17,
      "text": "Og hun bort sig vendte ved hans Klage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 17,
      "text": "Følte Gud i sig paa Prøvens Dage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 17,
      "text": "»Rabbi, Du jo lærte nys mig Svage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 17,
      "text": "Giv tilbage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 17,
      "text": "Hvad dets Eier fordre kan med Ret!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 18,
      "text": "Hvis jeg vægred’ mig, en Synd jeg voved!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 18,
      "text": "Rabbi Mejer hævede sit Hoved:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 18,
      "text": "»Herren gav, han tog, han være lovet!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 18,
      "text": "Sødt hensoved’",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 18,
      "text": "Er de Fromme! Støvet vorde Muld!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 19,
      "text": "Og han følte Trøst og Haab derinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 19,
      "text": "Ja, et Sjæle-Mod, som ingensinde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 19,
      "text": "»Den, som Gud velsigne vil, han finde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 19,
      "text": "Skal en Qvinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 19,
      "text": "Trofast, prøvet, som det rene Guld!«",
      "part": false,
      "marginal_notes": []
    }
  ]
}
