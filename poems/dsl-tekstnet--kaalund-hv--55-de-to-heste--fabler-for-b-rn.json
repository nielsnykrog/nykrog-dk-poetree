  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Naar Godtfolk mødes, de hilse: God Dag!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Med Heste er det en anden Sag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "de se paa hinanden; men havde de Ord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "de taled vist om det lækre Fo'er;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "nu tie de stille, de savne Sproget",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "og se saa enfoldigt hen i Taaget.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Det gjør saa dejligt at kløes en Smule -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Hestene tænke: Mule for Mule!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "En Tjeneste er den anden værd;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "saa blive de hjulpne hver især.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Fy skamme Dig, Du, som bortstøder din Næste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Tjenstvillighed lære Dig disse Heste.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
