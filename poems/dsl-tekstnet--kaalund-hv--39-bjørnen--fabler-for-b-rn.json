  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Bjørnen sidder ved Strømmens Skum",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "og rokker og synger: sum, sum, sum!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Han grunder paa i sit laadne Skind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "hvad ej skulde falde et Menneske ind;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "men Busken sig sagte bevæger -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Nu gjælder det, Bjørn: en Jæger!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Et vældigt Spring da Bjørnen gav:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "\"Min Ven, Du har selv kun ondt deraf!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Saa trykker ihjel den Jægeren grum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "og synger som før: sum, sum, sum, sum!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "\"Jeg sagde Dig det jo, Kjære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Du kunde jo ladt mig være.\"",
      "part": false,
      "marginal_notes": []
    }
  ]
}
