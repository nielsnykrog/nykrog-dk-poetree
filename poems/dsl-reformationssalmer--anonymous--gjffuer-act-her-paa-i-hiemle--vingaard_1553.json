  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "GJffuer act her paa i Hiemle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "ieg vil tale/ oc iorden høre orden aff min mund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Min lerdom drypper/ lige som regn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "oc min tale flyder/ lige som dug.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "Lige som Regn paa græssit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "och lige som dropper paa Vrterne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Thi ieg vil prise Herrens naffn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "giffuer vor Gud all ene æren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "Han er en Sten thi hans gierninger ere vstraffelige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "Thi alt det han gør/ det er ret",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 5,
      "text": "Gud er trofast/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "och der er intet ont i hannem/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "Retferdig oc from er han",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "Hin vanartige oc onde art falder aff fra hannem/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "skamsecke ere de/ oc icke hans børn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "Tacker du saa Herren din Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "du daarlige oc vanuittige folck.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "Er ey han din Fader/ oc din Herre?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "er ey han all ene den dig haffuer giort oc bered",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "Tenck paa de forgangne dage indtil nu",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "oc betracte huad han haffuer giort Fæderne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 10,
      "text": "Spør din fader at/ han kundgør deget/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "dine Oldinge/ de sige deget vel.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 11,
      "text": "Der den alderhøyeste vddelte folckene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "oc adspredde Menniskens børn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 12,
      "text": "Da sette han Folckenes Landemercke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "effter Jsraels børns tal.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 13,
      "text": "Thi Herrens del er hans Folck/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "Jacob lodner hannem til arff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 14,
      "text": "Han fand hannem vdi ørcken/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "paa den tørre vild ø/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 14,
      "text": "der som det hylede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "Han førde hannem och gaff hannem Louen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 15,
      "text": "han beuarede hannem som sin egen øyesteen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "Lige som en ørn vdfører sine Vnge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 16,
      "text": "oc flagrer offuer dem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "Han vdbredde sine Fieyre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 17,
      "text": "oc tog dem/ oc førde dem paa sine Vinger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 18,
      "text": "Herren alene ledde hannem/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 18,
      "text": "oc haffde ingen fremmet Gud met sig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 19,
      "text": "Han lod hannem fare høyt paa iorden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 19,
      "text": "oc spisede hannem met fructen aff marcken.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 20,
      "text": "Ocsaa lod han hannem sue Honnig aff Stenen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 20,
      "text": "oc Olie aff den horde Sten.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 21,
      "text": "Smør aff Køerne oc milck aff Faarene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 21,
      "text": "oc met Fitted aff Lammene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 22,
      "text": "Oc fede Vædre/ oc bucke met fede Nyrer oc huede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 22,
      "text": "oc skenckte hannem got drueblod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 23,
      "text": "Men der han vor bleffuen fed oc met/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 23,
      "text": "da bleff han kæd/ fed/ tyck/ oc hyldig vor han.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 24,
      "text": "Oc han lod fare den Gud som hannem haffde giort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 24,
      "text": "oc actede sin Salighedz sten ringe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 25,
      "text": "Oc errede hannem met hine fremmede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 25,
      "text": "ia met verstyggelighed fortørnede han hannem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 26,
      "text": "De offrede Skoudieffle/ oc icke deris Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 26,
      "text": "de guder der de kende intet til/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 26,
      "text": "som vore ny och haffde ey før verit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 26,
      "text": "huilcke eders fædre haffde icke æret",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 27,
      "text": "Men ved din Sten der dig fødde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 27,
      "text": "haffuer du verit skødesløes",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 28,
      "text": "Oc den Gud som dig haffde giort",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 28,
      "text": "haffuer du ladt i forglemmelse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 29,
      "text": "Oc der Herren det saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 29,
      "text": "da bleff han vred paa sine Sønner oc Døtter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 30,
      "text": "Oc han sagde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 30,
      "text": "ieg vil skiule mit ansict for dem/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 30,
      "text": "ieg vil see huort det vil hen met dem omsier",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 31,
      "text": "Di det er ith wbeslaget pack/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 31,
      "text": "det er falske Børn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 32,
      "text": "De haffue erret mig met det som icke er Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 32,
      "text": "met deris affguderii haffue de fortørnet mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 33,
      "text": "Saa vil ieg oc erre dem igen met det som icke er folck/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 33,
      "text": "met ith daarligt Folck vil ieg fortørne dem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 34,
      "text": "Di her er en ild optent i min vrede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 34,
      "text": "oc den skal brende indtil det vnderste Helffuede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 35,
      "text": "Oc han skal fortære landet met sin fruct",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 35,
      "text": "oc sette Jld paa Biergenis grunde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 36,
      "text": "Jeg vil sende dem megen wlycke paa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 36,
      "text": "ieg vil skiude alle mine pile ind paa dem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 37,
      "text": "Aff hunger skulle de forsmectis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 37,
      "text": "oc for tæres aff kulde siuge oc suar heffuelse.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 38,
      "text": "Jeg vil sende vilde Dyurs tender iblant dem/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 38,
      "text": "oc græselige Slanger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 39,
      "text": "Vduortis skal Suerdet berøffue dem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 39,
      "text": "oc induortis forferelse.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 40,
      "text": "Vere sig Dreng och vere sig pige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 40,
      "text": "det diende barn met den gamle Mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 41,
      "text": "At ieg vil sige/ huor ere de?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 41,
      "text": "saa vil ieg tage deres amindelse bort iblant menniskene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 42,
      "text": "Lode ieg det icke for Fiendens vrede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 42,
      "text": "at deris Fiende skulde vorde stoltte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 43,
      "text": "Oc maatte sige/ vor haand er høy/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 43,
      "text": "oc Herren haffuer icke giort alt dette",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 44,
      "text": "Thi det er ith folck der ingen raad er i/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 44,
      "text": "oc der er ingen forstand i dem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 45,
      "text": "O vore de vise/ oc kunde begriffue dette/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 45,
      "text": "ath de forstode huad dem her effter skal vederfaris:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 46,
      "text": "Huor gaar det til/ at en skal foriage Tusinde aff dem?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 46,
      "text": "och tho gienne thi tusinde paa fluct.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 47,
      "text": "Er det ey saa? ath deris Sten haffuer sold dem?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 47,
      "text": "oc ath Herren haffuer offuer giffuet dem?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 48,
      "text": "Thi vaar Sten er icke som deris Steen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 48,
      "text": "des ere vaare Fiende selff dommere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 49,
      "text": "Thi deris Vinstocker aff Sodomas Vinstocke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 49,
      "text": "oc aff Gomorras marck.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 50,
      "text": "Deris druber ere idel Galde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 50,
      "text": "De haffue beske Ber.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 51,
      "text": "Deris Vin er Dragers forgifftelse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 51,
      "text": "oc grum ødlegalde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 52,
      "text": "Er icke saadant skiult hoss mig?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 52,
      "text": "oc beseglet hoss mine liggende Fæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 53,
      "text": "Heffnen er min/ ieg vil gelde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 53,
      "text": "paa sin tid skal deris foed skrie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 54,
      "text": "Thi deris wlycke dag er nær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 54,
      "text": "och det dem forestaar skynder sig fast.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 55,
      "text": "Thi Herren vil dømme sit folck/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 55,
      "text": "oc offuer sine tiænere vil han forbarme sig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 56,
      "text": "Thi han skal det ansee/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 56,
      "text": "at de ere plat vndergaane/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 56,
      "text": "oc huercken den indlucte eller nogen er offuerbleffuen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 57,
      "text": "Oc mand skal sige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 57,
      "text": "huor ere deris guder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 57,
      "text": "deris steen der de forlode sig paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 58,
      "text": "Aff huilkes Offer de ode fetted/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 58,
      "text": "och drucke Vinen aff deris drickoffer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 59,
      "text": "Lader dem nu staa op oc hielpe eder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 59,
      "text": "oc vere eders beskermelse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 60,
      "text": "See i vel nu/ at det er Jeg all ene?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 60,
      "text": "oc at der er ingen Gud hoss mig?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 61,
      "text": "Jeg kan dreffue oc giffue Liff igen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 61,
      "text": "ieg kan sla/ oc læge igen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 61,
      "text": "och ingen kan reddet aff min haand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 62,
      "text": "⁕ Thi ieg vill recke min Haand op i Hiemmelen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 62,
      "text": "Och vil sige/ Jeg leffuer euindelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 63,
      "text": "Naar ieg faar huedt mit Suerdz/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 63,
      "text": "liunet/ oc min haand giffuer til straff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 64,
      "text": "Saa vil ieg igen heffne mig paa mine fiende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 64,
      "text": "oc gelde dem som mig hade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 65,
      "text": "Jeg vil gøre mine Pile druckne aff Blod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 65,
      "text": "oc mit Suerd skal æde Kød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 66,
      "text": "Offuer deris Blod som forslaune ere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 66,
      "text": "Och offuer Fengselet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 66,
      "text": "Och offuer Fiendens bare hoffuit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 67,
      "text": "⁕ Fryder eder alle/ Som ere hans Folck/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 67,
      "text": "Thi han vil heffne sine Tiæneris Blod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 68,
      "text": "Oc han vil heffne sig paa sine fiende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 68,
      "text": "oc vere sit Folckis land naadig.",
      "part": false,
      "marginal_notes": []
    }
  ]
}