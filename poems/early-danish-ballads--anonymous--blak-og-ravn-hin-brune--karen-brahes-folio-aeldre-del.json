{
  "id": null,
  "title": "Blak og Ravn hin brune",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA156.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Hylldebrannd hannd synn søster bortt-gaff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": ":: Vnder lyddenn. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "hynnder tieell manggenn muoddig dag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Ieg weed weell, huor denn iumfru er, der meeg bydder. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Hunn bleeff bortt-gyffuen och ildde gyfft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "wed ald synn gleedde daa bleff hun skieeldtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Om sønndagenn waar hun saa høffskenn brud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "om manddagenn bleff hun saatt y mørckenn bwrre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "\"Mynn herre, huad laadder y wydde meg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "imenn y laader saa bieendde meg?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "\"Tthett haffuer ieg att wyde deeg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "thu førrde icke nock gwld y gaardde tiell meeg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "\"Ieg førrde y etters bwrre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 5,
      "text": "weell otte kyster fullde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "Dy thuo waar fulde aff saabbeell och morrd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "thy tho waar fuldde aff dyrris-hornn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "Tthy thuo waar fwlde aff huyddenn sølleff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 7,
      "text": "thy thuo waar fwld aff rødenn gwld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "Ieg gaff edders faadder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 8,
      "text": "gylltte saaddell och graa ganngger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "Ieg gaff edders muodder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 9,
      "text": "skaarlagenn rød till fuodde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "Ieg gaff edders brodder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 10,
      "text": "sneckenn vdj floude.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "Ieeg gaff edder søster",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 11,
      "text": "røde guld y sytt brøste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "Ieg gaff edders guode hoffmend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 12,
      "text": "skiortter smaa, waar huidde som bienn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "I haffdde aldrig saa lyddenn enn mord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 13,
      "text": "ieg gaff hinder io syllcke tiell synn haard.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "Mynn herre, huad laader y wyde meg?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 14,
      "text": "och huy lader j saa bynnde meg?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "\"Tthett haffuer ieeg att wydde dieeg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 15,
      "text": "dynn brødder dy sluo mynn faadder fraa meg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "\"Ieg matte der slett inthett y wollde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 16,
      "text": "thett mynn brøder wore bløffuen saa bollde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "Tthett feeck y for edders faadders død:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 17,
      "text": "syuff thønder sølleff och guld saa rød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 18,
      "text": "Mynn herre, huad laader y wydde meg?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 18,
      "text": "huor-for laader y saa bynnde meg?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 19,
      "text": "\"Dett haffuer ieg att wydde theeg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 19,
      "text": "thu kaamst icke møø y bwrre till meeg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 20,
      "text": "\"Saa hieellpe meg Gud aff alle mynn nød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 20,
      "text": "som ieg kaam y mynn brwddeseeng møø!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 21,
      "text": "Herre Gud løsse saa weell mynn harum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 21,
      "text": "som ieg kaam møø y eeders arrum!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 22,
      "text": "\"I dag skaalltt dw seedde innde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 22,
      "text": "i morgenn skalltt thu brindde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 23,
      "text": "Der saad hun saa lennge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 23,
      "text": "teell hun hørrde raffuens wennge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 24,
      "text": "\"Hør du nu, raffuenn hynn bruue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 24,
      "text": "kaandtt thu thend weegtter thuoonne?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 25,
      "text": "\"Iaa saa meend, ieg hannom weell kannd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 25,
      "text": "ieg waar saa lyddenn, der ieg hanom naam.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 26,
      "text": "\"Wylldtt thu flyffue for meg tieell Tuone-by?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 26,
      "text": "der buor alld mynn freendder y.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 27,
      "text": "Der buor faader och muoder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 27,
      "text": "mynn søster och mynn broder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 28,
      "text": "Ieg gyffuer deeg ett rødde gwld-baand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 28,
      "text": "du berre mytt buod till Hylldebraannd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 29,
      "text": "Ieg gyffuer theeg thett røødde guld-baann:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 29,
      "text": "thu wildtt hannom sygge vd-aff mynn waande.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 30,
      "text": "\"Huad skaall ieg med thett guld saa røde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 30,
      "text": "langtt heelder tager ieg mynn raffnne-føde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 31,
      "text": "\"Raffuen-lild, wildtt thu flyffue for meg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 31,
      "text": "mynn hiarris hiartte saa gyffuer ieg thieeg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 32,
      "text": "\"Neye saa mend, ieg icke weell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 32,
      "text": "for-vddenn ieg faar hans øggenn tieell.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 33,
      "text": "\"Dw flyff bortt, raffuen-lyld, om dw wildtt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 33,
      "text": "du skallt weell faa hans øggenn teell.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 34,
      "text": "Raffnenn sluo synn wynnger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 34,
      "text": "offuer thrinde konnge-rygge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 35,
      "text": "Raffnenn flyuer y stuoffuen ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 35,
      "text": "som Hyldebrann drecker denn klaarre wynn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 36,
      "text": "\"Hør thu thett, vnge Hylldebraand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 36,
      "text": "dynn søster seedder bunden y haarden baand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 37,
      "text": "Tthu seeder her och drecker wynn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 37,
      "text": "y morgenn daa breender dy søster dynn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 38,
      "text": "Hylldebrannd sprang offuer bredenn borrd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 38,
      "text": "denn kllaarre wynn paa guolditt stuod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 39,
      "text": "Hylldebraand gaar y staalde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 39,
      "text": "hand skuodde thy fuollerr allee.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 40,
      "text": "Hand skuodde denn brune, hand skuodde denn graa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 40,
      "text": "men Black lagde hand gyltte saaddell paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 41,
      "text": "\"Black-lyllde, willdtt dw beerre meeg?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 41,
      "text": "thaarskenn hueedde saa gyffuer ieg dieeg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 42,
      "text": "\"Saa giernne daa wylde ieg beerre deeg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 42,
      "text": "om dw wilde icke nøffne meg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 43,
      "text": "Hylldebrannd saatte seg paa Black synn bag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 43,
      "text": "saa reendde hand offuer denn saalltte hauff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 44,
      "text": "Denn thyd hand kaam der meette paa sund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 44,
      "text": "daa neffnid hand Black y kranckenn stunde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 45,
      "text": "Black hand saam till laande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 45,
      "text": "men Hylldebrand saanck tilbuondde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 46,
      "text": "Iumfruenn staar paa tynnge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 46,
      "text": "der hørde hun Black-lyld skrynny.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 47,
      "text": "\"Nu hørrer ieg Black y kranckenn stund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 47,
      "text": "mynn broder leegger sunckenn paa haffsenns buonde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 48,
      "text": "Black-lyld leebb att tyngenn frem:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 48,
      "text": "haand suo synn søster bonndenn staanddenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 49,
      "text": "Black-lyld ind paa tynngenn sprang:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 49,
      "text": "thy rømett for hanom buode quinde och mand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 50,
      "text": "Black-lyld sluo, och raffnenn hog:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 50,
      "text": "thy stuod y hunddertt maannde bluod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 51,
      "text": "Black-lyld sluo, hand wor saa threett:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 51,
      "text": "hand stuod y mande-blod saa røtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 52,
      "text": "Hand thog synn søster paa synn bag:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 52,
      "text": "hand gyck aff thiengenn, hand waar saa spaag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 53,
      "text": "Tther thy kaam till straande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 53,
      "text": "Hylldebrand stuod paa saannde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 54,
      "text": "Well-komenn, lyddenn Kierstenn, kerre søster mynn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 54,
      "text": "huy blegner deeg dynn rosens-kynnd?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 55,
      "text": "\"Fordy blegner meg myn rosens-kynder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 55,
      "text": "for ieg waar langtt fraa muoder mynn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 56,
      "text": "Ieg raader nu huer daannemand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 56,
      "text": "gyfftte aldrig synn bønn till fremede laannd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 57,
      "text": "Weell faar dy buod sølleff och guld:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 57,
      "text": "dy er dog weed all deris gledde skyld.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 58,
      "text": "Hylddebrand klaper hynder weed huidenn kynd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 58,
      "text": "\"Thu sørgge icke, kierre søster mynn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 59,
      "text": "Mynn kerre søster, for-laad meg wrede:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 59,
      "text": "thend sorig thend haffuer ieg wolditt deeg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 60,
      "text": "Tthett meelltte Black-lild, som hand stuod:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 60,
      "text": "\"Du mynnde meg nu, myn søster guod!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 61,
      "text": "Lydenn Kierstenn, wiltt thu mynndde meeg?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 61,
      "text": "saa giør du och meed raffuen-lild meed!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 62,
      "text": "Saa gladellig mynnditt hun denom for dierris muond:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 62,
      "text": "saa bleff dy frellsitt y same stunde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 63,
      "text": "Hun myndditt denom buode med willy guod:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 63,
      "text": "dy bleff till hynndis brødder, thy huoss hynd stuod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 64,
      "text": "Dy thuog hynnder daa alle vdj derris arum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 64,
      "text": ":: Vnder lyddenn. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 64,
      "text": "forsuondenn er nu buode angist och harum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 64,
      "text": ":: Ieg weed well, huor denn iumfru er, der meg bydder. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}