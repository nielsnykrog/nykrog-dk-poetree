{
  "id": null,
  "title": "62. Snjo, Sigvalds søn",
  "year_created": 1495,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Rimkrøniken",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1495,
    "url": "https://tekstnet.dk/books/anon_rimkroeniken/065/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Tha ieg fick Danmark for ath staa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "och skullæ theres kronæ bæræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Skonæ wor ther tha wundhet fraa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "thet wor myn høystæ kæræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "som thet i wære hade:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Eskildh oc Akildh i theres boo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "ieg thet tijl Danmark ladhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Siden wandh ieg oc Gøttingælandh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Ieg krijde paa Swerigæ til land oc strandh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "meth danskæ riddere och swenæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "Wthi myn tijd so dyr thid kom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "saa dyr som nogher kunne myndes.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "hwat syndh ther tijl skullæ fyndes.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "The roddhe meg them at sla ihiell",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "som ey kunne krij och aule,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "»Forleweth folk och børn om wel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "Tha faa the nogh som leffue igen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "the mwe the rygeth beworæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "och iorden dyrkæ oc bruge sien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 5,
      "text": "som theres foreldernæ giorde foræ.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "thet raadh som wij hadde fwndhet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 6,
      "text": "Hwn sade oss bwrdæ ey meghen prijs",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 6,
      "text": "for bwndh som wij hade bwndhet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "Hwn sade ath »bliffue I wedh thet rodh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 7,
      "text": "tha gøræ I Danmark en ewigh hodh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 7,
      "text": "och en wbodeligh skade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 8,
      "text": "Hwo haffuer seth oc giffuith gæm",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 8,
      "text": "eth slemmer mord bedriffues",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 8,
      "text": "som liff och leffneth giffues?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 9,
      "text": "Wisser heller borth aff rygeth wdh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 9,
      "text": "hwer nyende man som vngher ær",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 9,
      "text": "tijl skips meth kost, skioldh oc spywdh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 10,
      "text": "Tha mwæ the ænthen ærligæ døø",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 10,
      "text": "eller oc syer ærligh wynne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 10,
      "text": "bode tijl land oc so tijl søø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 10,
      "text": "som løcken kan seg tha fynne.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 11,
      "text": "wij lodhe the loder wanckæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 11,
      "text": "Wij gaffue therpaa ey lengher bedh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 11,
      "text": "skønth folk tha mwnne wij sanckæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 12,
      "text": "Hennes søner giorde wij tijl howitzmen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 12,
      "text": "The giordæ wel fullestæ hwer for en",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 12,
      "text": "ihwort wde som the komme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 13,
      "text": "I Blegyngæ fwldhe wij them tijl søøs,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 13,
      "text": "the wore saa fawer en skaræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 13,
      "text": "wij bode them wel ath fare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 14,
      "text": "Tijl Lombardyen bestryde the wel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 14,
      "text": "som ligger i Walland indhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 14,
      "text": "Ther sloffue the alle men ihiell",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 15,
      "text": "Tha skreffues then store prophetis aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 15,
      "text": "sex hundride och firesinnetiuæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 15,
      "text": "och sex theroffuer som scriffuet staar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 15,
      "text": "ieg wil thet ickæ lywæ.",
      "part": false,
      "marginal_notes": []
    }
  ]
}