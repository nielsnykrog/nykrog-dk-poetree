{
  "id": null,
  "title": "31. Efteraarsnaturen",
  "year_created": 1858,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Vilhelm Kaalund",
    "country": null,
