  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "GVdz Engel sider hoss graffuen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Er førd i klarhedzens klædebon",
      "part": false,
      "marginal_notes": [
        "Math xxviii Mar xvi"
      ]
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Huilken quinderne saage oc bleffue forferde aff megen rædzle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "oc stode langt fra",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "* Da talede Engelen sigendis",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Den korsfeste paa mandommen loffuer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "oc den iordede for eders skyld ærefulde gører/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Den som opstod aff døden tilbeder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Frøcter icke/",
      "part": false,
      "marginal_notes": [
        "Mathei xxviii Mar xvi"
      ]
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "ieg siger eder det/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "ath den leffuer hwilken i lede effter/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "menendis død at wære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Oc menniskens liff er opstandit met hannem Alleluia",
      "part": false,
      "marginal_notes": []
    }
  ]
}