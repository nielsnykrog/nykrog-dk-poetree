{
  "id": null,
  "title": "Herr Palles Bryllup",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift I",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVI64.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Ditte war iomffru Gunder-lelle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hun skulle thill kiercke fare:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "der møder hun rider her Palli,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "hand ville hinder med woll bort-tage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: Der springer ud løffuenn y-saa grønner. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Ditt wor rider her Pally,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "hand rider till hengendis karm:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "helsser hand iomffru Gunder-lelle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "hand tog hinde i sinn arm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "\"I rider bort, rider herre Pally,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "i gyør meg ingen menn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "først messen hund er ud-sunggen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "saa vill ieg følle eder hiem.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Dytt war ryder herre Pally,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "hand rider till kiercke och fore:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "for-gyldenne war hans heste-skou,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "forgylldenn var hans spore.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Dytt var iomffru Gunder-lelle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "hun holler y grønnen lund:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "der for-klede hun hindis kiøre-suend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "och satte hanem i karmen sinn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Messen den war ud-siungen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "och folcken dy foer hiem:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "dytt war iomffru Gunder-lelle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "hun følle ryder herre Palli hiem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Saa førde dy denn unge brud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "y rider herre Pallis gard:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "ditt huide suell, ditt røde gulld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "wor for di liegere uspart.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Saa førde di denn unge brud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "allt udi sallit ind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "for ganger bode rydder och suenne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "di bar hindis skarlagenn-skind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Saa satte di denn unge brud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "allt paa den brude-benck:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "for ganger bode ridder och suenne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "di bar for hinder skenck.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Skenckit dy den brunne møød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "och saa den klare vinn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "all denn lannge sommers-dag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "allt for den unge brud ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Dytt wor syldig om afftenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "røgenn hund fielld paa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "och dit var daa denn unge brud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "hun løste at soffue gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Saa føllede dy denn unge brud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "udi dit brude-hus:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "for ganger bode ryder och suenne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "di ber for hinder blues.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "Saa satte di den unge brud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "udi denn brude-senng:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "ditt war ridder herre Pally,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 12,
      "text": "hand duelde icke holle lenge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "Dytt war rider herre Palli,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "hand sattis i senngenn neder:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "ditt daa war den unge brud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 13,
      "text": "hun venndis till vegenn wred.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Dytt war rydder herre Pally,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "klaper hinde wed huiden kienn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "\"Y wender eder hid, iomffru Gunder-lelle!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 14,
      "text": "y er aller-kiereste min.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "\"I legger bort, ryder herre Pally,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "i gør meg ingenn meenn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "ieg er iomffru Gunder-lelle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 15,
      "text": "hindis kiøre-suend.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "\"Och est du iomffru Gunder-lelle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "hindis kiøre-suenn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "aller skalt du gaa leffuendis",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 16,
      "text": "ud-aff min brude-seng!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "Dytt war rider herre Pally,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "hand rober at glauende och spid:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "dytt war iomffruens kiøre-suenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 17,
      "text": "hand sprang att wynnduit ud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "Ditt war iomffruens kiøre-suenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "hand sprang at winduyt ud:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "ditt war iomffru Gunder-lelle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 18,
      "text": "hund hollt hannom ganger i-genn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "Tack haffue iomffruens kiøre-suend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "hand war hinder aller saa troe!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "hand glemte icke hindis hoffde-gulld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 19,
      "text": "icke heller hindis søll-spendit sku.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "Dytt war iomffru Gunder-lelle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "och hun lod spøre under øø:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "\"Monne hand ridder herre Pally",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 20,
      "text": "font min køre-suen møø?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 21,
      "text": "Dytt war iomffru Gunder-lelle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "hun giorde hanem ditt thill harm:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 21,
      "text": "hun sender hanem silcky-suebe-klede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 21,
      "text": "alle till den kiøre-suends barn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 21,
      "text": ":: Der sprang ud løffuenn allt y-saa grønnen. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}