  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "MEt glede oc fred far ieg nu hen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "alt effter Gudz vilge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "vil ieg nu skilyes/",
      "part": false,
      "marginal_notes": [
        "Phil ii"
      ]
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "effter de ord som Gud haffuer loffuit mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "døden skal min søffn worde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Det gør alt Jesus Christ Gudz Søn den tro frelsermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "den ieg haffuer seet met mine øgen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "ieg tror vist ath han er vort liff oc all vor salighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "i nød oc dødens wonde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Den haffuer du herre nu sat fram/",
      "part": false,
      "marginal_notes": [
        "Rom iii"
      ]
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "for alle folk met stor naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "oc til hans rige alle land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "lader bede oc raade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "met dit dyre oc hellige ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "som synder och nør kundgøris",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Han er det klare oc salige liwss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "for alle hedninge/",
      "part": false,
      "marginal_notes": [
        "Joan viii"
      ]
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "ath liwse dem som ere vwiss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "oc Gud icke kende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Han er oc dit folckis Jsrael/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "priss ære/ frøyd oc glede",
      "part": false,
      "marginal_notes": []
    }
  ]
}