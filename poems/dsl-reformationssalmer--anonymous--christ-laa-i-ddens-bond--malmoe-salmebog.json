  "source": {
    "id": null,
    "title": "[tabt]",
    "year_published": 1533,
    "publisher": "Christiern Pedersen",
    "printer": "Joh. Hoochstraten",
    "place": "Malmø",
    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/malmoe-salmebog/1/33"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "CHrist laa i dødens bond",
      "part": false,
      "marginal_notes": [
        "Mathei xxviii"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "for vore synder giffuen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "han er igen opstanden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "gaff oss det euige liff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Ath wi skulle alle tid være glad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "hannem tacke oc prise i alle stad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "siunge Alleluia",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Døden kunde ingen tuinge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "blant alle menniskens sønner/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Det giorde alt vore synder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "ingen vdskyllig vor ath finde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Der aff da kom den død saa snart/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "fick mact offuer oss met en fart/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "holt oss i sith rige fangne Alleluia",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Jesus Christus Gud faders Søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "i vor sted er kommen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "vid hannem faa wi den euige løn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "och døden er offuerwunden/",
      "part": false,
      "marginal_notes": [
        "Osee xiii"
      ]
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "All sin ret oc all sin mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "som wi vore vnderlagt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "bortog Christi død all ene Alleluia",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Der vor en gantske vnderlig krig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "der døden oc liff de stridde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Liffuit fick da mact oc offuerhand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "oc monne døden aff liffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Skrifften haffuer oss det kund giort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Ath Chisti død bedreff det mord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "en spot aff døden er worden. Alleluia",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Her er det rette paaske lam/",
      "part": false,
      "marginal_notes": [
        "Ose xiii i Corin xv Exo xi i Petri i Exo. xii"
      ]
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "om huilkit Gud haffuer budit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "Det er det som paa korsit kom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "for wor skyld stegt oc dødet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "det blod stenckis paa vore dørre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "oc holler døden vden fore/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "Den mørdener kand oss ey røre Alleluia",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Saa holde wi det høye fest/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "met hiertens frøyd oc glede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "ath Jesus Christu er oss nest/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "sin naade lader han oss skine",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "Han er selff retivishedzens liuss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "som opliuser vor hiertens huss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "Syndens nat hun er bortgangen Alleluia",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "Aff det sande Paaske lam",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "æde wi oc saa leffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "den gamle surdey menniskens lærdom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 6,
      "text": "Gudz ord skall han nu wige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 6,
      "text": "Christus han er den sande mad/",
      "part": false,
      "marginal_notes": [
        "i Cor v Mat xv Johan vi"
      ]
    },
    {
      "id": 47,
      "stanza_id": 6,
      "text": "som bespiser den Christne stad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "Troen kan ey andet lide Alleluia",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 7,
      "text": "Han frelste oss fra død och synd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 7,
      "text": "alt met sin bittre pine/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 7,
      "text": "han er oss bleffuen opstandelsen/",
      "part": false,
      "marginal_notes": [
        "Esaie liii"
      ]
    },
    {
      "id": 52,
      "stanza_id": 7,
      "text": "retferdighed monne han giffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 7,
      "text": "Stat op aff søffne all Christenhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 7,
      "text": "lad mørckens gerninger wære dig leed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 7,
      "text": "Retferdelige leff i Christo Jesu alleluia",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 8,
      "text": "Pharaonis mact den grumme mand/",
      "part": false,
      "marginal_notes": [
        "Exo xv oc xvii"
      ]
    },
    {
      "id": 57,
      "stanza_id": 8,
      "text": "er fordømdt met alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 8,
      "text": "Vid Jesum Christ for frelsermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 8,
      "text": "oss aff Egypten han kalde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 8,
      "text": "Her haffue wi sand Mosen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 8,
      "text": "som vdledde all Jsraelss køn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 8,
      "text": "fra syndens trældom til hiertens lyse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 9,
      "text": "Loff priss oc ære være dig Dauid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 9,
      "text": "O Christe vor Konning/",
      "part": false,
      "marginal_notes": [
        "Act vii"
      ]
    },
    {
      "id": 65,
      "stanza_id": 9,
      "text": "som stride for oss mandelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 9,
      "text": "Goliat er offuerunden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 9,
      "text": "som lagde vind paa/ met all sin wold/",
      "part": false,
      "marginal_notes": [
        "i Re xvii"
      ]
    },
    {
      "id": 68,
      "stanza_id": 9,
      "text": "Ath forderffue Jsraelss skiold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 9,
      "text": "Dit aandelige Jsraelss folk sig glæder Alleluia",
      "part": false,
      "marginal_notes": []
    }
  ]
}