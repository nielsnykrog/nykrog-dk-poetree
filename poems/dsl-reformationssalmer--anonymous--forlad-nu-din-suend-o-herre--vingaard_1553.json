  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "FOrlad nu din Suend o Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "effter dit ord i freden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Fordi mine øyen haffue seet din genløselse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "den som du beredde for alle Menniskers Ansicte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "⁕ Jth Liuss til Hedningernis opliuselse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "Oc til dit Folckis Jsraels ære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "⁕ Ere vere Gud Fader oc Gud søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "Ocsaa Gud den Helligaand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "Som verit haffuer aff begyndelsen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "Nu oc altid er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "fra euighed oc til euighed Amen",
      "part": false,
      "marginal_notes": []
    }
  ]
}