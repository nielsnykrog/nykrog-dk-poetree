  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Op! op! at møde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Din Goel, JEsu bruud!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Som for dig døde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Og gik fra døden ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Som ey blev borte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Den stund hand var forkast,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Som bandt den sorte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Den tiid hand selv var fast,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Som freden giorte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Den gang hans hierte brast.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "O! hvilken qvale",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Hans siel og legem bandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Før hand sin dvale",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "I gravens hvile fandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Hand gik i borgen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "For os, vor beste ven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Sank som i sorgen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Og døden gandske hen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Paa paaske-morgen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Da fik vi ham igien.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "O! al min glæde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Jeg løber dig imod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Din grav at væde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Med glæde-taarers flod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "O tusind gange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Velkommen fra min straf,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Fra dine mange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Og svare piners haf,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Fra din den trange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "Og mørke død og grav!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Vor nat er svunden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "For naadens lyse dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "Og vi har vunden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "Med ære al vor sag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "Gid ingen vanke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "I sorgens mørke meer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "Derpaa at anke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "Hvad os i verden skeer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "Da vi de blanke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "Guds himle aabne seer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "Vil satan fnyse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "Mod det, som synes svagt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "Lad dig ey kyse,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "Hand har slet ingen magt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "Lad ham kun larme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 4,
      "text": "Din JEsus er din trøst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 4,
      "text": "Kast dine arme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 4,
      "text": "Om den opstandnes bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 4,
      "text": "Sig at forbarme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 4,
      "text": "Er ham den største lyst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 5,
      "text": "Sank hand til grunde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 5,
      "text": "For os i dødens aae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 5,
      "text": "Mon hand da kunde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 5,
      "text": "Af sine haanden slaae?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 5,
      "text": "Ney, hand vil være",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 5,
      "text": "Vor skiold mod satans list,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 5,
      "text": "Hand vil os hære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 5,
      "text": "Naar vi vor kraft har mist,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 5,
      "text": "Og os erklære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 5,
      "text": "For sine her og hist.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 6,
      "text": "Saa er mig døden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 6,
      "text": "Og livet begge kier,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 6,
      "text": "Er det fornøden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 6,
      "text": "At leve lidet her,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 6,
      "text": "I JEsu naade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 6,
      "text": "Mit levnet skal bestaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 6,
      "text": "Den levemaade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 6,
      "text": "Er sød at tænke paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 6,
      "text": "Saa kand jeg baade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 6,
      "text": "I sorg og glæde gaae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 7,
      "text": "Men skal jeg træde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 7,
      "text": "Til gravens mørke port,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 7,
      "text": "Ja ret med glæde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 7,
      "text": "Den gang skal blive giort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 7,
      "text": "Med brude-mine",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 7,
      "text": "Jeg hilse vil min død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 7,
      "text": "Har JEsus sine",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 7,
      "text": "Dog hende giort saa sød;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 7,
      "text": "Trods dødsens pine!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 7,
      "text": "Jeg døer i JEsu skiød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 8,
      "text": "Kom, søde leye!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 8,
      "text": "I gravens stille borg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 8,
      "text": "Dig kand jeg eye",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 8,
      "text": "Foruden synd og sorg;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 8,
      "text": "Trods dine pile,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 8,
      "text": "Du hele mørkheds trop!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 8,
      "text": "Der kand jeg hvile",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 8,
      "text": "Min arme ømme krop,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 8,
      "text": "Der kand jeg smile,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 8,
      "text": "Naar jeg igien skal op.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
