  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Iegh Reed migh wdtt enn morgenn-stundtt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "iegh acthet thi diur att biede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "iegh fantt | enn Iomfrw wnder enn lindt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "minn tienist | monne iegh hinde biude |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Herre staar ÿ Iomfrw skønn och fÿnn |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "huÿ stander ÿ her saa ene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "huad giør ÿ | saa aarlÿgh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "ÿ diisse gÿrøne enghe, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Iegh liuder paa frÿgd och fule-sangh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "och | paa thenn her sromerszens grøde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "iegh haffuer | enn suend ÿ mit hierthe saa kier",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "for | hannom ber iegh stor mødhe |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Iomfrw war iegh thet wer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "iegh motthe eders | sorrigh forwende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "eders wille tro ttiener iegh werre | well",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "och ind-thiill liffsens ende |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "I haffuer tack skøn wnger-suend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "for ethers | store tuct och sinde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "iegh haffuer enn suend | mitt winskab sagtt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "thet skall migh | ingenn aff-wende |",
      "part": false,
      "marginal_notes": []
    }
  ]
}