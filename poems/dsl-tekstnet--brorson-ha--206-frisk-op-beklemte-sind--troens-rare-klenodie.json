  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Frisk op beklemte sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Kast med et heldte-mod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Din sorg i veyr og vind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Det koste liv og blod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Lad dig ey paa nogen side",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Af din fiendes magt bestride.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "En heldt man kiende kand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Af blodig kamp og striid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Saa er og himlens land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "At faae til evig tiid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Værd sig derfor at umage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Indtil blodet ey forsage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Skiønt os den milde GUd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Sin naade fri har skenkt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Saa er det dog hans bud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Som bliver lidt betænkt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "At man skal med JEsu lide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Kaste verdens lyst til side.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Hvad gik dog Job en vey,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Før hand sin krone tog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "Og Paulus fegted ey",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Som den, i veyret slog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "Hver en martyrs krands og seyer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Blomstrede i blodig leyer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "En svend i nød og død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 4,
      "text": "Sin herre følger med,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 4,
      "text": "Thi kierlighed giør sød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 4,
      "text": "Al fare og fortred,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Kierlighed kand døden jage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "Christi aag er let at drage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 5,
      "text": "I haabet seer jeg alt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 5,
      "text": "De skiønne palmers glands,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 5,
      "text": "Den liflige gestalt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 5,
      "text": "At bære seyrens krands,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 5,
      "text": "Hos de fromme blant saa mange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "I den hvide dragt at prange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 6,
      "text": "Min JEsus skal den sveed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 6,
      "text": "Mig tit har giennemblødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 6,
      "text": "Og giort i kampen heed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 6,
      "text": "Med egen haand saa sødt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 6,
      "text": "Og saa mildelig afviske,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 6,
      "text": "Da skal jeg mig ret forfriske.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
