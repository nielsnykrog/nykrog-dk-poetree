    {
      "id": 0,
      "stanza_id": 0,
      "text": "Iegh kaller thet wæræ en vsel man",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "som inghen mandom gøre kan.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Saadan mandom bedreffs thaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Thil skyps tha slo ieg kæmppær thoo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
