{
  "id": null,
  "title": "Mit hjerte det brænder så hedt som et bål",
  "year_created": null,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Peder Ræv Lille",
    "country": null,
    "wiki": "Q12331790"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": null,
    "url": "https://tekstnet.dk/books/lille-pr_mit-hjerte-det-braender-saa-hedt-som-et-baal/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Mith hierthæ thet brener saa heth som boll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "then werdighæ Guth berothæ worth moll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "thet munnæ ganzæ sorligæ fictæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Ther lathæ iek gernæ all wyn vppaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "en vysæ aff all venestæ ath dictæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "All edhlestæ bloster paa Hemmelsens gren",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "oc frucsoms korn foruthen all men,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "myth hierthæ lister thegh ath lowæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "thet vyll jek syæ oc bewisæ met skell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "them børe thegh neyæ oc bøwæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Rakell, hun mundhæ saa sorligæ klykkæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "for hennæ met thegh mathæ ske then likkæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "All hennes affkom thet glether sekk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "priser oc louer oc hetherer thegh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "ath thu thet noghen tydh spurdhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Johannes oc gamlæ Symeon,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "ther thee till tegh mundhæ spøræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "Johannes gledis lenghæ føren han vort fødh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "oc Symeon i allerdom mødh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "ther thu then gledhen førdhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "virgines, vidue ac doctores",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "met all hymmærighess iherarchia,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "thee glethæ thet blomster vppaa syn gren",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "hwes fructh ther løstæ all verden aff men,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "Guth Father almectustæ ynen syth woll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "Guth Søn met Then Helliganz trennæfoll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "gyuæ allæ worss moll goth endhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "Ihoo thennæ wysæ hauer giordh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "han vell syth naffn ey wendhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": "Amen",
      "part": false,
      "marginal_notes": []
    }
  ]
}
