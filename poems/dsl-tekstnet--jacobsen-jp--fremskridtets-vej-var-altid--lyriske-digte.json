  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Fremskridtets Vej var altid:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Først krybe og dernæst gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Hvo virkelig vil det Store,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Maa ogsaa ha' Mod paa det Smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Thi Ingen er flyvende baaren,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Men: krybe kan vokse til: gaa.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
