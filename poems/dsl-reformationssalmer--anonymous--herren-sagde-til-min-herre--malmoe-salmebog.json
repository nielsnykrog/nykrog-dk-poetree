  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "HErren sagde til min Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "sidh hoss min høgre hand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Saa lenge ieg legger dine fiende til en fodskammel vnder dine føder",
      "part": false,
      "marginal_notes": [
        "Psal. cx"
      ]
    },
    {
      "id": 3,
      "stanza_id": 2,
      "text": "Herren skal vdsende aff Sion din sterckhedz spire/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "haff heredømme mit iblant dine fiende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 3,
      "text": "Dit folk skal der være veluillige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "hellige smøcke paa din sterckhedz dage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 4,
      "text": "Vdaff moders liff skal komme din fødelsis dwg met morgen stunden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 5,
      "text": "Herren haffuer sorid oc det angrer han nem icke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 5,
      "text": "du est effter Melchizedecks skick en prest euindelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 6,
      "text": "Herren vid din høgre hand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 6,
      "text": "skall sla kongerne paa sin grumhedz dag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 7,
      "text": "Han skall døme iblant hedningerne oc opfylde dale met døde kroppe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 7,
      "text": "och sønder sla ith hoffuit offuer mange lande",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 8,
      "text": "Han skall dricke paa veyen aff en beck/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 8,
      "text": "der fore skall han opløffte hoffuedet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 9,
      "text": "Ere være Gud fader och Gud Søn oc Gud den Helligand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 10,
      "text": "Som værit haffuer aff begyndelsen/ nu oc altid er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 10,
      "text": "oc bliffuer til euig tid AMEN",
      "part": false,
      "marginal_notes": []
    }
  ]
}