{
  "id": null,
  "title": "9. Aerostaten",
  "year_created": 1836,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Ørsted",
    "country": null,
    "wiki": "Q44412"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Luftskibet",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1836,
    "url": "https://tekstnet.dk/books/oersted-hc_luftskibet/011/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Bestraalet af en herlig skyfri Himmel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Ombølget af Parises Folkevrimmel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "I snevre Rum et kunstrigt Værksted staaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Og ordnende derinde Charles gaaer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Han forbereder Alt, til snart at stige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Paa luftigt Skib til Æthrens klare Rige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "I Midten halvfyldt sees en Kugle svæve,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Som skal den lette Baad fra Jorden hæve.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "I tætte Trækar rundtom vikles ud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Den Luft, som fylde skal dens Silkehud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "I Rørværk Luften hen til Kuglen føres,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Saa ved det lette Fyld den vægtsvang gjøres.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "En liden Luftbold skal nu foran stige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "For Vindens Retning oven for at sige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Han giver Snoren Mongolfier i Haand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Og siger: »En af dem, hvis høie Aand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Vi skylde denne stolte Banes Ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Med Billighed bør her Anfører være.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Snart er den fyldt, saa meget den bør være,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "For lette Baad med Ladning tung at bære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "Nu Charles, fuld af Mod, bestiger den;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Og med ham er Robert, hans Reiseven.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "De Skibets Baand rask overskjære lade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "og hæve sig fra Jordens Overflade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Beundrende ledsager dem hvert Øie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 4,
      "text": "Det hele Folk taus skuer mod det Høie;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 4,
      "text": "Snart hilses det med Sving af muntre Flag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 4,
      "text": "Som glimte herligt i den klare Dag;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Og Bifalds Jublen lyder som en Torden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "Der opsteg dundrende til dem fra Jorden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 5,
      "text": "Rundt om med Seerør og med Maalekredse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 5,
      "text": "Bevogtes Kuglen af de Lærde stedse.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 5,
      "text": "Aftalt de har, med Flid at agte paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 5,
      "text": "Hvor høit den naaer i Aftenhimlens Blaae;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 5,
      "text": "Og alt som meer den svinder i det Fjerne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Den nyder Ære som en Vandrestjerne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 6,
      "text": "Men for de Tvende paa det høie Stade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 6,
      "text": "Alt mindskes meer og meer paa Jordens Flade;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 6,
      "text": "En Sølvtraad Seinen bli’er for deres Blik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 6,
      "text": "Og største Slot indsvinder til en Prik.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 6,
      "text": "Men stort er Rummet, deres Syn omspænder;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 6,
      "text": "Man Byer der som paa et Landkort kjender.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 7,
      "text": "De maale Luftens Tryk, alt som de stige;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 7,
      "text": "Dets Mindskning maa dem deres Høide sige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 7,
      "text": "Men da man Stigning meer ei bliver vaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 7,
      "text": "Man giver Frihed til et Duepar;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 7,
      "text": "Dog hurtigt atter vende de tilbage;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 7,
      "text": "De føle, her er Vingerne for svage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 8,
      "text": "Men nu Robert sin Ven om Nedfart minder;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 8,
      "text": "Thi hurtigt Dagen mod sin Slutning rinder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 8,
      "text": "Man vil da søge til den faste Grund;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 8,
      "text": "For lette Brændluft aabnes Kuglens Mund;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 8,
      "text": "Dog tør saamegen Luft kun frit undvige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 8,
      "text": "Som spildes bør, for atter ned at stige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 9,
      "text": "Neddalende man har et herligt Skue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 9,
      "text": "Alt malet staaer i Aftensolens Lue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 9,
      "text": "Et gyldent Løvhav Skovens Kroner staae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 9,
      "text": "Hvor for et Vindpust milde Bølger gaae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 9,
      "text": "Og da til sikkre Grund man Anker fæster,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 9,
      "text": "Det sidste Solglimt Dalens Blomster gjester.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 10,
      "text": "De hilses strax af en tililet Skare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 10,
      "text": "Som havde seet dem gjennem Luften fare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 10,
      "text": "Henrykt Enhver den lette Flugt har seet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 10,
      "text": "Og til al Hjelp man skyndsomst er beredt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 10,
      "text": "Ei Nogen her vil blandt de sidste være,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 10,
      "text": "At vise Venskab dem og billig Ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 11,
      "text": "Men Charles, midt i den Beundrings Trængsel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 11,
      "text": "Til nyt Forsøg henrives af sin Længsel.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 11,
      "text": "Nu Skibet, lettet fra hans Reiseven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 11,
      "text": "Et Overmaal af Stigkraft har igjen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 11,
      "text": "Det halve Tab ved Ladning han erstatter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 11,
      "text": "Og op mod Himlens Blaae sig skynder atter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 12,
      "text": "Snelt stiger han, saa hurtigt ingen Glente",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 12,
      "text": "Nedskydende formaaer sit Rov at hente.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 12,
      "text": "Den sjunkne Sol for ham paa ny opstaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 12,
      "text": "Og anden Gang idag for ham nedgaaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 12,
      "text": "Hvor saligt, høitidsfuldt er han tilmode",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 12,
      "text": "Ved dette Smiil fra Lysets høie Klode.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 13,
      "text": "Han i sin Luftørk ei sig føler ene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 13,
      "text": "Bestraalet af den store Himmelscene;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 13,
      "text": "Til fjerne Verdner svæver hen hans Aand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 13,
      "text": "Som var den løst fra Støvets tunge Baand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 13,
      "text": "Her Indsigt bliver Aandeflugtens Moder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 13,
      "text": "Og sætter Væsner paa de fjerne Kloder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 14,
      "text": "Og i en Tilstand mellem Drøm og Vaagen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 14,
      "text": "Det er som svandt fra Øiet Jordetaagen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 14,
      "text": "De Mænd, hvis Viisdom engang skinned her,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 14,
      "text": "Han hisset vandre seer i Lysets Skjær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 14,
      "text": "Pythagoras med Leibnitz deromvanker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 14,
      "text": "Med Newton synes Brahe vexle Tanker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 15,
      "text": "Homeros synes paa Linnee at høre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 15,
      "text": "Og Dante Galilei laaner Øre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 15,
      "text": "Med Thales grubler Stahl paa Luens Art,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 15,
      "text": "Med Plato skuer Rømer Lysets Fart,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 15,
      "text": "Med Empedokles Steno vil opdage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 15,
      "text": "De gamle Spor fra Verdens første Dage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 16,
      "text": "Af denne Himmeldrøm et Glimt ham vækker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 16,
      "text": "Som pludselig ham blænder og forskrækker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 16,
      "text": "Forbi ham farer snelt et Stjerneskud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 16,
      "text": "Og breder rundt om ham sin Klarhed ud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 16,
      "text": "Nu han paa Vennerne hist nede tænker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 16,
      "text": "Og hurtigt gjennem stille Luft sig sænker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 17,
      "text": "Her glade Venner ham til Hjertet trykke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 17,
      "text": "Og tusind Munde ønske ham til Lykke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 17,
      "text": "Hver Velkomst her i Kredsen møder han,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 17,
      "text": "Som kjærlig, varm Beundring yde kan.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 17,
      "text": "Selv Kongens Ætmand kappes med den Ringe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 17,
      "text": "Den velfortjente Hyldning ham at bringe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 18,
      "text": "Hver Mand, som er i Kredsen her tilstede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 18,
      "text": "Sig føler greben af en Seiersglæde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 18,
      "text": "Ei blot man nyder fro, hvad man alt har,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 18,
      "text": "Men og hvad øines gjennem Haabets Glar;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 18,
      "text": "Og Bernardin, fyldt af Begeistringslue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 18,
      "text": "Udbreder høit i Ord sit indre Skue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 19,
      "text": "Hvor bliver Kunst ved Videnskab ei stærk!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 19,
      "text": "Hvad Fabel drømte, staaer som Indsigts Værk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 19,
      "text": "Kun ved en Digtning, spiret fra Fornuft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 19,
      "text": "Beseiler Jordens Søn den lette Luft.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 19,
      "text": "Og Sandhed hævdet har sig Skjønheds Krands;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 19,
      "text": "Thi herligt staaer det for den rene Sands,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 19,
      "text": "At Flugten ei ved Fuglevinger skeer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 19,
      "text": "At Manden flyver uden laante Fjer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 19,
      "text": "I dyben Aand til Kunsten Spiren laae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 19,
      "text": "Og Frugten Kuglen blev paa Himlens Blaae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 19,
      "text": "Skjønt er alt Værket, som et Skuespil;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 19,
      "text": "Men Tiden den til mere modne vil.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 19,
      "text": "Maaskee den ei kan modnes i vor Tid;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 19,
      "text": "Men engang skal den fremme mægtig Id.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 19,
      "text": "Jeg seer den stige til hver Høide let,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 19,
      "text": "Hvor Mennesket kun finder Aandedræt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 19,
      "text": "Han kaster dristig sig i Skyens Favn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 19,
      "text": "Og speider Veiret i dets Fødestavn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 19,
      "text": "Hvad oven skeer i gjennemsigtigt Løn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 19,
      "text": "Skal aabent ligge da for Jordens Søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 19,
      "text": "Og Indsigt skal med sikkert Spaadoms-Blik",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 19,
      "text": "Os forudsige Veirets Art og Skik.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 19,
      "text": "Man skal besøge sneebedækte Pol",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 19,
      "text": "Og Ørknen, sveden gold af stærken Sol.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 19,
      "text": "Barbaren skal os ikke see med Had,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 19,
      "text": "Men vores Overmagt erkjende glad;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 19,
      "text": "Thi hvor for Alle Veien aaben staaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 19,
      "text": "En enkelt Voldsmand intet meer formaaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 19,
      "text": "Jeg seer Ballonen følge med vor Leir,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 19,
      "text": "Og under Slaget vinke os til Seir.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 19,
      "text": "Forgjæves Fjendens Skud den søge skal;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 19,
      "text": "Hans Kugler skal ei bringe den til Fald.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 19,
      "text": "Ja mere frem i Tiden vises mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 19,
      "text": "At den skal gjøre Ende paa hver Krig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 19,
      "text": "Naar intet Slot og ingen Fæstning kan",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 19,
      "text": "En Tilflugt yde Krigens Ophavsmand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 19,
      "text": "Sin egen Rædsel maa da Krigen flye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 19,
      "text": "Og aldrig mere vise sig paa ny.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 19,
      "text": "Dog hvor forvildes jeg! før Jordens Søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 19,
      "text": "Kan blive værdig til en Lod saa skjøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 19,
      "text": "Maa mangen Fordom med sin Taage flye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 19,
      "text": "Og svinde hen for Indsigts Morgengry.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
