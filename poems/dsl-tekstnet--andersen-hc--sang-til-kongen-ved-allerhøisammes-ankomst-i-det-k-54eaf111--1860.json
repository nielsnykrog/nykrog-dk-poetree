  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1860,
    "url": "https://tekstnet.dk/books/andersen-hc_sang-til-kongen-ved-allerhoeisammes-ankomst-i-det-kongelige-akademi-for-de-skioenne-kunster-den-31-marts-1860/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "I Kunstens Hal vi træde ind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Med Andagt, som var det i Kirken!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Du, Konge! kongelig i Sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Beskytter, hiertevarm, vor Virken!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Saa dansk, saa ligefrem, saa tro!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Med Dig i Kjærlighed vi groe!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Gid Du, o Konge! frydes maa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Ved, at fra Kunstens danske Ager",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Guldhorn, med Aandens Indskrift paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Man frem til Verdens Undren drager.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Ved hvert, der lyser frem i Pragt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Er Glands og Magt til Danmark lagt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "I Kunsten Sundhed, Kraft og Glød!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Den løftes til et",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Gid Seirens Rose, frisk og rød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Fra Kunstens høitidsfulde Kirke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Udfolde for Dig Blad ved Blad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Og giøre Dig og Danmark glad!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
