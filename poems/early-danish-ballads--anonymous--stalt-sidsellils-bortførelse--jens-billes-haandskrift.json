  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Jens Billes Håndskrift",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1555,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/BILL30.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Stoltt Sescele er ett rosenblodtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": ":: - i skoffuen - ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "saa thitt gør hun mitt hiertte glatt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "thi gleder iegh migh y allen stadtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: Saa gonges hun ham ey aa. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Stoltt Cettzselle tager sin lille smaa-dreng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "hun sender her Timandtt buden y-gien:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "\"Thu sigh ham aff mitt lønlig men!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Du bedtt ham kom y afften her,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "om han har migh y hiertett kier,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "eller han migh aller for.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "Liden smaa-drengh indtt att døren tren,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "her Timandtt reker ham honden y-gien:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "\"Du ver vell-kommen, du lile smaa-drengh.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "\"Hell sidtt du, her Timandtt, och dricker vin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "her er budtt fra iomfru ditt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "du skalltt komme y afften der.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "Du skalltt komme y afften der,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "om du haffuer hinde y hierttett kier,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 5,
      "text": "eller du hinde aller faar.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "Her Timandtt skødtt dett brede bordtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 6,
      "text": "saa vide da stoncke di sølskolle XII:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 6,
      "text": "\"Danesuene, skyner eder, goed!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "Dannesuene, skynder eder tiill hest!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 7,
      "text": "some y draffuer paa brønin best!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 7,
      "text": "y afften ville vi vere her Rebors giest!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 8,
      "text": "De rede op y stolltt Cetzsels gaardtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 8,
      "text": "ude stodtt stoltt Cetzselle suøbtt y maardtt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 8,
      "text": "\"Vell i nu følle migh aff gaardtt?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 9,
      "text": "De suøbte stoltt Cetzselle y koben blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 9,
      "text": "de løffte hinde paa her Timans gonger graa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 9,
      "text": "saa vide da gongis den orden aff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 10,
      "text": "Dhe rede frem for Thye-bye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 10,
      "text": "der holt her Rebor i brynien ny,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 10,
      "text": "han tore huerken holde eller fly.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 11,
      "text": "Handtt torde huerken hollde eller fly,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 11,
      "text": "bortt førde her Timandtt hans unge brudtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 11,
      "text": "Nu gaar hun i her Timands gaar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 12,
      "text": "Nu gaar hun i her Timands gaardtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 12,
      "text": ":: - i skoffuen - ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 12,
      "text": "nu slider hun rødtt skarlagen, hun drager pell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 12,
      "text": "her Timandtt andtt hinde y hierttett vell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 12,
      "text": "her Rybor sører han seg y-hiell.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 12,
      "text": ":: Saa gonges hun ham ey aa. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}