  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "HErre huem skal haffue sin bolig i dit Paulun/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc huo skal bliffue paa dit hellige Bierg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "⁕ Den som vandrer for vden smitte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "och den som gør Retferdighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "och aff sit hierte taler sandhed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "⁕ Den som icke haffuer belackit met sin Tunge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "oc icke giort sin neste ont/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "och ført hannem paa nogen haanhed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "⁕ De wfromme foractis vdi hans øyen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "men dem som frycte Gud gør han ære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "Den som loffuer sin neste met eed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "oc foruandler det icke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "⁕ Den som icke vdgiffuer sine penninge paa Aager/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 5,
      "text": "oc icke tager gaffuer offuer den wskyldige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "⁕ Huo som dette gør/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "han skal aldrig forfaris euindelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "Ere vere Gud Fader oc Gud Søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 7,
      "text": "Ocsaa Gud den Helligaand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "Som verit haffuer aff begyndelsen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 8,
      "text": "nu oc altid er/ oc bliffuer til euighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 8,
      "text": "Amen",
      "part": false,
      "marginal_notes": []
    }
  ]
}