{
  "id": null,
  "title": "V Mødet",
  "year_created": 1886,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Jens Peter Jacobsen",
    "country": null,
    "wiki": "Q370246"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Gurresange",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1886,
    "url": "https://tekstnet.dk/books/jacobsen-jp_gurresange/005/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Ej danse de Engle for Herren saa herligt,",
      "part": false,
      "marginal_notes": [
        "Speaker: valdemar"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Som Verden nu danser for mig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Ej juble for ham de mer ydmygt og kjærligt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "End Valdemars Hjerte for dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Men stoltere satte ej heller sig Krist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Hos Herren, og lo af sin Kvide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "End Valdemar, glemmende Kummer og Tvist,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Sig sætter ved Tovelils Side.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Ej længes de Sjæle for Himmerigs Mure",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Mer efter at svinge sig ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "End Valdemar, da han fra Øresunds Kure",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Saa' Gurres guldglimtende Tind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Og ej vil jeg bytte dets fredsæle Vang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Og Perlen, den lønligen varer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "For Himmerigs Glans og bedøvende Klang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Og alle de helliges Skarer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Nu siger jeg dig for første Gang:",
      "part": false,
      "marginal_notes": [
        "Speaker: tove"
      ]
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "»Kong Volmer, jeg elsker dig.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Nu kysser jeg dig for første Gang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Og slynger min Arm om dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Og siger du, at jeg det før har sagt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Og at du til Kysset er vant,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Saa siger jeg: »Kongen han er en Nar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Der mindes forfængelig Tant.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Og siger du, saa er jeg selv slig Nar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Saa siger jeg: »Kongen har Ret;«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Men siger du, at jeg det ikke er,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Saa siger jeg: »Kongen er slet.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "For alle mine Roser har jeg kysset ihjel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "Alt mens jeg tænkte paa dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Det er Midnattens Stund,",
      "part": false,
      "marginal_notes": [
        "Speaker: valdemar"
      ]
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Og usalige Slægter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "Staa frem af glemte, sunkne Grave,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "Og de stirre med Længsel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "Paa Borgens Kjerter og Hyttens Lys,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "Og Vinden ned over dem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "Spottende ryster",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "Harpeslæt og Bægerklang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "Og Elskovssange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "Og svindende de sukke:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 3,
      "text": "»Vor Tid er forbi!« –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 3,
      "text": "Mit Hoved vugges paa levende Bølger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 3,
      "text": "Min Haand fornemmer et Hjertes Slag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 3,
      "text": "Ned over mig livssvulmende strømmer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 3,
      "text": "Kyssets glødende Purpurregn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 3,
      "text": "Og min Læbe jubler:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 3,
      "text": "»Det er min Tid nu!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 3,
      "text": "Men Tiden flygter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 3,
      "text": "Og jeg skal færdes",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 3,
      "text": "Ved Midnatstide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 3,
      "text": "En Gang som død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 3,
      "text": "Skal samle Ligdragten om mig tæt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 3,
      "text": "Mod de kolde Vinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 3,
      "text": "Og liste mig frem ved sildig Maane,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 3,
      "text": "Og smertebunden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 3,
      "text": "I Muldet riste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 3,
      "text": "Med sorte Gravkors",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 3,
      "text": "Dit kjære Navn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 3,
      "text": "Og synkende sukke:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 3,
      "text": "»Vor Tid er forbi!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 4,
      "text": "Du sender mig et Elskovsblik",
      "part": false,
      "marginal_notes": [
        "Speaker: tove"
      ]
    },
    {
      "id": 61,
      "stanza_id": 4,
      "text": "Og sænker saa Øjet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 4,
      "text": "Dog Blikket trykker din Haand i min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 4,
      "text": "Og Trykket dør;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 4,
      "text": "Men som et elskovsvækkende Kys",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 4,
      "text": "Du lægger mit Haandtryk paa min Læbe. –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 4,
      "text": "Og du har for Døden et Suk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 4,
      "text": "Naar et Blik kan opstaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 4,
      "text": "Som et flammende Kys!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 4,
      "text": "De lysende Stjerner paa Himlen hist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 4,
      "text": "Vel blegne hver Gry,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 4,
      "text": "Men blusse dog hver en Midnatsstund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 4,
      "text": "I evig Pragt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 4,
      "text": "– Saa kort er Døden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 4,
      "text": "Som rolig Slummer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 4,
      "text": "Fra Kvæld til Gry,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 4,
      "text": "Og naar du vaagner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 4,
      "text": "Hos dig paa Lejet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 4,
      "text": "I nyfødt Skjønhed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 4,
      "text": "Du straale ser",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 4,
      "text": "Din unge Brud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 4,
      "text": "Saa lad os da tømme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 4,
      "text": "Den gyldne Skaal",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 4,
      "text": "For den mægtigt forskjønnende Død;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 4,
      "text": "Thi vi gange til Grav",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 4,
      "text": "Som et Smil, der dør",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 4,
      "text": "For et saligt Kys.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 5,
      "text": "Vidunderlige Tove!",
      "part": false,
      "marginal_notes": [
        "Speaker: valdemar"
      ]
    },
    {
      "id": 88,
      "stanza_id": 5,
      "text": "Saa rig ved dig er jeg nu,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 5,
      "text": "At end ej et Ønske jeg ejer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 5,
      "text": "Mit Bryst er saa let,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 5,
      "text": "Min Tanke saa klar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 5,
      "text": "En vaagen Fred er over min Sjæl.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 5,
      "text": "Der er saa stille i mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 5,
      "text": "Saa sælsomt stille.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 5,
      "text": "Læben vil bygge paa Ordets Bro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 5,
      "text": "Men synker igjen til Hvile;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 5,
      "text": "Thi det er mig som banked' mit Bryst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 5,
      "text": "Ved dit Hjertes Slag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 5,
      "text": "Og som mit Aandedrag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 5,
      "text": "Hæved', Tove, din Barm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 5,
      "text": "Og jeg ser vore Tanker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 5,
      "text": "Fødes og glide sammen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 5,
      "text": "Som Skyer, der mødes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 5,
      "text": "Og samlede vugges de i vekslende Former.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 5,
      "text": "Og min Sjæl er stille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 5,
      "text": "Jeg ser i dit Øje og tier.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 5,
      "text": "Vidunderlige Tove!",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
