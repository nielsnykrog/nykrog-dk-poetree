  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1849,
    "url": "https://tekstnet.dk/books/andersen-hc_uden-faelles-titel-1849/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Vor Junker kom i Skoven, der Grethe han saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hun gik og samled’ Jordbær, hun trak dem paa Straae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "de modneste, de bedste, hvert friskt sødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "»ei Grethelil!« saa talte han, »det var jo heldigt mødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "jeg vil hjælpe med at plukke!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "»Det rødeste, det bedste, jeg fandt denne Stund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "det sødeste, meest friske, det groer paa din Mund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "du veed ei selv din Rigdom, jeg seer den,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "og derfor vil jeg hjælpe dig, jeg er en ærlig Ven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "jeg vil hjælpe med at plukke!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "I Skoven stod en Slaaentjørn, den hørte derpaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "før Junkeren det vidste, i Tjørnen han laae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "og Grethe løb, hun smiilte: »jo, jo Tak!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "den Slaaentjørn havde tornet Green, og alle Torne stak:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "»jeg vil hjælpe med at plukke!«",
      "part": false,
      "marginal_notes": []
    }
  ]
}
