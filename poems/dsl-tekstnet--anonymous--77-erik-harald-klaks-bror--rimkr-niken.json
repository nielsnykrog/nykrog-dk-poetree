  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Rimkrøniken",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1495,
    "url": "https://tekstnet.dk/books/anon_rimkroeniken/080/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "I myn tijdh foor aff Danmark wdh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "en mecthigæ her meth skioldh oc spywdh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "The wundhe saa mangæ seyer klaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "intijl the komme tijl Norman indh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "thet gode land meth frwcth oc wijn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Ther løstæ them tha at byggæ oc boo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "och giffue them tha tijl fred oc roo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "han thorde ey giffue them straff ther aa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "The bleffue ther sydende, oc ære ther en.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Ther føder aff konninger oc mecthige men,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Thet wor ottehundrede tw mynder en tyw aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Ther waar tha mangæ aff kongeslecth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "i Danmark willæ tha haffue macth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Ieg wor och aff thet samme blodh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "thi tycthæ meg ath ieg wor omgodh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "ieg willæ saa prøffue løckæ spijl.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Thet fortrødh myn søsters søn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Gutorm, saa hed then hæledæ køn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Thi togæ wij oss imellom en krij,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "Om syer droffue wij sammen i slaw,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "thet bleff wor sistæ leffnetz daw.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "Ther wthi bleff slaffuen all kongæslecth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "wthen Erich Barn som siden fik macth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "sloffues flere en ther leffdæ igen.",
      "part": false,
      "marginal_notes": []
    }
  ]
}