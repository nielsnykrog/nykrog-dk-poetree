{
  "id": null,
  "title": "80. Saa skal da mammon vige",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
    "wiki": "Q348003"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Troens Rare Klenodie",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1739,
    "url": "https://tekstnet.dk/books/brorson-ha_troens-rare-klenodie/082/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Saa skal da mammon vige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Og verdens trældoms stand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Vor JEsu naades rige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Det aldrig lide kand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Hvad skal afguderie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Paa verdens sand at bygge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "I JEsu Kirkes skygge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Ney naaden giør os frie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Lad spørge den, som ikke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "GUds søde naade seer:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Hvad skal jeg æde drikke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Hvo vil mig klæde meer?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Vil hedninger da gaae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Med verden sig at qvæle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Saa maae oplyste siele",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Dog bedre det forstaae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "O hvilken skam, at løbe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Fra GUd, som dyre lod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Os helved-slaver kiøbe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Med JEsu eget blood,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Og give sig hen i",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Den haarde verdens plage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "At ofre sine dage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Til evigt slaverie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Vil man ey andet have",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "End verden til sin skat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Saa er man jo en slave,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "I trældom dag og nat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Før man kand noget faae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Og er der lidet vunden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Med frygt er sielen bunden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "At det igien skal gaae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Det verste er, at slige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "(Det maa jeg sige bart)",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "I søde himmerige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "Har ingen deel og part,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "De gaae den brede vey,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "Og vil i himlen havne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "Naar de skal verden savne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "Men JEsus siger ney.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "Ney! aldrig tørst du tænke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "Som JEsum har forladt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 5,
      "text": "At GUd dig der vil skenke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 5,
      "text": "Den store himmel-skat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 5,
      "text": "Er verden dig saa skiøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "Og himlen dig saa liden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "Saa tag til takke siden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "Med helvede til løn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "Saa prøv dig nu i grunden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 6,
      "text": "Om du ey verden har",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 6,
      "text": "I hiertet, GUd i munden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 6,
      "text": "Og dermed sagen klar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 6,
      "text": "Som hykleren er van,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "Paa mammon kun at haabe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "Paa GUd sig dog beraabe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "Det gaaer umueligt an.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 7,
      "text": "Vil du det trolig mene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 7,
      "text": "Din GUd at tiene her,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 7,
      "text": "Saa er hand, hand allene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 7,
      "text": "Dig over alting kier,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 7,
      "text": "Men er dig verden stor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 7,
      "text": "Og skiøn i dine tanker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 7,
      "text": "Saa har du mist dit anker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "Og seyler uden roer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 8,
      "text": "I ret oplyste sinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 8,
      "text": "Som JEsum har udvalt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 8,
      "text": "Som kiende, søge, finde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 8,
      "text": "I eders Jesu alt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 8,
      "text": "Forsmaaer, som støv og sand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 8,
      "text": "Al verdens gods og evne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 8,
      "text": "Som ey er værd at nævne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 8,
      "text": "Mod eders herre-stand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 9,
      "text": "Thi har I GUd til Fader,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 9,
      "text": "Hand er at lide paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 9,
      "text": "Saa glædes kun, og lader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 9,
      "text": "Al verdens kummer gaae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 9,
      "text": "Hvad skal unyttig sorg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 9,
      "text": "Om næring tungt at spørge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 9,
      "text": "Saa længe GUd vil sørge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 9,
      "text": "Og være eders borg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 10,
      "text": "Er himlens slot vor eget.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 10,
      "text": "GUd selv og hvad hand har,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 10,
      "text": "Da er det meer end meget,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 10,
      "text": "Da sagen er saa klar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 10,
      "text": "At kunde tvile paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 10,
      "text": "Om og vort lives næring,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 10,
      "text": "Saa kort en reyses tæring,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 10,
      "text": "Er hos vor GUd at faae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 11,
      "text": "Kun frisk, I fromme hierter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 11,
      "text": "Og senker eder ned",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 11,
      "text": "Med alle eders smerter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 11,
      "text": "I JEsu kierlighed!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 11,
      "text": "Du GUds udvaldte flok,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 11,
      "text": "Stræb kun af alle kræfter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 11,
      "text": "At følge JEsum efter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 11,
      "text": "Saa har og faaer du nok.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
