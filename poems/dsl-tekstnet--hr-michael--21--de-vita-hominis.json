  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Sum responsurus reserans mea crimina queque.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Iste dies durus quo cristus iudicat eque.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Nw schal ieg bødhæ baadhæ lidhet och stort",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "thet ieg mod Gud haffuer syndhet och giort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Mynæ gerningher wil Gud nw dømæ meth sckiæl,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "han glømer ræth inthet, thet weed ieg wæl,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Gud frælsæ mig aff thennæ waadhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Hwar swaerth er thenne dag at see",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "hwer bær for sig stoer faræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Aff allæ the paa dommen staa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "wedh inghen hwo Hælwedhæ kan vndgaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Gud wil tha inghen sparæ.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
