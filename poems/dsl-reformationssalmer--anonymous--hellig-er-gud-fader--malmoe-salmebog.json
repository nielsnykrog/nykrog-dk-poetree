  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "HEllig er Gud fader/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Hellig er oc saa Gud Søn met den baade/",
      "part": false,
      "marginal_notes": [
        "Esa vi"
      ]
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "oc vor hugsualere den Helligand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Er hellig oc skøn en eniste velgører/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "mod oss oc vore forældre/",
      "part": false,
      "marginal_notes": [
        "Mat. vi"
      ]
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "met flit han oss forsørger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Stercke første oc mectige herre offuer Sabaot alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Baade synd oc død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "och der til helffuede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "for hannem gantske motte falle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Der fore er bode hiemmel oc iord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "opfylt met dit ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "oc skrige nu Hosianna",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Christo være all loff oc priss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "den som kom i herrens naffn met vnderlig wiss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "vore synder alsammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "veldige haffuer offueruundet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "oc haffuer sit rige saa ind anammet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Nu rober alle Hosianna",
      "part": false,
      "marginal_notes": []
    }
  ]
}