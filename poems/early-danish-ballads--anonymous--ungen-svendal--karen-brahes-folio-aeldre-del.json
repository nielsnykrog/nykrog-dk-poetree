{
  "id": null,
  "title": "Ungen Svendal",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA81.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Thett wor vngen Sueidaall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hand skulld boldenn lieg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "boldenn dreff y iumfruens bur,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "thett giorde hans kiender bleeg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: Och lader du dyn ord well! ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Boldenn dreff y iumfruens bur,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "suendenn eftter gieng:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "førind hand kam der vd igenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "stuor sorrig hand y hiarttet fyngee.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "\"Tthu thørst yke kaaste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "dynn bold eftter meg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "der seder en møø y fremede land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "hun lengis efter deg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Tthu skallt aldrig ruo bide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "och aldrig ruo faa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "førind du faar lest dett sorig-fuld hiartte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "saa lenge haffuer lieett y thraa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Tthett wor vngenn Suiedall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "hand suøber seg hoffuett y skynd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "saa gaar hand y stuoffuen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "alt for syn hoffmand ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "\"Her sedder y, alle myne mend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "dreker mød aff skaall:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "men ieg gaar till bierigenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "med myn kerr muoder att thalle.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Tthett wor vngenn Suiedall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "hand tog till att kald:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "ther reffnitt mur och malmerr-stien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "och bergitt tog til at falde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "\"Huem er thett, ther kalder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "och weecker meg saa muod?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "maa ieg ike med ruo forlieett",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "op vnder den suorte iordd?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "\"Tthett er vngenn Suiedall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "och kerre sønne dyn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "hand wild fuld gierne haffue guode rad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "aff kerr moder synn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Ieg haffuer fangitt en styffmoder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "hun er meg worden haard:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "hun haffuer myn hiartt y tuongen lagtt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "for denn, ieg aldrig suo.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "\"Skall ieg meg nu opriese",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "aff søffuen och haarden kualle:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "vdj thi same wieee",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "tha skallt thu ind fuld-well faare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Ieg skall gyffue deg enn fuolle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "hand skall well bere deg frem:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "hand gar saa wel offuer sallttenn fiord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "som paa denn grønne iord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "Ieg skall giffue deg dugenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "alt om du kandt thend bredde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "ald denn mad, du ønsker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 12,
      "text": "den skall deg staa tiell rede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "Ieg skall giffue deg ett dyres-hornn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "och thett er spenntt med guld:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "ald den drøk, du ønsker deg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 13,
      "text": "da skal den staa ald fuld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Ieg skall giffue deg suerditt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "er harditt y drage-blod:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "y-huor du rider igieemill mørkenn skuoff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 14,
      "text": "daa brinder hun som enn booell.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "Ieg skall gyffue deg skibbenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "den staar y saltenn fiordt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "ald dyn finder, deg imod wilde seggell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 15,
      "text": "dem løber hun vnderr y fiordt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "Tthy wand op dieris sylcke-seggell",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "saa hytt y forgyldene ruo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "saa seglitt thi for denn same land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 16,
      "text": "alt som den iumfru wor paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "Tthi kaaste derris acker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "paa denn huide saand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "thett wor vngenn Sueidall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 17,
      "text": "hannd thrennd ther først y land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "Tthett wor vngenn Suedall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "hand gaar paa huiden sannd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "thend første mand, hand møtte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 18,
      "text": "wor hiorden paa thett land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "Tthett wor guodenn hiorde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "och hand luod spøre till:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "\"Huad daa skader thenne vngersuend?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 19,
      "text": "huy er hans hiartte saa thørst?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "\"Hanns hiartte legger y thuongen lagtt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "for den, hand aldrig suo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "suenden heder vngenn Sueddall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 20,
      "text": "och saa gaar saaden aff.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 21,
      "text": "\"Her er och-saa en iumfru paa thette land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "hun leger y sterkenn thraa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 21,
      "text": "alltt eftter en suend, heeder Suiedall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 21,
      "text": "hun aldrig med øgen suo.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 22,
      "text": "\"Hør du, guodenn hiørde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 22,
      "text": "och huad ieg siger deg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 22,
      "text": "wedst thu, huor denn iunnfru er,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 22,
      "text": "daa døll thett icke for meg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 23,
      "text": "\"For offuen wed den grønne lund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 23,
      "text": "der staar myn iumfrues gard:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 23,
      "text": "puorttenn er aff thett huidee walls-byenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 23,
      "text": "och puortten er lagtt med staall.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 24,
      "text": "Vddenn for mynn iumfrus puortt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 24,
      "text": "ther stander en løffue saa gram:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 24,
      "text": "men er y den rette Suiedall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 24,
      "text": "saa fritt maa y gaa fram.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 25,
      "text": "\"Er thett nu saa sanden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 25,
      "text": "alt som du sigger for meg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 25,
      "text": "blyffuer ieg kongge paa thette land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 25,
      "text": "til rider giør ieg dieg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 26,
      "text": "Hand gick til denn gyldene puortt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 26,
      "text": "och ind der hand suo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 26,
      "text": "alle daa war dy laasse,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 26,
      "text": "och dy falt seleff der-fraa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 27,
      "text": "Løffuenn med thy huide biørn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 27,
      "text": "thi faldt den herre til fuodt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 27,
      "text": "liendenn med syn grenne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 27,
      "text": "hun bogner nedder til iord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 28,
      "text": "Mitt vdj denn borig-gaard",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 28,
      "text": "der axler der axller hand syn skyndtt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 28,
      "text": "saa gaar hand y hyffue-lofftt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 28,
      "text": "for hiendske koning ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 29,
      "text": "\"Hell seder y, hiedennske koning,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 29,
      "text": "offuer edders egen bord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 29,
      "text": "well y meg edders datter giffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 29,
      "text": "och wide meg ansuar-ord?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 30,
      "text": "\"Ieg haffuer icke datter, for-vdenn ienn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 30,
      "text": "hun lieger y sterkenn thraa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 30,
      "text": "alt efter en suend, heder Sueidall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 30,
      "text": "hun aldrig med øgen suo.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 31,
      "text": "Tthett thaa suaritt thend liden smaa-dreng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 31,
      "text": "stuod kled y kiorttell huidt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 31,
      "text": "\"Lengis hynder efter Sueiedall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 31,
      "text": "da er hand nu komen hidtt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 32,
      "text": "Saa bratt kaam buod y hyffuelofft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 32,
      "text": "for skøn iumfru ind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 32,
      "text": "\"Nu sedder vngenn Suiedall",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 32,
      "text": "nest huoss fader dynn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 33,
      "text": "\"Daa thager y nu buortt dy hyffue ruo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 33,
      "text": "ochsaa dy liggebaar:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 33,
      "text": "følger y meg y hyffue-lofft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 33,
      "text": "ind for myn hiarttens-kierr.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 34,
      "text": "Tthett tha melltte den skønne iumfru,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 34,
      "text": "hun ind aff døren trennd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 34,
      "text": "\"Wer well-komen, vngen Suiedall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 34,
      "text": "hiartt-allerkerste mynn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 35,
      "text": "Huad helder well y, myn kerre fader,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 35,
      "text": "nu tage wed den chrestlig thro:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 35,
      "text": "helder ieg skall følge vnge Suedaall",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 35,
      "text": "y fremede land at buo?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 36,
      "text": "\"Langtt helder well ieg ladde meg chresten",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 36,
      "text": "och tage weed chrestlig lerre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 36,
      "text": "ind ieg wilde, myn kerre datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 36,
      "text": "ind ieg wilde deg om-bere.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 37,
      "text": "Tthett wor om enn mandag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 37,
      "text": "dy tog wedd den chrestelige tro:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 37,
      "text": "den neste sønddag, der efter kaam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 37,
      "text": "luod thi thett brølup buo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 38,
      "text": "Saa drak thi thett brølup",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 38,
      "text": "well y dage fem:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 38,
      "text": "alt gick guodenn hiordde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 38,
      "text": "hand glede seg y alle dem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 39,
      "text": "Tthett melltte vngen Suiedall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 39,
      "text": "hand thaaller till suene thuo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 39,
      "text": "\"Y hientter meg ind denn hiørde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 39,
      "text": "ieg skall hanom till rider slaa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 40,
      "text": "Tthak haffue vnge Suiedall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 40,
      "text": "saa well holtt hand syn throff:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 40,
      "text": "hand slo thend hiord til rider,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 40,
      "text": "hand satte hanom øuerst till buord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 41,
      "text": "Nu haffuer vngen Suiedall",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 41,
      "text": "forwuonden al syn harum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 41,
      "text": "saa haffuer och den stalt iumfru,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 41,
      "text": "hun suoffuer for inden hans arum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 41,
      "text": ":: Och ladder du dyn ord well! ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}