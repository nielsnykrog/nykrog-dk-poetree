  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Loffuer Herren Hedninge alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Thi han dem ey nectede sin naade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Desligest alle Folck skal til hannem falle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Di han dem haffuer frid aff alskens vaade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Hans godhed offuer oss rundelige forøct.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Thi han oss met sin naade haffuer søct",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Hans Trofasthed er oss beted",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Thi ske hannem loff euindelig",
      "part": false,
      "marginal_notes": []
    }
  ]
}