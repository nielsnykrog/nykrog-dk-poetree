  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "BEnedidet vere Jsraels Gud och Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Fordi han haffuer søgt och forløst sit Folck",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Oc han haffuer opræt oss salighedens børn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "i Dauidz huss sin Tiæneris",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "Som han haffuer altid igennem sine hellige Propheters Mund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "huilcke som ere aff gammel tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Det skulle ske at wi skulle frelsis fra vaare wuenner/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "och aff alle deris haand huilcke oss før haddede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "Paa det han skulle bruge sin barmhiertighed/ met vaare foreldre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "och vere ihukommende sit Testamente oc løffte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 5,
      "text": "Och fuldkomme den eed han sor Abraham vor Fader/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "ath han skulle giffue oss sig alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 6,
      "text": "Paa det at wi som vaare frelste aff vore wuenners hender/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "skulle tiæne hannem wden redtzel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 7,
      "text": "Met hellighed och Retferdighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "for hans ansict i alle vore liffs tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 8,
      "text": "Oc du Barn skalt kallis den høyestis Prophete/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "Thi du skalt gaa for Herrens Ansict/ oc berede hans Veye",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 9,
      "text": "Til at giffue hans Folck salighedz lærdom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "til deris Synders forladelse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 10,
      "text": "Vid vor Gudz storre oc hierte barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 10,
      "text": "met huilcken han søgte oss oprunden aff det høyeste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 11,
      "text": "Ath han skulle liuse dem som side vdi Mørcke oc i dødens skugge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 11,
      "text": "at stille vore føder til fredzens veye",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 12,
      "text": "Ere vere Gud Fader oc Gud Søn oc saa Gud den Helligaand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 13,
      "text": "Som verit haffuer aff begyndelse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 13,
      "text": "nu er oc altid bliffuer til euig tid Amen",
      "part": false,
      "marginal_notes": []
    }
  ]
}