  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Hwilken som løcken wil vare medh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "han wordher hoffærdigh paa en stedh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Ieg wedh thet westh at meg so gik",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Løcken, hwn war meg altijd blidh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "thi wanth ieg megeth meth storm oc stridh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Iegh hade ther ey gøme aff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "thi ær ther lidit scriffuet aff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "thet thæræde iegh vnytthelig.",
      "part": false,
      "marginal_notes": []
    }
  ]
}