    "url": "https://tekstnet.dk/books/andersen-hc_digte-1830/046/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Saa deiligt et Træ i Skoven staaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Og Fuglene smukt i Kronen slaaer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Der mødes tre lystige Svende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Enhver sig tager af Træet lidt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Saa vandre De atter hver til sit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Thi Dagen lakker mod Ende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "En Billedhugger den ene var;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Af Træet i Hast han hugget har",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "En smuk, en velskabt Herre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "Den anden var jo Skræder Dich;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "Af ham det deilige Klæder fik;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "Men Aanden mangled’, desværre!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 4,
      "text": "Den tredie var en ung Poet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "Da lidt han havde paa Klodsen seet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "Gav han den Aanden og Livet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 5,
      "text": "Den nye Mand bukked’ og gik sin Vei;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "Men grunder alt meer og mere: »ei!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "Hvem mon mig det Bedste har givet?«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 6,
      "text": "I Byen gjorte han Lykke snart,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 6,
      "text": "Thi Klæderne hjalp ham, det var klart;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "Med Titler de smukt ham bemalte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 7,
      "text": "Hvert Dame-Hjerte stod nu i Brand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 7,
      "text": "Hvor det dog er en nydelig Mand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "– Om Aanden der slet Ingen talte.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
