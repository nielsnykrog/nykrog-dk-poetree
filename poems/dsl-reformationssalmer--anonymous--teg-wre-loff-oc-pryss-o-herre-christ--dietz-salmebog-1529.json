  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "TEg wære loff oc prÿss o Herre Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "benedidet er then dag for wist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Wÿ loffue teg nw oc til ewig tÿd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Hellig hellig hellig æst tw ÿ thet høgeste.",
      "part": false,
      "marginal_notes": [
        "Esaie. vj."
      ]
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Englene oc offuer engle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "tronerne oc thet himmelske herskaff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Teg loffue Cherubin oc Seraphin.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Hellig hellig hellig siungis ÿ thet offuerste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Thit folk o Christe loffue teg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Thÿn brud aff hiertet nw glæder seg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "For thÿn naade oc barmhiertighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Hellig hellig hellig hun siunger teg.",
      "part": false,
      "marginal_notes": []
    }
  ]
}