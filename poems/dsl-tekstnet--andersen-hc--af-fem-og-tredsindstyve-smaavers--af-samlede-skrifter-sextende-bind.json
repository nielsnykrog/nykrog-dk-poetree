  "body": [
    {
      "id": 0,
      "stanza_id": 25,
      "text": "Jeg dandser længe, jeg dandser kort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 25,
      "text": "Jeg dandser med hele Skroget.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 25,
      "text": "Jeg dandser min Forkjølelse bort",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 25,
      "text": "Og det er jo altid Noget.",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
