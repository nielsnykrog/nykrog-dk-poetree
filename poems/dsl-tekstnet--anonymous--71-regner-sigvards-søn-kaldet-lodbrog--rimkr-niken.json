{
  "id": null,
  "title": "71. Regner, Sigvards søn, kaldet Lodbrog",
  "year_created": 1495,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Rimkrøniken",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1495,
    "url": "https://tekstnet.dk/books/anon_rimkroeniken/074/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Løcken, hwn maa wel lignes eth glar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hoo thet giffuer gøm, han worder thet war.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "tha brøster thet alsom snarest.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Ther wor en konning i Sweriges land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "wthi myn tijd, Erod hede hand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Han hade en dotther, hwn war bold.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Thi lod han føde too orme opp;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "the odhe hwer om daghen en oxekropp.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Them lod han sættæ for hennes dør",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "at ther skullæ indh inghen komme før",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "oc andræ fleræ wenners om wel.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Tha ormenæ woræ saa store i kropp,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "tha angræde hannum at han hade fød them opp.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Han reddis for seg oc alle syn land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Thi lod han almyndelig tijlsyæ saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "at then man skullæ hans døtther faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "som samme orme kwnne sla ihiell",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "oc frælsæ hannum aff then angher well.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "om ieg mottæ faa then ionfrw skøn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "Ieg gik ther vdh wthi en aa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "ieg lod myne kleder ther frysæ saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "at the wore som eth harniske klarth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "Meth skioldhen beskermde ieg meg for theris tand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "meth ysen for edher, ieg thet ey fand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "Saa fik ieg slaffueth the orme tijl dødh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "oc frælstæ tha kongen aff syn nødh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "oc fik henne saa tijl drodning myn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "Tha ieg kom op aff then aa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "och konghen han myne kleder saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "ath the hende saa klattegæ om meg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "»Hoo ær then lodbrog hissæth goor?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "Han ær saa klattig som eth foor!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 0,
      "text": "Ther aff kalledis ieg siden Lodbrog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 0,
      "text": "thet syer ieg edher for wthen hiog.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 0,
      "text": "tijl orloff oc allskøns idh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 0,
      "text": "Therforæ ieg Norgæ twswer vandh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 0,
      "text": "saa giorde ieg oc wedh Skotlandh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 0,
      "text": "Ieg Ængland wand oc Hyberland",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 0,
      "text": "Grønlandh och Ørkenøø",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 0,
      "text": "meth andre smaa land i Westersøø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 0,
      "text": "Ther skattidæ meg mere wæpnthe men",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 0,
      "text": "oc wæpnthe romer hwer oc en.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 0,
      "text": "forthi ath løcken wor meg blidh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 0,
      "text": "thet Lanthosassen ieg och tha wand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 0,
      "text": "meth allæ andræ tydeskæ land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 0,
      "text": "Ther kørde ieg keyseren aff landhen wdh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 0,
      "text": "Hans store pallatz, som wor i Tagæn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 0,
      "text": "thet hæctedæ ey mere æn en lagæn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 0,
      "text": "Ieg wand thet snarth meth storm oc stridh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 0,
      "text": "ieg settæ ther myne hestæ wdhi.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 0,
      "text": "och fik myn søn thet foræ ath staa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 0,
      "text": "Ieg krijde ther paa i fyretyw aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 0,
      "text": "och giorde ther døde men oc soræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 0,
      "text": "The som bode i Parises stad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 0,
      "text": "Rytzen ieg oc saa offuerwand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 0,
      "text": "och fik en annen myn søn i hand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 0,
      "text": "Hannum sloffue the saa snarth ihiell",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 0,
      "text": "meg tøcthe the giorde thet ey meth skiell.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 0,
      "text": "och wandh thet land, ieg wor ey seen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 0,
      "text": "Ieg hannum lodh beholde thet land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 0,
      "text": "som slo myn søn, then vngæ mand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 0,
      "text": "Han skullæ meg skath giffue orlig modh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 0,
      "text": "Hwath skall ieg nw mere syæ ther aff?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 0,
      "text": "Ieg maa thet syæ for wthen straff:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 0,
      "text": "Fra Danmark oc saa tijl Mæret wdh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 0,
      "text": "ieg offuer wand meth skioldh oc spywdh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 0,
      "text": "oc lodh them see the danskæ swærdh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 0,
      "text": "Fæmthen myne søner som ieg hade kæær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 0,
      "text": "them fick ieg hwer sit rigæ i sæær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 0,
      "text": "som wore Ornik och Godefredh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 0,
      "text": "Siwer, Iwer, Radulff oc Erik Wederhat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 0,
      "text": "Agner, Vbbe, Ingwer, Frytlæ oc Dwmwat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 0,
      "text": "Siden bleff ieg greffuen i Hyberland",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 0,
      "text": "oc sætthes i ormethorn paa stand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 0,
      "text": "saa fald myn løckæ bort saa brath.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 0,
      "text": "Tha ieg skullæ tijl the ormæ gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 0,
      "text": "tha sade ieg tijl tornwoctheren saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 0,
      "text": "»Westhæ nw grissæne hwad ornen toll,",
      "part": false,
      "marginal_notes": []
    }
  ]
}