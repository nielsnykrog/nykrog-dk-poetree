  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "I Kroen de havde en tæmmet Skade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "den hoppede om ved Lo og Lade;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "naar Bønderne rulled fra Staden hjem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "den sad saa andægtig og saae paa dem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Purr! raabte de, Purr! vil Du staa, din Mær!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Det morede Skaden dog mest især.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Mens Tordnen buldred, den sad en Dag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "og lytted deroppe paa Husets Tag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Den vidste ej, hvad det var, den hørte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "den troede, det Vognene var, som kjørte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Purr! raabte Skaden af alle Kræfter;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "men Tordnen hørte kun lidt derefter.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
