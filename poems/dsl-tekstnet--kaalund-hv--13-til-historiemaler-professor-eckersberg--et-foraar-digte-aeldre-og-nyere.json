{
  "id": null,
  "title": "13. Til Historiemaler, Professor Eckersberg",
  "year_created": 1858,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Vilhelm Kaalund",
    "country": null,
    "wiki": "Q2362214"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Et Foraar. Digte, Ældre Og Nyere",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1858,
    "url": "https://tekstnet.dk/books/kaalund-hv_et-foraar/014/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Vi bringe Dig vor Hylding, kjære Gamle!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Foruden Faklers Glans, kun med en Sang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "vi ved dit Vindve os i Natten samle;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "ej Opsigt elsked Du paa Livets Gang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Om af den yngre Slægt den Ældre glemmes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "vi vil dog ikke følge Modens Vis;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "af vore fulde Hjerter her istemmes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "beskedne, gamle Eckersberg, din Pris!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Mens Tvivl og Uro gjære trindt i Livet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "mens Ormen gnaver skjult i Tidens Eg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "er Kunsten som en dejlig Drøm os givet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "i den sig nejer Sol og gyldne Neg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Mens Verdens Babler styrte i Ruiner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Du sidder dér med Haaret sølvergraat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "o Kunstens Søn, og sér med milde Miner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "paa Livet, som fra et Morganaslot.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Naturen elsked Du, og glad dit Øje",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "hang ved Guds Himmel og det friske Hav;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "et Straa, lidt Solskin kunde Dig fornøje,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "og hvad Du saae, din Pensel sanddru gav;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "dog for din Sjæl blev hvert et Billed ringe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "mod Værket af Guds Almagts Fantasi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "Dig Kunsten paa Naturens Ørnevinge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "er kun en liden, dejlig Kolibri.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "Som Lærer har Du ærlig vidst at gavne:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "En Küchler, Marstrand, Bendz og mange fler",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "skal hæve med europakjendte Navne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "dit Mesterværd, naar Du er ikke mer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "Og medens Verden Danmarks Thorvald ærer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "o Eckersberg, din Ros skal ej forgaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "Som Kunstner stor og højtfortjent som Lærer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "som Menneske saa elskelig som Faa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 0,
      "text": "Fred med dit hvide Haar paa Livets Aften!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 0,
      "text": "Langt fra din Tærskel vige Sorgens Aand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 0,
      "text": "at længe Du bevare Kunstnerkraften,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 0,
      "text": "dit sikre Øje og din faste Haand!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 0,
      "text": "Fred med dit Liv, til Du hos Juel faar hjemme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 0,
      "text": "højt paa Udødeligheds lyse Bjerg!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 0,
      "text": "Vor gamle Lærer aldrig vi forglemme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 0,
      "text": "vor Ven, vor elskelige Eckersberg!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
