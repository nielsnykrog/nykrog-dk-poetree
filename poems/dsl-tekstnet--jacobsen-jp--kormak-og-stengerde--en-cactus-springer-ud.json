{
  "id": null,
  "title": "Kormak og Stengerde",
  "year_created": 1886,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Jens Peter Jacobsen",
    "country": null,
    "wiki": "Q370246"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "En Cactus Springer Ud",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1886,
    "url": "https://tekstnet.dk/books/jacobsen-jp_en-cactus-springer-ud/007/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "\"Ofte Pigemunde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Nævnte Kormak skjøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Nu han tror sig ligne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Odins yngste Søn;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Thi slig Stemme fager",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Maa fra Freja komme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Skjønheds Dis, som bedst kan",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Fælde Skjønhedsdomme.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "\"Issens Lyng den sorte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Dækker Tankens Vang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Varer Snoge tvende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Venligt under Hang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "At ej Møers Hjerte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Fast de skal omspænde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Og saa Elskovs Syge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Dem i Sindet tænde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "\"Mer end skumhvid Bølge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Frygter jeg din Barm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Mer end Tryk af Skjolde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Mø, din runde Arm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Mer end Stormens Bulder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Røsten din den klare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Og dit Blik det lyse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Mer end Sejd og Snare.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "\"Brand saa vil jeg tage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Dag din Skjønhed faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Ved dens Lys den klare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Brand vil slukket staa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Men for mig vil aldrig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Mere Nat oprinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Thi bestandig skuer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Jeg den fagre Kvinde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "\"Skjønheds Skik det aldrig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "Var for Lyset fly,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "Jetter kun og Trolde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "Kaare Mulmets Ly.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "Men har nu en Gyge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "Borget sølvklar Stemme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "Lykkelig var Kormak,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "Var han bleven hjemme.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "\"Fager Blomsterbølge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "Over Diget faldt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 5,
      "text": "Skjøn slig Hilsen være",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 5,
      "text": "Maa for ham, den gjaldt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 5,
      "text": "Men sig bedre lønne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "Maa bag Diget fange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "Kyssebær saa søde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "Blikkeblomster mange.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "\"Udfra Høloftslugen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 6,
      "text": "Stirred Øjet mat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 6,
      "text": "Saa, hvor Aaen glimted",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 6,
      "text": "I den lune Nat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 6,
      "text": "Skued Taagens Bølger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "Op af Enge vælde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "Og langt borte saa det",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "Gnupsdals spidse Fjelde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 7,
      "text": "Navnløs Tavshed hused",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 7,
      "text": "I mit unge Bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 7,
      "text": "Hjertet som en Dravge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 7,
      "text": "Sad derinde tyst;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 7,
      "text": "Alle mine Tanker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 7,
      "text": "Laa i Taage bundne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 7,
      "text": "Mindets Havn og Haabets",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "Bavne var forsvundne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 8,
      "text": "Men nu Blikket vanked",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 8,
      "text": "Over kjendte Sti,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 8,
      "text": "Hver en Busk og Tue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 8,
      "text": "Som det gled forbi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 8,
      "text": "Kjendinger og Mærker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 8,
      "text": "Var til det Forsvundne;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 8,
      "text": "Mindets Havn og Haabets",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 8,
      "text": "Bavn var atter fundne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 9,
      "text": "Mine Gnupsdalssange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 9,
      "text": "Lød for mig igjen:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 9,
      "text": "\"Elskovsflugt vi flyve",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 9,
      "text": "Ingenvegne hen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 9,
      "text": "Under Frejas Lofte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 9,
      "text": "Vi paa Vinger hvile,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 9,
      "text": "Alle Jubeltoner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 9,
      "text": "Frem imod os ile.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 10,
      "text": "Men fra Tunge svared'",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 10,
      "text": "Pigen mig igjen:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 10,
      "text": "\"Elskovsflugten flyve",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 10,
      "text": "Vi mod Maalet hen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 10,
      "text": "Gjennem Frejas Lofte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 10,
      "text": "Jublende vi glide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 10,
      "text": "Thi vor Lykke vinker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 10,
      "text": "Paa den anden Side.\"\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 11,
      "text": "\"Ej er Tid at bøde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 11,
      "text": "Nu paa revnet Hus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 11,
      "text": "Kormaks fagre Lykke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 11,
      "text": "Sunken er i Grus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 11,
      "text": "Ringe er den Glæde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 11,
      "text": "Lunt bag Væg at hvile,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 11,
      "text": "Medens ude Stimænd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 11,
      "text": "Med Ens Eje ile.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 12,
      "text": "\"Hvilet har det Rygte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 12,
      "text": "Vist i hver en Vraa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 12,
      "text": "Træt af al den Kummer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 12,
      "text": "Som det drager paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 12,
      "text": "Nu paa rappe Foler",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 12,
      "text": "Maa vi hurtigt fare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 12,
      "text": "Spildte Tid skal Hestens",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 12,
      "text": "Hove sammenspare.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 13,
      "text": "\"Nu skal Berse favne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 13,
      "text": "Lyse Mø med Lyst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 13,
      "text": "Mig vil Sorgen svarte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 13,
      "text": "Trykke til sit Bryst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 13,
      "text": "Skjønt skal han paa Lejet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 13,
      "text": "Hendes Røst fornemme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 13,
      "text": "Grumt mig holde vaagen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 13,
      "text": "Sildig Angers Stemme.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 14,
      "text": "\"Samled Odin alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 14,
      "text": "Asekvinders Blod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 14,
      "text": "Vakte det ved Runer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 14,
      "text": "Til en Kvinde god,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 14,
      "text": "Skulde saa som fagrest",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 14,
      "text": "Guder hun fortrylle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 14,
      "text": "Fik din Ham hun laane",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 14,
      "text": "Og i den sig hylle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 15,
      "text": "Mide Norner vilde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 15,
      "text": "Jeg Stengerde fandt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 15,
      "text": "Norners Hu sig vendte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 15,
      "text": "Berse hende vandt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 15,
      "text": "Og min Fremtid, gryet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 15,
      "text": "Til en Vaardags Lykke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 15,
      "text": "Til en Høstnat kvelded.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 15,
      "text": "- Alt dens Taager trykke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 16,
      "text": "Dog, som her jeg stander^",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 16,
      "text": "Kuet, mat og mod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 16,
      "text": "Magt og Sejer ruger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 16,
      "text": "I mit Skjaldeblod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 16,
      "text": "Thi om end en Anden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 16,
      "text": "Dig som sin kan favne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 16,
      "text": "Evigt mine Kvad dog",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 16,
      "text": "Samler vore Navne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 17,
      "text": "Tak for lødrig Glæde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 17,
      "text": "Tak for Kummer bleg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 17,
      "text": "Tak, for du mig elsked',",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 17,
      "text": "Tak, for du mig sveg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 17,
      "text": "Tak for rige Toner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 17,
      "text": "I ufødte Sange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 17,
      "text": "Tak for hver en Hæder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 17,
      "text": "Jeg paa Jord skal fange.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 18,
      "text": "\"I Glemsels Grav",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 18,
      "text": "Hver Tid maa gange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 18,
      "text": "Hvis Skridt ej skues",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 18,
      "text": "Af Skjaldeblik.\"\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 19,
      "text": "\"Nu, Stengerde, ønsker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 19,
      "text": "Jeg dig Trællestand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 19,
      "text": "Saa du gik som Vare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 19,
      "text": "Om fra Mand til Mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 19,
      "text": "Thi din rige Skjønhed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 19,
      "text": "Du saa ringe agter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 19,
      "text": "At til hver en Stodder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 19,
      "text": "Du den bort forpagter.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 20,
      "text": "\"Aldrig, nej, Stengerde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 20,
      "text": "Skilles du fra mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 20,
      "text": "Mer end fællig Arne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 20,
      "text": "Binder mig til dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 20,
      "text": "Fjeld paa Fjelde dynget,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 20,
      "text": "Hvorom Bølger larme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 20,
      "text": "Var kun liden Hindring,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 20,
      "text": "Mindre Tintens Arme.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 21,
      "text": "\"Saa Farvel, lad Tinten",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 21,
      "text": "Kys og Blikke faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 21,
      "text": "Og din fagre Stemme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 21,
      "text": "Lad ham høre paa;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 21,
      "text": "Men din stærke Længsel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 21,
      "text": "Graad, som lønligt vælder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 21,
      "text": "Og hver dristig Tanke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 21,
      "text": "Dog kun Kormak gjælder.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 22,
      "text": "\"Nat er nu forbi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 22,
      "text": "Fred og Slummer ender,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 22,
      "text": "Kampbud over Ø",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 22,
      "text": "Solens Bavn udsender.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 22,
      "text": "Op til Liv og Strid!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 22,
      "text": "Dag sit Skjold faar Klang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 22,
      "text": "Skjønt det klinger ned",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 22,
      "text": "Nu som Fuglesang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 23,
      "text": "Se, hvor Ymers Blod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 23,
      "text": "Rødt i Solen luer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 23,
      "text": "Som det syded end",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 23,
      "text": "Under Bringens Buer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 23,
      "text": "Hvor det vugges vildt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 23,
      "text": "Hvor det løftes vredt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 23,
      "text": "Som i Aarens Gang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 23,
      "text": "End det banked' hedt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 24,
      "text": "Himmellød og Glands,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 24,
      "text": "Som mit Øje blænder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 24,
      "text": "Drømmehær, som Sol",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 24,
      "text": "I hans Hjerne tænder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 24,
      "text": "Saa kun nævnes kan",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 24,
      "text": "Svalins Runedrag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 24,
      "text": "Rumme kan dem ej",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 24,
      "text": "iSIoget Ordelag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 25,
      "text": "Større Pragt dog nu",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 25,
      "text": "Under Tintens Øje,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 25,
      "text": "Drømmens Rose Liv",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 25,
      "text": "Faar bag hvide Høje,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 25,
      "text": "Paa den Fagres Kind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 25,
      "text": "Sætter Knop den prud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 25,
      "text": "Og paa hendes Mund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 25,
      "text": "Springer Rosen ud.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 26,
      "text": "Lad mit Kvad nu galdre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 26,
      "text": "Gamle Minder Dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 26,
      "text": "Tiden, da vi mødtes",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 26,
      "text": "Under Gnupsdals Tag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 26,
      "text": "Lad et Kys, Stengerde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 26,
      "text": "Syv Aars Smerte døde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 26,
      "text": "Tænde ny vor Elskovs",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 26,
      "text": "Første Morgenrøde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 27,
      "text": "\"En Gang i dit Hjerte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 27,
      "text": "Lukked du mig ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 27,
      "text": "Did bestandig længes",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 27,
      "text": "End mit tunge Sind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 27,
      "text": "Men hvor stærkt jeg banker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 27,
      "text": "Og hvor mygt jeg beder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 27,
      "text": "Ej mig op du lader,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 27,
      "text": "Ej mig ind du leder.\"",
      "part": false,
      "marginal_notes": []
    }
  ]
}
