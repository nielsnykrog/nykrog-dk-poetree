  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Hankatten sidder paa Gaardens Mur,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "han ser sin Elskte paa Gjenboens Skur:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "\"Skjønne, lad Dig min Mjauen røre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "vil Du dog aldrig mit Suk bønhøre?\" -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Ømmere stedse hans Tone stiger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "tilsidst i den høje Sky han skriger:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "\"Dronning for alle Slikkepotter!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Jeg véd et Spiskammer fuldt af Rotter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "af Skinker og Pølser og søde Ost\" -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "O ve! da fik han af Gaardskarlens Kost",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "et dygtigt Rap, saa det sved i Nakken. -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Som Visen Du sang, Herr Mons, var Takken!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
