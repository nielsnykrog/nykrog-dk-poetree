  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Myn herre koning Roleff som gaf meg brødh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hanum haffde ieg ieth at heffne hans dødh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "ffor noger mantz hand, swerd eller kniff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Thi slo ieg Sweriges koning ihyel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "som hanum hade myrd forvthen skæll.",
      "part": false,
      "marginal_notes": []
    }
  ]
}