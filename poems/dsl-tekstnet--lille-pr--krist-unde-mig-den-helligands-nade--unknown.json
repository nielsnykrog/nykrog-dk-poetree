{
  "id": null,
  "title": "Krist unde mig den helligånds nåde",
  "year_created": null,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Peder Ræv Lille",
    "country": null,
    "wiki": "Q12331790"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": null,
    "url": "https://tekstnet.dk/books/lille-pr_krist-unde-mig-den-helligaands-naade/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Crist vndhæ megh Then Helighanz nadhæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc thertill konst oc synnæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "oc fyllæ megh opp thet megh er foth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Iek villæ gernæ lowæ en kwynnæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "al dæth skal opp aff rysæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Hun er wellkendh bodhæ fiern oc ner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "aff hynnæ qwedher iek en vysæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Ridher oc swenæ oc froer oc mør,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "J veræ vell tistæ som ther till bør",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "om J villæ hennes loff høræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Jek vil tik lowæ, thu edhlæ jomfruæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "om tu teth ikkæ forkunnæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "for allæ thæm tegh vel vndhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "versus Inghen hauer seth soo ven en quinnæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "tessæ orth moo iegh beuysæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Hun er vel prøueth i tucth oc synnæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Hun er møghet vener en engell i skare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "soo er hun skøn, then renæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Soll oc monæ oc stierner klare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "lignes ikkæ then jomfru iek mener.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "tess hauer man inghen effnæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Myth hiertæ thet gledhes, hun er myk kier,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "nar jek hynnes naffn hør neffnæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Hun er velcledh til foth oc handh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "i bollækin oc blianth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "jn koko oc bistinctu.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 4,
      "text": "Hennes kledher er forydh meth pantherskin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 4,
      "text": "the hawæ soo manghæ lydhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "moo hun them fulvell nydhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "Hennes kledher hauæ møghet sødher døn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "en rosser oc mwskathæ bothæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "som Ysaach taledhæ til syn søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 5,
      "text": "Hennes howyth thet lignes vydh gull thet rødhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 5,
      "text": "Carmelus Bergh thet høwæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 5,
      "text": "thet gywer fruct oc yrther till grødhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "ywer allæ sin landh till nøwæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "oc haar som palmæquistæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "Hun er then sool oss dagligh skyn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "wi kunnæ hennes nadhæ ey mistæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 6,
      "text": "Hun er oppvoxen mø som vondh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 6,
      "text": "Hennes belthæ thet er eth silkæbondh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 6,
      "text": "thet ber hun forudhen all mødhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "Hennes halss er hwidher oc vener ath se",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "en Dauitz thorn thet boldhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "soo er thet sterth ath holdhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 7,
      "text": "Meth skiol oc spyth oc bisser oc blidher",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 7,
      "text": "oc thertill fawræ thinnæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 7,
      "text": "hun lewer meth gledhæ, forudhen all quidhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 7,
      "text": "Johannes han soo en jomfru so fyn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 7,
      "text": "man mathæ henne dranighen kallæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 7,
      "text": "hun var kleth i solsens skyn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 7,
      "text": "oc mønen henne fodhæballe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 8,
      "text": "aff hennes kobæ oc kronæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 8,
      "text": "som han in Patmos insula soo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 8,
      "text": "j hymmerighs høwæ thronæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 8,
      "text": "Sibilla hun soo then samme syn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 8,
      "text": "y Romærestath vndher hemmelsens skin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 8,
      "text": "thet haffdhæ oss gledhæ at biwdhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 9,
      "text": "Hun hauer en kronæ bodhæ ven oc boll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 9,
      "text": "er laudh meth dyræ stenæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 9,
      "text": "then edlestæ jomfru al enæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 9,
      "text": "Hennes føther the stanner i en stadigh grunuoll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 9,
      "text": "eræ skodhæ i gul thet rødhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 9,
      "text": "The hennæ thyener, løsær hun aff nøth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 10,
      "text": "Judith hun var en quinnæ fulskøn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 10,
      "text": "oc klogh i allæ synnæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 10,
      "text": "hun frelstæ sit folk oc var fullkøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 10,
      "text": "Olifernem mwnnæ hun forvinnæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 10,
      "text": "then alsomedlestæ liliæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 10,
      "text": "I al vor nødh er hun fulfyn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 10,
      "text": "fran Heluydet kan hun oss skyliæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 11,
      "text": "Putifar han hafdhæ en dotter soo geff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 11,
      "text": "Han gaff hennæ Josep til hosfru leff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 11,
      "text": "Asnech then skiønestæ quinnæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 11,
      "text": "Enthæ lygnes hun veth then",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 11,
      "text": "som jek dyerres aff at quedhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 11,
      "text": "i Hymmerigh hauer hun glæthe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 12,
      "text": "Hun er vel wen bothæ vthæ oc ynnæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 12,
      "text": "for allæ hannæ smyttæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 12,
      "text": "alverdhens speyel meth tucht oc synnæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 12,
      "text": "Hun er en vener en Ester fruæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 12,
      "text": "frucswmælegher er hun en Lyæa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 12,
      "text": "Hun helper oss gernæ aff al syn mwæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 12,
      "text": "henes naffn thet kallas Maria.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
