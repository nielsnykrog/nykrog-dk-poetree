  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Bakker Og Bølger",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1912,
    "url": "https://tekstnet.dk/books/larsen-t_bakker-og-boelger/003/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Der bølger Varme over Bakkens Kamme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "og Kornets trygge slummerdunkle Riger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Som saligt-salte Blik er Søer og Damme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "beruset blaa af Sol og nøgne Piger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Der springer Klang fra Fuglenæb i Luften.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Og Skyer som en anden Klodes Bjerge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "gaar stille frem, saa Lyset og saa Duften",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "sig lader blindt besove og besværge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Alt lever i en øm og yppig Spænding,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "de skjulte Safter giver Mod til Glæde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Og Disens Bølger vugger uden Brænding",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "mod sære Kyster, ingen kan betræde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Døgnfluen aner ved en blaa Violrand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "det evige. Og over Marken varlig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "gaar mættet Modningslugt af Korn og Solbrand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Og Tordenskyens Latter lyder farlig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Se aabne Døres Mulm i alle Sogne, –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "som gabte Graven ud af hver en Vaaning,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "som vented alle døde nu at vaagne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "til ærlig Dag paa Bakkens grønne Skraaning.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Nu drukner Solen. Og med haarde Kamme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Uvejrets Vande staar som Flint og Grotter;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "der falder Alvor over Søer og Damme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "og bag et Regnbjerg Lynet vildt sig blotter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Af Badet løber Bondens hvide Datter –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "de kære Vande, nødigt hun forlod dem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Hun strækker sine Bryster højt med Latter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "mens Tordenregnen straaler ned imod dem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "Hvor Koen brøler, som fra Jordens Indre!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Hvor Hylden dufter sødt, som kunde Roden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "en regnmæt Lykke under Muld erindre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "Og lystent borer Lynet sig i Kloden.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
