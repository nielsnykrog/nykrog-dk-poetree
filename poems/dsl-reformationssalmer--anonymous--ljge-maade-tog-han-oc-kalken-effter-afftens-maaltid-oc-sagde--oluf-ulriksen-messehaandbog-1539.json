  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "LJge maade Tog han oc kalken effter afftens maaltid oc sagde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Tager oc dricker allesammen der aff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Dette er det ny testamentis kalk i mit blod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "det som vdgiffuis for eder oc for mange til syndernis forladelse.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Dette giører saa offte som i det dricke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "i min hukommelse.",
      "part": false,
      "marginal_notes": []
    }
  ]
}