  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Gud Fader du haffuer mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "kand ieg betract/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "i Himmelen oc paa Jordens kreds.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Menniskens slect det vaar foract/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "fra dig foriagt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "for Synder sine i Paradiss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Godhed ieg veed du ey bortuende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "paastend du loffuit dem den trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "hør nu/ sagde du/ Eua Adam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "ved Quindens sæd i bliffue forløst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "O Herre hør/ huad klage ieg før/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "straff mig ey aff den vrede dig rør.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Mit hierte er mig aff haardhed skend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Oc saare betend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Met egen kæde oc Kiødsens lyst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Mod sind fornufft er gantske foruend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Min marg forbrend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Ved Guds Lou/ som er Vredsens røst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Min plage alle dag er mangefold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Plat kold er min Samuittighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "O Christ/ ieg vist paakalder dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "Hielp mig i min mistrøstighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "Thi du est her/ oss kommen nær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "At trøste dem saare bedrøffuit er.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Synder dine ord vil ieg ey høre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "du vilt ey giøre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "effter Guds villie dag oc nat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Dit hierte sig i Synden rør/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "oc ond fruct før/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "it raadet træ mand kiender brat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "Verden er den/ hues lyst dig er",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "saa kier/ at du est ey Guds Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "din lyst din trøst seer ieg er kiød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 2,
      "text": "men Døden er Syndsens rette løn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 2,
      "text": "Den retuiss er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 2,
      "text": "i fare skal være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 2,
      "text": "huor bliffuer da den store Synder bær?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "HERRE til din godhed haaber ieg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "Døm icke mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "Effter din strenge Retfærdighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 3,
      "text": "Thi du komst mild til Jorderig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 3,
      "text": "Oc sactmodig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 3,
      "text": "At føre oss Syndere salighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 3,
      "text": "Sagde/ de karske ingen Læge behøffuer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 3,
      "text": "Røffueren paa Kaarssit du stor Naade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 3,
      "text": "Beuiste O Christ/ vor Broder sand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 3,
      "text": "Talsmand oc eniste Megler god.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 3,
      "text": "O du Guds lam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 3,
      "text": "Der til oss kam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 3,
      "text": "Oc all Verdsens synder bortnam.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 4,
      "text": "Synder dit hierte ieg begær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 4,
      "text": "Slet intet meer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 4,
      "text": "Ey nogen søde ord eller person/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 4,
      "text": "Thi sandelig huer den som siger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 4,
      "text": "Til mig Herre Herre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 4,
      "text": "Skal ey indgaa i Himmelens thron/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 4,
      "text": "Deris mund huer stund beuiste mig ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 4,
      "text": "Dog er deris Hierte vijt fra mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 4,
      "text": "Judas vaar falsk/ i talen god/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 4,
      "text": "Hans mod oc Hierte fuld had oc suig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 4,
      "text": "Der for det maa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 4,
      "text": "Hannem ilde gaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 4,
      "text": "Oc Simon troldkarl lige saa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 5,
      "text": "O Herre ieg rober inderlig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 5,
      "text": "Oc steds til dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 5,
      "text": "Som den Cananeiske quinde giorde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 5,
      "text": "Dit hierte vaar mild oc sactmodig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 5,
      "text": "Der du naadelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 5,
      "text": "Hialpst Paulum dig forfølge torde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 5,
      "text": "O Gud vent du til dig mit hierte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 5,
      "text": "Kom snart/ all min trøst paa dig staar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 5,
      "text": "Vden dig kand ieg ey vende mig om",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 5,
      "text": "Herre kom/ ellers ieg til Døden gaar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 5,
      "text": "J Syndsens nød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 5,
      "text": "Bleff Cain død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 5,
      "text": "Oc Saul kom til Helffuedis glød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 6,
      "text": "Synder dig trycker Syndsens baand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 6,
      "text": "Oc faar offuerhaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 6,
      "text": "Jt ruskendis blad dig jager fast/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 6,
      "text": "Met Gud du icke trette kand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 6,
      "text": "Om hand paastand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 6,
      "text": "Til Helffuedis glød dig støder met hast.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 6,
      "text": "Den vey oc stij til Helffuedis Port",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 6,
      "text": "Er stor/ oc mange did monne gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 6,
      "text": "Til sig/ act mig/ Gud offte mon alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 6,
      "text": "Vel kalde/ dog ere de Vdualde faa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 6,
      "text": "Thi Gud siger/ Jeg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 6,
      "text": "Miskunder mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 6,
      "text": "Offuer den ieg er miskundelig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 7,
      "text": "O Herre/ Gud siger/ naar en Synder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 7,
      "text": "Hiertelig sucker/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 7,
      "text": "Vil ieg ey tencke meer paa hans Synd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 7,
      "text": "Thi Gud ingen Synders død begær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 7,
      "text": "Men at hand helder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 7,
      "text": "Omuendis/ oc gaar i Liffuit ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 7,
      "text": "Den Søn/ som skønt forlaaren vaar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 7,
      "text": "Kom snart/ sin Synd bekiende frijt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 7,
      "text": "Huor god du mod den Hoerquinde bleffst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 7,
      "text": "Bortdreffst hendis fiender/ oc sagde hende quit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 7,
      "text": "Du sagde/ bancker fast/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 7,
      "text": "Eder skal met hast",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 7,
      "text": "Opladis/ dit Ord tror ieg vden last.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 8,
      "text": "Synder du faar min Naade oc fred/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 8,
      "text": "Vilde du met glæde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 8,
      "text": "Din stercke tro sette paa mit Ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 8,
      "text": "Min gunst oc Naade bleff dig beteed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 8,
      "text": "Din Samuittighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 8,
      "text": "Bleff stillet da/ oc Sielens mord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 8,
      "text": "Synder/ end er din Lampe tom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 8,
      "text": "End kom der ey Troens Olie til.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 8,
      "text": "Tror du mig nu/ at ieg din Siel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 8,
      "text": "Ret vel/ sund giøre kand oc vil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 8,
      "text": "Det skeer vden meen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 8,
      "text": "Gud giøret alleen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 8,
      "text": "Ved Troen bliffuer hiertet reen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 9,
      "text": "Ah Herre/ ieg tror det du mig sagde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 9,
      "text": "Dog monne ieg klage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 9,
      "text": "Min store Vantro hielp Herre kier/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 9,
      "text": "Du bryder ey det Rør som er suagt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 9,
      "text": "Fra dag til dag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 9,
      "text": "Min saare skrøbelig tro formeer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 9,
      "text": "Hør nu/ vilt du/ saa bliffuer ieg heel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 9,
      "text": "Ret vel/ ellers ingen mig hielpe kand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 9,
      "text": "Herre sige til mig it naadigt ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 9,
      "text": "Saa faar ieg Sielens lægedom sand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 9,
      "text": "Herre hielp met hast/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 9,
      "text": "Min Siel pinis fast",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 9,
      "text": "Oc plagis aff den wrene gast.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 10,
      "text": "O Menniske stor er din trois krafft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 10,
      "text": "Aff Naadens safft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 10,
      "text": "Dig skee lige som du tror hiertelig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 10,
      "text": "Menniskens Lære skalt du ey act/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 10,
      "text": "Hendis løgn betract/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 10,
      "text": "Hun er aff skrømpterij fuld oc suig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 10,
      "text": "Vent om/ oc kom/ leff effter mit Ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 10,
      "text": "Elsk storlig offuer alting din Gud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 10,
      "text": "Du skalt oc elske vel Neste din",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 10,
      "text": "Fra Synd vær reen/ i fred gack vd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 10,
      "text": "Oc synde icke meer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 10,
      "text": "Ellers bliffuer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 10,
      "text": "Det sidste end det første værre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 11,
      "text": "Loffuit være Gud euindelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 11,
      "text": "At hand haffuer mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 11,
      "text": "Forløst vel fra den euige død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 11,
      "text": "Min aand er nu gantske villig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 11,
      "text": "Mit kiød er siugt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 11,
      "text": "Oc strider imod alt det Gud bød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 11,
      "text": "Din Aand/ oc sand hielp tag ey bort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 11,
      "text": "Ellers suart din lætte byrde vil være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 11,
      "text": "Du Christen/ bliff vist hoss Guds ord klar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 11,
      "text": "Lad fare all Menniskens Low oc lære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 11,
      "text": "Gud O Herre min/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 11,
      "text": "Dit Ord saa reen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 11,
      "text": "Lad være mine Føders lycte oc skin.",
      "part": false,
      "marginal_notes": []
    }
  ]
}