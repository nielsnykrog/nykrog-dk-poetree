{
  "id": null,
  "title": "Den Ubekjendtes Mesterværk",
  "year_created": 1838,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
