{
  "id": null,
  "title": "Christian den anden i Sverrig",
  "year_created": [
    1555,
    1559
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Jens Billes Håndskrift",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1559,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/BILL38.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Vylle y lyde och høere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "ieg wiill eder quede en wiisse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "aff koningh Christiern, then høgborne første,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "ieg wiill hanum loffue och prisse.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: Fordii wunde the Sueriige mett stor ære. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Ther mand skreff M, D,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "och paa thett atthene aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "koning Christiern lod sitt folck samen komme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "y Skaane paa Helssingborge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "The komme tiill-samen baade tydske och danske,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "well widt II M mend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "her Otthe Krompinn, then welbyrdiig mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "hand bleff høffuissmand for them.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Koningen lod kalde syne gode mend tiill siig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "hand bad thenum wære welueliige och trøste:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "\"Ieg wyll ether forse mett slott och læen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "ether skall rett aldriig brøste.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "The suarede alle: \"Naadiste herre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "wii wylle thett gierne giøre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "wii wylle oss beuisse som erliige mendtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "y skulle thett baade høre och spøre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "The droge thenum offuer Hallins-aass,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "the lode theris heste springe:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "the røste thøris glaffuen, theris lange speytz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "the acte stor ære att wynde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "The droffue thenum igenom Halliin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "och ind y Suerigis riige:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "the hellede wore y hierttit trøst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "for ingen wylde the wiighe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "De droffue baade offuer bierg och dale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "y-genom de mørcke skoue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "tiill Gud, y hans hender, stod all thøriis trøst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "tiill ingen mand setthe the loffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "The droffue baade offuer bierg och dale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "i-genom thett mørcke riiss:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "ther the komme tiill Bouessundt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "ther bleffue the thøriis fiender wiiss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "The giorde slag-orden tiill hest och foidtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "the hellede wore well monge:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "the funde ther waaghir och bradir for them,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "the waare baade stercke och lange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "De høffuissmand robthe bøsse-skøttherne frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "the bad thønum bøsserne stiille:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "\"Wii wille her frem, om herre Gud wiill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "y-mod the suenskiis wylie.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "The bøsse-skøtter røcthe bøsserne frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "de lode thøriiss tappyr gonge:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "thett andit skud, ther skuditt wor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "her Sten monne skaden fonge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "Her Sten hans been bleff skudtt sønder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "ud-aff thett andit skudtt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "thett wiill ieg forsenningen siighe:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 12,
      "text": "thett wor forseedtt aff Gudtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "The trycte fast frem tiill hest och foidtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "the wylde icke lenger biide:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "the bruge thøriis glaffuin och skarppe suerdtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 13,
      "text": "the giore the suenske stor quide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "The suenske de flyde, huor the kunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "for konnigen aff Danemarckz woldtt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "\"Hagde wii Thiwidden paa wor røgh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 14,
      "text": "hand wor oss fuld-god en skioldtt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "The suenske flyde, huor the kunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "tiill Oplandtt lod the riide:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "the danske reed baade dag och natt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 15,
      "text": "the lode fast effther thenom liide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "Kyndenmøsse-affthen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "wor froue kircke-gongh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "tha møttis the paa Thiuidden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 16,
      "text": "the sloge saa mongen suensker mand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "Saa droffue the op ad land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "ther lod the thennum biide:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "saa droffue the tiill Wetre-aass,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 17,
      "text": "och ther wylle the thønum huile.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "Saa droffue the fra Westre-aass,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "tiill Strenge-ness wiille the riide:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "ther laa for thenum tryssindz-tiuffue tussinde mendtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 18,
      "text": "the torde thenom icke biide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "The sloge y-hiell, huad thii ther funde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "som fyende pleyde att haffue forssedt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "den anden dagh sende the suenske thennom budtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 19,
      "text": "begierde ud-aff thenom friidtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "The danske the stæde thøriiss mynde ther-tiill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "end herre-dagh y Oplandtt att søge:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "the stockholmske gaffue saa the suenske raadtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 20,
      "text": "the wylde thøris feyde forøghe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 21,
      "text": "The sende ud breff, de sende ud budtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "the suenske bønder samen att komme:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 21,
      "text": "thii wylde the danske sla y-hiell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 21,
      "text": "thett kom thenom tiill liiden fromme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 22,
      "text": "Vylle y lenger høre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 22,
      "text": "huor thett er gongitt tiill:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 22,
      "text": "longe-fredagh droge the tiill Opland,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 22,
      "text": "the begynthiis ett wnderligtt spill.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 23,
      "text": "The danske droffue thenom y-modtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 23,
      "text": "thøriss herre troskaff att beuisse:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 23,
      "text": "the sloge ther saa mongen suensker mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 23,
      "text": "thii wunde ther baade ære och priiss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 24,
      "text": "I Sueriige stod aldriig sliigtt ett slaug,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 24,
      "text": "ther nogen mand kand tencke:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 24,
      "text": "thii er ther saa mongent faderløss barn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 24,
      "text": "saa mongen fattiig encke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 25,
      "text": "Siiden droge the tiill Opland,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 25,
      "text": "koningen ther att biide:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 25,
      "text": "hand sende thenom bud, hand sende thenom breff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 25,
      "text": "tiill Stockholm tiill siig att riide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 26,
      "text": "Saa droge the tiill Stockholm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 26,
      "text": "lage them ind paa Søndre-malm:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 26,
      "text": "the belagde then by, som the well kunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 26,
      "text": "giore thenom baade angist och harm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 27,
      "text": "The stockholmske sende koningen bud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 27,
      "text": "oc lod hanom beede saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 27,
      "text": "hand wille them en gunstiig herre wære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 27,
      "text": "och tage thenom tiill syn naade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 28,
      "text": "Koningen hørde thøriiss bøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 28,
      "text": "thii hand wor wiiss y sinde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 28,
      "text": "wor froue affthen mett korss och faane",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 28,
      "text": "toge the hanum y Stockholm indtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 29,
      "text": "Loffuidtt wære Gud-fader y Hemmeriigh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 29,
      "text": "the danske mendtt haffuer undtt then ære!",
      "part": false,
