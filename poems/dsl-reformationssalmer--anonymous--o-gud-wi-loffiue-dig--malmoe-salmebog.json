  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Gud wi loffiue dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "wi bekende dig for en Herre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "All verden och iørderig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "priser dig euige fader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "Saa gør oc alle dine Engle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "hiemle oc hiemmelske herskaff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Dig prise Cherubin och Seraphin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "met en euige engelske loffsang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "Hellig/ Hellig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "Hellig herlig Herre Gud Sabaoth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 5,
      "text": "Hiemmel och iorden ere opfylte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "met din Maiestatis herlighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 6,
      "text": "Den hederlige Apostelss forsamling",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "Propheter/ Martyrer met alle hellige fedre loffue dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 7,
      "text": "Alle gudfrøctige Gudz børn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "vederkende dig offuer all iørderige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 8,
      "text": "En fader met allerhøyste herlighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 9,
      "text": "Oc din eniste Søn Jesum Christum",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 9,
      "text": "holde wi met dig faar en herlig Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 10,
      "text": "Och saa den Helligand en sand trøstermand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 11,
      "text": "O herre Christe du est en Konge aff all ere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 12,
      "text": "Du est din faders euige Søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 13,
      "text": "Du anammede menniskelige nature met kød oc blod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 13,
      "text": "oc der met offueruant dieffuelsens hoffmod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 14,
      "text": "Der du hagde stungit døden met sin egen bred/",
      "part": false,
      "marginal_notes": [
        "Ose. xiii Mar xvi"
      ]
    },
    {
      "id": 25,
      "stanza_id": 14,
      "text": "da skenckte du alle dine det euige liff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 15,
      "text": "Der fore sider du nu paa høygre hand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 15,
      "text": "i din faders herlighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 16,
      "text": "Och her effter skalt hid igen komme en streng dommere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 17,
      "text": "O Jesu hielp dine tro Christne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 17,
      "text": "huilke du forløste met dit dyrebare blod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 18,
      "text": "At wi mue worde i din ere delactige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 19,
      "text": "O herre hielp dit vdualde folk/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 19,
      "text": "oc velsigne dem som dig ere til arffue giffne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 20,
      "text": "Och regere du dem selff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 20,
      "text": "oc lær dem din vilge ath gøre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 21,
      "text": "Vi prise dig o sande Gud baade nu oc altid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 22,
      "text": "Oc wi prise dit naffn euindelige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 22,
      "text": "fra nu oc til euig tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 23,
      "text": "O herre beuar oss nu oc altid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 23,
      "text": "syndeløse oc synde fri",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 24,
      "text": "O herre forbarme dig offuer oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 24,
      "text": "oc vær oss naadig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 25,
      "text": "O herre the oss din barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 25,
      "text": "som vor store tro er nu til dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 26,
      "text": "Men wi sette til dig vor lid/ hob och trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 26,
      "text": "da vilt du mildelige høre vor røst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 26,
      "text": "oc hielpe oss altid i vor brøst",
      "part": false,
      "marginal_notes": []
    }
  ]
}