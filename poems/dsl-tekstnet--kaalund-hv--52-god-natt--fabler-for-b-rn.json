  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Nu lægger sig hele Naturen til Ro,",
      "part": false,
      "marginal_notes": [
        "Speaker: Paafuglen:"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "til Hvile gaar baade Hest og Ko,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Smaafuglene sætte sig til at sove,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "men Ræven lister fra sorte Skove -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Kom hid! kom hid! mine Unger smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "heroppe kan os ej Røveren naa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Og Ungerne gjorde, som Moderen bad -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "den Ene under hendes Vinge sad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "den Anden slumred ved Siden tryg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "den Tredie tog Plads paa Moderens Ryg;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "men Vinden hvisked i Busk og Krat:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Sov sødeligt Alle! god Nat! god Nat!",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
