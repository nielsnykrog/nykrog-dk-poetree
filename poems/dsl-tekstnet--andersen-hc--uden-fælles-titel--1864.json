  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "I eet Aar, hvilket Væld af Lykkens Magt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Til dine Børn blev Konge-Kroner bragt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Og Dig tilfaldt Europas ældste Rige;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Hvor høit end Bølgen slaaer, i Kraft det staae!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Gid Krigens Rædsler ei til Danmark naae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Du være Christian den Lykkelige!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Du staaer som Moder og som Ægteviv",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "I et velsignet, smukt Familieliv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Som et Exempel. Gid dit Huuslivs Lykke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "I hele Danmarks Rige boe og bygge!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
