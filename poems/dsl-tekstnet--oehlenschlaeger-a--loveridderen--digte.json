{
  "id": null,
  "title": "Löveridderen",
  "year_created": 1803,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Adam Oehlenschläger",
    "country": null,
    "wiki": "Q168356"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Digte",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1803,
    "url": "https://tekstnet.dk/books/oehlenschlaeger-a_digte/007/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Mildt boltre sig de lune Sommervinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "fra klare Safirhvælving Maanen straaler",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "igiennem duftopfyldte svale Linde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "til Engens lukte Lillier og Violer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "rödt glöder gyldne Spir fra Borgens Tinde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "i Flodens fulde sortblaae Jaspisskaaler.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Kong Didrik langsomt paa sin Ganger rider",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "i stille underlige Midnatstider.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Og som han kommer ind hvor Skovens Grene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "saa tæt og dæmrende en Lund indhegner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "hvor der er mörkt og skummelt, tyst og ene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "hvor blegere den blege Straale blegner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "da hörer han det rasle giennem Stene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "for brede Bug det höie Straae nedsegner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "En saaret Löve brölende forfölger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "en Lindorm, som sig giennem Græsset bölger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Dybt Löven slaaer med convulsivisk Vælde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "sin Kloe i Ormen, for sit Saar at hævne;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "da vender den sig langsomt og vil fælde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "sin Fiende i det rædselsfulde Stevne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Det tykke Hoved mosbegroet af Ælde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "den gule Bug, som vil af Ædder revne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "den lange Braad, de Öine blodigröde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "alt dirrer Löven frygteligt imöde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Da raaber den bestæd i stor Ulempe:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "»Red mig fra den som mig mit Liv vil röve!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Kom mig til Hielp, du staalbeklædte Kiempe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "som förer i dit Skiold en gylden Löve;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "som den jeg staaer i Brand, o kom at dæmpe!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "lad Ormens Pandeskal dit Glavind pröve.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Da skal jeg altid vandre ved din Side.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "I Liv og Död du trygt paa mig kan lide.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Og Kongen drager brat sit Sværd hin brede;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "tæt under glatte Skiel han vender Odden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "Hans Öie gnistrer frygteligt med Vrede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "han borer Staalet lige ind til Klodden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "Da rangler Ormens Ledemod saa lede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "den skeler hvæsende og viser Braadden;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "Kongen bliver bleg og heel forfærdet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "han ryster som et Löv og taber Sværdet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "Da slynger Ormen slimbeklædte Hale",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "heel smidig rundt omkring sin Fiendes Lemmer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 5,
      "text": "og kryber taus med ham til Biergets Sale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 5,
      "text": "hvor Nat og Malm de fæle Syner giemmer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 5,
      "text": "Paa Veien uophörligt Haner gale.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "Sit Hoved Ormen haardt mod Fieldet stemmer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "Da revner det, de faste Stene gunge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "og Hesten vrindsker under Ormens Tunge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "»Börnlille! kom I elleve Unger mine.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 6,
      "text": "Her er en ringe Brad. I Morgen mere!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 6,
      "text": "Saa spyer hun Hesten ud. De Unger grine,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 6,
      "text": "og graadig deres Bytte de fortære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 6,
      "text": "»I Morgen skal I Manden faae!« De hvine.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "»For denne Gang I skal fornöiet være.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "De lyde Moderen, men fælt de tude",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "og knytte sig til Hvile i en Knude.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 7,
      "text": "Kong Didrik ganger bleg og heel bedrövet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 7,
      "text": "omkring i Bjergets fæle sorte Hule.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 7,
      "text": "»Ak var mit gode Sværd mig ei berövet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 7,
      "text": "de friede jeg mig let af denne Kule.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 7,
      "text": "Da dræbte jeg de Orme ufortövet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 7,
      "text": "og klemte dem med Skioldets stærke Bule,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 7,
      "text": "og favned atter hierteligt imorgen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "min Fæstemöe, min Fylla, hist paa Borgen.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 8,
      "text": "Og see ved Maanens hvide Midnatsluer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 8,
      "text": "som falder i en Ridse giennem Bierget,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 8,
      "text": "et rustent Sværd tæt ved sin Fod han skuer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 8,
      "text": "hvormed en Kiempe fordum sig har værget.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 8,
      "text": "»Nu ingen Fare meer mit Mod forkuer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 8,
      "text": "thi Skiebnen har sig ei mod mig forsværget.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 8,
      "text": "Saa raaber han og seer paa Sværdet nöie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 8,
      "text": "og bittre Taarer brister af hans Öie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 9,
      "text": "Det bedste Sværd, berömt i alle Lande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 9,
      "text": "den stærke Adelring han har i Hænde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 9,
      "text": "der farvede med Blod saa mangen Pande",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 9,
      "text": "og giorde paa saa mange Helte Ende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 9,
      "text": "Kong Sigfreds Sværd, den Helt som alle Strande",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 9,
      "text": "blandt Kiemper monne förste Rang tilkiende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 9,
      "text": "og Didriks Ven, i mange Aar forsvunden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 9,
      "text": "og nu, ved dette Mærke atter funden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 10,
      "text": "»Saa skulde du din lyse Bane ende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 10,
      "text": "i dette Mörke, mellem grumme Trolde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 10,
      "text": "Dit kiekke Hierte brast i stor Elende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 10,
      "text": "da under disse sorte skumle Volde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 10,
      "text": "Saa let kan Lykken sig i Livet vende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 10,
      "text": "Jeg slaaer saa længe som dit Sværd kan holde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 10,
      "text": "Du var min Ven, din Död jeg vist skal hævne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 10,
      "text": "Hvor der er Mod der mangler ikke Evne.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 11,
      "text": "»Afsted! afsted! hvi vil jeg længer töve",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 11,
      "text": "i denne Hule mellem Skræk og Jammer?«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 11,
      "text": "Han Sværdet slaaer mod Flinten for at pröve",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 11,
      "text": "om det er stærkt, og Bierget staaer i Flammer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 11,
      "text": "De störste Klippestykker kan han klöve.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 11,
      "text": "Da vaagner op den mindste Orm og stammer:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 11,
      "text": "»Hvis du vor Moder vækker af sin Hvile",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 11,
      "text": "da vil du neppe ad din Skiebne smile.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 12,
      "text": "Men Kongen svarer: »Dybt mit Glavind bider!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 12,
      "text": "Dets dödelige Saar kan ei forbindes",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 12,
      "text": "I straffes skal ved disse Midnatstider.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 12,
      "text": "De store Led i eget Blod skal findes.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 12,
      "text": "Det Onde med det Gode altid strider",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 12,
      "text": "og vinder til det evig overvindes.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 12,
      "text": "I vog saamangen Helt i disse Sale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 12,
      "text": "det kan kun eders Hierteblod betale.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 13,
      "text": "»Vaagn, Moder! vaagn, og slug den slemme Fange.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 13,
      "text": "Hun vaagnede og vilde Fangen sluge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 13,
      "text": "Men da hun skued Sværdet blev hun bange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 13,
      "text": "og gav sig til at skielve og at ruge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 13,
      "text": "»Det Guld og Sölv som er i Fieldets Gange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 13,
      "text": "det maa du bringe frit herfra og bruge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 13,
      "text": "Kast Adelring kun ned i Biergets Rifter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 13,
      "text": "et evigt Venskab her med dig jeg stifter.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 14,
      "text": "»Jeg kaster ei mit Sværd, dets Ægge bider,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 14,
      "text": "dets dödelige Saar kan ei forbindes.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 14,
      "text": "Du dræbes skal ved disse Nattetider,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 14,
      "text": "din store Krop i eget Blod skal findes.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 14,
      "text": "Det Onde med det Gode altid strider,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 14,
      "text": "og vinder til det evig overvindes.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 14,
      "text": "Du vog Kong Sigfred her i disse Sale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 14,
      "text": "det skal du med dit Hierteblod betale.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 15,
      "text": "»Kast Adelring dybt ben i Kildevældet!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 15,
      "text": "Blandt Venner ei man bruger skarpe Sværde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 15,
      "text": "Din Fylla sidder fængslet her i Fieldet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 15,
      "text": "Luk hende ud, I er hinanden værde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 15,
      "text": "Et Nögleknippe, rustent og forældet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 15,
      "text": "er skiult heroppe ved mit Hovedgierde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 15,
      "text": "Kom, buk dig, tag det, end din Elsktes Jammer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 15,
      "text": "bring Fylla af det fugtigmörke Kammer.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 16,
      "text": "»Min elskte Pige nager ingen Kummer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 16,
      "text": "Mit Hierte siger hun er ei i Fare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 16,
      "text": "Hist paa sin Faders Borg hun roligt slummer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 16,
      "text": "omskandset af Guds hellige Engleskare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 16,
      "text": "Ei mindste Myg om hendes Leie summer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 16,
      "text": "Du lokker mig forgieves i din Snare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 16,
      "text": "Mit Sværd skal i dit seige Blod sig klæbe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 16,
      "text": "döe Slange! med den sidste Lögn paa Læbe.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 17,
      "text": "Brat Ormen og de fæle Ögleunger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 17,
      "text": "saa gispende i Græsset ned maa bide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 17,
      "text": "Da fylder Hulen Gift og Ormetunger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 17,
      "text": "han vader dybt i Slangeblod hin hvide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 17,
      "text": "Forgieves han i Biergets Side stiunger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 17,
      "text": "de Kampestene viger ei tilside.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 17,
      "text": "Han kan ei bryde giennem sorte Lukke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 17,
      "text": "snart maa han ned i spraglet Edder dukke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 18,
      "text": "Da hörer han fra Fieldets ydre Side",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 18,
      "text": "en vældig Skraben og en Stemme raabe:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 18,
      "text": "»Fat Mod, Kong Didrik! du skal ikke lide!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 18,
      "text": "Her smuldrer Stenen skiör, her kan vi haabe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 18,
      "text": "Hug med dit Sværd, jeg vil i Fieldet slide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 18,
      "text": "med mine Klöer, saa kiempe vi tilhobe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 18,
      "text": "Den haardeste Natur tilbageviger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 18,
      "text": "bestormet af en Löve og en Kriger.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 19,
      "text": "Og Löven grov og Kongen vældigt stödte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 19,
      "text": "med skarpen Adelring, saa Fieldet rysted;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 19,
      "text": "thi Ormene alt meer og mere blödte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 19,
      "text": "den fæle Edder steeg ham op til Brystet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 19,
      "text": "Snart begge Kiemperne hinanden mödte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 19,
      "text": "At blive længer der dem ikke lysted.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 19,
      "text": "De vandred begge trætte ned i Dalen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 19,
      "text": "til Morgenröden og til Nattergalen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 20,
      "text": "Ved klaren Aae, som mellem Blomster dandser,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 20,
      "text": "Kong Didrik sig ved Lövens Side sætter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 20,
      "text": "Det blanke, haarde, blodbestænkte Pandser",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 20,
      "text": "han med den lyse Morgenbölge tvætter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 20,
      "text": "Saa södt hendysser Fuglesang hans Sandser;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 20,
      "text": "og saftig Frugt den matte Kiempe mætter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 20,
      "text": "Til fierne Borg saa længselfuld han smiler,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 20,
      "text": "mens Löven i hans Skiöd sit Hoved hviler.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 21,
      "text": "»Ak herligt synger du, du muntre Sanger!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 21,
      "text": "og venligt, Kilde! dine Bölger vige;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 21,
      "text": "og yndigt, Rose! du i Busken pranger;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 21,
      "text": "dog sörger jeg, thi her er ei min Pige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 21,
      "text": "O havde jeg kun dig, min rappe Ganger!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 21,
      "text": "da paa din stærke Ryg jeg skulde stige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 21,
      "text": "og ile did, og kysse af sin Slummer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 21,
      "text": "den Elskede, og glemme al min Kummer.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 22,
      "text": "Det hörte Löven i hans Skiöd og smilte:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 22,
      "text": "»Jeg kan med dig saa vel som Hesten vanke!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 22,
      "text": "Kom sæt dig paa min Ryg.« Derpaa de ilte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 22,
      "text": "mens Kongen holdt sig ved den tykke Manke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 22,
      "text": "Over Bierg, over Dal de foer, og ei de hvilte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 22,
      "text": "slig Ganger ei behöver Kræfter sanke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 22,
      "text": "Forfærdet Fylla saae sin Beiler trave",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 22,
      "text": "paa sieldne Skimmel over Borgens Grave.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 23,
      "text": "Men siden klapped hendes Lilliehænder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 23,
      "text": "det ædle Dyr, hun fored det hver Morgen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 23,
      "text": "Erkiendtligt Lövens höie Hierte brænder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 23,
      "text": "den blev sin hele Levetid paa Borgen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 23,
      "text": "Taknemlighed er al den Fryd den kiender.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 23,
      "text": "Den glemmer Stolthed, Friehed, selve Sorgen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 23,
      "text": "at skilles fra sin Skov og fra sin Mage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 23,
      "text": "den tiener Kongen alle sine Dage!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
