{
  "id": null,
  "title": "Natur-Temperamenter",
  "year_created": 1803,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Adam Oehlenschläger",
    "country": null,
    "wiki": "Q168356"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Digte",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1803,
    "url": "https://tekstnet.dk/books/oehlenschlaeger-a_digte/021/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Östens lange, blege Strimmel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "breder ud sin hvide Fold.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Stiernen döer paa matte Himmel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Luften er saa vaad og kold.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Perleduggens tætte Vrimmel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "glindser fra den grönne Vold.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Langsomt fölger Bonden Ploven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "velter fugtigtunge Jord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Taus og sort sig hvælver Skoven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "uden Sange, uden Ord!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Fieldet staaer saa stump i Taagen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Hisset Valmuebusken groer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Nattens höitidsfulde Time",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "hen i Evigheden foer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Ingen Kirkeklokker kime",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Dödninger af dunkle Jord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Træt af store Midnatscene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "sover mystiske Natur.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Roligt muldne gamle Bene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "hisset bag den gamle Muur.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "Mat og kold kun Vinden bölger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "hen i Dammens vaade Siv.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "Morgentaagefloret dölger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "hyllende Naturens Liv.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 1,
      "text": "Milde Saphirer paa Himmelens Bue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 1,
      "text": "hæve den prægtige Hvælving med Ynde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 1,
      "text": "Östkanten brænder med Rosernes Lue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 1,
      "text": "Skovenes qviddrende Sange begynde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 1,
      "text": "Tusind Karfunkler i Solen vi skue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 1,
      "text": "Guldgule Bölger i Floden sig skynde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 1,
      "text": "Blomsten udfolder forföriske Blade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 1,
      "text": "boler med Solen i kiölige Bade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 1,
      "text": "Elskov! Elskov!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 1,
      "text": "Venus Cypria!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 1,
      "text": "Dit Altar staaer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 1,
      "text": "i de svale Dale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 1,
      "text": "i de skiönne, grönne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 1,
      "text": "duftende Hvælvinger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 1,
      "text": "hvor Philomela slaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 1,
      "text": "hvor den rislende Sölvbölge gaaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 1,
      "text": "Vellysten blusser paa svulmende Læber,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 1,
      "text": "Faunerne smile og Uskyld forsager.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 1,
      "text": "Lokkende Skiersild! som pirrende dræber!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 1,
      "text": "Helvedes Lue! som Æthren forjager!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 1,
      "text": "Sielen forsvinder, den höiere Sands.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 1,
      "text": "Dyret og Mennesket, Blomsten og Lövet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 1,
      "text": "törres, forstokkes og nærmer sig Stövet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 1,
      "text": "svungen i Straalens ophidsende Dands!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 1,
      "text": "Elskov! Elskov!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 1,
      "text": "Venus Cypria!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 1,
      "text": "Hvor den rislende Sölvbölge gaaer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 1,
      "text": "hvor Philomela slaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 1,
      "text": "i de duftende Hvælvinger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 1,
      "text": "i de skiönne, grönne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 1,
      "text": "svale Dale",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 1,
      "text": "dit Altar staaer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 2,
      "text": "Hvad sortner?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 2,
      "text": "Det er Himlens Bue!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 2,
      "text": "Hvad lysner?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 2,
      "text": "Det er Heklas Lue!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 2,
      "text": "Den stærkeste Kiempe i Nor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 2,
      "text": "den gamle Thor!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 2,
      "text": "Der staaer han, forvandlet til et Field.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 2,
      "text": "Hedder Hekla!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 2,
      "text": "Med Iispandser om sit Bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 2,
      "text": "med Torden i sin Röst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 2,
      "text": "med gloende Tunge!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 2,
      "text": "Harniskpladerne runge!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 2,
      "text": "Paa hiin Side af det vilde Ocean",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 2,
      "text": "staaer hans Fostbroder Vulkan!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 2,
      "text": "Hedder Etna!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 2,
      "text": "Luende Blod paa den skielvende Jord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 2,
      "text": "har de stænket i hinandens Spor.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 2,
      "text": "Da det gamle Rige svandt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 2,
      "text": "grumt de sig forbandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 2,
      "text": "for pludselig eengang med Kiempevægt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 2,
      "text": "at knuse den nyere Slægt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 2,
      "text": "som myldrer mellem begge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 2,
      "text": "deres Flintevægge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 2,
      "text": "Nu raadslaae de sammen i den mörke Gang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 2,
      "text": "saa lang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 2,
      "text": "under Europa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 2,
      "text": "Frels os Jesus af Nazareth!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 2,
      "text": "Paa Engen hist to Roser stod ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 2,
      "text": "Fod ved Fod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 2,
      "text": "i Ungdomsblod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 2,
      "text": "See hvor de skilles ad ved en Klöft!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 2,
      "text": "ved en bundlös Gröft.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 2,
      "text": "Den evige Vrede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 2,
      "text": "har draget det flammede Sværd af sin Skede!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 2,
      "text": "Hvi bliver I alle saa blege?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 3,
      "text": "Tordnen meer ei lyder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 3,
      "text": "Maanen giennembryder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 3,
      "text": "Nattens brustne Skye.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 3,
      "text": "Spredt er Jordens Dampe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 3,
      "text": "Himlens hvide Lampe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 3,
      "text": "brænder klart paa nye.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 3,
      "text": "Intet Skrald",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 3,
      "text": "og Klippefald.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 3,
      "text": "Allevegne Taushed ruger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 3,
      "text": "Græsset Regnen suger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 4,
      "text": "Venligt Nattergalen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 4,
      "text": "synger hist i Dalen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 4,
      "text": "mellem Blomsterbed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 4,
      "text": "paa den Klippetinde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 4,
      "text": "som for barske Vinde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 4,
      "text": "nylig styrted ned.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 4,
      "text": "Dybt til Krat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 4,
      "text": "i dunkle Nat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 4,
      "text": "böd et Öieblik den reise.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 4,
      "text": "Secler saae den kneise!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 5,
      "text": "Hist i Blomsterdække",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 5,
      "text": "Jordens lange Sprække",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 5,
      "text": "gaber sort og stor.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 5,
      "text": "Mildt ved Maanens Straaler",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 5,
      "text": "duftende Violer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 5,
      "text": "sig ad Randen snoer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 5,
      "text": "Snart en Broe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 5,
      "text": "med freidig Roe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 5,
      "text": "Dalens Hyrder her vil bygge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 5,
      "text": "over Döden trygge!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 6,
      "text": "Sorglöst Kildevældet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 6,
      "text": "risler nu fra Fieldet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 6,
      "text": "i sin gamle Dands.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 6,
      "text": "Klippens Roser vinke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 6,
      "text": "Himlens Stierner blinke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 6,
      "text": "med fornyet Glands.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 6,
      "text": "Skiönne Jord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 6,
      "text": "i Nattens Flor!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 6,
      "text": "Dobbelt skiön er Midnatslunden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 6,
      "text": "efter Rædselstunden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 7,
      "text": "Naar den sidste kommer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 7,
      "text": "Naar den store Dommer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 7,
      "text": "knuser eget Værk;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 7,
      "text": "naar han Havet velter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 7,
      "text": "naar han Jorden ælter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 7,
      "text": "med sin Arm saa stærk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 7,
      "text": "skal en Nat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 7,
      "text": "blandt Blomsterkrat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 7,
      "text": "mere klar, hvor ingen famle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 7,
      "text": "blidelig os samle!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
