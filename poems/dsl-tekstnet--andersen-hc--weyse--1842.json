  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1842,
    "url": "https://tekstnet.dk/books/andersen-hc_weyse/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Hans trætte Støv er bragt til Gravens Ro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Hans stærke Aand i Kraft end meer ophøiet! –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Han stod i denne Verden ensom jo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Og ensom lukked’ han i Døden Øiet!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Alene var han: naar da Hjertet leed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Med Melodier Smerten han indlulled’,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "I Toner staaer hans Ungdoms Kjærlighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Den lyder i: »de klare Bølger rulled«!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Han sad ved Orglet, og en egen Magt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Da løftede vor Tanke høit fra Jorden;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "En Skat af Sange har han Folket bragt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "I Toner udtalt Aandens Dyb i Norden!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Hans Tale var et Væld, saa sundt og rigt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Hans Sjæl var ung – nu har den Himlens Glæde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Ak, død er Weyse! – Hvilket Sørge-Digt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Har Kraft som disse Ord, – og dybt vi græde.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
