  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Herre Gud miskunde teg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "see til oss her paa iorden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "wÿ ere thÿne børn saa vsellig/",
      "part": false,
      "marginal_notes": [
        "Math. vj. Luce. xj."
      ]
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "wor fader æstu worden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Tw sidder høgt ÿ himmerig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "oc wÿ wdi dødzens snare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Giff prÿss thit naffn wdi iorderig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "lad oss ey saa hæden fare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "ÿ thÿn vgunst saa saare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "O fader øøg thit rÿge fast/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "lad dieffuelen ey sielff raade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "oc frelss oss fraa then skadelig gest/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "begaff oss med thÿn naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Att wÿ maa wære thÿne lydige børn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "teg lade styre ock raade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "thÿn wilie skee ÿ iorderig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "alt som ÿ himmelens throne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "lær oss thÿne børn til gode.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Giff oss ÿ dag wort daglige brød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "thÿne ord oc hellige naade/",
      "part": false,
      "marginal_notes": [
        "Math. vj."
      ]
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "oc frelss oss fraa then ewige død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "oc saa fraa dieffuelsens waade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Borttag fraa oss med naaden thÿn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Pharisaiske swrdey oc lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "skenck oss igien then klare wÿn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "som Christus monne frambære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "thet er rett tro oc lære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "O kiære fader wær oss huld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "oc spar oss ÿ wor brøste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "wor brøde hun er saa mangefold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "hielp att wÿ ey mistrøste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "J wor strÿd stat oss mandelig bÿ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "offuerwinde vwenner grumme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "aandelige oc werdzlige gienstrÿd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "Ontt wend fraa oss altsammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "oss hør kiære fader Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "Prÿss loff oc heder til ewig tÿd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "er wor begæring alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "skal giffuis teg wor fader saa blÿd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "thÿn søn thet oc for alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "Ther till then aand wor trøstermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "skal giffuis then samme ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "aff fattig oc rÿg ÿ alle land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "som teg nw saare begiære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "Giff thennom then ewig ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "LOffuer Herren alle hedninge:",
      "part": false,
      "marginal_notes": [
        "Psal. cxvj."
      ]
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "oc tilhaabe loffuer Gud alle folk.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 6,
      "text": "Forthi hans miskundhed er stadfest offuer oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "oc Herrens sandhed bliffuer ewindelig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 7,
      "text": "Aere wære Gud fader oc hans søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 7,
      "text": "oc saa Gud then Helliaand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 8,
      "text": "Som wærid haffuer aff begyndelsen nw oc altÿd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 8,
      "text": "fraa ewighed oc til ewighed AMEN.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 9,
      "text": "FOrlad nw thÿn swend o Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 9,
      "text": "effter thit ord ÿ freden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 10,
      "text": "Forthi mÿne øgne haffue seet thÿn gienløselse/",
      "part": false,
      "marginal_notes": [
        "Luce. ij."
      ]
    },
    {
      "id": 56,
      "stanza_id": 10,
      "text": "then som tw beridde for alle menniskens ansigt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 11,
      "text": "Eet liwss til hedningernes opliwselse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 11,
      "text": "oc til thit folkis ære Jsrael.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 12,
      "text": "Aere wære Gud fader oc Gud søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 12,
      "text": "oc saa Gud then helliaand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 13,
      "text": "Som wærid haffuer aff begyndelsen nw oc altÿd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 13,
      "text": "fraa ewighed oc til ewighed AMEN.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 14,
      "text": "Benedider Herren Alleluia. Loffuer Herren Alleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 15,
      "text": "Gud wære benedidet Alleluia. Loffuer Herren Alleluia.",
      "part": false,
      "marginal_notes": []
    }
  ]
}