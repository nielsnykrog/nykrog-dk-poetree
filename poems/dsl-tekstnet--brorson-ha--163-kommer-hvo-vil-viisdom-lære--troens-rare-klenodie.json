{
  "id": null,
  "title": "163. Kommer, hvo vil viisdom lære!",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
