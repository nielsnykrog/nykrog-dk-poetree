      "text": "Att wÿ vndfly all dieffuelsens liste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 1,
      "text": "Med Guds ord wÿ oss bewaare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 1,
      "text": "Amen Amen sandelig saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 1,
      "text": "Saa siunge wÿ Alleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Helliaand bliff tw nw med oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "oc lad oss icke forderffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "Giør oss alle wore synder frij/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "then stund wÿ hæden skulle fare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "Fraa dieffuelsens swig oss wel bewaar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 2,
      "text": "wor tro wdi oss wil styrcke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 2,
      "text": "Paa teg lad oss nw bygge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 2,
      "text": "aff hiertens grund oss trøste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 2,
      "text": "Teg wÿ oss giffue aff gantske macht/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 2,
      "text": "med alle rett Christne menniskis acht/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 2,
      "text": "Att wÿ vndfly all dieffuelsens liste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 2,
      "text": "Med Guds ord wÿ oss bewaare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 2,
      "text": "Amen Amen sandelig saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 2,
      "text": "Saa siunge wÿ Alleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 3,
      "text": "HEr Christ Gud faders eenborne søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 3,
      "text": "som er hans ewig raad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 3,
      "text": "æst aff hans hierte wdgangen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 3,
      "text": "ligerwÿss som schreffuit staar/",
      "part": false,
      "marginal_notes": [
        "Johan. ix."
      ]
    },
    {
      "id": 46,
      "stanza_id": 3,
      "text": "han er then morgen stierne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 3,
      "text": "wor hierter opliwser saa gierne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 3,
      "text": "med sÿn miskundheds ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 4,
      "text": "For oss eet mennisk er worden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 4,
      "text": "ÿ sÿste werdzens tÿd/",
      "part": false,
      "marginal_notes": [
        "Math. j. Luce. ij."
      ]
    },
    {
      "id": 51,
      "stanza_id": 4,
      "text": "hans moder ey forloren/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 4,
      "text": "hennes vkrenckelig kyskhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 4,
      "text": "Dieffuelen haffuer han belenckid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 4,
      "text": "himmerig igien oss skēnckid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 4,
      "text": "med thet ewige lÿff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 5,
      "text": "Wille tw oss naaden giffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 5,
      "text": "att wÿ motte rett forstaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 5,
      "text": "ÿ Christen tro att bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 5,
      "text": "ÿ aanden teg saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 5,
      "text": "wort hierte motte smage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 5,
      "text": "thÿn sødhed alle dage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 5,
      "text": "oc tørste altÿd effter teg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 6,
      "text": "Tw skaber alt paa iorden:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 6,
      "text": "oc æst thÿn faders krafft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 6,
      "text": "regherer thet med thÿn orde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 6,
      "text": "sterckelig med Guddoms macht/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 6,
      "text": "thÿn naade ÿ oss optende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 6,
      "text": "wort hierte om till teg wende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 6,
      "text": "att wÿ ey twÿle paa teg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 7,
      "text": "Straff oss wdaff thÿn gode/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 7,
      "text": "oc styrcke oss med thÿn naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 7,
      "text": "frij oss fraa heluedis waade /",
      "part": false,
      "marginal_notes": [
        "Johan. j."
      ]
    },
    {
      "id": 73,
      "stanza_id": 7,
      "text": "att Guds børn wÿ bliffue maa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 7,
      "text": "Att wÿ her aldrig meere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 7,
      "text": "wden Christi ord begære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 7,
      "text": "oc menniskens lærdom forsmaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 8,
      "text": "Wor gierning oc wor tancke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 8,
      "text": "wiltw bestyre saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 8,
      "text": "then gamle Adam krencke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 8,
      "text": "att then ny nw leffue maa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 8,
      "text": "Att wÿ nw icke meere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 8,
      "text": "wor legoms løst begære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 8,
      "text": "Men altÿd tencke paa teg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 9,
      "text": "MEn wÿ leffue paa iorden her/",
      "part": false,
      "marginal_notes": [
        "Ephe. j."
      ]
    },
    {
      "id": 85,
      "stanza_id": 9,
      "text": "med døden ere wÿ omfangne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 9,
      "text": "Hwem fly wÿ tha tilom hielp",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 9,
      "text": "att wÿ Guds wrede vndgange?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 9,
      "text": "Tw æst then Herre allene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 9,
      "text": "oss twinger nw wore synder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 9,
      "text": "saa saare som teg Gud fortørne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 9,
      "text": "Hellige Herre Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 9,
      "text": "forbarm teg offuer oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 9,
      "text": "Hellige stercke Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 9,
      "text": "forbarm teg offuer oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 9,
      "text": "Hellige barmhiertige trøstermand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 9,
      "text": "tw ewige Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 9,
      "text": "Lad oss icke indfalle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 9,
      "text": "ÿ then ewige nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 9,
      "text": "Kyrieleyson.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 10,
      "text": "Mit ÿ døden omfanger oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 10,
      "text": "heluedis macht ock wrede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 10,
      "text": "hwem frelste oss aff tellig een død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 10,
      "text": "att vndfly sÿne swÿg oc lÿst?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 10,
      "text": "Thet giør tw Herre allene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 10,
      "text": "wer tw nw oss miskundelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 10,
      "text": "helst forthi tw wedst wor brøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 10,
      "text": "Hellige herre Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 10,
      "text": "forbarm teg offuer oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 10,
      "text": "Hellige stercke Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 10,
      "text": "forbarm teg offuer oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 10,
      "text": "Hellige barmhiertige trøstermand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 10,
      "text": "tw ewige Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 10,
      "text": "Lad oss icke fordømmis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 10,
      "text": "wdi then sware heluedis pÿne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 10,
      "text": "Kyrieeleyson.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 11,
      "text": "Mit wdi heluede oss driffuer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 11,
      "text": "wor natur oc synder/",
      "part": false,
      "marginal_notes": [
        "Ephe. j."
      ]
    },
    {
      "id": 118,
      "stanza_id": 11,
      "text": "hwem skulle wÿ tha nw tilfly/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 11,
      "text": "att wÿ maa thennom qwÿt bliffue?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 11,
      "text": "Till teg Herre Christ allene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 11,
      "text": "Thyt dyrebar blod tw for oss wdgaffst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 11,
      "text": "som for alle synder er eet wederlaff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 11,
      "text": "Hellige Herre Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 11,
      "text": "forbarm teg offuer oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 11,
      "text": "Hellige stercke Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 11,
      "text": "forbarm teg offuer oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 11,
      "text": "Hellige barmhiertige trøstermand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 11,
      "text": "tw ewige Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 11,
      "text": "Lad oss icke awfalde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 11,
      "text": "aff then rette tro ÿ mistrøst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 11,
      "text": "Kyrieeleyson.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 12,
      "text": "O Gud aff himmelen see her til/",
      "part": false,
      "marginal_notes": [
        "Psalm. xj."
      ]
    },
    {
      "id": 133,
      "stanza_id": 12,
      "text": "oc lad teg thet forbarme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 12,
      "text": "Gantske faa tha ere thÿne tiæner till/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 12,
      "text": "beswigne ere wÿ arme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 12,
      "text": "Thÿne ord wil man ey giffue macht/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 12,
      "text": "oc troen er skøtt gantske forlatt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 12,
      "text": "hooss alle menniskens sønner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 13,
      "text": "The lære idel falsk oc swig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 13,
      "text": "hwad theris wÿsdom paafinder/",
      "part": false,
      "marginal_notes": [
        "ij. Tim. iij."
      ]
    },
    {
      "id": 141,
      "stanza_id": 13,
      "text": "theris hierte er icke samdrectelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 13,
      "text": "til Guds ord att forkynde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 13,
      "text": "then ene wil thette/ then anden wil thet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 13,
      "text": "bedrage oss med menniskens set/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 13,
      "text": "oc siunes dog hellig vdwortis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 14,
      "text": "Gud wil then schrifft med roden oprycke/",
      "part": false,
      "marginal_notes": [
        "Math: xv: oc. xxiij."
      ]
    },
    {
      "id": 147,
      "stanza_id": 14,
      "text": "som falsk hellighed oss lærer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 14,
      "text": "ther till theris tunge staalt obenbare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 14,
      "text": "taler stort wÿ wille oss wærie/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 14,
      "text": "wÿ haffue rett oc macht ÿ hand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 14,
      "text": "hwad wÿ beschriffue thet skall gaa fram/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 14,
      "text": "hwem er ther wil oss straffe?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 15,
      "text": "Ther fore tall Gud ieg wil opsee/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 15,
      "text": "the arme leggis fast øde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 15,
      "text": "theris suck oc sorrig the meg bethee/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 15,
      "text": "ieg wil theris kæremaal høre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 15,
      "text": "Mÿne salige ord the skulle nw fram:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 15,
      "text": "begiærlig the annamme them/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 15,
      "text": "paa thennom the arme seg trøste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 16,
      "text": "Man prøffuer sølff med ilden wel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 16,
      "text": "saa worder thet klart befundet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 16,
      "text": "paa Guds ord man wel wochte skall/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 16,
      "text": "tesligest ÿ alle stunde/",
      "part": false,
      "marginal_notes": [
        "Math. v. oc. x."
      ]
    },
    {
      "id": 164,
      "stanza_id": 16,
      "text": "thet wil med korsit beskermis best/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 16,
      "text": "saa lærer oss then hellige læst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 16,
      "text": "thets krafft luchter ÿ alle lande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 17,
      "text": "O milde Gud bewaare thÿne ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 17,
      "text": "fraa alle falske lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 17,
      "text": "att alle wÿ her sammen boo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 17,
      "text": "tw wilt wor beskermer wære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 17,
      "text": "The Guds forgangne monne tw her finde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 17,
      "text": "thit folk achte the nw offuer att winde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 17,
      "text": "o Gud forbiwd thennom thet AMEN.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 18,
      "text": "Aere wære teg fader ewindelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 18,
      "text": "oc Christ thÿn søn wor Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 18,
      "text": "ther til wor trøster then Helliaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 18,
      "text": "aff hiertet wÿ thet begiære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 18,
      "text": "Giff oss thÿn naade oc styrcke wor tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 18,
      "text": "att wÿ tilsamen med kierlighed boo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 18,
      "text": "ÿ eet sind effter thÿn wilie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 19,
      "text": "SAa taler then vwÿse mund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 19,
      "text": "then rette Gud wÿ meene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 19,
      "text": "Thet siger han ey aff hiertens grund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 19,
      "text": "sÿne gierning giffue thet tilkende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 19,
      "text": "hans hellighed er for Gud een spot:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 19,
      "text": "J alle hans gierning er intthit got/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 19,
      "text": "Jngen aff thennom Gud rett dyrcke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 20,
      "text": "Gud sielff aff himmelen saa hernid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 20,
      "text": "paa alle menniskens sønner/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 20,
      "text": "tha han theris gierning hadde seet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 20,
      "text": "om han nogen kunde finde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 20,
      "text": "Ther hans ord oc wæy for øghne hadde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 20,
      "text": "oc nogit effter hans wilie giorde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 20,
      "text": "thet kunde han wel paa achte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 21,
      "text": "Ther wor ingen paa rette wey/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 21,
      "text": "the wore alle wdtrædne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 21,
      "text": "alle giorde onth thet straffedes ey/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 21,
      "text": "hwer hadde onde sedwane/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 21,
      "text": "Jngen aff them giorde aff hiertet gott/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 21,
      "text": "ÿ hwor meged the hadde aff Gud faat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 21,
      "text": "thÿ motte han til att tale.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 22,
      "text": "Hwor lenge wille ÿ wanwittige wære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 22,
      "text": "eders ondskab ey forlade?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 22,
      "text": "oc spare mit folk effter mÿn wilie/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 22,
      "text": "oc giøre thennom ingen skade?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 22,
      "text": "Nw wel ÿ tro ey rett paa Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 22,
      "text": "ÿ kalle paa hannwm ey effter hans bud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 22,
      "text": "ÿ wille eder sielff forsørge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 23,
      "text": "Ther fore haffue the aldrig roo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 23,
      "text": "men altÿd monne the frøchte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 23,
      "text": "Gud hooss the fromme altÿd wil boo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 23,
      "text": "the seg paa hannwm forlade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 23,
      "text": "J offuer forsmaa then armis raad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 23,
      "text": "oc holde hannwm alt for spot oc haad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 23,
      "text": "att Gud hans trøst er worden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 24,
      "text": "Hwem skal Jsrael then arme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 24,
      "text": "saligheden giffue?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 24,
      "text": "Gud wil seg sitt folk forbarme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 24,
      "text": "oc løse the forfarne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 24,
      "text": "Thet wil han giøre wid sÿn søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 24,
      "text": "ther aff bliffuer Jacob gantske from/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 24,
      "text": "oc Jsrael seg glæder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 25,
      "text": "THen daarlig mund han siger saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 25,
      "text": "een Gud bekende wÿ gierne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 25,
      "text": "Dog theris hierte ÿ wantro monne staa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 25,
      "text": "med løgen hans ord forderue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 25,
      "text": "Theris handling er fordømmelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 25,
      "text": "for Guds øghne gantske vkendelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 25,
      "text": "ingen Guds bud paa achter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 26,
      "text": "Gud fader nid aff himmelen saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 26,
      "text": "tha wore wÿ alle blinde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 26,
      "text": "han lod seg thet icke forsmaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 233,
      "stanza_id": 26,
      "text": "om han nogen kunde finde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 234,
      "stanza_id": 26,
      "text": "Ther hadde forstand oppaa hans ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 235,
      "stanza_id": 26,
      "text": "for thennom torde woffue bode lÿff oc iord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 236,
      "stanza_id": 26,
      "text": "oc hans wilie fuldkomme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 237,
      "stanza_id": 27,
      "text": "Tha skiøtte ingen then rette wæy/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 238,
      "stanza_id": 27,
      "text": "allsammen wor the wildfarne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 239,
      "stanza_id": 27,
      "text": "hwer fulde then gamle seed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 240,
      "stanza_id": 27,
      "text": "menniskens budord att bewerne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 241,
      "stanza_id": 27,
      "text": "Jngen aff thennom nogit got hadde giord/",
      "part": false,
      "marginal_notes": [
        "Roman. iij"
      ]
    },
    {
      "id": 242,
      "stanza_id": 27,
      "text": "hwer wel for synden giorde stor bood:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 243,
      "stanza_id": 27,
      "text": "Ther offuer seg gud forbarme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 244,
      "stanza_id": 28,
      "text": "Lang tÿd wille the forblindet wære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 245,
      "stanza_id": 28,
      "text": "seg sielff med swig forderffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 246,
      "stanza_id": 28,
      "text": "bedrage the arme/ theris gods fortære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 247,
      "stanza_id": 28,
      "text": "med løgen theris kunst beskerme:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 248,
      "stanza_id": 28,
      "text": "forthi att the tro ey paa Gud/",
      "part": false,
      "marginal_notes": [
        "Mat. xxiij."
      ]
    },
    {
      "id": 249,
      "stanza_id": 28,
      "text": "hannwm ey paakalle ÿ syndzens nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 250,
      "stanza_id": 28,
      "text": "theris gierning mene the thennom hielpe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 251,
      "stanza_id": 29,
      "text": "Ther fore er theris hierte ey still/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 252,
      "stanza_id": 29,
      "text": "till frøcht oc sorrig seg wender/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 253,
      "stanza_id": 29,
      "text": "Gud til the arme seg wende wil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 254,
      "stanza_id": 29,
      "text": "som han ÿ troen finder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 255,
      "stanza_id": 29,
      "text": "Theris bøn han hører bestiller theris raad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 256,
      "stanza_id": 29,
      "text": "oc wil thennom hielpe som han haffuer sagd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 257,
      "stanza_id": 29,
      "text": "thennom glædis att the hannwm haffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 258,
      "stanza_id": 30,
      "text": "Hwem wil the arme Jsraels børn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 259,
      "stanza_id": 30,
      "text": "til Sions trøst annamme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 260,
      "stanza_id": 30,
      "text": "med krafft sÿne miskunds ørhne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 261,
      "stanza_id": 30,
      "text": "wil frelse sÿne faar oc lame?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 262,
      "stanza_id": 30,
      "text": "Thet haffuer han giort oss med søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 263,
      "stanza_id": 30,
      "text": "aff hwilken Jacob fick god løn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 264,
      "stanza_id": 30,
      "text": "oc alle Christne seg glæde.",
      "part": false,
      "marginal_notes": []
    }
  ]
}