  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "AAl then gantske Christenhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "prÿser Guds barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "for hans store kierlighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Thet er nw skeed som spaat hadde Esaias.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "Gabrielis ord the ere nw/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "Eya Eya Een Jomffru haffuer fooster fød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "som Gud fader hadde iætt/ ÿ fordom tÿd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Nw er fød een frelsermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "een frelsermand ÿ Jsrael/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "aff een Jomffru",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "som oss sagde Gabriel.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "Konningen wdaff himmerig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "kom her nid til iorderig/",
      "part": false,
      "marginal_notes": [
        "Zachar. ix."
      ]
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "att han wilde oss giøre salig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "Thet er nw skeed som spaat hadde etc.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 5,
      "text": "All then gantske menniskens køn/",
      "part": false,
      "marginal_notes": [
        "Roman. v."
      ]
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "wor fortapt Guds eenest søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "han haffuer henne nw løøst igien.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 6,
      "text": "Thet er nw skeed som spaat etc.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 7,
      "text": "Dieffuelen hadde oss alle grebit/",
      "part": false,
      "marginal_notes": [
        "j. Corint. ij. Gene. iij."
      ]
    },
    {
      "id": 20,
      "stanza_id": 7,
      "text": "med sÿn løgen oss beswegit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 7,
      "text": "Christus haffuer hans macht knusit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 8,
      "text": "Thet er nw skeed som spaat etc.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 9,
      "text": "Nw er kommen then salige tÿd/",
      "part": false,
      "marginal_notes": [
        "Esaie. ij. iij"
      ]
    },
    {
      "id": 24,
      "stanza_id": 9,
      "text": "ther Propheterne hadde om schreffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 9,
      "text": "att Gud skulle giffue sÿn søn her nid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 10,
      "text": "Thet er nw skeed som spaat etc.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 11,
      "text": "Hwo som Guds søn wil forsmaa/",
      "part": false,
      "marginal_notes": [
        "Deu. xviij."
      ]
    },
    {
      "id": 28,
      "stanza_id": 11,
      "text": "oc ey effter hans lærdom gaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 11,
      "text": "han kand aldrig naade faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 12,
      "text": "Thet er nw skeed som spaat etc.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 13,
      "text": "Hwo som synden wil offuergiffue/",
      "part": false,
      "marginal_notes": [
        "Esaie. lv."
      ]
    },
    {
      "id": 32,
      "stanza_id": 13,
      "text": "oc Gud om miskund bede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 13,
      "text": "han faar naade oc himmerig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 14,
      "text": "Thet er nw skeed etc.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 15,
      "text": "Thet haffuer oss Christus fortiænt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 15,
      "text": "ther till haffuer hanwm Gud wdsend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 15,
      "text": "thÿ wor macht hun er inthit bewend.",
      "part": false,
      "marginal_notes": [
        "ij. Corin. iij"
      ]
    },
    {
      "id": 38,
      "stanza_id": 16,
      "text": "Thet er nw skeed etc.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 17,
      "text": "Ther for bør oss tacke Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 17,
      "text": "frøcte hannwm oc holde hans bud/",
      "part": false,
      "marginal_notes": [
        "Deu. xxxij."
      ]
    },
    {
      "id": 41,
      "stanza_id": 17,
      "text": "thÿ han er then oss hielper aff nød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 18,
      "text": "Thet er nw skeed som spaat hadde Esaias.",
      "part": false,
      "marginal_notes": []
    }
  ]
}