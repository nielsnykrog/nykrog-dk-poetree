  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1845,
    "url": "https://tekstnet.dk/books/andersen-hc_den-27de-mai-1845/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Vaaren gi’er Kys og Alting springer ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Alle Smaafugle faae Lyst at bygge Rede;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Mai er en Maaned for Brudgom og Brud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Hjertet synger: »Herre hör hvorom vi bede!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":|: Bryllupsfest er paa Blomst og Green,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Og vi – vi feire ogsaa een! :|:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Ikke , Athen eller Rom",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Havde, som , den Blomst som Du sögte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Der först de skjönne Mai-Tanker kom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Der var det Huusligheds-Alferne spögte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": ":|: Syden har Skjönhed, men hjemme Du saae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Den deiligst i to Öine laae! :|:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Thorvaldsen har skabt saa mangen smuk ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Du har vist Huus for hele dens Familie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Amor har nu villet takke Dig derfor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Amor er Amor med hele sin bedste Villie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": ":|: Han har Dig skudt med de venlige Ord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "»Sæt Foden under dit eget Bord!« :|:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Det har Du gjort og Hun har gjort det med,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Uden hende var her – ikke Fest i Stuen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "Hun slaaer Öiet ned, men vist paa Tid og Sted,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Vil hun slaae det op og vise hun er Fruen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": ":|: Kjæreste Börn I maa drilles saa smaat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Ellers I faae det altfor godt! :|:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Skibet seiler nu med Maimaaneds-Grönt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 4,
      "text": "Seil kun I to, paa Lykke tör vi love,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 4,
      "text": "Selv i mörke Dage blev Livet rigt og skjönt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 4,
      "text": "Regnbuen staaer paa den brusende Vove.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": ":|: Gid vi see Sölvets og Guldets Glands",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "Straale fra Eders Myrtekrands. :|:",
      "part": false,
      "marginal_notes": []
    }
  ]
}
