      "id": 0,
      "stanza_id": 0,
      "text": "Nu lader oss alle tacke Gud vor Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "huilcken met sin Fødelse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "oss haffuer forløst fra Dieffuelens mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Loffuer Herren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Hannem bør altid at wi siunge met Englene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Ære oc priss være Gud i det Høyeste.",
      "part": false,
      "marginal_notes": []
