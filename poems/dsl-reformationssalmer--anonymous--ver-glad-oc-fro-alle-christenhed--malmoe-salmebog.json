  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "VEr glad oc fro alle christenhed/",
      "part": false,
      "marginal_notes": [
        "Phil. iiii Psalmo xxxii Luce ii Rom. v"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc lader oss alle quede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "aff Jesu Christ saa inderlig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "thi han er al vor glede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Aff hiertens grund wi prise hannem alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "han haffuer oss løst aff Adams fald/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "sit liff lod han det kaaste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "J diæffuelsens vold ieg fangen laa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Jeg vor fordømpt til døde/",
      "part": false,
      "marginal_notes": [
        "Esaie liii ii Tim ii"
      ]
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Min synd mig qwalde nat oc dag/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "ieg hadde stor angest oc møde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "oc altid sanck ieg dybere ned/",
      "part": false,
      "marginal_notes": [
        "Rom xii Esa lxiiii Hie xvii"
      ]
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Jeg viste ey raadt ey salighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "saa hagde mig synden offueruundit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Myne gode gerninger ere alle vren/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "for Gud som hiertit ransager/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Min natur er baade fuld oc slem/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "som ieg tid sielff fornemmer/",
      "part": false,
      "marginal_notes": [
        "Ge vi oc viii Ro viii"
      ]
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Ath vilgen haffuer løst til all ondskaff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "oc kan ey gøre det Gud oss bad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "thi maa ieg til helffuede siuncke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Da ynckede Gud i hiemmerige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "mine elende offuer maade/",
      "part": false,
      "marginal_notes": [
        "Joan iii Gene iii"
      ]
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "han tenckte paa sin barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "han vilde mig hielpe lade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "sit faderlige hierte vende han til mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "han kaaste der paa for vden suig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "det kæriste der han hagde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Han talede til sin kære søn/",
      "part": false,
      "marginal_notes": [
        "Luce i"
      ]
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "det er nu tid ath forbarme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "du skalt det gøre alt for min bøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "far hen oc frelss de arme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "oc hielp dem vd aff syndsens nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "och sla ihiel den horde død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "oc lad thennem met dig leffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Gudz Søn sin fader lydig wor/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "Han kom til mig paa iorden/",
      "part": false,
      "marginal_notes": [
        "Phil. ii Esa vii Phil. ii"
      ]
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "aff en Jomffru bode ren och klar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "han vilde min broder vorde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "Sin kongelig mact førde han i løn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "alt vnder det vsle menniskens køn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "han vilde dieffuelen fange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "Han bad oss alle komme til sig",
      "part": false,
      "marginal_notes": [
        "Mat. xi Joan. xv"
      ]
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "Om wi vilde salige være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "han gaff sig selff mod døden i strid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 6,
      "text": "sit liff vil han ey spare",
      "part": false,
      "marginal_notes": [
        "Joan x"
      ]
    },
    {
      "id": 46,
      "stanza_id": 6,
      "text": "Han tede der met sin kærlighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 6,
      "text": "wi skulde bliffue hans euindelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "och aldrig fra hannem skilyes",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 7,
      "text": "Mit blod det flød paa iorden ned/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 7,
      "text": "ieg baar det korss met møde/",
      "part": false,
      "marginal_notes": [
        "Ma. xvi Luc. xxii"
      ]
    },
    {
      "id": 51,
      "stanza_id": 7,
      "text": "ieg led for dig den haarde død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 7,
      "text": "tro det/ oc lad dig døb/",
      "part": false,
      "marginal_notes": [
        "Joan. xix"
      ]
    },
    {
      "id": 53,
      "stanza_id": 7,
      "text": "Mit liff offueruinder alt dødsens mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 7,
      "text": "all verdsens synd wor paa mig lagt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 7,
      "text": "thi est dw salig vorden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 8,
      "text": "Til hiemmelss igen til fader min/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 8,
      "text": "for ieg fra dette elende/",
      "part": false,
      "marginal_notes": [
        "Jo. xiiii oc xvi Ro. viii"
      ]
    },
    {
      "id": 58,
      "stanza_id": 8,
      "text": "Der wil ieg være meglære din/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 8,
      "text": "den helligand dig vdsende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 8,
      "text": "han dig i angist trøste skall/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 8,
      "text": "han skal dig lære sandhed all/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 8,
      "text": "oc vise dig rette vey",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 9,
      "text": "Dw skalt predicke den Christelige tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 9,
      "text": "der ieg befalde ath lære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 9,
      "text": "Och elske huer anden aff hiærte oc hu/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 9,
      "text": "det skal mit bud nu være/",
      "part": false,
      "marginal_notes": [
        "Jo. xii Mathei xxviii Jo. xiiii oc xv Esai. xl"
      ]
    },
    {
      "id": 67,
      "stanza_id": 9,
      "text": "for menniskens lærdom wocte dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 9,
      "text": "thi han forderffuer all sandhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 9,
      "text": "Gudz ord det bliffuer euindelig",
      "part": false,
      "marginal_notes": []
    }
  ]
}