  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "NOs autem gloriari oportet in cruce Domini nostri Jesu Christi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "in quo est salus vita et resurrectio nostra,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "per quem saluati et liberati sumus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Deus misereatur nostri et benedicat nobis:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Jlluminet vultum suum super nos, et misereatur nostri.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Gloria Patri et Filio et Spiritui sancto:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Sicut erat in principio et nunc et semper, et in secula seculorum, Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "DJscubuit Jesus et Discipuli eius cum eo, et ait.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Desiderio desideraui hoc pascha manducare vobiscum antequam patiar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Et accepto pane gratias agens fregit, et dedit illis, dicens.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Hoc est Corpus meum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Et accepto calice gratias agens dedit illis, et ait.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Hic est sanguis meus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Edite et bibite ex hoc omnes, et facite quotiescunque feceritis in mei commemorationem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "Dicens.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "Hoc est Corpus meum, et sanguis meus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "Gloria Patri potentissimo, et Filio eius vnigenito, et Spiritui sanctissimo paracleto: Sicut erat in principio.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 6,
      "text": "Dicens. Hoc est Corpus meum, et sanguis meus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 7,
      "text": "HJelp Gud at ieg nu kunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 7,
      "text": "Du edele skaber min/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 7,
      "text": "Prise dig aff hiertens grunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 7,
      "text": "Guddommelig ære din.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 7,
      "text": "Saa gladelig begynde vil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "om dine ord at siunge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 7,
      "text": "Herre Gud hielp mig der til.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 8,
      "text": "Euindelige dine ord bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 8,
      "text": "Som Esaias Prophet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 8,
      "text": "J sin Bog monne scriffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 8,
      "text": "Før skulle forgaa all Slect/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 8,
      "text": "Himmel oc alt det Gud haffuer giort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 8,
      "text": "Skulle det end slet fordærffuis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 8,
      "text": "Aldrig rygger Gud sit ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 9,
      "text": "Jesus kom hid til Verden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 9,
      "text": "Hand vaar Guds ord det bold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 9,
      "text": "Giorde huer Mand stor velgierning/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 9,
      "text": "Dog bleff hand ynckelige sold",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "Aff Juda/ som vaar hans egen mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Bleff hand forraad til døde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "Jesus det meenløse Lam.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 10,
      "text": "Da Jesus haffde ædit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "Met sine det Paaske Lam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "De skulde hannem ey forgæde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "Tog Brødet i sin haand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "Æder (sagde hand) mit Legeme det er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "Som skal for eder giffuis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 10,
      "text": "Betale for eders Synder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "Hand monne dem ocsaa skencke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "J Vin sit rosens Blod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "Hans død der met at betencke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 11,
      "text": "At hand vaar oss saa god/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 11,
      "text": "Huo verdelige æder aff dette Brød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 11,
      "text": "Oc dricker denne Skaale/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 11,
      "text": "Aldrig bliffuer hand død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 12,
      "text": "Jesus tode deris Føder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 12,
      "text": "Dog hand vaar deris Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 12,
      "text": "Saa skulle i hinanden giøre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 12,
      "text": "(Sagde hand) det er min lære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 12,
      "text": "At i skulle haffue hinanden kier/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 12,
      "text": "Der paa skal mand det kende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 12,
      "text": "At i mit Folck ere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 13,
      "text": "Christus i Vrtegaarden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 13,
      "text": "Der hand sin Bøn haffde giort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 13,
      "text": "De komme met Hellebaarder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 13,
      "text": "Oc ledde hannem bunden bort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 13,
      "text": "For Dommeren som vaar den tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 13,
      "text": "Hudstrugen oc met Torn krunit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 13,
      "text": "Bleff saa fordømt til døde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 14,
      "text": "Høyt paa Kaarssit ophengdis",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 14,
      "text": "Denne høybaarne Første/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 14,
      "text": "Effter oss hannem saare forlengdis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 14,
      "text": "Thi sagde hand/ mig tørster/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 14,
      "text": "Det vaar effter vor salighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 14,
      "text": "Aff Maria vaar fødder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 14,
      "text": "Guds Søn i euighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 15,
      "text": "Hand bøyede ned sit hoffuit/ Och saa sin Aand opgaff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 15,
      "text": "Som Johannes haffuer vidnit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 15,
      "text": "Der nest bleff tagen aff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 15,
      "text": "Kaarssit/ oc bleff i Graffuen lagt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 15,
      "text": "Oc Tredie dag opstanden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 15,
      "text": "Som hand tilforn haffde sagt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 16,
      "text": "Sine Disciple da lærde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 16,
      "text": "Jesus at forkynde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 16,
      "text": "Hans ord omkring all Verden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 16,
      "text": "Huo sig vil omuende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 16,
      "text": "Fra Synd/ oc tro oc bliffue døbt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 16,
      "text": "Hand skal euindelige leffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 16,
      "text": "Det haffuer hannem Christus kiøbt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 17,
      "text": "Lucas hand monne scriffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 17,
      "text": "Om Christi Himmelfart/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 17,
      "text": "Dog vil hand hoss oss bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 17,
      "text": "Altid som hand haffuer sagt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 17,
      "text": "Det er alt met sit Guddoms ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 17,
      "text": "Der kand ingen mod stride/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 17,
      "text": "Ey gantske Helffuedis port.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 18,
      "text": "En trøstere hand oss sende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 18,
      "text": "Som er den Hellig Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 18,
      "text": "Sandhed skal hand oss kiende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 18,
      "text": "Oc styrcke oss i modgang/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 18,
      "text": "Den samme ville wi kalde paa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 18,
      "text": "Hand vil oss ey forlade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 18,
      "text": "Men trolige met oss staa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 19,
      "text": "Lader oss for Herskab bede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 19,
      "text": "Gud Fader inderlig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 19,
      "text": "Enddog wi aff dem lide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 19,
      "text": "Vold wret oc wfred/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 19,
      "text": "At Gud vil giffue dem sin naad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 19,
      "text": "Haffuer Christi Martyr siungit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 19,
      "text": "Der hand i Fengsel sad.",
      "part": false,
      "marginal_notes": []
    }
  ]
}