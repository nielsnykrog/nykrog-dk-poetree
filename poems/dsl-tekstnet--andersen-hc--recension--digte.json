  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Vel rødmer Land og Hav ret smukt i Aftensolens Flamme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Men ak, Maneren mærker man bestandig er den samme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Original er Solen ei, hvad saa den er forresten,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Bestandig staaer den op i Øst, og synker ned i Vesten;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Saa komme Nattens Stjerner frem, men man sig ret maa harme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "De skinne vel, men Alt er koldt, der er ei Liv, ei Varme!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "En Nattergal ret snurrigt slaaer sin Trille hist bag Muren,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Men der er ei Methode i, det er jo reent Naturen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Desuden er den alfor ung, har neppe Duun paa Hagen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Og havde Sangen ingen Feil, saa sang den nok om Dagen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Nu staaer da ogsaa Maanen op, og den er ei saa ilde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Var den dog bare altid rund, og ikke skifte vilde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Høit skummer Bølgen, men for stærkt, den maa sig moderere –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "– Det Hele røber vel Genie, men heller ikke mere!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
