    "url": "https://tekstnet.dk/books/brorson-ha_troens-rare-klenodie/086/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Gud! fornuften fatter ey",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Din forsyns skiulte naade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Den ubegribelige vey",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Og underlige maade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "At føre dine helgen paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "At gange og ledsage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Lede, drage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Og altid med dem gaae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "I alle deres dage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Naar du os vil ophøye, maae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Vi først til jorden segne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Naar vi dit naade-skin skal faae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Saa lader du det regne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Du tager os vor fordeel hen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Naar du os riig vil giøre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "For at føre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Vor siel til dig igien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Og dine bud at høre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Du lader os med helved-frygt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "I vore synder plage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "At naaden ret kand blive søgt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Og desto bedre smage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Du truer os med nød og død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Naar du os vil oplive,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Trøsten give,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Der er langt mere sød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "End nogen kand beskrive.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Og naar vi da din kierlighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Og milde hierte finde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "At mange glædes taarer ned",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Af vore øyne rinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Naar den afvendte siel igien",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "I JEsu skiød kand havne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "Ham at favne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "Saa svinder verden hen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "Som drømme, røg og avne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "Du stiller dig som du varst vred,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "Forskrekker vore tanker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "Du støder os i skarnet ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "Os truer, slaaer og banker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "Befinder du os deri troe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "At vi det trofast mene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "Med dig ene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "Saa faae vi liv og roe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "I siel, i marv og bene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "Du fører os i kamp og striid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "Mod satans hele skare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "Vi synes tiit i saadan tiid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 5,
      "text": "I alt for stor en fare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 5,
      "text": "Da lære vi, hvor lidt vor leyr",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 5,
      "text": "Formaaer mod satans pile,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 5,
      "text": "Til dig ile,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 5,
      "text": "Og efter vunden seyr",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 5,
      "text": "I dig allene hvile.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "I saadan kamp vi føres ind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "Til vores egen nytte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 6,
      "text": "I Gud et uforandret sind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 6,
      "text": "At faae til deel og bytte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 6,
      "text": "Naar vi vor jammer, synd og nød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 6,
      "text": "Saa stærk i Gud bekrige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 6,
      "text": "At de vige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 6,
      "text": "Det bringer kiødet død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 6,
      "text": "Og aanden kraft og rige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "Saa gaaer du giennem torn og krat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 7,
      "text": "Og mange mørke stræder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 7,
      "text": "At faae de arme siele fat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 7,
      "text": "Som sig i verden glæder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 7,
      "text": "At de sig siden uden tvang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 7,
      "text": "Dig gandske overgive,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 7,
      "text": "Troe forblive,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 7,
      "text": "Og satan mangen gang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 7,
      "text": "Forfølge og fordrive.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 8,
      "text": "Du giør til idel daarlighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 8,
      "text": "De vises høye sinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 8,
      "text": "Og den for verden intet veed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 8,
      "text": "Kand dine veye finde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 8,
      "text": "De arme synd're naade faae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 8,
      "text": "Men de sig selv behage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 8,
      "text": "Maae tilbage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 8,
      "text": "Med skam og blusel gaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 8,
      "text": "Som verden ey forsage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 9,
      "text": "Det, som er for fornuften stort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 9,
      "text": "Det agter du ey meget,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 9,
      "text": "Men det, som verden kaster bort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 9,
      "text": "Det kalder du dit eget,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 9,
      "text": "Din gierning fører ingen pragt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 9,
      "text": "Hvad roes og gunst vil vinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 9,
      "text": "Maa forsvinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 9,
      "text": "Det, som er slet og svagt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 9,
      "text": "Det kand din naade finde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 10,
      "text": "Og det er nu din gamle viis",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 10,
      "text": "Med dem, som dig behage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 10,
      "text": "De maae saa ofte tugtens riis",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 10,
      "text": "Og megen trængsel smage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 10,
      "text": "Du fører os i mulm og mørk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 10,
      "text": "Hvor ingen vey og ende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 10,
      "text": "Er at kiende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 10,
      "text": "Før vi fra verdens ørk",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 10,
      "text": "Til himlens hiem os vende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 11,
      "text": "Du viser altid det, der staaer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 11,
      "text": "Imod den deel, du tænker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 11,
      "text": "Naar veyen hen til kronen gaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 11,
      "text": "Saa viser du os lenker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 11,
      "text": "Tit lader du os falde, naar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 11,
      "text": "Du os fra fald og snare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 11,
      "text": "Vil bevare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 11,
      "text": "Og lægedommen gaaer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 11,
      "text": "Da ud af gift og fare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 12,
      "text": "Du giør os nøgen, bar og blot,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 12,
      "text": "Naar du os vil berige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 12,
      "text": "Og trapperne er spee og spot",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 12,
      "text": "Til ærens krands at stige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 12,
      "text": "Naar vi slet intet andet kand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 12,
      "text": "End onde lysters vinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 12,
      "text": "I os finde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 12,
      "text": "Saa setter du i stand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 12,
      "text": "De synd-beklemte sinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 13,
      "text": "Naar sielen sidder kold og svag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 13,
      "text": "I stor anfegtnings mørke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 13,
      "text": "Da just i hendes vee og ach",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 13,
      "text": "Du selv er hendes styrke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 13,
      "text": "Vi tænke ofte i vor vee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 13,
      "text": "At du os slet forstøder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 13,
      "text": "Knuser, døder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 13,
      "text": "Ved enden kand vi see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 13,
      "text": "At hiertet mod os bløder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 14,
      "text": "Hvo merker, søde Gud! din daad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 14,
      "text": "Og vise forsyns veye?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 14,
      "text": "Hvo overgiver sig dit raad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 14,
      "text": "Og faderlige pleye?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 14,
      "text": "Vi troe dit milde hierte ey,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 14,
      "text": "Og kand vor onde ville",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 14,
      "text": "Ikke stille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 14,
      "text": "Naar du fra glædens vey",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 14,
      "text": "I korset os vil skille.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 15,
      "text": "O Fader! vær taalmodig mod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 15,
      "text": "Os arme her i live,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 15,
      "text": "Og lad vort hiertes onde rod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 15,
      "text": "Din naade ey fordrive,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 15,
      "text": "Du kiender jo vort onde sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 15,
      "text": "Hvor let vi selv os plage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 15,
      "text": "Og forsage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 15,
      "text": "Naar korset trænger ind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 15,
      "text": "I vore glædes dage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 16,
      "text": "Saa brug din gode fader-ret",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 16,
      "text": "Og vise tugte-maade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 16,
      "text": "Det vilde gaae os alt for slet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 16,
      "text": "Om kiødet skulde raade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 16,
      "text": "Griib hiertet an, og lad os ey",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 16,
      "text": "I verden nogen hvile,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 16,
      "text": "Før vi ile",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 16,
      "text": "Til dig paa troens vey",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 16,
      "text": "For korsets jammer-pile.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 17,
      "text": "Lær os det falske hykle-trin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 17,
      "text": "Fra Christi gang at skille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 17,
      "text": "Og ikke med det bare skin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 17,
      "text": "Os selv og andre drille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 17,
      "text": "Ey følge vore egne spor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 17,
      "text": "Thi vor fornuft de rette",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 17,
      "text": "Ey kand giette,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 17,
      "text": "Men dine veye for",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 17,
      "text": "Vort øye altid sette.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 18,
      "text": "O! lad fornuften aldrig dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 18,
      "text": "I dine veye dømme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 18,
      "text": "Og kiødet ey bedrage sig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 18,
      "text": "I sine egne drømme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 18,
      "text": "Og naar du giør ved korsets tugt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 18,
      "text": "At synden os skal smage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 18,
      "text": "Salt som lage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 18,
      "text": "Vi da forstaae den frugt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 18,
      "text": "Som vi af korset tage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 19,
      "text": "Saa føer os ved din egen haand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 19,
      "text": "Som du det bedst kand finde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 19,
      "text": "Og lad din gode Hellig Aand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 19,
      "text": "Os alle tider minde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 19,
      "text": "At hvordan du os føre vil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 19,
      "text": "Saa er din vey og maade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 19,
      "text": "Os at raade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 19,
      "text": "Hvor haardt det end gaaer til,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 19,
      "text": "Dog idel naade, naade.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
