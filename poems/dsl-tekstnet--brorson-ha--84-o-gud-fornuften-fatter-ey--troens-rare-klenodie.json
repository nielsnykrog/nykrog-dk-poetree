{
  "id": null,
  "title": "84. O Gud! fornuften fatter ey",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
