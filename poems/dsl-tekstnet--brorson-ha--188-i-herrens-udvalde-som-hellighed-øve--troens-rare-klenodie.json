{
  "id": null,
  "title": "188. I HErrens udvalde, som hellighed øve",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
