{
  "id": null,
  "title": "Turde jeg min ydmyge tjeneste beté",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
