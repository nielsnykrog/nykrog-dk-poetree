  "title": "Bøndernes og Fiskernes Sang til Kongen. Den 18de September 1841",
  "year_created": 1841,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
