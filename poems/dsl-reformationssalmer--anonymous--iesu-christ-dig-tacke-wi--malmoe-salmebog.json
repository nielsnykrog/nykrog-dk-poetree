    "place": "Malmø",
    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/malmoe-salmebog/1/66"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "IEsu Christ dig tacke wi/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "du lod oss icke fortabis/",
      "part": false,
      "marginal_notes": [
        "Phil ii"
      ]
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "fra vor synd giorde du oss fri/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "du ville selff for oss plagis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "thi du hagde oss inderlig kær/",
      "part": false,
      "marginal_notes": [
        "Joan xv"
      ]
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "vel den det kunde besinde at du for vor skyld døder er",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "der met wi hiemmerige winde/",
      "part": false,
      "marginal_notes": [
        "Hebr vii"
      ]
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "hagde du icke dit blod vdgiffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "oc saa for oss betalit da hagde wi alle fortabit bleffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "til heluedis grund ned faldit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Jesu Christ wi tacke dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "wi loffue dig/ wi prise dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Huo haffuer hørt slig kerlighed/",
      "part": false,
      "marginal_notes": [
        "Joan iii Psalmo xiiii Rom v Rom iii Joan iii"
      ]
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "som Gud fader haffuer oss beted?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "wi som wore aff synder leed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "thi alle hans bud hagde wi forget/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "der fore wor han paa oss wred/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "wi vore hans vuenner alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Euige pine hagde wi fortient/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "ret bode vnge oc gamle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Men Gud for sin miskundhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "monne sig offuer oss forbarme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "sin eniste Søn sende han her ned",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "at frelse oss vsle oc arme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 1,
      "text": "Jesu Christe wi tacke dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 1,
      "text": "wi loffue dig/ wi prise dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Der fore skulle wi være glad/",
      "part": false,
      "marginal_notes": [
        "Zacha ix"
      ]
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "oc altid Gud fast loffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "han vill inted andit haffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "for sin velgerning och gaffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "En ath wi skulle synden offuergiffue",
      "part": false,
      "marginal_notes": [
        "Ezech xviii"
      ]
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "Der fore leed Gudz Søn pine/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "At wi skulle nu ret christelig leffue/",
      "part": false,
      "marginal_notes": [
        "i Pet ii Joan xiii"
      ]
    },
    {
      "id": 33,
      "stanza_id": 2,
      "text": "huer anden elske oc lide/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 2,
      "text": "gøre dem gaat/ som oss gøre ont/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 2,
      "text": "som Gud mod oss monne gøre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 2,
      "text": "der paa kendis wi ath være Gudz folk",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 2,
      "text": "om wi oss i kerlighed øffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 2,
      "text": "Jesu christ wi tacke dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 2,
      "text": "wi loffue dig/ wi prise dig",
      "part": false,
      "marginal_notes": []
    }
  ]
}