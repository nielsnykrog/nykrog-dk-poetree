{
  "id": null,
  "title": "Herr Peder bor sig ute med å",
  "year_created": [
    1630,
    1639
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Dronning Sophias visebog",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1639,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/DRS88.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "En anan wisa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 1,
      "text": "Här Pädar Bor sig wte med ådh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Han åtte döttrar fäm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Adelin hette den ÿngsta,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "och hon var skönaste af dem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": ":: Tÿ hon bär Sörgen för honom. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Här Nichlas tiänar i Konungenss gardh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "han ähr en Ridderss Man,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "fäste han stålten Adelin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "den sköne lilie wan,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": ":: Tÿ hon bär sårgen för honom. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "Dett Sporde och den gamblj Grefve,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "han bodde sig vnder Ödh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Att then Bolde Här Nichlas",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "hade fäst then wäna Möö.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": ":: tÿ hon bär Sorgen för honom. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Dett war och den gamble Grefve,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "beder sala Hästen sin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "iag skall rida till Konungen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "han ähr kiäre sÿster Sonen min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": ":: T. H. B. S. F. H. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Den gamble Grefve kom ridande i Konungenss gårdh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "gåår in för Konungen att står",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "Här Nils hafver fäst den stålte Iungfru,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "där all min hugh till var",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": ":: T. H. B. S. F. H. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Haffuer han fäst den stålt Iungfru",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "der all Eder hugh till war",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "will gudh dett iagh leffua må",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": "han skall henne aldrigh få",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": ":: t h b s f h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "Kåningen later Ett vthbudh giöra",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "han later thett giöra så stränge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 7,
      "text": "thett war alt för her Nilses skull giordt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 7,
      "text": "han skulle icke töffua för lenge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": ":: t h b s f h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "Iagh hade achtatt mitt brölop giöra",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 8,
      "text": "och leffwa I glädie och Roo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 8,
      "text": "och warra hoss eder min hiertans kiäre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 8,
      "text": "medh eder både bÿga och boo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 8,
      "text": ":: t h b s f h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 9,
      "text": "Hören I stålt Adelin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 9,
      "text": "wille I migh Iungfru bida,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 9,
      "text": "iagh will kåma snart igän",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 9,
      "text": "om gudh will vnda migh liffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 9,
      "text": ":: t h b s f h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 10,
      "text": "Iagh will Eder Iungfru bida",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 10,
      "text": "dett seger iagh Eder försan",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 10,
      "text": "om I icke kåme aff lidingen hem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 10,
      "text": "iagh låffuar migh aldrigh man",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 10,
      "text": ":: t h b s f h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 11,
      "text": "Höre I her Nils then bålle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 11,
      "text": "iagh will eder bida möö,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 11,
      "text": "kåme I icke aff lidingen hem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 11,
      "text": "den sårgh tuingar migh till dödh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 11,
      "text": ":: tÿ bär hon sårgen för honom ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 12,
      "text": "Thett war och den gamble greffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 12,
      "text": "beder han sadla sine hester",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 12,
      "text": "än skall iagh vthÿ denne dagh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 12,
      "text": "her peder hemme geste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 12,
      "text": ":: t h b s f h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 13,
      "text": "Den greffuen kåmer Ridandes",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 13,
      "text": "vthÿ her peders gårdh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 13,
      "text": "vthe står her peder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 13,
      "text": "han war wäll suept vthÿ mårdh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 13,
      "text": ":: t h b s f h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 14,
      "text": "I stå her heren pedar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 14,
      "text": "I ären wäll suept I skin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 14,
      "text": "I giffuen migh stållt adelin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 14,
      "text": "till ale käraste min",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 14,
      "text": ":: t h b s f h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 15,
      "text": "Höre I gamble greffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 15,
      "text": "huadh iagh eder suara will,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 15,
      "text": "kåmmer Her Nilss aff Lidinge hem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 15,
      "text": "hon hörer honom till",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 15,
      "text": ":: t. h. b. S. f. h. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 16,
      "text": "Iagh ähr nu så gammall, mig lÿster eÿ begära",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 16,
      "text": "en annarss fästemöö,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 16,
      "text": "thed må iag ider säÿa wppå min San,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 16,
      "text": "thed här Nilss han ähr dödh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 16,
      "text": ":: t. h. b. S. f. h. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 17,
      "text": "Thed war Herren Peder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 17,
      "text": "han svarade honom så brått,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 17,
      "text": "iag skall med min dotter tala,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 17,
      "text": "för än iag gifver henne bortt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 17,
      "text": ":: t. h b. S. f. h. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 18,
      "text": "Mitt Vpå Midie gärde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 18,
      "text": "tär Axlade han sin skin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 18,
      "text": "så går han i frustugan in",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 18,
      "text": "till käre dotter Sin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 18,
      "text": ":: t. h. b. S. f. h. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 19,
      "text": "Thed war Härren Pädar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 19,
      "text": "han in igönom dören stegh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 19,
      "text": "wpstog stålten Adelin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 19,
      "text": "hon Emott honom Negh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 19,
      "text": ":: t. h. b. S. f. h. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 20,
      "text": "Höre du ståltt Adelin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 20,
      "text": "Her Nilss han är nu dödh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 20,
      "text": "Iag will gifva tigh then gamble Grefve,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 20,
      "text": "tu skall blifua honom Fästemöö",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 20,
      "text": ":: t. h. b. S. f. h. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 21,
      "text": "Thed war hennass tärna,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 21,
      "text": "hon var så snartt till att svara,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 21,
      "text": "i gifve min Iungfru ingen annan Man",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 21,
      "text": "Vtan then henne siälff behagar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 21,
      "text": ":: t. h. b. S. f. h. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 22,
      "text": "Tu tigh stilla Elin tienste Möö",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 22,
      "text": "och i skulle tiga både,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 22,
      "text": "i kunne inthe bätre svara,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 22,
      "text": "tärföre skulle i inthe råda,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 22,
      "text": ":: t h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 23,
      "text": "Thed war Härren Pädar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 23,
      "text": "han går så wredh till Bordh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 23,
      "text": "så gaf han sin dotter bortt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 23,
      "text": "förutan hennes Egitt Iaa Ordh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 23,
      "text": ":: t. h. b. S. f. h. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 24,
      "text": "Drucke dee theras bröllop,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 24,
      "text": "uthi fulle dagar fäm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 24,
      "text": "the fruchtade alt för then wnge Her Nilss,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 24,
      "text": "att han skulle komma hem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 24,
      "text": ":: tÿ b. h. S. f. h. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 25,
      "text": "All den långe Sommer dagh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 25,
      "text": "the skenckte både Miödh och win,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 25,
      "text": "alt satt stålten Adelin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 25,
      "text": "och henne Rann tårar wpå kin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 25,
      "text": ":: t. h. b. S. f. h. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 26,
      "text": "Ståltt Adelin sitter på Bruder Benck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 26,
      "text": "hon suckar af hiärtat såå Svåra,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 26,
      "text": "gifve Gudh fader i himmelrik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 26,
      "text": "thed iag i Iorden wore,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 26,
      "text": ":: t. h. b. S. f. h. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 27,
      "text": "Togee dee den vnga Brudh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 27,
      "text": "de satte henne på högen hest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 27,
      "text": "thett war vnga dråningen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 27,
      "text": "hon Redh Bruden näst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 27,
      "text": ":: t h b s f h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 28,
      "text": "Förde dee den vnga Brudh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 28,
      "text": "vthaff her peders gårdh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 28,
      "text": "Effter Redh hennes kiäre Moder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 28,
      "text": "hon tröste henne medh orde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 28,
      "text": ":: t h b s f h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 29,
      "text": "Her Nils kåm Aff lidingen hem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 29,
      "text": "han hade warett sin herre hulldh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 29,
      "text": "dett wiste wäll vnge kongen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 29,
      "text": "hans hierta war sårge fullt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 29,
      "text": ":: t h b s f h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 30,
      "text": "Iagh haffuer warett I lidingen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 30,
      "text": "och vunett pris och ära,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 30,
      "text": "bort haffue I giffuett min festemöö",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 30,
      "text": "min Roo och all min glädie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 30,
      "text": ":: t h b s f h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 31,
      "text": "Iagh haffuer warett I lidingen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 31,
      "text": "och warett eder huldh och troo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 31,
      "text": "bårt haffue I giffuett min festemöö",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 31,
      "text": "min gläde och högsta Roo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 31,
      "text": ":: t h b s f h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 32,
      "text": "Hörer tu her Nils",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 32,
      "text": "tu sörgh icke för then,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 32,
      "text": "iagh will giffua tigh litten kierstin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 32,
      "text": "hon är skiönare än stållt Adelins fem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 32,
      "text": ":: t h b s f h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 33,
      "text": "Thett måtte han vnge her nils giöra",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 33,
      "text": "alt medh sin herres Rådhee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 33,
      "text": "feste han liten Kierstin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 33,
      "text": "förän han Redh tedan aff gårde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 33,
      "text": ":: t h b s f h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 34,
      "text": "Thett war bålde her nils",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 34,
      "text": "han Rådes wedh suener sin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 34,
      "text": "än skall iagh bede fru Adelin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 34,
      "text": "före migh bruden hem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 34,
      "text": ":: tÿ bär h s f h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 35,
      "text": "Thett war bålde her Nills",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 35,
      "text": "han beder sadle sin häste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 35,
      "text": "än skall iagh I Affton",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 35,
      "text": "den gamble greffuen geste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 35,
      "text": ":: t h b s f h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 36,
      "text": "Thett war her Nils then bålle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 36,
      "text": "han Rider vthÿ greffuens gårdh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 36,
      "text": "vthe står gamble greffuen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 36,
      "text": "han war wäll suept I mårdh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 36,
      "text": ":: t h b s f h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 37,
      "text": "I waren wäll kåmen her nills",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 37,
      "text": "I waren wälkåmen till min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 37,
      "text": "luster Eder den Brune miödh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 37,
      "text": "äller thett klara win",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 37,
      "text": ":: t h b s f h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 38,
      "text": "Iagh will Ike haffua then Brune Miödh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 38,
      "text": "Eÿ heller dett klara winn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 38,
      "text": "iagh will talla med stålt Adelin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 38,
      "text": "som för war kiäreste min",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 38,
      "text": ":: t h b s f h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 39,
      "text": "Thett war och den gamble greffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 39,
      "text": "han in I genom dören stegh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 39,
      "text": "vpstodh fru adelin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 39,
      "text": "hon Emot honom negh:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 39,
      "text": ":: t: h: b: s: f: h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 40,
      "text": "Höre I stålt Adelin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 40,
      "text": "alle kiereste min",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 40,
      "text": "haffue I dett före hört",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 40,
      "text": "här Nills haffuer fest liten kierstin:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 40,
      "text": ":: t: h: b: s: f: h: ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 41,
      "text": "Höre I Fru Adelin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 41,
      "text": "Alerkiäreste min",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 41,
      "text": "wille I migh den tiensten giöra",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 41,
      "text": "och föra hem bruden min:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 41,
      "text": ":: t: h: b: s: f: h: ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 42,
      "text": "Alt stodh stålten Adelin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 42,
      "text": "hon torde siälff intett suara",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 42,
      "text": "Iamen suara den gamble greffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 42,
      "text": "och dett skall giärna wara:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 42,
      "text": ":: t: h: b: s: f: h: ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 43,
      "text": "Inlade hon vthÿ Ett skrin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 43,
      "text": "både guldh och Edle gåffuer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 43,
      "text": "Ingen den fru till brölopett kåm",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 43,
      "text": "gaff Bruden sådana gåffuer:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 43,
      "text": ":: t: h: b: s: f: h: ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 44,
      "text": "Ingen dän fru till brölopett kåm",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 44,
      "text": "månde Bruden så för ära",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 44,
      "text": "hon gaff henne den bålle her Nills",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 44,
      "text": "som hon will nödigt vmbära:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 44,
      "text": ":: t: h: b: s: f: h: ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 45,
      "text": "Her nills han går vpå gåluedh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 45,
      "text": "han skenchte thett klara winn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 45,
      "text": "stålt Adelin sitter hoss bruden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 45,
      "text": "och fäller tårar på kin:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 45,
      "text": ":: t: h: bar: s: f: h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 46,
      "text": "vp stodh vnge kongen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 46,
      "text": "han Rächte handh I från sigh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 46,
      "text": "I kåmen hitt stålt Adelin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 46,
      "text": "I skulle dansa medh migh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 46,
      "text": ":: t h b s f h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 47,
      "text": "Så lustigt wille iagh dansa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 47,
      "text": "och giärna för eder för Eder quäda",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 233,
      "stanza_id": 47,
      "text": "men sårgin haffuer mitt hierta kråsadh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 234,
      "stanza_id": 47,
      "text": "iagh kan migh Aldrigh glädee:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 235,
      "stanza_id": 47,
      "text": ":: t: h: b: s: f: h: ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 236,
      "stanza_id": 48,
      "text": "Så giärna wille iagh dansa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 237,
      "stanza_id": 48,
      "text": "wedh eder huitta handh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 238,
      "stanza_id": 48,
      "text": "men sårgen haffuer mitt hierta kråsadh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 239,
      "stanza_id": 48,
      "text": "gudh löse wäll min tuångh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 240,
      "stanza_id": 48,
      "text": ":: t h b s f h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 241,
      "stanza_id": 49,
      "text": "Hören I stålt Adelin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 242,
      "stanza_id": 49,
      "text": "I sörgen Ike för tÿ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 243,
      "stanza_id": 49,
      "text": "iagh haffuer eder giffuett den gamble greffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 244,
      "stanza_id": 49,
      "text": "han är bätter än her Nils tre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 245,
      "stanza_id": 49,
      "text": ":: t h b sårgen för honom ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 246,
      "stanza_id": 50,
      "text": "I haffue giffuett migh den gamble greffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 247,
      "stanza_id": 50,
      "text": "han åger både slått och landh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 248,
      "stanza_id": 50,
      "text": "så kiär haffuer iagh den bålle her nils",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 249,
      "stanza_id": 50,
      "text": "Rätt aldrigh aldrigh förgiätter iagh honom",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 250,
      "stanza_id": 50,
      "text": ":: t h b: s: f: h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 251,
      "stanza_id": 51,
      "text": "Thett lider så Fast ått Affton",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 252,
      "stanza_id": 51,
      "text": "de skulle gå till senge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 253,
      "stanza_id": 51,
      "text": "her nills och ståltte Adelin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 254,
      "stanza_id": 51,
      "text": "de begÿnte på ett tall så lenge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 255,
      "stanza_id": 51,
      "text": ":: t h b s f h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 256,
      "stanza_id": 52,
      "text": "Thett war bålle her Nils",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 257,
      "stanza_id": 52,
      "text": "han tager stållt Adelin I fampn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 258,
      "stanza_id": 52,
      "text": "förlåtte Eder gudh min hiertans kiäre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 259,
      "stanza_id": 52,
      "text": "I toge Er En anan man",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 260,
      "stanza_id": 52,
      "text": ":: t h b s f h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 261,
      "stanza_id": 53,
      "text": "Min Egen Fader gaff migh bortt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 262,
      "stanza_id": 53,
      "text": "I wreden månde han thett giöra",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 263,
      "stanza_id": 53,
      "text": "då gick gläden aff mitt brÿst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 264,
      "stanza_id": 53,
      "text": "hon kåmer ther Aldrigh mera.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 265,
      "stanza_id": 53,
      "text": ":: t h b s f h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 266,
      "stanza_id": 54,
      "text": "Höre I bålle her nils",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 267,
      "stanza_id": 54,
      "text": "huadh iagh Eder seger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 268,
      "stanza_id": 54,
      "text": "iagh will lega beges wår sårgh till saman",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 269,
      "stanza_id": 54,
      "text": "och draga den så lenge iagh leffuer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 270,
      "stanza_id": 54,
      "text": ":: t h b s f h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 271,
      "stanza_id": 55,
      "text": "Wth kåm då den tärna",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 272,
      "stanza_id": 55,
      "text": "hon tallade medh stor hast,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 273,
      "stanza_id": 55,
      "text": "bruden sitter I brude sengh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 274,
      "stanza_id": 55,
      "text": "hon wänter Effter eder fast",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 275,
      "stanza_id": 55,
      "text": ":: t h b s f h ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 276,
      "stanza_id": 56,
      "text": "Han togh stålt Adelin I sin fampn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 277,
      "stanza_id": 56,
      "text": "han kallade henne sitt wif",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 278,
      "stanza_id": 56,
      "text": "En tidh fören minatt kåmer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 279,
      "stanza_id": 56,
      "text": "latter iagh för eder mitt liff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 280,
      "stanza_id": 56,
      "text": ":: t h b s ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 281,
      "stanza_id": 57,
      "text": "Her nils bleff dödh I brude huss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 282,
      "stanza_id": 57,
      "text": "vpå brudens arm",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 283,
      "stanza_id": 57,
      "text": "stålt Adelin bliff dödh I fru stuffun",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 284,
      "stanza_id": 57,
      "text": "de fruger till sårgh och harm:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 285,
      "stanza_id": 57,
      "text": ":: t: h: b: s: f: h: ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 286,
      "stanza_id": 58,
      "text": "Arle wart thett om mårgon",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 287,
      "stanza_id": 58,
      "text": "dett dager han bleff lius",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 288,
      "stanza_id": 58,
      "text": "så hårde woro de thidene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 289,
      "stanza_id": 58,
      "text": "ther kåme för kåningens huss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 290,
      "stanza_id": 58,
      "text": ":: t: h: b: s: f: h: ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 291,
      "stanza_id": 59,
      "text": "Hårde kåme the tidene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 292,
      "stanza_id": 59,
      "text": "the kåme alt så bråt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 293,
      "stanza_id": 59,
      "text": "att her nils och stålten Adelin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 294,
      "stanza_id": 59,
      "text": "bleffue döde then same natt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 295,
      "stanza_id": 59,
      "text": ":: tÿ hon bär sårgen för honom ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 296,
      "stanza_id": 59,
      "text": "Ende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 297,
      "stanza_id": 59,
      "text": "gudh oss sin nåde sende",
      "part": false,
      "marginal_notes": []
    }
  ]
}