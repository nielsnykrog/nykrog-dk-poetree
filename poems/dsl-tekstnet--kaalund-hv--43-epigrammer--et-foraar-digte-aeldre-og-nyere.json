{
  "id": null,
  "title": "43. Epigrammer",
  "year_created": 1858,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Vilhelm Kaalund",
    "country": null,
    "wiki": "Q2362214"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Et Foraar. Digte, Ældre Og Nyere",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1858,
    "url": "https://tekstnet.dk/books/kaalund-hv_et-foraar/042/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Naar Du er dum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "da vær blot stum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "men med en kritisk Mine -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "strax gyser Hver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "som til Dig sér,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "og tænker Død og Pine!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "\"Jeg\", raabte Vintren, \"klæder Jorden af",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "og frem den nøgne Sandhed viser.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Men mildt til Gjensvar Vaaren gav:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "\"Jeg dækker kjærligt Jordens Grav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "og derfor Skabningen mig priser.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "O Pige! jeg vil ikke sé,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "hvordan din Hat kan klæde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "men vel, om Du med Aand kan lé",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "og kan med Hjerte græde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Den Mand er ikke stort bevendt, som praler af sin Hjerne;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "det er jo kun den skrumpne Nød, som rasler med sin Kjærne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Natur, hvor lidt har Mennesket Du paa dets Vandring givet!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Den plumpe Bjørn Du knapper selv en Foerværkspels om Livet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "paa Faarets Fødder trækker Du de varme uldne Strømper",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "og giver Saal til Hestens Sko; men hvad fik jeg, jeg Stymper?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "Jeg Støvler kjøbe maa samt Sko, om Hatten ej at tale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "og bøde selv med Kjoleskjød paa Mangelen af Hale;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "I, Faar og Heste! har den frit, hvor jeg misunder Eder -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "Her har en Regning jeg igjen nu faaet fra min Skræder!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "Af Recensent faar man Navnet nu,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "naar man kan skrive: Dit Fæ!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "Til Fejekost kan det Smaakrat due,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "som ej har Marv til et Træ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "Ja, Stof til Sang har hver en Tid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "mens Lys og Skygge parres,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "om ej ved sine Heltes Strid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 0,
      "text": "saa dog ved sine Narres.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 0,
      "text": "Tag denne farvede Devise,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 0,
      "text": "et Billed paa den nye Poesi:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 0,
      "text": "Først maa Du Skallens ydre Melpap spise,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 0,
      "text": "og saa, saa ligger Tanken indeni.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 0,
      "text": "\"Jeg\", raabte højt en Skralde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 0,
      "text": "og overdøved Alle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 0,
      "text": "\"gjør selv den Vise tavs!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 0,
      "text": "Hvad melder Du da, Kjære;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 0,
      "text": "det maa vel Perler være?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 0,
      "text": "Lad sé - da var det Snavs.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 0,
      "text": "Et Sildehoved i Mørket laa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 0,
      "text": "og fryded med Glandsen nogle Smaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 0,
      "text": "Ej, raabte de, hvilket prægtigt Skin!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 0,
      "text": "Saa bar de det Hoved i Stuen ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 0,
      "text": "men ved de flammende Kjerter dér",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 0,
      "text": "det lyse Hoved ej lyste mér.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 0,
      "text": "Lér jeg af Hjertet med Dig, jeg kunde bevæget dog græde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 0,
      "text": "brister i Graad jeg med Dig, da funkler mit Øje af Glæde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 0,
      "text": "det er din uhyre Kraft, som Skyggen og Lyset omfatter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 0,
      "text": "bøjer min Alvor til Smil og smelter i Taarer min Latter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 0,
      "text": "Hel sælsomt det i Verden gaar -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 0,
      "text": "Forundring hos Beundring staar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 0,
      "text": "Hvad af de to Du vækked mest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 0,
      "text": "det har jeg aldrig rigtig vidst!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 0,
      "text": "En Digter sang: Hvor Smaa kan være store!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 0,
      "text": "Men sér jeg Dig i al din Storhed staa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 0,
      "text": "og saare Hjertet for med Vid at more,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 0,
      "text": "jeg synger: Ak, hvor Store tidt er smaa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 0,
      "text": "Schack Staffeldt, de dybeste drømmende Savn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 0,
      "text": "Du nævner med sølvklare Toner ved Navn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 0,
      "text": "Man kalder Dig mystisk og ej populær -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 0,
      "text": "Naar gik det ej saadan det Himmelske her!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
