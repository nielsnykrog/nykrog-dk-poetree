    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVI62.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Der boer en rider",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "wed Torne-led,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "och hand haffuer sig en dater,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "hund haffuer hindis tro bort-iedtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: Y-huor tho siellenn der di findis. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Dett war herre Arland,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "hand beder sadell sind heste:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "\"Och wy will ryde oss op att landit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "herre Torbenn will wi geste!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Dytt war herre Arland,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "hand kam der ridendis i gorde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "ude stoer herre Torbenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "hand var well suøbyn udi mord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Der di kom y gorden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "der axeller di deris skind;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "saa gaar di i stouenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "allt for her Torbenn ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "\"Her sider y, herre Torbend!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "allt offuer eders brede bordt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "will i mig eder datter giffue?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "i vyder mig andit suar ord!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "\"Och ingenn dotther haffuer ieg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "der manden-woxen er,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "for-uden Gierde-borrig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "hund haffuer hindis tro bort-iett.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Dytt war herre Arlland,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "och sin suerd ud-drog;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "dit war herre Torbenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "hand hoffdit fraa hanem hug.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Saa tog hand liden Gierde-borrig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "løffte hinder opaa sin høffue hest;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "saa førde hand hinder ouen skoffuen ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "som tyckonitt vor alle-miest.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Dytt war hindis syu brøder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "di kam fraa skolle hiem;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "och dytt wor deris kiere moder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "kam gangende denem gredendis i-genn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "\"Hør y det, mine syu sønner!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "haffuer y dytt icke føre hørt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "eders fader er mett vaben wyett,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "eders søster er med wold bort-førdt!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Saa gange dy y høffue-lofftt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "dy lader dennom klæder skiere;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "saa gaar dy y-gemmell synn kongers riger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "allt for di kunde deris søster oplede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Saa gaar dy thill denn hiorde-sønn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "hand gick och wocktit fee:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "\"Wyser oss nogenn i dene by,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "der oss giffuer øll och mad!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "\"Her boer herre Arland,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "hand haffuer saa god en konne;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "hindis fader er mett wabenn wyett,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 12,
      "text": "hund er med wolld bort-førdt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "Der dy kom y gordenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "der axeller di deris skiend;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "saa gaar di y stoffuen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 13,
      "text": "for her Arland ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "\"Her syder y, herre Arland!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "alltt offuer eders brede bord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "will y lonne oss hus y-nat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 14,
      "text": "y wyder oss andit suar ord!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "\"Ieg vill giffue eder øll och mad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "saa megit som y kunde there;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "her pleer alldrig nogen piellegrim",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 15,
      "text": "her om natten at were.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "Dytt war lyden Gierde-borrig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "hund kiende dennom paa deris moell:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "\"Min kiere her Arland, y lonner dennom hus",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 16,
      "text": "alltt for min faders død!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "\"Allt will ieg giøre for min hostruis hindis skylld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "och lone eder hus y-nat;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "y skynder eder snarligen aff min gord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 17,
      "text": "før sollen skienner halld!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "Och dit daa suarede den ungeste broder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "och hand suarede for dem alle:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "\"Alltt skall y lade oss soffue vor morgens-søffuen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 18,
      "text": "till solen skiener offuer oss alle!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "Saa druck di her Arland drucken,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "saa fulle dy hanem at soffue;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "liden Gierde-borrig och hindis broder syu",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 19,
      "text": "dy holldit den rus i stoffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "\"Hør du, lidenn gierde borrig huad ieg siger dig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "tøckis dig icke were stoer kuide:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "du leger din faders banne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 20,
      "text": "huer nat ved din side?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 21,
      "text": "Hør du, liden Gierdeborrig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "tøckis dig icke were stor harm:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 21,
      "text": "du leger din faders banne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 21,
      "text": "huer nat i din arm?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 22,
      "text": "\"Hører y, herre Arland!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 22,
      "text": "huad ieg siger eder?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 22,
      "text": "alltt er ditt mine brødre siu,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 22,
      "text": "y lonthe y-affthis hus!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 23,
      "text": "\"Och er dit dine brødre siu,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 23,
      "text": "ieg lonte y-affthis ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 23,
      "text": "daa haffuer ieg och siu brødre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 23,
      "text": "dy boer her nest om-kring.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 24,
      "text": "Daa troer ieg opaa min gode suerd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 24,
      "text": "och sa mine brynnie nye",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 24,
      "text": "och siden opaa min brødre siu,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 24,
      "text": "som boer her westen i bye!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 25,
      "text": "Saa tog di her Arland",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 25,
      "text": "y hans gulle lock;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 25,
      "text": "saa hog dy hanem hoffdit fraa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 25,
      "text": "alltt offuer hans senge-stock.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 26,
      "text": "Saa tog dy liden Gierde-borrig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 26,
      "text": "satte hinde paa høffuer hest;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 26,
      "text": "saa førde dy hinde thill-bage i-genn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 26,
      "text": "allt som dy kunde aller-best.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 26,
      "text": ":: Y-huor tho siellen der dy findis. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}