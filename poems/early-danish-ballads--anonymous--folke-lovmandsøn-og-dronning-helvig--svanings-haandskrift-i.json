{
  "id": null,
  "title": "Folke Lovmandsøn og Dronning Helvig",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift I",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVI56.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Falquor hand tiener y Kongens gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "alt | bode for heder och ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "och Fruer och Iomfruer | the onte hannem vell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Ieg siger dig Falquor | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: du skallt aff landen rømme. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Fruer och Iomfruer the onte hannem vell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "the | haffde hannem iderlig kier,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "och mest hin Drotning frue Helleuig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "hun vnte hannem allt | som best.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": ":: ÿ | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Lenge stod Danner Konning",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "och tenckte hand | ved sig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "och hui monne Falquor Lagmansøn |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "de fruer saa iderlig kiende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": ":: Ieg siger dig falquor | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": ":: du skalt ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": ":: ÿ | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "Suarit ther till en liden smaa dreng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "och med stor | møgin vsnilde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "och hand kiende hannem saa oent | yt raad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "och ther met giorde hand ilde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": ":: Ieg siger. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "Tager y Falquor Lagmansøn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "och setter hannem y | horden iern,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "och saa fanger y the fruer atth see, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 4,
      "text": "som falquor hand haffde saa kier.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 4,
      "text": ":: Ieg siger | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "Falquor hand ganger y Fruer stuffue ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "allt | huad som giort wor før,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": "och saa fick hand | the tiner atth høre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 5,
      "text": "som hand ilde behagde. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "Thet vor Falquor Logmanssøn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "hand ind ath | døren tren,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": "och alle fruer och Iomfruer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 6,
      "text": "the stander | hannem op igien. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "Helszer hand fruer och Iomfruer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 7,
      "text": "allt som | hand kunde best,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": "och mest hin Drotning frue | Helleuig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 7,
      "text": "hand haffde vthi hiertet kier.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 7,
      "text": ":: Ieg. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 8,
      "text": "Ind kom liden smaa dreng",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 8,
      "text": "och steddis hand | for boer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 8,
      "text": "och hand vor snild vthi sin tunge, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 8,
      "text": "hand kunde vell føie sin ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 8,
      "text": ":: Ieg. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 9,
      "text": "Helsset hand Falquor Logmandszøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 9,
      "text": "y ere vell | suøpt vthi skind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 9,
      "text": "och y skulle ind till nyborrig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 9,
      "text": "och | saa bad herre min. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 10,
      "text": "Skall ieg ride till Nyborg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 10,
      "text": "alt som min herre | mig beder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 10,
      "text": "saa men y Drotning Frue Helleuig |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 10,
      "text": "vi findis ret aldrig mere. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 11,
      "text": "Och thet vor Falquor Logmansøn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 11,
      "text": "och hand till | Nyborrigh kom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 11,
      "text": "och sette the hannem y horden | iern",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 11,
      "text": "och saa y horden bond.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 11,
      "text": ":: Ieg siger. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 12,
      "text": "De spente halsziern om hans halsz",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 12,
      "text": "och horde | bond allt om hans fødder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 12,
      "text": "och huad haffuer iegh | her till brøtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 12,
      "text": "allt enten metz gierning eller metz | ord. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 13,
      "text": "Suarit ther till hin lidell smaadreng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 13,
      "text": "allt met | saa megen vsnilde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 13,
      "text": "och thet er for Drotningh frue | Helleuig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 13,
      "text": "y haffuer formøgit kier. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 14,
      "text": "Hielpe mig Gud som offuer mig er",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 14,
      "text": "paa kaarset tholde død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 14,
      "text": "men Drotningh Fru Helleuig vor | aldrig dig verre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 14,
      "text": "at ieg vor nogen tid født. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 15,
      "text": "Thet vor Falquor Logmanszøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 15,
      "text": "hand glemmer | huerken tuct eller sinde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 15,
      "text": "y sige Drotning Helleuig | tusind gode nath,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 15,
      "text": "hendis møer och alle hendis quinder |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 16,
      "text": "Siger Drotning Helluig gode nath,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 16,
      "text": "hindis møer | och alle hendis quinder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 16,
      "text": "men skall ieg lade mit | vnge liff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 16,
      "text": "thet giører ieg nu hellst for hende. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 17,
      "text": "Konken hand lader en thønne giøre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 17,
      "text": "mett huasze | iern kniffue at staa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 17,
      "text": "och thet motte Falquor Logmandszøn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 17,
      "text": "allt leffuendis giennem gaa. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 18,
      "text": "Thet vor Drothning Fru Helleuig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 18,
      "text": "hund | kaller ath suenne tho",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 18,
      "text": "och vi vill ride till Ny | borrig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 18,
      "text": "och see huor Falquor hand maa. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 19,
      "text": "Thet vor Drothningh Fru Helleuigh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 19,
      "text": "hun | hørde the klogker ringe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 19,
      "text": "och aldrig fick ieg en | større sorrig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 19,
      "text": "siden ieg till Danmarck kom. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 20,
      "text": "Ingen Ridder y Danmarck",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 20,
      "text": "monne saadan en | fare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 20,
      "text": "och thet vor Drothning fru Helleuig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 20,
      "text": "hun | sielff for boren monne gaa. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 21,
      "text": "Thet vor Drothning Fru Helleuig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 21,
      "text": "hun sette | sig paa hans graff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 21,
      "text": "thuszen marck aff thett | røde guld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 21,
      "text": "hun for hans siell vdgaff. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 22,
      "text": "Och thet vor Drothning frue helleuig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 22,
      "text": "hun kom | ther ridende y gaard",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 22,
      "text": "vde da star Danner Konning",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 22,
      "text": "hand vor vell suøpt vdi moer. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 23,
      "text": "I vere vell kommen Fru Helleuig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 23,
      "text": "hui haffuer ethers øgen saa runde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 23,
      "text": "och haffuer y verit | till Nyborrig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 23,
      "text": "och haffuer y falquor fundit. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 24,
      "text": "Hun suor bode om Siell och liff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 24,
      "text": "och alt hun | suere kunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 24,
      "text": "men skall ieg lade mit vnge liff, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 24,
      "text": "thet giør iegh helst for hannem. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 25,
      "text": "Fast minder hun loe, faste mere hun gred, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 25,
      "text": "dis større vor hendis quide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 25,
      "text": "den første nat hun | hosz Kongen laae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 25,
      "text": "hun døde hosz hans side.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 25,
      "text": "Ieg | siger dig falquor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 25,
      "text": "du skallt vd aff landit rømme. |",
      "part": false,
      "marginal_notes": []
    }
  ]
}