{
  "id": null,
  "title": "Tovelilles Dands",
  "year_created": 1861,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Carsten Hauch",
    "country": null,
    "wiki": "Q688529"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Valdemar Atterdag",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1861,
    "url": "https://tekstnet.dk/books/hauch-c_valdemar-atterdag/005/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Den høie Dør sig aabned, Kong Volmer fremtreen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Og skjøndt han ei var smykket med Guld og Ædelsteen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Han ligned dog en Konning, som Ild var hans Blik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "De Fruer og Jomfruer neied, hvorhen den Herre gik.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Ham fulgte tredive Hofmænd, der lytted til hans Røst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Om Armene bar de Ringe, dem skinned Guld paa Bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Foran den ædle Marskalk løfted en gylden Stav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Da Mængden veg tilside som et bølgende Hav.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Med mangen ædel Ridder talte den Herre god.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Da Tovelil ham skued, hun rødmed som Blod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Hun traadte langt tilbage, dog mødtes deres Blik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Det var som et Solstik, der hurtig kom og gik.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Kong Volmer førte Talen med megen Kløgt og Snilde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Snart traf hans Ord som Pile, snart som en venlig Kilde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "De risled mellem Blomster, han syntes vel tilfreds,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Han satte sig blandt Ridderne, de stod om ham i Kreds.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Mæled da Ridder Folkvar, han stod ved Kongens Stol:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "»Der kommer Dronning Helvig, hun skinner som en Sol,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Med alle sine Jomfruer hun sagtelig fremskrider,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Det er som et Tryllenet, der gjennem Hallen glider.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "See, min Drot, hvor fagert Guldkronen hende klæder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "De Ædelstene glimte, hvorhen den Frue træder;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Kappen af røden Fløiel er rigt med Guld belagt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "Aldrig nogen Dronning var klædt i større Pragt.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Da tænkte Volmer Konge, dog sagde han det ei:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "»Hist skuer jeg en Jomfru, heel langtfra Helvigs Vei,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Hun vænere maatte tykkes, selv om hun var død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "End den iiskolde Dronning med sin Guldkrone rød.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "Pludselig han sig reiste, han treen i Hallen ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Ham ingen Hofmand fulgte, heel iilsomt frem han skred,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "Indtil han naaede Pladsen, hvor Tovelille stod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "Nysgjerrig Mængdens Blikke fulgte den Herre god.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "Den Lilievand sig neied, han traadte hende nær",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Og sagde: »Følg mig efter, min Jomfru fiin og skjær!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "Nei, frygt kun ingen Fjende, Du har en trofast Ven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "Der vel Dig kan forsvare, hvor Du vender Dig hen.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "Saa fulgte hun den Herre med nedslagne Blik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "De Ungersvende sukked, hvorhen den Jomfru gik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "Men Kongen iled fremad, han standsed ei, før",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "Han naaede Dronning Helvig med alle hendes Møer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "Mæled da Kong Volmer med stolt og dristigt Mod:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "»Her bringer jeg en Jomfru af det ædleste Blod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "For Dyd hun vidt berømmes og for høviske Sæder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "Fuldelig hun fortjener, at I viser hende Hæder.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "Da sagde Dronning Helvig: »I er mig kjær at see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Hvad Kongen befaler, det bør bestandig skee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "Ofte han rider ene med Falk og med Hund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "Jeg hører, han har mødt Jer alt i den Bøgelund.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "Af Guld en vægtig Kjæde hun tager af sin Arm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "Og selv hun den hænger om Tovelils Barm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "At sidde ved sin Side Fru Helvig hende bad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "Dog vendtes hendes Venskab tilsidst til bittert Had.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 13,
      "text": "Fru Helvig sig reiser, hun frem i Dandsen gaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "Nær hende dandser Tovelil med guldfagert Haar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "Som en svævende Fugl hun i Dandsen monne glide;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "Tilsidst hun dog standsed ved Konning Volmers Side.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "Der blev en vældig Trængsel, hvor hun i Dandsen gik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Der brændte mangt et Hjerte, hvor hun vendte sit Blik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "Da hørtes der en Hvisken: »Det er som Vindens Gang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "Naar den leger med Duggen og Græsset paa Vang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 15,
      "text": "Ret aldrig saae man Øine med saa selsom en Glands,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "Og aldrig nogen Jomfru, der gik saa let i Dands.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "- »Ja«, svared en gammel Kæmpe, han støtted sig til Sværd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "»Langt meer end noget Kongespiir er saadan Jomfru værd.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 16,
      "text": "Da sagde Ridder Vendelbo, han saae til Dandsen hen:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "»Vi trænger ei til Dandsere, men vel til stærke Mænd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "Og sværdvante Kæmper, af dem har vi kun Faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "Og stedse blive de færre, medens Tiderne gaae.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 17,
      "text": "Spurgte da Dronning Helvig, hun hvilende sad:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "»Hvi er der saadan Trængsel om de Dandsendes Rad?«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "Gjensvared en Terne: »De see paa Tovelil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "Hvor let hun kan sig vende ved Sang og Strængespil.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 18,
      "text": "Det er, som naar om Natten i Fuldmaanens Skjær",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "De Elverpiger dandse bag Krat og bag Træer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "Og dreie sig som Taager, der jages af Vind.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "Det hørte Dronning Helvig med tankefuldt Sind.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
