  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Ieg oc Anul, myn suskenæ barn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "wij trætte om Danmarks rigæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Hwer for andhen sættæ wi wore garn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "I tij aar fullæ, tha hade wij krij",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "alt thet menegæ rygæ tijl skade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Eth eneste aar wore wi ey fry",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "ath wi ey orloff hade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "meth deylighe men och wæne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Wi bleffue ther slaffne then samme daw",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "meth elluffuæ twsende swæne.",
      "part": false,
      "marginal_notes": []
    }
  ]
}