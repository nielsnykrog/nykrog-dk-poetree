  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Herre/ En Fader oc Gud offuer mit leffnit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Giff mig icke øynes hoffmod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "men vend fra mig all ond begiæring/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Borttag fra mig Brugens attraa och velløst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Och lad icke Legemens begiæringe behegte mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Och giff mig icke ith whørsomt sind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "oc wblut ansigt.",
      "part": false,
      "marginal_notes": []
    }
  ]
}