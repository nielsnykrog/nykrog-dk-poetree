  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Helge",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1814,
    "url": "https://tekstnet.dk/books/oehlenschlaeger-a_helge/002/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 21,
      "text": "Tys! hørte Du dem træde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 21,
      "text": "Paa Græssets Tørve?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 21,
      "text": "Hvis Frode Døren finder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 21,
      "text": "Vort Blod maa flyde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 21,
      "text": "Mit lidet Sværd, min Skimring",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 21,
      "text": "Skal tappert stride.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 21,
      "text": "Vor Banemand skal bløde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 21,
      "text": "Før Helge blegner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 21,
      "text": "Ak, saaest Du, Moder kiære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 21,
      "text": "De Sønners Qvide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 21,
      "text": "I Gravens Giemme blandte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 21,
      "text": "Sig Graad med Asken!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 21,
      "text": "Tænk, da den tappre Fader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 21,
      "text": "Faldt uden Taarer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 21,
      "text": "Og reed til Odins Rige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 21,
      "text": "Paa røden Sleipner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 21,
      "text": "Her sidde vi saa stille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 21,
      "text": "To Kongesønner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 21,
      "text": "Ved lidet Bord, hvor Lampen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 21,
      "text": "I Hulen lyser.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 21,
      "text": "Den Tid vil ogsaa times,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 21,
      "text": "Da vi skal tielde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 21,
      "text": "De hvalte Kongesale",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 21,
      "text": "Med lysen Silke!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 21,
      "text": "Da skal vi enigt styre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 21,
      "text": "Det stolte Rige;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 21,
      "text": "Og ei, som Frode, feide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 21,
      "text": "Med egne Frænder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 21,
      "text": "Jeg seiler vore Snekker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 21,
      "text": "Paa Søens Vover;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 21,
      "text": "Og hævder Danmarks Hæder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 21,
      "text": "Paa alle Have.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 21,
      "text": "Jeg kneise vil med Kronen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 21,
      "text": "Ved Leirekilder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 21,
      "text": "Og holde Ret i Riget",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 21,
      "text": "Og reise Staden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 21,
      "text": "Nu Faren er forsvunden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 21,
      "text": "Og borte Frode!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 21,
      "text": "Jeg hørte Vifil Hornet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 21,
      "text": "Med Haan at blæse.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 21,
      "text": "Han aabner Lugen. Lyset",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 21,
      "text": "Fra Luften blaaner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 21,
      "text": "Nu Græsset os og Grenen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 21,
      "text": "Fra Graven vinker!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 38,
      "text": "Helge jeg græder, Du spotter og leer.",
      "part": false,
      "marginal_notes": [
        "Speaker: HROAR"
      ]
    },
    {
      "id": 45,
      "stanza_id": 38,
      "text": "Signe min Syster jeg dagligen seer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 38,
      "text": "Tør ikke tale, for Signelil staae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 38,
      "text": "Men kun som Hyrde paa Grønningen gaae!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 39,
      "text": "Vidste Du, Signe, som har os saa kiær;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 39,
      "text": "Vidste Du Hroar og Helge var nær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 39,
      "text": "Ikke saa tit med en svulmende Barm",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 39,
      "text": "Sadst Du og støtted dit Hoved til Arm!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 40,
      "text": "Ofte, naar Sævar indbyder til Fest;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 40,
      "text": "Rider til Borgen den hielmede Giæst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 40,
      "text": "Stolt paa sin Ganger, saa mægtig og fri",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 40,
      "text": "Klædt i sit Harnisk vor Hytte forbi;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 41,
      "text": "Medens som Trælle vi skamfulde staae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 41,
      "text": "Med vore Hætter af Geddeskind paa;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 41,
      "text": "Aabne ham Ledet, og lukke det til;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 41,
      "text": "Høre kun langtfra det klingende Spil! -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 42,
      "text": "Helge! da ønsker jeg tit mig til Hæl.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 42,
      "text": "Heller dog død, end en ynkelig Træl!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 42,
      "text": "Heller i Graven, end levende død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 42,
      "text": "Haanes, og trælle for Vand og for Brød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 43,
      "text": "Hroar min Broder! Du skiælder din Dragt?",
      "part": false,
      "marginal_notes": [
        "Speaker: HELGE"
      ]
    },
    {
      "id": 65,
      "stanza_id": 43,
      "text": "Elsker som Qvinden Du Flitter og Pragt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 43,
      "text": "Skindet er stivt, af umageligt Maal?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 43,
      "text": "Vel Dig! det vænner til Kobber og Staal!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 44,
      "text": "Hroar Du vrager vellystig Din Mad?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 44,
      "text": "Ønsker, som Bonden, det spækkede Fad?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 44,
      "text": "Skamme Dig maatte Du; giør mig ei rød!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 44,
      "text": "Knoklerne styrkes af Vand og af Brød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 45,
      "text": "Snart skal vi hævne paa Frode vor Spot.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 45,
      "text": "Nøden opdrager en Skioldunge godt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 45,
      "text": "Drengene vogte spagfærdige Faar;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 45,
      "text": "Drotten at ave de Kæmper forstaaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 46,
      "text": "Sævar maa prøves. End kan vi et Aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 46,
      "text": "Dræbe ham Ulven, og vogte hans Faar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 46,
      "text": "Senerne hærdes, og Solen giør bruun,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 46,
      "text": "Snart er vor Hage bedækket med Duun.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 47,
      "text": "Signe vor Syster vi dagligen see:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 47,
      "text": "Armen er trind, som af krystede Snee;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 47,
      "text": "Barmen er svulmende, Kinden er rød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 47,
      "text": "Skiøndt hun begræder vor tidlige Død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 48,
      "text": "Signelil trives uagtet sin Sorg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 48,
      "text": "Har hvad hun ønsker: En Mand og en Borg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 48,
      "text": "Det tør jeg sværge: Naar intet hun veed -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 48,
      "text": "Ei hun forraader vor Hemmelighed!",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
