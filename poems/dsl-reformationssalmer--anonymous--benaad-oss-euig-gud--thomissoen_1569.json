  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Benaad oss euig Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "som haffuer alle helgen naaden teed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Frelss du oss O Jesu/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "for huilcke du bleffst til kaarssit leed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Lad oss gaa til all godheds Kilde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "lad oss en ren samuittigheds øyen stille paa din velde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "lad oss din Vissdoms drick der faa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "aff huilcken vor hu kand den euig Liffs smag forstaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Lad oss ret Christendoms tro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "beuise/ met Kierligheds gierninger mod vor Nabo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "oc siden met en Christelig affgang/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "komme til dig vor Fader fra all tuang.",
      "part": false,
      "marginal_notes": []
    }
  ]
}