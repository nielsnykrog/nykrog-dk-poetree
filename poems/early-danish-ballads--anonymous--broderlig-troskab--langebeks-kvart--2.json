    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/LNGK80.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Dett War Wngenn herre karll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hannd Wille | aff landenn faare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "hann fick herre Tor sin | Broder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "hans fester-møøe ath for-ware",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: sin | Iomfrue for-glemmer hann Aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Hørdu herre Tor kiere Broder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Ieg throer | dig aller-Best",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Ieg Befaler dig min kiere | feste-møøe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "hun er mig aller-kierist:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": ":: s: I: f: h: a | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Willthu hinde Worde och gemme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Medenn Ieg | far mig aff lann",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Ieg Well hende aldrig for-glemme |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "før Ieg kommer hiem igen:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": ":: s: I: f: h: A | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Saa Well schall Ieg hende Wockte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "saa well skall | Ieg hende gemme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "saahender schall ingen ander | faa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "føre du kommer selluer hiem:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": ":: s: I: f: h: A | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "Ieg Well hende full-well Wogte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "Ieg well hende | full-well giemme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "saa hun faar Ingen anden | suen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "Alle om mig winder liffuett:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": ":: s: I: f: h: A: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "Dett War Wngenn herre karll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "hann foer | aff landen wd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "effter sad hans feste-møø",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "med | lengells och sorge-full hoff:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": ":: s: I: F: h: A: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "Hann hagde icke aff landenn Werett",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "for-wdenn enn stackett tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "dett spurde herre tide-Mand |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": "han ackted ath gøre hannom suig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 6,
      "text": ":: s: I: f: h: A: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "Dett War herre tide-Manndt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 7,
      "text": "handt Beder | sadell hest",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": "Ieg well ride Op ath land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 7,
      "text": "her karll hans Iomfru ath fest:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 7,
      "text": ":: s: I: F: h: A: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 8,
      "text": "Dett War herre tide-Mandt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 8,
      "text": "hann kom ther | ridenn wdj gaardt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 8,
      "text": "wde stod Iomffruens fader |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 8,
      "text": "hann waar well suøbt ÿ maar:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 8,
      "text": ":: s: I: F: h: A: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 9,
      "text": "Her stander ÿ herre peder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 9,
      "text": "ÿ ere enn mann sa | finn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 9,
      "text": "ÿ giffuer mig lidenn kierstinn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 9,
      "text": "thill kiere | høstru Minn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 9,
      "text": ":: s: I: F: H: A | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 10,
      "text": "Dog Ieg giffuer eder Minn datter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 10,
      "text": "daa Maa ÿ | icke hennder haffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 10,
      "text": "Ieg haffuer giffuett | hende hinn wnge her karl",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 10,
      "text": "han er aff landen dragen:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 10,
      "text": ":: s: I: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 11,
      "text": "Ieg haffuer giffuett hinde hinwnge her karll |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 11,
      "text": "hann er aff landenn Dragen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 11,
      "text": "dett Ieg gaff hannom | Min daater",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 11,
      "text": "dett anger mig alle min dage:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 11,
      "text": ":: s: I: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 12,
      "text": "Saa Well kinder Ieg hinn wnge herre karll |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 12,
      "text": "Ieg Well hannom aldrig for wige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 12,
      "text": "giffuer | ÿ Miig eders datter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 12,
      "text": "om Ieg maa were hindis lige:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 12,
      "text": ":: s: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 13,
      "text": "Frem gick herre peder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 13,
      "text": "hann war enn mandt | saa Braad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 13,
      "text": "gaff hann Bortt sinn datter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 13,
      "text": "han | sporde hinne intte till raadt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 13,
      "text": ":: s: I: F: H: A | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 14,
      "text": "Ind kom hindis Moder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 14,
      "text": "och sagde hinde dise ordt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 14,
      "text": "dinn fader haffuer dig herre thide-mand | giffuett",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 14,
      "text": "han er enn reder saagod:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 14,
      "text": ":: s: I: F: H: A: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 15,
      "text": "Dett suarett Lidenn kiersten",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 15,
      "text": "Medtt angest | och sorgerfull hoff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 15,
      "text": "huad skall Ieg thaa herre | Karll suare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 15,
      "text": "som Ieg haffuer giffuett min tro |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 16,
      "text": "Herre karll er aff landenn wde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 16,
      "text": "du ser hannom | aldrig Mere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 16,
      "text": "her thide-man haffuer Baade | slott och feste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 16,
      "text": "han kan dig holde medt ere |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 17,
      "text": "Ieg agter icke om herre thide-mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 17,
      "text": "icke heller | hans møgle rige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 17,
      "text": "Minn fader gaff mig hin | Wnge herre karll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 17,
      "text": "Ieg will hannom aldrig suige |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 18,
      "text": "Lidenn kierstinn kann huerkenn ede eller dricke |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 18,
      "text": "saa Mange-full er en hendis quide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 18,
      "text": "før hun | fick ett lønn-lig Bod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 18,
      "text": "her thor de thidenn ath sige |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 19,
      "text": "Dett war lidenn kierstinn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 19,
      "text": "hun sennder her | thor saa Bod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 19,
      "text": "min fader haffuer mig her | thide-mand giffuett",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 19,
      "text": "dett er mig saare emod |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 20,
      "text": "Du Bed her tord thencke ther-paa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 20,
      "text": "allt huad | han loffuett sinn Broder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 20,
      "text": "om hann kan finde | nogenn god raad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 20,
      "text": "och skelle mig wed denne wande |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 21,
      "text": "Dett suared wngen herre tor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 21,
      "text": "ther han de tiding | saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 21,
      "text": "well thet gudt Ieg leffue maa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 21,
      "text": "han skall | hinder aldrig Faa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 21,
      "text": ":: s: I: F: h: A: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 22,
      "text": "Bed hinde Baade æde och Drigke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 22,
      "text": "och were ÿ hiertid | frj",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 22,
      "text": "Ieg skall hinde wed thenn angest skelle |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 22,
      "text": "allt om mig winder liffuett |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 23,
      "text": "Kommer Ieg icke om løffuer-dagenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 23,
      "text": "daa er Ieg | Megett senn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 23,
      "text": "thaa skall Ieg komme om søndag | afften",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 23,
      "text": "och føre hannom Bruden hiem |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 24,
      "text": "Rede de thill Brøllup",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 24,
      "text": "i fulle dage Nÿ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 24,
      "text": "alle sad | Brudenn sorige-full",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 24,
      "text": "ÿ alle sammen Dj",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 24,
      "text": ":: sinn | Iomfru for-glemer hann aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 25,
      "text": "Alltt sad Brøllops-folckett",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 25,
      "text": "saa glade offuer dett | Bordt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 25,
      "text": "dett war Wngenn herre tor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 25,
      "text": "hann kom | I denn Brøllups-gaar:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 25,
      "text": ":: s: I: for: g: h: A | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 26,
      "text": "Slagenn Bleff herre thide-Mann",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 26,
      "text": "dett war | enn øncke-lig fær",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 26,
      "text": "fangenn Bleff Wngenn | herre tor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 26,
      "text": "dett hagde hann werett wuerdt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 27,
      "text": "Saa thog the herre thide-Mans lig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 27,
      "text": "och lagde dett | paa Baar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 27,
      "text": "saa thogde wngenn herre tor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 27,
      "text": "de | satte ham ÿ haardenn Iernn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 27,
      "text": ":: s: I: f: h: A: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 28,
      "text": "Brudenn seder paa Brude-Benck",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 28,
      "text": "hunn greder | aff stor nød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 28,
      "text": "hun gred Mer for herre tor er fangen |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 28,
      "text": "enn for her tide-Mans døtt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 28,
      "text": ":: s: I: f: h: A | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 29,
      "text": "Dett Meller Brudens Moder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 29,
      "text": "med sorg och megen | Meen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 29,
      "text": "spender wÿ heste for karmme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 29,
      "text": "med sorig | faar wÿ hiemm:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 29,
      "text": ":: s: f: h: A: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 30,
      "text": "Dett suarett Brudens moder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 30,
      "text": "ÿ raad waar | hun eÿ senn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 30,
      "text": "Enn haffuer Ieg enn anden | sønn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 30,
      "text": "wÿ giffuer hende Bruden igen |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 31,
      "text": "Wdj gaar waar Ieg enn unge Brud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 31,
      "text": "ÿ dag | enn sorig-full encke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 31,
      "text": "Ieg well Icke saa wde | arruff gaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 31,
      "text": "ÿ thør thett aldrig thencke |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 32,
      "text": "Dett suarett hindis fader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 32,
      "text": "han war en man | saa haard",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 32,
      "text": "dett skall icke all sammen gaa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 32,
      "text": "allt effter dett egen raad |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 33,
      "text": "Frem geck herre laffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 33,
      "text": "waar kled i skarlagen | smaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 33,
      "text": "her peder giffuer mig eders datter |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 33,
      "text": "Menn min Broder icke leffue maa: |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 34,
      "text": "Frem gick herre peder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 34,
      "text": "hann war enn man | saa Braad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 34,
      "text": "hann gaff sinn datter anden sinn | Bort",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 34,
      "text": "for-wdenn henndis egenn raad |",
      "part": false,
      "marginal_notes": []
    }
  ]
}