  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "IEsus Christus er wor salighed/",
      "part": false,
      "marginal_notes": [
        "Esaie. liij."
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "som fraa oss tog Gud faders wrede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "med sÿn pÿne oc hellige død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "frelste han oss fraa heluedis nød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Att wÿ aldrig thet forgæde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "gaff han oss sitt legomme att æde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "som er skiuld ÿ brødzens skÿn/",
      "part": false,
      "marginal_notes": [
        "Mat. xxvj."
      ]
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "oc att dricke sitt blod ÿ wÿn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Hwem aff thenne kost wil æde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "sitt hierte oc sÿn sag han ey forgæde/",
      "part": false,
      "marginal_notes": [
        "j. Corin. xj."
      ]
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "hwem vwerdig her til gaar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "for lÿffuit tha then ewige død han faar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Thÿ skaltw Gud fader prÿse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "att han teg saa wel wilde spÿse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "oc han for thÿn syndzens løst/",
      "part": false,
      "marginal_notes": [
        "Rom. viij."
      ]
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "ÿ døden sÿn søn haffuer giffuit wist.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Saadan naade oc barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "søger eet hierte ÿ stort arbeyd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "æstw karsk saa bliff her fraa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "att tw skalt icke fordømmelsen faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Tw skalt nw bliffue ÿ stadelig tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "tha foer tw naade miskund oc roo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "aff thenne kost han haffuer giffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "oss arme til thet ewige lÿff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Han siger sielff kommer ÿ arme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "ieg wil meg offuer eder forbarme /",
      "part": false,
      "marginal_notes": [
        "Math. xj. Math. ix:"
      ]
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Jngen læge haffue the karske behoff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "hans konst er thennom een spot oc wro.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "Wilde tw med thÿne gierninger fange/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "ÿ himmelen for thennom indgange/",
      "part": false,
      "marginal_notes": [
        "Galat. ij."
      ]
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "tha wore mÿn pÿne oc død ey fyllist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "for tw teg sielluff thÿn salighed æst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "Troer tw fast aff hiertens grund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "oc bekender med thÿn mund/",
      "part": false,
      "marginal_notes": [
        "Roman. x."
      ]
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "saa æst tw ret gantske wel skickit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "oc thenne kost thÿn siæl wederqweger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "Thenne frucht kan ey hæden wære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "brødre oc søstre skaltw ære/",
      "part": false,
      "marginal_notes": [
        "Johan. xiij"
      ]
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "med thÿne penning gods oc iord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "ther med thennom hielpe som Gud haffuer budit.",
      "part": false,
      "marginal_notes": []
    }
  ]
}