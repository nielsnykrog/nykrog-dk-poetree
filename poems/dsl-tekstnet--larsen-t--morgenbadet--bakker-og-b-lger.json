{
  "id": null,
  "title": "Morgenbadet",
  "year_created": 1912,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Thøger Larsen",
    "country": null,
    "wiki": "Q323530"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Bakker Og Bølger",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1912,
    "url": "https://tekstnet.dk/books/larsen-t_bakker-og-boelger/006/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Paa skønne Ben du skrider mod Søen blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hvor Ild fra Solen leger som unge Slanger!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Du Synderinde af Ungdom og uden Anger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "skal Vandenes salte Søvn-Omfavnelser faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Og Morgenen vokser under den lyse Sky,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "som levede vi under selve Tidernes Gry.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Jeg ser dig for mig, kun i en solhvid Særk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "og Luften flytter varsomt med Lys og Skygger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Din trygge Skønhed fortroligt paa Jorden bygger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "og vidner, at Himlens Hvælving er strakt og stærk.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Du tøver – og tager mig i dine Øjnes Blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "der sejrer og siger saa svangert: Vi forgaa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Et Morgensmil i Kindernes Buer staar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "som Sejersminder efter en sluknet Rødme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Et Skær af Solens Kraft og af Syndens Sødme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "i Blikkets Søer under det unge Haar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "I Barmens vuggende Hvidhed en Gud har leet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "mens Stjernernes inderste Underværk er sket.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Dit Væsens Troper straaler imod min Hu –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "uendelig frodigt under din gode Pande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "Mit Hjerte løftes af Have og gyldne Vande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Befriet – lutter Menneske blev du nu.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "Et Baal af uudgrundelig Nøgenhed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "slog gennem mit Sind, som Lyn slaar i Havet ned.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Som dugget Sølv dine Øjne nu ser paa mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 4,
      "text": "du vaagnede Pige, der sover for alle Tider.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 4,
      "text": "Og Lykken ligger omkring os til alle Sider.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 4,
      "text": "Og svale Vande ligger og venter dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "I alle Former løb du af Stjernen fuld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "du gaadefulde Ætling af Mødre i Mud.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
