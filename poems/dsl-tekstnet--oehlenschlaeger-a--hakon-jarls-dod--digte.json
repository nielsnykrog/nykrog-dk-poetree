{
  "id": null,
  "title": "Hakon Jarls Död",
  "year_created": 1803,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Adam Oehlenschläger",
    "country": null,
    "wiki": "Q168356"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Digte",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1803,
    "url": "https://tekstnet.dk/books/oehlenschlaeger-a_digte/004/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "De Nætter ruge saa lange og sorte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Syvstiernen skimter saa mat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Ud stormer Vinden fra Himmelens Porte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "fælt knager Granen i kolde Nat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "I Offerlundene Blæsten tuder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "om mosgroede Stötter af Valhals Guder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "»Vor Tid er forbi!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Snart synke vi!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Den rasler og styrter den blodige Steen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "og knaser omliggende Offerbeen!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Den gothiske Steenmasse kneiser,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "brunrödlig skummel i Maaneglands.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "I mörkeblaae Luft sit Spir den reiser,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "om Muren Dödninge rangler i Dands.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Fra lange Blyevindve en Straale iler",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "til Alterets Crucifix og smiler:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "»Du seirer vist,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Du hvide Christ!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Snart skal den vilde nordlige Zone",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "neie sig for din Tornekrone!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Olaf Tryggesön lander i Norge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Brat synger han Messer paa hviden Strand!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Fra skumle, sydlige Borge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "bringer han Munke til Klippeland.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Alt mere den christne Troe sig udbreder;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "men mægtige Hakon Bönderne leder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "For gamle Troe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "i Fædreboe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "de möder Olaf med tapper Ære –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "men Konningen splitter de samlede Hære!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Höit galer Hanen ved Midnatstide;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Jarl Hakon slagter sin Sön.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "Han drager den rygende Kniv af hans Side",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "og synker i Lunden, og giör en Bön.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "»Christe! forstyr ej de straalende Aser.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "Tag dette Offer, mit Hierte raser!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "og giv os Held!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "Forlad vort Field!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "Men Uglen flagrer paa Rotas Bryst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "og tuder med dæmpet, varslende Röst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "Korsbannerne vildt i Ætheren velte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "De lyne, de lyne afsted!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "Höit opflammer Luren de christne Helte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "hvor Olaf stevner er Lykken med.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "Foran ham bæres Verdens Befrier,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 4,
      "text": "rundt om lyder Psalmer og Litanier;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 4,
      "text": "med korsdannet Sværd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 4,
      "text": "han förer sin Hær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 4,
      "text": "Foran ham iler de seirende Rygter!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 4,
      "text": "Forladte Hakon fnyser og flygter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 5,
      "text": "Afsted paa den vrindskende Ganger han traver.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 5,
      "text": "Den standser ved Gaulaae, med Skum bedækt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 5,
      "text": "»Blev alle Nordmænd end feige Slaver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 5,
      "text": "saa skiender jeg ej min ældgamle Slægt.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 5,
      "text": "Med Taarer sin sidste Ven han dræber,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 5,
      "text": "i Gangerens Blod han sin Kiortel klæber.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 5,
      "text": "»Nu troer du mig död!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 5,
      "text": "at mit Blod her flöd;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 5,
      "text": "men Olaf giv Tid, jeg har Kiemper i Nor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 5,
      "text": "og paa min Side strider Tyr og Thor.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 6,
      "text": "Saa knittrende vrede hans Öine skule;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 6,
      "text": "han iler til grantakte Field",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 6,
      "text": "og skiuler sig i en skummel Hule,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 6,
      "text": "med Thormod Karker sin frigivne Træl.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 6,
      "text": "En rygende Fyrrespaan Hulen oplyser.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 6,
      "text": "Der sidde de tause, Trællen gyser!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 6,
      "text": "Den ene ej troer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 6,
      "text": "den andens Ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 6,
      "text": "Fælt stirrer Trællen paa Jarlen hvid;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 6,
      "text": "dog slumrer han ind ved Midnatstid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 7,
      "text": "Da hvidsler det sagte i Hulens Mörke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 7,
      "text": "og Asa Hermod for Hakon staaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 7,
      "text": "»Guderne sætte Lid til din Styrke!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 7,
      "text": "Giv Olaf Christen sit Banesaar!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 7,
      "text": "Guldtaarer den yndige Freya græder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 7,
      "text": "Ha skal en sydlig korsfæstet Misdæder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 7,
      "text": "forstyrre os her?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 7,
      "text": "Gaae, sving dit Sværd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 7,
      "text": "Med Olafs Blod vore Altre bestænk!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 7,
      "text": "Da skal du sidde paa Valhals Bænk.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 8,
      "text": "Saa taler den röde Skygge og svinder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 8,
      "text": "men Trællen vaagner forfærdet op.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 8,
      "text": "»Jesus stod for mig med smilende Kinder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 8,
      "text": "og pegede paa din blodige Krop!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 8,
      "text": "»Ha usle Slave! frygt Tordnerens Torden!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 8,
      "text": "Hvi bliver du bleg og sort som Jorden?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 8,
      "text": "Formaster du dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 8,
      "text": "at forraade mig?«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 8,
      "text": "»Nej!« gyste Trællen med frygtende Sind;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 8,
      "text": "og udmattet slumrede Jarlen ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 9,
      "text": "Men underlig fælt han smiler i Drömme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 9,
      "text": "og Karker ræddes ved dette Syn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 9,
      "text": "»Hvi saae jeg ham nylig i Blod at svömme?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 9,
      "text": "Hvi trækker han saa med det höire Bryn?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 9,
      "text": "Han er dog en Röver, som Norge skiender.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 9,
      "text": "Velan, i hans Blod jeg toer mine Hænder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 9,
      "text": "Til Olaf jeg gaaer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 9,
      "text": "og en Guldkiede faaer!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 9,
      "text": "Saa hvisker han bleg i den sorte Grube",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 9,
      "text": "og zittrer – og udskierer Jarlens Strube!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 10,
      "text": "Höit Lurene skralde fra nærmeste Fielde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 10,
      "text": "»Her er han! her flygted han hen!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 10,
      "text": "Som Fossen med brusende, knusende Vælde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 10,
      "text": "indbryder Kong Olaf med sine Mænd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 10,
      "text": "Brat Hakons Træl Hellebarderne dræbe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 10,
      "text": "og Olaf skuer med smilende Læbe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 10,
      "text": "tæt ved sin Fod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 10,
      "text": "Hakon Jarl i Blod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 10,
      "text": "»Den ypperste Hedning faldt! jeg er hevnet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 10,
      "text": "Ved hans Död er Vankundigheds Forhæng revnet!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 11,
      "text": "Det ruller i Horizontens Himmel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 11,
      "text": "og sagtelig skielver Hav og Jord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 11,
      "text": "De gamle Guders brogede Vrimmel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 11,
      "text": "forsvinder, og kommer ej meer til Nord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 11,
      "text": "Istedet for Lundens ærværdige Minder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 11,
      "text": "man idel Kirker og Klostere finder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 11,
      "text": "Kun hist og her",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 11,
      "text": "man fiern og nær",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 11,
      "text": "en Höi og en opreist Kampesteen skuer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 11,
      "text": "som minder om Oldtidens slukte Luer.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
