  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Jesu Bold met megit vold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Gud Faders Søn oc ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "du haffuer met mact nu ødelagt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "den falske Dieffuels Snare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Mod Adams fald fick du det kald/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Som oss Gud Fader iette/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "paa det han vilde forgette/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "min Synd oc skyld/ du vost mig huld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Der er ey trøst/ huor du ey est/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "barmhiertighed at forhuerffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Huem ey haffuer dig/ oc din naade met sig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "han er euig forderffuit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "⁕ O Christe mild/ du haffuer stild/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "vaare Oldefæders forlange/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Som Aar oc dag/ i ve oc i wmag/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Vdi Helffuede laage fangne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "vdaff stor nød/ robte de o Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Lad op de Hiemmelske porte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "at obnes i alle orde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Sent oss din Søn/ der tager oss fra/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "den suare ve/ som du lod ske/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "O Christe met din pine/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "derfaare est du offuer verden nu/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "En Herre til euig tide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "⁕ O Jesu ren/ du est all ene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "alle synderis trøst paa Jorden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Som vor forseet aff euighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "ith Menniske skulde vorde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "oss alle til trøst/ for vden brøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "Du skalt dem alle dømme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "der ey ville Troen nemme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "O verdige Fruct/ all min tilfluct",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "haffuer ieg til dig/ Thi du haffuer mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 2,
      "text": "forhuerffuit euig glæde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 2,
      "text": "mit haab til dig/ er tryggelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 2,
      "text": "Som mig kan naaden giffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "⁕ O Christe god/ aff Dauids Rod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "naadig for vden ende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "gantske flittelig haffuer du mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "igen til dig lad vende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 3,
      "text": "Alt met dit Ord/ Haffuer du det giort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 3,
      "text": "fra falske Propheters Lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 3,
      "text": "der røffuede mig fra din ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 3,
      "text": "met deris dict och falske Scrifft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 3,
      "text": "Jeg led der paa/ Och mente saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 3,
      "text": "der met stor naade forhuerffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 3,
      "text": "Jeg forlod dig dem icke mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 3,
      "text": "min wforstand det giorde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 4,
      "text": "⁕ O Jesu fin/ dit ord giffuer skin/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 4,
      "text": "Lær oss dig ret at dyrcke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 4,
      "text": "Och vere deris Tolck/ dine arme folck",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 4,
      "text": "som side vdi det mørcke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 4,
      "text": "Haffue ingen frist/ men argelist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 4,
      "text": "alt vdaff Menniskens lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 4,
      "text": "i dem dine ord formere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 4,
      "text": "O Herre sød hielp her aff nød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 4,
      "text": "giff dem din trøst du haffuer forløst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 4,
      "text": "met pine oc død all ene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 4,
      "text": "de haabe til dig/ samdrectelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 4,
      "text": "ey paa deris gerninger wrene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 5,
      "text": "⁕ O Christe kære/ om det saa skeer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 5,
      "text": "Dit ord skal fra mig vige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 5,
      "text": "saa kom til mig miskundelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 5,
      "text": "oc lad mig ey besuige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 5,
      "text": "Aff Menniskens skick/ oc falske dict/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 5,
      "text": "huem kan den list begribe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 5,
      "text": "hun lader sig hellig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 5,
      "text": "Som dog er løgn oc idel segn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 5,
      "text": "Din hellige røst er liffuit vist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 5,
      "text": "dit ord kan sandhed lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 5,
      "text": "det spise mig ieg beder dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 5,
      "text": "lad mig det ey ombære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 6,
      "text": "⁕ O Jesu Christ/ sand Gud du est",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 6,
      "text": "ingen brøst i dig kan vere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 6,
      "text": "Han er ey queg der fuldelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 6,
      "text": "bescriffue kan din ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 6,
      "text": "Din erlighed/ oc maiestet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 6,
      "text": "ere alting vndergiffuen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 6,
      "text": "i huad som helst der leffuer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 6,
      "text": "i alle creatur/ O Konning pur/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 6,
      "text": "naar ieg skal dø/ aff denne ø/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 6,
      "text": "mit hierte maa da lide/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 6,
      "text": "Da hielp du mig/ at ieg hoss dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 6,
      "text": "Euindelige maa leffue",
      "part": false,
      "marginal_notes": []
    }
  ]
}