{
  "id": null,
  "title": "4. Kvindens forbandelser",
  "year_created": 1514,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Michael",
    "country": null,
    "wiki": "Q108476156"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "De Creatione Rerum",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1514,
    "url": "https://tekstnet.dk/books/hr-michael_de-creatione-rerum/004/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Ieg wil tig swodanæ gaffuer giffuæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "offuer tig scal han waræ herræ. 1.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Altijd scal han legghæ therpaa wind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "at swichthæ thit ondhæ haardhæ sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "eller I faræ baadhæ werræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "eller han slaer sønder baadhæ ryg och been",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "om thu wilt hannum ey lydhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Uarer med fred, thet staar ether wæl,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "tha leffuæ I samen med ræth och sckiæl,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Thin sckyld findes meer end Adam brød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "thi scalt thu wordhæ bleg och rød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "nar thu thinæ børn scalt fødhæ. 2.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Aff twang och nød som thu scalt lidhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "thu taaldt baadhæ wee och mødhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Aff sorg thinæ tænder gaa til hobæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "ioduth och wee, mwnæ thu tha robæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "then tijd scal wordhæ tig banghæ. 3.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "end taalæ swodan bitther nød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "om daghenæ wordhæ noghet langhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "Allæ qwindffolk som børn scullæ fødhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "the mwghæ alt taalæ swodan mødhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "Haffdhæ thu ey syndhet med thin vsnildhæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "then tijd thu æbled ædhæ wildhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "nød haffdhæ ey kommet hæræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "Thu scalt vpffyldes med wee och twang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "swo scalt thu thet forstandhæ. 4.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "At taalæ then nød som thu scalt haffuæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "for syndhen thu giordhæ aff legoms plaffuæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "thet spørs offuer allæ landhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "swo ether kan aldrig løckæ sckee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "gaar hijd nw allæ tillighæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "Thu Dieffuel, gack bort aff Paradijs,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 0,
      "text": "thu swegst Adam, tog han war wijs,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 0,
      "text": "I ormælighæ haffdhæ thu tig sckapt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 0,
      "text": "wisthæ thu ey wæl, thu wasth fortapt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 0,
      "text": "end solen wasthw fæddræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 0,
      "text": "At thu haffdhæ bleffuit vti hælffuedes glødhæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 0,
      "text": "thet haffdhæ wareth møghet bæddræ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 0,
      "text": "end thu scullæ swighæ thessæ twendhæ folk",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 0,
      "text": "och kommæ alwærdhen vti kwmmer och wolk.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 0,
      "text": "Forbannedhæ wordhæ thinæ stwndhæ!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 0,
      "text": "far bort til hælffuedes twang och wee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 0,
      "text": "thi thu æsth ond aff grwndhæ!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 0,
      "text": "Adam tænchthæ paa hwad han wildhæ gøræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 0,
      "text": "Thet Gud sagdhæ ormen, kwnnæ han wæl høræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 0,
      "text": "»Misckwndelighæ Herræ, tha giff mig dom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 0,
      "text": "mig war imod ieg foræ tig kom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 0,
      "text": "thu stander alt nw til redhæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 0,
      "text": "at dømæ mig for myn sckyld och brødhæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 0,
      "text": "gør thet med twcht och æræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 0,
      "text": "Driff mig ey aff thennæ stæd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 0,
      "text": "lad mig hær bliffuæ och Eua med,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 0,
      "text": "hær wildhæ wij gernæ bliffuæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 0,
      "text": "thet tychthæ mig waræ nytthæ och got,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 0,
      "text": "wildhæ thu tig thertil bøghæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 0,
      "text": "Kwnnæ wij ey meræ aff Himmerighæ faa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 0,
      "text": "end thennæ stæd wij standhæ vpaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 0,
      "text": "»Adam och Eua, gaar baadhæ hijd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 0,
      "text": "ether staar nw foræ en ynckælig tijd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 0,
      "text": "thet maa ey andhet wæræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 0,
      "text": "Huad I haffuæ brøt ethers Gud imod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 0,
      "text": "Paradijs scullæ I ombæræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 0,
      "text": "Adam, gack fram, thu fwlæ mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 0,
      "text": "then syndughæ qwindhæ tag med thin hand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 0,
      "text": "gaar wd til wærdzens mødhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 0,
      "text": "allæ the som sckabes, theres øgnæ wædhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 0,
      "text": "och solæn maa therforæ blødhæ.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 0,
      "text": "For gang som Adam och Eua the gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 0,
      "text": "Gud ladhæ thet foræ theres synder staa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 0,
      "text": "Allæ diwr som sckapthæ waaræ, Rabbi Moyses Genesis 3",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 0,
      "text": "mellom Adam och Gud the witnæ baaræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 0,
      "text": "aff Paradijs strax the løbæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 0,
      "text": "The soghæ til himmelæn och stampedhæ paa iord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 0,
      "text": "Gud wisthæ huad the mwnæ myeenæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 0,
      "text": "Foglæ fløghæ høgt och ropthæ swo fast,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 0,
      "text": "for Adam war aff Paradijs kast,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 0,
      "text": "sloghæ them mod trææ och greenæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 0,
      "text": "thu sculdhæ then storæ glædhæ spildhæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 0,
      "text": "och gøræ tig sielff then sckadhæ.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 0,
      "text": "Fisckæ som waræ i allæ flodhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 0,
      "text": "the løbæ i wandhet, och ildhæ the lodhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 0,
      "text": "Huad sorg vti Adams hiarthæ stod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 0,
      "text": "thet wedh then Gud hannum wordhæ lod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 0,
      "text": "han gaff sig gantzæ saaræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 0,
      "text": "»Eua,« sagdhæ Adam med grædendhæ taar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 0,
      "text": "Gud giffuet wij dødhæ waaræ.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 0,
      "text": "Eua ropthæ tha med iemmerlig røst:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 0,
      "text": "»O Adam, Adam, giff mig trøst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 0,
      "text": "ieg døør aff hwnghers waadhæ!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 0,
      "text": "Adam, vthen thu kanth findhæ raad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 0,
      "text": "tha bliffuæ wij dødhæ baadhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 0,
      "text": "Aff hwngher och tørst med fraast och kwld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 0,
      "text": "Gudz nadhæ och hielp er for oss dwld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 0,
      "text": "Ieg bedher tig, Adam, gør saa wæl",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 0,
      "text": "mædhen wij hær gaa, sla mig ihiæl,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 0,
      "text": "swo fødher thu tig wæl eenæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 0,
      "text": "eller Gud ledher tig i Paradijs,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 0,
      "text": "swo faar thu thinæ fødhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 0,
      "text": "Ihuadh wij gøræ i thennæ tijd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 0,
      "text": "om wij gaa baadhæ om wærdhen wijd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 0,
      "text": "tha findhæ wij inghen grødhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 0,
      "text": "ey noghet trææ wil bæræ frwcht",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 0,
      "text": "som wij sculdhæ oss aff bierghæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 0,
      "text": "Uoræ klæder kwnnæ oss ey sckiwlæ for fraast,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 0,
      "text": "swo lidhen er wor daglighæ kaast,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 0,
      "text": "for noghen then ting oss er imod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 0,
      "text": "O Adam, hielp thet wij faa bod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 0,
      "text": "bedh Gud om hielp och nadhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 0,
      "text": "Awij, huat wij haffuæ ildhæ giord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 0,
      "text": "med æbled ther wij aadhæ!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 0,
      "text": "Adam begynthæ at suckæ och grædhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 0,
      "text": "»thet war fuldildhæ wij sculdhæ thet ædhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 0,
      "text": "Gud nadhæ oss allæ stondhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 0,
      "text": "for sødmæ ther gick gemmen mwnd och thænder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 0,
      "text": "the æræ baadhæ haardhæ och ondhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 0,
      "text": "O Herræ, som wij haffuæ brøt emod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 0,
      "text": "vnd oss at gøræ plycht och bod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 0,
      "text": "Før wij scullæ ind vti Hælffuedhæ gaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 0,
      "text": "vpfylt med sorg i huærriæ wraa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 0,
      "text": "wij villæ oss til tig giffuæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 0,
      "text": "Ey er then plicht swo stoer paa iord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 0,
      "text": "ieg sigher huad thu scalt gøræ:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 0,
      "text": "Eua, gack paa thin baræ fod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 0,
      "text": "gør plicht och bod i Tigris flod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 0,
      "text": "mig hobes Gud wil tig høræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 0,
      "text": "holt hannum fuldhart vti thin mwnd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 0,
      "text": "stadt ther vti 30 daghæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 0,
      "text": "Swo lenghæ scalt thw ey talæ eth ord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 0,
      "text": "besyrghæ thet wij haffuæ ildhæ giord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 0,
      "text": "Til Iordans flod wil ieg nw gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 0,
      "text": "swo længhæ wil ieg i wandhet staa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 0,
      "text": "taalæ ther hwad Gud wil sændhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 0,
      "text": "Jeg wil ey drickæ, ey helder ædhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 0,
      "text": "til liffuet fangher ændhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 0,
      "text": "Eua, ieg wil nw fran tig wighæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 0,
      "text": "lad tig ey meer aff Dieffuelen swighæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 0,
      "text": "om han wil til tig kommæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 0,
      "text": "wtaff thin mwnd tal ey eth ord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 0,
      "text": "tha faar thu løckæ och frommæ.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 0,
      "text": "Adam gick bort synæ synder at bødhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 0,
      "text": "fuldsnart mwnæ Dieffuelen qwinden mødhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 0,
      "text": "Han taledhæ til hennæ i samæ tijd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 0,
      "text": "hwn wændhæ sig huærcken hist eller hijd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 0,
      "text": "hannum inthet hwn swaræ tordhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 0,
      "text": "Dieffuelen sckapthæ sig i ænglælighæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 0,
      "text": "bad hennæ hwn sculdhæ hannum lydhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 0,
      "text": "Han ynckedhæ sig offuer then qwindes twang:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 0,
      "text": "»Eya, huar tidhen er wordhen tig lang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 0,
      "text": "Gudz wilghæ wil ieg tig bydhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 0,
      "text": "Huart ieg gaar foræ, gack faræløst med,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 0,
      "text": "thet er Gudz særdeles williæ.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 0,
      "text": "Hwar saaræ war qwindhen then tijd flad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 0,
      "text": "ther hwn giordhæ som Dieffuelen bad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 0,
      "text": "Dieffuelen foer tha med løgn och føg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 0,
      "text": "swo grøn war Eua som en løg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 0,
      "text": "hennes krop war wissnet med allæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 0,
      "text": "Hwn gad ey staaedt paa synæ been,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 0,
      "text": "mod iordhen maathæ hwn fallæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 0,
      "text": "Dieffuelen tog hennæ vp i syn faffn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 0,
      "text": "hwn tenchtæ han giordhæ hennæ nytthæ och gaffn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 0,
      "text": "hennæ tychthæ hwn fick tha lisæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 0,
      "text": "och scapt aff then i Himmelen boer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 0,
      "text": "thu scalt mig Adam wisæ.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 0,
      "text": "The ginghæ tijd baadhæ som Adam stood,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 0,
      "text": "och bøthæ synæ synder i Iordans flood,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 0,
      "text": "»O qwindhæ, hwi æsthw kommen hijd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 0,
      "text": "æsthw nw swighen andhen tijd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 0,
      "text": "Eua, huad haffuer thu faaræ?«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 0,
      "text": "Hwn wred synæ hænder drog sig i haar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 0,
      "text": "giff mig thet nw tilkennæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 0,
      "text": "»Twi wordhæ thin armæ wslighæ qwind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 0,
      "text": "at thu swo løss wast i thit sind,«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 0,
      "text": "swo swaredhæ Adam hennæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 0,
      "text": "toldhæ kwld och hwngher med møghel plaffuæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 0,
      "text": "fuldsaaræ mwnæ han sig weenæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 0,
      "text": "For qwindhen som tha haffdhæ ildhæ giord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 0,
      "text": "til hennæ wildhæ han ey talæ eth ord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 0,
      "text": "Then fødhæ war ey møghet god,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 0,
      "text": "thet war thet tang i wandnet stod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 0,
      "text": "och fisckæ som inghen mathæ ædhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 0,
      "text": "Thet frod och slym som wandnet dreff op,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 0,
      "text": "synæ hænder mathæ hwn ey wædhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 0,
      "text": "I flodhen som Adam tha i stod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 0,
      "text": "al wærdhen war them baadhæ imod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 0,
      "text": "»Thet er nw 40 dæffuæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 0,
      "text": "ieg bedher tig, Adam, gack nw til land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 0,
      "text": "lad oss nw vedhermod haffuæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 0,
      "text": "och fattigdom forwthen ændhæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 0,
      "text": "til Gud wil oss syn nadhæ sændhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 0,
      "text": "och taalighen bæræ i allæ maadhæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 0,
      "text": "mædhen wij kwnnæ waræ samen baadhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 0,
      "text": "huad han wil oss tilføghæ.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 0,
      "text": "Adam gick strax aff Iordans flood,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 0,
      "text": "som han wildhæ haffuæ syn hwilæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 0,
      "text": "Med Eua han affledhæ ther en søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 0,
      "text": "han kalledhæ hannum Abel som jeg kan sckiøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 0,
      "text": "the ginghæ sidhen manghæ milæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 0,
      "text": "med graad atspwrdhæ the theres brød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 0,
      "text": "wæl 30 winther til ændhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 0,
      "text": "Sidhen ginghæ the til then stæd igeen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 0,
      "text": "som the waræ førræ, med mødhæ och myeen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 0,
      "text": "Eua kom tha i sorghens garn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 0,
      "text": "hwn bleff ther med eth andhet barn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 0,
      "text": "thet kom hennæ lidhet til fraamæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 0,
      "text": "Aff leghoms twang och wee och nød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 0,
      "text": "fuldlenghæ bleff hwn en daamæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 0,
      "text": "Hwn kwndhæ ey see, ey hælder høræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 0,
      "text": "ey noghet ledhæmod paa sig røræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 0,
      "text": "thet taaldhæ hwn manghæ daghæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 0,
      "text": "the misthæ fuldmanghæ baadhæ sind och maal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 0,
      "text": "then arff effther hennæ the haffuæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 0,
      "text": "Omsygher slog hwn synæ øghenæ op",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 0,
      "text": "och tog sielff paa syn siwghæ krop,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 0,
      "text": "»Adam, gack bort ieg scal nw fødhæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 0,
      "text": "myt fooster til wærdhen med angher och mødhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 0,
      "text": "hoes mig bliff inghælwndhæ.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 0,
      "text": "Chayn føddæ hwn, han war ey god,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 0,
      "text": "hwn kalledhæ sidhen at them baadhæ:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 0,
      "text": "»Thetthæ scalt thu, Adam, sckiødhæ och widhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 0,
      "text": "swo scullæ qwindfalk effther thessæ tidhæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 0,
      "text": "fødhæ børn med døtzens waadhæ.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 0,
      "text": "och biærghæ sig aff wand och iord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 0,
      "text": "som folk plæghæ nw at gøræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 0,
      "text": "Mandhen scal gaa med harghæ och plow,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 0,
      "text": "tærsckæ och mwghæ och aghæ til sckow,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 0,
      "text": "Sidhen skedhæ thet mod ræth och sckiæl",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 0,
      "text": "at Chayn slog Abel, syn broder, ihiæl,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 0,
      "text": "hannum tymdes therforæ stor wandhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 0,
      "text": "Gud bleff hannum wreed for samæ sag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 0,
      "text": "landfflychtug bleff han aff landhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 0,
      "text": "En tijd sckiwldhæ Chayn sig hoess eth trææ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 0,
      "text": "ther waræ ey dywr, ey fwglæ, ey fææ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 0,
      "text": "kasthæ om sig manghæ greenæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 233,
      "stanza_id": 0,
      "text": "for han mathæ ey paa iordhen boo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 234,
      "stanza_id": 0,
      "text": "thet gick hannum stort til meenæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 235,
      "stanza_id": 0,
      "text": "Lamech han heffnedhæ ther Abels død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 236,
      "stanza_id": 0,
      "text": "i samæ stæd han Chayn sckiød, Genesis 4",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 237,
      "stanza_id": 0,
      "text": "Then gerning war Adam møghet imod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 238,
      "stanza_id": 0,
      "text": "gantzæ lenghæ thet i hanss hiarthæ stod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 239,
      "stanza_id": 0,
      "text": "hwar Chayns siæl kwndhæ bliffuæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 240,
      "stanza_id": 0,
      "text": "Han syrgdhæ for Abel och Chayn waræ dødhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 241,
      "stanza_id": 0,
      "text": "han kwndhæ thet ickæ wændhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 242,
      "stanza_id": 0,
      "text": "Lamech bleff sidhen i wandet sænkt In diluuio",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 243,
      "stanza_id": 0,
      "text": "som Gud haffdhæ wrag offuer menniscken tænckt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 244,
      "stanza_id": 0,
      "text": "swo fick hanss leeffnet ændhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 245,
      "stanza_id": 0,
      "text": "at Adam leffuedhæ sidhen 9 hwndredhæ aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 246,
      "stanza_id": 0,
      "text": "och 30 wyntheræ til ændhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 247,
      "stanza_id": 0,
      "text": "Adam bleff sidhen en gammel man,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 248,
      "stanza_id": 0,
      "text": "30 søner tha affledhæ han, Ex historia scolastica",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 249,
      "stanza_id": 0,
      "text": "Eua føddhæ 30 døtther thertil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 250,
      "stanza_id": 0,
      "text": "the woxthæ, thet war eth wnderligt spil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 251,
      "stanza_id": 0,
      "text": "al wærdhen fick aff them frommæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 252,
      "stanza_id": 0,
      "text": "Allæ som æræ sckapthæ och sckabes endnw,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 253,
      "stanza_id": 0,
      "text": "aff Adam och Eua the kommæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 254,
      "stanza_id": 0,
      "text": "Adam bleff siwg effther leghomsens laap,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 255,
      "stanza_id": 0,
      "text": "at leffuæ haffdhæ han ey lengher haap,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 256,
      "stanza_id": 0,
      "text": "swo fick han tha til ordhæ:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 257,
      "stanza_id": 0,
      "text": "vthen ieg faar noghet at smørghæ mig med,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 258,
      "stanza_id": 0,
      "text": "ieg kan ey siwgheræ wordhæ.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 259,
      "stanza_id": 0,
      "text": "Then trediæ søn haffdhæ han hoss sig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 260,
      "stanza_id": 0,
      "text": "»Sæth, hør nw huad ieg sigher tig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 261,
      "stanza_id": 0,
      "text": "Miskwndhetzølliæ er myn attraa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 262,
      "stanza_id": 0,
      "text": "snarlighen scalt thu paa wæghen gaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 263,
      "stanza_id": 0,
      "text": "at ieg kwndhæ hennæ fanghæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 264,
      "stanza_id": 0,
      "text": "I østher tag wæghen paa høgræ hand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 265,
      "stanza_id": 0,
      "text": "ther standhæ woræ fiæd wæl kændhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 266,
      "stanza_id": 0,
      "text": "Som engelen kiørdhæ oss aff Paradijs wd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 267,
      "stanza_id": 0,
      "text": "slog oss fuldsaaræ paa wor hwd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 268,
      "stanza_id": 0,
      "text": "ther wij oss mod hannum wændhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 269,
      "stanza_id": 0,
      "text": "sig ieg til hannum sætther al myn lijd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 270,
      "stanza_id": 0,
      "text": "Bed hannum mig noghet naadhæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 271,
      "stanza_id": 0,
      "text": "och giffuæ mig smørelsæ til leghoms trøst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 272,
      "stanza_id": 0,
      "text": "ieg bedher hannum dess med grædendhæ røst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 273,
      "stanza_id": 0,
      "text": "Enghelen fick Sæth try æblækorn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 274,
      "stanza_id": 0,
      "text": "the waræ swo hordhæ som noghet horn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 275,
      "stanza_id": 0,
      "text": "och sagdhæ huad han sculdhæ gøræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 276,
      "stanza_id": 0,
      "text": "Han gick sidhen hiem och græd och tød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 277,
      "stanza_id": 0,
      "text": "til iordhen mwnæ han hannum føræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 278,
      "stanza_id": 0,
      "text": "Oc iordedhæ hannum paa then wenstræ hand In monte caluarie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 279,
      "stanza_id": 0,
      "text": "i Ebron som Gud gaff vp syn and,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 280,
      "stanza_id": 0,
      "text": "swo fick hanss leffnet ændhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 281,
      "stanza_id": 0,
      "text": "i Hælffuedhæ som sckreffuet staar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 282,
      "stanza_id": 0,
      "text": "Gud hennæ til Limbum sændhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 283,
      "stanza_id": 0,
      "text": "The kærner waræ førdhæ offuer wand och haff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 284,
      "stanza_id": 0,
      "text": "och planthedæ sidhen paa Adams graff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 285,
      "stanza_id": 0,
      "text": "Theraff woxthæ eth trææ fuldstort",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 286,
      "stanza_id": 0,
      "text": "aff huilket Wor Herres kaars war giort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 287,
      "stanza_id": 0,
      "text": "thet scullæ allæ mennisckæ widhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 288,
      "stanza_id": 0,
      "text": "Finis. Deo gratias.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 289,
      "stanza_id": 1,
      "text": "»O mennisckæ, lidher thu noghet for mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 290,
      "stanza_id": 1,
      "text": "fuldsnarlighen tha bedrøffuer thu tig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 291,
      "stanza_id": 1,
      "text": "Tag vp thit kaars och efftherfylghæ mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 292,
      "stanza_id": 1,
      "text": "see hwilket ther er tha swarest for dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 293,
      "stanza_id": 1,
      "text": "i Himmerighæ scalt thu til ewig tijd frøydhæ tigh blant ængelæsang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 294,
      "stanza_id": 1,
      "text": "Uilt thu med welløst myt kaars forbij gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 295,
      "stanza_id": 1,
      "text": "tha scalt thu och wthen myt righæ staa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 296,
      "stanza_id": 1,
      "text": "Kwnnæ ieg ickæ vti myt righæ forwthen pynæ och modgang kommæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 297,
      "stanza_id": 1,
      "text": "Med wngdom eller siwgdom orsaghæ tig ingæledz mig at tiænæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 298,
      "stanza_id": 1,
      "text": "hæltz forthi at thu ickæ wedst huar manghæ lijffsdaghæ ieg wil tig forlænæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 299,
      "stanza_id": 1,
      "text": "Lad ickæ tidhen tig forsømelighen bedraghæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 300,
      "stanza_id": 1,
      "text": "ieg haffuer ickæ bebreffuet tig at leffuæ i 8 dagæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 301,
      "stanza_id": 1,
      "text": "thu staar dog om the gamblæ fuldstor en faræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 302,
      "stanza_id": 1,
      "text": "Seer thu ickæ at dødhen daglighæ dags blant falcket slaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 303,
      "stanza_id": 1,
      "text": "som stegheren blant hønsenæ, nar som han til stegherhwset gaar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 304,
      "stanza_id": 1,
      "text": "Then hanæ som han lader igen leffuæ, han siwngher allighæ fast",
      "part": false,
      "marginal_notes": []
    }
  ]
}
