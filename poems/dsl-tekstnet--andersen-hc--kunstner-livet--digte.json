    "url": "https://tekstnet.dk/books/andersen-hc_digte-1830/012/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Rask Rokken snurrede, Kanarifuglen sang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Paa Gulvet Katten sprang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "(Det var et godt, et velopdraget Dyr).",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Den gamle Bedstemoer fortalte Eventyr,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Og Drengen lyttet gjerne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Thi Eventyr kun spøgte i hans Hjerne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Ak, Tiden løb med alt for raske Skridt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Ja tidt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Slog Aftenklokken allerede ni,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Før Eventyret ganske var forbi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Da fik han Plads i Bedstemoers Alkove,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Men kunde ei de første Timer sove;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Der var saa meget jo, at grunde paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Saaledes just en Sommernat han laae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Da banker det paa Ruden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Og skjøn som Elskovs-Guden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "En lille Dreng paa Gulvet for ham staaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Med Grønt og Blomster i sit gule Haar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Fra Skuldren hæve sig to store gyldne Vinger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "Og deiligt Legetøi den Lille med sig bringer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "O hvilken Fryd! af Glæde Øiet flammer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "Det lille, snevre Kammer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "Er snart forladt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "Alt er saa smukt jo i den maaneklare Nat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "Sødt dufter Skovens friske grønne Krands,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "Smaa-Alferne forlyste sig med Dands;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "I Høien røre sig de gamle Kjæmpebeen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "Taus sidder Aanden paa sin Bautasteen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "Og fremad skuer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "Men med sin Engel, Barnet ikke gruer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "De lege begge froe i Skovens Sale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "Hvert Træ, hver Blomst kan tale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 0,
      "text": "Og Fuglen synger smukt om hvad den saae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 0,
      "text": "I fjerne Riger og i Luftens Blaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 0,
      "text": "De gamle Kjæmpe-Høie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 0,
      "text": "Sig aabne for hans Øie;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 0,
      "text": "Smaa-Puslinger, knap som en Finger lange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 0,
      "text": "Arbeide dybt i Jordens snevre Gange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 0,
      "text": "Alt skuer han, og føler sig saa glad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 0,
      "text": "Men Dagen gryer – nu maae de skilles ad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 0,
      "text": "»Farvel! Farvel!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 0,
      "text": "Men næste Aftenqvæl",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 0,
      "text": "Den Fremmede igjen til Drengen kommer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 0,
      "text": "Saa gaaer det fort i Vinter og i Sommer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 0,
      "text": "Snart bygges Babeltaarne, Ridderslotte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 0,
      "text": "Snart leger han med Alfen i hans Grotte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 0,
      "text": "Tidt laaner den ham sine gyldne Vinger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 0,
      "text": "Da svinger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 0,
      "text": "Han sig til Himlen, som en Kjæmpe-Ørn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 0,
      "text": "Og leger med de glade Engle-Børn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 0,
      "text": "Han skuer Verden, høit fra Himlens hvalte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 0,
      "text": "Og Alt hvad Bedstemoer fortalte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 0,
      "text": "Saa svinde Barndoms salige Minutter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 0,
      "text": "Man i en Skole Drengebarnet putter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 0,
      "text": "Tilspærrer Vinduet med Grammatik og Gloser;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 0,
      "text": "Kortsagt man skoser",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 0,
      "text": "Den Lille, som i Natten gjør Vesitter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 0,
      "text": "At han tilsidst kun gjennem Ruden titter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 0,
      "text": "Til Drengen, som nu bliver lang og stor.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 0,
      "text": "– Snart døer den gamle Bedstemoer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 0,
      "text": "Og hende følger Fader, følger Moder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 0,
      "text": "Han har ei Søster meer, eiheller Broder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 0,
      "text": "Forladt staaer Drengen da i Sorgens Tanker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 0,
      "text": "Da banker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 0,
      "text": "Det atter paa det lille Vindues Rude,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 0,
      "text": "Og ude",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 0,
      "text": "Den Lille staaer, han vinker – men forsvinder. –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 0,
      "text": "Da vaagne alle Barndoms søde Minder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 0,
      "text": "Han vil den Lille søge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 0,
      "text": "Der hist forsvandt bag Skovens dunkle Bøge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 1,
      "text": "Bort med Taare, bort med Suk!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 1,
      "text": "Verden er saa lys og smuk.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 1,
      "text": "Stjernen blinker fra det Blaae;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 1,
      "text": "Gud er med os hvor vi gaae!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 2,
      "text": "Forvoven",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 2,
      "text": "Han stiger ind i Livet, ind i Skoven",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 2,
      "text": "Hvor før, som Barn, han med den Lille vandret;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 2,
      "text": "Men, ak! det Hele har sig reent forandret.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 2,
      "text": "Stolt kneise Skovens grønne Træer med deres stive Nakker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 2,
      "text": "Som Lapse sveie Pilene i grønne Snørlivs Frakker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 2,
      "text": "Der vanke mange Stød og Smæk, der kan faae til at sukke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 2,
      "text": "Min Søn, vil Du i Verden frem, Du krybe maa og bukke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 2,
      "text": "Stort Selskab der i Skoven er, af Dyr paa to og flere;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 2,
      "text": "O Gud, hvor der er mange Gjæs, og andet saadant mere!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 2,
      "text": "Dumpappe, Ravne, Stær og Sligt, man seer i Høiden bygge;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 2,
      "text": "Den slette Urt i Solskin staaer, den bedste tidt i Skygge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 2,
      "text": "Igjennem Tjørn og Krat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 2,
      "text": "Han vandrer stille fremad, Dag og Nat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 2,
      "text": "Men hvad han søger finder han dog ikke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 2,
      "text": "Og Skoven leer kun af hans vaade Blikke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 2,
      "text": "Men Stjernen funkler klart paa Himlens Kyst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 2,
      "text": "En mægtig Tanke vaagner i hans Bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 2,
      "text": "»Her vil jeg,« siger han, »i Skovens Skygge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 2,
      "text": "Et Tempel bygge;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 2,
      "text": "Dets Altar smykkes skal med Vaarens grønne Blommer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 2,
      "text": "Maaskee da, Englen atter til mig kommer!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 2,
      "text": "– Snart hvælver sig den stolte Tempelhal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 2,
      "text": "Og Orglet bruser gjennem Skov og Dal.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 2,
      "text": "Forundret Alfen titter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 2,
      "text": "Bag Buskens grønne Gitter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 2,
      "text": "Den hele Skov",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 2,
      "text": "Istemmer høit den store Kunstners Lov;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 2,
      "text": "Men Ædderkoppen væver Dag og Nat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 2,
      "text": "Til han om Templet faaer en Vævning fat;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 2,
      "text": "Der komme flere, slige Recensenter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 2,
      "text": "Og uden Complimenter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 2,
      "text": "Giftige og fule,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 2,
      "text": "Det store Hele, De i Væv vil skjule.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 2,
      "text": "Natuglen glad med sine Vinger slaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 2,
      "text": "I Taage Templet staaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 2,
      "text": "Ei længer Guldet reent i Solen spiller,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 2,
      "text": "Det kan kun skimtes gjennem Sandheds Briller,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 2,
      "text": "Og de er’ tabt’ fra Løven indtil Myggen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 2,
      "text": "Kun Slangen løber om med dem paa Ryggen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 2,
      "text": "– I Glemsels Nat det bedste Blomster visner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 2,
      "text": "Det varme Hjerte isner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 2,
      "text": "Men Tiden kommer snart paa Stormens Vinger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 2,
      "text": "Da synker Taagen, Væven springer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 2,
      "text": "I Tjørn og Krat, nu Ædderkoppen skjælver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 2,
      "text": "Og Templet atter klart mod Himlen hvælver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 2,
      "text": "Da strømmer Skaren til, og jubler i det Høie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 2,
      "text": "Men længst er bristet alt den store Kunstners Øie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 3,
      "text": "Det toner over Tidens Bølgehav.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 3,
      "text": "Som Bautasteen staaer Templet paa hans Grav.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
