  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Langebeks kvart",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1562,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/LNGK29.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Wllffuenn staar paa stalle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc hand haffuer bitzell j munnde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "hesthenn løffuer saa witt om hauff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "saa wiit om haffsens grunde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: Hestene gale, menn hønszene riide. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Hestenne løber saa wiitt om hauff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "saa wiitt om hauffszenns grunnde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "oc geddenn hunn fløger saa høgtt wdj skye.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Geddenn fløger saa høgtt wdj skye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "hun taber enn feder wdj huer enn bye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "oc wlffuenn sider paa kircke-kam.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "Wllffuenn sider paa kircke-kam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "oc duenn løber oc bider lam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "ieg kom tiill saa wellbyrdigitt hus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "Ieg kom tiill saa wellbyrdigitt hus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "ther brende moncke oc sang woxlius,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "innd ieg gluggitt, oc wd ieg saa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "Innd ieg gluggitt, oc wd iegh saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "ther sadh enn kierlinng wdj enn wraa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 5,
      "text": "hunn kemtte grød oc røre j blor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "Hunn kemtte grød oc røre wdj bloer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 6,
      "text": "the skallede møer slaa wd therriis haar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 6,
      "text": "krøblingenn danntzede oc dommenn quadh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "Krøblinngenn dantzede oc dommenn quad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 7,
      "text": "thennd blinnde sad oc wouff guldlad;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 7,
      "text": "och ieg thett mett minne øgne saa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 8,
      "text": "Ieg thett mett minne øgne saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 8,
      "text": "att kirckenn hunn wdj prestenn laa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 8,
      "text": "degnenn huismid fast wdenn omkrinng.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 9,
      "text": "Monenn ligger wdj liungstack,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 9,
      "text": "oc skintig skinner saa wiide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 9,
      "text": "ieg smurde min hest, ieg salede minne støffle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 9,
      "text": "meg løstett icke lenger att biide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 9,
      "text": ":: Hestene gale, meden hønszene ride. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}