{
  "id": null,
  "title": "Marsk Stig",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift II",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVII34.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Marsti hand vogner om midie-nat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc taler hand til sin kiere:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "\"Och ieg haffuer nu drømmit saa underlig en drøm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Gud rade, huad det monne sede!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: Min edelig her, och hin unge Marsti! ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Oc ieg drømt om min racker smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "vaar vorden til vilde suinn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "och de vor udi min urter-gaard",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "och kaste vor urter omkring.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Oc ieg drømt om min store skib,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "vor bleffuen til liden smaa bod:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "och anckeren vor paa landet skøt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "der vor icke styre-mand paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Oc ieg drømt om min god hoffmendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "vaar kled i iern saa graa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "min hest slog mig under sig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "hand løber til vilden skoff.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "\"I tider quer, her Marsti!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "i giffuer det icke igienn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "och det er bønder oc borger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "vill føre eder skatten hiem.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "\"Det er icke bønder eller borger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "och det du siger saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "det er den unge konning,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "som ligger for Skandelborgh.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Och Marsti lader vebne siu hunder mend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "och alle udi iern saa graa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "och saa rider hand till Skandelborg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "alt som den herre skulle staa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Oc for rider unge her Marsti,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "hand vaar udi hoff saa trøst:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "och effter rider alle hans gode hoffmend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "och dennem skinner guld saa rød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Oc drottningen stander paa Skandelborg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "och sier hun ud saa vide:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "\"Hist seer ieg unge her Marsti,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "all-fremerst saa monne hand ride.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Oc mit opaa den borge-gaard",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "der axelet de deris skind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "och saa gaar de i hiffue-lofft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "for danske drottning ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Det vaar unge her Marsti,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "hand ind att døren tren:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "och det vor dantsken drottning,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "hun stander hannom op igien.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "\"Oc ver velkommen her, Dus van Huss,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "det siste der du mig saa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "da hede ieg unge her Marsti",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "der ieg udi din arm loe.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "\"Oc icke heder ieg Duss van Huss,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "i ver vellkomen her *:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "men ieg skal drottning i Danmarck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 12,
      "text": "dett skall eder liden fromme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "Oc det da suarde den kongens barn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "vor kled i kiortel rød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "\"Mig thyckis det att vere fuld-ond en buod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 13,
      "text": "att haffue for faders død!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "\"Och skam faa alle de stercke hollander,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "der mig det sige bad!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "\"Oc saa faa och alle din,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 14,
      "text": "der miig nu necter den sag!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "Oc det suarde den kongens barn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "och hand tog til sin kniff:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "\"Och du skalt anten aff landen rømme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 15,
      "text": "eller det skall kaste dit liff.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "\"Oc skal ieg aff landen rømme i aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "och ligge i skugge och skiull:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "da skall ieg min føde aff Danmarck hinte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 16,
      "text": "bode vinter, sommer och iull.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "Oc skal ieg nu aff landen rømme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "och ligge paa vanden hinde kolde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "da skal ieg saa mange til encker giøre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 17,
      "text": "och miest iblantt fruer saa bolde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "Oc Marsti lader lader vircke en huss saa hiff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "den skinner offuer mur och ring:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "och der ligger for baade tydsk och danske,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 18,
      "text": "och ingen kand hannom hussit affuinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 18,
      "text": ":: Min edelig her, och hind unnge her Marsti! ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}