{
  "id": null,
  "title": "105. O store GUd! hvad har dog dig",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
