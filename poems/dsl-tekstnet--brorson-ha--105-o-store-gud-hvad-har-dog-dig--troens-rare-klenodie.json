    "year_published": 1739,
    "url": "https://tekstnet.dk/books/brorson-ha_troens-rare-klenodie/107/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O store GUd! hvad har dog dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Bevæget til at trykke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "I mennisket saa yndelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Dit billeds ædle smykke?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Hvad var den ormesæk da riig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Den skabte siel sin skaber liig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "I sin fuldkomne lykke!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Det giør os nu din godhed klar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "At du, al godheds kilde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Dit liv, som du selv i dig har,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Os mildt meddele vilde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "At unde sielen arv udi",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Din egen herlighed, fordi",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Hun var din lyst til hende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Thi har du Adams stand saa stor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Og herlig vildet giøre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "At hand paa hele verdens jord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Dit rige kunde føre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Men selv allene vilde du,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Hans HErre, GUd og Konge, nu",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "I sielen boe og raade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Du selv din bolig smykket har,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "Skiøn uden til og inde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Hans krop var konstig, deylig, klar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Af lemmer, glands og sinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Fra døden fri i fryd og fred,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Og havde paradiis derved",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Til bolig, føde, glæde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Som denne helligdom for dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "Allene skulde være,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "Saa blinked' der saa underlig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "Din Guddoms glands og ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Usynlig var, som du, hans siel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "Som skulde evig lide vel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "Og døden aldrig smage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Hvor saae man det oplyste sind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "I himmel-fryd at smile,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "Da GUd gik selv i sielen ind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "At have der sin hvile;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "Da hun var fyldt med lys og ret,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "Og alle hendes kræfter net",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "Til HErrens priis forbundne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "Guds lyses straal der slog saa stærk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "Der funklede og brændte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "At hand GUds væsen, vey og verk",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 6,
      "text": "Og egenskaber kiendte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 6,
      "text": "Den giennemtrængde ham saa klar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 6,
      "text": "At Adam saae, i hvor hand var,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "Sit allerstørste gode.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 7,
      "text": "Hand brugte ingen skrift og prent,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 7,
      "text": "At finde dine veye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 7,
      "text": "Til dig hans gandske sind var vendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 7,
      "text": "Dig vilde hand kun eye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 7,
      "text": "Dit væsen var hans tiidsfordriv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 7,
      "text": "Din ville var hans lives liv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 7,
      "text": "Begyndelse og ende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 8,
      "text": "Hand elskte dig af hiertens grund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 8,
      "text": "Du varst hans største gode,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 8,
      "text": "Hans paradiis og frydens lund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 8,
      "text": "Hvori hans hierte boede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 8,
      "text": "I hvad hand giorde eller lod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 8,
      "text": "Din gierning ham for øyne stod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 8,
      "text": "Hvori hans hierte hviilte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 9,
      "text": "Hans sands var af GUds klarhed fuld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 9,
      "text": "Af kierlighed hans ville,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 9,
      "text": "Lod haant kun om med jordens guld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 9,
      "text": "Og verdens lyst at spille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 9,
      "text": "Thi viisdom, som det beste veed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 9,
      "text": "Og uforfalsket hellighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 9,
      "text": "Var sielens guld og glæde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 10,
      "text": "Hvad var dog sielen angenem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 10,
      "text": "For GUd i friheds sæde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 10,
      "text": "Hun var, o GUd, dit huus og hiem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 10,
      "text": "Dit paradiis og glæde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 10,
      "text": "Du varst i Adam, hand i dig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 10,
      "text": "Og skulde derfor idelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 10,
      "text": "I himlen med dig leve.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 11,
      "text": "Men ach! at Adam faldt fra GUd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 11,
      "text": "Og al hans lyst blev øde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 11,
      "text": "Hans viisdoms lys gik gandske ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 11,
      "text": "Og helligheden døde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 11,
      "text": "Fra dig hans sind blev plat forvendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 11,
      "text": "Du est for sielen ubekiendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 11,
      "text": "Reent fremmed, mist og borte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 12,
      "text": "Nu har al verden satans sind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 12,
      "text": "Og billede, desverre!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 12,
      "text": "Enhver er af naturen blind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 12,
      "text": "Og løber fra vor HErre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 12,
      "text": "De flye for GUd, som for forgift,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 12,
      "text": "Og søge, efter kiødets drift,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 12,
      "text": "Den skidne verdens glæde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 13,
      "text": "Ach tag dog denne blindhed hen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 13,
      "text": "Og lær os dig at kiende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 13,
      "text": "Lad ordet dog dit lys igien",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 13,
      "text": "I vore siele tænde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 13,
      "text": "Væk hiertet op ved Guddoms kraft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 13,
      "text": "Til livet, som vi før har haft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 13,
      "text": "At vi i GUd maae leve.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 14,
      "text": "Du har mig til dit billed' sat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 14,
      "text": "Din herlighed at love,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 14,
      "text": "Skal nu min siel, din egen skat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 14,
      "text": "I satans arme sove,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 14,
      "text": "Din egen skabning, liv og aand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 14,
      "text": "Skal den nu gaae i satans baand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 14,
      "text": "Og evig ham tilhøre?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 15,
      "text": "Hvad skal dog sielen som en ravn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 15,
      "text": "Det raadne mere smage?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 15,
      "text": "Red dog, o GUd! dit store navn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 15,
      "text": "Og hent min aand tilbage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 15,
      "text": "Hun flyver om i syndsens nat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 15,
      "text": "Og faaer din haand mig ikke fat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 15,
      "text": "Saa er jeg evig borte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 16,
      "text": "See! var din søn os dog saa troe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 16,
      "text": "Og i vort kiød sig klædde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 16,
      "text": "At hand os ud af satans kloe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 16,
      "text": "Og strikker vilde redde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 16,
      "text": "Os har du ham jo selv bered",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 16,
      "text": "Til viisdom og retfærdighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 16,
      "text": "Til hellighed og frelse.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 17,
      "text": "Lad sielen ved hans naade-cuur",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 17,
      "text": "Dog liv og sundhed finde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 17,
      "text": "Og hans Guddommelig natur",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 17,
      "text": "Os fast med dig forbinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 17,
      "text": "Hand blev en vey til GUd igien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 17,
      "text": "Vor sandhed, at vi lige hen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 17,
      "text": "Til livet kunde komme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 18,
      "text": "Giv os dit lys, at hver for sig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 18,
      "text": "Maa komme ret til live,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 18,
      "text": "Og da vi alting har i dig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 18,
      "text": "Os gandske dig hengive,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 18,
      "text": "At trænge med et opvakt sind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 18,
      "text": "Op u-ophørlig længsel ind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 18,
      "text": "Til dig, vort største gode.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 19,
      "text": "O! lad dit billede dog snart",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 19,
      "text": "Ved aandens kraft oprinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 19,
      "text": "At vi dit eget sind og art",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 19,
      "text": "Forklaret i os finde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 19,
      "text": "Lad sielen renses meer og meer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 19,
      "text": "Til hun sig fuld-forklaret seer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 19,
      "text": "I evig dig at skue.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
