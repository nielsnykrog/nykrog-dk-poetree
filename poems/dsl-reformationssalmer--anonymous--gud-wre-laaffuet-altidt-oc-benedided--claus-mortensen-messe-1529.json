    "printer": "Oluf Ulriksen",
    "place": "Malmø",
    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/claus-mortensen-messe-1529/25"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Gud wære laaffuet altidt oc benedided",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "som oss seelff haffuer bespiisedh * *",
      "part": false,
      "marginal_notes": [
        ".i. Cor. xi."
      ]
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Meth sitth legomme och meth siitth blodh/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "thet giffue oss herre gud til gode",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Kyrieeleison",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "* Herre veedh titth hellige legom",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "thet som aff thin modher Maria kom/",
      "part": false,
      "marginal_notes": [
        "Mathei. i.",
        "Luce. xxi.",
        "Gala. iiii."
      ]
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "titth hellige blod och thin død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "hielp oss herre aff all wor nød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Kyrieleyson",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "* Titth hellige legomme er for oss giffuet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "y døden ath wy schulle leffue",
      "part": false,
      "marginal_notes": [
        "Luce. xxii."
      ]
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Jngen staarre gaffue kunde han oss skiencke/",
      "part": false,
      "marginal_notes": [
        ".i. Cor. xi."
      ]
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "ther meth wy hannom och hans dødh betencke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Kyrie * * * *",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "* Kierlighed o herre tigh saare tuinghet haffuer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "atth tith blodh ey offuer oss klaffuer/",
      "part": false,
      "marginal_notes": [
        "Johannis. v.",
        "Hebre: xii.",
        ".i. Joh. i."
      ]
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "och betalet all wor skyld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "ath oss gud er vorden huld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Kyrie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "* Gudh y alle gaffuer oss wil velsigne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "ath vy paa hans vey schulle bliffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "J reeth och broderlig thro/",
      "part": false,
      "marginal_notes": [
        "Joh. xiii"
      ]
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "ath then mad kommer oss ey til wroo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Kyrie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "* Herre meth thin and oss aldrig forlad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "men tiig alltid paa kalle y allen stadh/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "ath thin arme christenhed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "maa leffue y fred och samdrectighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": "Kyrieeleison",
      "part": false,
      "marginal_notes": []
    }
  ]
}