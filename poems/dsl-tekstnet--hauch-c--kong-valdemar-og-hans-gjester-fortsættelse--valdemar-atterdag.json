{
  "id": null,
  "title": "Kong Valdemar og hans Gjester - Fortsættelse",
  "year_created": 1861,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Carsten Hauch",
    "country": null,
    "wiki": "Q688529"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Valdemar Atterdag",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1861,
    "url": "https://tekstnet.dk/books/hauch-c_valdemar-atterdag/006/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "I trende Dage varede den danske Konges Fest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Den ædle Marskalk sørged for hver indbuden Gjest;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Af Spiser og ædle Vine var Kongehallen fuld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Den rige Herre Volmer da spared ei sit Guld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Der var stor Lyst og Gammen, der tænktes ei paa Sorg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "De Ædleste med de Bedste bleve paa Kongens Borg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Og stedtes der til Hvile, da Dandsen var endt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "De Andre blev i Byen til Herberge sendt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Da bød Fru Helvig Tovelil til sig blandt sine Møer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Hun sagde: »Vi see Jer gjerne, skjøndt ei vi saae Jer før;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "I være skal velkommen blandt os paa dette Slot.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Mæled de danske Kæmper: »Fru Helvig taler godt.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Der redtes og for Hr. Vendelbo i Borgen et Leie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Han havde mødt Kong Volmer tilforn paa Kampens Veie;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Dog vilde ham Kongen vinde, thi han var kjæk og bold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Med hundrede Kæmper han red under Skjold.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Men denne Gang han bragte kun tyve Svende med,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Ham sendte Jyllands Adel at byde Kongen Fred,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Hans Svende troe ham fulgte, de traadte frem saa trygt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Deres Øine det viste, at ei de kjendte Frygt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Tidt havde Jyllands Adel trodset Danmarks Drot,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Den sagde: »Han vil beholde for sig hver Borg og Slot.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Derfor de mod Kongen havde stridt med væbnet Arm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "Nu sendte de Ridder Vendelbo at mildne Kongens Harm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Hr. Eckhard og Hr. Vendelbo da mødtes paa Vei,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "At begge ham gjested sammen, huede Volmer ei.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Venlig han dog dem modtog, han syntes glad og fro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "Da sagde Hr. Eckhard: »Du skal ham aldrig troe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "Snart er hans Tale hvas, snart den Honning er liig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Men hvordan han den dreier, han vil bedrage Dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "Han har Jer længe kuet, han skatter Jert Land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "Saalangt som Møller male til den tangklædte Strand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "Os han i Hjertet hader, skjøndt han kalder sig vor Ven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Alt, hvad til os er pantsat, han løser igjen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "Han jager i vore Skove, han fisker i vort Vand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "Hans Fader Kong Christopher var dog en bedre Mand.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "- »Nej«, svarede Hr. Vendelbo, »han var en ussel Drot,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Ikke dog skal Volmer os skille ved Borg og Slot,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "Men vilde han ei negte vor Adel dens Ret,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "Maatte vi selv det tilstaae, han hersker ikke slet.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "Den næste Morgen tidlig stod Volmer i Hal",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Mellem sine Gjester, han mælede: »Nu skal",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "I ikke tage Hermelin men Staalbrynier paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "Ei smykke Jer med Silke, men med de Hjelme graae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "Min Borgegaard sig strækker heel bred og dertil lang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Der kunne de Heste løbe, der er ei Pladsen trang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "De allerbedste Stridsmænd har ofte kæmpet der,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "Der vil i Dag vi lege med Spyd og med Spær.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "»Ja«, svared Hr. Vendelbo, han var i Ord saa brat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "»Den Leg er meget bedre end den, vi saae i Nat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "Først vil vi høre Messen, dertil den Ottesang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "Saa vende vi tilbage og prøve den Heltegang.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 13,
      "text": "Hvad dem den Herre raadte, blev strax sat i Værk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "De droge til Kirken i staalgraa Pandsersærk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "De sagde: »De Ord, han talte, var Guld og Penge værd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "At høre Messen styrker baade Brynier og Sværd.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "Kong Volmer blev paa Borgen, han fulgte dem ei,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Han sagde: »Jeg bliver hjemme, det er for lang en Vei,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "Jeg lytter helst til Klokkeklang fra Skovens vilde Sti,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "Og elsker kun den Munkesang, der snart er forbi.«",
      "part": false,
      "marginal_notes": []
    }
  ]
}
