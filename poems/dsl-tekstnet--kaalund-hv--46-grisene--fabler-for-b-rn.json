  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Skammer Jer, Børn, vort Liv er for kort,",
      "part": false,
      "marginal_notes": [
        "Speaker: Soen:"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "til vi med Lege tør fjase det bort.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": ". Vænne man maa sig til Alvor itide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Møddingen, ser I, det er det Solide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Hvis I ej høre Formaningen min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "blive I aldrig anstændige Svin.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Grisene agted paa Moderens Stemme;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "alle de havde det bedste Nemme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "lytted ej efter Fuglenes Sang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "grynted og died den Dag saa lang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Større Fornøjelse kjendte de ikke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "end faa sig for Tørsten en Taar at drikke.",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
