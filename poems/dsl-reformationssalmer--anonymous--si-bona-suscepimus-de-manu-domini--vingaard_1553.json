    {
      "id": 0,
      "stanza_id": 0,
      "text": "SI Bona suscepimus de manu Domini,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "mala autem quare non sustiniamus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Dominus dedit, Dominus abstulit, sicut Domino placuit, ita factum est,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "sit nomen Domini benedictum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Nudus egressus sum, de uentrematris meæ, nudus reuertar illuc.",
      "part": false,
      "marginal_notes": []
    },
    {
