  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Glaedeligh wylle wy alleluya syunghe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "meth kierlighedhszens begiærringh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Uort haab oc hierte til gud scal springhe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "meth sin hellighe naadhe oc miskundh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Som haffuer forløsth oss aff all wor syndh/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "til salighed och alskens trøesth/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "er han oss alle wprunden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Alltyngh szom leffuer paa iorden schall gudh ære",
      "part": false,
      "marginal_notes": [
        "Psal. cl"
      ]
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "rundhelighe hans naadhe kundhgiøre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Naadhe/ lyff størcke ther tiil kraffth/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "y christho haffue wy macth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "hæluedhe/ dødh och dieffuilszens woldh/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "han haffwer forderffweth for wor skyldh/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "wy tacke tiigh o herre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Gudh tiil sygher alle thennum syn naadhe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "som seg paa hannom forladhe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Ath gyffue trøsth modh synden affh syth godhe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "er handh thennom bestandigh alle maadhe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "wdhen suigh och all bedræghelighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "szom hans ordth forkynder visth/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "thin freedh offuer oss o herre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Gudh være loff och euigh ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "ther tiil gudh hans søn wor herre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Och ther til then verdighe andh/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "som christhne giør altydth bestandh/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "fraa euighed och till euighed/",
      "part": false,
      "marginal_notes": [
        "Roma. xvi"
      ]
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "haffuer wæridth och bliffue schal/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "for vden endhe",
      "part": false,
      "marginal_notes": []
    }
  ]
}