  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Frw Guner seeder y Spirre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hynder beedis beeggle saa dyre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": ":: Hynnde frw Gundder. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Hyndder beedder bieegle aff synndenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "thy rigest och thy yngist.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Hyndis beedis beeglle aff weestenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "dy riggest och thy beste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Hyndder bieedis till aff nuordenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "alle thy beedde thuorde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Hyndir beedder till aff østenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "thy rigest och thi thrøste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "Hynndder baad hertug Heenddrick,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "saa krancke skieebbenn thi saamell fieeck.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Hand hynd bad, och hand hynd fiennge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "storum och strid der-efter ginge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "Tthend herre skulde y lieedinng faarre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Raffuenngaard hand skulde hieeme werre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "\"Wogtte thu weell Bronsuig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "och halle-beeddere Slesuig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 5,
      "text": "Wogtte thu fuld weell y Spirre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "och miest frw Gunder hynnd dyrre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Haartugenn styrrer synn sneecke fraa land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Raffuengaard rider synn gaanger paa sannd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 6,
      "text": "Raffuenngaard axller skaarlagenn-skieend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "hand gaar i lofftt forr droningen ind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "\"Y skaall faa meg suer Aaddellring,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "saa bad Henddrick herre mynn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 7,
      "text": "\"Icke saagde mynn herre meg saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "thett sidste synde hand skildis meg fraa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "\"Kand ieg icke Aaadellring faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "daa skaall ieg eedder lygge opaa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 8,
      "text": "\"Daa lyff och lyuff, thett thu faar skaam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "ind er herre Gud langtt beder ind graam.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Heerttugenn kaam fraa lieeding hieem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "Raffuengaard gaar hynd vd igenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 9,
      "text": "\"Huor staar thett y Spyrre?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "huor lydder frw Guneld hynn dyre?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "\"Edders landde staar som dy stuode,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "frw Gunild haffuer saa ilde giortt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 10,
      "text": "\"Och icke weell ieg dynn ord nu thro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "ieg aldrig vthroskaab til hind suo.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "\"Ieg thett med myn øggen souo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "att erricke-bieespenn huoss hynd luo.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 11,
      "text": "\"Tthaa skaall ieg hynndder saa byrrig och slaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "dett ingenn mand hynd hiellpe maa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Hertug Henddrik axller skaarlagenn-skyeend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "hand gaar y lofftt for droningenn ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 12,
      "text": "Harttugenn innd aff dørrenn threend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "droningenn stuod hanom op igenn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "\"Weell-komenn, eddellig haare myn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "huor haffuer eedder y lieeddinng lidd?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 13,
      "text": "\"Weell haffdde meg lydd y lieedding y aaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 13,
      "text": "haffde dw icke saa ildde giortt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "\"Mynn naaddige herre, y sygger icke saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "rett aldrig ieg der thengtte opaa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 14,
      "text": "\"Saa weeslig du der thengtte paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "der errkee-bespenn huosz deg luo.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Saa sluo hand hynndder saa saarre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "slett ingenn hynder hieelpe thuordde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 15,
      "text": "Tther waar heelder ingenn indde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 15,
      "text": "for-vden thuo høffske quinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "For-vddenn thuo høffske wyffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "dy bad thend frw y lyffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 16,
      "text": "\"Mynn eddellig herre, y skaall thett icke thro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 16,
      "text": "Raffuengaard haffuer hynd løggenn paa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "\"Thaa skaall hun nu fly seg denn mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "y kriensenn thør med Raffuengaard staande.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 17,
      "text": "Offuen-hoffuett och baarre-fuod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 17,
      "text": "saa vseell kaam hun aff dørrenn vd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "Hun gick seeg till heelde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "som kieemper dy drak sneelde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 18,
      "text": "Droninggenn ind aff dørrenn thrennd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 18,
      "text": "alle stuod kieemper hynd op igenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "\"Er her nu ingenn inde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "som feegtt weell for quinndde?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 19,
      "text": "Alle stuod kieemper och thuaffued,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 19,
      "text": "for-vddenn Miemerinng, suaridtt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "\"Ieg thimtte y edders faaders gaard",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "weell y fulde femttenn aaar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 20,
      "text": "Ieeg suo edder aldrig saa vseell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 20,
      "text": "saa baar om edders axell.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "Ieg suo edder aldrig baare-fuod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "paa den grøne greese-rod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 21,
      "text": "Some daa gaff hand giøbbind guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 21,
      "text": "och snuome daa gaff hand skoller fuld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 21,
      "text": "Raffuenn-gaard gaff hand allder-mieest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "men hand haffuer sueegenn edder alder-først.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 22,
      "text": "Allttyd suod ieeg weed ennde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 22,
      "text": "som alle guodde gaaffuer weendde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 22,
      "text": "Nu weell ieg for edder y kreendsenn gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 22,
      "text": "om y weell meg suerd Aadellring faa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 23,
      "text": "\"Alltt om du welltt y krindsenn gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 23,
      "text": "saa weell skall thu suerd Addellring faa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 23,
      "text": "Tthi skreff krindsenn paa denn moold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 23,
      "text": "thy gick der-y meed suerd och skiold.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 24,
      "text": "\"Nu skalltt thu saa suere meg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 24,
      "text": "att thu weedst icke suerd Aaadellring.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 24,
      "text": "\"Saa hiellp meg Gud paa mynn thro:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 24,
      "text": "ieg weed icke vddenn grebb for-offuen iiordt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 25,
      "text": "Nu skaalltt thu saa suerre iggenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 25,
      "text": "att thu west icke suerd Saaderinng.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 25,
      "text": "\"Saa hieellpe meg Gud foroffuenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 25,
      "text": "som ieg weed icke suerd Swdde-wynndtt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 26,
      "text": "Tthett første huog, der Raffuengaard huog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 26,
      "text": "daa huog hand Meemerings suerdtt y thuo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 26,
      "text": "Thett melltte heerttugenn som hand stuod:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 26,
      "text": "\"Nu matte thu siee denn gierning dw giordde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 27,
      "text": "Hun suaridtt: \"Ieg haffuer icke deenn gierning giortt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 27,
      "text": "ind-dog mynn sølligge keemppe saa fuor.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 27,
      "text": "Thett første huog, ther Mømering huog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 27,
      "text": "tha hog hand Raffuengaards suerd y thuo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 28,
      "text": "\"Du holltt op, Mymerring, hog icke meeg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 28,
      "text": "men ieg kaand myn skuo tuing.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 28,
      "text": "Raffuengaard nedder ad iorddenn løb,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 28,
      "text": "suerd Swd-wynnd hand for seeg skøød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 29,
      "text": "\"Du haffuer nu dieeg om mieen suoritt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 29,
      "text": "dynn søllig seell hun er forlorenn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 29,
      "text": "Dett første huog, der Raffuengaard huog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 29,
      "text": "daa huog hand Memerings suerd y thuo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 30,
      "text": "\"Holtt op, Raffuengaard, huog icke meeg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 30,
      "text": "men ieg kaand myn skoo tuing.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 30,
      "text": "Miemering needer till iorrdenn leebb,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 30,
      "text": "suerd Aadellring hand for seeg skøød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 31,
      "text": "\"Nu haffuer du dieg om myeen suorenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 31,
      "text": "dynn søllig seel hun er forlorenn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 31,
      "text": "\"Ieg haffuer meg icke om mierenn suorit:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 31,
      "text": "ieg west icke vdden greff for-offuen iordtt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 32,
      "text": "Tthett første huog, der Miemering huog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 32,
      "text": "daa huog hand Raffuengards suerd y thuo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 32,
      "text": "Thett anditt huog, der Miemerring huog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 32,
      "text": "da huog hands Raffuengaard hallss y thuo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 33,
      "text": "\"Sie nu, kieer herre mynn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 33,
      "text": "huor hand fuor med keempen dynn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 33,
      "text": "Myn eddellig herre, weell y throff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 33,
      "text": "att Raffuengaard haffuer meg løffuett paa?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 34,
      "text": "Herr Heennddrick klaper hynder weed huiden kinnd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 34,
      "text": "\"Forlaad meg thett, allerkieereste mynn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 34,
      "text": "Miemerrig kaam der staalkeenn hiem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 34,
      "text": "med blodig hoffued och brøden bienn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 35,
      "text": "\"Frw Guner, giør for edders faadders sieell:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 35,
      "text": "gyff meg brød, men ieg maa løffue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 35,
      "text": "\"Hørdu, Miemering, huad ieg sigger dieeg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 35,
      "text": "dinn saard skall ieg laadde leege deeg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 36,
      "text": "Alle dynn dage ieg giffuer dieg brød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 36,
      "text": "seelliff skallt thu slidde skaarlagenn rød.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 36,
      "text": ":: Sagde G. Gundder. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}