{
  "id": null,
  "title": "110. Christoffer, Eriks bror",
  "year_created": 1495,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Rimkrøniken",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1495,
    "url": "https://tekstnet.dk/books/anon_rimkroeniken/113/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Iegh kan thet nw fulwel forstaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Eehwort en man seg wendher,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "tha wil thet hannum gherne saa gaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "han hendher alth som han trendher.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "fra Gutz byrd gangne waaræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "tijl Danmarks konning ieg kesther waar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "ath ieg skullæ thet forsware.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Marcgreffuen som wor paa Brandeborig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "oc giorde theris brøllop paa Wordenborig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "meth stor prijs, hedher och ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "Tijl klosther giorde ieg Knardrop gaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "Wor Frwe tijl loff och ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "effther hwn mwn Cristum bære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "Siden tog ieg meg saa onth eth sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "thywær ath ieg saa giorde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "paa rætwijsshed lade ieg ey wind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "Riddherskabet lade ieg megh imod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "thet kom meg lidheth tijl baade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "almwen ieg meg beskatte lod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 5,
      "text": "saare wdh offuer syn maade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "i allæ the maade the kunne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 6,
      "text": "The giorde meg bode skade oc meen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 6,
      "text": "lith goth thi ther i wunde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "I Tornborigh grebæ the Eric, myn søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 7,
      "text": "Thee reddes ey trw, the hørde ey bøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 7,
      "text": "the giorde hannum last och neese.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 8,
      "text": "I Hadhersløw sætte the hannum i torn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 8,
      "text": "han nødh ey annen nade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 8,
      "text": "i lang tijd mod oss bode.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 9,
      "text": "Tha ieg fick spurd thet gik hannum saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 9,
      "text": "ieg tog hwad ieg hade rede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 9,
      "text": "Hædhen tijl Tydeskæland lod ieg staa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 10,
      "text": "Men danskæ fulde tijl the greffwer too",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 10,
      "text": "som ther i Holtzen waare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 10,
      "text": "Gered och Hans, the hellede froo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 10,
      "text": "ath the skullæ them forsware.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 11,
      "text": "tijl Siæland wthi mith rigæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 11,
      "text": "The wore meg falske hwer oc en,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 11,
      "text": "thi mottæ ieg annen tijd wigæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 12,
      "text": "Tha fik ieg ath see for wthen drwt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 12,
      "text": "Raffnen hwggher ey annens øwe wdt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 12,
      "text": "eehwad the skrigæ eller galæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 13,
      "text": "Paa begge sidher ther tha tydeskæ wor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 13,
      "text": "thy willæ the ickæ stride.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 13,
      "text": "aff righeth tha mottæ ieg glide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 14,
      "text": "Tha danskæ hade meg dreffuet wdh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 14,
      "text": "meth greffuennes hielp forneffnde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 14,
      "text": "modh them tha wende the theris spiwdh;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 15,
      "text": "I theris land fore the genesten ind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 15,
      "text": "och iwderne mest the nørræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 15,
      "text": "the Gottrop belaffde meth macth oc sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 15,
      "text": "och Hadersløff wunde the førræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 16,
      "text": "och sloo oc fangede ther mange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 16,
      "text": "Han sende them tijl syne fogede hiem;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 16,
      "text": "ther hade the dawenne lange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 17,
      "text": "Siden bleffue the tydeskæ herris ogh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 17,
      "text": "The screffue meg tijl i breff oc bogh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 17,
      "text": "the mwnne thet saare kære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 18,
      "text": "The hade ther bode land oc slot",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 18,
      "text": "i menighe Danmarks rigæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 18,
      "text": "Inghen lode the wære theris ligæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 19,
      "text": "The som tæncte ath bliffue wedh macth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 19,
      "text": "om the kundet meg fornætræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 19,
      "text": "the vslinge bleffue mod theris acth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 20,
      "text": "The som wore fulglade ther tijl",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 20,
      "text": "ath the kunne meg wddriffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 20,
      "text": "ieg thet forsennen sye wil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 20,
      "text": "effter meg lode the først scriffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 21,
      "text": "ath ieg skullæ them forsware",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 21,
      "text": "for greffue her Gerd, theris størstte wuen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 21,
      "text": "forthi the reddis hannum saare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 22,
      "text": "Siden ieg kom tha i righeth ind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 22,
      "text": "thet kunne ey gaa wdaff myn sind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 22,
      "text": "at the dreffue meg aff lande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 23,
      "text": "Thi lod ieg tha giøre eth swawerskab",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 23,
      "text": "meth greffuen paa theris skade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 23,
      "text": "som hertugen i Sassen før hade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 24,
      "text": "Siden tog ieg paa eth stort wrad:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 24,
      "text": "I Børlund greff ieg bisp tyge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 24,
      "text": "Och sætte'n i fengsel oc giorde hannum hod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 25,
      "text": "Før han kom wdh tijl pawens gaar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 25,
      "text": "och righeth i forbud sætte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 25,
      "text": "Thet wor ther i paa ottæ aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 25,
      "text": "før thet kom aff then trætte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 26,
      "text": "ath wij kunne ey fordrawes.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 26,
      "text": "Thi dreff myn søn hans dotther fra segh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 26,
      "text": "meth henne kunne han ey hawes.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 27,
      "text": "Paa Lohed møttes wij syen i krij,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 27,
      "text": "thy ieg hade mange tydeskæ therij",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 27,
      "text": "som ey willæ trolige stande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 28,
      "text": "Saa flyde ieg tha tijl Loland ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 28,
      "text": "i Saxkøben ieg greben worde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 28,
      "text": "bode danskæ och tysdkæ thet giorde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 29,
      "text": "Om syer kom ieg ther wdh meth nød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 29,
      "text": "tijl Falster lod ieg meg føre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 29,
      "text": "Ther bleff ieg gennesten paa Nykøbyng død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 30,
      "text": "Twsende och tryhundrede aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 30,
      "text": "och ther tijl xi och tiwæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 30,
      "text": "effther ath Gutz søn fødher waar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 30,
      "text": "ieg wil thet ingelunde liwe.",
      "part": false,
      "marginal_notes": []
    }
  ]
}