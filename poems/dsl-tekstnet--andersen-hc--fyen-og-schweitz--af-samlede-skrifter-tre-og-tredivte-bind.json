  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Odins Ø med Palnatokes Grav",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Med susende Skove ved det rullende Hav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Fyen, hvor jeg fødtes til Tankens Lyn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Mellem vilde Roser og Humleduft!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Velsignet dit Solskin, velsignet din Luft!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Mægtige Schweitz med Gletschernes Bulder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Du minder mig sært om, naar Nordsøen ruller.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Schweitz! Wilhelm Tells og Skyernes Land!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Genfersø med den blomstrende Strand!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Skal her mit Støv under Hængepilen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Blomstre og groe og dog finde Hvilen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Medens mit Livs Lyn bevares i Væren? –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Gud være takket! Ham evig Æren!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
