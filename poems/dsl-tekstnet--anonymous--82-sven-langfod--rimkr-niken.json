  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Iegh wor i Normandieland",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "tha Knudh, myn fadher, døde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Tha ieg thet sporde, ieg tog paa stand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "meg hiem tijl lande ath møde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "som fadher for meg mwnne wæræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Saa længæ ieg Danmarks krone baar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "meth hedher och meth stor æræ.",
      "part": false,
      "marginal_notes": []
    }
  ]
}