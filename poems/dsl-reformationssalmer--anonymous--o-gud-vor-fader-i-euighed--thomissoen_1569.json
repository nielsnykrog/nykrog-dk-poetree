  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Gud vor Fader i euighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "vden all begyndels oc ende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Jeg tror paa dig oc visselig ved/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "som scrifften giffuer til kiende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "At du haffuer met din Guddoms krafft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Himmel oc Jord oc alting skabt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Den første Mand oc Quinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Jeg tror ocsaa paa Jesum Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Gud Faders Søn allene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Vndfangen aff den Hellig Aand vist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Fød aff Jomffru hin rene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Maria heder den Jomfru skøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Som hand tog aff sin Manddoms køn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Vor Frelsermand allene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "J Bethlehem fødde Maria sin Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Hans Hellig velsignede Moder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Til hielp oc trøst all Menniskens køn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Vilde hand da være vor broder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Nu er Christus baade Gud oc Mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Det bør oss alle at tro for sand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Om wi ville salige vorde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "J Jøde Land gick hand omkring/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "Guds ord at Predicke oc lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Met sine Mirackel oc vnderlige ting/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Beuiste sig Gud at være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Oc Lazarum bad hand opstaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Der hand vilde til sin pine gaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Judas monne hannem forraade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Der nu Christus Guds eniste Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "Gaff sig i Dødens fare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "Langfredag nat hand giorde sin bøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "Met sued oc Blodige taare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Da bleff hand fangen i Vrtegaard/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "Aff Judas oc den Jødeske skar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "Apostlene monne fra hannem vige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "For Menniskens skyld tro wi nu fast",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "Loed hand sig fange oc binde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "At hand der met aff Synd oc last",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "Vilde fri oss fra vore Fiende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "Fra Helffuedis pine oc euig død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "Som Adam vdi Paradiss brød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "Guds bud vnder euig pine.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "De sende hannem først ind til Annas/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "Der møtte hannem sorrig oc møde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "Oc strax der nest til Caiphas/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 6,
      "text": "De hastede met hannem til døde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 6,
      "text": "Met løgn oc falsk oc stor wret/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 6,
      "text": "Som de hannem giorde den gantske nat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "Peder monne hannem forsuære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 7,
      "text": "Om morgenen vel betimelig tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 7,
      "text": "Det første de vilde da giøre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 7,
      "text": "Jesum monne de samdrectelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 7,
      "text": "Hen til Pilatum føre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 7,
      "text": "De løye paa hannem for Ræt oc dom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 7,
      "text": "De sagde hand actede icke Keyseren aff Rom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 7,
      "text": "Det maatte Pilatus høre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 8,
      "text": "Der hand forstod den sag i grund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 8,
      "text": "Som de for hannem berette/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 8,
      "text": "Viste hand vel at den Jødiske fund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 8,
      "text": "For had oc affuind vilde trette/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 8,
      "text": "Mod Jesum den wskyldige mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 8,
      "text": "Hoss huem hand ingen døds sag fand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 8,
      "text": "Dog loed hand hannem hudstryge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 9,
      "text": "Hans tienere toge hannem ind met hast/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 9,
      "text": "Kalde sammen den gantske Rode/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 9,
      "text": "En Krune aff Torn giorde de vel fast/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 9,
      "text": "Den sette de paa hans Hoffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 9,
      "text": "De spøtte oc sloge oc giorde hannem vee/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 9,
      "text": "Gaffue Rør i haand oc fulde paa knæ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 9,
      "text": "En Konge de monne tilbede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 10,
      "text": "Saa kaste de offuer hans blodige krop",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 10,
      "text": "Jt gammelt Purpur klæde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 10,
      "text": "Met spe oc spot reyste de hannem op/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 10,
      "text": "Pilatus loed hannem vdlede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 10,
      "text": "Da stod tilsammen den Jødiske hob/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 10,
      "text": "De fulde hannem offuer met skreg oc rob.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 10,
      "text": "Lad hannem kaarsfestis til døde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 11,
      "text": "Pilatus suarede aff sin forstand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 11,
      "text": "Jeg kand icke andet fornemme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 11,
      "text": "End Jesus er en wskyldig Mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 11,
      "text": "Huor for skal ieg hannem dømme?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 11,
      "text": "Da robte de Jøder huer oc en/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 11,
      "text": "Oc sagde/ du est icke Keyserens ven/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 11,
      "text": "Om du lader hannem vndkomme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 12,
      "text": "Her maatte Pilatus giffue sig tafft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 12,
      "text": "Der hand fick Keyseren at høre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 12,
      "text": "All hans Retfærdighed miste sin krafft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 12,
      "text": "Oc hand loed sig forføre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 12,
      "text": "Oc fryctede mere for Keyserens had/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 12,
      "text": "End for Christi retfærdige Sag/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 12,
      "text": "Som mange dis værre end nu giøre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 13,
      "text": "Pilatus tode sine hender i Vand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 13,
      "text": "Wskyldig vilde hand da være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 13,
      "text": "Oc dømde saa den wskyldige Mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 13,
      "text": "Som Jøderne monne begære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 13,
      "text": "Jeg er wskyldig i denne Mands blod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 13,
      "text": "De robte igen met it friit mod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 13,
      "text": "Hans Blod skal offuer oss komme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 14,
      "text": "De ledde hannem vd til Hoffuitpande sted",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 14,
      "text": "Sit Kaarss maatte hand selff bære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 14,
      "text": "En stor Almue da fulde hannem met/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 14,
      "text": "Som græde oc gaffue sig saare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 14,
      "text": "Du Sions Daatter græd icke for mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 14,
      "text": "Men du maat nu vel græde for dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 14,
      "text": "For din wlycke vil komme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 15,
      "text": "Oc der de komme til Golgatha/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 15,
      "text": "Jesum monne de Kaarsfeste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 15,
      "text": "Mellem to Røffuere hengde hand da/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 15,
      "text": "Det skede alt for vort bæste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 15,
      "text": "Hand robte paa Kaarssit met høyer røst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 15,
      "text": "O Fader forlad dem deris brøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 15,
      "text": "De vide icke huad de giøre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 16,
      "text": "Der stod omkring den menige mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 16,
      "text": "De spottede hannem mangelunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 16,
      "text": "Den suare pine taalde hand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 16,
      "text": "Vdi tre gantske stunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 16,
      "text": "Saa gaff hand strax der op sin Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 16,
      "text": "Oc den befalede sin Fader i haand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 16,
      "text": "Oc døde for Synderne vore.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 17,
      "text": "Der hand vaar død/ strax en aff dem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 17,
      "text": "Hand loed sig icke fortryde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 17,
      "text": "Men tog it Spiud oc traadde der frem/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 17,
      "text": "Stack op i Christi side/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 17,
      "text": "At Spiudet i hans Hierte stod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 17,
      "text": "Der vdrand baade Vand oc Blod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 17,
      "text": "Sancte Hans det klarlig bescriffuer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 18,
      "text": "Joseph aff Arimathia kom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 18,
      "text": "En dristelig gierning hand giorde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 18,
      "text": "Hand bad Pilatus strax der om/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 18,
      "text": "At hand maatte Christum iorde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 18,
      "text": "Saa tog hand Christi Legem der aff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 18,
      "text": "Oc lagde det i sin egen graff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 18,
      "text": "Der til hialp Nicodemus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 19,
      "text": "Christus oc ned til Helffuede foer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 19,
      "text": "At tage til fange oc binde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 19,
      "text": "Den gantske Dieffuelens mact saa stor/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 19,
      "text": "Der offuer hand seyer monne vinde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 19,
      "text": "Hand krystede hans hoffuit oc Helffuede brød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 19,
      "text": "Forhuærffuede det met sin pine oc død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 19,
      "text": "At wi skulde aldrig fordømmis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 20,
      "text": "Paa tredie dag i morgen stund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 20,
      "text": "Christus stod op aff døde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 20,
      "text": "Met Legem oc Siel baade karsk oc sund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 20,
      "text": "Frelste oss aff all vor møde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 20,
      "text": "J fyrretiue dage lod hand sig see/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 20,
      "text": "Oc for sin Apostle sig betee/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 20,
      "text": "J Verden hand dem vdsende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 21,
      "text": "Saa foer hand op til Himmelen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 21,
      "text": "Der de fyrretiue dage haffde ende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 21,
      "text": "Oc strax her ned til bage igen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 21,
      "text": "Hand oss den Hellig Aand sende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 21,
      "text": "Nu sidder Jesus baade Gud oc Mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 21,
      "text": "Alt hoss sin Faders høyre haand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 21,
      "text": "Der monne hand for oss bede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 22,
      "text": "Der fra er hand oc ventendis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 22,
      "text": "At dømme baade leffuendis oc døde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 22,
      "text": "De gode bliffuer tilskenckendis",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 22,
      "text": "Det euige Liff oc glæde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 22,
      "text": "De onde faa hannem der oc at see/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 22,
      "text": "Saa stødis de ned til euig vee/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 22,
      "text": "Vdi Helffuedis Jld at brende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 23,
      "text": "Jeg tror oc paa den Hellig Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 23,
      "text": "Som mig skal styre oc raade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 23,
      "text": "Forøge min tro oc ret forstand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 23,
      "text": "Oc giffue mig aff sin naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 23,
      "text": "At ieg skal rettelig frycte Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 23,
      "text": "Samtycke hans villie oc holde hans bud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 23,
      "text": "Min fattige Neste til gode.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 24,
      "text": "Der til er oc den hellig Aand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 24,
      "text": "Oss arme Menniske til gode/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 24,
      "text": "En hielper oc husualermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 24,
      "text": "At giffue dem trøst oc glæde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 24,
      "text": "Som kalde paa hannem i sorrig oc nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 24,
      "text": "Met stadelig tro i liff oc død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 24,
      "text": "Dem vil hand aldrig vndfalle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 25,
      "text": "En hellig Kircke oc Christen samfund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 25,
      "text": "Tror ieg i Verden at være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 25,
      "text": "Det Folck som pinis i allen stund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 25,
      "text": "For Christi ord oc lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 25,
      "text": "De haffue tilsammen en tro en daab/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 25,
      "text": "Til Christum sette de all deris haab/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 25,
      "text": "Hand er deris salighed allene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 26,
      "text": "Jeg tror oc veed det visselig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 26,
      "text": "At Gud vor Himmelske Fader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 26,
      "text": "Hand er oss mild oc miskundelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 26,
      "text": "Oc oss vor Synd forlader/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 26,
      "text": "For eniste Christi Pine oc Død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 26,
      "text": "Giør hand oss fri aff all vor nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 26,
      "text": "Thi kand oss aldrig skade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 27,
      "text": "Jeg veed ieg skal igen opstaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 27,
      "text": "Enddog de mig begraffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 27,
      "text": "Oc wforkrenckelig her fremgaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 27,
      "text": "Jngen tuil der paa kand haffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 27,
      "text": "Det er aff Guds besynderlig krafft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 27,
      "text": "At alle de Menniske som hand haffuer skabt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 27,
      "text": "Skulle da opstaa aff døde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 28,
      "text": "Det er min trøst oc stadelig tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 28,
      "text": "At Christus min kiere broder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 28,
      "text": "Skal giffue mig det euig Liff oc ro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 28,
      "text": "Hoss Gud min Himmelske Fader/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 28,
      "text": "Til euig tid met glæde oc fryd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 28,
      "text": "Effter denne forgengelig timelig død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 28,
      "text": "Hand lader mig aldrig forfare.",
      "part": false,
      "marginal_notes": []
    }
  ]
}