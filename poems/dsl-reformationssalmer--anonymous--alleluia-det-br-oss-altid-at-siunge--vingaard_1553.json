  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "ALleluia det bør oss altid at siunge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Herren loffue oc prise aff hiertens grund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Thi hans miskund haffuer vore Synder alle vdslet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "all kærlighed oc gaat gaffuer han oss betet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "⁕ Alt det som liff haffuer/ det skal Gud loffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "for hans megne miskund oc store naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Han haffuer oss giffuit venskaff/ styrcke/ Liff oc krafft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "han haffuer forderffuit Synd/ Død och all Dieffuelens mact",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "⁕ Gud haffuer dem som tro paa hannem iæt naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "vil dem hielpe oc trøste i all vaade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Hiemmerigis Rige vil han dem alle giffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Det holder han vist/ di han kan icke liuge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "⁕ Gud Fader dig vere loff oc ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "met din Søn Jesu Christ vor Frelsere kære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Desligest den Helligaand aff oss alle sammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "wi tacke dig nu oc euindelige Amen",
      "part": false,
      "marginal_notes": []
    }
  ]
}