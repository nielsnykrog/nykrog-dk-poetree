  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "The som pleyde ath giffue meg skath",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "twingdæ ieg ighen saa rath",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "meth skat tijl meg ath faaræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "I Ængæland fik ieg kristendom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "the meg ther troen kændæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "the skullæ meg klærkæ sændæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "End før the budh the komme igen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "tha wor ieg laweth wndher tørffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "aff soth oc ey aff andeth meen.",
      "part": false,
      "marginal_notes": []
    }
  ]
}