  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "– – leicht ging er aus dem Leben –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Sein Bißchen Geist, das war leicht aufzugeben.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Forleden Aften – saadan Klokken ni,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Var det forbi!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Alt længe følte vi det Enden blev,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Om selv din Fader dig Recepter skrev.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Du arme Barn, født i det kolde Nord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Du var for let og tynd for denne Jord!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "En Aftenstorm dig fløitede ihjel –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Farvel! Farvel!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Høit paa din Grav skal blæses med Trompeter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Vee, tretten Gange Vee de yngere Poeter!!!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
