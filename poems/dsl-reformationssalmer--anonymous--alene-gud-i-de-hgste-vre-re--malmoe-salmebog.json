  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "ALene Gud i de høgste være ære",
      "part": false,
      "marginal_notes": [
        "Luce ii"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc tack for sin store naade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Der fore ath oss nu aldrig mere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "kan røre siælens skade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Gud haffuer til oss nu ingen had/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "men her er nu fred vden all vlad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "All feyde haffuer nu fongit ende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Vi loffue prise och tilbede dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "for din ære wi tacke dig/",
      "part": false,
      "marginal_notes": [
        "Luce ii"
      ]
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "ath du Gud fader i euighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "regere oss oc vilt acte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Gantske vbegribelig er din mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "all werden hun er dig vnderlagt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "wel er oss for saadan Herre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "O Jesu Christe Gudz enborne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "en Søn vor hiemmelske faders/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "forløst haffuer du de forlorne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "ath Gud dem velbehager/",
      "part": false,
      "marginal_notes": [
        "Mat i oc ii i Petri ii"
      ]
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Gudz hellige lam vor herre oc Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "tag til dig vor skyld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "gør for oss bod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "forbarme dig offuer oss arme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "O Helligand almectiste Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "dw aller ypperste trøstere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "aff dieffuelsens wold led dem wd/",
      "part": false,
      "marginal_notes": [
        "Joan. i iiii oc xvi"
      ]
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "der Jesus Christus forløste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "formedelst stor martyr oc bitter død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Affuent fra oss all iemmer oc nød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Der til wi oss forlade",
      "part": false,
      "marginal_notes": []
    }
  ]
}