  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "I Danmark Navnet er Fyrstinden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "I hvem et Folk beundred’, elsked’ Kvinden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Du ligne hende: Slægter vil Dig prise,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Fornyet, deiligt, lyde Vise!",
      "part": false,
      "marginal_notes": []
    }
  ]
