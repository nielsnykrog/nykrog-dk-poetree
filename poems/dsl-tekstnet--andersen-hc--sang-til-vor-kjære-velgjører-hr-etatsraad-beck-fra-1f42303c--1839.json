  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1839,
    "url": "https://tekstnet.dk/books/andersen-hc_sang-til-vor-kjaere-velgjoerer-hr-etatsraad-beck-fra-skole-ungdommen-paa-frederiksvaerk/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Nu fyger Sneen, Nordens Storme komme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Den nøgne Stilk er Blomstens Monument;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Dog Hjertets Blomster-Flor er aldrig omme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "En Farve-Pragt, som dens har Ingen kjendt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Og Hjertets Blomster ville Dig vi bringe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Hver Blomst blev Toner, Krandsen selv en Sang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Vi veed, du vil ei finde Gaven ringe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Den bragtes Dig, dertil vi følte Trang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Et Livets Efteraar vi skal opleve,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "En Høst, hvor Frugten synligt bliver bragt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Den Frugt, de Renter, Du har Ret at kræve",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "For hvad Du i vor Tanke har nedlagt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Gid Verdens Riigmænd halvt Dig maatte ligne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Da skete der, end meget Godt og Stort.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Vor Herre Dig og dine Børn velsigne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "For Alt det Gode Du mod os har gjordt!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
