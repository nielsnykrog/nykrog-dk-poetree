  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Sig Himlen hvælver saa reen og klar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Iisblomster fryse paa Rudens Glar;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "I Solens Flamme saa smukt de staae;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "En Yngling sidder og seer derpaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "Men som han paa de Blomster seer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "To Pige-Øine derude leer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Saa skjønne Blomster han aldrig saae;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "To Martsvioler saa smukke blaae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "Iisblomsten smelter ved Kindens Brand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "– Vor Herre hjælpe den unge Mand!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
