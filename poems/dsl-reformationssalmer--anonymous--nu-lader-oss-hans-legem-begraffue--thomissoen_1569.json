  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Nu lader oss hans Legem begraffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc ingen tuil der paa haffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "hand skal paa den yderste dag opstaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "oc wforkrenckelig her fremgaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Jord er hand oc skabt aff Jorden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Til Jorden bliffuer hand nu igen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Oc aff Jorden skal hand opstaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Naar Gud lader sin Basun gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Hans Siel skal leffue til euig tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Hoss Gud/ som hende haffuer befrid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Fra syndsens baand oc helffuedis nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Ved sin eniste Søns blod oc død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Hans jammer armod oc ælende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Er kommen til en salig ende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Hand haffuer dragit Christi Aag/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Er nu død/ men hand leffuer dog.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Sielen leffuer vden all klage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Legemit soffuer til Dommedag/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Oc der vil Gud det forklare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "J euig glæde det beuare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Hand vaar i denne Jammerdal/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Nu boer hand i den euig Sal/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "J hederlig glæde oc bolig skøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "Skinner langt klarer end Solen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "NV lade wi hannem soffue i fred/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Wi gaa nu huer hiem til sit stæd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Oc skicke oss der til betiden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "Thi døden kommer oc er ey seen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "Der til hielpe oss Christus vor trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Som met sit Blod haffuer oss igenløst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "Fra Dieffuelens mact oc euig vee/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "Hannem ske loff priss oc ære.",
      "part": false,
      "marginal_notes": []
    }
  ]
}