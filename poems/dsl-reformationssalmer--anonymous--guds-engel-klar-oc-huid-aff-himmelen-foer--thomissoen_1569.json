  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Guds Engel klar oc huid/ aff Himmelen foer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oplod graffuen oc forfærde Vecten met Jordskel stor.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Aarlig om morgen der Soel gick op/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "ginge Quinderne til graffuen at smøre Jesu døde krop.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Engelen i Graffuen trøstede dem alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "hand bad dem ey frycte/ men glade være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Thi Jesus aff Nazareth vaar opstanden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "den de søgte i dødsens baande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Det siger hans Disciple foruist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "J Galilea de see den Christ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "Maria græd oc i Graffuen saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "stæden som Jesu Legem laa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "bag sig hun saa en leffuendis Mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "haffuer du icke (sagde hun) taget hannem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "Jesus det vaar/ Thi sagde hand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "Sige Maria mine huer Mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "at ieg vil til Himmels fare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "til min oc eders Herre Gud oc Fader/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "mine Brødre skulle i være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "oc min Faders børn kiere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Quinderne til Graffuen komme igen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "der maatte de atter see Engle siun.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 6,
      "text": "Saa vist vilde Gud oss det være kiend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 6,
      "text": "at Christus for oss hid vdsend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "leffuer nu vden all ende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 7,
      "text": "Engelen sagde/ ah frycte ey saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 7,
      "text": "Thi ieg lader eder nu god tiende forstaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 7,
      "text": "Christus den Kaarsfeste den i søge hoss de døde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "er nu opstanden fra all møde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "kommer oc seer stæden der hand i laa/ Graffuen er tom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "hand leffuer i krafft som en Konning from.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 8,
      "text": "",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 9,
      "text": "Jesus kom oc sagde selff det samme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 9,
      "text": "Helsel gode quinder/ værer ey saa bange/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 9,
      "text": "Tror en leffuendis Mand/ det see oc føle i vel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 9,
      "text": "ieg haffuer paa mig baade krop oc siel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "Thi siger mine Brødre/ at de sig ey møye/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Jeg vil dem i Galilea møde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 10,
      "text": "",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 11,
      "text": "Cleophas gick til Emmaus heden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 11,
      "text": "aff medynck hand om Jesu talede met sin ven/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 11,
      "text": "Jesus holt sig til dem/ oc lærde dem saa Scrifften/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 11,
      "text": "at de maatte Sagen ret forstaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 11,
      "text": "met tegn oc hiertens brynde/ loed hand sig kiende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "at de vel fornumme huort de vaare vende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 12,
      "text": "",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 13,
      "text": "Som Cleophas met Apostlerne talede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 13,
      "text": "da traadde Jesus mit ind til dem oc sagde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 13,
      "text": "Fred met eder/ Fred være met eder allesammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 13,
      "text": "met glæde oc fryd euindelig Amen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 13,
      "text": "hand aad met dem hand lod dem see oc træffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 13,
      "text": "at mand ey mere skulle paa hannem tuiffle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 14,
      "text": "",
      "part": false,
      "marginal_notes": []
    }
  ]
}