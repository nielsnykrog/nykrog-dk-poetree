    {
      "id": 0,
      "stanza_id": 0,
      "text": "Tha iegh hade slawet myn broder ihiell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "tha gik meg løcken til hende ful well,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "tha iegh bleeff koningh i all Danmarck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "och slo megh i myn eghen gaardh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "som Wiburges stadh i Iutland staar.",
      "part": false,
      "marginal_notes": []
    }
