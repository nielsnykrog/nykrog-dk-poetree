  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Den Lækat titter fra Gjærdet ud:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Jeg synes, det tegner til Sne og Slud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "henad December det maa vist lakke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "nu faar jeg nok snart min Vinterfrakke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Jeg tager de smaa hvide Handsker paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Vorherre mig lod for Kulden faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Dens brune Skind fra Sommerens Tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "nu blev til en Hermelinskaabe hvid:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "naar Jægeren gik paa den lyse Sne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "han kunde ej Hermelinsdyret se;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "det smuttede ind under Gjærdelyet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "dér sad det og saae paa Nytaarsnyet.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
