  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "En ældre Ven Du var os, Dig vi fulgte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Og Blomstens Hjeroglypher vi forstod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Vi saae den Verdens Storhed, Bladet dulgte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Og fik Dig kjær, Du var saa klog og god.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Du Blomsters Ven skal mellem Blomster hvile,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Vi fölge Dig i Dag for sidste Gang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Men Du er taus, Dit Öie kan ei smile,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Og vore Sange –! o, Du elsked’ Sang!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Den var som Blomstens Duft Dig dyrebar!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Farvel! – Vi hid til Blomsterne Dig bar.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
