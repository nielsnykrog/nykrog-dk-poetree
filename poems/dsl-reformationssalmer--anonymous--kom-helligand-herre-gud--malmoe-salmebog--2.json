  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "KOm Helligand herre Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "opfylt met din naade och miskund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "alle menniskens hierte/ hw och sind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "din brendendis kerlighed i dem optend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "O herre met din naadis liwss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "du pleyer den rette vey ath wise/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "oc komme dem alle i en ret tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Thi være dig loff alletid/ baade silde oc fro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Alleluia/ Loffuer Gud alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Du hellige liwss oc visdoms port/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "lad oss opliwsis/ met liffsens ord/",
      "part": false,
      "marginal_notes": [
        "Esai. xi"
      ]
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "oc lær oss Gud ret kende alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "oc aff hiertens grund hannem vor fader kalle/",
      "part": false,
      "marginal_notes": [
        "Ephe. i Ro viii"
      ]
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "O herre beskerme oss fra fremmede lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "ath wi ingen mestere atspørge mere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "vden Jesum Christ vor frelsere kære/",
      "part": false,
      "marginal_notes": [
        "Joan x"
      ]
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "ath wor tro kunde til hannem all ene være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Alleluia Loffuer Gud alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Du hellige ild oc trøstere sød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "hielp oss nu oc i all vor nød/",
      "part": false,
      "marginal_notes": [
        "Acto ii"
      ]
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "ath wi kunde altid din vilge følge/",
      "part": false,
      "marginal_notes": [
        "Ro viii"
      ]
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "oc lad ingen modgang oss fra dig skilye/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "O herre met din Guddoms krafft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "styrcke oss vsle oc giff oss din mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Ath wi motte her stride mandelig/",
      "part": false,
      "marginal_notes": [
        "Act xiiii"
      ]
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "gennem sorg oc megen bedrøffuelsse komme til dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Alleluia Loffuer Gud alle",
      "part": false,
      "marginal_notes": []
    }
  ]
}