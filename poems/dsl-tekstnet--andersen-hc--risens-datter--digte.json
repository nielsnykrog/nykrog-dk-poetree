{
  "id": null,
  "title": "Risens Datter",
  "year_created": 1830,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Digte",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1830,
    "url": "https://tekstnet.dk/books/andersen-hc_digte-1830/038/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Dybt inde under Bjerget en gammel Rise boer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Hans Dagligstue hvælver sig der saa høi og stor.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Dets gyldne Lofte bæres af Søiler, stolte tre;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Der sidder Risens Datter, hun er nok værd at see.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "En Fjerdingvei er Høiden, maaskee en Smule meer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Forresten deilig velskabt, med Smilehul som leer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Hun strikker Børnestrømper til sine Søstre smaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "I hvert et Strømpeskafte vist Runde-Taarn kan staae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Sit hele Liv hun leved’ i Bjergets snevre Buur,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Nu faaer hun Lyst at røre sig lidt i Guds Natur.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Saa deiligt skinner Solen og Himlen er saa blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Som en Kartoffel-Ager hun synes Skoven staae;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Og hele Kjøbsted-Flækken med Kirken paa en Høi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Er som et Bord paa Marked’ med broget Legetøi.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Saa lystigt hun spadserer hen over By og Eng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Og boltrer sig i Søen, det er saa blød en Seng.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Af vilde Rosenhække og Hyldebuske net,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Hun binder i sin Uskyld en lille Bryst-Bouquet;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "De store høie Bøge hun rykker op med Rod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Saa fletter hun sig Krandse, det unge muntre Blod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Paa Marken pusler Noget – det synes ret pikant;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "I Forklædet gjemmer hun strax hvad her hun fandt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Og siger til sin Fader: »see, hvad jeg stødte paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "Til Legetøi jeg tog det for mine Søstre smaae.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Den gamle Rise klygtig paa Hittegodset saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Og svarede: »Kjær Datter, lad Du det Smaakravl gaae!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Det synes vel saa spinkelt, men det har stor Forstand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "Det er en Plov med Øxne og deres Bondemand!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "Han smykker Bjergets Vægge med Ranker og med Grønt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Nu sørger han for Kornet, der ogsaa pynter kjønt. –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "Din Indsigt i Naturen er ikke just til præ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "Du Blumenbach maa læse, der staaer om slige Kræ.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "– Imellem Fjeldets Stene, bag Buske og bag Krat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Seer man et Lys nu brænde til over Midenat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "Thi Jomfruen studerer, jo! jo! jeg siger Tak;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "Snart kan hun jo paa RamseLinné og Blumenbach.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "Hun snakker nok saa dristigt om Infusorium,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Man skulde troe hun daglig kom paa Collegium;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "Men Strikkestrømpen hviler, og hun og Søstre smaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "Med nøgne Pusselanker i Bjergets Sale gaae.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
