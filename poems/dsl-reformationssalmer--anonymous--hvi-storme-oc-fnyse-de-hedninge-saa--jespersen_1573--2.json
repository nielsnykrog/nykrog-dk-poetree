  "source": {
    "id": null,
    "title": "Gradval. En Almindelig Sangbog",
    "year_published": 1573,
    "publisher": "Niels Jespersen",
    "printer": "Lorenz Benedicht",
    "place": "København",
    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/jespersen_1573/65"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "HVi storme oc fnyse de Hedninge saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc lade saa megit ilde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Wnyttige raad gaar folckene paa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "som Gud icke haffue vilde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "De Konger paa Jorden bestercke sig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "oc Førster forsamlet ere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "imod Christum din Søn oc dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Gud lad det icke saa være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Forbarme dig offuer oss Herre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Lad oss bryde sønder deris baand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Oc deris Aag bortkaste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Den som boer i Himmerigis throne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Skal det aff dem vist laste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Oc haanlige foracte saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Oc tale til dem met vrede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Oc i sin grumhed met redsel sla/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "For de vaare icke til rede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Oc hannem om naade bede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Gud haffuer sæt til Kong sin Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Offuer oss Christne alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Oc aff hannem skal tage løn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Der hand til hannem saa talde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Du est min Søn/ Jeg fødde dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "J dag/ som mig vel behagde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Jeg skal dig giffue/ eske du aff mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Hedninge til arff at haffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Oc Verden til euig gaffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Jngen skal kunde staa dig imod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Du skalt dem sønder bryde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Oc træde dem alle vnder din Fod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Som dig icke vilde lyde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "J Konger værer kloge saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "Oc lader eder vnderuise/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "Som Jorderigis dom skulle bestaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "At i Gud ære oc prise/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "Saa faa i Ro oc lise.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "Tiener eders Herre Gud met fryct/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "Oc glæder eder met fare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "Anammer Guds sande Ord met tuct/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "Saa kunde i veyen beuare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "Naar hans grumhed optendis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "Da lider dem vel alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "Som icke fra hannem vendis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "Men trolige paa hannem kalde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "Gud vnde oss glæden alle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "IN voluntate tua Domine vniuersa sunt posita,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "et non est qui possit resistere voluntati tuæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "Tu enim fecisti omnia, coelum et terram,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 5,
      "text": "et vniuersa quæ coeli ambitu continentur:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 5,
      "text": "Dominus vniuersorum tu es.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 6,
      "text": "Beati immaculati in via,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 6,
      "text": "qui ambulant in lege Domini.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 6,
      "text": "Gloria Patri et Filio et Spiritui sancto:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "Sicut erat in principio et nunc et semper,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "et in secula seculorum, Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 7,
      "text": "HAleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 7,
      "text": "De profundis clamaui ad te Domine,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 7,
      "text": "Domine exaudi vocem meam.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 7,
      "text": "Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 8,
      "text": "SAa taler den wuise mund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 8,
      "text": "Den rette Gud wi mene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 8,
      "text": "det siger hand ey aff hiertens grund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 8,
      "text": "hans gierning giffuer det til kiende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 8,
      "text": "Hans hellighed er for Gud stor spot/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 8,
      "text": "i all hans gierning er intet got/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 8,
      "text": "Jngen aff dem Gud ret dyrcke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 9,
      "text": "Gud selff aff Himmelen saa her ned",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 9,
      "text": "Paa alle Menniskers Sønner/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 9,
      "text": "Da hand deris gierning haffde seet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 9,
      "text": "Om hand nogen kunde finde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 9,
      "text": "Der hans Ord oc vey for øyne haffde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 9,
      "text": "Oc noget effter hans villie giorde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 9,
      "text": "Der kunde hand vel paa acte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 10,
      "text": "Der vaar ingen paa rette vey De vaare alle afftrædne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 10,
      "text": "Alle giorde ont/ de straffedis ey/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 10,
      "text": "Huer haffde onde seduane/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 10,
      "text": "Jngen aff dem giorde aff hiertet gaat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 10,
      "text": "Jhuor meget de haffde aff Gud faat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 10,
      "text": "Thi maatte hand til at tale.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 11,
      "text": "Huor lenge ville i vanuittige være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 11,
      "text": "Eders ondskab ey forlade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 11,
      "text": "Oc spare mit Folck effter min villie/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 11,
      "text": "Oc giøre dem ingen skade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 11,
      "text": "Nu vel i tro ey ret paa Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 11,
      "text": "J kalde paa hannem ey effter hans Bud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 11,
      "text": "J ville eder selff forsørge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 12,
      "text": "Derfor haffue de aldrig ro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 12,
      "text": "Men altid monne de frycte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 12,
      "text": "Gud hoss de Fromme vil altid bo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 12,
      "text": "De sig paa hannem forlade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 12,
      "text": "Der offuer forsmaa den Armis raad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 12,
      "text": "Oc holde hannem alt for spot oc had/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 12,
      "text": "At Gud hans trøst er vorden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 13,
      "text": "Huem skal Jsrael den arme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 13,
      "text": "Saligheden giffue?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 13,
      "text": "Gud vil sig sit Folck forbarme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 13,
      "text": "De Fangnis frelser bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 13,
      "text": "Det vil hand giøre ved sin Søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 13,
      "text": "Der aff bliffuer Jacob gantske køn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 13,
      "text": "Oc Jsrael sig glæder.",
      "part": false,
      "marginal_notes": []
    }
  ]
}