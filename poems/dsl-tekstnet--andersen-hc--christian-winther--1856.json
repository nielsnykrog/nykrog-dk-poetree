  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Han snitted’ i Træet, – der dufted’",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Af Kløver og Bøgens Blad;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Han »Hjorten« jog, – og der klang os",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Et dansk udødeligt Qvad!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Det er som den friske Rose,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Det er som den modne Frugt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Saa rigt, saa sundt og saa lifligt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Og saa har det Tonernes Flugt!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
