  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Rotte, Du Tyv, hvor kunde Du flytte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Æggene bort fra mit Fad, min Bøtte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "uden Du ét i Stykker slog?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Rotten, den sad i sin lune Krog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "slikkede sig polisk om Munden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "tænkte: ja bi til Skumringsstunden!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Da det saa lakkede hen mod Nat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Rotterne toge paa Værket fat:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "En af de Gamle paa Ryggen laa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Ægget han holdt med Poterne paa;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Rotter var Heste, og Halen var Stangen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "saa kjørte et Æg de bort ad Gangen.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
