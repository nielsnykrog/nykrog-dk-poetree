{
  "id": null,
  "title": "Ridder Stigs Bryllup",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA122.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Ryder Sty hand lader ett gestebuod giørre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "men alldrig waar sliggitt y Danmarck førre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": ":: Iumfrur, y gyffuer oss orluoff! ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Hand bydder dyd kongenn med alld synn mend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "wor danske droning skulde følge denom.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "Hand byuder dyd droningenn med alld synn mørr",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "och lidenn Kierstenn op vnder ø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "Daner-kongenn hand kaam y rider Sties gaard:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "vd stuod rider Stied, waar suøbtt y muordt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "Dy haarer dy saatte denom nieder tilbenck:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "silleff gick rider Sty, denom wynen att skenncke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "I-diess merre hand skienckitt wynn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "des bedere guod-willige fieck hand till lidenn Kierstynn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "\"Dett er well otte aar, syden ieg roner nam:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "y afftten wel ieg prøffue, om ieg denom kand.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "Med dend hyggere haand skennckitt hand klaare wynn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "med dend wenster haand kaaste hand roner synn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "Hannd agthett thy ronner till hynd lyden Kierstynn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "thi dreff op vnder iumfru Rigis hyndis byenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "Iunfrw Rygys hun rødemer som en blod:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "men rider Styd suorttener som en iord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 10,
      "text": "Rydder Styd suøber seg hoffuett y skyend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "hand gaar y lofftt for foster-moder synn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 11,
      "text": "\"Fostermuoder, fostermuoder, kyender meg rad:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "meg er nu thymitt saa hyggelig en waad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 12,
      "text": "Y affttis daa skienkitt ieg mød och wynn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "saa kier feck ieg hynd lyden Kerstinn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 13,
      "text": "Ieg skreff runer och kaaste denom for liden Kierstinn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "dy dreff op vnder iumfru Rigis hynder skiend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 14,
      "text": "Nu well ieg laade saadell myn ganger graa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "saa snarlig daa well ieg ride her-fraa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 15,
      "text": "\"Alltt om du kunde nu ride tyell saalttenn rynn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "y natt komer Rygeslild tiell dynn seng.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 16,
      "text": "Dw luock y laass dynn hyffue-loffs-dør:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "du gack y seeng, som du giorde førrre!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 17,
      "text": "Alltt om hun klaper paa dørenn med skyend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "du lad, som du est der icke indde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 18,
      "text": "Alltt om hun mynder dynn mund saa rød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 18,
      "text": "du lieg, rider Styd, som du warst død!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 19,
      "text": "Syldig om affttenn, rym faldtt paa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 19,
      "text": "op stuod iumfru Riggis, sluo offuer seg skaarlagenn smaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 20,
      "text": "Hun klaper paa loffsdør med synn skyend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 20,
      "text": "\"Statt op, rider Styd, y lader meg ind!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 21,
      "text": "\"Sllett ingenn haffuer ieg støffuene saatt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 21,
      "text": "och ingenn lader ieg y lofftt om natt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 22,
      "text": "Lydenn daa haffde hun fynger och smaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 22,
      "text": "saa thuog hun selliff thy nuaffueller fraa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 23,
      "text": "Hun satte seg paa hans senge-stock:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 23,
      "text": "hun legtte fast med hans gwlle lock.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 24,
      "text": "Saa mynditt hun hans mund saa rød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 24,
      "text": "men altt luo rider Stid, som hand waar død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 25,
      "text": "Iumfru Riggis-lyld axller skaarlagen-skynnd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 25,
      "text": "saa sørinnd gyck hun fraa denn rider igenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 26,
      "text": "\"Och, ryder Sty, Chrest gyffue deg skaam!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 26,
      "text": "mytt hiartte thett haffuer du lagtt y thuang.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 27,
      "text": "Saa syldig om affttenn daa war thett giort:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 27,
      "text": "om morgenn bleff thett for kongenn førdtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 28,
      "text": "Kongenn hand thaaller till suenne thuo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 28,
      "text": "\"Y beder rider Sty ind for meg gaa!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 29,
      "text": "Ind kaam rider Styd, hand steedis for buord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 29,
      "text": "\"Huad wylde y, myn herre, huy sende y meg ord?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 30,
      "text": "\"Hør thu thett, rider Stid, seelle myn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 30,
      "text": "huad giorde mynn søster y natt y bwre dynn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 31,
      "text": "\"Tthett er fuld vndtt att thrette ymod magtt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 31,
      "text": "thy roner waar ycke eders søster aagtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 32,
      "text": "Men dett wor well sanddingen, hun tiell meg gyck:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 32,
      "text": "slett ingenn guod-willig ieg aff hynder fieck.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 33,
      "text": "Droningenn hun suaridt ett ord med ere:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 33,
      "text": "\"Y laader thy vnge thuo tiellsamell were!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 34,
      "text": "Tther war stuor gledde y konngens gard:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 34,
      "text": "och kongenns søster bortt-gyffuen waar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 35,
      "text": "Hand gaff hinder bortt med guld och skatt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 35,
      "text": "thend løcke haffde rider Sty seg ycke agtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 35,
      "text": ":: Iumfruer, y gyffuer osz throen! ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}