  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Herre Gud benaade mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "aff din godhed forbarme dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "slet vd all min wlydigbed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "aff din store Barmhiertighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Oc toe mig vel O Herre Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "aff all min ondskab oc wdyd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "oc giør mig reen aff Synder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "thi ieg dem nu befinder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Oc all min Synd er steds for mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "allene haffuer ieg syndet mod dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "for dig haffuer ieg ilde giort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "men du bestaar altid dine ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "om mand dig vilde dømme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Wduelig er ieg kommen hid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Min Moder haffuer mig i ondskabs ijd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "J synden mig vndfangit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Stor synd haffuer ieg begangit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Til Sandhed haffuer du Herre lyst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Oc lærer mig til Hiertens trøst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Din Visshed vden sorgen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Som hemmelig er forborgen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "Bestenck mig Herre met Jsop skøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "At ieg som Sne bliffuer huid oc reen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "Din glæde oc fryd lad høre mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 1,
      "text": "Saa frydis de Been oc glæder sig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 1,
      "text": "Som du haffuer sønderknusit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "See icke til min last oc skam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Affslet min Synd/ vær mig ey gram.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "O Herre mig begaffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "Jt Hierte reent at haffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "En retter Aand forny vdi mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "Forskiud mig oc ey plat fra dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "Tag ey fra mig din hellig Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 2,
      "text": "Giff mig Naade oc ret forstand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 2,
      "text": "Min saligheds trøst lad komme her/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 2,
      "text": "O Gud min Fader oc Herre kier/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 2,
      "text": "Met en sterck Aand giør mig stadig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 2,
      "text": "De vantro vil ieg lære flitelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 2,
      "text": "Deris veye til dig vende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "Fra alle Blodskylde redde mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 3,
      "text": "O Gud min Herre/ ieg beder dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 3,
      "text": "Saa vil ieg prise oc tale",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 3,
      "text": "Din Retuisshed offuer alle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 3,
      "text": "Mine Læber lad op Herre min/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 3,
      "text": "At ieg forkynder æren din.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 3,
      "text": "Til Offer haffuer du ingen lyst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 3,
      "text": "Det veed ieg vel min Herre vist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 3,
      "text": "Brendoffer eller andit meer saadant",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 3,
      "text": "Behager dig ey/ er men it tant/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 3,
      "text": "For dine Øyen er men it had.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 3,
      "text": "Guds Offer er det ret oc gaat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 3,
      "text": "Jt sorrigfult hierte for Synden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 4,
      "text": "Jt angerfult hierte som er ret",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 4,
      "text": "Vilt du ey haffue plat forgæt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 4,
      "text": "Du vilt det ey foracte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 4,
      "text": "Det kand ieg vel betracte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 4,
      "text": "O Herre Gud betenck Zion/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 4,
      "text": "Alt effter din gode villie skøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 4,
      "text": "Oc Jerusalems Mure",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 4,
      "text": "Vilt du igen opbygge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 4,
      "text": "Saa skalt du haffue glæde oc lyst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 4,
      "text": "Til det Offer som er retuist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 4,
      "text": "Til det Brendoffer er dit Mod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 4,
      "text": "Saa skal mand da den Kalff saa god",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 4,
      "text": "Ret paa dit Altere legge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 5,
      "text": "O Herre Gud du vær vor trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 5,
      "text": "Tenck paa din naadige Lyfftis røst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 5,
      "text": "Paa huilcken wi til dig komme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 5,
      "text": "Oss til euig gaffn oc fromme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 5,
      "text": "Lad dine Øern her mercke paa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 5,
      "text": "Lad dine Øyen her aabne staa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 5,
      "text": "Bønhør vor Hiertens klage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 5,
      "text": "Lad oss Naade hoss dig haffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 5,
      "text": "Jsrael kiender sig mangfoldelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 5,
      "text": "At haffue met Synd fortørnet dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 5,
      "text": "Men flyer til din Barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 5,
      "text": "Hielp hende nu oc i euighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 5,
      "text": "Det bede wi arme Synder.",
      "part": false,
      "marginal_notes": []
    }
  ]
}