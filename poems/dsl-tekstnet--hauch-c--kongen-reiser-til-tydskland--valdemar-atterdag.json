{
  "id": null,
  "title": "Kongen reiser til Tydskland",
  "year_created": 1861,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Carsten Hauch",
    "country": null,
    "wiki": "Q688529"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Valdemar Atterdag",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1861,
    "url": "https://tekstnet.dk/books/hauch-c_valdemar-atterdag/022/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Hr. Folkvar blev ført til Nyborg under Ø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Der maatte den Herre med Qval og Skjændsel døe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Da Dronningen det hørte, da glemte hun at lee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Hun sagde: »Gud give mig at hevne Din Spee!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Den luegyldne Snekke sig gynged under Strand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Dankongen vilde drage til Keiserens Land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "I Tovelils Hal den ædle Herre stod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Han vilde med hende tale, før han Danmark forlod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Han sagde: »Bort jeg seiler paa Bølgen den blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Nu har jeg de Beviser, jeg ventede paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Jeg gjester Keiser Karl, han var mig stedse god,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Han vil i denne Sag vist ei være mig imod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Den falske Mynt, de præged for mig at bedrage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Den skal jeg med Renter dem give tilbage;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Al Fru Helvigs Ondskab jeg gjennemskuet har,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Som man i Skoven raaber, saa faaer man ogsaa Svar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "For Helgene hun knæled og smelted hen i Graad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Hexeqvinder og Voldsmænd dog sad i hendes Raad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Lad hende gaae i Kloster! der kan hun gjøre Bod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Den Slægt, hvorfra hun stammer, var aldrig Danmark god.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Den Slægt, hvorfra hun stammer, var stedse svigefuld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Til Eckhard, den Forræder, hun skjenked sit Guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Paa det jeg kunde gives i mine Fjenders Vold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "Utysker og grumme Stimænd stod udi hendes Sold.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Da spurgte Jomfru Tove: »Er I da vis derpaa?«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Han svared: »Hvad Skjebne den falske Viv skal faae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Det vil jeg overlade til Keiserens Dom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "Jeg ogsaa til Paven har skrevet derom.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "Han er mig meget gunstig, den Herre klog og rig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "At skilles fra Fru Helvig han neppe negter mig;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "Lad hende gaae i Kloster! jeg vil ei hendes Død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "Men Du skal arve Kronen, som Helvig forbrød.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "Han sagde: »Derfor lod jeg, som Intet jeg saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "For at det kunde vise sig, hvorvidt hun vilde gaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "Paa det det kunde rygtes og blive vidt bekjendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "At hvad hun nu maa lide, det har hun vel fortjent.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "Nu reiser jeg til Tydskland at ende vor Kiv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Snart er jeg her tilbage, da vorder Du min Viv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "Snart har vi vundet Seier, vor Lykke stunder til,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "Dog vaer Dig for Fru Helvig og hendes falske Spil!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "Din Broder mig følger som sprogkyndig Mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Dog lade vi dem tilbage, der vel Dig vogte kan,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "Hvad Helvig Dig befaler, det agte Du ei paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "Hun skader Dig vist aldrig, naar ei hun kan Dig naae.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "Saa trykked han Fru Tove heel kjærlig til sit Bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Han sagde: »Nu jeg skilles fra Livets bedste Lyst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "Dog snart som Brud og Dronning Du sidder ved min Side.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "Alt hvad de dengang talte, Fru Helvig fik at vide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "Hun sagde: »Den bedrog mig, som meest jeg stoled paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "Dog vil jeg mig hevne, hvordan det skal gaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "Ja, selv om han mig vier til Fængsel eller Død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "Skal hun dog aldrig bære min Guldkrone rød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 13,
      "text": "Jeg veed, at Verdens Glæder som Støv svinde hen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "Folkvar jeg maatte miste, min troeste Ven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "Med Spot og med Skjændsel han maatte Døden lide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "Derfor skal hende times den bittreste Qvide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "Før frygted jeg at miste min Høihed og min Magt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Intet nu meer jeg frygter, thi Alt er ødelagt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "Jeg veed, han vil forskyde sin ædelbaarne Viv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "Det skal den Slegfredqvinde betale med sit Liv.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 15,
      "text": "Før hun skal ægte Volmer og boe i Kongens Hal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "Jeg tænde vil et Brudeblus, som seent forglemmes skal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "Jeg selv vil tænde Blusset og lede Brudens Fjed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "Til Leiet, som jeg snildelig har for hende redt.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 16,
      "text": "Neppe var Kongen borte, saa lod hun til sig stevne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "Folkvars rige Frænder, som ønsked ham at hevne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "De svor ved alle Helgene og ved den høie Christ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "Ærlig at hjelpe Dronningen med Magt og med List.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 17,
      "text": "Hun sagde: »Jeg hende sender et Brev med Kongens Segl,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "Jeg kjender den Mand, som uden mindste Feil",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "Hans Haand kan efterskrive; der gaaer saa vild en Sø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "Vi sige, han er dreven tilbage til vor Ø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 18,
      "text": "Jeg vandt ved Guld en Tjener, som jeg kan stole paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "Han tidt i Volmers Ærind den Slegfredqvinde saae;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "Naar han bringer Brevet som Kongens vante Bud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "Haaber jeg vist, hun kommer og vorder Dødens Brud.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 19,
      "text": "Mæled de stolte Herrer: »Den Hevn er kun liden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "En anden Slegfredviv han møder vel med Tiden.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "Hun svared: »Ingen stærkere Hevn kan I finde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "Han elsker ei sit Kongespiir saa høit som denne Qvinde.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 20,
      "text": "Saa drog hun til Kirken og knæled til Jord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "Mens Psalmesangen toned fra Orgel og Chor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "Det var som Varselsrøster, der klang i det Høie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "Dog kunde de til Mildhed Fru Helvig ei bøie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 21,
      "text": "Ei de kunde dæmpe den hevngjerrige Lyst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 21,
      "text": "Skjøndt hun med Vievand væded sit Aasyn og sit Bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "Hun korsed sig og neied og bøied sig til Jord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 21,
      "text": "Og talte til de Helgene saamangt et lønligt Ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 22,
      "text": "»Saafremt over Tovelil I give mig Magt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 22,
      "text": "Da bygger jeg for Eder med kostelig Pragt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 22,
      "text": "En Kirke, der skal synes et Vidunder i Nord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 22,
      "text": "Og smykker Eders Billeder med Guld og Perlemor.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 23,
      "text": "Ja, naar jeg blot maa raade for Tovelilles Liv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 23,
      "text": "Da skal jeg siden leve som den frommeste Viv",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 23,
      "text": "Og tjene Jer til Gjengjeld med Alt, hvad jeg forstaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 23,
      "text": "Og klæde Jer hver Vinter i Zobel og Maar.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 24,
      "text": "Saa talte Dronning Helvig med Suk og blegen Kind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 24,
      "text": "Mens Læberne skjælved som Espeløv i Vind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 24,
      "text": "Hun folded sine Hænder, hun bad med sagte Røst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 24,
      "text": "I Dronningens Andagt fandt Mængden megen Trøst.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
