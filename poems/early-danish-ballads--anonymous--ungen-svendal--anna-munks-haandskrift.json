{
  "id": null,
  "title": "Ungen Svendal",
  "year_created": [
    1590,
    1591
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Anna Munks Håndskrift",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1591,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/MUNK36.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Thet var ungen Sueydall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hanndt skulde boldenn lege:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "boldenn dreff y yomffruens skiødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "och giorde hunn kinnderenn blege.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: Thu lade thine ordt well! ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Boldenn dreff y iomffruenns bure,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "och suennden effther ginnge:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "før hanndt udt aff burritt kom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "stuor sorrigh y hiertett hanndt finnge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "\"Thu thør icki kaste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "boldenn effther mig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "der sider enn iomffru y fremede lanndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "hun lider fast effther dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Thu skaltt aldrig søffuenn soffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "och alldrig rouenn fannge:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "før thu faar løst den skiønne iomffru,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "som liger for dig y tuannge.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Thett var unngenn Sueydall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "hanndt suøber sig hoffuitt y skinndt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "saa gaar hand y høffue-lofftt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "for syne kiere hoffmend innd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "\"Her sider y, alle mine guode mennd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "y dricker mødt aff skole:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "menns ieg gaar y bierigitt inndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "altt medt dy døde att thalle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Her sider y, alle mine guode hoffmenndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "y dricker miødt och vinn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "menns ieg gannger y bierigitt inndt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "och thaller medt moder minn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Thett var unngenn Sueydall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "handt tager thill att kalde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "der reffner mur och malmerstienn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "och biergitt tager thill att falde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "\"Huem er dett, mig vecker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "eller aff mig kalde maa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "menn ieg maa icki mett freden lege",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "op-unnder denn sorthe iordt?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "\"Thett er unngenn Sueydall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "och kiere sønne dynn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "hanndt villde saa gierne haffue guodt raadt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "aff kiere moder synn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Ieg haffuer fanngett mig stedmoder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "hunn er mig saa hordt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "hunn haffuer kast mig ronerenn paa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "for den, ieg aldrig saa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "\"Maa ieg icki mett fredenn lige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "unnder denn sorthe qualle:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "udi dy samme veye",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "fuldt-vell da skalthu fare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "Ieg skall giiffue dig fuolenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "fuld-well skall hanndt berre dig fram:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "saa vell kanndt hannd løbe paa vilden haff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 12,
      "text": "som paa grønnenn enng.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "Ieg skall giffue dig dugenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "hunn er aff ageruldt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "all thenn madt, thu ynnsker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 13,
      "text": "thenn skall deg staa strax paa burdt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Ieg skall giiffue dig dørins-huorne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "dy er belagd medt guldt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "all denn drøck, du ønnsker dig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 14,
      "text": "daa skall hanndt staa all fuldt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "Ieg skall giiffue digh suerdett,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "er herdt y drage-blodt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "y-huor du drager igiennom skouffuenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 15,
      "text": "daa liuser hunn som enn boell.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "Ieg skall giiffue dig snekenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "hunn skall verre dig guode:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "hunn løber saa vell paa thenn grønne iordt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 16,
      "text": "som paa vildenn floede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 16,
      "text": "Ieg skal giffue dig saa goed en pung,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 16,
      "text": "den skal vere dig huld:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 16,
      "text": "du skal aldrig saa thage aff denn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 16,
      "text": "hand skall iou altid verre fuld.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 17,
      "text": "Thy vonnde op dieris silcke-segell",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 17,
      "text": "høyt y forgyldene raa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 17,
      "text": "saa seglett dy thill denn samme lanndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 17,
      "text": "som then iomffru er paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 18,
      "text": "Saa kaste dy dieris anncker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 18,
      "text": "paa denn huide sandt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 18,
      "text": "thett var ungen Sueydall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 18,
      "text": "hanndt thrinn der først paa lanndt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 19,
      "text": "Thett var unngenn Sueydall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 19,
      "text": "hanndt styritt synn snecke for lanndt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 19,
      "text": "dett første, dett dennom møtthe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 19,
      "text": "dett var enn gammel manndt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 20,
      "text": "Thett da var denn gamle manndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 20,
      "text": "hanndt lodt spørge først:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 20,
      "text": "\"Huadt da heder denn unnger-suenndt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 20,
      "text": "hanndt er y hierthett trøst.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 21,
      "text": "\"Suenndenn heder unngen Sueydall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 21,
      "text": "saa viide gangis sadenn deraff:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 21,
      "text": "hanndt er lagdt y lanngen athraa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 21,
      "text": "for denn, hand aldrigh saa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 22,
      "text": "\"Her er enn iomffru paa dett lanndt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 22,
      "text": "hunn leger y lanngenn atthraa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 22,
      "text": "for enn suenndt, heder Sueydall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 22,
      "text": "hunn hannom aldrig mett øyenn saa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 23,
      "text": "\"Lengis hender epther enn unger-suendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 23,
      "text": "hun haffuer hannom aldrig seett:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 23,
      "text": "heder hanndt unngenn Sueydall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 23,
      "text": "da er hanndt nu kommenn hidt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 24,
      "text": "Hørre du dett, du gammelle manndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 24,
      "text": "er dett sanndenn, du syger mig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 24,
      "text": "bliffuer ieg konge paa dette lanndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 24,
      "text": "thill greffue saa giør ieg dig.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 25,
      "text": "\"Møtte udi denn grønne lundt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 25,
      "text": "ther stannder minn iomffrues gaardt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 25,
      "text": "hussitt er aff graa malmerstienn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 25,
      "text": "och gaardenn er lagd medt staaell.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 26,
      "text": "Husenn er aff graa malmerstienn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 26,
      "text": "och gordenn er lagdt medt stoell:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 26,
      "text": "porthenn er aff dett røde guldt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 26,
      "text": "tolff huide biørne stannder derfor.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 27,
      "text": "Møtthe udi minn iomffrues gaardt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 27,
      "text": "der stannder enn linndt saa grønn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 27,
      "text": "er thu den rette Sueydall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 27,
      "text": "du gack saa dristelig fram!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 28,
      "text": "Buortt red ungen Sueydall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 28,
      "text": "och inndt adt porthen hand saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 28,
      "text": "alle dy lose, der henngde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 28,
      "text": "dy gick ther lediige fraa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 29,
      "text": "Ther falmer løff, ther falmer linndt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 29,
      "text": "och gressitt vedt linde-roedt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 29,
      "text": "dy løffuer och dy biørne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 29,
      "text": "dy fieldt thenn herre thill foedt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 30,
      "text": "Ther hanndt kom y denn borge-gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 30,
      "text": "ther axler hanndt synn skinndt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 30,
      "text": "saa gannger hanndt y høffue-lofftt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 30,
      "text": "for hedennske konngenn inndt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 31,
      "text": "\"Her sider y, hedennske konngenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 31,
      "text": "altt offuer eders brede bordt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 31,
      "text": "vill y mig eders dather giffue?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 31,
      "text": "y vider mig anntsuar-ord!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 32,
      "text": "\"Ieg haffuer icki datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 32,
      "text": "och datter forudenn ienn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 32,
      "text": "hun liger lagdt y langenn atthraa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 32,
      "text": "altt for enn unger-suendt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 33,
      "text": "Hunn liger lagt y lanngen atthraa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 33,
      "text": "for thenn, hunn aldrig saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 33,
      "text": "suenndenn heder unngen Sueydall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 33,
      "text": "saa viide gangis saden aff.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 34,
      "text": "Innd da kom denn lidenn smaa-dreng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 34,
      "text": "var kledt y kiorthellenn huidt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 34,
      "text": "\"Lenngis eder nu, iomffru, epther Sueydall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 34,
      "text": "da er hand komen hidt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 35,
      "text": "\"Berrer y nu udt dy lige-borre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 35,
      "text": "och saa dy giøle raa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 35,
      "text": "och følger y mig y høffuenn-lofftt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 35,
      "text": "denn unnger-suenndt att skue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 36,
      "text": "Innd da kom thenn skiønne iomffru,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 36,
      "text": "var kledt y silcke huidt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 36,
      "text": "\"Ver vell-kommenn, unngenn Sueydall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 36,
      "text": "hierthe-allerkieriste minn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 36,
      "text": "Wer vell-kommen, ungen Sueidall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 36,
      "text": "edelig herre min:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 36,
      "text": "thack haffue Gud-fader i Hemmerig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 36,
      "text": "oss begge haffuer løst aff kuidde!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 37,
      "text": "\"Ville y lade eder døbe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 37,
      "text": "och tage vedt denn christelige thro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 37,
      "text": "och følge mig thill Dannemarck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 37,
      "text": "huos unngenn Sueydall att boo?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 38,
      "text": "\"Gierne vill ieg lade mig døbe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 38,
      "text": "thage vedt den christelige tro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 38,
      "text": "och følge eder saa thill Dannemarck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 38,
      "text": "huos eder, unngenn Sueydall, at bo.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 39,
      "text": "Om loffuerdagenn lodt hun sig døbe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 39,
      "text": "thog vedt denn christelig thro:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 39,
      "text": "om sønndagenn lodt dy dirris brøllup bo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 39,
      "text": "thy leffuer thillsammel mett ro.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 40,
      "text": "Thy druck brøllup y dage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 40,
      "text": "och vell y dage nye:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 40,
      "text": "altt thaa sadt denn gammele manndt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 40,
      "text": "och sørgitt y alle dy.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 41,
      "text": "Tack haffue ungenn Sueydall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 41,
      "text": "saa vell holtte hanndt synn ordt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 41,
      "text": "hanndt giorde hannom thill rider",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 41,
      "text": "och saatthe hannom øffuerste thill bordt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 42,
      "text": "Nu haffuer unngenn Sueydall",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 42,
      "text": "forvon- all synn harum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 42,
      "text": "saa haffuer och den skiønne iomffrue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 42,
      "text": "hunn soffuer paa hanns arum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 42,
      "text": ":: Thu ladt dine ord vell! ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}