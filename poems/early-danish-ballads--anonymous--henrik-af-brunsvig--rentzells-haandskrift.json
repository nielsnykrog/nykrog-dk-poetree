    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/RNZ5.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Hertogen ud-aff Bruinsuig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "huor finder mand en herre sliig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Udaff Brunsuig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "hur da finder mand en herre sliig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Anthen thiill diister eller till hoffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "saa handeliig thord handtt sin liff for-woge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Heller thiill hoffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "saa handeliig thør sin liff for-woge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Hertogen wogner om midinatt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "\"Min hierttens-kier, mig er icke gott.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Om midinatt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "\"Min hierttens-kiere, mig er icke gott.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Faar ieg icke orloff bratt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "tha leffuer ieg icke thenne natt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Orloff bratt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "tha leffuer ieg icke thenne same natt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "\"Orloff will ieg icke spare:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "min edeliig herre, huortt will y fare?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Wiide eller spare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "min edle herre, huortt will y fare?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "Naar skall ieg brøge, naar skall ieg blennde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "nar skall ieg winthe ethers komme igienn?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Nar skall ieg blande?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "nar skall ieg winthe ethers komme igienn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "\"Kommer ieg ick indenn IX winthers frest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "thu loff then rider, ther theg unnder biest!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Inden IX winthers frest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "thu loff then suend, ther thu under best!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "Du agtt di ord, ieg will deg siige:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": "du leg ick hare y biørssens leye!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "Ieg wiill deg siige:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "du leg ick hare i biørsens ley!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "Hand striide ind tiill Sørssels haff:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 7,
      "text": "hand striidie ind tiill thett helliig graff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "For Sørssels haff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "hand stridde ind tiill thett helliige graff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "End stridde hand, som hand wel kunde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 8,
      "text": "hand stride ind for Babilone.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "Som hand wel kunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "och ind stride hand tiill Babilonne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "Och han stride modtt den hedenske herre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 9,
      "text": "och fangen bliff hertogen, thett wor werde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "Hedenske heer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "fangen bliff hertogen, thett wor werre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "Hand spenntte hannom bode y harnsk och plog:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 10,
      "text": "hann thienntte saa well then hedenske frue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "I harffue och plog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "hand thientte saa vel then hedenske frue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "Hun gaff hannum madtt, meden hand kunde bere:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 11,
      "text": "skouen hun wor VII ugers ferdtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "Men hann kund bere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "och skoffuen vor VII ugers ferdtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 12,
      "text": "Skoffuen hun var VII ugers ferdtt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 12,
      "text": "altt under sin kobe bor handtt itt suerdtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "VII ugers ferdtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "altt under sin kobe bar hand itt suerd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 13,
      "text": "Hertogen ganger aff weyen frem:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 13,
      "text": "saa underliig ting euentyrdis han.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "Adtt weyenn frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "saa underliig ting euentyrdis hann.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 14,
      "text": "Hann saae siig unnder en thre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 14,
      "text": "en løffue och lindorm fictis ther.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "Altt under en thre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "en løffue oc lindorm fictis ther.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 15,
      "text": "\"Welkomen, hertog Heneriig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 15,
      "text": "min edeliig herre aff Brunssuig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "Heneriick,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "min edeliig herre aff Brunssuig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 16,
      "text": "Wilde du nu hielpe mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 16,
      "text": "saa gierne wille ieg thienne thiig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "Hielpe mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "saa gierne wille ieg thienne diig.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 17,
      "text": "\"Hierre Gud giffue, ieg motte were thett werdtt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 17,
      "text": "att werie den lindorm mett mitt suerd!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "Motte were thett werd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "att werie then lindorm mett min suerd.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 18,
      "text": "Den herre hand hug, then løffue hand bedtt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 18,
      "text": "di weriett den lindorm, som Gud wel wedtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "Then løffue hun bedtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "di voge then lindorm, som Gud wel wedtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 19,
      "text": "Den herre giick igiemell den lundtt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 19,
      "text": "den løffue hannum fulde som hans brøllylig hundtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "Igiemen den lund then lund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "then løffue fuld hannom som hans brølliig hunn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 20,
      "text": "Then herre hand gick aff weyen frem:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 20,
      "text": "saa underliig ting effuenthyrdis hann.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "Att weyen fram,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 21,
      "text": "saa underliig ting effuentyrdis ham.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 21,
      "text": "Hand soe siig op under en eg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 21,
      "text": "ther sadtt en iermedtt och klagitt siig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 22,
      "text": "Op unnder en eg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 22,
      "text": "ther sadtt en iermedtt och klagitt siig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 22,
      "text": "\"Welkomen, hertog Henderiich,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 22,
      "text": "min edeliig herre aff Brunssuig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 23,
      "text": "Hendriick,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 23,
      "text": "min edelig herre aff Brunsuig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 23,
      "text": "Sette theg neder och thall mett mig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 23,
      "text": "och ieg wiill bede min skaber for deg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 24,
      "text": "Och thall mett mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 24,
      "text": "och ieg wiill bede min skaber for thieg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 24,
      "text": "Hand satte siig neder enn liden wille:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 24,
      "text": "engelen førde hannom VII mille.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 25,
      "text": "En liden wille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 25,
      "text": "engellen førde hannum VII mille.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 25,
      "text": "Op wognett then herre, hand wor saa gladtt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 25,
      "text": "hand hørde then hiorde, po thidske hand quadtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 26,
      "text": "Hand blieff saa glad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 26,
      "text": "hand hørde then hiørde, paa thidske hand quadtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 26,
      "text": "\"Hørde du hiørde, oc siige du mig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 26,
      "text": "huis er thett fæ, du driffuer for thieg?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 27,
      "text": "Siig du mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 27,
      "text": "hues er thett fæ, du driffuer for thieg?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 27,
      "text": "\"Staden heder Brunssuig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 27,
      "text": "och heren heder hertog Hendriick.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 28,
      "text": "Brunsuig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 28,
      "text": "och herren heder hertog Hendriick.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 28,
      "text": "Siidenn wy miste then edeliig herre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 28,
      "text": "och siden stod staden halffue werre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 29,
      "text": "Den edeliig herre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 29,
      "text": "oc siden stod staden halle werre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 29,
      "text": "Aldriig komer tiill Brunssuig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 29,
      "text": "sliigen en herre som hertog Hendrig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 30,
      "text": "Thiill Brunsuig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 30,
      "text": "sliigen en herre som hertog Henriig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 30,
      "text": "Anthen tiill disten eller tiill hoffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 30,
      "text": "sa handelig thorde sin liff for-woge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 31,
      "text": "Eller tiill hoffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 31,
      "text": "saa handeliig thorde sin liff for-woge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 31,
      "text": "Y morgen skall ther en brøllup were",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 31,
      "text": "i Brunsuig mett hans hiertens-kiere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 32,
      "text": "Ett brøllup were",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 32,
      "text": "y Brunsuig mett hans hiertens-kiere.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 32,
      "text": "\"Hørthu hiørde, huad ieg siiger thieg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 32,
      "text": "thu bied then brudgom thalle mett mig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 33,
      "text": "Huad ieg siiger thieg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 33,
      "text": "thu bed then brudgom thalle mett mig.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 33,
      "text": "\"Huad mon then pillegrim thill mig kiennde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 33,
      "text": "men hand hand mig saa dristeliig buden sennde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 34,
      "text": "Thiill mig kiende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 34,
      "text": "men hand mig saa dristeliig buden sende.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 34,
      "text": "Altt uthen for then gildene portt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 34,
      "text": "ther møtthis then brudgom oc then pillegrim suortt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 35,
      "text": "Den gildene portt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 35,
      "text": "ther møtthis then brudgom och then pillegrim suortt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 35,
      "text": "\"Der du drogst hiem, sagde, ieg wor dødtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 35,
      "text": "tha suigst thu thett rette brødtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 36,
      "text": "Sagde, ieg wor dødtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 36,
      "text": "da suigst thu thett rette brødtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 36,
      "text": "Rag aff min skeg, skier aff min haar!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 36,
      "text": "och tha sier du min dybe saar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 37,
      "text": "Skier aff min hor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 37,
      "text": "tha sier thu mine dibe saar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 37,
      "text": "Ieg will giffue thieg en anden guod gaffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 37,
      "text": "och sielff wiill ieg min høstruu haffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 38,
      "text": "En anden guod gaffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 38,
      "text": "oc sielff wiill ieg min høstru haffue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 38,
      "text": "\"Icke passer ieg paa thin gode gaffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 38,
      "text": "och sielff motthu thin høstru haffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 39,
      "text": "Din guode gaffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 39,
      "text": "och sielff motthu thin høstru haffue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 39,
      "text": "Saa glade wor the Brundsuig-mendtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 39,
      "text": "ther the finge thieriis herre igienn.",
      "part": false,
      "marginal_notes": []
    }
  ]
}