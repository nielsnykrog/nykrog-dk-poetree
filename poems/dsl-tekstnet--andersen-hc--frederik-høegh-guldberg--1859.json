  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "En gammel, ædel Skjald os her forlod;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Som Fremmed for den nye Slægt han stod –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Hvad Jordens er »skal ældes, som et Klæde.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Den bedste Sang tidt blev i Tiden glemt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Men Aandens Spire, som i den laa gjemt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Groer gjennem Slægter til sin Givers Glæde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Tak for Din Sang, tak for Dit Hjertelag!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Hvor deiligt dog, ved Dødens Vinge-Slag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Ret i et Nu ind for sin Gud at træde!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
