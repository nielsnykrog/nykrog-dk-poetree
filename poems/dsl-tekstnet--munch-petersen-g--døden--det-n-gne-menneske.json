    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "det hænder, at vi er saa glade, at vi synger –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "maaske blir vi saa lykkelige, saa glade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "at vi engang stille gaar vores vej,",
