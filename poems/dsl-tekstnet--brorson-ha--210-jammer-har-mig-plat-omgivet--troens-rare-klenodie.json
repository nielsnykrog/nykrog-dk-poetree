    "year_published": 1739,
    "url": "https://tekstnet.dk/books/brorson-ha_troens-rare-klenodie/211/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Jammer har mig plat omgivet,",
      "part": false,
      "marginal_notes": [
        "Speaker: Sielen."
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Sorrig er min klæde-dragt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Angest er min deel i livet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Hiertet bever og er svagt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Gud har mig forladt i vrede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Her er ingen trøst til rede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Sorgen har for stor en magt :,:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Meget grusom er jeg dreven",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Fra vor HErres ansigt ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Og af ham befunden bleven",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Som en slem og troløs bruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Billig maa jeg skamfuld vige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "For jeg ikke lod mig sige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Ret at følge HErrens bud :,:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Ach! jeg gaaer dog vist til grunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "For anfegtnings haarde vind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Gud, som ene hielpe kunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Trænger kun med straffen ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Her vil intet anker holde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Ordets løfter ere kolde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "For mit snart fortvilet sind :,:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 9,
      "text": "Kiere siel! hold op at klage,",
      "part": false,
      "marginal_notes": [
        "Speaker: JEsus."
      ]
    },
    {
      "id": 22,
      "stanza_id": 9,
      "text": "Tonen alt for høyt er stemt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 9,
      "text": "Solen i de mørke dage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 9,
      "text": "Synes borte, død og glemt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 9,
      "text": "Sees dog siden smukt oprinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 9,
      "text": "Saa skal du engang befinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 9,
      "text": "At Gud bruger kun sin skiemt :,:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 10,
      "text": "Synes JEsus for dig borte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 10,
      "text": "O! saa kommer vist den dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 10,
      "text": "Da hand skal din nød forkorte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 10,
      "text": "Ved et lifligt favne-tag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 10,
      "text": "Lad dig aldrig det indbilde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 10,
      "text": "At din JEsus vil dig ilde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 10,
      "text": "Det er mod hans hiertelag :,:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 17,
      "text": "JEsu! lad din aand da glæde",
      "part": false,
      "marginal_notes": [
        "Speaker: Sielen."
      ]
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "Mit forknuste hierte-rod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 17,
      "text": "Saa vil jeg paa satan træde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 17,
      "text": "Ved din pine, død og blod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 17,
      "text": "Jeg vil gierne lide, stride,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 17,
      "text": "Lad mig kun, min JEsu! vide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 17,
      "text": "At min ende bliver god :,:",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
