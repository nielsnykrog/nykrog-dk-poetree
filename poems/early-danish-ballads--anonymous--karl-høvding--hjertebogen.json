{
  "id": null,
  "title": "Karl Høvding",
  "year_created": [
    1553,
    1555
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Hjertebogen",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1555,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/HJB66.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Hær Magnus redt sig under øø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": ":: - min hierteligh rosen och myn kierist - ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "feste handt Elyne Tordz-datther, saa wennen møø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Then stundt migh winder liffuit. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Her Magnus kom ther rydende y gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "udt stander hær Toordt, ær suøbt y maardt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "\"Hær stander y, hær Tordt, kiere selle myn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "thu giffuer migh Ellyne datther thin!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "Hær Toordt handt wor en mandt saa bradt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "handt gaff hende bort then same dagh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "Hær Magnus handt haffuer then iomfru fæst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "hun under Karll Høffdingh y hiertet best.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "Karll Høffdingh handt sydder offuer bræden boordt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 5,
      "text": "handt snacker saa mangt ith gammens-ordt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "\"Wy wille bort-riide under øø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "bedt om Ellyne Tordz-datther, saa wen en møø.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "Thet suarede then suendt, som handt stod nest:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 7,
      "text": "\"Hær Magnus haffuer then iomfru fest.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "\"Thet tørff iegh sette widt, alt iegh haffuer:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 8,
      "text": "her Magnus scall henne aldrigh faa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "Der tørff iegh setthe widt myn XV boo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 9,
      "text": "rett aldrigh fanger handt then iomfrues troe!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "Der tørff iegh setthe widt all myn feste:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 10,
      "text": "den iomfru under migh allerbest!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "Thii want op sægell och forgylthe fløye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 11,
      "text": "saa sæglede dii thennom fraa Raunsøø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "Bruden stander for kircke-dør,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 12,
      "text": "bleff hun seyell udi siøen war.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "\"Hisset sier iegh segell baade brune och blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 13,
      "text": "iegh wenther, Karll Høffdingh hand ær ther-paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "Hør thu, Torckell, kiere frende myn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 14,
      "text": "riidt till stranden och bædt hannom hiem!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "Karll Høffdingh handt styrede syn skyb till landt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 15,
      "text": "Torckell handt render syn gangre paa sandt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "\"I werer wel-kommen, Karll Høffding under øø!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 16,
      "text": "hær Magnus dricker brøllup medt ethers feste-møø!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "Thet ær y-dagh hendnes brøllups-dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 17,
      "text": "y kommer till hendne och giør ether gladt!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 18,
      "text": "\"Hør thu, Torckell, huad ieg siger deg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 18,
      "text": "wilt thu skiffte klædre med mig?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 19,
      "text": "Wilt thu skiffte klædre y-dag medt migh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 19,
      "text": "thet røde guldt thet giffuer ieg tigh.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 20,
      "text": "\"Iegh giør thet icke for guldt saa rødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 20,
      "text": "giff migh thin søster, then wenne møø!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 21,
      "text": "Kandt iegh thin øngste søster faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 21,
      "text": "ieg skiffter medt tigh, y-huoor thet gaar.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 22,
      "text": "Thii kunde well skiffte theris skarlagens-skindt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 22,
      "text": "thii kunde icke skiffte theris fauere kindt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 23,
      "text": "Thii skifftede skarlagen, thii skifftede maardt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 23,
      "text": "thii kunde icke skiffte theris fauere haar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 24,
      "text": "Torckell handt redt then brudt emod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 24,
      "text": "sylcke suam om heste-foodt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 25,
      "text": "Satthe thii Torckell till bencke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 25,
      "text": "Karll Høffdingh handt gick och skenkthe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 26,
      "text": "Bruden smyler under skindt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 26,
      "text": "Christ giffue then suendt, ther skencker wyn!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 27,
      "text": "Sildigh om affthen, røgh faldt paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 27,
      "text": "then unge brudt lyster att søffue gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 28,
      "text": "Thii fulde bruden till brude-huuss,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 28,
      "text": "for gaar Karll Høffdingh och bærer the bluss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 29,
      "text": "Karll Høffdingh stander for brude-sengh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 29,
      "text": "hans frende then willde handt effter lyde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 30,
      "text": "Karll Høffdingh y den brude-sengh sprang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 30,
      "text": "hand sloghte udt bluss medt huiden handt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 31,
      "text": "\"Huem ær ther y brude-huuss?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 31,
      "text": "och huem tha slucker for bruden bluss?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 32,
      "text": "\"Thet ær hær Karll aff Raunsøø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 32,
      "text": "hand ær y senge medt syn møø.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 33,
      "text": "Drotningen bødt thennom alle goode-natt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 33,
      "text": "hær Karll handt luchte den brude-dør bratt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 34,
      "text": "Drotningen gaar y sallen indt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 34,
      "text": "\"Karll Høffdingh handt soffuer hooss wnge bruden din!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 35,
      "text": "Snart wor brynen aff bielcken rycth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 35,
      "text": "dii haarde hielme om hoffden knytt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 36,
      "text": "Thii støtte paa dørren medt glauindt och spyudt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 36,
      "text": "\"Du stat op, Karll Høffdingh, du gack hær-udt!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 37,
      "text": "Melte thet bruden, ii sengen laa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 37,
      "text": "\"Thii ære saa mange, wii ære saa faa!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 38,
      "text": "Melte thet bruden medt taare paa kindt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 38,
      "text": "\"Miin kiere Karll Høffdingh, y bliffuer hære-inde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 39,
      "text": "Iegh sagde ether, hær Magnus, paa høffueloffts-broo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 39,
      "text": "det war Karll Høffdingh, iegh loffuit myn troo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 40,
      "text": "Iegh sagde ether, hær Magnus, under øø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 40,
      "text": "att ieg wor her Karlls møø.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 41,
      "text": "Hær Magnus handt støtte paa dørren medt syn foodt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 41,
      "text": "\"Stat op, Karll Høffdingh, gack migh emodt!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 42,
      "text": "Karll Høffdingh udt aff dørren løb,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 42,
      "text": "syn goode suerdt handt for sigh skødt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 43,
      "text": "Karll Høffdingh handt giorde thet y den færdt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 43,
      "text": "handt wogh hær Magnus medt sit suerdt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 44,
      "text": "\"Christ giffue thet, stalt Ellynsborgh, saa wen en møø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 44,
      "text": "thet wii wore boode paa Raunsiø!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 45,
      "text": "Thii wondne seygell saa høgt y skyy,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 45,
      "text": "och saa seglede dii till Raunsiøø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 46,
      "text": "Tack haffue Karll Høffdingh, handt holt syn troo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 46,
      "text": "medt ære lodt handt syn brollup boo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 47,
      "text": "Handt giorde sytt brøllup medt lyste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 47,
      "text": "saa gaff handt Torckell syn søster.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 48,
      "text": "Hand gaff hannom siin søster, saa wennen møø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 48,
      "text": ":: - myn hiertelige roosen och min kiere - ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 48,
      "text": "och tru-diefflen aff Raunsiø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 48,
      "text": ":: Then stundt migh winder liffuit. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}