  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "HErre Gud Fader staa oss bi",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hielp oss aff vor trang oc nød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "oc gør oss alle aff synder fri/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Saa fonge vi en salig død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Mod vore vuennerss frøct oc fare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "gør i oss bode tro oc trygge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Och lad oss paa dig bygge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "saa kan oss ingen rygge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "fri oss aff syndens snare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "At wi vndgaa dieffuelsens list",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Oc staa fast i alle frist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Vid vor herre Jesum Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Amen Amen det være Ja/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Saa siunge wi Alleluia",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Jesu Christe stat oss bi/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "hielp oss aff vor trang oc nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Oc gør oss alle aff synden fri/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Saa fonge wi en salig død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Mod vore vuenners frøct och fare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Gør oss bode tro oc trygge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Oc lad oss paa dig bygge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "Saa kand oss ingen rygge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "Fri oss saa aff syndzens snare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "At wi vndgaa dieffuelsens list/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 1,
      "text": "Oc staa faste i all frist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 1,
      "text": "ved vor herre Jesum Christ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 1,
      "text": "Amen Amen det være ia/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 1,
      "text": "saa siunge wi Alleluia",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Gud du Helligand stat oss bi/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "Dette Verss siungiss lige som de andre",
      "part": false,
      "marginal_notes": []
    }
  ]
