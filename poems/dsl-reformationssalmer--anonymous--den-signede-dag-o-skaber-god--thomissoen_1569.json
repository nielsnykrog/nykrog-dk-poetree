  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Den signede dag O Skaber god/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "som wi Søndagen nu kalde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "oc vaar den første dag oc roed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "til Verdsens gierninger alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "paa den du baade Himmel oc Jord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "met Liuss oc afften oc Morgne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "skabte met dit hellige Ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Thi hellige wi den saa gierne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Hør du vor Bøn oc see vor graad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Oc frels oss aff vore Synder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Skenck oss Naade met lycke oc raad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Oc fri oss fra vore Fiender.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Løfft vort hierte til Himmelen op/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Dit Liuss lad offuer oss skinne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "At vor Siel oc syndige Krop",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "J mørcke oss ey forblinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Den anden dag/ O Skaber bold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Som Mandag nu monne hede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Togst du Himmel met mact oc vold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Oc den lodst strax vdbrede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Vandet sette du paa sin grund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Der offuer foruden all vaade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Det vaar dit Guddommelig fund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "At det skulde Jorden ey skade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Dit hellige Ord/ din helliger Aand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Lad være vor grund oc feste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Forøg vor Tro met ret forstand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Oc kierlighed til vor Neste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Verdsens suig kast vnder vor fod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Leed oss aff Dieffuelens snare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Demp i oss vort Kiød oc blod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Lad oss icke lenger vildfare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Den Tredie dag/ O liffsens Arck/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "Som wi Tissdag monne neffne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "Gaffst du Jord met Skou oc Marck",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "Offuer Vand sin rum oc effne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "Korn oc kierne lodst du der gro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "Met Vrter oc anden grøde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "At Mennisken skulde paa Jorden bo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "Hannem gaffst du det til føde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "Giff oss regen fra Himmelen ned",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "Om Vaaren baade løff oc grene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 5,
      "text": "Blomster oc fruct om Sommersens tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 5,
      "text": "Oc Korn om Høst hin rene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 5,
      "text": "Vinter kommer met kuld oc fraast/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "Met storm oc sne hin huide/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "Forsee oss met klæder oc kaast/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "Frels oss fra sorrig oc quide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "Den Fierde dag/ O Skabere kier/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 6,
      "text": "Onsdag wi neffne saa gierne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 6,
      "text": "Skabte du Soel oc Maane saa klar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 6,
      "text": "Planeter oc liuse Stierner/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 6,
      "text": "Dem badst du paa Himmelen gaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "Baade nat oc dag at skinne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "Der til mercke oc tegen/ huor paa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "Wi Aarsens tid kunde finde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 7,
      "text": "Retuisheds Soel oc Verdsens Liuss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 7,
      "text": "Wi bede dig nu saa gierne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 7,
      "text": "Thi du est eniste klog oc viss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 7,
      "text": "Lad skinne din Morgens stierne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 7,
      "text": "Vdi vort hierte/ dit hellige Ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 7,
      "text": "At wi det onde kunde skillie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 7,
      "text": "Fra det gode/ her nedre paa Jord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "Oc leffue saa effter din villie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 8,
      "text": "Den Femte dag/ O Skaber mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 8,
      "text": "Som Taarsdags naffn monne haffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 8,
      "text": "Fule i Sky oc Fisk i Vand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 8,
      "text": "Saa herlige skenck oc gaffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 8,
      "text": "Skabte du/ til Menniskens Mad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 8,
      "text": "J vær oc Vand at flyde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 8,
      "text": "Paa det Mennisken kunde dem faa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 8,
      "text": "Til Mad oc Kaast at nyde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 9,
      "text": "Giff oss Herre vor daglige brød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 9,
      "text": "Vor daglige kaast oc klæde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 9,
      "text": "Lad oss icke aff hunger dø/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 9,
      "text": "Forsørge oss met vor føde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 9,
      "text": "Velsigne du vort Huss oc hiem/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 9,
      "text": "Vore Børn oc tiund til gode/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 9,
      "text": "At wi maatte forsørge dem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 9,
      "text": "Giff Fule/ oc Fisk i Flode.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 10,
      "text": "Den Siette dag/ O Skaber blid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 10,
      "text": "Som Fredag lader sig kalde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 10,
      "text": "Skabte du til rette tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 10,
      "text": "Diur/ Orme oc Beester alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 10,
      "text": "Oc strax Mennisken met it Ord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 10,
      "text": "Skabte du baade Mand oc Quinde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 10,
      "text": "Met Siel oc Krop aff Aand oc Jord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 10,
      "text": "Met skel fornufft oc sinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 11,
      "text": "Opret vor forkrenckte natur",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 11,
      "text": "Oc skenck oss Sielsens føde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 11,
      "text": "For Adams Eble vaar beeskt oc surt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 11,
      "text": "Oc dømde oss alle til døde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 11,
      "text": "Aandelig ro oc Legemlig fred",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 11,
      "text": "Lad oss i Verden at hende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 11,
      "text": "Ret formaal oc Christelig død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 11,
      "text": "Naar dette liff haffuer ende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 12,
      "text": "Den Siste dag/ O Skaber klog/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 12,
      "text": "Holde wi Løffuerdag at være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 12,
      "text": "Om den staar screffuit i Lousens bog/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 12,
      "text": "Alt til din loff oc ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 12,
      "text": "Alt paa den dag huilde du dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 12,
      "text": "For Himmel oc Jord stode rede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 12,
      "text": "Huert Creatur vel skabt for sig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 12,
      "text": "Derfor wi dig tilbede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 13,
      "text": "Derfor giff oss en stadelig Tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 13,
      "text": "At wi ret aldrig tuile",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 13,
      "text": "At faa den euige glæde oc ro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 13,
      "text": "Met dig i Himmerig at huile/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 13,
      "text": "Den euige Soel oc Sabbaths tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 13,
      "text": "Lad oss i Himmerig optende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 13,
      "text": "Giff oss siden baade glæde oc fryd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 13,
      "text": "Hoss dig foruden all ende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 14,
      "text": "HErre Gud Fader være loff oc tack/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 14,
      "text": "Der alting skabte met sin mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 14,
      "text": "Himmel oc Jord/ alt met sit ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 14,
      "text": "Oss alle til gode haffuer hand det giort.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 15,
      "text": "Hand skabte met stor ære oc krafft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 15,
      "text": "Englerne met Herredom oc mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 15,
      "text": "Oc sette hand dem vdi sin Chor/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 15,
      "text": "At de skulle giøre hannem ære stor.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 16,
      "text": "Men da en part aff Englernis tal/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 16,
      "text": "Lode sig formegit tycke met all/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 16,
      "text": "Støttis de strax aff Himmelen ned/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 16,
      "text": "Til euige pine i Helffuedis glød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 17,
      "text": "At Gud nu effter Englernis fald/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 17,
      "text": "Kunde met andre opfylde sin Sal/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 17,
      "text": "Menniskens køn skabte hand saa reen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 17,
      "text": "At i hannem vaar slet intet meen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 18,
      "text": "At sette hannem hen i Paradiss ind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 18,
      "text": "Oc giffue hannem nock/ fick Gud i sind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 18,
      "text": "Men vissdoms træ hand hannem forbød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 18,
      "text": "Eller hand skulde faa den visse død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 19,
      "text": "J Orme lige da kom Satan/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 19,
      "text": "Oc strax foruende Guds Ord oc Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 19,
      "text": "Slo vore Forældre ned i Synd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 19,
      "text": "Oss der met at fordærffue i grund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 20,
      "text": "Aff Adams synd kom bitter død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 20,
      "text": "Oc all vor sorrig/ angist oc nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 20,
      "text": "Synden regerede met stor vold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 20,
      "text": "Oc døden baade offuer vng oc old.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 21,
      "text": "Da sende Gud sin Søn saa kier/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 21,
      "text": "Der fands icke anden Frelsere meer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 21,
      "text": "Hand bleff Menniske from oc god/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 21,
      "text": "Dog leed hand jammer oc armod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 22,
      "text": "Begynte hand strax i sin Barndom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 22,
      "text": "At bære vor byrde met stor modgong/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 22,
      "text": "For Adams synd hand giorde bod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 22,
      "text": "Tre Aar oc tredue met taalmod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 23,
      "text": "Hand tiente oss met gierning oc ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 23,
      "text": "Gick for oss gennem den sneffre Port/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 23,
      "text": "Lærde oss at komme til Gud igen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 23,
      "text": "Fly synd/ tro Gud/ oc bliffue hans ven.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 24,
      "text": "Der hand da haffde Guds ord fremført/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 24,
      "text": "Oc oss den rette Guds tieniste lærd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 24,
      "text": "Taalde hand den suare bittere død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 24,
      "text": "Hialp oss der met fra Helffuedis nød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 25,
      "text": "Hand stod aff døde met stor krafft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 25,
      "text": "Andre befalede sit budskab/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 25,
      "text": "Hand foer til Himmelen/ der hand nu",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 25,
      "text": "Sider hoss sin Fader met glæde oc ro.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 26,
      "text": "Hand sende oss hid den hellig Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 26,
      "text": "At skicke vore Hierter til ret forstand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 26,
      "text": "At de kunde søge delactighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 26,
      "text": "Hoss Jesum Christ vor salighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 27,
      "text": "Dig Gud Fader i euighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 27,
      "text": "Met din Søn lige i Herlighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 27,
      "text": "Den hellig Aand disligeruiss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 27,
      "text": "J euighed ske loff oc priss.",
      "part": false,
      "marginal_notes": []
    }
  ]
}