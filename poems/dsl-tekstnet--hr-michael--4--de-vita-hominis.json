  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "En fugiens trocum rogo sit michi nemo molestus",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "impediendo iocum quia ludus habetur honestus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Jeg leghær nw top meth andræ børn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "mynæ wingher slaar ieg som en ørn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "huo kan mig thet formenæ?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Huod ieg heltz tal, skiøder ey mynæ ord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "at ligghæ gaar ieg ickæ enæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Thet giffuer mig æy myt rætthæ sckiæl,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "hwad helder ieg gør ildhæ eller wæl,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Ihuad ieg gør, eller huort ieg gaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "dødhæn han altijd foræ mig staar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "ieg wedh han wil mig mødhæ.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
