  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Høistærede! – jeg troer De vil mig kjende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "De veed jeg fører ei den lange Snak;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "En kort Replik og saa er Alt tilende –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Iaften skal jeg sige – »Mangetak!«",
      "part": false,
      "marginal_notes": []
    }
  ]
}
