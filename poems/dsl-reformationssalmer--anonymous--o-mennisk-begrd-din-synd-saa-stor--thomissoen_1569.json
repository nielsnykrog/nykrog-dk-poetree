  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Mennisk begræd din Synd saa stor/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "for huilcken Christus nederfoer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "fra Faderens skød til Jorden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Vd aff en Jomfru reen oc klar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "for oss it Menniske fødder vaar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "vor Megler er hand vorden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "De døde deris liff hand gaff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "de Siugis kranckhed lagde hand aff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "til tiden sig fremtrengde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "at hand for vor skyld offrit bleff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "oc vor suare Synder bortdreff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "paa Kaarssit vilde hand henge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Da Jødernis Paaske høytid kam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Jesus sine Discipler til sig nam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Oc snarlig til dem sagde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Menniskens Søn forraadis skal/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Pinis Kaarsfestis oc slaes ihiel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "J disse høytids dage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "J Simons Huss en Quinde kam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Kaastelig Salue hun met sig nam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Lod den paa Herren flyde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "Somme Discipler knurrede oc ved/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "Jesus prisede Quinden for det/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "Det monne Judas fortryde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Til Præste høffdinge hand sig gaff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Til forræderi vaar hans hiertelag/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Tog trediue Sølffpenning i hende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Jesus til sine Discipler kam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Oc oed met dem deris Paaske Lam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "Oc giorde der paa en ende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "Hand sette oss it Testament/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "Hans død til yderst ende at betenck/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "Deris Føder hand oc toede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 2,
      "text": "Om kierlighed vnderuisde dem/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 2,
      "text": "Hand sagde/ J løbe strax fra mig hen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 2,
      "text": "Hand trøstet dem met all gode.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "Der nest hand til Oliebiergit kam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "Stor skelffuen oc beffren der fornam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "Hand bad at de skulde vaage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "Jt stenskast monne hand fra dem gaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 3,
      "text": "Oc bad da til sin Fader saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 3,
      "text": "Staar det til i nogen maade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 3,
      "text": "At denne Kalck kand tagis fra mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 3,
      "text": "Thi Fader alting er mueligt for dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 3,
      "text": "Jeg setter det i din villie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 3,
      "text": "Saadan en Bøn hand tregang bad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 3,
      "text": "Saa tijt hand til Disciplerne traadde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 3,
      "text": "Da soffue de Alle stille.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 4,
      "text": "J soffue (sagde hand) oc ieg lider møde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 4,
      "text": "J acte icke mig at faa it stød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 4,
      "text": "Menniskens Søn skal giffuis",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 4,
      "text": "J Fienders hender/ Staar nu op/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 4,
      "text": "See hissit kommer den syndige krop/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 4,
      "text": "Thi maa i vaagen bliffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 4,
      "text": "Som hand da talede disse Ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 4,
      "text": "Da kom Judas met en Skare stor/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 4,
      "text": "Met Spedze Lycter oc Stenger/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 4,
      "text": "Jt Tegn den Forræder fra sig gaff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 4,
      "text": "Paa en kyss skulle i mercke mig aff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 4,
      "text": "Huilcken der i skulle fange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 5,
      "text": "Fordi Jesus vel viste alting/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 5,
      "text": "Gick hand frem som de stode omkring/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 5,
      "text": "Hand sagde til dem met gode.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 5,
      "text": "Huem lede i effter met slig mact?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 5,
      "text": "De sagde/ Paa Jesum haffde wi act.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 5,
      "text": "De fulde tilbage paa Jorden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 5,
      "text": "Judas kyste hannem forrædelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 5,
      "text": "Saa grebe de hannem met falsk oc suig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 5,
      "text": "De vredis offuer all maade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 5,
      "text": "Peder sit Suerd vdrycte da/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 5,
      "text": "Bispens Suend hug hand ørit fra/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 5,
      "text": "Jesus da til hannem sagde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 6,
      "text": "Stick ind dit Suerd i Balgen sin/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 6,
      "text": "Skal ieg icke dog dricke Kalcken min?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 6,
      "text": "Saa lægte hand Malchi øre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 6,
      "text": "De ledde Jesum til Annam hen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 6,
      "text": "Dernest til Caipham hans wuen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 6,
      "text": "Monne de hannem bunden føre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 6,
      "text": "Petrus fulde met i Stuen ind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 6,
      "text": "At vide enden det vaar hans sind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 6,
      "text": "Tre gange forsoer hand Herren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 6,
      "text": "Bispen frittede Jesum fast/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 6,
      "text": "De søgte falskt Vidnisbyrd met en hast/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 6,
      "text": "At omkomme hannem aff Verden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 7,
      "text": "Christus suarede hannem intet da/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 7,
      "text": "Thi talede Bispen til hannem saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 7,
      "text": "Huad vilt du her til suare?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 7,
      "text": "Jeg maner dig ved den Leffuendis Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 7,
      "text": "Est du Christ Guds Søn/ sig det vd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 7,
      "text": "Jesus sagde obenbare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 7,
      "text": "Jeg er/ oc siger denne tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 7,
      "text": "At i skulle see Menniskens Søn friit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 7,
      "text": "Fremkomme i Skyerne klare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 7,
      "text": "Oc sidde der hoss Guds høyre side.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 7,
      "text": "Bispen begynte sine klæder at slide/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 7,
      "text": "Nu kand ieg selff forfare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 8,
      "text": "At hand bespotter Gud nu her/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 8,
      "text": "Sagde hand/ Mercker huad ville wi mere?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 8,
      "text": "De sagde/ Mand skal hannem døde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 8,
      "text": "De spyttede hannem i hans øyne friit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 8,
      "text": "Sloge hannem kindhest samme tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 8,
      "text": "Stor spot maatte hannem der møde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 8,
      "text": "De bunde for hans Ansict da/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 8,
      "text": "Oc sloge hannem met deris neffuer saa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 8,
      "text": "Gæt til huem dette giorde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 8,
      "text": "Om Morgenen kom den gantske Skare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 8,
      "text": "Alle haffde de Jesum at tage vare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 8,
      "text": "Alle hannem fordømme torde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 9,
      "text": "Pilato antuorde de hannem da/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 9,
      "text": "Men der Judas oc saadant saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 9,
      "text": "Da gruede hand for sine synder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 9,
      "text": "De penninge bar hand Præsterne igen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 9,
      "text": "Ah ieg syndig forraadde Guds Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 9,
      "text": "Min wdyd ieg nu kiender.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 9,
      "text": "Saa hengde hand sig/ oc sønder sprack.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 9,
      "text": "Præsterne begynte da at snacke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 9,
      "text": "Huort skulle de penninge høre?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 9,
      "text": "En Pottemagers Jord da kiøbte de",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 9,
      "text": "Til at begraffue Pillegrime vdi/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 9,
      "text": "Som Propheten kundgiører.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 10,
      "text": "Da Jesus for Pilato stod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 10,
      "text": "De vaare mange hannem stode imod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 10,
      "text": "Oc høyelig paa hannem klagde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 10,
      "text": "Keyseren haffuer hand giort imod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 10,
      "text": "Oc siger sig at være Guds Søn god/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 10,
      "text": "Bedrager Folck alle dage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 10,
      "text": "Pilatus frittede hannem da saare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 10,
      "text": "Men Jesus vilde hannem intet suare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 10,
      "text": "Det tøcte hannem ont at være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 10,
      "text": "Hand sende hannem til Herodes frem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 10,
      "text": "Herodes glæddis offuer hannem/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 10,
      "text": "Euentyr aff hannem begærde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 11,
      "text": "Da Jesus vilde hannem intet suare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 11,
      "text": "Da tog Herodes det til fare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 11,
      "text": "Til Pilatum hand hannem sende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 11,
      "text": "Pilatus sagde til Jøderne da/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 11,
      "text": "Met denne ieg ingen Sag kand faa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 11,
      "text": "Herodes ey heller kunde finde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 11,
      "text": "En Seduan haffue i altid hafft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 11,
      "text": "J eders Høytid en Fange forlat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 11,
      "text": "Jesum vil ieg løss giffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 11,
      "text": "De robte alle som de kunde mest/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 11,
      "text": "Tag Jesum lad hannem bliffue Kaarsfest/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 11,
      "text": "Lad Barrabam leffuendis bliffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 12,
      "text": "Pilatus Jesum hudstryge loed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 12,
      "text": "Oc vilde icke være den Skare imod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 12,
      "text": "Jt Purpur bleff hand idragen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 12,
      "text": "En Torne krune veffuede de saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 12,
      "text": "At hun igennem hans hoffuit skulle gaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 12,
      "text": "Met it Rør bleff hand slagen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 12,
      "text": "De kallede hannem en Konge paa spe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 12,
      "text": "Bespytte Ansictit/ det giorde hannem vee/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 12,
      "text": "De sloge hannem paa hans hoffuit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 12,
      "text": "Pilatus sagde/ See huilcken Mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 12,
      "text": "J hannem ieg ingen wret finde kand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 12,
      "text": "Det siger ieg paa min loffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 13,
      "text": "De robte alle met stemme stort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 13,
      "text": "Kaarsfeste/ kaarsfeste/ tag hannem bort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 13,
      "text": "Eller Keyseren din wuen bliffuer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 13,
      "text": "Der Pilatus hørde disse ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 13,
      "text": "Da sette hand sig ved Dommerens bord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 13,
      "text": "Met tuct sig wskyldig giffuer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 13,
      "text": "Hand gaff den Morder Barrabam løss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 13,
      "text": "Men Jesus skulle kaarsfestis vist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 13,
      "text": "Alt effter deris falske villie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 13,
      "text": "Hans Klæder monne de hannem iføre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 13,
      "text": "Hans Kaarss finge de hannem selff at bære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 13,
      "text": "De robte/ men hand gick stille.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 14,
      "text": "Den tid de ginge vd met hannem/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 14,
      "text": "Nødde de Simon/ som gick der frem/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 14,
      "text": "At hand hans Kaarss skulle bære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 14,
      "text": "Der stode de Quinder saa saare de græde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 14,
      "text": "Thi kunde Jesus det ey forgæde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 14,
      "text": "Men vende sig/ dem at lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 14,
      "text": "Oc sagde/ græder icke offuer mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 14,
      "text": "Sions Døtter/ græder huer for sig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 14,
      "text": "Oc saa for Børnene sine/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 14,
      "text": "Den dag skal komme ati skulle sige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 14,
      "text": "Salig ere de wfructsommelige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 14,
      "text": "Saa stor bliffuer sorrig oc pine.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 15,
      "text": "Til Galliebierg komme de hen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 15,
      "text": "Der møtte dem to Misdedere igen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 15,
      "text": "Som ocsaa bleffue kaarsfeste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 15,
      "text": "Hoss Jesu høyre oc venstre haand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 15,
      "text": "Som Scrifften giffuer til forstand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 15,
      "text": "Der bad Jesus deris bæste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 15,
      "text": "Forlad dem Fader dette stycke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 15,
      "text": "Thi huad de giøre det vide de icke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 15,
      "text": "Da loed Pilatus scriffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 15,
      "text": "Ebraiske Gredske och saa Latine/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 15,
      "text": "Jesus Jøde Konge en Nazaren/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 15,
      "text": "Det monne Præsterne fortryde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 16,
      "text": "Der Jesus nu saa Kaarsfest vaar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 16,
      "text": "Da toge Bødlene hans klæder snart/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 16,
      "text": "Doblede huem dem skulde haffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 16,
      "text": "Da Jesus nu sin Moder saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 16,
      "text": "Oc Johannes der hoss hende staa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 16,
      "text": "Monne hand hende befale.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 16,
      "text": "See Quinde din Søn i steden min/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 16,
      "text": "Johannes see du Moder din/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 16,
      "text": "Strax monne hand hende anamme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 16,
      "text": "Bisperne oc Præsterne bespottede Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 16,
      "text": "Met andre som der vaare komne vd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 16,
      "text": "De giorde det allesammen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 17,
      "text": "Est du den leffuendis Guds Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 17,
      "text": "Da hielp dig neder aff Kaarssit igen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 17,
      "text": "Røffueren sagde deslige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 17,
      "text": "Den ene sig til den anden kerde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 17,
      "text": "Jesum wskyldig hand hannem lærde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 17,
      "text": "Hand tenckte paa Christi Rige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 17,
      "text": "Herre naar du kommer i Rigit dit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 17,
      "text": "Jeg beder du vilde mig ey forgette.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 17,
      "text": "Hand sagde/ du skalt hoss mig bliffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 17,
      "text": "Jt Mørck kom paa den siette stund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 17,
      "text": "Ved ni robte hand aff hiertens grund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 17,
      "text": "Suarlig monne hand sig giffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 18,
      "text": "Min Gud min Gud hui forlodst du mig?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 18,
      "text": "Da bespottede de hannem huer ved sig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 18,
      "text": "Edicke monne de hannem skencke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 18,
      "text": "Jesus det smagede oc vilde icke dricke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 18,
      "text": "Hand sagde/ det er fuldkommit huert stycke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 18,
      "text": "Sit hoffuit loed hand ned sencke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 18,
      "text": "O Fader vdi hender dine/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 18,
      "text": "Vil ieg nu befale Aanden min/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 18,
      "text": "Met høyer Røst hand robte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 18,
      "text": "Gaff op sin Aand/ men samme stund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 18,
      "text": "Templens Forheng brast mangelund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 18,
      "text": "Oc Stenene sloges til hobe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 19,
      "text": "Jorden hun skalff oc røstede der aff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 19,
      "text": "Der oplods mangen Dødis graff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 19,
      "text": "Høffuitzmanden met sine knecte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 19,
      "text": "Sagde/ hand vaar sandelige Guds mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 19,
      "text": "Oc Guds Søn som oss tyckis kand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 233,
      "stanza_id": 19,
      "text": "Wi kunde det icke necte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 234,
      "stanza_id": 19,
      "text": "De sønderbrøde da Røffuernis been/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 235,
      "stanza_id": 19,
      "text": "Men Jesu giorde de icke den meen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 236,
      "stanza_id": 19,
      "text": "En stack hannem i hans side/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 237,
      "stanza_id": 19,
      "text": "Der vdflød Vand oc Blod saa klar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 238,
      "stanza_id": 19,
      "text": "Som Sancte Hans vidnisbyrd om bar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 239,
      "stanza_id": 19,
      "text": "Scrifften monne det vdtyde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 240,
      "stanza_id": 20,
      "text": "Der det da hart mod afften kam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 241,
      "stanza_id": 20,
      "text": "Den fromme Joseph Jesum nam",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 242,
      "stanza_id": 20,
      "text": "Aff Kaarssit/ loed hannem begraffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 243,
      "stanza_id": 20,
      "text": "Der til oc Nicodemus kam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 244,
      "stanza_id": 20,
      "text": "Mirrha oc Aloe hand met sig nam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 245,
      "stanza_id": 20,
      "text": "Jesu krop det skulde haffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 246,
      "stanza_id": 20,
      "text": "De suøbte hannem i it Linklæde rent/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 247,
      "stanza_id": 20,
      "text": "Hand bleff lagd i en graff aff Sten/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 248,
      "stanza_id": 20,
      "text": "Der i vaar ingen begraffuen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 249,
      "stanza_id": 20,
      "text": "Saa stor en Sten lagde de der paa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 250,
      "stanza_id": 20,
      "text": "Saa monne de bort fra Graffuen gaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 251,
      "stanza_id": 20,
      "text": "Deris Sabbaths huile at haffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 252,
      "stanza_id": 21,
      "text": "Jøderne giorde sig mere wmage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 253,
      "stanza_id": 21,
      "text": "Beuarede hans Graff til tredie dag/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 254,
      "stanza_id": 21,
      "text": "Hand stod op fra dem alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 255,
      "stanza_id": 21,
      "text": "At hand vilde oss Retfærdige giøre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 256,
      "stanza_id": 21,
      "text": "Oc oss met sig til sit Rige føre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 257,
      "stanza_id": 21,
      "text": "Synden skal oss ey offuerfalde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 258,
      "stanza_id": 21,
      "text": "Derfor ville wi nu glade være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 259,
      "stanza_id": 21,
      "text": "At Jesus Christ vor broder kier/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 260,
      "stanza_id": 21,
      "text": "Haffuer nu offueruundit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 261,
      "stanza_id": 21,
      "text": "For oss vor Synd oc alle nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 262,
      "stanza_id": 21,
      "text": "Helffuede oc den euige død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 263,
      "stanza_id": 21,
      "text": "Dieffuelen haffuer hand bundit.",
      "part": false,
      "marginal_notes": []
    }
  ]
}