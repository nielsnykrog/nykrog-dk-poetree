  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "AF dybsens nød raaber ieg til dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Herre Gud vilt du mig høre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Din naadsens Øern vent du til mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "min røst ieg nu framfører/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "giffuer du paa vor gierninger act/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "at heffne Synden met din mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "O Herre huo kand det taale?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Hoss dig allene gielder Naade oc gunst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Til Synden at forlade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Naar wi dig nogen tid haffue mist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Wi vide oss ey at raade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "For dig ingen sig berømme kand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Thi maa dig frycte alle mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Oc trøste dem paa din Naade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Til Gud staar all mit Haab oc trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Min gierning kand mig ey bade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "J det du ene haffuer mig forløst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Aff din wsigelig naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Dine Ord de ere en dyrebar Skat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Som du oss haffuer effterlat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Dem ville wi gierne høre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Skulde det vare fra Morgen stund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "Oc indtil afftens ende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Da skulde mit hierte ingelund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Fortuile/ eller fra dig vendis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Saa bør at være ret Jsraels art/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "At haabe oc tro aff hiertet snart/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Oc naade aff hannem begære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Dog Synden hoss oss er mangefuld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "Hoss Gud er meget meer Naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "At hielpe oss er hand vel huld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "Aff nød oc alskens vaade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Hand er foruist den rette Tolck/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "Som haffuer forløst all Jsraels Folck",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "Aff sorrig oc Synder alle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Gud Fader Søn oc den hellig Aand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "Hannem ville wi prise oc ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "Thi oss haffuer ingen frelst vden hand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "Som wi aff Scrifften lære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "Thi bør hannem loff oc tack allen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "Til euig tid foruden meen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "Der til sige wi nu Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "INuocauit me,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "et ego exaudiam eum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "eripiam eum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 6,
      "text": "et glorificabo eum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 6,
      "text": "longitudine dierum adimplebo eum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 6,
      "text": "Qui habitat in adiutorio altissimi:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "in protectione Dei Coeli commorabitur.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 6,
      "text": "Gloria Patri et Filio et Spiritui sancto:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 6,
      "text": "Sicut erat in principio et nunc et semper, et in secula seculorum, Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 7,
      "text": "HAleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 8,
      "text": "Domine non secundum peccata nostra facias nobis, neque secundum iniquitates nostras retribuas nobis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 9,
      "text": "Domine ne memineris iniquitatum nostrarum antiquarum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 9,
      "text": "Cito anticipent nos misericordiæ tuæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 9,
      "text": "Quia pauperes facti sumus nimis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 10,
      "text": "Adiuua nos Deus salutaris noster,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 10,
      "text": "et propter gloriam nominis tui Domine libera nos,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 10,
      "text": "et propitius esto peccatis nostris,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 10,
      "text": "propter nomen tuum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 10,
      "text": "Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 11,
      "text": "WJ arme Adams børn alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 11,
      "text": "wi ere saa dybt i Synden faldne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 11,
      "text": "Thi ville wi alle Gud paakalle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 12,
      "text": "Nu bede wi den hellig Aand etc.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 13,
      "text": "Vor natur er baade mørck oc blind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 13,
      "text": "met all forstand skæl siel oc sind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 13,
      "text": "Thi ville wi alle til Gud falde ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 14,
      "text": "Du værdige giff oss dit skin etc.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 15,
      "text": "Wi hade alt det oss er imod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 15,
      "text": "En vil ey være den anden god/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 15,
      "text": "Thi giff du oss it bedre mod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 16,
      "text": "Du søde Aand skenck etc.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 17,
      "text": "Huer er gantske forfengelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 17,
      "text": "ey vden kiød oc blod met falsk oc suig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 17,
      "text": "Thi ville wi nu alle bede dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 18,
      "text": "Du ypperste trøst etc.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "GVd Fader oc Søn oc Hellig Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "hannem bør oss prise oc ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "Hand giør miskund i alle Land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 19,
      "text": "som wi maa daglige lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 19,
      "text": "Hand haffuer beuist stor kierlighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 19,
      "text": "mod Menniskens køn saa mange led/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 19,
      "text": "som wi ville faa at høre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 20,
      "text": "J Dieffuelens vold ieg fangen laa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 20,
      "text": "Jeg vaar fordømt til døde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 20,
      "text": "Min synd mig qualde baade nat oc dag/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 20,
      "text": "Jeg haffde stor angist oc møde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 20,
      "text": "Oc altid sanck ieg dyber ned/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 20,
      "text": "Der vaar ey raad ey salighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 20,
      "text": "Jeg vaar i Synden vndfangen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 21,
      "text": "Min gode gierninger de hiulpe mig ey/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 21,
      "text": "De kunde ey døden offueruinde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 21,
      "text": "Den stercke Dieffuel hand sagde ney/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 21,
      "text": "Hand vilde ey lade sig binde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 21,
      "text": "Aff mig eller noget Creatur/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 21,
      "text": "Jeg vaar i hans vold aff min natur",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 21,
      "text": "Fordømt til euig pine.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 22,
      "text": "Der vaar oc ingen i Verden til/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 22,
      "text": "Der mig forløse kunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 22,
      "text": "Jeg veed ret aldrig huort ieg vil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 22,
      "text": "Jeg maa til Helffuedis grunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 22,
      "text": "For Guds vrede der offuer mig er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 22,
      "text": "Oc syndsens byrde der ieg nu bær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 22,
      "text": "Fortabit maa ieg bliffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 23,
      "text": "Da ynckede Gud i euighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 23,
      "text": "Min ælende offuer maade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 23,
      "text": "Hand tenckte paa sin Barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 23,
      "text": "Hand vilde mig hielpe lade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 23,
      "text": "Sit Faderligt hierte vende hand til mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 23,
      "text": "Hand kaaste der paa foruden suig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 23,
      "text": "Det kieriste der hand haffde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 24,
      "text": "Hand talede til sin kiere Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 24,
      "text": "Det er nu tid at forbarme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 24,
      "text": "Du skalt det giøre for min bøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 24,
      "text": "Far heden oc frels de arme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 24,
      "text": "Oc løss dem vdaff Syndsens nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 24,
      "text": "Oc sla ihiel den haarde død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 24,
      "text": "Oc lad dem met dig leffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 25,
      "text": "Guds Søn sin Fader lydactig vaar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 25,
      "text": "Hand kom til mig paa Jorden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 25,
      "text": "Aff en Jomfru baade reen oc klar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 25,
      "text": "Hand vilde min Broder vorde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 25,
      "text": "Saa lønlige førde hand sin stat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 25,
      "text": "Leed alskens nød oc megen platz/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 25,
      "text": "For hand vilde Dieffuelen fange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 26,
      "text": "Guds Søn hand sagde/ kom hid til mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 26,
      "text": "Jeg vil mig offuer dig forbarme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 26,
      "text": "Jeg taalde den bittre død for dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 26,
      "text": "Der met du Himmerige skalt arffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 26,
      "text": "Nu er ieg din oc du est min/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 26,
      "text": "Oc huor ieg er der skalt du være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 26,
      "text": "Den fiende skal oss ey atskillie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 27,
      "text": "Huem haffuer hørt større kierlighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 27,
      "text": "End døden for wuenner at lide?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 27,
      "text": "Det haffuer ieg ene giort for dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 27,
      "text": "At du skulde met mig bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 27,
      "text": "Jeg er den ene der hielpe kand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 27,
      "text": "Thi kommer til mig baade quinde oc mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 27,
      "text": "Oss skal ret ingen atskillie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 28,
      "text": "Mit blod det flyder paa Jorden vd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 28,
      "text": "Jeg bær det kaarss met møde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 28,
      "text": "Jeg lider for dig den haarde død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 28,
      "text": "Tag tro oc lad dig døbe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 28,
      "text": "Mit liff offueruinder den død met mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 28,
      "text": "All Verdsens synder er paa mig lagt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 28,
      "text": "Thi est du salig vorden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 29,
      "text": "Til Himmels igen til Fader min/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 29,
      "text": "Far ieg fra denne ælende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 29,
      "text": "Der vil ieg være Mester din/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 29,
      "text": "Den hellig Aand dig at sende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 29,
      "text": "Som dig i angiste trøste skal/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 29,
      "text": "Oc dig vnderuise oc lære vel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 29,
      "text": "J sandheds vey at vandre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 30,
      "text": "Huad ieg haffuer giort vnderuist oc lærd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 30,
      "text": "Det skalt du giøre oc lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 30,
      "text": "Der met mit Rige opfylt bliffuer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 30,
      "text": "Mig selff til loff oc ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 30,
      "text": "Foruare dig vel for Menniskens sæt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 30,
      "text": "Som oss foruender den Christelige ræt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 30,
      "text": "Det giffuer ieg dig tilkiende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 31,
      "text": "Du skalt predicke den Christelige tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 31,
      "text": "Som ieg befaler at lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 31,
      "text": "Elsker huer andre baade silde oc fro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 31,
      "text": "Det skal mit Budord være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 31,
      "text": "For Dieffuelens lærdom vocte dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 31,
      "text": "Thi hand er falsk oc skadelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 31,
      "text": "Guds ord det bliffuer euindelig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 32,
      "text": "Thi ville wi prise i euighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 32,
      "text": "Oc loffue foruden all ende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 32,
      "text": "Gud Faders store barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 32,
      "text": "Som oss den naade sende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 32,
      "text": "Oc nederslog i Christi død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 32,
      "text": "Helffuede Synd oc Dødsens nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 32,
      "text": "Huo kand oss nu fordærffue?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 33,
      "text": "JEsu Christ dig tacke wi/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 33,
      "text": "du loedst oss icke fortabis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 33,
      "text": "Fra vor Synd giorde du oss fri/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 33,
      "text": "du vilde selff for oss plagis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 33,
      "text": "Thi du haffde oss inderlig kier/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 33,
      "text": "vel dem det kunde besinde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 33,
      "text": "at du for vor skyld døder er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 33,
      "text": "der met wi Himmerig vinde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 33,
      "text": "haffde du icke dit Blod vdgiffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 33,
      "text": "och saa for oss betalit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 33,
      "text": "da haffde wi alle fortabit bleffuet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 33,
      "text": "til Helffuedis grund nedfaldit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 33,
      "text": "Jesu Christ wi tacke dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 33,
      "text": "wi loffue dig/ wi prise dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 34,
      "text": "Huo haffuer hørt slig Kierlighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 34,
      "text": "Som Gud Fader haffuer oss beteed?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 34,
      "text": "Wi som vaare aff Synder leed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 34,
      "text": "Thi alle hans Bud haffde wi forget/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 34,
      "text": "Derfaare vaar hand paa oss vred/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 34,
      "text": "Wi vaare hans wuenner alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 34,
      "text": "Euig pine haffde wi fortient/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 34,
      "text": "Ret baade vnge oc gamle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 34,
      "text": "Men Gud for sin miskundhed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 34,
      "text": "Monne sig offuer oss forbarme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 34,
      "text": "Sin eniste Søn sende hand her ned/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 34,
      "text": "At frelse oss wsle oc arme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 34,
      "text": "Jesu Christ wi tacke dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 34,
      "text": "Wi loffue dig/ wi prise dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 35,
      "text": "Derfaare skulle wi være glade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 35,
      "text": "Oc altid Gud fast loffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 35,
      "text": "Hand vil inted andet haffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 35,
      "text": "For sin velgierning oc gaffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 35,
      "text": "End at wi skulle Synden offuergiffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 35,
      "text": "Derfaare leed Guds Søn pine/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 35,
      "text": "At wi skulle nu ret Christelige leffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 35,
      "text": "Huer anden elske oc lide/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 35,
      "text": "Giøre dem gaat som oss giøre ont/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 35,
      "text": "Som Gud imod oss monne giøre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 35,
      "text": "Der paa kiendis wi at være Guds folck/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 35,
      "text": "Om wi oss i kierlighed øffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 35,
      "text": "Jesu Christ wi tacke dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 35,
      "text": "Wi loffue dig/ wi prise dig.",
      "part": false,
      "marginal_notes": []
    }
  ]
}