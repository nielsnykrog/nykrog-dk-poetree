  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1847,
    "url": "https://tekstnet.dk/books/ploug-c_grundloven-1/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Loven blev til, hvormed Landet skal bygges,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Træet er sat, hvoraf Slægter skal skygges,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Marv er i Stammen, og sund er dets Rod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Broderlig delte vi, Høje og Lave,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Karrigt ej Kongen udmaalte sin Gave;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Vi havde Mod til at ta' derimod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Men, hvad vi fik uden Kamp, er ej vundet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Sejerens Krands er endnu ikke bundet;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Kampen vil komme, og nu er den nær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Det gaar ej godt, om vi styre iblinde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Udenfor kule de østlige Vinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Og her forinden er Klipper og Skær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Dog skal det gaa, naar med Lempe vi fare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Og ta'r paa Vinden og Voverne Vare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Ja, naar hver Mand kun vil gjøre sin Pligt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Naar vi for Skygger kun ikke er bange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Naar vi ej dysses af Selvsygens Slange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Men har det Hele og Alles i Sigt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Derfor kun fremad til Kamp og til Sejer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "Ej vil vi spare de Kræfter, vi ejer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "Naar vi for Dannemarks Fremtid skal slaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "Kongen er trofast, han vil ikke svige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "Folket er enigt, det vil ikke vige:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "Landet skal bygges, og Loven skal staa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "Paa Danmarks rige Slette",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "Engang et Majtræ stod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "Som Frederik den Sjette",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "For Folket plante lod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "Det kaldte os til Thinge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "Alt med sin Fane grøn;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "Derhen vi skulde bringe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "Vort Ønske og vor Bøn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 0,
      "text": "Tynd var kun Træets Krone,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 0,
      "text": "Og Stammen var kun kort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 0,
      "text": "Og Bønnens svage Tone",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 0,
      "text": "I Vinden døde bort;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 0,
      "text": "Men Bladene, de spæde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 0,
      "text": "Jo Haabets Farve bar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 0,
      "text": "Og derfor Folkets Glæde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 0,
      "text": "Og Trøst det længe var.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 0,
      "text": "Da mørkned Danmarks Himmel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 0,
      "text": "Og Kampens Torden lød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 0,
      "text": "Og Fjenders tætte Vrimmel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 0,
      "text": "Sig over Sletten gød;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 0,
      "text": "Men Folket, uforskrækket,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 0,
      "text": "Stod fast om Kongens Stol,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 0,
      "text": "Og gjennem Uvejrsdækket",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 0,
      "text": "Brød frem vor Junisol.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 0,
      "text": "En anden Fredrik talte:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 0,
      "text": "\"Mit Folk skal være frit!\" -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 0,
      "text": "Da højt sig Træet hvalte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 0,
      "text": "Da bredte det sig vidt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 0,
      "text": "Da blev dets Blade tætte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 0,
      "text": "Da skød det Grene ny,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 0,
      "text": "Saa hele Danmarks Slette",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 0,
      "text": "Det Skygge gav og Ly.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 0,
      "text": "Hil staa det i sin Sommer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 0,
      "text": "Vort danske Frihedstræ;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 0,
      "text": "Thi Livets fagre Blommer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 0,
      "text": "Skal trives i dets Læ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 0,
      "text": "Og Himlens Fugle sjunge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 0,
      "text": "Skal under Løvets Hang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 0,
      "text": "Og Folkets Røster runge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 0,
      "text": "Med gammel nordisk Klang!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 0,
      "text": "Hil Ham, som villig valgte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 0,
      "text": "At styre frie Mænd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 0,
      "text": "Som holdt det Ord, han talte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 0,
      "text": "Og Intet tog igjen!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 0,
      "text": "Hil hver en ædel Stemme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 0,
      "text": "Som var hans Villies Tolk!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 0,
      "text": "Hil Friheden herhjemme!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 0,
      "text": "Hil Kongen og hans Folk!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 0,
      "text": "Velkommen, Folkets Foraarsdag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 0,
      "text": "Med Frihedssolen oppe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 0,
      "text": "Og Millioner grønne Flag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 0,
      "text": "I Bøgeskovens Toppe!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 0,
      "text": "Du er en Grændse, der blev sat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 0,
      "text": "Imellem Trældoms Vinternat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 0,
      "text": "Og Manddoms Sommerdage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 0,
      "text": "Vor Frihed er endnu en Vaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 0,
      "text": "Der lover mer end yder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 0,
      "text": "Hvori en Fremtidssæd vi saa'r,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 0,
      "text": "Men ej dens Frugter nyder;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 0,
      "text": "Og Mangen tabte Haab og Mod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 0,
      "text": "Og sine Arme synke lod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 0,
      "text": "Fordi han fandt kun Møje.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 0,
      "text": "Og Solen varmer end ej ret,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 0,
      "text": "Og Nattefrosten lurer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 0,
      "text": "Paa Spirerne, der pippe spædt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 0,
      "text": "Af Markens nye Furer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 0,
      "text": "Mens en ufrugtbar Hvirvelvind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 0,
      "text": "Koldt over Landet blæser ind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 0,
      "text": "Fra Sønden og fra Østen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 0,
      "text": "Men vi har Haab, og vi har Tro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 0,
      "text": "Og vil ej trætte blive;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 0,
      "text": "Thi paa os selv det vil bero,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 0,
      "text": "Om Sæden Frugt skal give.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 0,
      "text": "Mod Trusel kjækt vi sætte Trods,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 0,
      "text": "Og Danmarks Konge staar med os,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 0,
      "text": "Og Gud vil skænke Lykke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 0,
      "text": "Velkommen derfor, Foraarsdag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 0,
      "text": "Som endte Vintrens Mørke!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 0,
      "text": "Du bringe skal vor gode Sag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 0,
      "text": "Hvert Aar forøget Styrke!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 0,
      "text": "For Danmarks Land, for Folk og Drot",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 0,
      "text": "Du varsler rigt, Du lover godt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 0,
      "text": "Og vi skal Løftet holde!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
