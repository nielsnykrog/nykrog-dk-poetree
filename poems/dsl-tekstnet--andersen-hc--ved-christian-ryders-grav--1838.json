  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Jeg saae Dig nys, da var Du karsk og glad;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Hos Dig og Dine var saa godt at være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Nu Kredsen er som Avner splittet ad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Brat tog Dig Døden bort fra Dine Kjære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "»Guds Villie skee!« var Bønnen som Du bad;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "»Guds Villie skee!« den Bøn vi og frembære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "I Kisten er kun Jord, et vissent Blad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Det, som vi elsked’, boer hos Lysets Hære!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
