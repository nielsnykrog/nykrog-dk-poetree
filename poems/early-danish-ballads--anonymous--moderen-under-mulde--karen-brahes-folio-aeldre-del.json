{
  "id": null,
  "title": "Moderen under Mulde",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA188.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Her Biørnn hannd rydder seg vnder ø:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "feste hand seg saa wen en møø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": ":: Fore ord frydder saa mangtt et hiartte. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Feste hand staalttenn Søllffuerlad:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "hun waar sørinnd och sieellenn glad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "I otte aar thi samell worre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "otte bønn hun till werddenn baare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "Saa kaam der døddenn paa thett laand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "och tuog bortt Sølffuerlad, denn lilli-wand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "Her Biørnn hand ridder saa widde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "saa feeste hannd iumfru Blydde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "Hand feeste seg iumfru Blidde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "hun bleff denom styffmuoder stridde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "Dy førdde brud i her Biørns gaard:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "hans smaa børnn garr hynndder vd imuod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "Dy klaper hyndder paa skaarlagenn-skiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "\"Y wer well-komen, kieer muodder mynn!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "Hun støtte denom fraa seg med synn fuod:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "\"Mone thette skall werre mynn første muod!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "Her Byørnn gaaff hyndder dy skaarlagenn blaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "for hun skulde elske hans biørnn saa smaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 10,
      "text": "Hand gaff hyndder ett huoffuet-guld:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "for hun skuld were hans smaa bønn huld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 11,
      "text": "Hand gaff hinder thett guld saa rød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "saa sorre sualt hun hans smaa børnn for brød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 12,
      "text": "Hun thuog fraa dennom dy bolster blaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "hun lagde hans børnn y baarenn straa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 13,
      "text": "Saa saarre daa gred hans smaa bøørnn vndder øø:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "thett hørde stolltt Sølffuerlad, hun waar døø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 14,
      "text": "Tthett wor om en løffuerdag att queld:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "alle seelle dy skulde daa huille.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 15,
      "text": "Hun gaar seg till enngeliest:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "hun bad seg loff aff Iesu Chrest.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 16,
      "text": "Dette hun maatte till mieelhiem gaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "och taalle med synn bønn saa smaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 17,
      "text": "\"Iaa saa mend daa matt du saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "wer her icke lennge fraa!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 18,
      "text": "Sttoltt Sølffuerlad riesser seeg aff synn graff:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 18,
      "text": "saa tuog hun kisten paa synn bag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 19,
      "text": "Hun tuog kistenn paa synn bag:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 19,
      "text": "saa gaar hun hiem med møgen vmag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 20,
      "text": "Der hun kaam till borrige-lied:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 20,
      "text": "hyndis eldste datter stuod der-weed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 21,
      "text": "\"Her stander du, eldste datter mynn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 21,
      "text": "huor lidder kier sødskind dynn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 22,
      "text": "\"Du est icke muodder mynn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 22,
      "text": "men du ber saa bleg enn kiend.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 23,
      "text": "Hun gaar sieg vdj deenn stuoffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 23,
      "text": "som hyndis smaa bønn inde luo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 24,
      "text": "Hun saatte seeg paa en stuoll:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 24,
      "text": "thend ene hun børstett, den anden thuoffuett.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 25,
      "text": "Hun saatte thend myndste paa synn skiød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 25,
      "text": "saa saare hun gred, hindis hiarte thett blød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 26,
      "text": "Hun gick tiel seenggenn, och y hun suo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 26,
      "text": "hyndis børnn dy luoo y baarenn straa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 27,
      "text": "\"Sig meg her, ellste datter mynn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 27,
      "text": "huor er her Biørnn, fader dynn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 28,
      "text": "\"Mynn fadder hand suoffuer y hyffueluofftt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 28,
      "text": "saa striden en sty-moder haffuer wy faatt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 29,
      "text": "Saa gaar hun seeg till hyffuen luofftt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 29,
      "text": "som herre Biørnn hand inde suoff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 30,
      "text": "Hun støtte paa dørrenn med kiste synn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 30,
      "text": "\"Staar op, her Biørnn, och ladder meg ind!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 31,
      "text": "\"Slett ingenn haffuer ieg støffne saatt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 31,
      "text": "och ingenn komer y myn lofftt om natt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 32,
      "text": "\"Daa weecker nu op stalltt Blidde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 32,
      "text": "hun er myn smaa børnn stridde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 33,
      "text": "Ieg gaff hynder mytt hoffuett-guld:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 33,
      "text": "for hun skulde werre mynn smaa børnn hwld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 34,
      "text": "Ieg gaff hyndder mytt guld saa rød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 34,
      "text": "saa saare daa suelltter mynn børnn for brød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 35,
      "text": "Ieg førdde till dieg dy bolster blaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 35,
      "text": "for du skulde laade mynn børnn haffue dynenn graa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 36,
      "text": "Nu leeger mynn børnn y baarenn straa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 36,
      "text": "saa vnd en løcke skaall Blydde faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 37,
      "text": "Menn skaall ieg thierr hiem till deg gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 37,
      "text": "saa haard en død skal Bliddelild faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 38,
      "text": "Naar dw hører di hunde bange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 38,
      "text": "daa matte du wintte denn dødde paa gange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 39,
      "text": "Nu gaaller haanen den suortte:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 39,
      "text": "saa snarlig maa ieg buorte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 40,
      "text": "Nu gaaller haanen den rødde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 40,
      "text": "till graffue stundder alle dy dødde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 41,
      "text": "Nu gaaller haanen den huidde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 41,
      "text": "ieg maa nu icke lenger biidde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 42,
      "text": "Hun war icke snarer lagtt y mold:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 42,
      "text": "ind hyndis børn wor lagtt paa bolster blaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 43,
      "text": "Blidde denom børste, och hun denom flette:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 43,
      "text": "och hun denom løfftte, och hun denom leette.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 44,
      "text": "Hun gaff denom wynn, hun gaff denom brød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 44,
      "text": "rett aldrig daa lidder dy bønn mierre nød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 45,
      "text": "Huer gange hun hørde dy hunde giøø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 45,
      "text": "daa lieeger dy bøn meed guld saa rød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 45,
      "text": ":: For ord fryder saa mangett hiartte. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}