{
  "id": null,
  "title": "Den fremmede Jomfru",
  "year_created": 1861,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Carsten Hauch",
    "country": null,
    "wiki": "Q688529"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Valdemar Atterdag",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1861,
    "url": "https://tekstnet.dk/books/hauch-c_valdemar-atterdag/002/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Saa red den ædle Konning ad Markerne hen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Der fulgte ham efter kun en eneste Svend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Men da de kom til Skoven, hvor Veien blev trang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Da hørte Kongen atter den fjerne Bjældeklang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Han kaldte paa Svenden, han let af Sadlen sprang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Han sagde: »Vogt min Ganger og vent mig paa Vang.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Saa gik han ind i Krattet, selv baned han sig Vei,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Han sagde: »Jeg hører Bjælderne, jeg skuffer mig ei.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Saa vandred han alene paa den vildsomme Sti,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Da naaede han en Plads, der for Træer var fri,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Der saae han en Jomfru - han troede knap sit Syn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Sagtelig leged Bladene med Solstraalernes Lyn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Om Brystet var hun fyldig, i Midien var hun smal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Eensom og stille hun sad bag Skovens Hal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Tankefuld drømmende paa den mosgroede Steen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Hun ligned en deilig og smækker Rosengreen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "De rødeste Koraller smykked hendes Haar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Midt i Høstens Blomster hun ligned den unge Vaar;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Fager hun syntes, liig en Paradisets Aand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Der saae han ogsaa Falken, den sad paa hendes Haand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Hun reiste sig med Iil, da den Fremmede hun saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Men Falken blev siddende, den agted ei derpaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Da standsed den Herre, hans Tanker sig forvilded,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "Han troede, han bedaaredes kun af et Tryllebilled.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Dog fatted han sig hurtig, han traadte hende nær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Og sagde: »Det er fagert at see paa Skoven her,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Og Græsset er fagert, og Falken er skjøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "Langt skjønnere den Jomfru, der lokked den i Løn.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "Da neied hun for Kongen, skjøndt hun kjendte ham ei,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Hun svared: »Af sig selv den fra Luften fandt Vei,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "Frivillig ned den daled og satte sig paa min Haand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "Jeg har den ikke lokket, ei holdt den i Baand.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "Da mæled den Herre: »Jeg ret ei fatte kan,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "At Rygtet om Jer Skjønhed blev skjult i dette Land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "At slig en Rose blomstred saa nær ved Øresund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "Og at jeg ei den skued før nu i denne Stund.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "Gjensvared den Jomfru: »Min Broder og jeg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Vi hid nys ere komne paa Bølgernes Vei.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "Min Moder var fra Danmark, hun efterlod os her",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "En Borg, som I kan skimte bag Krat og bag Træer.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "Da sagde Konning Volmer: »Den Falk tilhører mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Dog gjerne jeg den afstaaer, hvis den kan tækkes Dig;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "Mig synes, Eders Øine ligne den klare Sø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "Ei før i Danmarks Rige jeg skued slig en Mø.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "Hun sænked sine Blikke, hun rødmed som Blod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "»Jeg har vel sagt formeget«, tænkte den Herre god,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "»Jeg gjerne længer dvæled, dog bør jeg nu vel gaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "Dog kan jeg de Drømmetanker af Hovedet ei faae.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "Om hendes Navn han spurgte, han gik endnu dog ei,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "Hun sagde: »Tovelille, min Herre, kaldes jeg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "Min Broder hedder Henning, vi kom fra Rygens Strand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "Vi stamme ned fra Konger i det vendiske Land.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 13,
      "text": "Da svared den Herre: »Jeg selv en Konning er,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "Og Alt, hvad I begjerer, jeg gjøre vil for Jer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "Jeg fødtes til Beskytter for undertrykte Mænd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "Og værgeløse Qvinder, vi sees vist igjen.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "Saa hilsed han venlig og svandt bag Busk og Krat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Hun efter ham stirred igjennem Skovens Nat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "Hun sagde ved sig selv: »Der var det i hans Øie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "For hvilket mod min Villie jeg maatte mit Hoved bøie.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 15,
      "text": "Men Falken steg i Luften, den fulgte ham paa Vei,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "Hun tankefuld bortvandred, dog vidste hun ei,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "At nu hun havde fængslet med Elskovens Baand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "Den Herre, der holdt det hele Danmark i Haand.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
