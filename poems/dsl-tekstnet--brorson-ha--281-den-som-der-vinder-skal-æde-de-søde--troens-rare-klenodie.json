{
  "id": null,
  "title": "281. Den, som der vinder, skal æde de søde",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
    "wiki": "Q348003"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Troens Rare Klenodie",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1739,
    "url": "https://tekstnet.dk/books/brorson-ha_troens-rare-klenodie/271/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Den, som der vinder, skal æde de søde",
      "part": false,
      "marginal_notes": [
        "Speaker: JEsus. Aab. 2, 7."
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Frugter, som midt i Guds paradiis groer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Ingen slags død eller jammer skal møde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Den paa mig stedse og hiertelig troer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Qvægende saft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Styrke og kraft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Gives den, seyren i døden har haft.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Hielp mig, o! sødeste JEsu! at vinde,",
      "part": false,
      "marginal_notes": [
        "Speaker: Sielen."
      ]
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Ofte jeg strider med skrøbelig magt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "See, hvor kand synden mig hænderne binde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "At jeg i striden er næsten forsagt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Frelsere bliid!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Føer du min striid!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "At jeg kand vinde i angestens tiid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Den, som der vinder, tør ikke forsage,",
      "part": false,
      "marginal_notes": [
        "Speaker: JEsus. v. 11."
      ]
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Ingen skal nogen tiid skade hans siel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Trods, at den anden død skulde den plage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Som før har fegtet saa mandig og vel!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Hiertet skal lee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Øyet skal see",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Mig, som ham frelste af alle slags vee.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Hielp mig, o! sødeste JEsu! at vinde,",
      "part": false,
      "marginal_notes": [
        "Speaker: Sielen."
      ]
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "Lidet formaaer kun min skrøbelig troe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "Den, som der vinder, jeg giver at æde",
      "part": false,
      "marginal_notes": [
        "Speaker: JEsus. v. 17."
      ]
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "Manna, som udi Guds ark er henlagt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "Saa og forsikring paa himlenes glæde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "Om hand den hvide steen tager i agt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "Hvo, som den faaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "Eene forstaaer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": "Det navn, som alle Guds kæmper attraaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "Hielp mig, o! sødeste JEsu! at vinde,",
      "part": false,
      "marginal_notes": [
        "Speaker: Sielen."
      ]
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "Verden sit kiødelig manna og strøer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "Hvorudi satans forgift er at finde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": "Hvorved saa mangen en siel saa hendøer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 6,
      "text": "JEsu, mig kryst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 6,
      "text": "Saa tit dit bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 6,
      "text": "At du for alting est ene min lyst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": "Den, som der vinder, og striden fuldender,",
      "part": false,
      "marginal_notes": [
        "Speaker: JEsus. v. 26 etc."
      ]
    },
    {
      "id": 38,
      "stanza_id": 7,
      "text": "Holder min gierning og bliver mig troe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 7,
      "text": "Jern hand skal føre, som riset i hænder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 7,
      "text": "Støde de onde, som potter, i toe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 7,
      "text": "Knuse dem smaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 7,
      "text": "Slide og slaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 7,
      "text": "Mens der er noget at hevne sig paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 8,
      "text": "Hielp mig, o! sødeste JEsu! at vinde,",
      "part": false,
      "marginal_notes": [
        "Speaker: Sielen."
      ]
    },
    {
      "id": 45,
      "stanza_id": 8,
      "text": "Giør du min christendom lutter og reen!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 10,
      "text": "Den, som der vinder, skal klædes med hvide",
      "part": false,
      "marginal_notes": [
        "Speaker: JEsus. Cap. 3, 5."
      ]
    },
    {
      "id": 47,
      "stanza_id": 10,
      "text": "Stikkede klæder og finde sit navn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 10,
      "text": "Skrevet i livets bog; hvo tør vel slide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 10,
      "text": "Den af min haand, som mig haver i favn?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 10,
      "text": "Stedse hand skal",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 10,
      "text": "Meer end christal",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 10,
      "text": "Skinne i himlens den deyligste sal.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 11,
      "text": "Hielp mig, o! sødeste JEsu! at vinde,",
      "part": false,
      "marginal_notes": [
        "Speaker: Sielen."
      ]
    },
    {
      "id": 54,
      "stanza_id": 11,
      "text": "See, hvad min kiortel er skiden og fuul,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 11,
      "text": "Lad min forvendte indbildning forsvinde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 11,
      "text": "Thi for dig er der jo intet i skiul;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 11,
      "text": "Toe du mig saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 11,
      "text": "At jeg og maa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 11,
      "text": "For dig i saligheds klæder bestaae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 12,
      "text": "Den, som der vinder, bestandig skal blive",
      "part": false,
      "marginal_notes": [
        "Speaker: JEsus. v. 12."
      ]
    },
    {
      "id": 61,
      "stanza_id": 12,
      "text": "I min Guds tempel en pillere stærk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 12,
      "text": "Der jeg tre deylige navne vil skrive:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 12,
      "text": "Stadens og Guds og mit nye navn vel merk:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 12,
      "text": "Kæmpe, hold ud!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 12,
      "text": "Jeg er din Gud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 12,
      "text": "Du est min borger, min daatter, min bruud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 13,
      "text": "Hielp mig, o! sødeste JEsu! at vinde,",
      "part": false,
      "marginal_notes": [
        "Speaker: Sielen."
      ]
    },
    {
      "id": 68,
      "stanza_id": 13,
      "text": "See, hvor let tabes mit hierte og mod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 15,
      "text": "Den, som der vinder, skal have den ære,",
      "part": false,
      "marginal_notes": [
        "Speaker: JEsus. v. 21."
      ]
    },
    {
      "id": 70,
      "stanza_id": 15,
      "text": "At hand beklæder min herligheds stoel.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 15,
      "text": "Her hand i korset mit billed maa bære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 15,
      "text": "Der skal hand glimre som himlenes soel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 15,
      "text": "Himlenes boe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 15,
      "text": "Fører ham roe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 15,
      "text": "Derfor striid tapper, standhaftig og troe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 16,
      "text": "Hielp mig, o! sødeste JEsu! at vinde,",
      "part": false,
      "marginal_notes": [
        "Speaker: Sielen."
      ]
    },
    {
      "id": 77,
      "stanza_id": 16,
      "text": "Fiendernes mængde staaer mod mig paa luur,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 16,
      "text": "Dievelen, verden og hendes gudinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 16,
      "text": "Kiød og blod, som er min onde natur;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 16,
      "text": "Jag dem nu hen!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 16,
      "text": "Jeg er igien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 16,
      "text": "Christe! din, du og min sødeste ven.",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
