  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Lyriske Digte",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1924,
    "url": "https://tekstnet.dk/books/jacobsen-jp_lyriske-digte/002/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Jeg er gal!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Men jeg kjender mit Vanvid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Dets Ophav og dets Væsen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Jeg er gal, og nu vil jeg synge;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Men jeg ved, jeg er stum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Og at Strengene, jeg slaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Er Jernstængerne for min Celle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "- Jeg synger det frem Altsammen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Og det kommer i Klang og Farve;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Ser kun mine Læber bevæges,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Mine Fingre famle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Saa let, saa begejstrende let",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Gaar min Elskedes Dands",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Som Libellernes Flugt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Over de brunlige Sivtoppe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Og som Løvet, der falder i spejlklare Sø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Faar Vandet til at vugge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "I voksende Kredse og falde igjen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Løvets eget vuggende Fald,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Saa følte hver, der skued min Elskedes Dands,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Sig forunderlig let",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "Og aned ukjendt Harmoni",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "I sin egen Gang. -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "Men ve! hendes Fodtrin høres tungt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 1,
      "text": "Rhytmerne vakle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 1,
      "text": "Lemmerne stivne -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 1,
      "text": "Der faldt Tynge over Alle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 1,
      "text": "Men jeg blev Sten.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 1,
      "text": "O jeg hader Rhytmer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 1,
      "text": "Jeg elsker det, der hviler i Usikkerhed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 1,
      "text": "Mest hader jeg Stormens sikkre Flugt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 1,
      "text": "Mest elsker jeg Taagen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 1,
      "text": "O! ser I det! ser I det!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 1,
      "text": "Mit Paradis kommer:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 1,
      "text": "Over det hvide Sand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 1,
      "text": "Ligger Taagen tæt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 1,
      "text": "Saa mat, saa dødt og glandsløst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 1,
      "text": "Saa afsindigt uforstaaeligt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 1,
      "text": "Skvulper Havet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 1,
      "text": "Som Skyggen af en Lue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 1,
      "text": "Flammer den takkede Klint",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 1,
      "text": "Mørkt, gjennem Taagens Røghvirvler.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 1,
      "text": "For mig lurer det glatte, glatte Sand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 1,
      "text": "Bag mig gabe mine Fodtrin i Sand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 1,
      "text": "Mine svindende Kræfters Grave",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 1,
      "text": "I en lang, lang lige Linie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 2,
      "text": "Du lille Verden, som Taagen begrændser,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 2,
      "text": "Til din Midte naa mine Skridt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 2,
      "text": "Bag mig er smaa Verdner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 2,
      "text": "Fulde af mine Fjed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 2,
      "text": "Men paa hin Fangemurs anden Side",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 2,
      "text": "Ligger en Verden, jeg ej har set og ej har traadt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 2,
      "text": "Og i den gaar nu Døden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 2,
      "text": "Og ved Muren vil han møde mig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 2,
      "text": "Men jeg vil ikke vide det,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 2,
      "text": "Thi mit skuffende Blik",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 2,
      "text": "Flytter den ved hvert Fjed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 2,
      "text": "Og naar Døden naar mig ved Muren",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 2,
      "text": "Og kaster mig til Jorden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 2,
      "text": "Vil jeg tro, mine Fodtrin standse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 2,
      "text": "I en ny Verdens Midte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 2,
      "text": "O hvor mat jeg er, saa salig mat!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 2,
      "text": "Og Havet skvulper,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 2,
      "text": "Klinten vakler,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 2,
      "text": "Og Taagen .. ve! ve! Taagen flygler",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 2,
      "text": "For Stormens faste Vingeslag!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 2,
      "text": "Klinten staar fast,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 2,
      "text": "Havet faar Glands,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 2,
      "text": "Og op op ned, op op ned",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 2,
      "text": "Vugger det i kraftige Vover!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 2,
      "text": "Og Stormen er Guds Tanke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 2,
      "text": "Hans stærke klare Tanke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 2,
      "text": "Og det er mig, den vil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 2,
      "text": "I Styrke og Klarheds",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 2,
      "text": "Dobbelte Rædsel!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 3,
      "text": "Men jeg vil ikke, Døden vil jeg!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 3,
      "text": "Min Sjæl skal skjælve bort",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 3,
      "text": "Som en Hules forvirrede Ekko,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 3,
      "text": "Og han vil, han vil drage den til sig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 3,
      "text": "I et stærkt, fuldt tonende Drøn! ..",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 3,
      "text": "O klinger, mine Strenge, klinger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 4,
      "text": "Rallende og varslende! -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 4,
      "text": "Strenge, Strenge, er I af Jern?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 4,
      "text": "Ja, ja, det er Stænger af Jern,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 4,
      "text": "Stænger for min Celle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 4,
      "text": "Thi jeg er gal!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
