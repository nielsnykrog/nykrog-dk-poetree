  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "I dag for fem og tyve Aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Hvor var vi kry og glade!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Da tyktes ingen Nødd os haard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Og bred nok ingen Gade;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Thi Studiegaardens Politi",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Os havde meddelt Pas til fri",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Kommers og Næringsdrift udi",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Athenes Kongerige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Da var det først, at Nuets Liv",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Af evigt Indhold fyldtes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Mens Fremtids dunkle Perspektiv",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Af Haabets Sol forgyldtes;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Da var det først, at Tanken slog",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Sin Vinge op og Højden tog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Mens Hjertet ud paa Vandring drog",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Iblandt de skjønne Kvinder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Da lod Studenteraanden op",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Os sin fidele Verden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Hvor trygt vi fra Ideens Top",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "Saa' ned paa Smaafolks Færden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "Mens Piben damped, Glasset klang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "Og Koret sig mod Himlen svang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "Da voxede den stærke Trang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "Som, Brødre! bandt os sammen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "Men femogtyve Aar forgik",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "Med mangefold Forandring:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "En glemte sagtens Sæd og Skik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "Og En har endt sin Vandring;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "En bor i Øst og En i Vest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "En blev til Degn og En til Præst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "Og her er kun en lille Rest",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "Af To og Tyves Russer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 0,
      "text": "Og dog kan Afstand eller Tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 0,
      "text": "Ei Aandens Magt besejre;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 0,
      "text": "Thi den det var, som drev os hid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 0,
      "text": "Dens Fest det er, vi fejre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 0,
      "text": "Og skjønt vel Hver har Plage nok,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 0,
      "text": "Trods bleget Kind og graanet Lok,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 0,
      "text": "Vi dog i gjenforenet Flok",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 0,
      "text": "Er unge, kry og glade!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 0,
      "text": "Studenten ejer lidt af Gods og Guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 0,
      "text": "Og borget har han tidt sin bedste Frakke;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 0,
      "text": "Men staar end Status stadigt under Nul,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 0,
      "text": "Saa løfter han dog lige stolt sin Nakke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 0,
      "text": "Saa klæder sig hans Sjæl i Haabets Pragt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 0,
      "text": "Saa henter han sig Guld fra Tankens Schakt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 0,
      "text": "En herlig Stand! I gode Borgermænd!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 0,
      "text": "Og vel for Jer, om højt I agted den.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 0,
      "text": "Blandt Kvinder staar han ofte stiv og stum",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 0,
      "text": "Og højst forlegen sine Handsker piller,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 0,
      "text": "Mens den, der indenfor er hul og dum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 0,
      "text": "Ved Skinnets Magt den Int'ressante spiller;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 0,
      "text": "Men i hans Hjerte staar en dejlig Drøm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 0,
      "text": "Og i hans Bryst gaar Livets Tonestrøm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 0,
      "text": "En herlig Stand, Du skjønne unge Mø!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 0,
      "text": "At dele Livet med paa Danmarks Ø!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 0,
      "text": "Vel slumrer tidt hans Villie, tam og tvær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 0,
      "text": "For Andres Gjerning glemmer han sin egen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 0,
      "text": "Men det var ham, der engang Gustafs Hær",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 0,
      "text": "Fra Fredriks Volde viste Vintervejen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 0,
      "text": "Og det var ham, der greb den nye Aand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 0,
      "text": "Og knytted Broderfolk ved Broderbaand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 0,
      "text": "En herlig Stand! I Mænd ved Statens Ror!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 0,
      "text": "En Fremtid Norden har, og den er vor.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 0,
      "text": "Vel maa vi bære manget Livets Tryk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 0,
      "text": "Og bredfuld er dets Lyst ej os iskænket,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 0,
      "text": "Men vi mod Nøden stemme Ryg mod Ryg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 0,
      "text": "Og Glæden kommer, hvor vort Lag er bænket.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 0,
      "text": "Naar Bollen flammer paa vort simple Bord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 0,
      "text": "Saa synger Hver, som Stemme har, i Kor:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 0,
      "text": "En herlig Stand! Du glade Broderflok!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 0,
      "text": "Naar vi kun er os selv, saa er vi nok.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 0,
      "text": "Studenten selv er glad, naar blot",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 0,
      "text": "En Vraa ham giver Skygge;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 0,
      "text": "Men Videnskabs og Kunstens Slot,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 0,
      "text": "Det er han med at bygge;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 0,
      "text": "Og det vi sætte Taarne paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 0,
      "text": "Som op mod Himlen peger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 0,
      "text": "Vort Slot har alt to:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 0,
      "text": "Ørsted og Oehlenschläger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 0,
      "text": "Studenten sværmsr flygtig om;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 0,
      "text": "Men Fædrelandets Stemme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 0,
      "text": "Han hørte, hver Gang Faren kom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 0,
      "text": "Da blev han aldrig hjemme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 0,
      "text": "Paa Slesvigs Jord staa Grave nok,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 0,
      "text": "Som Eoraarssolen grønner;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 0,
      "text": "Der hviler en Flok",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 0,
      "text": "Af danske Musasønner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 0,
      "text": "Studenten ærer højt sin Stand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 0,
      "text": "Som Brodersind forener;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 0,
      "text": "Men han foragter ingen Mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 0,
      "text": "Som ret og godt det mener.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 0,
      "text": "Enhver, som har Respekt for Aand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 0,
      "text": "Og elsker Gamle Moder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 0,
      "text": "Ham række vi Haand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 0,
      "text": "Ham kalde vi vor Broder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 0,
      "text": "Vort Liv er en Flugt mellem Himmel og Jord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 0,
      "text": "Vor Hu er en Fugl, som stiger og daler:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 0,
      "text": "Snart lytter vort Øre til Sfærernes Kor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 0,
      "text": "Snart svælger vort Øje blandt Idealer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 0,
      "text": "Snart hæves vort Bryst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 0,
      "text": "Af Jorderigs Lyst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 0,
      "text": "Af Kjærligheds bævende Luer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 0,
      "text": "Snart bænkes vort Lag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 0,
      "text": "I mægtige Tag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 0,
      "text": "Vi kryste de svulmende Druer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 0,
      "text": "Dog, medens vi fare saa op og saa ned",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 0,
      "text": "Og prøve vor Ungdoms smidige Kræfter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 0,
      "text": "Et Hjem, bag hvis Væg der er Hvile og Fred,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 0,
      "text": "Vi savne, og tidt vi længes derefter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 0,
      "text": "Vor Celle er stum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 0,
      "text": "Dens ensomme Rum",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 0,
      "text": "Befolkes af Mismodets Skygger;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 0,
      "text": "Den giver ej Klang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 0,
      "text": "Naar Hjertet i Sang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 0,
      "text": "Sit Haab og sin Higen udtrykker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 0,
      "text": "Et virkeligt Hjem kan Studenten ej naa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 0,
      "text": "Det skænker ham først en elsket Veninde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 0,
      "text": "Et Telt paa vor flygtige Vej vi opslaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 0,
      "text": "Hvor Trøst for vort Savn og Ly vi kan finde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 0,
      "text": "En Arne, hvis Skin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 0,
      "text": "Opklarer vort Sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 0,
      "text": "Hvor Lunet sig legende svinger;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 0,
      "text": "En tonende Sal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 0,
      "text": "Hvor Glædens Pokal",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 0,
      "text": "Harmonisk mod Brødrenes klinger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 0,
      "text": "Snart reiscr af ny sig Studenternes Hjem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 0,
      "text": "Lavt vorder dets Tag og Væggene trange:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 0,
      "text": "Men Aanden og Livet skal der voxe frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 0,
      "text": "Og der skal vor Stræben Vielsen fange;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 0,
      "text": "Og Musernes Kor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 0,
      "text": "Hos Ydun og Thor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 0,
      "text": "Skal søsterlig der tage Sæde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 0,
      "text": "Og Nisse og Alf",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 0,
      "text": "Med Faunerne halv",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 0,
      "text": "Skal dele Symposiets Glæde.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
