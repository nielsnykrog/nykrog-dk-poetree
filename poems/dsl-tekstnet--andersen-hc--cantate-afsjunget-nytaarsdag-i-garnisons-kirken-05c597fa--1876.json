{
  "id": null,
  "title": "Cantate afsjunget Nytaarsdag i Garnisons-Kirken",
  "year_created": 1876,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1876,
    "url": "https://tekstnet.dk/books/andersen-hc_cantate-afsjunget-nytaarsdag-i-garnisons-kirken/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Herren vi prise! et Aar er atter henrundet;",
      "part": false,
      "marginal_notes": [
        "Speaker: CHOR"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Meget, som blunded’, er vakt og Klarhed har vundet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Glæde og Sorg gjæstede Hytte og Borg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Haabet blev fastere grundet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Tak være Herren! Tak for hver Taare vi græde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Tak for Sorgen! I denne boer Spiren til Glæde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Tak for hver Nød! Herre! Tak for det daglige Brød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Himlen vi skulle betræde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Blev jeg i Hjertets Dyb prøvet, var jeg bedrøvet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Aldrig jeg stod dog forladt, ganske Trøsten berøvet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Aaret, som svandt, Vishedens Krandse mig bandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "I Tro min Tillid blev øvet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Lær mig, o evige Gud, af Aaret, som ender,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Mere og mere mig selv og din Godhed jeg kjender,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Gid som et Straa Synden i Spiren forgaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Før Vinterdøden Du sender.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Ordet, som Jesus os gav, staaer fast i min Tanke:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Det er i Jordlivets Storm den frelsende Planke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Frem vil jeg see! Gud vil, det Bedste skal skee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Roligt mit Hjerte tør banke!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Ei vil jeg frygte, om Doms-Basunerne lyde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Afgrunden brister, Stjernerne Banerne bryde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Tryg i Din Favn, høit jeg lovsynger Dit Navn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Gud! evig skal jeg mig fryde!",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
