  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "VAg op wag op i Gudz naffn",
      "part": false,
      "marginal_notes": [
        "Esaie lx Osee ii ii Co vi"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "du verdige Christenhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "oc tacke din kæriste brudgom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "for denne naadelige tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "i huilken han dig sit ord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "haffuer nu vdsent igen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Der met han vil oss frelse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "saa mange som det ret elske/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "det lyder i alle land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Men dieffuelen verdens første/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "som løgens fader er/",
      "part": false,
      "marginal_notes": [
        "Joan xiiii Acto iiii"
      ]
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "han vilde det gerne omstørte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "met suig han forbiuder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "ath ingen skulde Gudz ord sige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "vid band oc godz och liff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "han lader mange fordriffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "forbrende och affliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "det hielper hannem dog inted",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Han skær fast met sine tender/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Satan oc hans parti/",
      "part": false,
      "marginal_notes": [
        "Acto vii"
      ]
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "met trw vil han forferde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "dig verdige Christenhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Dog bliff du fast vid Gudz ord/",
      "part": false,
      "marginal_notes": [
        "Mat vi"
      ]
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "thi han sørger for dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "han siger huo dig nogen wret gør/",
      "part": false,
      "marginal_notes": [
        "Zacha ii"
      ]
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "hans øgensten han der met rører/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "han er din hielp visselig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "See huorledis Gud hialp Jøderne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "aff Egypti land/",
      "part": false,
      "marginal_notes": [
        "Ex xiiii"
      ]
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "oc i røde haff forsencte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "den Konning Pharao/",
      "part": false,
      "marginal_notes": [
        "Josu vi"
      ]
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Hierico det motte oc falle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "for Gudz folk strax paa stan/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "aff de thrommeters skalle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "alt saa hielper Gud dem alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "som setter deris tro till hannem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "Och de Madianiter",
      "part": false,
      "marginal_notes": [
        "Judi vi oc vii"
      ]
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "giorde Gudz folk platz oc møde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "oc de Amalechiter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "Gudz folk robte da til Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "han dem naadelig reddede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "formedelst Sedeon/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "den tid Gudz folk trommetede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "en Hedning den anden myrde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "tiwe hundred tusinde mend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "Tenck huor thit Gud beskermede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "fra Sauls hand Konning Dauid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "den hagde myrd saa gerne/",
      "part": false,
      "marginal_notes": [
        "i Regum xviii oc xix"
      ]
    },
    {
      "id": 48,
      "stanza_id": 5,
      "text": "Gud beuarede hannem oc met flit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 5,
      "text": "for hans egen Søn den skøne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 5,
      "text": "som kallis Absolon/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 5,
      "text": "han vilde hans liff bort tage/",
      "part": false,
      "marginal_notes": [
        "ii Regum xvi"
      ]
    },
    {
      "id": 52,
      "stanza_id": 5,
      "text": "Dauid motte da rigit rømme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 5,
      "text": "men dog der ind igen komme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "Merck huorledis Gud halp ath stride/",
      "part": false,
      "marginal_notes": [
        "ii Par xiii iii Re xv"
      ]
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "alt mod Hieroboam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 6,
      "text": "J Konning Abia tide/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 6,
      "text": "den han omkring sat hagde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 6,
      "text": "Ath han kunde icke vnd komme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 6,
      "text": "da robte folkit til Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 6,
      "text": "saa flyde the fiende met skamme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 6,
      "text": "oc Gudz folk slo aff thennem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 6,
      "text": "fem hundrit tusende døde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "Desligist halp Gud ath kempe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 7,
      "text": "Assa den Konning bold /",
      "part": false,
      "marginal_notes": [
        "ii Pa xiii"
      ]
    },
    {
      "id": 65,
      "stanza_id": 7,
      "text": "da Serach wilde forderffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 7,
      "text": "Gudz folk met mact oc wold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 7,
      "text": "de monne da Gud paakalle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 7,
      "text": "aff gantske hiertens grund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 7,
      "text": "thi motte de blaamend falde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 7,
      "text": "tusinde gange tusind talde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 7,
      "text": "for Gudz folk samme stund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 8,
      "text": "See huorledis Gud reddede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 8,
      "text": "den Konning Ezechiam/",
      "part": false,
      "marginal_notes": [
        "iiii Reg xix ii Para xxxii"
      ]
    },
    {
      "id": 74,
      "stanza_id": 8,
      "text": "den storlig trued hagde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 8,
      "text": "Sennacherib wid naffn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 8,
      "text": "den sin her hagde stellid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 8,
      "text": "alt mod Hierusalem/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 8,
      "text": "aff dem Gudz Engel felde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 8,
      "text": "firesindz tiwe tusind oc flere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 8,
      "text": "oc saa giorde han dem thamme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 9,
      "text": "Hør oc huor Gud lod krige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 9,
      "text": "for Konning Josaphat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 9,
      "text": "den tid hannem vilde fordriffue",
      "part": false,
      "marginal_notes": [
        "ii Pa xx"
      ]
    },
    {
      "id": 84,
      "stanza_id": 9,
      "text": "Amon oc Moab met mact",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 9,
      "text": "gudz folk hagde sorg oc klage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 9,
      "text": "til Gud hagde det sin trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 9,
      "text": "De Hedninge lod Gud plage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 9,
      "text": "de toge hind anden aff dage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 9,
      "text": "oc Gudz folk bleff forløst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 10,
      "text": "O Christenhed merck lige/",
      "part": false,
      "marginal_notes": [
        "Esaie l Es xxxi Math x"
      ]
    },
    {
      "id": 91,
      "stanza_id": 10,
      "text": "huor Gud sine fiende slar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 10,
      "text": "de mod hans folk monne stride/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 10,
      "text": "hans mact er nu lige stor/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 10,
      "text": "Han kan dig vell beskerme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 10,
      "text": "dine haar ere alle talde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 10,
      "text": "lad du men dieffuelen suerme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 10,
      "text": "bliff du vid Gudz ord gerne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 10,
      "text": "altid saa est du vduald",
      "part": false,
      "marginal_notes": []
    }
  ]
}