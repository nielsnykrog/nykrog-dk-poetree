{
  "id": null,
  "title": "O Gud, hvem skal jeg klage min bange",
  "year_created": [
    1579,
    1583
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
