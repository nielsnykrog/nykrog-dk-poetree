    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/thomissoen_1569/17/10"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Fortørnis icke naar du end seer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "de onde at være mange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "naar du end seer Misdedere fleer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "vær icke hadske oc bange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Endog de blinde gaa i stor synd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "met slem ondskab/ vden all straff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "stor fremgang der til haffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "oc Rigdoms herlige gaffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "De skulle vden all tuil fuld snart",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Som gress oc vrter grøne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Affhuggis/ oc visne met en fart",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Met alle deris blomster skøne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Forgengeligt oc forfengeligt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Er alt det gode som de paa trode/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Saa snart endis deris velde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Synden skulle de vndgielde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Til Herren set dit haab oc tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Forsømme ey gaat at giøre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Vdi dit land du bliff oc bo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Lad troens trøst dig røre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Du skalt dig nære met Gud oc ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Haff all din lyst til Gud/ som vist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Din Hiertens bøn vil høre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Oc din sag vel vdføre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Befal Herren dine veye oc Sag/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Dit haab du til hannem sette:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Saa skal hand føret saa vel i lag/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Som hand i sit ord iette.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Hand skal lade skee/ at huer kand see",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Din retuiss sag/ lige som middag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Skinne/ oc som Liusit klare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Saa kant du dig forsuare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Naar Gud dig nogit Kaarss paafør/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "Taalmodig vær du oc stille:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "Oc vær til freds som hand det giør",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "Effter sin hellige villie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "Holt op aff vrede oc bitterhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "De ondis lycke ey til mistyck",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "Tag/ at du oc giør ilde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "Guds gunst monne du saa spilde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "Opryckis slet skulle alle de",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "Som synd oc Ondskab bedriffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 5,
      "text": "Men de som effter Herren see",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 5,
      "text": "Skulle vist i Landit bliffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 5,
      "text": "De Ondis fald snart komme skal/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "De gode bestaa/ oc nocksom faa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "Aff Guds gode laan oc gaffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "Oc fredsens lyst de haffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "De onde sig bruge met spot oc spee",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 6,
      "text": "Oc trusel imod de Fromme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 6,
      "text": "Met Suerd oc Bue de lade sig see/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 6,
      "text": "Guds Folck ville de omkomme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 6,
      "text": "Gud der at leer/ thi hand vel seer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "Den straff saa haard/ dem snart offuergaar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "Buen skal dem brydis i hænde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "Suerdit i deris hierte vende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 7,
      "text": "Det lille som den Retuise monne faa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 7,
      "text": "Aff Guds milde haand oc naade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 7,
      "text": "Er bedre/ end alt det være maa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 7,
      "text": "Som den Wgudelig kand baade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 7,
      "text": "End Huse fulde met gods oc Guld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 7,
      "text": "Thi Gud monne selff velsigne vel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 7,
      "text": "Alt huad hand sine Børn giffuer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "Saa det dem gaffnligt bliffuer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 8,
      "text": "De ondis arm sønderbryder Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 8,
      "text": "Deris synd det dem monne volde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 8,
      "text": "Oc styrcker de Fromme/ som hans Bud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 8,
      "text": "Aff hiertit gierne holde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 8,
      "text": "Deris nødtørfftighed oc dage hand veed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 8,
      "text": "Naar hand dem vil sin trøst sende til/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 8,
      "text": "Den arff som hand dem giffuer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 8,
      "text": "Euindelig vist bliffuer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 9,
      "text": "De beskemmis ey i Siugdoms tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 9,
      "text": "Ey helder i Feyde oc trette/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 9,
      "text": "J dyre tid er Gud dem saa blid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 9,
      "text": "At hand dem selffuer metter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 9,
      "text": "De Ondis lyst forgange skal vist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 9,
      "text": "De skulle vel kort/ som Røg suinde bort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 9,
      "text": "Oc en snar ende tage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 9,
      "text": "Paa alle deris gode dage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 10,
      "text": "Den onde borger aff en falsk grund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 10,
      "text": "At betale hand ey tencker/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 10,
      "text": "Den fromme er barmhiertig oc rund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 10,
      "text": "Hand laaner gierne oc skencker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 10,
      "text": "De fromme aff Gud velsignelse god",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 10,
      "text": "De onde vist faa forbandelse haard/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 10,
      "text": "De gode skulle Landit arffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 10,
      "text": "De onde vil Gud fordærffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 11,
      "text": "Den godis leffnit vey oc stij",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 11,
      "text": "Styrer Gud met sin naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 11,
      "text": "At hand til gaffns kand vandre fri/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 11,
      "text": "Oc frelsis fra all vaade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 11,
      "text": "Om hand met hast/ i syndsens last",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 11,
      "text": "Falder/ eller oc i Kaarsens Aag/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 11,
      "text": "Hand skal dog icke forsmecte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 11,
      "text": "Sin haand vil Gud hannem recke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 12,
      "text": "Fra barndom indtil Alder min",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 12,
      "text": "Jeg icke forfare kunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 12,
      "text": "Den Retfærdig aff Skaber sin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 12,
      "text": "Forlat være nogenlunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 12,
      "text": "Eller at hans Sæd/ paa nogen stæd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 12,
      "text": "Aff hungers nød/ gick effter sit brød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 12,
      "text": "Gud vil sine Børn vel føde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 12,
      "text": "De bliffue aff hunger ey døde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 13,
      "text": "Den retuise mildelig hielper i nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 13,
      "text": "Hans børn velsignelse fange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 13,
      "text": "Giør du oc gaat/ som Gud dig bød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 13,
      "text": "Fra det onde skalt du gange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 13,
      "text": "Saa skal Gud dig/ ret visselig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 13,
      "text": "Til liff oc Siel forsørge vel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 13,
      "text": "Der til dine Børn husuale/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 13,
      "text": "Som sig ville hannem befale.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 14,
      "text": "Thi Herren elsker ret oc skel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 14,
      "text": "Sine helgen hand ey forlader/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 14,
      "text": "Men altid dem beuarer vel.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 14,
      "text": "De Ondis Sæd hand skader/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 14,
      "text": "Saa at den skal opryckis all.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 14,
      "text": "De Retuise Landet arffue met ret/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 14,
      "text": "Til euig tid der bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 14,
      "text": "Met lyst oc fryd der leffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 15,
      "text": "Den frommis mund til visshed er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 15,
      "text": "Hans tunge om Rætten taler/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 15,
      "text": "Guds ord hand i sit hierte bær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 15,
      "text": "Som Gud oss det befaler.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 15,
      "text": "Menniskens tant hand der iblant",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 15,
      "text": "Ey haffue vil/ men seer vel til",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 15,
      "text": "At hand ey skal til side",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 15,
      "text": "Met sin bekiendelse glide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 16,
      "text": "Den Onde paa den Fromme seer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 16,
      "text": "Oc vilde hans blod vdøse:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 16,
      "text": "Men Herren hannem sin naade beteer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 16,
      "text": "Oc fra hans hænder forløser.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 16,
      "text": "Bliffuer hand skønt wrettelig dømt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 16,
      "text": "For ketters ord/ eller oprør stor/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 16,
      "text": "Gud hannem dog retuiss kiender/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 16,
      "text": "Oc salighed hannem tiluender.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 17,
      "text": "Bie Herren/ hans vey holt offuer alt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 17,
      "text": "Hand dig da vist ophøyer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 17,
      "text": "At du bestandig bliffue skalt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 17,
      "text": "Megit gaat hand dig tilføyer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 17,
      "text": "Du skalt oc lee/ naar du monne see",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 17,
      "text": "Den wferd suar/ de Onde faar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 17,
      "text": "Den de nu ey kunde tencke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 17,
      "text": "Som Guds vrede vil dem skencke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 18,
      "text": "Jeg saa en stolt wgudelig mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 18,
      "text": "Veldig met gaffuer skøne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 18,
      "text": "Mectig oc vel vdbred vaar hand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 18,
      "text": "Som Lauerber træ hin grøne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 18,
      "text": "Jeg saa mig om der ieg did kom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 18,
      "text": "Huor monne hand være/ der stod nu here?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 18,
      "text": "Jngen mig det sige kunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 18,
      "text": "Jngen stæd da bleff hand funden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 19,
      "text": "Fryct Gud/ oc giør retfærdighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 19,
      "text": "Saa skalt du faa at finde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 19,
      "text": "At dig her giffuis en euig fred/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 19,
      "text": "Du skalt det nu besinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 19,
      "text": "De Ondis ende skal være dig kient/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 19,
      "text": "Til Helffuedis glød oc euig død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 19,
      "text": "Skulle de allesammen komme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 19,
      "text": "De her foracte Guds domme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 20,
      "text": "Gud er de Frommis frelser god",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 20,
      "text": "Oc styrcke i nødsens tide/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 20,
      "text": "Hand skal dem hielpe oc giffue mod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 20,
      "text": "J all modgang oc quide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 20,
      "text": "Fuldkommelig oc euindelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 20,
      "text": "Dem frier hand vist/ fra de Ondis list/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 20,
      "text": "Thi de paa hannem sig trøste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 20,
      "text": "Hand er den dem forløste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 21,
      "text": "Loff ære oc tack i alle Land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 21,
      "text": "Ske dig Gud Fader kiere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 21,
      "text": "Met din Søn oc den hellig Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 21,
      "text": "Det wi aff hiertit begære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 21,
      "text": "At du saa vel/ til liff oc Siel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 21,
      "text": "Oss haffuer forløst/ oc giffuer trøst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 21,
      "text": "Lad intet oss her fordærffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 21,
      "text": "Lad oss vist Himmerig arffue.",
      "part": false,
      "marginal_notes": []
    }
  ]
}