  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "HErre frelss mig fra onde Menniske",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc beuare mig fra alle wmilde mend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Som betencke ont i deris hierte mod mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "oc berede dem daglige til strid oc trette.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "De huesse deris Tunger som hugormene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "der er forgifft oc eder i deris Tunger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Herre beuare mig fra de ondis hender/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "oc frelss mig fra alle wretuise Mend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "Som acte at kaste mine føder om kuld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "de hoffmodig lagde deris snarer for mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 5,
      "text": "De vdsette deris Garn oc Reb for mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "at ieg skulle falle ned paa veyen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 6,
      "text": "Men ieg sagde til Herren du est min Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "Herre hør min ydmyge Bøn oc røst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 7,
      "text": "Herre som est min salighedz krafft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "du skiulte oc halp mit hoffuit i Striden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 8,
      "text": "Herre lad onde Menniske icke fuldkomme deris onde vilge mod mig som de acte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 9,
      "text": "De motte ellers hofferde dem for meget/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 9,
      "text": "lad dem icke fonge mact oc offuer haand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 10,
      "text": "Lad deris Læbers ondskaff oc fortalelse betecke deris hoffuit tringt omkring.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 11,
      "text": "Lad dem falde i Jlden paa gloende Kul/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 11,
      "text": "at de icke staa op igen aff den wselhed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 12,
      "text": "En Baguaskere faar icke lycke paa Jorden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 12,
      "text": "En ond Mand skal gribis aff Døden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 13,
      "text": "⁕ Jeg ved at Gud skal fly de fattige dom oc ræt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 13,
      "text": "oc heffne de armis wskel oc wræt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 14,
      "text": "⁕ Herre de Retuise skulle alle loffue dit naffn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 14,
      "text": "oc bliffue for dit ansicte euindelige.",
      "part": false,
      "marginal_notes": []
    }
  ]
}