  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "VErdens velde/ met sit Belde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "haffuer ieg forsmaat met alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "For den elsku/ J huilcken ieg maa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "met min Herre Christ ind falle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Huilcken det første ieg fick at see/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Fick ieg hannem kær met alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Betrode hannem vel/ i glæde oc ve/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Jeg elske hannem vden all Galde",
      "part": false,
      "marginal_notes": []
    }
  ]
}