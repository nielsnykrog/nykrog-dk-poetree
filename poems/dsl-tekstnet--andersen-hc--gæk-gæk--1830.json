{
  "id": null,
  "title": "»Gæk! Gæk!«",
  "year_created": 1830,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1830,
    "url": "https://tekstnet.dk/books/andersen-hc_gaek-gaek/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Smukt ligger Gaasestien hist i den frie Natur;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Rundtom staae Skræppeblade og Nelder ved dens Muur;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Heelt skrøbeligt er Huset, det ligger halv paa Knæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Mens Mikkel Ræv er ophængt høit i det grønne Træ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "See! Pigen aabner Døren, hun har den halv paa Klem;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "De hvide Gjæs nu skride fra Gaasestien frem;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Man tager dem ved Vingen, man binder deres Been:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "»Gæk! Gæk!« i Chor de synge nu Alle, Hver og Een.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Fælt Kokken staaer og brummer, ret som en oprørt Søe:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "»Nu er det Mortens Aften, thi maae de Alle døe!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "O! hvilken deilig Tanke! den tolkes ei med Ord, –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "At stegt’ og fyldt’ med Svedsker de sættes skal paa Bord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "»Gæk! Gæk!« som Chor istemme de hvide, blege Møer:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Een Stemme høres mindre, for hver en Gaas, som døer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Det dæmpes meer og mere, – hør end den Sidstes Qvæk!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Med Eet det bliver stille – nu er’ de Alle væk.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
