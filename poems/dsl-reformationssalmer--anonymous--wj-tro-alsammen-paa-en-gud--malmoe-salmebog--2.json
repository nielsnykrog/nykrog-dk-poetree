  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "WJ tro alsammen paa en Gud",
      "part": false,
      "marginal_notes": [
        "Gene i"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hiemmels oc iordens skaber",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Gudz søn sin fader wilge giorde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "paa det wi hans børn skulle bliffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Han vil oss forse vor næring/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "lyff oc siæl i hans beuaring/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Altid han oss vil beuare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "inted ont skal oss wederfare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "han sørger for oss dag oc nat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "for han haffuer alting i sin mact",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Vi tro oc alle paa Jesum Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "som er Gudz søn och wor Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Som aff den Helligand vndfangen vor/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "aff guddommelig krafft oc ære/",
      "part": false,
      "marginal_notes": [
        "Luce i"
      ]
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "aff Maria den rene Jomffrue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "ith sandeligt menniske er worden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Pint vnder Pontio Pilato",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "korssfest/ død/ oc iordet/ til heffuedis for",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "paa tredie dag høg aff døde opstod til hiemmels for/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "vor dommer er han vorden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Vi tro oc paa den Helligand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "lig met fader oc met søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "som alle bedrøffuedis hugsualer er/",
      "part": false,
      "marginal_notes": [
        "Johan xv"
      ]
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "met dyrebare gaffuer och naader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "skøne All gantske Christenhed paa iorden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Jth samffund giort/ met sine ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "met hannem wore synder tillgiffne word/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "wi menniske skulle alle opstande/ effter dette ælende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Jth nyt liff er oss bered/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "i ewighed til euig tid",
      "part": false,
      "marginal_notes": []
    }
  ]
}