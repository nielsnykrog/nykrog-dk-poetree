  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "FOrlad nw thÿn swend o Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "effter thit ord ÿ freden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Forthi mÿne øgne haffue seet thÿn gienløselse/",
      "part": false,
      "marginal_notes": [
        "Luce. ij."
      ]
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "then som tw beridde for alle menniskens ansigt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "Eet liwss til hedningernes opliwselse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "oc til thit folkis ære Jsrael.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Aere wære Gud fader oc Gud søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "oc saa Gud then helliaand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "Som wærid haffuer aff begyndelsen nw oc altÿd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "fraa ewighed oc til ewighed AMEN.",
      "part": false,
      "marginal_notes": []
    }
  ]
}