  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "LAder oss nu alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Vor kiere Fader tacke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "For sine velgierninger oc nyttige gaffuer:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "At hand aff sin Naade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Saa rigelig vil made/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Baade Diur oc Menniske dem alle til gode.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Wi siunge hannem baade loff oc priss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Som jorden allene slaar met sin munds riss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Hand sider i Himmelen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Sit Ord vdsender paa Jorden:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Huo det vil høre oc gemme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Dem vil Gud sin Aand visselig sende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Thi vnd oss Fader euige Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "At wi din villie ret giøre kunde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Dig ske euig ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "O Gud wi tacke oc loffue dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "ved din Søn Christ vor Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "For alle dine gaffuer oc godhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "som du beuiser oss here/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "met megit gaat som du formeer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "oc altid oss saa vel forseer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "Thi bør dig priss oc ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Som du nu haffuer vederqueget vel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Vort Legeme met dit gode/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Saa bede wi at du Aandelige føder vor Siel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Met dit hellig Ord oc naade:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Der ved hun leffuer euindelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Oc bliffuer hoss dig til euig tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Oc glædis foruden all ende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Ære være dig Fader i allen tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Met din Søn Christ vor Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Ved huilcken du haffuer oss alle frid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "Dine euige Børn at være:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "Thi prise wi din barmhiertighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "Met den hellig Aand i euighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "Nu oc euindelig/ Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "O Gud din godhed tacke wi/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "Formedelst Christum vor Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "For din velgierning rund oc blid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "Met huilcken du beuarer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "Alt det der liff oe leffnit haffuer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "Aff dig sin føde oc nødtørfft faar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "Dig ske loff priss oc ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 5,
      "text": "Lige som du haffuer nu bespiset",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 5,
      "text": "Vort liff met legemlig føde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "Saa lad vor Aand met din naade opfyldis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "At hun ey sueltis til døde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "Dit hellige Ord hende mette kand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 5,
      "text": "Oc føre hende i det foriette Land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 5,
      "text": "Vor høyeste ro oc glæde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 6,
      "text": "Giff oss nu alle i din samfund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 6,
      "text": "Som ere forsamlit here/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 6,
      "text": "At elske huer anden aff hiertens grund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "Som Christus monne oss lære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "Beuar oss fra vor Fiende gram/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "Fra alskens skade baade last oc skam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 6,
      "text": "Du vilt vor beskermer være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 7,
      "text": "Loff ære oc tack i allen stund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 7,
      "text": "Skal dig Gud Fader være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 7,
      "text": "Som løst haffuer oss aff syndsens baand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 7,
      "text": "Giff oss dine Ord at lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 7,
      "text": "At tro paa din enbaarne Søn Jesum Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 7,
      "text": "At wi dine Børn oe Arffuinge vist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "Dig euindelig prise/ Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 8,
      "text": "TAcker Herren/ thi hand er saare venlig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 8,
      "text": "Thi hans godhed oc sandhed bliffuereuig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 9,
      "text": "Hand som en naadig Gud vdaff sin mi skund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 9,
      "text": "Er mod oss Arme Creatur saare rund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 10,
      "text": "Hand er den som giffuer Queg deris føde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 10,
      "text": "De vnge Raffne som paa hannem raabe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 11,
      "text": "Hand haffuer icke lyst til hine Stercke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 11,
      "text": "Men til dem i hans fryct hans godhed mercke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 12,
      "text": "Siunger aff hiertens grund met inderlighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 12,
      "text": "Loff oc tack ske dig Fader i euighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 13,
      "text": "At du oss som en rig oc milder Fader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 13,
      "text": "Spiser oc klæder dine Børn aff naade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 14,
      "text": "Giff at wi kunde dig rettelig lære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 14,
      "text": "At kiende/ ved Christum Jesum vor Herre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 15,
      "text": "J Jesu naffn saa haffue wi alle ædt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 15,
      "text": "Aff øl oc mad saa ere wi nu vel mett:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 16,
      "text": "O euig Herre Gud giff oss der aff gaffn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 16,
      "text": "At loffue oc prise dit hellige naffn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 17,
      "text": "HErre Gud du være nu priset",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 17,
      "text": "Oc tacket for Dricke oc Mad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 17,
      "text": "Du haffuer oss vel bespiset/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 17,
      "text": "Thi er vort hierte glad:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 17,
      "text": "Oc din mildhed bemercker/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 17,
      "text": "At du vor tro bestyrcker/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 17,
      "text": "At du est alles vor Gud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 18,
      "text": "Om wi det haffue anammit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 18,
      "text": "Met lyst oc offuermaade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 18,
      "text": "Huor met wi maatte kommit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 18,
      "text": "Snart i din vrede oc had/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 18,
      "text": "Du vilde dog oss aff naade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 18,
      "text": "O Herre icke lade det skade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 18,
      "text": "Ved Christum Jesum din Søn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 19,
      "text": "Du vilt oc altid nære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 19,
      "text": "Herre vor Siel oc Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 19,
      "text": "Oc til Christum henføre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 19,
      "text": "At hun i dig fødis kand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 19,
      "text": "At wi ingen hunger lide/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 19,
      "text": "Ere stercke i sorrig oc quide/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 19,
      "text": "Oc leffue euindelig.",
      "part": false,
      "marginal_notes": []
    }
  ]
}