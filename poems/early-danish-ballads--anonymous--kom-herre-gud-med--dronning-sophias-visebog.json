{
  "id": null,
  "title": "Kom Herre Gud med",
  "year_created": [
    1630,
    1639
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Dronning Sophias visebog",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1639,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/DRSVIII.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "an En wisa vnder samma ton",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 1,
      "text": "Kåm Herre Gudh medh tin hielp och tröst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "j these siste tider",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "och stÿrk wår hierta j wår bröst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Effter så månge bedröffuelse lider",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "så wäll den fatige som then Rik",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "olÿckan kan då jngen vnwika",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "der öffuer så mången quider",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Ach herre gudh tu wäll hielpa kan",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "dem som sigh på tigh förlåta,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Antinga thet är quina äller man",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "kan thet them Aldra bäst båtha",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "när the sit håp sätia förwist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Allena till tigh herre jesu Christ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "och tin hielp stadigt förbida",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Ropa till gudh aff hiertans grundh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "borde wÿ medh Räta giöra",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "vthÿ alla tider så och stundh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "om vÿ wille han skall oss höra",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "men gudh bätre wÿ thet Eÿ Förmå",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "så stadigt vthÿ bönen stå",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "vthan tu gudh wår hierta will Röra",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "Iagh bekiäner thet jn för tigh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "o gudh min kiäre herre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "att sårgen har tuingat offta migh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 4,
      "text": "att iagh bedröfuat hierta monde bära",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 4,
      "text": "för tÿ iagh Eÿ har så kunat bedet digh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 4,
      "text": "Aff alt mitt hierta jnerligh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "som migh har bort att giora",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": "Nu takar iagh tigh gudh Aff hiertans grundh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 5,
      "text": "för mot och medh gångh tillika",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 5,
      "text": "och beder ödmiukeligh j all stundh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 5,
      "text": "att tu aldrigh Ifrån migh will wicka",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 5,
      "text": "vthan Regera migh medh tin nådh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 5,
      "text": "och war altidh medh migh j Rådh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "vthaff nåde giff migh himmell rike",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 6,
      "text": "Plat medh oss alla vthe är",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 6,
      "text": "om wÿ håp till menniskior draga",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 6,
      "text": "thet håp och snart förloras her",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 6,
      "text": "Få är alla menniskiors dagar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 6,
      "text": "j dagh En leffuer och är Frögde Full",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 6,
      "text": "j morgon är dödh och leges j muldh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "gudh sÿ till wårt Elende wÿ her draga",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 7,
      "text": "Elendigh må den nämpnas wist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 7,
      "text": "som her j wärden skall leffua",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 7,
      "text": "och sina wäner haffuer mist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 7,
      "text": "bedröffua hierta månde thet giffua",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 7,
      "text": "dåk låffuat ware tu jesu blidh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 7,
      "text": "som them Elende tröstar altidh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 7,
      "text": "och när them will altidh bliffua",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 8,
      "text": "Rät saligh och säll då är then man",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 8,
      "text": "som tu Reda haffuer till tigh taget",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 8,
      "text": "så och migh när som iagh kan",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 8,
      "text": "kåma j thet liufliga laget",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 8,
      "text": "och ther får vngås medh wäner min",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 8,
      "text": "vthÿ then Euige herlighet till",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 8,
      "text": "ach jesu lät thet tigh snart behaga",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 9,
      "text": "sanerligh må den nämpnas sel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 9,
      "text": "och saligh medh Alla till licka",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 9,
      "text": "som jfrån thenna wärden är skilldh wäll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 9,
      "text": "och får wistas j himell Rike",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 9,
      "text": "och ther får skåda gudz ansichte blidh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 9,
      "text": "för vthan all Ende till Euigh tidh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 9,
      "text": "då kan man all bedröffuelse vnwicka",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 10,
      "text": "Denne wärlden är Full medh ostadigh Frögdh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 10,
      "text": "det må man medh Räta klaga",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 10,
      "text": "men wistas vthÿ himels högdh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 10,
      "text": "är Frögdh och lustiga dagar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 10,
      "text": "och wara jblant gudz Engle skar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 10,
      "text": "och så wthÿ den herlighett klar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 10,
      "text": "som sigh tå monde till draga",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 11,
      "text": "O Euige gudh tu hör min bön",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 11,
      "text": "som iagh för tigh monde frambära",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 11,
      "text": "så wäll vpenbarlig som j lön",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 11,
      "text": "är thet min hiertans begiära",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 11,
      "text": "att iagh måte snarlige kåma till tigh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 11,
      "text": "iagh åstundar thet jesu jnerligh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 11,
      "text": "att iagh altidh måte hoss tigh få wara",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 12,
      "text": "thet trÿcker En fast hårdeligh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 12,
      "text": "när som bedröfuelse hender",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 12,
      "text": "men thet frögdar då jnnerligh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 12,
      "text": "att gudh altingh om wånder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 12,
      "text": "och giffuer oss En Euigh Ro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 12,
      "text": "som till hans lÿffte sätia tro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 12,
      "text": "och befalla sigh honom j hender",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 13,
      "text": "Ett troligen Aff hiertat önskar iagh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 13,
      "text": "migh och alla trogne tillika",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 13,
      "text": "att kunna på then siste dome dagh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 13,
      "text": "herrans grÿme wrede vnwike",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 13,
      "text": "och bliffue vth walde till hans brudh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 13,
      "text": "och altidh glädias j tigh here gudh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 13,
      "text": "j thet frögde fulla himmelriket",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 14,
      "text": "Rät nu Beslut måste iagh snart",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 14,
      "text": "medh thenna min wisa giöra",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 14,
      "text": "Effter hon Eÿ haffuer sådan art",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 14,
      "text": "iagh många tårs lata henne höra",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 14,
      "text": "för tÿ then henne haffuer samman sat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 14,
      "text": "han haffuer jke mÿcket studerat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 14,
      "text": "tÿ må honom jngen spåt giöra",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 15,
      "text": "Valle till månge tusen godh nat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 15,
      "text": "huem thenne wisan monde före kåma",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 15,
      "text": "skall altidh wara aff migh önskatt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 15,
      "text": "mÿcken Fredh Frögdh och Froma",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 15,
      "text": "gudh late oss snart finas j then Euige Ro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 15,
      "text": "och sedan medh christo j himelen bo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 15,
      "text": "ther till hielp jese Christe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 15,
      "text": "Amen",
      "part": false,
      "marginal_notes": []
    }
  ]
}