  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Det er den herligste Tidsfordriv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "at agte paa Dyrenes Færden og Liv!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "At se, hvor de flokkes om Menneskets Hytte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Nogle til Glæde og Andre til Nytte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "i Skov, paa Mark, i Stald og i Bur,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "hvert med sin egen Drift og Natur.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Og kan ikke Dyret græde og le,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "det kan dog kjærligt paa Mennesket se,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "det bringer sin Tak og klager sin Nød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "og elsker den Haand, som rækker det Brød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Og derfor skal Mennesket Dyret agte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "og gjerne dets venlige Færd betragte.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
