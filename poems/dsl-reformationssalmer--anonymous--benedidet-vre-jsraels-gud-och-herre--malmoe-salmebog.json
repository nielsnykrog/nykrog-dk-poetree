  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "BEnedidet være Jsraels Gud och herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "fordi han haffuer søgt och forløst sit folk",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Oc han haffuer opret oss salighedens horn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "i Dauidz huss sin tieneris",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Som han haffuer talid igennem sine hellige Propheters mund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "huilcke som ere aff gammel tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Det skulle ske ath wi skulle frelsis fra vore wvenner/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "oc aff alle deris hand huilcke oss hadede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Paa det han skulle bruge sin miskundhed met vore foreldre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "och være ihwkomende sit testamente och løffte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Oc fuldkomme den eed han soor Abraham vor fader/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "at han skulle giffue oss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Paa det ath wi som vore frelste aff vore vwenners hender/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "skulle tiene hannem vden redtzel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Met hellighed och retferdighed for hans ansicte i all vor liffuis tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Oc du Barn skal kallis den høgstis Prophete/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "thi du skalt gaa for Herrens ansicte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "oc berede hans vey",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Till ath giffue hans folk salighedz lerdom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "til deris synders forladelse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "Vid vor Gudz store oc hierte barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "met huilcken han søgte oss oprunden aff det høgiste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "Ath han skulle liwse dem som side vdi mørckid oc dødens skugge ath stille vore føder til fredzens veye",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "Ere være Gud fader och Gud Søn oc saa Gud den Helligand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "Som værit haffuer aff begyndelsen nu er oc altid bliffuer til euig tid Amen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 1,
      "text": "Loffuer Gud vor Herre Alleluia Loffuer Herren Alleluia Alleluia/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Gud være euige tack Alleluia/ Loffuer Herren Alleluia Alleluia",
      "part": false,
      "marginal_notes": []
    }
  ]
}