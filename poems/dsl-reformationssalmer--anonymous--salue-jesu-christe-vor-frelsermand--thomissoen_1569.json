  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Salue Jesu Christe vor Frelsermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Du som all Guds vrede offueruand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "at Adam i dig naade fand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Du est vort liff oc søde trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "baade i modgang oc i lyst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "paa dig wi haabe O Jesu Christe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Wi paakalde dig vdi vor nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "som ere faldne i euig Død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "met Eua vor Moder alle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "Wi raabe til dig aff denne grædelige dal/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "Wi sucke oc græde for saadant it fald/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "dog est du fuld aff Guds gunst oc naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Thi hielp oss O naadefuld Christe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "Eya Christe vor talsmand est du vorden til vor Fader/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "forlad oss for din Døds skyld alle sager.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 5,
      "text": "Oc vend dit naadefuld ansict til oss vsle oc arme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "oc lad dig mildelig altid offuer oss forbarme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 6,
      "text": "O Jesu lær oss nu at kiende Fader din/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 6,
      "text": "huess Naade oc fromhed i dig skin.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 7,
      "text": "Lad oss saa kiende hannem i ret tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 7,
      "text": "at wi maa hans blide ansict skue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 7,
      "text": "oc siden met dig oc hannem bo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 8,
      "text": "1. O gode Jesu.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 8,
      "text": "2. O milde Jesu.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 8,
      "text": "3. O søde Jesu.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 9,
      "text": "Jesu Christe Guds Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 9,
      "text": "hør nu vor hiertens bøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 9,
      "text": "oc skil oss ved vor fortiente løn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 9,
      "text": "Du som frelste Adams køn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 9,
      "text": "hør vor Gudelig bøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 9,
      "text": "oc som wi tro dig du oss vel røn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 9,
      "text": "Vndertræd vor fiende den gamle slange/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 9,
      "text": "at hand oss ey nu maa fange/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 9,
      "text": "som hand haffuer giort ved mange/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 9,
      "text": "O Abrahams sæd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 9,
      "text": "du oss icke forgæd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "Men deel oss din Naade met.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 10,
      "text": "O Jomfru Marie Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 10,
      "text": "O Kong Dauids euige køn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 10,
      "text": "O Jesu Christe du hør nu vor bøn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 11,
      "text": "1. O gode Jesu.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 12,
      "text": "Jesu du est vor trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 12,
      "text": "hør vor grædelig røst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 12,
      "text": "oc benaade oss vdi vor brøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 12,
      "text": "Du est Emanuel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 12,
      "text": "opliuss vor mørcke Skel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 12,
      "text": "oc optend Naadens liuss i vor Siel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 12,
      "text": "du est Jacobs Stierne oc Jsraels quist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "som Bileam sagde foruist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "oc Esaias aller mest/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "Du est den Kilde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "som Naaden vduelder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 12,
      "text": "Som Propheten om melde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "O Jomfru Marie Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "O Kong Dauids euige køn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "O Jesu Christe du hør nu vor bøn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "2. O milde Jesu.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 15,
      "text": "Jesu du est vor vey",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 15,
      "text": "til Himmels/ oc vor stij/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 15,
      "text": "lad oss ey vildfare i wuey/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 15,
      "text": "Du est Paradisis port/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "lad oss ey vildis bort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "i den bister mørcke Jld oc sort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "du est en faffuer Soel skinnende oc klar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 15,
      "text": "som i Verden skin/ obenbar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 15,
      "text": "huo den seer gaar vden fare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 15,
      "text": "Du est det Guds lam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 15,
      "text": "som for oss i nød kom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 15,
      "text": "Skild oss ved den gamle ham.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 16,
      "text": "O Jomfru Marie Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 16,
      "text": "O Kong Dauids euige køn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 16,
      "text": "O Jesu Christe du hør nu vor bøn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 17,
      "text": "3. O søde Jesu.",
      "part": false,
      "marginal_notes": []
    }
  ]
}