    "year_published": 1854,
    "url": "https://tekstnet.dk/books/andersen-hc_af-samlede-skrifter-femtende-bind/004/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Som Du tænkte det staaer nu Museet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Klart vi have for os din Idee!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Stille gjemmer i sig Rosentræet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Tanken til den Blomst vi siden see;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Og vort Hjerte slaaer ved dette Skue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Sangen runger over Sund og Bugt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Det gjør godt at føle Hjertet lue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Juble for hvad dygtigt er og smukt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Livet leves skal! hvo ret har levet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Friskt og sundt i Tanke, Daad og Gud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Han sit Navn i Verdens Bog har skrevet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Fuldendt sin Mission, sin Skabers Bud!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Danmark fik en Skat, Du Caps’len bragte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Mangt et Kunstværk, skabe Du lig den!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "I vort Øie Gud en Guldmønt lagde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Glædens Guld, tag din Betaling Ven!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
