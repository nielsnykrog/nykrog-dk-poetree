{
  "id": null,
  "title": "Kong Valdemars sidste Stund",
  "year_created": 1861,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Carsten Hauch",
    "country": null,
    "wiki": "Q688529"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Valdemar Atterdag",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1861,
    "url": "https://tekstnet.dk/books/hauch-c_valdemar-atterdag/027/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Kong Volmer styred Landet i fem og tredive Aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "I onde med gode Dage, i Vinter som i Vaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Han vandt igjen tilbage saamangen pantsat Ø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Nu nærmed sig den Time, da Kongen skulde døe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Han sagde: »Vidt jeg færdedes paa Hav og paa Strøm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Ved Gurresø dog drømte jeg min fagreste Drøm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Man troede, jeg var lykkelig, dog vared Lykken kort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Thi den, jeg høiest elsked, blev reven fra mig bort.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Maatte det mig forundes at drømme den Drøm igjen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Og kunde jeg samles med min kjæreste Ven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Jeg opgav gjerne Himlen, selv om den findes kan,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Og boede helst med Tovelil ved Gurresøens Strand.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Ind traadte Biskop Erland, en Herre from og reen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Tilside veg hver Hofmand, da han i Hallen treen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Han sagde: »Mig sender Helvig, Jer ulykkelige Viv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Nu er det vel paa Tiden at ende den Kiv.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Det var den samme Herre, for hvem ved Paasketide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Tovelil havde skriftet engang sin Elskovs Qvide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Da som en Munk i Kloster endnu han maatte boe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Vidt var han bekjendt for sin Gudsfrygt og Tro.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Han agtedes alt som Helgen, før han blev lagt i Grav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Hans Dyd man havde lønnet nu med en Biskopstav;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Han var i Borg og Hytte de Undertryktes Ven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "Han lindred mangen Kummer, hvor han sig vendte hen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Han sagde: »Jeg om Helvig har talt til Eder tidt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Min ædelige Herre, dog hjalp det kun lidt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Før var hendes Lokker som Ibenholt at see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "Nu er de saa hvide som nyfalden Snee.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "Alt Dødens Træk jeg skuer omkring Din blege Mund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Saa tilgiv Din Hustru i Livets sidste Stund;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "Alt længst sin svare Gjerning hun skrifted ved min Fod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "Hun har havt Tid til Anger og til oprigtig Bod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "Og husk, at for Dig selv nu Dommen forestaaer.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "- »Jeg tilgi'er hende aldrig, hvordan det saa gaaer,«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "Gjensvared Kong Volmer, han vendte sig om;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "Forgjeves minded Bispen igjen om Herrens Dom.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "Han sagde: »Betænk Dig, lad bedre Tanker raade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Husk, at høit Du trænger nu selv til Herrens Naade!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "I Dag alt skal Du vandre paa den ukjendte Vei.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "- »Nei,« svared atter Kongen, »jeg hende tilgi'er ei.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "Døden til ham sig nærmed, den paa hans Leie sad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Den greb ham alt om Hjertet, dog holdt han fast sit Had,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "Det sortned for hans Øie, sig aabned Gravens Vei,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "Dog svæved paa hans Læber endnu et sagte »Nei.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "End dvæled Bispen længe, han stirred tankefuld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Paa Kongens Lig og sagde: »Saa synker i Muld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "De mægtigste Kræfter, den høieste Jordens Kløgt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "Vel den, som ei sin Lykke paa Jorden blot har bygt.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "Den samme Dag, da Klokkerne ved Kongens Baare klang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 11,
      "text": "Aanded og Dronning Helvig i Luft for sidste Gang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 11,
      "text": "Dem, som i Livet skiltes ad, forened Dødens Magt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 11,
      "text": "Og i den samme Time de blev i Graven lagt.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
