    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA86.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Wellemand och Sallemand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "thy gaar thenom att gaaden fram.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "\"Hør du, Wellemand wene!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Der myne fuolle render igiemell skuoffue. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Wenne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "wiltt thu thiig icke quenis?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "\"Ieg wed ingenn saa rigge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": ":: Der mynn fuolle render igiemell skuoffue. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Rigge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "der kand werre myn lygge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "For-vdenn iunfru Swaane.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "Suane,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "alt om hun wilde seg mande.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Sallmand suøber seg hoffuit y skiend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "Hoffuit y skiend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "hand gaar y lofft for søster synn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "\"Hør thu, søster Suanne!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "Suane,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "wildtt thu thieg icke mande?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 5,
      "text": "\"Ieg wed ingen saa rige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "Rige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 6,
      "text": "der kand were myn lygge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 6,
      "text": "For-vden Wielemand wene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "Wenne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 7,
      "text": "altt om hand wilde quenys.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 7,
      "text": "Thy lader bryge och blende wyn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 8,
      "text": "Blende wyn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 8,
      "text": "saa luod dy till brølup byde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 8,
      "text": "Thy bød fattig, och thy bød rige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 9,
      "text": "Tthy bød rigge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 9,
      "text": "thy bød thrinde konge-rige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 9,
      "text": "Saa bød thi och hans sleffred-wyff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 10,
      "text": "Sleffred-wyff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 10,
      "text": "thett kostett hans vnge lyff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 10,
      "text": "Hun gaff hanom vdj synn mad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 11,
      "text": "I syn mad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 11,
      "text": "ther-aff feck hand saa vnde lade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 11,
      "text": "Saa gaff thi hanom att drike.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 12,
      "text": "Drike",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 12,
      "text": "men inthett kunde hanom sløcke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 12,
      "text": "sløke Wellemand thog seg suerd y haand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 13,
      "text": "Suerd y haand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 13,
      "text": "saa gaar hand y dørenn att staande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 13,
      "text": "Wellemand hog, thett hand wor muod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 14,
      "text": "Hand wor muod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 14,
      "text": "hand stuod y XXX mande blod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 14,
      "text": "\"Hør y, iumfru Suane!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 15,
      "text": "Suane",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 15,
      "text": "y steller edders festemand!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 15,
      "text": "\"Stielle hanom Gud och sancti Iehann!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 16,
      "text": "Och sancti Ihann,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 16,
      "text": "som ieg hanom icke stielle kand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 16,
      "text": "Stell hanom Gud och Mari møø!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 17,
      "text": "Mari møø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 17,
      "text": "hand stieller seg aldrig, førind ieg er død.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 17,
      "text": "Wellemand hand sytt suerd vdrog.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 18,
      "text": "Sitt suerd vdrog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 18,
      "text": "syn vnge brud hand y støcker huog.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 18,
      "text": "Thett skiedde ind førre mydi-natt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 19,
      "text": "Mydi-natt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 19,
      "text": "Wellemand feck wed saa offuer-bratt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 19,
      "text": "\"Offuer-bratt hør y thett, kerr moder myn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 20,
      "text": "Moder myn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 20,
      "text": "huor er iumfru Suane, alderkereste myn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 20,
      "text": "\"Saa haffuer du liegtt dyn affttens-lieg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 21,
      "text": "Affttenns-lieg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 21,
      "text": "dyn vnge brud legger y loffthett lig.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 21,
      "text": "Wellmannd hand sytt suerd vddrog.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 22,
      "text": "Suerd vddrog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 22,
      "text": "syn sleffred hand alle y støcker huog.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 22,
      "text": "Saa satte hand hialttenn imod en stienn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 23,
      "text": "Mod enn stienn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 23,
      "text": "aadenn giorde hans hiartte mien.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 23,
      "text": "Skaam daa faa den sleffred-wyff!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 23,
      "text": "hun forrade saa mgangtt ett vnge lyff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 23,
      "text": ":: Ther mynn fuolle render igemell skuoffue. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}