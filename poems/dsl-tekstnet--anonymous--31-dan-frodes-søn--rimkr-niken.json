  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "ieg rodher hannum ath han tencker aa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Han bidhe syn fijendhæ ey hiemme i hwss,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "men waræ hannum vndher hans øwen fws.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Ieg wor end mynne æn xiij aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "The bleffue so store i hiarthæ oc hw,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "aff Lanthosassen som the æræ en nw.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "The willæ ey ware vndher danes wold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "men gaffue them lasth so manghæ fold.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "han fylthæ all ælffuen som eth kær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Fra then enæ oc tijl then annen bredh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "motthæ man gaa paa skipsbord wredh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "som han hade ganghet paa en broo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Ieg wanth them offuer meth Danmarks macth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "thet gik them offuer, the hade meg acth.",
      "part": false,
      "marginal_notes": []
    }
  ]
}