  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Huo som Christi Kaarss vil pryde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc der aff euig salighed nyde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "fem ædele Stene hand der i sette/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "oc deris kraffter aldrig forgætte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Tro Ydmyghed Lydactighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Taalmodighed oc Kierlighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "1. Troen hun er den ædele Sten",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Som Christum gantske fatter allen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Aff Christi ord er Troens krafft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Hun acter intet all Dieffuelens mact.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Christi Retfærdighed før hun sig i/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Huor met hun er alle Synder fri.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "2. Ydmyghed fylger Troen nær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Hun slar sig neder for HERREN kier.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Hun frycter Gud vdi allen stund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "All Hoffmodighed slar hun til grund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Hun kiender sin egen Synd oc Last/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Der for bliffuer hun i Troen fast.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "3. Den ædele Sten Lydactighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Som fylger met Troens retsindighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "All Kiødsens raad monne hun forsmaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "J huor det hende vdi Verden vil gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "Huad HERREN biuder det vil hun giøre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Aff Verden lader hun sig icke forføre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "4. Der voxer aff Troen Taalmodighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 4,
      "text": "Som acter icke Modgangs bitterhed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 4,
      "text": "Hun veed at HERREN er huld oc tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 4,
      "text": "Som hun skal hoss vdi euighed bo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Den timelig Plage faar vel ende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "Som Christi Kaarss giffuer oss tilkiende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 5,
      "text": "5. Ved Kierlighed lader Troen sig see/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 5,
      "text": "Oc vil sine deylige kraffter betee.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 5,
      "text": "Hun kiender Christum vdi sine Lemmer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 5,
      "text": "Oc aldrig Barmhiertighed mod dem glemmer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 5,
      "text": "Guds billede monne hun altid ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Som alle Christne visselig bære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 6,
      "text": "Scriff dette Kaarss vdi hierte rod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 6,
      "text": "Saa kant du kiende huad HERren er god.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 6,
      "text": "Naar denne Verden hun vil dig glippe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 6,
      "text": "Oc du skalt Rigdom oc Venner slippe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 6,
      "text": "Da haffuer du trøst vdi all din nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 6,
      "text": "Aff Christi dyre oc hellige død.",
      "part": false,
      "marginal_notes": []
    }
  ]
}