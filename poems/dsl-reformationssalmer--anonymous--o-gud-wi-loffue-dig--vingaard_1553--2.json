  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Gud wi loffue dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Vi bekende dig for en Herre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "All verden oc Jorderige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "priser dig euige Fader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "Saa gør oc alle dine Engle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "Hiemle oc Hiemmelske herskaff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Dig prise Cherubin oc Seraphin/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "met en euig Engelske Lofsang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "Hellig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "Hellig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "Hellig/ herlig Herre Gud Sabaot",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "Hiemmel oc Jorden ere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "opfylte/ met din Maiestetis herlighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "Den hederlige Apostels forsamling/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "Propheter/ Martyrer/ met alle hellige Fædre loffue dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "Alle Gudfryctige Gudz børn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "vederkende dig offuer all Jørderige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "En Fader met allerhøyeste herlighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 9,
      "text": "Oc din eniste Søn Jesum Christum",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "Holde wi met dig for en herlig Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 10,
      "text": "Ocsaa den Helligaand een sand trøstermand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 11,
      "text": "O Herre Christe du est en Kong/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 11,
      "text": "aff alt ære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 12,
      "text": "Du est din Faders euige Søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 13,
      "text": "Du anammede Menniskelig nature met Kød oc Blod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 13,
      "text": "oc der met offueruant Dieffuelsens hoffmod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 14,
      "text": "⁕ Der du haffde stungit døden met sin egen Braad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 14,
      "text": "da skencke du alle dine det euige Liff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 15,
      "text": "Derfaare sider du nu paa høyre hand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 15,
      "text": "i din Faders herlighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 16,
      "text": "Oc der effter skal hid igenkomme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 16,
      "text": "en streng dommere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 17,
      "text": "O Jesu dine tro Christne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 17,
      "text": "huilke du forløste met dit dyrebare Blod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 18,
      "text": "At wi mue vorde i din ære delactige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 18,
      "text": "O Herre hielp dit vdualde folck/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 18,
      "text": "oc velsigne dem som dig ere til arffue giffne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 19,
      "text": "Oc regere du dem selff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 19,
      "text": "oc lær dem din vilge at gøre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 20,
      "text": "Vi prise dig O sande Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 20,
      "text": "baade nu oc altid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 21,
      "text": "Och wi prise dit naffn euindelige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 21,
      "text": "fra nu oc til euig tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 22,
      "text": "O Herre beuare oss nu oc altid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 22,
      "text": "syndeløse oc synde frii",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 23,
      "text": "O Herre forbarme dig offuer oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 23,
      "text": "och ver oss naadig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 24,
      "text": "O Herre te oss din barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 24,
      "text": "som vor store Tro er nu til dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 25,
      "text": "Men wi sette til dig vor lid/ haab oc trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 25,
      "text": "da vilt du mildelige høre vor røst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 25,
      "text": "oc hielpe oss altid i vor brøst",
      "part": false,
      "marginal_notes": []
    }
  ]
}