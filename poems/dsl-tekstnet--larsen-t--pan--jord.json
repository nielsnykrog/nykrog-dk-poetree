    "place": null,
    "year_published": 1904,
    "url": "https://tekstnet.dk/books/larsen-t_jord/022/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "I Universets evige Blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hvor Kloderne tavst om Kloderne gaa – –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "i Jordens Luft, hvor Torden og Storm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Solskin og Slud som Stemninger skifter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "mens Skyerne skifter Farve og Form",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "og jages af store, urolige Drifter – –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "i Kræfternes Løb ad Lovenes Vej,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "manende Jordlivets mylrende Kuld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "af Muld, over Muld, i Muld – –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "jeg aner en Gud, et evigt Jeg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "der har Nerver i Klodernes Indre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "og i Slægternes Marv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "og hvis Evner fra Solene tindre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "og hvis Væsen er Væsnernes Tarv.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "Han vakte Fædrenes »hellige Ord«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "i Tanker, der spurgte Himmel og Jord;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "han vakte Tvivlen i Sønnernes Sind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "og aanded Fornyelsens Østenvind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "over hæmmede Evners Ranker – –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 5,
      "text": "og Higen mod denne al-rige Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "strømmer som en Sankt-Elmsild ud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "fra Tinderne af alle Folkeslags Tanker.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
