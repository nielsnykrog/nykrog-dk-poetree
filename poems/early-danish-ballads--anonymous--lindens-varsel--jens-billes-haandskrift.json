  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Jens Billes Håndskrift",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1559,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/BILL46.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Ieg vel eder syge aff tu konge-børn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hvad dhe lofved hver-anden i løn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": ":: I dansen dha trede vy. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Dhe lofvede hver-anden af saa megen lest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "dher sprynger ud løf paa lynden-kvyst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "\"Skule i iar i ledyng far,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "hvem dha setter i meg tyl vare?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "\"Ieg skal sette dheg lynden for dhin lofttes-bro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "vyntter och somer dha skal hun gro.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "Første dhen lyn hun feler syn blad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "dha mott dhu vyde, dhett ieg er ike glad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "Første dhen lyn hun feler syn løf,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "dha ma i vyde, dhett ieg er døtt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "Alltt dher dhe taled, dhe tenktte, dhe var ennæ to,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "alltt stod hynes terne och lyde dher-pa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "Heræ Krest gyfve dhen terne men,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "hun brød løf af lynden-gren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "Saa stod dhett i manett tre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "saa løste iomfruen tyl lynden att se.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "Hun lod op vyndu, och ud hun saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "lyndenløf paa ioren laa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 10,
      "text": "\"Veste ieg, att myn herre var døtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "dha skule ieg brende myn burd i glød.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 11,
      "text": "Hun sett illd i buryn syn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "och brende seg inde mett alle syn mør.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 12,
      "text": "Dher dhen bur stod i gloen brand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "dha kom dhen reder seglen tyl land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 13,
      "text": "\"Hveden er dhenæ gloen brand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "her brender paa myn iomfrues land?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 14,
      "text": "Veste ieg, dett myn iomfru vare døtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "dha skulle mytt egett sver blyfve myn døtt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 15,
      "text": "Han sette hyltten mod en sten,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "och oden i hans hyrtte i-gen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 16,
      "text": "\"Nu skall dhett kalle iern",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "sløk sorg och svale harm.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 16,
      "text": ":: Ud-i dansen dha tredæ vy. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}