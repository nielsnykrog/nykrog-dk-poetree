  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Hwor som man seer syn offuermacth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "thet ær ey skade ath gøre ther pacth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "och sie at thet ær lasth oc skam.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Then tijd ieg Danmarks koning bleff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "aff Rom kom Iulius, then hællædhe geff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Han willæ oss twingæ vnder romers hand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Men tha han saa wort folkkes macth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "han thordæ ey kry, men giorde en pacth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "ath wi skullæ en tijd om hwert aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "høgthidhe then dagh han føddher waar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "och holldæ'næ for en almyndelig sedh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Wij kallædhe'n iull, then ryther tijl loff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "wi brugædæ ther i bode løst oc skoff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Saa for han meth then redhe borth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Thernæst giorde ieg eth annet gaffn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Ieg Hwrwell slo i Hwrwelshaffn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "I Hallandh mwnne then høffding boo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "han willæ tha taghæ then danskæ koo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "och Ængæland meth vndher danes handh.",
      "part": false,
      "marginal_notes": []
    }
  ]
}