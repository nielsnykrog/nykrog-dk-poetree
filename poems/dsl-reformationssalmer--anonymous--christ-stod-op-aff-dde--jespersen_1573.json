    {
      "id": 0,
      "stanza_id": 0,
      "text": "CHrist stod op aff Døde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc frelste oss alle aff nøde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Thi ville wi alle være glad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "oc loffue vor Herre i allen stad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Kyrieleis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "O Christe Konning/ forbarme dig offuer oss/ Haleluia.",
      "part": false,
      "marginal_notes": []
    }
  ]
}