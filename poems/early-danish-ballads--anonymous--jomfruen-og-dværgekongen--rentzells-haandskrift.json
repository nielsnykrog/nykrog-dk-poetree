  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Rentzells Håndskrift",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/RNZ49.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Rider holler under buske,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": ":: Thy tiiden giøres meg saa lang ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "tager hand till at øske.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Eya, ey ey, huad sorrigen du est tung! ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "\"Christ giffuedt, den ønsken matthe saa gaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "ath ieg kunde konningens dotther faa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Suaaridtt denn ville duerge, under biergedt som hand laa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "\"Det er en ønsk, der aldrig fremgaar.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "Then diuerge tager staffuen y sin hand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "till konningens gaard saa monne hand gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "Daatther och hindis kiere moder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "dy sidder y dieris burre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "\"Hør du nu, kiere daatther myn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 5,
      "text": "hui falmer dit haar? hui blegner dine kindt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "Hui falmer dyn lydtt, hui falmer dit haar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "lige-som den quinde, met barne gaar?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "\"Thet duer icke at dylle for ether:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 7,
      "text": "den ville diuerge haffuer lockedt mig.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "\"Haffuer den ville diuerge lockett dig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 8,
      "text": "tha haffuer du icke lenger moder y mig.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "The menthe, de var enne II:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 9,
      "text": "udestaar den diuerge, liuder paa ordt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "Hand slo hinde met edt eluer-thre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 10,
      "text": "\"Du skøndt dig adt biergidt effter mig!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "Stallt Metthe-lill ind aff biergiid thren:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 11,
      "text": ":: Dy legthe for-offuen wedt hald. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 11,
      "text": "hindis VII sønner dy stander hende op igien.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 11,
      "text": ":: Eya, ey ey, sorrigen huad thu est tung! ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}