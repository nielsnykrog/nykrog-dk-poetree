  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "En Epilog – dens Kreds gaaer vidt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "I Aandens og Verdens Mit og Dit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "I Alt hvad der skeer; man bliver ei kvit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Epilogen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Ved Balmusikens og Dandsens Flugt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Forloves et Par; det er ganske smukt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Epilogen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Den synkende Sol ender Dagens Magt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Og giver igjennem Skyernes Pragt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Epilogen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "Paa Storm følger Havblik i Vexelgang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "Paa Svanens Liv følger Svanesang:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Epilogen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "Den visne Blomst, gjemt, men ei glemt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "Er om saameget, der dybt har stemt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "Epilogen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "I Længselen ligger den fjernt og vidt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "I Kjærligheds Lykke blev Smerte tidt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "Epilogen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 6,
      "text": "Vel er Epiloger skrevet og sagt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "Saa tidt, at nu har slet ingen Magt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 6,
      "text": "Epilogen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 7,
      "text": "Og dog er det ofte en Hjertens Trang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "At sige sin Tak – saa har man en Gang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 7,
      "text": "Epilogen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 8,
      "text": "Den er en Bouquet, som Digteren bandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 8,
      "text": "Der bringes, som man i hans Have fandt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 8,
      "text": "Epilogen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 9,
      "text": "Men Hjertelaget har en Magi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 9,
      "text": "Den lægger dybtfølt Tak udi",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 9,
      "text": "Epilogen!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
