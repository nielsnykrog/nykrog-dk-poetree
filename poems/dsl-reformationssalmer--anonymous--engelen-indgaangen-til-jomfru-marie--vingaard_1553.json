  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "ENgelen indgaangen til Jomfru Marie/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Sagde helsel fuld naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Herren met dig du est benedide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Blant quinder i mange maade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Elizabet sagde oc met tuct/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Velsignet er din liffzens Fruct/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "De Tro wi oc alle samme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Den Marie flyde naade frelste oss aff vaade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Jesus Christus Amen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "⁕ Adam oc Heua der de bleffue skaffte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Effter Gudz egit Billede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Aff Dieffuelsens had bleffue de fortabte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Der de hans løgen beuilgede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Gud truede Slangen dem til glæde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Oc sagde Quinde Sæd skulde hans hoffuet træde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Det Tro wi alle sammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Den Adam flyde naade frelste oss aff vaade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Jesus Christus Amen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "⁕ oc Abel giorde Gud skel paa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Der han Cain fordømde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Men Abels Offer han gerne til saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "For han vor wden skrømpte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Cains vantro manddemord bedreff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Men Abels Tro til salighed bleff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Det tro wi alle sammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Den Abel flyde naade frelste oss aff vaade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Jesus Christus Amen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "⁕ Enoch siuende mand effter Adam kom",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Predickede denne Tro oc spaade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Om Gudz vrede oc strenge dom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Thi lidde han spot oc vaade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Men Gud gemde hannem met Krop oc Skind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "Oc lod saa Verden fare blind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "Det tro wi oc alle sammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "Den Enoch flyde naade frelste oss aff vaade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "Jesus Christus Amen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "⁕ Noe predickede i hundrede Aar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "Der Folck bleffue flere oc verre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "Alle troløsse och Kødelige vaare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "huer vaar sin egen herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "Thi plaffuede dem Gud met vand flod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "Vden Arcken Vand offuer Verden stod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "Det tro wi alle sammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "Den Noe flyde naade frelste oss aff vaade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "Jesus Christus Amen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "⁕ Loth gode mand i Sodoma/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "J troen lidde han stor drøffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "X Gudz venner kunde mand ey faa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 5,
      "text": "Der Gud vilde dem prøffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 5,
      "text": "Met Jld plaffuede Gud de wfromme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 5,
      "text": "Lot met sine Døtter lod han vnd komme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 5,
      "text": "Det tro wi alle sammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 5,
      "text": "Den Loth flyde naade frelste oss. et cetera",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "⁕ Abraham bleff oc en Gudz Mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "For han Gudz løffte trode/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "At aff hans Sæd skulde fødis han/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 6,
      "text": "J huilcken Gud salighed loffuede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 6,
      "text": "Der i fulde hannem oc Jsaac/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 6,
      "text": "Oc Jacob trode den samme snack",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 6,
      "text": "Det tro wi och alle sammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 6,
      "text": "Den dem flyde naade frelste oss aff vaade. et cetera",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 7,
      "text": "⁕ Joseph den yngste blant Jacobs Børn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 7,
      "text": "Bleff alle de andris herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "Der de sluppe hannem for Vgle och ørn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 7,
      "text": "Hans lycke bleff ey des verre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 7,
      "text": "Aff dem komme alle Jsraels Folck/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 7,
      "text": "Moses oc Aaron bleffue deris tolck/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 7,
      "text": "Det tro wi oc alle sammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 7,
      "text": "Den dem flyde naade frelste oss aff vaade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 7,
      "text": "Jesus Christus Amen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 8,
      "text": "⁕ Kong Pharao lod Gud beplaffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 8,
      "text": "Oc fride sit Folck aff fengsel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 8,
      "text": "Der de vil de fremmede Guder haffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 8,
      "text": "da giorde han dem och trengsel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 8,
      "text": "Ath de skulde ey i Chanaan Bo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 8,
      "text": "Vden Josue oc Caleb ene to/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 8,
      "text": "det Tro wi alle sammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 8,
      "text": "Den dem flyde naade frelste oss aff vaade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 8,
      "text": "Jesus Christus Amen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 9,
      "text": "⁕ Paa Sina bierg lod Gud dem giffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 9,
      "text": "Sine hellige x budord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 9,
      "text": "At de skulde i gode geninger bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 9,
      "text": "Och kende huad Synder de giorde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 9,
      "text": "dog kunde dem ingen holde foruist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 9,
      "text": "Vden de der trode paa Jesum Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 9,
      "text": "det Tro wi alle sammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 9,
      "text": "den dem flyde naade. et cetera",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 10,
      "text": "⁕ At de skulde sig ey selffue leffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 10,
      "text": "Gaff Gud dem Dommere oc Konger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 10,
      "text": "der til Propheter som Gudz ord screffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 10,
      "text": "Oc truuede met plaffue och hunger/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 10,
      "text": "Der effter vdlagde Gudz hellige Bud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 10,
      "text": "Och spaade om Christo mand oc Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 10,
      "text": "Det Tro wi oc alle sammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 10,
      "text": "Den dem flyde naade frelste oss aff et cetera",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 11,
      "text": "⁕ Dauid oc andre ehuad de hede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 11,
      "text": "Som scrifften oss forkynder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 11,
      "text": "huad kunde wi andet om dem vdlede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 11,
      "text": "End at de vaare Syndere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 11,
      "text": "Men at de komme aff Synd oc nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 11,
      "text": "Det skede for Christi pine oc død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 11,
      "text": "Det Tro wi alle sammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 11,
      "text": "der dem flyde naade frelste oss aff vaade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 12,
      "text": "⁕ Alt det gamle Testamente/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 12,
      "text": "Viste oss Christ som skulde komme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 12,
      "text": "den Gud haffuer nu til Verden send/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 12,
      "text": "Oss alle til glæde oc fromme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 12,
      "text": "Saa er det gamble bleffuit det Ny/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 12,
      "text": "der predickis i Land baade Egn oc By/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 12,
      "text": "dess loffue wi Gud alle sammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 12,
      "text": "Emanuel som Gabriel bebudet Marie Amen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 13,
      "text": "VJ bede vor Fader den Hiemmelske Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 13,
      "text": "om Siels oc Liffuis nødtørte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 13,
      "text": "At wi kunde fire hans Ord oc Bud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 13,
      "text": "Oc styres til dygd aff hierte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 13,
      "text": "Der met at gøre oc lide hans vilge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 13,
      "text": "Oc oss dog ingen fra næringen skillie/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 13,
      "text": "Men nyde hans naade alle sammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 13,
      "text": "Aldrig met alle i frestelsse falde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 13,
      "text": "Men frelsis fra Dieffuelen Amen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 14,
      "text": "NAar som wi ret paa en Gud tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 14,
      "text": "Fader som alting skabte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 14,
      "text": "Oc paa hans Søn i Hiemmelen bor/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 14,
      "text": "Som frelste oss fortabte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 14,
      "text": "Och wi tro paa den Helligaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 14,
      "text": "Som hellig gør baade Quinde oc mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 14,
      "text": "Der han til Troen fører sammen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 14,
      "text": "Och siden vecker op met Siæl och Krop",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 14,
      "text": "Til det euige Liff Amen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 15,
      "text": "HVo der Tror oc bliffuer døbt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 15,
      "text": "han skal vist salig bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 15,
      "text": "Men huo met andet vil vere igenkøbt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 15,
      "text": "Til pine vil Christ hannem driffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 15,
      "text": "Der paa giffuer han besegling god/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 15,
      "text": "Sit Legeme oc sit hellige Blod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 15,
      "text": "Det vnde oss Gud alle sammen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 15,
      "text": "At wi saa Tro det wi maa bo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 15,
      "text": "Met Jesu Christo Amen",
      "part": false,
      "marginal_notes": []
    }
  ]
}