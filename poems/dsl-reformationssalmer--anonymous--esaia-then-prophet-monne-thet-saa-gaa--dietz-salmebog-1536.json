  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "ESaia then Prophet monne thet saa gaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Att handt ÿ Aanden HERREN sidde saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Vdi then høge Trone oc klare skÿn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Hans kleder the opfylte thet koor omkring/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "tho Seraphin stode hooss hannom ther/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "sex winger saa mandt thennom haffue hwer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Mett thoo skiulde theris ansicht klare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Mett thoo betachte the theris fødder bare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Oc mett the andre tho fløge the fryt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "ÿ modt huer anden robte the mett megit fliit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Hellig er Gud waar herre Sabaoth/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Som haffuer all iorden opfyltt mett megit goth/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Aff thet roob skalff grundwaall och bielcker sware/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Och husit fult aff røg oc toge wor Amen.",
      "part": false,
      "marginal_notes": []
    }
  ]
}