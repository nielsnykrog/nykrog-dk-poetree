  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "och brugher han thet sith rigæ tijl gaffn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "tha maa han kalles en kongæ meth prijs,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "en ærligh man och klog oc wijs.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Men wil han ickæ regere well,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Saa gik thet meg for wissæ i hand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "tha ieg skullæ styræ bode rigæ oc land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Wthen gaffn hade ieg mit kongæ naffn;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "hwo nogeth ær dvælig, ther gaar aff saffn.",
      "part": false,
      "marginal_notes": []
    }
  ]
}