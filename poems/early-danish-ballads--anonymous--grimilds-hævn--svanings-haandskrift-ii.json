  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift II",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVII23.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Det vaar fru Kremold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hun lader det mød blende:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "det vaar saa mange helte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "der hun bud effter sende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Hun bad dem komme til orloff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "hun bud dem komme til krig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "der vaar saa mangen helt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "der skulde fordoie sit unge liff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "slig en som Helle Hagen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "oc Falquor Spilmand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "oc raske hellet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "der ieg neffne kand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Frem da gick hun Buodel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Hellet Hagens moder:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "\"Mig tøcte, de fogle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "alle døde vaar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Drømen haffuer at sæde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "huem hende forstande kand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "kommer du til den hedenske land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "det skader for mangen mand.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Herre rider wi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "oc strømme rinder stride:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "fandt hand selffue marre-mynd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "soffuind under lide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "\"Vaag, vaag, marre-minde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "skøne lande-viff:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "skal ieg til den hedenske land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "fordoye mit unge liff?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "\"Vent dig, Helle Hagen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "du est en knect saa baald:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "du haffuer paa dit egen land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "saa mange borge oc vold.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "Du haffuer paa dit eget land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "saa meget gods saa fri:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "kommer du til det hedenske land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "fordoit er dit unge liff.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "Det vor Helle Hogen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "oc hand sit suerd ud-drog:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "det vaar søllige marre-mind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "oc der hand hoffdet aff hug.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "\"Førend da skalt du dø",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "paa den huide sand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "ieg rider mig saa friskelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "oc ind til hedenske land.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "Herrer rider vide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "oc strømme rinder stride:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "fand hand søllig ferre-mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "soffuind hoss sin viff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "\"Vog op, goden feri-mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "du før mig offuer sund:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "ieg giffuer dig min gulde-ring,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "hun veier vel femtan pund.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 13,
      "text": "\"Haffue du selff din gulde-ring,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "ieg maa hende icke eie:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "ieg kommer aldri i den stad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "ieg bær ey for hender treie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "Ieg kommer aldrig i den stad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "ieg tager ey for hender nød;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "ieg fører dig icke offuer sund y dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "fru Kremøll mig det for-bød.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 15,
      "text": "Det vaar Helle Haagen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "hand sit suerd ud-drog:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "det vor den sellige ferri-mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "der hand hoffden fra hug.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 16,
      "text": "Saa kast hand det blodige hoffuit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "hand kaste hende udi sund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "saa kaste hand kropen effter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "hand bad, de skulde findis ved grund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 17,
      "text": "Her Gynter oc her Gierlo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "de styrede skib fra land;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "der de komme der mit paa sund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "daa reiste veier til haan.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 18,
      "text": "Sønder gick de orer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "i Falquor Spilmands haand;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "Helle Hagen met sin forgylte skiold",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "styrde selff det skib til land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 19,
      "text": "Da kaste de deris ancker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "paa det huide sand;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "det vaar Helle Haagen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "hand tren der først paa land;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 19,
      "text": "den neste mand, hannem effter tren,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 19,
      "text": "det vor Falquor Spilmand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "Ud da stander de kuorrer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "de trampeler paa de tynd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 20,
      "text": "\"Her er kommen paa vor land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 20,
      "text": "to saa stolt edeling.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "Her er kommen paa vort land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 21,
      "text": "tre saa modig mend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 21,
      "text": "de ere kled i iern,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 21,
      "text": "deris hest kommer springend frem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 22,
      "text": "De ere kled i ierne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 22,
      "text": "deris hest er springendis frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 22,
      "text": "den ene hand førde en høg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 22,
      "text": "er det sinner skiold;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 22,
      "text": "den anden hand førde en feddel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 22,
      "text": "en hertugs søn saa bold.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 23,
      "text": "Ud stander frue Kremold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 23,
      "text": "hun kunde de ord vel skiøn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 23,
      "text": "\"Hand før ingen feddel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 23,
      "text": "oc icke for nogen her løn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 23,
      "text": "de ere tre saa friske helt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 23,
      "text": "tre hertugers børn saa skiøn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 24,
      "text": "Ud stander frue Kremold",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 24,
      "text": "i siner skind grøn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 24,
      "text": "\"Ver vel alle nu kommen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 24,
      "text": "for-uden Helle Hagen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 25,
      "text": "Ver mig alle vel-kommen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 25,
      "text": "forinden disse rad;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 25,
      "text": "ieg siger aff kong Seifrids død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 25,
      "text": "den stund ieg leffue maa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 26,
      "text": "Det vaar kongen Kanselin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 26,
      "text": "hand taler til sin mend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 26,
      "text": "\"Wi vil holde en rend i dag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 26,
      "text": "met Helle Hagen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 27,
      "text": "Wi vil holde en rend i dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 27,
      "text": "sla hannem til hans død:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 27,
      "text": "saa maa wi volde hans grøne skrin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 27,
      "text": "oc saa hans guld saa rød.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 28,
      "text": "Det suaret Helle Hagen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 28,
      "text": "for inden ved den dør:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 28,
      "text": "\"Ieg vil det ether vel voffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 28,
      "text": "om i det voffue torff.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 29,
      "text": "Ud da sprang de suerde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 29,
      "text": "saa fast der de sprong:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 29,
      "text": "alle da lid dennem ilde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 29,
      "text": "den elder saa vel som den unge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 30,
      "text": "Sønder gick den gode suerd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 30,
      "text": "i Falquord Spilmands hand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 30,
      "text": "hand saae sig offuer den dør,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 30,
      "text": "hand fick en stolle-stang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 31,
      "text": "Hand saae sig alt offuer den dør,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 31,
      "text": "hand fick en stolle-stang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 31,
      "text": "hand slog aff den første slag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 31,
      "text": "siu-hundre rask hoffmend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 31,
      "text": "\"In nomine domini,\" sagde Helle Hagen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 31,
      "text": "\"nu gaar min fedel vel.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 32,
      "text": "In nomine domini,\" sagde Helle Hagen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 32,
      "text": "\"nu gaar min fedel vel:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 32,
      "text": "mig tyckis, det min hielper",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 32,
      "text": "de nu slagen er.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 33,
      "text": "Red ieg nu alt fra offuen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 33,
      "text": "saa vaar ieg i den vexd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 33,
      "text": "mig tyckis, min huide hals brender",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 33,
      "text": "for-inden min brynie-ringe.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 34,
      "text": "\"Slaar nu, alle mine mend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 34,
      "text": "som ieg haffuer giffuen brød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 34,
      "text": "spar nu icke den unge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 34,
      "text": "spar nu icke den gamle:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 34,
      "text": "lad thennem alle lige gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 34,
      "text": "de ere mig unde alle-sammen.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 35,
      "text": "Det vaar konge Kanselin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 35,
      "text": "hand kom der selin min:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 35,
      "text": "sin blod stomper,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 35,
      "text": "saa haffde de hannem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 36,
      "text": "\"Stat op frue Kremolt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 36,
      "text": "du skynd de vnder aff mig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 36,
      "text": "der staar tre saa friske helt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 36,
      "text": "de hugger saa friskelig.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 37,
      "text": "\"Eyvred, eyured,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 37,
      "text": "søster Kremol:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 37,
      "text": "mig hug saa dybbe vnder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 37,
      "text": "du varst mig aldri god.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 38,
      "text": "Vosen alle de stunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 38,
      "text": "de dage, der ieg hid red:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 38,
      "text": "ieg hug saa dybe vnder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 38,
      "text": "det vaar mig saa saare emod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 39,
      "text": "Ieg haffuer mig foruoget",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 39,
      "text": "siu natter oc siu dage:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 39,
      "text": "aldri der nu søffn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 39,
      "text": "i min øyen kom.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 40,
      "text": "Oc haffuer ieg mig forloffrit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 40,
      "text": "saa ynckelig en kiff:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 40,
      "text": "min gode suerd er bort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 40,
      "text": "saa kiert som mit eget liff.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 41,
      "text": "Det suarede unge Obbe Iern,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 41,
      "text": "hand stod hannem alt saa nær:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 41,
      "text": "\"Ieg skal giffue dig min suerd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 41,
      "text": "min broder haffde saa kier;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 41,
      "text": "mig tyckis, du est en hellet skyen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 41,
      "text": "i-hueden du kommen est.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 42,
      "text": "\"Ieg tacker dig, unge Obbe Iarn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 42,
      "text": "du est en kempe saa rig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 42,
      "text": "ieg oc alle mine brøder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 42,
      "text": "wi vil dig for brøder staa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 42,
      "text": "ehuor du oss til-siger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 42,
      "text": "du maatte der lide paa.\"",
      "part": false,
      "marginal_notes": []
    }
  ]
}