    "title": "Een ny handbog med Psalmer oc aandelige lofsange",
    "year_published": 1529,
    "publisher": "Ludwig Dietz",
    "printer": "Ludwig Dietz",
    "place": "Rostock",
    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/dietz-salmebog-1529/5/2"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "LOffuit wære tw Jesu Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "att tw menniske worden æst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "fød aff een Jomffru reen oc klar:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "thÿ glæder seg alle Engle skare",
      "part": false,
      "marginal_notes": [
        "Luce. ij."
      ]
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Kyrioley.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Guds ewige faders eniste søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "er fød for oss till stor trældom/",
      "part": false,
      "marginal_notes": [
        "Phil. ij."
      ]
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "wor krenckelig natur han paa seg tog/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "ther ÿ klædde seg thet ewige gode",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Kyrioley.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Then som all werden skal frelse aff nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "ligger ÿ thet Jomffruelig skød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "han er eet barn saa lidet oc kleint/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "som himmel oc iord opholder alleen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Kyrioley.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Thet ewige liwss gaar nw herind/",
      "part": false,
      "marginal_notes": [
        "Johan. j. viij. oc. ix."
      ]
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "som giffuer all werden eet nyt skÿn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "oc liuser mit om midnatis tÿd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "att wÿ kunde kende wor fader saa blÿd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Kyrioley.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "Gud faders søn een Gud aff artt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "eet dødeligt menniske han er worden snart/",
      "part": false,
      "marginal_notes": [
        "Luce. ij."
      ]
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "oc førde oss aff then iæmmerlig dall/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "oc giorde oss arwinge wdi himmerigs sall",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Kyrioley.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "Han er paa iorden kommen the arme/",
      "part": false,
      "marginal_notes": [
        "Math. xj."
      ]
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "att han wil seg offuer thennom forbarme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "oc thennom ÿ himmelen att giøre rÿge/",
      "part": false,
      "marginal_notes": [
        "Mat. xxij."
      ]
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "hans hellige Engle att wære lÿge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": "Kyrioley.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "Saadant monne han sÿne børn tilwende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "ther paa wÿ oc nw hans kierlighed kende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "Thÿ tacker hannwm all Christenhed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": "oc prÿse teg Gud ÿ ewighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 6,
      "text": "Kyrioley.",
      "part": false,
      "marginal_notes": []
    }
  ]
}