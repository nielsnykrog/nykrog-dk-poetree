{
  "id": null,
  "title": "191. Du hiertens fryd for rene sinde",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
