{
  "id": null,
  "title": "Esbern og Sidsel",
  "year_created": [
    1555,
    1559
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Jens Billes Håndskrift",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1559,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/BILL79.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Her eszbernn teiner j kongens gårdtt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "allty sa mangenn goder dagh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "hann | ffeszte hjnn stoltte Ionffru cjszzelle |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "konjngenn hanom for-lenijngh gaff |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: nu lenges mÿgh aff landenn tÿl mÿn | kerest | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Tii worre Samenn wtj Monit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "icke Mo-nett vdenn tho,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "her eszbernn drømer | enn drømm om nattenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "hann skülde aff | landenn ffar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": ":: nu l m u d l t k | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Woger op stalttenn fru Siitzelle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "j wender | eder hijtt tjl mjg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "wdaff mjn sterke | drøme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "da skall ieg Siige ffor eder |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": ":: n l m u d l t k | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Orloff well iegh aff ether Bedes",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "j ere | minn herttens-kerre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "ieg haffüer drømt | enn drøm j nadtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "ieg ma her icke | lenger werre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": ":: n l m. u d l t m k | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "Orloff well iegh ike wedtt eder spa-re",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "j ere mjnn eddeliige herre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "herre | güd lade eder Sa well att ffarre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "oc | alder anndtt iegh eder werre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": ":: n l | m u d l t k | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "Thet wor om enn sønd-dagh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "hann skülde | tell kiirken ffare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "hann hann ffor tÿll | Sjnn Sogenn-kiirke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "hann lÿusde | szjn fferre j laue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": ":: n l m ü d l t k | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "Hann for tiill Sjnn Sogenn-kiirke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "hann | lus siidt fer j laüe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "hand Badtt altt | the danne-folk",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": "att ede med segh i dagh |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 6,
      "text": ":: nu l m v. j l t m k | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "Tÿ ade och thj drüke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 7,
      "text": "mød och thenn kl-areste wjnn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": "op stodt her esbernn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 7,
      "text": "och | helszer hann wener sÿnne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 7,
      "text": ":: U l M ü | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 8,
      "text": "Er her Nogenn danne-folk",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 8,
      "text": "Som iegh | haffüer gordtt ÿ-modtt tell menn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 8,
      "text": "j he-ffuer dett paa migh sell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 8,
      "text": "ike paa thenn | liille-grenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 8,
      "text": ":: N l M v l t m k | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 9,
      "text": "Her eszbernn redtt tell skibett",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 9,
      "text": "hanum | ffülde Saa Megenn almue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 9,
      "text": "alder kam | ffru Siitzlliilles hüijd handtt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 9,
      "text": "aff her | eszberns Sadell-büe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 9,
      "text": ":: n l m v l | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 10,
      "text": "Hun lade Sjnn arm om hans hals",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 10,
      "text": "hun | vär med guld lest",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 10,
      "text": "rade dett gud-fader | j himeriigh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 10,
      "text": "nar att Wj skülle fyndes | her nest",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 10,
      "text": ":: n l m v l t m k | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 11,
      "text": "Rade thet güd-ffader j hiimeriige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 11,
      "text": "Nar | wÿ skulde findes bradtt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 11,
      "text": "Mjnn here | och iegh vor met eders Barnn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 11,
      "text": "om thet | en Sa ware,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 11,
      "text": ":: n l m v l t m k | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 12,
      "text": "Hann agtte Segh ike Bordt att Were |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 12,
      "text": "j wintter fflere enn en",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 12,
      "text": "thet wor fuld | XV",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 12,
      "text": "for hand kom hem jgenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 12,
      "text": ":: n l m | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 13,
      "text": "Hann stodtt pa thenn helliigh graff |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 13,
      "text": "ffor Meszenn wor god att høre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 13,
      "text": "Saa | kom han sjn kerre j hüen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 13,
      "text": "Som | han wor wandt att gøre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 13,
      "text": ":: n l m v | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 14,
      "text": "Herr esbernn tager skrepenn paa | Sjnn Bagh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 14,
      "text": "peg-staff vdj Sjn | hand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 14,
      "text": "geste han Sjn Moder-Broder |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 14,
      "text": "enn Iulle-afftenn att qüelde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 14,
      "text": ":: n l m | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 15,
      "text": "Her Peder hann Sette Siidttt folk | tÿll Bors,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 15,
      "text": "aldtt som hann kund | Beszt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 15,
      "text": "for-vdenn hjn fattÿgh pÿle-grÿm",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 15,
      "text": "hann sattes wedtt dørren | nest",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 15,
      "text": ":: n l m v l t m k | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 16,
      "text": "Her Peder hann skenker bade Mød | och wjnn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 16,
      "text": "met hujde Beger aff hande |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 16,
      "text": "driik nu ffattiigh pellegrim",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 16,
      "text": "njus | komenn aff fremde lande",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 16,
      "text": ":: n l m v | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 17,
      "text": "Nÿues er igh komenn aff fremde land |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 17,
      "text": "nÿues er iegh komenn her",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 17,
      "text": "huor ma | staltte Siiszellÿlle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 17,
      "text": "hüor gemer hun | Sjnn erre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 17,
      "text": ":: n l m v l t m k | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 18,
      "text": "Well ma stalttenn ffru siittzelle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 18,
      "text": "Sa | uell gemer hun Sjn ere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 18,
      "text": "wor iegh | konjngh j thett landtt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 18,
      "text": "en krone skulde | hun Berre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 18,
      "text": ":: n l m v l t m k | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 19,
      "text": "Süarde thet stolttenn ffru Ingeboriigh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 19,
      "text": "med | tügtt och heder och erre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 19,
      "text": "wiill j mÿgh | j høgett-lofft fjulde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 19,
      "text": "iegh uell eder saa | hederliige klede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 19,
      "text": ":: n l m v l t m k | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 20,
      "text": "Haffüer tack stoltenn ffru engeboriigh |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 20,
      "text": "altt far eders mogett ere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 20,
      "text": "altt ta skall | mjn Sjszellejlle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 20,
      "text": "migh Se j mjn piillegrj-ms-kleder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 20,
      "text": ":: n l m v d l t m k | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 21,
      "text": "Her peder hann riider for Slottett indt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 21,
      "text": "hand wor well suøbtt j skjnn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 21,
      "text": "vde stodt | fru siiszelle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 21,
      "text": "njues komenn fra kjrkenn | hem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 21,
      "text": ":: n l m v d l t m k | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 22,
      "text": "Vell-komenn her peder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 22,
      "text": "och kerre bro-der mjnn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 22,
      "text": "huad er eder tiill møde | laudtt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 22,
      "text": "huj geste j migh nu j dette | Sjnde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 22,
      "text": ":: n l M v d l t m k | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 23,
      "text": "Thett Süarde her peder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 23,
      "text": "hann wor | well Süøbtt j skjnn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 23,
      "text": "och iegh haffuer | slagett Mand j-hell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 23,
      "text": "och tett er szorgen | mjnn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 23,
      "text": ":: n l M j land t m k | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 24,
      "text": "Her esbernn har pjgstaffuen j sjn | hand",
