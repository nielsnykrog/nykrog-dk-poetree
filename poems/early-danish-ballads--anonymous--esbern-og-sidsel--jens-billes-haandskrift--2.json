      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 32,
      "text": ":: n l m v l t m k | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 33,
      "text": "Nu haffuer Stolttenn Siitzelle",
