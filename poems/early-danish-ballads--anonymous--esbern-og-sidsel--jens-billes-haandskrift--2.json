      "id": 166,
      "stanza_id": 33,
      "text": "for-wn-dett bade angest och harm",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 33,
      "text": "hun soffuer | nu Sa gladeliigh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 33,
      "text": "altt j her essberns | arm",
