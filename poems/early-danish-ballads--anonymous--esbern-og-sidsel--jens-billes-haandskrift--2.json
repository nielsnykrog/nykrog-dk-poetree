      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 24,
      "text": "hann stor vnder høgloffts-sualle |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 24,
      "text": "hann bleff j sytt hertte gladtt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 24,
      "text": "han | hørd Sjnn kereste talle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 24,
      "text": ":: n l m v | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 25,
      "text": "Stoltt siitzelle Sette sjtt folk tell | Bors,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 25,
      "text": "altt Som hun kunde best |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 25,
      "text": "for-vdenn hjn fattjgh pellegrjm |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 25,
      "text": "hann Sattes vett dørrenn nest |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 25,
      "text": ":: n l m j l t | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 26,
      "text": "sztoltt Siitzelle skennchtte Bade mød | och wjnn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 26,
      "text": "mett hujde beger pa hænde |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 26,
      "text": "drjck nu fattiigh pellegrjm",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 26,
      "text": "njues | kamenn aff fremde lande",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 26,
      "text": ":: n l m j | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 27,
      "text": "Njues er iegh komenn aff fremde land |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 27,
      "text": "njues er iegh kamenn her",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 27,
      "text": "well j lanne | mjgh hus j natt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 27,
      "text": "altt ffor her esbernn | Sell",
