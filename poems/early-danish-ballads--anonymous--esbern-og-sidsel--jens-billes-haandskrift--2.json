    },
    {
      "id": 139,
      "stanza_id": 27,
      "text": ":: n l m j l t m k | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 28,
      "text": "Tha Blegnett ffru siitzelliille",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 28,
      "text": "altt vnder | sjnn skarlagenn-skjnn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 28,
      "text": "och kende | j her esbern",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 28,
      "text": "kerre herre Mjnn |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 28,
      "text": ":: n l m j l t m k | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 29,
      "text": "Hann kaszte skrepenn pa sjnn Bagh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 29,
      "text": "pÿ-ghstaffuenn aff sjnn hand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 29,
      "text": "vor hand en | arm horenn-Sønn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 29,
      "text": "ther segh nu døller | lenger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 29,
      "text": ":: N l M v j l t k | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 30,
      "text": "Stoldtt siitzelle szette sjtt folk tell bors |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 30,
      "text": "altt Som hun künde best",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 30,
      "text": "satte hun | her esbernn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 30,
      "text": "Segh Selffuer nest",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 30,
      "text": ":: n lm | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 31,
      "text": "Thett vor ffru siiszelle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 31,
      "text": "hun kaller att | Suene tho",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 31,
      "text": "Beder j kiistjnn mjn kerre | datter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 31,
      "text": "j bede hende j stoffuenn gaa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 31,
      "text": ":: n l m v d l t m k | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 32,
      "text": "Beder j kiirstiin mynn datter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 32,
      "text": "y stoffuen | gaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 32,
      "text": "hun er nu fuld XV ar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 32,
      "text": "hun aldriig | Sjnn fader Sa",
