  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "CHristus Jesus for oss offrid /",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "then loffue wÿ alle Christne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Guds lam haffuer igienløøst sÿne faar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Christus vskyldig haffuer forlÿgt Gud fader oss alle syndere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Død oc lÿff haffue nw strid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "lÿffzens høffding som war død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Christus nw leffuer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "altÿd skall regnere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Sig oss nw Maria/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "hwad tw haffuer paa wæyen seet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Jeg saa then leffuendis Christi graff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Oc ieg saa hans ære som war opstanden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Jeg saa Guds Engle oc iordeklæder till witnesbyrd: Christus wort haab wist opstanden er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "oc han skall eder møde ÿ Galilea.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "Marie rette witnesbyrd er fast meere troligt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "en alle Jødernis falske ord oc løgen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "Wÿ thet sandelig wÿde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "att Christ stod op aff døde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "o Christe Konning forbarme teg offuer oss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 5,
      "text": "Alleluia.",
      "part": false,
      "marginal_notes": []
    }
  ]
}