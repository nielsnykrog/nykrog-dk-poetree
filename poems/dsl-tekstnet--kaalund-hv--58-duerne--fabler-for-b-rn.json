  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Duerne sidde paa Husets Tag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "kurre i Solen den lange Dag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Da kommer lumsk den blodige Glente,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "vil sig en Steg mellem Duerne hente,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "svæver paa mægtige Vinger i Sky,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "stiger og synker og stiger paany.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Skytten sigter og skyder: Paf!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Ej, hvor blev da den Røver af?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Truffen han sank til Jorden med Hast.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Skytten ham nagled paa Muren fast,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Andre hans Lige til Varsel og Spot -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Nu kunde Røveren ha'e det saa godt.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
