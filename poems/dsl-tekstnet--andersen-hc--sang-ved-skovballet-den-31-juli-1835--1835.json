{
  "id": null,
  "title": "Sang ved Skovballet den 31 Juli 1835",
  "year_created": 1835,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
