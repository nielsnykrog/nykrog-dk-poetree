  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Af Samlede Skrifter. Tre Og Tredivte Bind",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1876,
    "url": "https://tekstnet.dk/books/andersen-hc_af-samlede-skrifter-tre-og-tredivte-bind/024/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Gamle Gunhild fra »Barselstuen,«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Boer paa fjerde Sal hos Fruen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Omme i Sanct Gertrudsstræde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Dit Besøg vil hende glæde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Hun kan Fremtids Syn Dig skaffe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Hun kan spaae i Kaart og Kaffe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Hun er klog, det gamle Skarn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Jeg er hendes Barnebarn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Tro paa Ingen, ei Dig selv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Godt Humeur Du prise!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "»Lystig hen ad Livets Elv!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Være din Devise.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Klæd Dig ikke i Rødt, ikke heller i Blaat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Men altid i Lilla, saa gaaer det Dig godt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Gjør Ægteskabs Tilbud i Dags-Avisen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Men tag kun Den, som har Pengegrisen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "Thi Penge – Penge – Du kan troe mit Ord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "Penge blev en Magt paa denne Jord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Gaa til Theatret! – ved Himlens Stjerner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Du bliver en Guldmynt, jeg sværger ved Berner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "Du fylder Kassen med Ører og Kroner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "Du løber op til selv Millioner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "Vælg denne Bane – gaa ikke i Spaaner!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "»Natten lang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "Dands og Sang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "Til Musik og Bægerklang!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "Det for Dig er Livets Gang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "Nu er Du paa Maskerade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "Og det paa Højbroplads;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": "Imorgen paa Østergade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "Saa er Du Lykkens Mads.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "Du er Poet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "Du er Prophet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 7,
      "text": "Du er En, jeg aldrig har seet;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 7,
      "text": "Men fra Hoved til Fødder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "Er Du proppet med Lykkens Nødder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "Der voxer for Dig, – ja vær Du glad!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 8,
      "text": "– En Kjærest paa hvert et Veibredblad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "Nu faae vi Vinter, nu fyger Sneen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "Stormen suser fra Nordkap til Hveen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "Men Du skal faae, til Kulden har Ende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 9,
      "text": "Penge nok til Kul og til Brænde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "Mig Gamle spørger Du Unge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "Hvad Skjæbne Dig forestaaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "»»Pyt«, sagde Peer til Kongen!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 10,
      "text": "Ja det er det Svar, Du faaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "Mandag være Dig Mærke-Dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "Paa den skal Du heise dit Bryllupsflag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "Naar Vaaren rider Sommer i By,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "Faaer Du en Hat af Silke – eller Bly!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 13,
      "text": "Jeg føler dit lille Hjerte dikke –!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 13,
      "text": "Jeg spaaer Dig – nei, jeg siger det ikke!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 14,
      "text": "Naar Skoven bliver grøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 14,
      "text": "Opfyldes dit Hjertes Bøn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 15,
      "text": "Du finder din Lykke i Kjøbenhavn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 15,
      "text": "Naar Du løber Fastelavn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 16,
      "text": "Du skal ikke troe al Snik og Snak,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 16,
      "text": "Tænk, det er Løgn, og siig – mange Tak!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 17,
      "text": "Dig Laurbær og Myrthe er skaaret;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 17,
      "text": "Hvad klæder Dig bedst i Haaret?",
      "part": false,
      "marginal_notes": []
    }
  ]
}
