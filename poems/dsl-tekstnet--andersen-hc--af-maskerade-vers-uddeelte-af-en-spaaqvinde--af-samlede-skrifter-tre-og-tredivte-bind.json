{
  "id": null,
  "title": "Af Maskerade-Vers, uddeelte af en Spaaqvinde",
  "year_created": 1876,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
