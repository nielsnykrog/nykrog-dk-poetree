  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "I hendes Hjerte varmt og mildt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Min Fremtids Skjæbne den bor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Den være Jammer, være Lyst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Snart kalder den frem mit Ord;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Paa hendes Læbe frisk og rød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Den viser sig da for mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Med Harmblik eller med venligt Smil -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Og daler saa over mig.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
