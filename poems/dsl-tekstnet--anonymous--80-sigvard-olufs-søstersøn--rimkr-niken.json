  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "I myn tijd en dæding wor giorth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "mellom danskæ oc franskæ som ær wel sporth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "tha danskæ hade i halfiærdesynne tiwe aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Men tij aar hadde ieg Danmark styrdh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "tha danskæ men the hadde meg myrdh.",
      "part": false,
      "marginal_notes": []
    }
  ]
}