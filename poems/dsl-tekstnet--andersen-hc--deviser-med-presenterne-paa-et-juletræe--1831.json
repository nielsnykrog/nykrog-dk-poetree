{
  "id": null,
  "title": "Deviser med Presenterne paa et Juletræe",
  "year_created": 1831,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
