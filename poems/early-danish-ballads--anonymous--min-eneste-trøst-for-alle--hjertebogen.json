  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Myn eniste trøst for alle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "som ald myn glede haffuer y wold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "thu wylt meg ycke vndfalle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "thett beder yeg teg gandske mangefold;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "end-dog then klaffer hand woller thett metth sin list,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "att yeg ycke hosz deg monnhe were,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "daa andt ieg teg well, och thett er wist,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "bode y dyd och ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Huad kunne wy ther-tiill giøre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "att thett fortrider saa mange mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "att thy thett nu skulle høre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "att wy huer-annhen wel and;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "wy wylle dog aldrig anneth giørhe eller tencke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "end huad som eren hører tiill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "myth hierte wyll ieg teg skencke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "thett were seg y-modt eller medt y-huem thett wyll.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Motte yeg ydelig hosz tegh were,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "hiert-aller-kierste myn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "thett war myn største begiere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "och bleff myth hyarte løst aff piin;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "huilcket yeg hobis bode dag och natt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "att myn sag motte bliffue god,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "och yegh motte finne teg brat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "saa finge myn sorrig godt bod.",
      "part": false,
      "marginal_notes": []
    }
  ]
}