  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Deroppe bag den høje Allé",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "man kan den prægtige Herregaard se,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "dér holdes Baller og rige Fester,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "dér komme og gaa de pyntede Gjæster;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "men nede gjennem Alleen gaar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "den fattige Pog med sin Husbonds Faar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Han fløjter og tænker paa Ingenting. -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Dog sælsomt vender sig Lykken omkring;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "den Dreng blev med Tiden en Herremand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Ej skammed han sig ved sin fattige Stand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "men hængte højt i sin Sal til Skue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "sine Træsko med samt den røde Hue.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
