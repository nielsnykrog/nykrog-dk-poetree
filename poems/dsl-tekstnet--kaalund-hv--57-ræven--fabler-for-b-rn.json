  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Ræven lister sig til sin Hule:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Nu er det nok Tid, at jeg maa mig skjule;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "i Østen glimter alt Dagens Spor.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Saa smutted den ned i den sorte Jord;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "der skrege og græd med arrige Tunger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "de smaa rødhaarede Ræveunger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "I Middagens Hede de fik dog Lov,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "at lege lidt ved den kølige Skov.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Men Rævemoderen spejdede rundt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "at Ingen skulde forvolde dem Ondt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "til Jorden hun lyttende Øret pressed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "mens Ungerne valsed omkring i Græsset.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
