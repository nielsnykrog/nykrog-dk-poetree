  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Farvel, Prindsesse Dagmar! Du gaaer til Storhed og Glands.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "En Keiserkrone groer der jo i din Brudekrands.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Gud lade sit Solskin lyse i Dig og dit nye Hjem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Da blive til Perler de Taarer, som Skilsmissen nu kalder frem.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
