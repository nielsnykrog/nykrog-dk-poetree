  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "IEsu som er vor salighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "all vor attraa oc kerlighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Allis vor Gud oc skabere blid",
      "part": false,
      "marginal_notes": [
        "Joan. i"
      ]
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "som tog mandom sist i verdens tid",
      "part": false,
      "marginal_notes": [
        "Col i"
      ]
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Huilcken miskundhed dig offuerwand /",
      "part": false,
      "marginal_notes": [
        "Gala. iiii Esai. liii"
      ]
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "ath du saa drogst vor syndens band/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Den grumme død wilde du lide/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "ath wi motte den euige død quit bliffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Det helffuede monne du igennem gaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "dine fanger dw frelste saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Jgengangen til din faders land/",
      "part": false,
      "marginal_notes": [
        "Mat xvi Esaie liii"
      ]
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "der sider du hoss hans høgre hand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Din godhed tuingde dig saa stercke lige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "vor synd du barst tolmodelige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "wi bede giff oss den euige ro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Ath wi dig see oc hoss dig bo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Den som aff døden opstanden er/",
      "part": false,
      "marginal_notes": [
        "Mathei xxviii Joan xx"
      ]
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "hannem ville wi loffue prise och ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Met fadere oc den Helligand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "som sin rene ord kundgør i alle land",
      "part": false,
      "marginal_notes": []
    }
  ]
}