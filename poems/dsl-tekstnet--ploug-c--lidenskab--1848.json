  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Siig, kjender Du det syge Barn, der vil, det veed ej hvad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Der brister pludselig i Graad og atter smiler glad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Der griber graadig efter Alt og kaster hvad det faar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Der higer bort fra Arm til Arm og ingen Hvile naa'r ?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Siig kjender Du det vilde Dyr, der raser i sit Bur,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Og selv sin Pande slaar tilblods imod den haarde Mur,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Der bider i det sejge Jern med Praade om sin Mund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Men for et Blik sig lægger ned, saa lydigt som en Hund?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Siig, kjender Du den Tankegang, der drejer sig omkring",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Den samme Gjenstand Dag og Nat i stedse mindre Ring,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Der surrer som en dristig Myg om Lyset, der blev tændt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Og styrter endelig til Jord, beskæmmet og for brændt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Siig, kjender Du det Hjerteslag, saa stormende og kjækt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Der skyller hver en Skranke bort og løfter hver en Vægt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Der stiger som et oprørt Hav og skjuler Himlens Lys,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Og glattes som en frossen Flod i Dødens Kuldegys ?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Nej, Gudskelov, din unge Sjæl har ikke maalt endnu",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Den Dybde, Lidenskaben har af Salighed og Gru.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Du drømmer som en Blomsterknop i Morgensolens Skin;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "Jeg kæmper som et tumlet Skib med Stormen i Sind.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
