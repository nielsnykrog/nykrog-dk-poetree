  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Jeg er klippet, jeg er umaadelig fin,",
      "part": false,
      "marginal_notes": [
        "Speaker: Pudelen:"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "afvejen, Du smudskede Gadesvin!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Jeg har Knebelsbarter, som Hvermand sér,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "jeg er Standsperson, jeg er Officer. -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Men Trofast svared igjen: Saa Skam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "mig synes, Du ligner et Paaskelam!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Det kunde Pudelen ikke taale. -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Først monne de lidt hinanden maale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "saa rendte Trofast Pudlen omkuld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "og napped af den en stor Tot Uld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Ej! raabte han, da den satte Farten:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Mig synes, Du glemte Knebelsbarten!",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
