{
  "id": null,
  "title": "Den genfundne Søster",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA83.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Ther war en greffue y Saxenland,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hand haffde en datter, en lily-wand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": ":: Thy huiltis op-vnder Øland. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Hand haffde icke døtter for-uden ienn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "icke haffde hand helder for-vdenn en sønn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "Vdenn en sønn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Her Siedellfaar saa hiede den sønn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "och Isemuor hedde den iumfru skønn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "Først døde hand greffuen vnder ø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "saa døde griff-inden, thett wor stuor nød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "Her Siedellfaar med den lily-wand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "saa iiene styritt dy dieris faders land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 4,
      "text": "Her Siedellfar skulde till Rum faar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "hans søster skulde werre hieme och tage landitt waare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "Kong Hagen hand seglett seg vnder ø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 5,
      "text": "Seg vnder ø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "saa staald hand borrtt den wiene møø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "Her Sedelfar kaam fraa Rum och hiem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "borrtte wor staalitt hans søster saa wenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 6,
      "text": "Bortte waar hans søster saa dydefuld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "hand skattitt hynder for ald werdsens guld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 6,
      "text": "Kong Hagen hand førde hynder hiem till synn land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 7,
      "text": "Hiem till synn land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "saae feck hand hynder syn droning y hand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 7,
      "text": "\"Her haffuer du en lyly-wand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 7,
      "text": "den well wy gyffue wor sønn y haand.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 8,
      "text": "Wor sønn y haand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 8,
      "text": "Her Seellfaar hand luod liede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 8,
      "text": "buode om land och rige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 8,
      "text": "Her Selfaar hand lader werke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 8,
      "text": "suy sneker vd-aff rett styrke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 9,
      "text": "Vdaff rett styrke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 9,
      "text": "Thy three dy skulde till warnen werre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 9,
      "text": "thy firre thy walske kattuorr att berre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 9,
      "text": "Seleff liette han til lande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 10,
      "text": "Til lande",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 10,
      "text": "buode med sorig och waande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 10,
      "text": "Thy red igiemell kong Hagens gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 10,
      "text": "vd stuod droning Ellend, wor suøbtt y mord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 11,
      "text": "Suøbtt y mord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 11,
      "text": "\"Hel stander y, droning Ellind, fuor och fynn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 11,
      "text": "ret aldrig suoo ieg saa høffsk en quind.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 11,
      "text": "\"Ind haffuer ieg enn iumfru hoss meg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 12,
      "text": "Iumfru hoss meg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 12,
      "text": "hun er thusen fold skønner ind ieg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 12,
      "text": "\"Thøll mark røde guld giffuer ieg eder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 12,
      "text": "att y lader meg den iumfru siee.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 13,
      "text": "Den iumfru siee.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 13,
      "text": "Droningenn ganger till burre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 13,
      "text": "hun wecker op Isemuor saa prude.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 13,
      "text": "\"Du statt op, Ismor, och kled thu theg!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 13,
      "text": "y afftten skalt thu skenke wynn for meg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 14,
      "text": "Skenke wynn for meg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 14,
      "text": "\"Ike løster meg att skencke gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 14,
      "text": "for-vden kong Haagenn selleff hieme waar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 14,
      "text": "For-vden kong Haagenn selleff hieme waar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "och helder myn broder her Sedellfarr.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 15,
      "text": "Her Sedell-farr.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 15,
      "text": "Ismoor gaar y burre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 15,
      "text": "ther kleder hun seg saa prude.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 15,
      "text": "Hun drog y en kiorttell skønn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 16,
      "text": "Kiorttell skønn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 16,
      "text": "well otte war skreder derrris suomer-søm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 16,
      "text": "Hun drog gulditt offuer guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 16,
      "text": "ald synn fynger denom satte hun fuld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "Iumfruen ind aff dørenn thrend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 17,
      "text": "Aff dørenn thrend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 17,
      "text": "hyndis øggen warr klaare, som som suollen skieen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 17,
      "text": "Hindis halsz war huid som hermelinn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "hindis mund wor rød som en robynn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "Her Sadell-far klaper paa hynde blaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 18,
      "text": "Paa hynde blaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 18,
      "text": "\"Seder nedder, skønn iumfru, och huiler her-paa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "I huiler, iumfru, paa hønde blaa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "och sigger meg, huor y er fød och bornn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "\"Y Saxenn er ieg fød och bornn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 19,
      "text": "Fød och bornn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "ther er all myn kleder skornn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "Ther bleff myn fader lagtt vnder maald,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "myn muoder døde, før-ind hønsenn gaall.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 19,
      "text": "Ieg haffde icke broder for-vden ienn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "For-vden ienn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "hand drog til Rom, kaam aldrig igen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "Chrest lade meg iesynd løffue den dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 20,
      "text": "att ieg matte finde myn broder glad.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 20,
      "text": "Hand klaper hynder wed huiden kiend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "Wed huiden kiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 21,
      "text": "\"Thu est allerkereste søster myn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 21,
      "text": "Hør du, Isemor, søster myn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 21,
      "text": "weltt du nu følge broder dyn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 21,
      "text": "Hun thog hanom y arum syn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 22,
      "text": "I arum syn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 22,
      "text": "\"Ieg følger deg gierne, kerr broder mynn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 22,
      "text": "Hand bød y dage, hand bød y thuo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 22,
      "text": "røde guld for den staltte iumfru.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 22,
      "text": "Den thid thett guld icke lenger wand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 23,
      "text": "Lenger wand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 23,
      "text": "thy thog denn fuolle, paa skuoffuen rand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 23,
      "text": "Thett melte dronning Ellind saa wene:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 23,
      "text": "\"Chrest giffue, kong Hagen war hieme!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 23,
      "text": "Haade kong Haggen weritt hieme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 24,
      "text": "Weritt hieme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 24,
      "text": "y førde hynder icke bortt saa ieen.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 24,
      "text": "Dy wonde op segell aff silke grønn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 24,
      "text": "her Segell-faar førrde syn søster hiem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 24,
      "text": ":: Thy huylttis op-vnder Øland. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}