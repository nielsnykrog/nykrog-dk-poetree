  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Hver Dag hun løb for Vinden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Her fik den hende fat;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Zephyren kysser Kinden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Og seer i Øiets Nat;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Nu leger han med Lokken,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Hun mærker Elskovs Gud –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Ak! hun kan ei naae Klokken",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Og Ilden er brudt ud!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
