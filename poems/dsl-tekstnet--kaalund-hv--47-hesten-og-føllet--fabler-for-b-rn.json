  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Moder, jeg længes, faar jeg ej Lov",
      "part": false,
      "marginal_notes": [
        "Speaker: Føllet:"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "snart til at bære Sko paa min Hov?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Daarlige Barn, en Træl vil Du være,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "højt paa din Ryg skal en Rytter Du bære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "følge hans Lune i Skridt og Trav. -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Ej, tænkte Føllet, jeg kaster ham af!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Føllet blev nu til Smcdien bragt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "fik sig Sko under Hovene lagt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "blev saa pyntet med Bidsel og Sadel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "fik sig en Herre af fornem Adel.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Hvad Moderen spaaede, blev dog opfyldt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "skjøndt Pisken var Silke og Sporen forgyldt.",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
