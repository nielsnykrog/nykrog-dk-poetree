{
  "id": null,
  "title": "Kongens Søn af Engeland",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift II",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVII4.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Kongens søn aff Engelland",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hannem skinner guld paa huiden haand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Hannem skinner guld paa saddelbue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Men børren bleser dennem vesten ind for Danmarck. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Hannem skinner guld paa saddelbue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "hand haffuer troloffuit saa stalt en iomfrue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Den kongens søn lader vircke en knar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Den kongens søn lader vircke en knar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "slig en kom aldrig paa landet føre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Hun vaar forgylt emellem begge bord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "Hun vaar forgylt emellem begge bord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "der paa stod screffuet vaar herris ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Hun vaar forgylt emellem begge staffne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "Der stod screffuet i frammer staffn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "den kongens søn tog sin iomfru i faffn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "Foruden da stode de løffuer smaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "Foruden da stode de løffuer smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "huer anden vaar gul, huer anden vaar graa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "Vdj den skib der stod en mast.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 6,
      "text": "Vdj den skib der stod en mast,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "den haffde vel tusind nobel kaast.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 6,
      "text": "Vdj den mast der hengde en fløe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 7,
      "text": "Vdj den mast der stod en fløe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "slig en kam aldrig i vester-søe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 7,
      "text": "Hans ancker vaare alle aff røden guld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 8,
      "text": "Hans ancker vaare aff røden guld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 8,
      "text": "hans seile vaar alle aff agger-vld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 8,
      "text": "Huerend toffue, som der vaar inde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 9,
      "text": "Huerende toffue, som der vaar inde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 9,
      "text": "de vaare giord aff silcke-tuende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 9,
      "text": "Huerende toff oc huerende bom.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 10,
      "text": "Huerende toff oc huerende bom",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 10,
      "text": "de vaare slagen met iomfruens haand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 10,
      "text": "Den konge tager sin søn at lære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 11,
      "text": "Den konge tager sin søn at lære:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 11,
      "text": "\"Min kiere søn, du tenck paa ære!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 11,
      "text": "Du tenck paa heeder, du tenck paa ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 12,
      "text": "Du tenck paa heder, du tenck paa ære:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 12,
      "text": "du lad icke pendinge din herre være!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 12,
      "text": "Du spar icke sølff, icke røden guld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 13,
      "text": "Du spar icke sølff, du spar icke guld:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 13,
      "text": "du giff din suenne, som dig ere huld!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 13,
      "text": "Den konge fuld sin søn til strand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 14,
      "text": "Den konge fuld sin søn til strand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 14,
      "text": "oc ridder oc suenne skød hannem fra land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 14,
      "text": "Dens kongens søn tog paa sin hat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 15,
      "text": "Den kongens søn tog paa sin hat:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 15,
      "text": "\"Fader oc moder haffuer gode nat!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 15,
      "text": "Fader oc moder oc høffske quinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 16,
      "text": "Fader oc moder oc høffske quinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 16,
      "text": "Gud lade oss alle met gleden findes!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 16,
      "text": "The vaar icke kommen vden lidet fra land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 17,
      "text": "De vaar icke kommen vden lidet fra land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 17,
      "text": "da blesede der weir paa strand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 17,
      "text": "Da bleser der veyr oc mørcken sky.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 18,
      "text": "Da bleser der veir oc mørcken sky,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 18,
      "text": "the viste dennem huercken land eller ly.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 18,
      "text": "Saa kaste de deris ancker vd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 19,
      "text": "Saa kaste de deris ancker vd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 19,
      "text": "trediue vinther haffde lagd i skuld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 19,
      "text": "\"I danne-suenne i værer vel frøe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 20,
      "text": "I danne-suene i værer vel frøe!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 20,
      "text": "det er saa aff silcki giort.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 20,
      "text": "Hand hobtes da, det vaar vden fare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 21,
      "text": "Hand hobtis da, det vaar vden fare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 21,
      "text": "den herre tog paa en vise oc quad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 21,
      "text": "Oc det skede ind for midie-nat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 22,
      "text": "Oc det skeed ind for middi-nat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 22,
      "text": "det stercke tog ware i sønder rad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 22,
      "text": "Sat hand sig paa gyltene skrin.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 23,
      "text": "Hand sette sig paa gyltene skrin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 23,
      "text": "met sorrigfuld haand vnder blegen kind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 23,
      "text": "Det vaar stor ynck at see der paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 24,
      "text": "Det vaar ynck at see der paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 24,
      "text": "det skib sloges all i støcker smaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 24,
      "text": "Den herre hand kam dog leffuend til land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 25,
      "text": "Den herre kom dog leffuend i land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 25,
      "text": "gick sorgefuld paa den strand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 25,
      "text": "Den herre gick, hand klagede sig saare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 26,
      "text": "Den herre hand gick, hand klagede sig saare:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 26,
      "text": "\"Ieg tencker, ieg haffuer icke wretferdige vare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 26,
      "text": "Foruden en liden ganger rød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 27,
      "text": "Foruden en liden ganger rød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 27,
      "text": "den tog ieg fra en faderløss møe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 27,
      "text": "Vil det Gud, ieg kommer vel hiem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 28,
      "text": "Vil det Gud, ieg kommer vel hiem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 28,
      "text": "tha skal ieg giffue hende to for en.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 28,
      "text": "Ræt vdj det samme sinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 29,
      "text": "Ret vdj den samme sinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 29,
      "text": "da kam til land hans forgylte skrin.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 29,
      "text": "Der kam gangendis en kocke-dreng.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 30,
      "text": "Der kam gangendis en kocker-dreng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 30,
      "text": "hand giorde den herre saa staar wmeen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 30,
      "text": "Hand haffde met sig de suenne fem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 31,
      "text": "Hand haffde met sig de suenne ni,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 31,
      "text": "her Eske Frast hand vid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 31,
      "text": "Then kongens søn hannem rand taar paa kind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 32,
      "text": "Den kongens søn hannem rand taar paa kind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 32,
      "text": "\"Christ bedret mig, ieg kom for Bouberg ind!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 32,
      "text": "Ieg er kommen saa ilde at holde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 33,
      "text": "Ieg er kommen saa ilde at holde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 33,
      "text": "ieg er kommen i her Eski Frostis volde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 33,
      "text": "Haffde ieg kommen i Bugges løn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 34,
      "text": "Haffde ieg kommen i her Buggis løn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 34,
      "text": "da haffde mig røffuet huercken ridder eller suend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 34,
      "text": "Nu røffuet mig hans minste kocke-dreng.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 35,
      "text": "Nu røffuer mig hans mindste kocke-dreng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 35,
      "text": "ieg skal det heffne, om ieg kommer hiem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 35,
      "text": "Vil det Gud, ieg maa leffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 36,
      "text": "Vil det Gud, ieg maa leffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 36,
      "text": "ieg skal det for kongen aff Danmarcke sige.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 36,
      "text": "Saa snart som her Bugge de tidende faar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 37,
      "text": "Første her Bugge de tidende faar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 37,
      "text": "hand sender effter hannem sine sønner to.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 37,
      "text": "Hand sender effter hannem suenne fem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 38,
      "text": "Hand sende effter hannem suenne fem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 38,
      "text": "loed hente hannem snart til Haldt oc hiem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 38,
      "text": "Her Bugge vndfick den herre met ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 39,
      "text": "Her Bugge vndfick den herre met ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 39,
      "text": "de danske loed hannem til Engeland føre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 39,
      "text": "Ther bleff de vndfangen met ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 39,
      "text": ":: Men børen bleser dem vesten ind for Danmarck. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
