  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Digte",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1830,
    "url": "https://tekstnet.dk/books/andersen-hc_digte-1830/022/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "– – – Liebe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Kennt der allein der ohne Hoffnung liebt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Hulde Maane, stiig fra Skyen frem!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Solen hviler alt bag Laas og Lukke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Ak Madam, Madam, jeg elsker Dem!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Vær ei kold mod mine hede Sukke!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "De er bleg, og jeg er ligesaa;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Begge vandre eensomt vi og ene;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Hurtigt gaaer De hen af Himlens Blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Ogsaa jeg har gode, lange Bene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Er det sandt at Maanen trækker Vand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Vil jeg græde mig til Ægtemand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Hav mig naadig dog i Deres Sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Husk den Tid, da jeg var meget Lille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Da jeg spillet Skorsteen, Klink og Pind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Og fik Riis, skjøndt ei jeg have vilde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "De har Kundskab om mit Barndoms Liv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Jeg var god – en lille Sukker-Unge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Nu jeg er det i Superlativ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Men beskedent tier her min Tunge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "O Madam, Madam! kom ned til mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Eller ogsaa tag mig op til Dig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "De har hørt saa mangen Elskers Suk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Trøstet ham ved Deres kydske Flamme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Ak men mig, De svarer ei et Muk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Det er ikke kristeligt Madamme!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Gjerne sukked’ jeg for Dem paa Spansk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Men jeg er ei stiv i Grammatikken,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Ak, jeg mægter knap at tale Dansk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Hjertet synker ned i Kjole-Fikken.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Skjænker De ei snart mit Hjerte Ro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Vist jeg spiller Werther Nummer to.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
