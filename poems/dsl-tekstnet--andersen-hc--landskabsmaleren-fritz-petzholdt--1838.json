  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1838,
    "url": "https://tekstnet.dk/books/andersen-hc_landskabsmaleren-fritz-petzholdt/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Han fik en Konstner-Sjæl, som Faa den fik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Han kjendte dennes mørke Øieblik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Hvori den føler: Intet her er stort!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Et feilfuldt Værk er Alt hvad Du har gjort!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Ved er hans Grav. Men Stedet? Hvor?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Den golde Tidsel henad Jorden groer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Der intet Øie græd, da Kisten gleed;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Hans Hjertets sidste Suk – kun Gud det veed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Han følte Hjemvee paa en fremmed Strand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Døds-Snekken bar ham til hans Fædreland.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Vi see i Snekkens Seil, som did ham bringer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Et Liiglag’n kun, ham er det Svanevinger!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
