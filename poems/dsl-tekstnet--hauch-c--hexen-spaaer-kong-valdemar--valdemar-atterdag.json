  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Kong Volmer rider ved Maaneglands,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Ham standser en gammel Qvinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "»Vel mødt«, hun siger, »Du Danmarks Drot!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Alt under de susende Linde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Vel mødt«, hun siger, »Du Danmarks Drot!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Ved Maanskin og Midnatstide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Saa gjerne jeg Dig Din Skjebne spaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Ifald Du den lyster at vide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Saa gjerne jeg Dig din Skjebne spaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Du drages det vel til Minde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Ret aldrig Du træder saa vild en Sti,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "At ei Du skal Veien finde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Ret aldrig Du træder saa vild en Sti,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "At Du skal Veien glemme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Ret aldrig flyver en Fugl saa høit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Du kan den fuldtvel tæmme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Ret aldrig flyver en Fugl saa høit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "At ei Din Piil den naaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Og aldrig Du finder det krumme Jern,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Som ei Du at rette forstaaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Og aldrig Du finder det krumme Jern,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Som ei Du rette kan,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Og mødte Du Keiseren selv i Rom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "Du er saa god som han.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Og mødte Du Keiseren selv i Rom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Du er jo vel hans Lige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Der er ei den Ridder i Danmark til,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "Som ei for Dig maa vige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "Der er ei den Ridder i Danmark til,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Hvis Mod Du ei kan bøie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "I Alting er Dig Lykken god,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "Hvorhen Du vender Dit Øie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "I Alting er Dig Lykken god,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Dog Eet jeg vil Dig raade:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "Vend aldrig Din Hu til Slegfredqvind!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "Det bliver Dig ei til Baade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "Vend aldrig Din Hu til Slegfredqvind!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Hun bliver Dig til en Snare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "Og volder Dig Kummer og Sorg og Spee",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "Og sætter Din Sjæl i Fare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "Hun volder Dig Kummer og Sorg og Spee,«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Saa sang hun ved Midnatstid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "Da svared den Herre: »Jeg vel kan see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "Fru Helvig har sendt Dig hid.«",
      "part": false,
      "marginal_notes": []
    }
  ]
}
