  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "an En wisa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 1,
      "text": "Kunde iagh nu skriffua,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "alt effter mitt begiär",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "der till migh månde driffua",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "dän ånger j mitt hierta är",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "huru dett migh hårdeligh kränker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "så offta iagh betänker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "den föra gaman,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "huar medh annan",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "j äran hade till saman",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "ach när iagh begrundar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "den förra lust och frögdh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "mitt hierta då åstundar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "till gudh j himels högdh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "ach gudh hielp oss alla,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "som digh troligh åkalla",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "och j dänna stundh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "aff hiertans grundh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "ropa medh hierta och mun",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Regera mitt hierta och sine",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "du trogne herre gudh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "att dett sigh låter later fina,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "lÿdigh din helga budh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Att alt huadh wärden vpwäker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "dett migh aldrigh förskräker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "vthan att iagh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "effter titt behagh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "må leffua både natt och dagh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "I gudz fruchtan och ära,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "som huar bör hafua kiär",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "hiälp migh altidh att leffua,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "Emedan iagh j värden är",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "annama och medh fruchtan,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "din nådige tuchtan",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "som tu härre migh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "altidh nådeligh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "tillskikar så faderligh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "när man will besina,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "denne wärdenes osedh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "huadh kan man tå på fina,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "vthan ledes wedh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "denne wärden wrånga,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 5,
      "text": "som bedrager så många",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 5,
      "text": "medh sin falska seedh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 5,
      "text": "och högfärdh ledh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "så och medh gerighett",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 6,
      "text": "platt ingen trohett,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 6,
      "text": "nu är att litta på",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "vthan på gudz godhett,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 6,
      "text": "som trofast är och så",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 6,
      "text": "han hielper oss wist alla,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 6,
      "text": "om vÿ till honom falla",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 6,
      "text": "och är oss när,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "Effter wår begiär",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "han omsårgh för oss bär",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 7,
      "text": "En dåk iagh Eÿ må klaga,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 7,
      "text": "öffuer lÿckan är mig tungh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 7,
      "text": "j dese år och dagar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 7,
      "text": "vthan då iagh var vng",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 7,
      "text": "då dett begÿnte bliffua,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 7,
      "text": "som iagh bäst skulle leffua",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 7,
      "text": "vthÿ bästa flor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 7,
      "text": "och vthÿ glädie stor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "som wara kunde på jordh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 8,
      "text": "Rätt snart lÿckan sigh wände,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 8,
      "text": "vthÿ samma stundh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 8,
      "text": "som hon migh aldrigh kiände",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 8,
      "text": "iagh tänkte siucka till grundh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 8,
      "text": "för honn migh så månde suika,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 8,
      "text": "och så jfran migh wika",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 8,
      "text": "alt medh sin suik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 8,
      "text": "dårade hon migh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 8,
      "text": "så brukar hon än dageligh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 9,
      "text": "som hon sigh bäst betede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 9,
      "text": "att hon wille wara godh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 9,
      "text": "ett fall hon migh berede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 9,
      "text": "hon Eÿ länger hoss mig stodh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 9,
      "text": "vthan rÿgen till migh vände,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 9,
      "text": "och olÿckan till migh sände",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 9,
      "text": "som migh en långh tidh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 9,
      "text": "giorde hiertans quidh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 9,
      "text": "vthÿ min vngdoms tidh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 10,
      "text": "döden sigh månde laga,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 10,
      "text": "Rätt mÿckett hasteligh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 10,
      "text": "min moder jfrån migh taga,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 10,
      "text": "mormoder och broder snarlig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 10,
      "text": "så och den wän kiära,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 10,
      "text": "som migh älska och ära",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 10,
      "text": "för andra wist,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 10,
      "text": "vthan all list",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 10,
      "text": "der fans Eÿ någon brÿst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 11,
      "text": "o gudh huadh för quida,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 11,
      "text": "iagh då j hierta bär",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 11,
      "text": "och huadh iagh månde lida,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 11,
      "text": "iagh skulle leffua quar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 11,
      "text": "j sårgh och mÿcken möda,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 11,
      "text": "tÿ mina woro döda",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 11,
      "text": "gudh deres siäll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 11,
      "text": "beuare Euinerligh wäll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 11,
      "text": "både häll och säll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 12,
      "text": "tröst migh då sändes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 12,
      "text": "aff tigh herre jesu christ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 12,
      "text": "att mitt hierta wandes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 12,
      "text": "till tållemodh förwist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 12,
      "text": "tÿ tu hielper draga,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 12,
      "text": "det ock j alla dagar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 12,
      "text": "Ehuru hårdt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 12,
      "text": "och mÿckett suårt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 12,
      "text": "det tuingar hiertatt wårt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 13,
      "text": "Ehuru sigh nu wänder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 13,
      "text": "min lÿcka aff aller till",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 13,
      "text": "befaler iagh j gudz hender,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 13,
      "text": "o jesu war migh mildh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 13,
      "text": "war migh ett stadigt ankar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 13,
      "text": "Ehuart min hugh wankar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 13,
      "text": "giff migh tållemodh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 13,
      "text": "och war migh godh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 13,
      "text": "anama mitt liff och blodh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 14,
      "text": "Regera huss och wårdnat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 14,
      "text": "medh din milda handh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 14,
      "text": "dem migh äre förårdnatt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 14,
      "text": "iagh beder digh försan",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 14,
      "text": "att du will migh giffua,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 14,
      "text": "godh rådh och när migh bliffua",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 14,
      "text": "j mitt besuär",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 14,
      "text": "som stadight är",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 14,
      "text": "både fiäran och när",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 15,
      "text": "vndt migh o jesu blide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 15,
      "text": "din wärdige helige Andh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 15,
      "text": "som migh alla tider,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 15,
      "text": "leder medh sin handh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 15,
      "text": "j sin saningh den Rene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 15,
      "text": "digh beder iagh jesu allene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 15,
      "text": "räck migh tin handh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 15,
      "text": "och hielp migh försan",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 15,
      "text": "tu millde frälsar man",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 16,
      "text": "så befaller iagh nu tigh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 16,
      "text": "tu helige trefaldighett",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 16,
      "text": "och dett du migh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 16,
      "text": "giffuett haffuer och wist wett",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 16,
      "text": "att tu Effter titt behagh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 16,
      "text": "migh beuarar natt och dag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 16,
      "text": "ty allena på tigh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 16,
      "text": "förlåter iagh altidh migh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 16,
      "text": "nu och Euinerligh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 16,
      "text": "Amen",
      "part": false,
      "marginal_notes": []
    }
  ]
}