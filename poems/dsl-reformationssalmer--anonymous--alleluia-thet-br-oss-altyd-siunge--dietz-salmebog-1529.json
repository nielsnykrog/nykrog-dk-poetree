  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "ALleluia thet bør oss altÿd siunge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Herren loffue oc prÿse aff hiertens grunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Thÿ hans miskund haffuer wore synder alle vdslæt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "all kierlighed oc got haffuer han oss beteed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Alt thet som lÿff haffuer thet skall Gud loffue/",
      "part": false,
      "marginal_notes": [
        "Ephes. ij."
      ]
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "for hans megne miskund oc store naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "han haffuer oss giffuet wenskab/ styrcke/ lÿff oc krafft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "han haffuer forderffuit synd/ død oc all dieffuelsens macht.",
      "part": false,
      "marginal_notes": [
        "Ephesi. j."
      ]
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Gud haffuer them som tro paa hannwm iætt naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "wil thennom hielpe oc trøste ÿ all waade/",
      "part": false,
      "marginal_notes": [
        "Psal. cxliiij ij. Corint. j."
      ]
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "himmerigis rÿge wil han them alle giffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "thet holder han wist/ thÿ han kan icke liwe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "O Gud fader teg wære loff oc ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "med thÿn søn Jesu Christ wor frelser kiære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "desligest then Helliaand aff oss alle sammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "wÿ tacke teg nw oc ewindelig AMEN.",
      "part": false,
      "marginal_notes": []
    }
  ]
}