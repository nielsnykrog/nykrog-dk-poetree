  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Af Samlede Skrifter. Tre Og Tredivte Bind",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1876,
    "url": "https://tekstnet.dk/books/andersen-hc_af-samlede-skrifter-tre-og-tredivte-bind/020/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Det var Udstillingstiden paa Charlottenborg;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Alt var nyt, og Meget godt og deiligt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Et Billed greb mig: Ung og smuk stod ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Saa to unge Ægtefolk til Æsels,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "De rede hjem saa lykkelige begge To.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Og Munkens Ungdomssjæl og varme Tanke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Gjød Veemod over hele dette Skue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Man følte: kun et Hjerte maler Sligt. – –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Hvert Aar fremstod et nyt, et herligt Billed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Vi saae iblandt Philistrene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Vi saae , vi saae ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Livssmerten, Lunet just i sundt Humeur.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Nu kom . Sneen smelted bort",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Fra Mængdens Øine; hvilket Storheds Billed!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Hvor var jeg glad med hele Kjøbenhavn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Da saa vi mødtes, Du var, som jeg tænkte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "En Barnesjæl og dog saa mandig klog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Beskeden, tvivlende om egen Styrke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Og dog forvisset om din Guds Mission;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "Thi ellers aldrig kunde den fuldføres.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "Da fik jeg Dig saa kjær. Tag mine Blomster",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "Som Tegn paa Glæden og paa Hjertelaget!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
