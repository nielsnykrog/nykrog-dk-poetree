  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "BEnaade oss euige Gudt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "som haffuer alle Helgen naaden ted/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Frels tu oss O Jesu",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "for huilcke thu blefst till korsit ledt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Ladt oss gaa til all godheds kielde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Ladt oss een reen samuittigheds øghen stille paa thin welde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Lad oss then wÿsdoms drick ther faa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Aff huilcken wor hw kan then euige lÿffs smag forstaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Lad oss reth Christendoms troo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "bewise mett kierligheds gerninger modt wor nabo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Oc siden mett een affgang /",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "komme till teg wor Fader fraa all twang Amen.",
      "part": false,
      "marginal_notes": []
    }
  ]
}