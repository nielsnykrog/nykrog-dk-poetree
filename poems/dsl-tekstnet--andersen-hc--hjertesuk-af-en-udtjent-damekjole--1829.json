  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Der var en Tid, da jeg var ganske ny –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Ak ja! det var de gode gamle Dage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Da var jeg ogsaa med i denne By;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Men nu i Krogen hænger jeg tilbage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "I gyldne Sale svandt min Blomstervaar:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Nu skal maaskee jeg snart i bygge;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Hvor Krusemynterne bag Ruden staaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Jeg veier Livets Solskin og dets Skygge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Alt dreier Hanen sig paa Petri Spiir,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Snart briste i mig mine skjøre Traade –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Dog ei jeg døer, – forvandlet i Papir,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Jeg bliver – – ja, det er den store Gaade.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
