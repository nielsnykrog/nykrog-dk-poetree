{
  "id": null,
  "title": "3. Til Virkeligheden",
  "year_created": 1877,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Vilhelm Kaalund",
    "country": null,
    "wiki": "Q2362214"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "En Eftervaar. Digte",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1877,
    "url": "https://tekstnet.dk/books/kaalund-hv_en-eftervaar/003/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Min Tugtemester, min store Lærer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "min Hyldest jeg Dig i Sang frembærer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Alt dengang jeg blev fra Brystet vænt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "jeg tror, mit Forhold til Dig var spændt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Du tog min Kjæphest, min Top og Trille.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Jeg maatte jo taale det! jeg var den Lille.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Der vanked Buler, der vanked Stød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "og Du var saa haard og jeg saa blød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Og alle de Huse af Kort, jeg rejste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "de faldt overende, som bedst de knejste;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "det var Dig, det var Dig, som rev dem omkuld!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Hvor kunde Du være saa ondskabsfuld?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Jeg havde drømt Dig foruden Skygge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "en straalende Verden af Lys og Lykke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Jo mere jeg voxed, jo mere jeg saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Du var ikke rigtig at stole paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Jeg vilde lege og juble i Solen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "men de trak mig fra Legen afsted til Skolen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Dér satte de mig paa den haarde Bænk",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "og sagde: \"Bryd nu dit Hoved og tænk!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "Og jeg tænkte og svedte og pinte min Hjerne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "for at finde blandt Skallerne Kundskabens Kjerne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "Men det Meste var Skaller og Avner, jeg fandt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "Jeg syntes, jeg tabte langt mér, end jeg vandt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "Derude - derude slog Fuglen sin Trille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "dér sprudled jo Livsglædens herlige Kilde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "Jeg maatte derud for at prøve mit Mod -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "der var Ungdom og luende Ild i mit Blod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "Saa jog jeg afsted over Bjerge og Dale",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "for at gribe den flygtende Fugl ved dens Hale;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "men jeg mærked det snart, jeg var kun dens Gjæk:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "naar jeg kom, hvor den sad, da var altid den væk.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 0,
      "text": "Af Roser, af Roser vel tusind jeg plukked;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 0,
      "text": "men tilblods blev jeg revet, tilblods blev jeg stukket.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 0,
      "text": "Der var Fald for min Fod, der var Sten paa min Sti,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 0,
      "text": "og Nøden i Pjalter mig humped forbi.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 0,
      "text": "Og jeg skulde trælle og være din Slave",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 0,
      "text": "i saadan en Verden, bedækket med Grave!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 0,
      "text": "Nej aldrig! aldrig! - Jeg bød Dig Trods!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 0,
      "text": "Hvem var den Stærkeste vel af os?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 0,
      "text": "- Saa toge vi To et Tag med hinanden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 0,
      "text": "om hvem af os der var Overmanden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 0,
      "text": "Det var mig, der vakled, og Dig, der stod;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 0,
      "text": "jeg kunde ej rokke din faste Fod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 0,
      "text": "Jeg vilde Dig i mine Arme hæve,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 0,
      "text": "men følte i Afmagt mit Knæled bæve.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 0,
      "text": "Jeg søgte i Luften et Støttepunkt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 0,
      "text": "men Arbejdet blev mig dog altfor tungt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 0,
      "text": "Din blev da Sejren - jeg maatte vige -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 0,
      "text": "men Hersker jeg var i mit eget Rige!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 0,
      "text": "Jeg var jo født med et Scepter i Haand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 0,
      "text": "en Evighedsarving, en fribaaren Aand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 0,
      "text": "og ejed det stolteste Kongedømme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 0,
      "text": "som nogen Fantast har sét i Drømme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 0,
      "text": "en Verden - ikke som din af Muld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 0,
      "text": "men straalende lys og underfuld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 0,
      "text": "Dér flygted jeg ind og lukked hver Sprække,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 0,
      "text": "dér skulde ikke din Arm mig række!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 0,
      "text": "- Men som en Kreditor barsk og raa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 0,
      "text": "Du stod derude og bankede paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 0,
      "text": "Det hjalp kun lidt, at jeg stopped mit Øre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 0,
      "text": "jeg kunde din Kalden derude høre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 0,
      "text": "\"Luk op, Du Daare! luk Livet ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 0,
      "text": "og giv mig dit luftige Hjernespind!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 0,
      "text": "Og jeg gav Dig det Alt! Jeg bad ej om Naade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 0,
      "text": "men aabnede Porten saa højt, jeg formaaede!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 0,
      "text": "Og det var, som faldt fra mit Øje et Bind -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 0,
      "text": "jeg bød Guds Verden et frejdigt \"Kom ind\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 0,
      "text": "med dens Skygge og Lys, dens Sorg og dens Gammen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 0,
      "text": "og jeg synes, nu passe vi herligt sammen!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 0,
      "text": "Og tager den stundom ej paa mig blidt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 0,
      "text": "og synes for tung mig dens Lærdom tidt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 0,
      "text": "og skotter endnu jeg som Barnet til Riset",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 0,
      "text": "og drømmer imellem om Paradiset,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 0,
      "text": "og kan ikke rime det Alt, hvad sker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 0,
      "text": "med mine ønsker og mine Ideer -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 0,
      "text": "jeg tænker, jeg faar det vel nok til at passe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 0,
      "text": "naar jeg rykker op i en højere Klasse!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
