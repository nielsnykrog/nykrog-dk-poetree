{
  "id": null,
  "title": "Svend Vonved",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Rentzells Håndskrift",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/RNZ13.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Suend Normand seder y bure,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hannd slor guld-harpenn prude.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": ":: Se diig udtt, Suend Normandtt. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Hand slor guld-harpenn unnder skindtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "hans moder kom der ganngenn indtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "Ind kom hans moder Adelin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "hun motte were drotning fin.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "\"Suend Normand, du skaltt udride,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "mett riige kemper att striide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "Att heffne faders bane din",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "och icke slo guld-harpen min.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "\"Skall ieg mig ud-riide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "mett andre kemper att striide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "Att heffne faders bane min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "rett aldriig komer ieg hiem tiill din.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "\"Da skall ieg dieg galle:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "rett aldriig skall ieg dieg skade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "Seyir y din høge hest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "sieir y deg allermest.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "Seyr i din haand, seeyr y din fod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "seyr y alle dine ledemaad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 10,
      "text": "Siignie dieg Gud, stenn drathin diure,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "denn helliige mandtt skall for dieg styre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 11,
      "text": "\"Y styller ether, stiller eder, Adelin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "y stiellen er, kiere moder myn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 12,
      "text": "Y lad nu brøge och blende win,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "och biud saa kongen hiem tiill din.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 13,
      "text": "Suend Normand binder siig suerdtt wed siide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "hanum lyster mett kemper att striide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 14,
      "text": "Suend Normand riider att weyin fram,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "der møtte hanum her Tulle Wanng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 14,
      "text": "der møtte hanum hans sønner tholff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "\"Hør du det, kiere sønne min:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 15,
      "text": "harnisk wiill ieg giffue dieg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "Och hand och sieyreth wiille wy skifftte emellum oss,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 16,
      "text": "føre wy wiille mett kemper slois.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "Suend Normand røgtte sitt suerd fra siide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 17,
      "text": "hanum lister mett kemper att striide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 18,
      "text": "Først weyit han her Tulle Wang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 18,
      "text": "och saa hans sønner tholff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 19,
      "text": "Suend Normand bantt sit suerd wiid siide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 19,
      "text": "hanum lister icke liennger mett kiemper at stride.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 20,
      "text": "Hand red siig under lide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 20,
      "text": "Diur-karll saa hand ther riide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 21,
      "text": "Bassin haffde hand po sin bag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 21,
      "text": "och biørn y hende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 22,
      "text": "Huer en finger, ther han haffde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 22,
      "text": "der spiller bode raaer och harer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 23,
      "text": "\"Hør du, Diur-karll, huad ieg siiger dieg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 23,
      "text": "du skalt skifftte diur mett mig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 24,
      "text": "Huad heller wiltt du fiigtte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 24,
      "text": "eller diur mett mig att skiifftte?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 25,
      "text": "\"Heller wiill ieg fiigtte mett dieg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 25,
      "text": "end skifftte diuren mett dieg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 26,
      "text": "Suend Normand drager sitt suerd fra siig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 26,
      "text": "hannom liister da mett kemper att striide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 27,
      "text": "De fiigthet y dag, de fiicthet y thoff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 27,
      "text": "den tridie dag giorde de och saa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 28,
      "text": "Den tridie dag att quelle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 28,
      "text": "Suend Normand Diur-karll felle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 29,
      "text": "Suend Normandtt binder siig suerd wiidtt siide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 29,
      "text": "hand liiste mett kemper att striide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 30,
      "text": "Han frem att høy saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 30,
      "text": "fæ-hiorde saa hand ther gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 31,
      "text": "\"Hør du fæ-hiorde, ieg thror diig best:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 31,
      "text": "du skalt wiisse mig kemper miest.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 32,
      "text": "\"Ieg wiiser ether tiill Sønderboriig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 32,
      "text": "ther driicker kemper uden soriig.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 33,
      "text": "Hand tog en guldering aff sin finger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 33,
      "text": "hun weytt XV pund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 34,
      "text": "Den gaff han then fæhiorde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 34,
      "text": "for hand hannom kemper wiisse thore.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 35,
      "text": "Normand kom der ridende y gaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 35,
      "text": "ud stor Ramulff suøptt y moor.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 36,
      "text": "\"Hør du, din horin-sønn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 36,
      "text": "huad wiltt du y mitt landtt?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 37,
      "text": "\"Ieg wiill mett mine enne hand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 37,
      "text": "blesse diig aff alle dine landtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 38,
      "text": "Ieg wiill mett mynn enne thaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 38,
      "text": "slaa diig alle dine land fraa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 39,
      "text": "Ieg wiill mett min mindste finger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 39,
      "text": "sloo diig alle dine lede-mod sønnder.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 40,
      "text": "\"Du skalltt icke mett din enne haandtt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 40,
      "text": "blisse mig fra alle mine landtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 41,
      "text": "Du skalt icke mett din enne thaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 41,
      "text": "slaa mig alle mine lande fra.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 42,
      "text": "Du skalt ick mett alle dine finger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 42,
      "text": "slaa mig itt aff mine ledemod sønnder.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 43,
      "text": "Suend Normand drog sitt suerd fraa siide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 43,
      "text": "han lister da mett kemper att striide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 44,
      "text": "Først weytt hand Randulff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 44,
      "text": "och saa weygde han Strandulff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 45,
      "text": "Saa weygde han Hans Under",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 45,
      "text": "och Egge-Unnder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 46,
      "text": "Och saa weygde han Egge-Karll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 46,
      "text": "och saa weygitt hand fiennden selff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 47,
      "text": "Suend Normand siette sitt suerd y skede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 47,
      "text": "han listitt tha tiill egitt land att riide hiem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 48,
      "text": "Suend Normand kom der riden y gaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 48,
      "text": "well tholff trolquinder stod der for.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 49,
      "text": "De stod for hanum mett rock och theen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 49,
      "text": "de sloo hanum offuer hans huide been.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 50,
      "text": "Suend Normandtt kaste sin hest om-kring:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 50,
      "text": "tolff trolquinder slo hand y en ring.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 51,
      "text": "Hans moder nødtt den beste liicke:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 51,
      "text": "hand slo hinder y fem thusind støcke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 51,
      "text": ":: See dieg ud, Suend Normandtt! ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}