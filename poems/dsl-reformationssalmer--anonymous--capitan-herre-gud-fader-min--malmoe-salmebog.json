  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "CApitan Herre Gud Fader min/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "vdsent migh naaden din/",
      "part": false,
      "marginal_notes": [
        "Psal xliiii"
      ]
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "den stund iegh her i liffue er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Stor vildelse nw i verden er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "miskunde oss Herre kær/",
      "part": false,
      "marginal_notes": [
        "Psal xx"
      ]
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "ath mig regere dine ord och lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Kundgør mig Herre den rette grund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "den stund/ her er den største nød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "din hellige ord forholt mig ey/ ret vey",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "til liffuit gennem døden wd/",
      "part": false,
      "marginal_notes": [
        "Joan xiiii"
      ]
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "est dw all ene min Herre oc Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Sig skynder fast den forsagde tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "O Herre gør oss fri/",
      "part": false,
      "marginal_notes": [
        "Ma xxiiii"
      ]
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "fra alt ont baade liff oc siæl/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "J all wor nød wi til dig fly",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "din naade begære wi/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "frelss oss o Herre fra werdzens qual/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "oc wær oss alle miskundelig/",
      "part": false,
      "marginal_notes": [
        "Coloss i"
      ]
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "forlig oss Herre formedelst din søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "ath wi kunde reth bliffue Christne/ vden men/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "det er min begere och bøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "hielp ath wi alle din ville gøre kunde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Mere gøris behoff ath bede dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "O Herre forlad ey mig/",
      "part": false,
      "marginal_notes": [
        "Psal xxvi"
      ]
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "dw som skapt haffuer alle ting/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "lad mig faa aff din visdom hid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "oc gack ey bort fra mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "met din naade mit hierte went omkring/",
      "part": false,
      "marginal_notes": [
        "Psal li Psal xxxii"
      ]
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "och skab i mig en retter aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "Dw kant/ wel wide huad mig gør møde oc waade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "thi alt mit haab haffuer ieg til dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "kom mig til trøst/ Herre Jesu Christ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "thi du all ene vor frelsere est",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "Marck/ steder/ oc alle mine vndersote/",
      "part": false,
      "marginal_notes": [
        "Deutero. xvii"
      ]
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "haffuer ieg aff dig faat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "beskerme dem alle for falske lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "Herre Gud her er nu kommen fram/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "en onder seduan",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "foruar oss alle i din ere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "Tag din hellige ord oc webne oss met/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 3,
      "text": "paa det/ ath dieffuelen oss ey besuige kan/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 3,
      "text": "met werdzlig praal oc menniskens tant/ Optend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 3,
      "text": "oss alle til saadan begere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 3,
      "text": "Ath vor tro kunde ret til dig ene være",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "Greffuer/ Herrer/ Ridder oc Knechte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 4,
      "text": "oc alle slecte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 4,
      "text": "befal ieg dig min herre oc Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 4,
      "text": "Forøg vor tro oc gør henne ret/",
      "part": false,
      "marginal_notes": [
        "Luce xvii"
      ]
    },
    {
      "id": 48,
      "stanza_id": 4,
      "text": "den verden haffuer forget/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 4,
      "text": "Jeg beder dig for din haarde død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 4,
      "text": "forlad oss ey i saadan nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 4,
      "text": "langt før haffuer du det selff forkyndet/",
      "part": false,
      "marginal_notes": [
        "Math xxiiii Acto xx"
      ]
    },
    {
      "id": 52,
      "stanza_id": 4,
      "text": "Ath falske Propheter skulle komme/ oc synes fromme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 4,
      "text": "som faar/ men induertis vlffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 4,
      "text": "som scrifften vduiser oc wi haffue befundit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 5,
      "text": "Til din store barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 5,
      "text": "huilcken all ene dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 5,
      "text": "opdrog paa korssit for vore synders nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 5,
      "text": "Jeg flyer till dig o Herre i dit skød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 5,
      "text": "mig aldrig offuergiff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 5,
      "text": "Jeg maner dig for din guddoms foriæt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 5,
      "text": "Den du haffuer loffuit for langen tid/",
      "part": false,
      "marginal_notes": [
        "Hie. xxi"
      ]
    },
    {
      "id": 62,
      "stanza_id": 5,
      "text": "Til dig rober nu saa mangen bedrøffuit aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 5,
      "text": "Oplad din øren oc hør vor røst oc trøste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 5,
      "text": "oss met din godhed alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 5,
      "text": "Beskerm oss ath wi icke i falsk tro falle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 6,
      "text": "Brende mercke haffue de i deris samuid/",
      "part": false,
      "marginal_notes": [
        "i Tim. iiii"
      ]
    },
    {
      "id": 67,
      "stanza_id": 6,
      "text": "som oss haffue wret ledit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 6,
      "text": "for dem sancte Pouel beder oss ath tage ware/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 6,
      "text": "De haffue foruent den hellige scrifft/",
      "part": false,
      "marginal_notes": [
        "ii Pe. iii"
      ]
    },
    {
      "id": 70,
      "stanza_id": 6,
      "text": "met deris falske dict/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 6,
      "text": "O herre frelss oss for din pine suar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 6,
      "text": "see her ned til oss dine fattige faar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 6,
      "text": "du haffuer betalid for all vor synd/",
      "part": false,
      "marginal_notes": [
        "i Tim ii"
      ]
    },
    {
      "id": 74,
      "stanza_id": 6,
      "text": "Christus haffuer oss met dig forligt/ det beuiss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 6,
      "text": "sancte Pouel met scrifft oc mund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 6,
      "text": "Foruar oss i din naade alle stund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 7,
      "text": "Den rette tro wi bede aff dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 7,
      "text": "hør oss nu Herre kær/",
      "part": false,
      "marginal_notes": [
        "Marc ix Dani. ix"
      ]
    },
    {
      "id": 79,
      "stanza_id": 7,
      "text": "før en døden oss om kuld støder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 7,
      "text": "til din miskund/ vort haab haffue wi",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 7,
      "text": "aff hiertens beger/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 7,
      "text": "O Herre wi ere saa ynckelige forførde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 7,
      "text": "fra din naade til vore egne gerniger/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 7,
      "text": "thi styrck oss ath wi kunde all ene til til dig/",
      "part": false,
      "marginal_notes": [
        "Psalm cxix"
      ]
    },
    {
      "id": 85,
      "stanza_id": 7,
      "text": "haffue all vor tro oc haabit vort/ dine ord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 7,
      "text": "ere sandhed visselig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 7,
      "text": "Giff oss ath wi maa leffue euindelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 8,
      "text": "Borger ret giff oss i dit Rige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 8,
      "text": "oc gør oss lige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 8,
      "text": "oc stat met oss alt ind til enden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 8,
      "text": "ath diefflene oss ey besuige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 8,
      "text": "O Herre ey fra oss wige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 8,
      "text": "din naadelige øgen ey bort fra oss vende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 8,
      "text": "ath naar wi komme i vor yderste nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 8,
      "text": "ath døden met grumhed vil oss tage fat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 8,
      "text": "saa redde du och wer vor skiold Herre bold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 8,
      "text": "wi bede dig alle met graad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 8,
      "text": "Jeg beder for alle mine vndersaat",
      "part": false,
      "marginal_notes": []
    }
  ]
}