  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Mit hierte hui gremmer du dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "bedrøffuer dig saa sørgelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "for Verdsens timelig gods/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "din trøst set til din Herre Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Der alting skabte met sit bud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Hand vil eller kand dig ey forlade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Hand veed din trang din nød oc skade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Hans er Himmel oc Jord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Min Fader oc min Herre sød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Som staar mig bi i all min nød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Du est min Gud oc Fader sand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Dit Barn du ey forlade kand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Dit hierte er Faderligt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Jeg er en Jordklimp met stor brøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Paa Jorden veed ieg ingen trøst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Den Rige paa sit gods trøster sig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "Men ieg fortrøster mig paa dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "Er ieg end her foract/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Saa veed ieg vel oc visselig tror/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "At dine tienere din hielp faar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "Helia sige huo fødde dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "Der Regnen forholtis vnderlig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "J den suare dyre tid?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "J Zidons Land en Encke rund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Til den Gud sende dig samme stund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "Oc at du ey skulde lide nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "Der du drogst did som Gud dig bød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "Oc hans befalning giorde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "Dig førde Raffne kiød oc brød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": "Aarle oc silde til din føde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "Du soffst vnder it Enebær træ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "Der Engelen kom/ oc loed sig see/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "Hand førde dig Vand oc Brød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": "Du gickst der effter en vey saa lang/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 6,
      "text": "Til Horebs bierg vden hungers trang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "Joseph bleff til Egypten sold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 7,
      "text": "Oc der i Fengsel kast met vold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": "For sin Gudfryctighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 7,
      "text": "Men Gud hialp hannem til Herre naffn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 7,
      "text": "Hans venner til stor ære oc gaffn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 8,
      "text": "Gud haffde Daniel ey forgæt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 8,
      "text": "Der hand blant Løuerne vaar nedset/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 8,
      "text": "Sin Engel sende hand did/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 8,
      "text": "Hand hannem Mad da føre loed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 8,
      "text": "Ved Abacuc sin tienere god.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 9,
      "text": "Den trofaste Gud ey glemme vild/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 9,
      "text": "De tre Mend som vaare kaste i Jld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 9,
      "text": "Sin Engel sende hand did/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 9,
      "text": "Loed dem beuare for Jldens glød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 9,
      "text": "Oc hialp dem saa aff all deris nød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 10,
      "text": "Jonas kunde Guds hielp ocsaa faa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 10,
      "text": "Der hand i Hualfiskens bug laa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 10,
      "text": "Tre dage oc nætter tre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 10,
      "text": "Gud met sit Ord det visslige giør/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 10,
      "text": "At Fisken hannem paa landet før.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 11,
      "text": "O Gud du est end nu saa rig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 11,
      "text": "Som du haffuer værit euindelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 11,
      "text": "Til dig staar all mit haab.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 11,
      "text": "Min Siel beuar/ oc giør hende rig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 11,
      "text": "Saa haffuer ieg nock euindelig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 12,
      "text": "Den timelig ære vil ieg ombære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 12,
      "text": "Den euig lad mig visse være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 12,
      "text": "Den du forhuærffuit mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 12,
      "text": "Alt ved din bitter haarde Død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 12,
      "text": "Det beder ieg dig O Herre sød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 13,
      "text": "Alt det denne Verden er aff fuld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 13,
      "text": "Det være sig Penning Sølff eller Guld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 13,
      "text": "Rigdom oc timelig gods.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 13,
      "text": "En liden stund det bliffuer ved/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 13,
      "text": "Oc hielper ey til Salighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 14,
      "text": "Jeg tacker dig Christ O Guds Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 14,
      "text": "At du gaffst mig denne kundskab skøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 14,
      "text": "Ved dit Guddommeligt Ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 14,
      "text": "Forlen mig oc bistandighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 14,
      "text": "Min arme Siel til Salighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 15,
      "text": "Loff ære oc priss skee dig allestund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 15,
      "text": "For dine velgierning mangelund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 15,
      "text": "Jeg beder dig inderlig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 15,
      "text": "Lad oss ey fra dit Ansict blid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 15,
      "text": "Forskiudis bort til euig tid.",
      "part": false,
      "marginal_notes": []
    }
  ]
}