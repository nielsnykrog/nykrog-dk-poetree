  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Hvor Kongeaaen skinner imellem Vaarens Grönt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Det nye Hjem sig reiser saa hyggeligt og skjönt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Hvor Fjenderne husered’ paa Jydens Pröve-Dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Skal Kjerligheden bygge i Ly af Danmarks Flag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Hinanden ret at eie, hinanden ret forstaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "I sig at eie Verden, er her Guds Himmel naae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Det fatte I og föle, saa glad, dog tankefuld!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Gid Myrtens grönne Blade I see, som Sölv og Guld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Der kommer Alvors Dage, der kommer ogsaa Sorg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Hold fast, og Gud vil være i Hjerte og i Borg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Vil styrke, luttre, hæve og holde karsk og fro!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "– Men nu – nu herske Glæden! – Velsignet vær I to!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Vor Sang mod Skyen runge ud over Vold og Sund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Med alle gode Önsker fra Hjertets dybe Grund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "I det vi Skaalen tömme for Brudgom og for Brud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Det er, som Vaarens Roser i dette Nu sprang ud!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
