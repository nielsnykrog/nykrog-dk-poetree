  "title": "18, Hunden ved Stranden",
  "year_created": 1845,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Vilhelm Kaalund",
    "country": null,
    "wiki": "Q2362214"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Fabler For Børn",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1845,
    "url": "https://tekstnet.dk/books/kaalund-hv_fabler-for-boern/019/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Ak, ser Du ej Skibet derude paa Søen?",
      "part": false,
      "marginal_notes": [
        "Speaker: Hunden:"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Min Herre, Kaptejnen, har glemt mig iland,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "nu maa jeg vel løbe og klage ved Strand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "- Saa løb den og jamred i Nætter og Dage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "den vilde ej Æde og Drikke tage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Til fremmede Lande gik Skibets Vej;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "den fattige Hund man ænsede ej.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Den døde af Kummer og fik sin Grav",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "i Tangen tæt ved det vaade Hav.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Mig synes, den havde saa vel fortjent",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "for sin Troskab et hædrende Gravmonument.",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
