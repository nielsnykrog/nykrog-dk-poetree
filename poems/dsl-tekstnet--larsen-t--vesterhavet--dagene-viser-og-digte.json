  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Dagene, Viser Og Digte",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1905,
    "url": "https://tekstnet.dk/books/larsen-t_dagene/003/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Jeg stod en Vinterskumring i Bovbjerg Skrænt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Et stormhidset Helvedhav laa under mine Fødder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Ildsøernes kolde Ætling, det Lavlands-Element,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "der knækker Skibes Staalskal, som vi knækker Nødder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Krumryggede Bølge-Udyr fra Horisonten brød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Med salte Fræs de stampede sig over de lange Revler.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Rygende og kogende, som Bunden laa i Glød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "stormede de Brændingen og sled hinanden i Trævler.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "De raste om Vragenes Ribbens rustne Staal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "der stritter op af Sandet, som Arme i Nød sig løfter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Bidder af Skræntens Lerskorp forsvandt i det vaade Baal.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Lange, lystne Tunger slikked i alle Kløfter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "En Sodomas Røg og Ross over Havstokken drev,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "mens de Uhyrer brødes om Bovbjergs Knolde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "De stiveste Stenskrig i Øret stak og rev,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "som boret ud af Halsen paa Tolvhestes Trolde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "De Skrig de vækker Minder i Menneskets Bryst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "om en brændende Kamplarm i Tidernes Dagning,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "mellem Kulde og Hede, i Rædsel og Lyst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Jeg mærker som en svimlende Solmoder-Dragning.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Paa Solen raser Ild, som paa Jorden raser Hav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "der gaar Brandfogs Brænding mod forkullede Kyster.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Den hvirvler sig endnu om sit himmelske Nav",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "som et fraadende Stjernebaal, en Vaade af Lyster.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
