  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Kom hellig Aand Herre Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "aff Himmelen send oss vd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "dit liusis klare skin.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Kom alle fattigis Fader kom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "kom der giffuer Naadens gaffuer kom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "kom O all vor hiertens liuss kom.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Du geffueste trøstermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "den sødeste Gæst vdi vor Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "saa sødelig vor Siel forlæske kand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "J all møde giffuer du trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "vdslycker all Synds brynde oc brøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "husualer all vor sorg oc graad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 4,
      "text": "O du allerhelligste liuss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "optend hiertens inderste huss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "J alle dine Christne børn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 5,
      "text": "Thi at vden din Guddoms krafft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "haffuer liusit i oss ingen mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "men blindhed oc synd i oss er.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 6,
      "text": "Toe alt det som besmittet er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 6,
      "text": "giør det vaat som fortyrcket er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "hele det som brødit er.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 7,
      "text": "Blødgiør det som forhærdet er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 7,
      "text": "optend det som forkølet er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "hielp det som vildfarend er.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 8,
      "text": "Du giff alle Christne din/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 8,
      "text": "til dig der sette Troen sin/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 8,
      "text": "dine mangfold gaffuer skøn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 9,
      "text": "At wi Christi verdskyld nyde maa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 9,
      "text": "vor Siels salighed lad oss faa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 9,
      "text": "Oc det euige liff til løn.",
      "part": false,
      "marginal_notes": []
    }
  ]
}