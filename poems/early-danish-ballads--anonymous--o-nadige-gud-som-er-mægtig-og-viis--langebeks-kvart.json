  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Naadige Gud som ehr megtig och Viisz |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "som Alting haffuer i hande |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Affuend den store Plage och Riisz |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "som henge offuer disse lande |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Giff du voris konning lÿcke och moed |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "sine fiende offuer att vinde |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "At danmarchis Rige igen matte komme | paa foed |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Och sig Anderledisz besinde",
      "part": false,
      "marginal_notes": []
    }
