  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "DJg vere loff och pris o Herre Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "benedidet er den dag for vist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "wi loffue dig nu oc til euig tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Hellig/ hellig/ hellig/ est du i det høyeste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Englene och offuer Engle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Tronerne och det Hiemmelske herskaff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Dig loffue Cherubin oc Seraphin/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Hellig/ hellig/ hellig/ siungis i det øffuerste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "dit folck o Christe loffue dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Din brud aff Hiertet nu glæder sig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "For din naade och barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Hellig/ hellig/ hellig hun siunger dig.",
      "part": false,
      "marginal_notes": []
    }
  ]
}