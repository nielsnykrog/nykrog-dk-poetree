  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Lyriske Digte",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1924,
    "url": "https://tekstnet.dk/books/jacobsen-jp_lyriske-digte/017/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Nej! der er ingen Kristendom i dette!",
      "part": false,
      "marginal_notes": [
        "Speaker: Faustina."
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Ej Sønderknuselse og stille Suk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Ej Myrrhakvalm og tunge Psalmetaager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "O hvilken Aften dog, hvor vild og smuk!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Det er ej Martyrblod, der Vesten farver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Det Mulm, der synker, aander ikke Fred,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Der er ej Bøn i disse Fløjtetoner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Her knirker ikke Korsets tørre Ved.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "I Solens Favn, den flammerøde Molochs,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "De dunkle Skyer sænke sig med Lyst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Og Jorden elskovsmod sit Hoved gjemmer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Ved Mulmets attraasvangre Bejlerbryst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "O hvorfor fordrer du saa mildt, min Brudgom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Og stedse af det Fattigste i mig?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Hvi kommer ej du, som din stærke Fader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Kom til Maria? Se, jeg venter dig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Ak, syg og lidende paa Træ du hænger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Og vil kun Graad og stille Vemodssuk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Tyst skal der være hos dig som hos Syge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "Tyst, og jeg er saa hed og sund og smuk!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "O kom dog i din Skjønhed og din Vælde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "Som fyrig Bejler eller Herre vred!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "Glad skal jeg synke hen i dine Arme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "Glad synke, knust af dig, i Støvet ned.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "Du vil mig ej! Nej Ingen mig begjærer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "Hvortil dog disse rige Formers Pragt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "Langt heller gav jeg disse blanke Lemmer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "Til Bytte for en Rovfugls gridske Magt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "Langt heller som et Skuespil for Mængden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "Af vilde Hingste splittes Led for Led",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "End som et uset simpelt fredet Blomster",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "Sin Skjønhed skue langsomt visne ned.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 0,
      "text": "Saa kom da du og vær min strænge Bejler.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 0,
      "text": "........................",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
