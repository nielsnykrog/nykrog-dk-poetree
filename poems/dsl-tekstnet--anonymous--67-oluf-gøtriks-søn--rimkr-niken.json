  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Megh thycthæ ieg kunde ey wære gladh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "ath leffue for wthen mødhe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "som slo myn fader tijl døde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Ieg for ey wthenlandz i krij",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "tha ieg bar danmarks krone.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Men Danmarks rigæ holt ieg saa frij,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Ieg døde i Lædræ, myn kongelig gaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "och ladis ther wdhenfore",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "wthi en høw, som ther en staar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Then stedh mwnne ieg meg kore.",
      "part": false,
      "marginal_notes": []
    }
  ]
}