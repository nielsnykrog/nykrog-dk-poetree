{
  "id": null,
  "title": "Hildebrand og Hilde",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA68.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Huy maa meg ey lyee der lierr",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "all werden om sieerr.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": ":: Huy maa hun ey? ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Lyee der lierr",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "all werden om sieerr.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Lidenn war hun Hylle:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "hun syde syn søm saa wilde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": ":: Huy maa hun ey? ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Hylle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "hun syde syn søm saa wilde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Thett siud hun med sylcke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "som hun med guld skuld werke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Och thett siude hun med guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "som hun med sylcke skulde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "Tthett spurde droningen vnder ø:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "thett Hildelil mone sømen saa wilde siy.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "Droning suøber seg hoffuet y skiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "hun gaar y lofft for Hylelild ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 6,
      "text": "Droningen ind aff døren thrend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 6,
      "text": "Hyllelild staar hind op igenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 7,
      "text": "\"Hør thu thett, Hyllelilde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 7,
      "text": "huy syer thu thin søm saa wilde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 8,
      "text": "Ligge saa syr du dynne søme:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 8,
      "text": "som den, synn glede mone gleme.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 9,
      "text": "Hyllelild klaper paa hønde blaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 9,
      "text": "\"Myn nadigge frwe, y huiler der-paa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 10,
      "text": "Myn nadige frw, y seder huosz meg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 10,
      "text": "all myn sorrig sigger ieg for eder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 11,
      "text": "Thett wilde bliffue eder forlangtt att staande:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 11,
      "text": "men ieg klager eder myn waande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 12,
      "text": "Mynn fader hadde enn konnge-wold:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 12,
      "text": "myn moder hun war en droning bold.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 13,
      "text": "Myn fader luod meg saa herlig søme:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 13,
      "text": "XII rider thi skulde meg wogtte och gieme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 14,
      "text": "Syden luod ieg meg locke:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 14,
      "text": "en rider vd-aff den flocke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 15,
      "text": "Hand heede hertug Hyldebraand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 15,
      "text": "kongens sønn aff Engeland.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 16,
      "text": "Saa lagde dy guld paa ganger thuo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 16,
      "text": "thend thride red hand och ieg seleff paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 17,
      "text": "Saa kaam wy om quelde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 17,
      "text": "der, som wy løstett att dueelle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 18,
      "text": "Om nattenn kaam der slauff paa dør:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 18,
      "text": "myne siy brøder war der for.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 19,
      "text": "Hand klapitt meg ued huiden kiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 19,
      "text": "Thu sørge icke, aler-kereste myn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 20,
      "text": "I-nar du sier meg bløde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 20,
      "text": "daa nøffuenn meg icke till døde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 21,
      "text": "I-nar du sierr meg faalle:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 21,
      "text": "daa nøffuen meg icke med alle!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 22,
      "text": "Hylle-brand hand baad huog och slaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 22,
      "text": "XV rider for hans fuoid luo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 23,
      "text": "Steeller eder, steller eder, Hyllebrand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 23,
      "text": "om y meg aff hiartet well aand!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 24,
      "text": "I lader myn yngeste broder løffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 24,
      "text": "hand matte ind iene y landenn blyffue!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 25,
      "text": "Hyllebrand fek y thett same kald",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 25,
      "text": "synn baane-sarrd til iorden och fald.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 26,
      "text": "Mynn broder thog meg wed huiden hand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 26,
      "text": "hand band meg med en saadelbandtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 27,
      "text": "Hand thog meg y gulle lock:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 27,
      "text": "hand band meg till syn saadell-knap.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 28,
      "text": "Hand red icke offuer saa liden en quest:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 28,
      "text": "hun thog io hudenn aff mitt brøst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 29,
      "text": "Hand red ike offuer saa lidell en gren:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 29,
      "text": "hun tog io hudenn aff mitt byen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 30,
      "text": "Hand red icke offuer saa lidenn en rod:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 30,
      "text": "hun stuod y blod y myn fuod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 31,
      "text": "Der hand kaam till borrige-lied:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 31,
      "text": "min sorig-fuld moder hun stuod der-wed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 32,
      "text": "Mynn fader luod ett thornn op-bygge:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 32,
      "text": "och der skuld ieg daa inde leege.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 33,
      "text": "For vden war thett med iarrne-pigge:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 33,
      "text": "for inden war thett med thett breme-risz.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 34,
      "text": "For huerind synde ieg rorde mynn fuod:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 34,
      "text": "thi huase risz stuod meg imod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 35,
      "text": "Myn fader wilde meg quelle:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 35,
      "text": "myn moder bad, thi skulde meg seelle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 36,
      "text": "Hun solde meg for en kloke:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 36,
      "text": "den henger y Marikierke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 37,
      "text": "Thend første lyu, der klokenn feck:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 37,
      "text": "mynn moders hiartte y synder gick.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 38,
      "text": "Tthett melltte droningenn vnder skiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 38,
      "text": "saa strid daa rand hind thaar paa kiend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 39,
      "text": "\"Y-men du haffuer nu sagtt sorig dyn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 39,
      "text": "daa war hertug Hilebrannd sønne mynn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 40,
      "text": "Tther Hyllelild haffde vd-sagtt dy ord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 40,
      "text": "daa fald hun død for droningens fuod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 41,
      "text": "Vd-sagtt dy ord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 41,
      "text": "daa fald hun død for droningens fuod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 41,
      "text": "Droningenn fieck saa stuor enn haarum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 41,
      "text": "stalt Hillelild døde vdj hindis arum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 41,
      "text": ":: Huy maa hun ey? ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}