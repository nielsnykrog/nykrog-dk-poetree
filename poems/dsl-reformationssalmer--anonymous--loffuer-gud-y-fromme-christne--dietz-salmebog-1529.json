  "source": {
    "id": null,
    "title": "Een ny handbog med Psalmer oc aandelige lofsange",
    "year_published": 1529,
    "publisher": "Ludwig Dietz",
    "printer": "Ludwig Dietz",
    "place": "Rostock",
    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/dietz-salmebog-1529/8/14"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "LOffuer Gud ÿ fromme Christne",
      "part": false,
      "marginal_notes": [
        "Psal. lxxx."
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "quæder oc wærer glad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "med konning Dauid psalmiste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "prÿser Gud ÿ allen stad/",
      "part": false,
      "marginal_notes": [
        "Psal. xxxij."
      ]
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Att Guds ord monne nw klinge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "saa wÿt offuer alle land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "ther med wÿ Christum finde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "wor eeneste frelsermand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Gud haffuer nw aff sÿn naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "opwecht een Christen mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Guds ord monne han framdrage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "ther med bewÿser hand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "att wÿ som kallis Christne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "haffue lenge farid wild/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "til alt got wærid wisne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "thet wor wore lærefædrers skyld.",
      "part": false,
      "marginal_notes": [
        "Hierem. l. Joh. xiiij. Johan. viij Roman. j. Psal. lxxx."
      ]
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Rett wæy til himmerige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "er Guds ord vden twil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "som Christus sielffue siger/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "hwo hannwm følg far ey wild/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Men wÿ haffue thet foractid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "ingen tro satte wÿ ther paa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "thÿ haffuer oss Gud bort kastid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "oc lod oss ÿ mørcke gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Alt thet som wÿ monne giøre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "wor ingen mand nyttelig/",
      "part": false,
      "marginal_notes": [
        "Genes. iij. Hier. xxiij. j. Tim. iiij."
      ]
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "thÿ dieffuelen monne oss føre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "rett mod Guds ord altÿd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Med falske iertegen oc drømme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "satte han sÿn snare for oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "att wÿ skulle Guds ord glømme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "oc saa med hannwm forgaas.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Han haffuer oc ladit schriffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "mod Guds ord lærdom ny/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "ther med han monne forgiffue/",
      "part": false,
      "marginal_notes": [
        "ij. Tessal. j. j. Corin. xvj"
      ]
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "alle them som Guds ord sky/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "Oc sette theris haab til andit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "en Christi pÿne oc død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "the ere aff Gud forbandnit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "oc komme til heluedis glød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "Ther paa skal mand thennom mercke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "som dieffuelsens lærdom følie/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 5,
      "text": "att the wille altÿd gierne/",
      "part": false,
      "marginal_notes": [
        "Hier. xviij"
      ]
    },
    {
      "id": 43,
      "stanza_id": 5,
      "text": "haffue theris eghen wilie/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 5,
      "text": "oc følie theris eghit sinde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "oc menniskens lærdom falsk/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "Guds ord wille the ey nemme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "thet er thennom beest oc hwast.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "The holde meer aff theris wane/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 6,
      "text": "oc gamle fædrers dicht/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 6,
      "text": "en aff Guds ord thet sande/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 6,
      "text": "oc Guds faders hellige schrifft.",
      "part": false,
      "marginal_notes": [
        "Johan. j."
      ]
    },
    {
      "id": 52,
      "stanza_id": 6,
      "text": "Som ewig tÿd haffuer wærid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "dog sige the att thet er nyt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "Guds ord haffue the forladit/",
      "part": false,
      "marginal_notes": [
        "j. Tim. iiij."
      ]
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "diefflens lærdom till thennom byt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 7,
      "text": "The klæde stock oc steene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 7,
      "text": "oc holde besynderlige dage:",
      "part": false,
      "marginal_notes": [
        "Abakuk. ij"
      ]
    },
    {
      "id": 58,
      "stanza_id": 7,
      "text": "ther med wille the Gud tiæne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 7,
      "text": "oc ther fore himmerige haffue.",
      "part": false,
      "marginal_notes": [
        "Esaie. lviij"
      ]
    },
    {
      "id": 60,
      "stanza_id": 7,
      "text": "The fattige lade the fryse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 7,
      "text": "oc lÿde hunger oc nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 7,
      "text": "Gud bød wÿ skulle thennom spÿse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "hans bud wÿ inthit skøde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 8,
      "text": "Er thet icke een stor blindhed/",
      "part": false,
      "marginal_notes": [
        "Esaie. vj. Johan. xiiij. Johan. iij."
      ]
    },
    {
      "id": 65,
      "stanza_id": 8,
      "text": "att the wille Gud ey tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 8,
      "text": "som er then ewig sandhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 8,
      "text": "oc wil giffue ewig ro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 8,
      "text": "Alle them hans lærdom følie/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 8,
      "text": "thet haffuer Christus fortiænt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 8,
      "text": "alt oppaa korssens gallie/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 8,
      "text": "ther till wor han wdsend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 9,
      "text": "Gud fader haffuer sÿn søn skickit/",
      "part": false,
      "marginal_notes": [
        "Johan. iij."
      ]
    },
    {
      "id": 73,
      "stanza_id": 9,
      "text": "til alles wor salighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 9,
      "text": "han haffuer oss sÿn schrifft giffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 9,
      "text": "hun er fuldkommelig.",
      "part": false,
      "marginal_notes": [
        "ij. Tim. iij. Mat. xxiij."
      ]
    },
    {
      "id": 76,
      "stanza_id": 9,
      "text": "Hun kan teg all sandhed lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 9,
      "text": "alt thet teg er nytteligt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 9,
      "text": "wÿ behøffue ey mestre flere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 9,
      "text": "Christus giffuer himmerig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 10,
      "text": "Thÿ lade wÿ them nw fare/",
      "part": false,
      "marginal_notes": [
        "Math. xv."
      ]
    },
    {
      "id": 81,
      "stanza_id": 10,
      "text": "som tro paa sÿn eghen krafft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 10,
      "text": "wÿ wille hooss Guds ord wære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 10,
      "text": "tro hwad Christus haffuer sagt.",
      "part": false,
      "marginal_notes": [
        "Coloss. ij. Johan. iij."
      ]
    },
    {
      "id": 84,
      "stanza_id": 10,
      "text": "J hannwm all sandhed findis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 10,
      "text": "all naade oc all miskund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 10,
      "text": "the skulle med dieffuelen twingis",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 10,
      "text": "som hannwm tro ingelund.",
      "part": false,
      "marginal_notes": [
        "Johan. viij."
      ]
    },
    {
      "id": 88,
      "stanza_id": 11,
      "text": "Sedwane kan them ey hielpe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 11,
      "text": "nar dommen holdis skal/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 11,
      "text": "oc ey theris gamle forfædre/",
      "part": false,
      "marginal_notes": [
        "Johan. v."
      ]
    },
    {
      "id": 91,
      "stanza_id": 11,
      "text": "Christus bliffuer offuer them alle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 11,
      "text": "Hans ord skulle tha framgange/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 11,
      "text": "oc alle skulle himmerig faa/",
      "part": false,
      "marginal_notes": [
        "Mat. xxv."
      ]
    },
    {
      "id": 94,
      "stanza_id": 11,
      "text": "som hannwm haffue gaaid til hande/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 11,
      "text": "oc effter hans lærdom gaa.",
      "part": false,
      "marginal_notes": [
        "Ephesi. j."
      ]
    },
    {
      "id": 96,
      "stanza_id": 12,
      "text": "Prÿss wære Gud ewindelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 12,
      "text": "som oss haffuer sÿne ord send/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 12,
      "text": "med them wÿ kunde bliffue salig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 12,
      "text": "oc komme fraa dieffuelsens tant/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 12,
      "text": "The lære tro Gud allene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 12,
      "text": "altÿd for vden galle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 12,
      "text": "oc wor ieffnchristen att tiæne/",
      "part": false,
      "marginal_notes": [
        "Mat. xxij."
      ]
    },
    {
      "id": 103,
      "stanza_id": 12,
      "text": "thet vnde oss Christus alle.",
      "part": false,
      "marginal_notes": []
    }
  ]
}