    "born": null,
    "died": null
  },
  "source": {
    "id": null,
    "title": "Een ny handbog med Psalmer oc aandelige lofsange",
    "year_published": 1529,
    "publisher": "Ludwig Dietz",
    "printer": "Ludwig Dietz",
    "place": "Rostock",
    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/dietz-salmebog-1529/8/3"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "GVds søn er kommen aff himmelen nid/",
      "part": false,
      "marginal_notes": [
        "Esaie. ix."
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "thÿ han oss inderlig elste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "wore gierninger ere vduelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "the kunde oss icke frelse/",
      "part": false,
      "marginal_notes": [
        "Esaie. lxvj."
      ]
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Thÿ tro wÿ alle paa Jesum Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "att han er all wor salighed wist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "oc haffuer oss himmerig forhwerffuit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Hwad Gud ÿ loffuen oss budit hadde/",
      "part": false,
      "marginal_notes": [
        "Roma. viij"
      ]
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "tha wÿ thet icke kunde giøre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Thÿ wore wÿ vnder Guds wrede alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "wor bøn wilde han ey høre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Wÿ skulde wære gode aff hiertens grund/",
      "part": false,
      "marginal_notes": [
        "Leuit. xix."
      ]
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "men wÿ ere onde ÿ alle stund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "all wor krafft er forderffuit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Dog meente wÿ saa ÿ wor blindhed/",
      "part": false,
      "marginal_notes": [
        "Roman. ij."
      ]
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "att Gud hadde loffuen wdgiffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "ret lÿge som wÿ hadde sielff kundit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "alt effter hennes wilie leffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Men hun er icke wden eet speil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "som oss wor wanart wÿse wil/",
      "part": false,
      "marginal_notes": [
        "Roma. iij."
      ]
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "ther lønlig boor ÿ hiertet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Thenne samme wanart wÿ ingelund kunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "aff wor eghen macht forlade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "endog wÿ thet thÿt forsøge monne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "synden wilde dog offuer oss raade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Wÿ siuntis vdwortis wære hellig/",
      "part": false,
      "marginal_notes": [
        "Roma. vij. Exodi. xx."
      ]
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "men ÿ hiertit wor syndzens løst oc swig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "thet Guds loff slæt fordømmer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Wÿ skulde Gud frøchte aff hiertens grund/",
      "part": false,
      "marginal_notes": [
        "Deutro. x."
      ]
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "til hannwm all wor tro sette/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "oc elske hannwm bode med hierte oc mund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "oc aldrig hans bud forgæte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Wÿ skulde alle menniske haffue kiær/",
      "part": false,
      "marginal_notes": [
        "Math. v."
      ]
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "saa wel wor fiend som wore wenner/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "aff hiertet them alt gott vnde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Her maa wÿ see wor naturs macht/",
      "part": false,
      "marginal_notes": [
        "Gen vj. viij"
      ]
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "oc syndelig art begribe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "hun skulde thet giøre som nw er sagt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "om hun wilde med Gud bliffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "Men hun er ther altÿd emod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "sÿn fiend kan hun ey wære god/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "oc Gud kan hun ey frøcte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "Nw skulle Guds bud opfyllis vden brist/",
      "part": false,
      "marginal_notes": [
        "Ess. xxxvj."
      ]
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "ellers motte wÿ alle fortabis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "thÿ vdsende Gud sÿn søn Jesum Christ",
      "part": false,
      "marginal_notes": [
        "Roma. viij"
      ]
    },
    {
      "id": 45,
      "stanza_id": 6,
      "text": "lod hanwm for wor skyld plawis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 6,
      "text": "Han haffuer Guds bud allene opfylt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 6,
      "text": "ther med Guds faders wrede stilt:",
      "part": false,
      "marginal_notes": [
        "Ephe. ij."
      ]
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "ther offuer oss gick alle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 7,
      "text": "Oc nar the nw opfylt ere/",
      "part": false,
      "marginal_notes": [
        "Ro. viij. x. Luce. vij."
      ]
    },
    {
      "id": 50,
      "stanza_id": 7,
      "text": "aff Christo som them kunde holde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 7,
      "text": "her skulle wÿ Christne menniske lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 7,
      "text": "wor Christne trois krafft hÿn bolde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 7,
      "text": "icke andet en tro mÿn Herre kiær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 7,
      "text": "thÿn pÿne oc død mÿn er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 7,
      "text": "tw haffuer for meg betalid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 8,
      "text": "Ther paa ieg twiler inthit med alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 8,
      "text": "thÿne ord kunde icke bedrage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 8,
      "text": "tw bad mennisk ÿ mishaab falle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 8,
      "text": "thet drager tw icke tilbage/",
      "part": false,
      "marginal_notes": [
        "Titum. j. Mar. xvj. j. Petri. j."
      ]
    },
    {
      "id": 60,
      "stanza_id": 8,
      "text": "Hwo paa meg tror oc bliffuer døpt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 8,
      "text": "til hannwm haffuer ieg himmerig kiøpt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 8,
      "text": "att han skal icke fortabis",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 9,
      "text": "Thenne tro hielper oss for Gud alleen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 9,
      "text": "om wÿ henne ÿ hiertet beware/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 9,
      "text": "Hun giffuer fraa seg eet saadant skÿn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 9,
      "text": "gode gierninger kan hun ey spare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 9,
      "text": "til Gud alleen strecker seg een rett tro/",
      "part": false,
      "marginal_notes": [
        "Deu. xxxij."
      ]
    },
    {
      "id": 68,
      "stanza_id": 9,
      "text": "men kierlighed giør alle menniske gott/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 9,
      "text": "om tw æst aff Gud fødder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 10,
      "text": "Guds bud lære oss att kende wor synd:",
      "part": false,
      "marginal_notes": [
        "Ro. iij. vij."
      ]
    },
    {
      "id": 71,
      "stanza_id": 10,
      "text": "the slaa wort hierte nedder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 10,
      "text": "saa kommer thet hellig Euangelium/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 10,
      "text": "oc trøster oss alle oc siger/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 10,
      "text": "kommer alle til Christ han wil eder glæde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 10,
      "text": "vnder loffuen er sorrig oc møde att leffue/",
      "part": false,
      "marginal_notes": [
        "Acto. xv."
      ]
    },
    {
      "id": 76,
      "stanza_id": 10,
      "text": "med hennes gierninger alle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 11,
      "text": "Rett gode gierninger komme wisselig/",
      "part": false,
      "marginal_notes": [
        "Galat. v."
      ]
    },
    {
      "id": 78,
      "stanza_id": 11,
      "text": "aff troen then Gud ÿ oss skaber/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 11,
      "text": "Guds aand haffuer hun vden twil med seg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 11,
      "text": "alt gott han ÿ oss mager/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 11,
      "text": "dog giør troen oss salig allene/",
      "part": false,
      "marginal_notes": [
        "Gene. xv. Galat. v."
      ]
    },
    {
      "id": 82,
      "stanza_id": 11,
      "text": "gode gierninger skulle wor tiæne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 11,
      "text": "ther paa wÿ then rette tro mercke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 12,
      "text": "Wort haab thet bÿer tolmodelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 12,
      "text": "effter thet Guds ord oss iætter/",
      "part": false,
      "marginal_notes": [
        "Ro. v. viij."
      ]
    },
    {
      "id": 86,
      "stanza_id": 12,
      "text": "saa lenge thet skeer med glæde oc fred/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 12,
      "text": "alting ÿ Guds hand setter/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 12,
      "text": "Han weed wel hwad oss nytteligt er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 12,
      "text": "alting lader han oss gaffnlige wære/",
      "part": false,
      "marginal_notes": [
        "Math. vj."
      ]
    },
    {
      "id": 90,
      "stanza_id": 12,
      "text": "ther paa skulle wÿ ey twile.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 13,
      "text": "Oc om tw finge saa stor modgang/",
      "part": false,
      "marginal_notes": [
        "Job per totum."
      ]
    },
    {
      "id": 92,
      "stanza_id": 13,
      "text": "att Gud siuntis wære teg wreder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 13,
      "text": "dog see tw til att ingen twang/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 13,
      "text": "teg fraa thÿn tro bortleder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 13,
      "text": "Men bliff fast wid Guds ord altÿd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 13,
      "text": "han siunis wære wreder han er dog blÿd/",
      "part": false,
      "marginal_notes": [
        "Coloss. j."
      ]
    },
    {
      "id": 97,
      "stanza_id": 13,
      "text": "thÿ lad teg icke forfære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 14,
      "text": "Gud fader oc Søn oc then Helliaand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 14,
      "text": "hannwm wille wÿ prÿse alle sammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 14,
      "text": "for sÿn godhed ÿ alle land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 14,
      "text": "oc bede han wilde fuldkomme.",
      "part": false,
      "marginal_notes": [
        "Psal. lxvij. Math. vj."
      ]
    },
    {
      "id": 102,
      "stanza_id": 14,
      "text": "Thet han ÿ oss nw haffuer begynt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 14,
      "text": "seg sielff til prÿss ewindelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 14,
      "text": "hans naffn kunde helligt giøris.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 15,
      "text": "Hans rÿge tilkomme hans wilie ske/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 15,
      "text": "her paa iorden som ÿ himmelens trone/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 15,
      "text": "wort daglige brød oss ÿ dag giffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 15,
      "text": "wore synder oc wilde skone.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 15,
      "text": "Ret lÿge som wÿ wore modbrydere giøre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 15,
      "text": "oc wilde oss icke ÿ frelstelse føre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 15,
      "text": "men frelse oss fraa ont AMEN.",
      "part": false,
      "marginal_notes": []
    }
  ]
}