  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1834,
    "url": "https://tekstnet.dk/books/andersen-hc_farvel-til-italien/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Jeg saae det Land, hvis Luft har himmelsk Lyst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Hvor under Pinien Skjønheds Børn os møde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Hvor Ilden sprudler frem af Bjergets Bryst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Og Oldtids Byer opstaae fra de Døde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Der klædt’ i Marmor høie Guder staae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Der Duft og Toner i hver Luftning vifte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Mens Havet er en Olie azurblaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Og Bjergene med syvfold Farve skifte. –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Der Alt er Malerie ved Malerie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Der klart Guds Skaber-Kjærlighed man skuer; –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "See Bondens Gjærde: Laurbær groer deri,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Den høie Cactus, Ranken tung med Druer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Der blev mit Hjerte Barn, men Tanken Mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Der lærte jeg Natur og Kunst at kjende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Du, Farvernes og Formens skjønne Land!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Farvel! – Min smukke Drøm er nu tilende!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
