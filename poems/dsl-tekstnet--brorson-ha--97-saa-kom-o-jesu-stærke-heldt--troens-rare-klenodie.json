{
  "id": null,
  "title": "97. Saa kom o JEsu, stærke heldt",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
