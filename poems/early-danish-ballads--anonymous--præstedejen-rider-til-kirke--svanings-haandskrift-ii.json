{
  "id": null,
  "title": "Præstedejen rider til kirke",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift II",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVII5.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Præsten vogner om midinat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc hand begynt at plader:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "\"Vel op alle mine mend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "I binder op heste haller.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: Vor deie hun vil ride i dag til kircken ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Der de kom for offuen by,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "de hørde de klocker kling:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "\"Rider fast, Peder Scriffuer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "och ladt icke præsten siunge.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": ":: Di siger her kommer fruer i dag til kircken. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Der hun kam til stette,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "der bandt hun hindis hest:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "\"Huor er nu min danne suend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": ":: Der mig skal løffte oc lette i dag ved kircken. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Der hun ind at kircken kam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "hun haffde saa hoffue teme;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "hun slog ned den store taffle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "som før vaar van at heng.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": ":: Oc hui mon ieg saa bang i dag i kircken. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Der hun ind i kircken kam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "da kneppett hun en;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "før hun kam i alter gul,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "da slog hun tu for en.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": ":: Oc hui maa ieg saa nyusz i dag i kircken. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "Hun tog peng vdaff hindis pung,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "hun offert saa vel til føye;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "hun slog synder vor præstens laar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "hun stack vd vor degens øye.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": ":: I mindis her vaar fruer i dag i kircken ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": "Meszen vaar vdsiungen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "oc saa den lange lest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "vd gick alle de hoffmend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "oc huer til hest.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": ":: Effter kam den deie gangen aff kircken. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 7,
      "text": "Som de rend i hiszel riisz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "som pot fødder i leir;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 7,
      "text": "somme hol hender for nese oc mund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": "fra østen kam den veyr.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 7,
      "text": ":: Hui mon her saa bles y dag ved kircken. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}