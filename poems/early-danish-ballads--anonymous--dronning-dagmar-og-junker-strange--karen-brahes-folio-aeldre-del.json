{
  "id": null,
  "title": "Dronning Dagmar og Junker Strange",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA194.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Konngenn och Sttrange thy sad offuer buord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": ":: - Saa mange forgylldenne flyø. - ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "thy snackitt saa mangett gamells-ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Saa seegliger</div> hand iuncker Sttranngy mod iumfru Daumuor. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "\"Hør thu, Strange, huad ieg sigger deg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "thu skaalt ind till Bier-land och feste enn iumfru for meg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Tthett suaridtt iuncker her Strangy, hand war saa snard y suard:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "\"Om ieg skaall till Bier-land, huem skaall daa med mieg faare?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "\"Tthag dw heerre Lieembeck vd-aff Agersz-husz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "der-till Oluff Lycke och saa hinde rige Pedder Globb!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "Bespenn vd-aff Seeland, hand er enn mand saa frum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "her Albuett aff Eskehollenn, synn ord weell føffue kaand.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "\"Der-till thøll rider lader y med meg faare!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 5,
      "text": "och tøll paar kleder lader y meg skeerre!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "Thrørenn skaall werre aff heemels-blodtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "och kiortelenn skal were aff silcke smaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "Ermenn skall werre aff aager-vld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 7,
      "text": "och kraffuerenn skaal were aff spunddenn guld.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "Sttrannge hand gick niedder till denn strand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 8,
      "text": "hanom fulde kong Wollemuor med alle synne mend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "Tthi wonnde op sylcke-seegell y forgyldene ruo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 9,
      "text": "thy seglitt tiell Bierr-land y maanitt thuo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "Tthi kaaste dieris acker paa huidde saand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 10,
      "text": "Sttrangi hand thrend der først y laand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "Mieette paa saannd skieeckett dy deris buod:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 11,
      "text": "thett thi maatte kome kongenn aff Bieer-land till ordd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "Weell daa suaritt denn eddelig herre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 12,
      "text": "saa giernne daa matte dy tiell hanom faarre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "Mette y gaarddenn der axeliett dy skieend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 13,
      "text": "dy gaar y lofft for kongen ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "\"Her seedder y, kongenn, offuer eders buord!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 14,
      "text": "kongen aff Danmarck haffuer seendtt edder ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "Hand seendde edder skeenck och riggenn gaffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 15,
      "text": "hand begierdde ridders datter till droning att haffue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "\"Ttha skaall y faa anmsuar med thett første:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 16,
      "text": "ieg well først raade alt med mynn beeste.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "Kongenn gaar y hyffueloff och rader med droning synn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 17,
      "text": "\"Kongen vd-aff Danmarck beedder om kierr datter mynn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 18,
      "text": "\"Veell konngenn aff Danmarck wor datter haffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 18,
      "text": "wy giffuer hanom hinder med erre och der-till rige gaffue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 19,
      "text": "Thi kledde hynnder y rødde guld, fulde hynder y stuoffuen ind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 19,
      "text": "\"Skaufftaffuell maa y nu liegge med kerr datter mynn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 20,
      "text": "Tthett taffuelbuord waar aff guld hynd riegne:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 20,
      "text": "here Strannge skulde lieege med den frøckenn allieenne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 21,
      "text": "Tthi drog thaggell aff røde guld:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 21,
      "text": "her Strangi wand denn frøckenn tiell alle Danmarckis wolld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 22,
      "text": "\"Sygger meg, her Strangi, huad ieg eder spør:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 22,
      "text": "er kongenn aff Danmarck saa weenn</div> som y er?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 23,
      "text": "Her Stranngi hand seeg till suollenn suo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 23,
      "text": "\"Hand er fast skønner innd mine thøøll.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 24,
      "text": "\"Hør y, her Stranngi, huad ieg sigger edder:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 24,
      "text": "er ederes herre saa rig, som Bieer-kongen er?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 25,
      "text": "\"Mynn herre hand haffuer enn fieske-daam:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 25,
      "text": "thennd rentter miere ind alle Biere-kongens land.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 26,
      "text": "Tther bleff sylcke paa iorddenn bred:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 26,
      "text": "thend frøckenn bleff til strandenn lieed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 27,
      "text": "Tthi lagde skibb fraa lande, thi wore buode glaad och fruo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 27,
      "text": "tthi seglitt till Danmarck y maanetter thuo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 28,
      "text": "Tthennd frøckenn kaam der segglind till land:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 28,
      "text": "kong Wollemuord render synn ganger paa saannd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 29,
      "text": "\"Sigger meg, her Sttrangy, førind ieg komer tiell land:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 29,
      "text": "huem er denn skieelle suend, der rider paa huidenn saannd?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 30,
      "text": "\"Mynn naadige frøckenn, y sigger icke saa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 30,
      "text": "tthett er den herre, alld Danmarck aae.\"</div>",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 31,
      "text": "\"Skaam faa y, herr Stranngy, huor kaand y lyffue!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 31,
      "text": "tha haffuer kongen aff Danmarck icke for-vdden ett yøe.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 32,
      "text": "\"Mynn naadige frøckenn, werer gladd och fruo!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 32,
      "text": "y skaall thett aldrig for-tøcke, imen y løffue maa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 33,
      "text": "Allee dy dage, ieg løffuer, weell ieg eders thieener were:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 33,
      "text": "och alle denn aaadell y Danmarck dy skaall edder buode hieder och erre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 34,
      "text": "Der bleff sillcke paa iorddenn bred:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 34,
      "text": "thennd frøckenn hun bleff y landenn lieed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 35,
      "text": "Kongenn hand thog hynder y synn arum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 35,
      "text": "hand gaff hinder guld-kronne och droninge-naffuen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 36,
      "text": "\"Skaall ieg droning y Danmarck werre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 36,
      "text": "Chrest giffue denom alle buodde hieedder och erre!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 37,
      "text": "Skaall ieg droning y Danmarck bliffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 37,
      "text": "Chrest segnne denom alle, buod faattig och rige!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 38,
      "text": "Dy drocke thett brølup med gled och ruo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 38,
      "text": ":: - Saa mange for-gylddenne flyø. - ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 38,
      "text": "thi gaff her Strange bode guld och dyrre gaffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 38,
      "text": ":: Saa seggler hand iuncker Strangi imud frøckenn Daunnor.</div> ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}