  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "NW er fød oss Jesus Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Aff een Jomffru thet er wist/",
      "part": false,
      "marginal_notes": [
        "Math. j. Luce: ij."
      ]
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Forwden mands beblandelse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Er han kommen aff høgeste:",
      "part": false,
      "marginal_notes": [
        "Math. j. Luce. j. Ezech xxvij Psal. cxiij."
      ]
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Wor salighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Gud med oss .",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Then bebudede Gabriel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Ther till er witne Ezechiel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Han kom til oss wor frelsere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "¶ Gud faders søn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Fuldkommen er nw Dauids dicht/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Ther till oc saa Propheternis schrifft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Christus er thet Engelske liwss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Som hiwrderne soge ÿ krybben laa.",
      "part": false,
      "marginal_notes": [
        "Luce. ij."
      ]
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "¶ Eet menniske.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Then som kom aff himmelen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "Han atsporde mennisken/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "Ey qwinne eller nogen mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "forderffue nogen tÿd wille hand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "O miskundhed.",
      "part": false,
      "marginal_notes": [
        "j. Petri. ij."
      ]
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "J Christne børn forsamles nw/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "Med Christ eder broder wærer glade oc froo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "Giffuer hannwm loff wor Konning wÿss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "Som oss forhwerffde then ewig prÿss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": ".",
      "part": false,
      "marginal_notes": []
    }
  ]
}