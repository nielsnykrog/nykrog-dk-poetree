    "year_published": 1555,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/BILL7.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Here Nellafs oc here Tidemand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "di vare stal-brødre med villi;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "den var icke i verden til,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "der dem kunde bode at-skilli.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: Herre Nelafs oc here Tidemand. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Den var icke i verden til,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "der dem kunde bode at-skilli,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "for-uden I iomfru i droningens gor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "di hade til bode god villi.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Der tiener I iomfru i droniningens gor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "hun heder iomfru Ingeborig;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "here Nellafs oc here Tide-mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "di baree for hinde stor sorig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Here Tidemand rider til Sverig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "ville vide sin frenders villi;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "here Nelafs hand blef føre rede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "hand feste den vene lili.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Sillig om den aften",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "hun tog ofver seg skarlagen-skind;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "hun hade ackted seg til her Nellefs søster at gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "here Tidemand tog hinde ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Det var here Tidemand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "slar ofver hinde skarlagen-skind;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "saa fullde hand hinde i høfved-loft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "der fremede hand villi sin.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Saa saare greder iomfru Ingeborig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "saa lønlig ved seg ene;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "det sporde here Nelafs,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "oc saa rider hand til hinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Hand tog hinde listelig i sin arm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "klapede hinde ved hviden kind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "\"Det er icke I maaned, sin ieg eder feste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "hvi falner eders rosen-kind?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Lenge stod iomfru Ingeborig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "oc hinde rand tore af kind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "\"Skam faa here Tidemand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "hand hafver fremed villi sin!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "\"I greder icke, iomfru Ingeborig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "den aller-veneste lilli!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "ieg hafver eder alt lige ker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "men det var i-mod eders villi.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Det var here Nelafs,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "hand lader sit brølop bo;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "det var here Tidemand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "hand lader sin gangere sko.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Her Nellafs han lader sit brøllop bo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "det koster ham søllet hint hvide;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "her Tidemand lader sin gangere sko,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "til brølopet ville hand ride.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "Droniingen ber alle sine mend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "ride med for-teckte ørs:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "\"I gøre den lili den her i-dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 12,
      "text": "men hun er faderløs!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "Sillig om den aften",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "di fulde den brud til at sofve;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "her Tidemand hand tallede i brude-hus",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 13,
      "text": "di ord, hand mote vel lade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Here Tidemand tallede i brude-hus",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "di ord, hand mote vel lade:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "\"Nu gor du med min sligefred i seng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 14,
      "text": "der ieg til-foren ote.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "Bruden seder i brude-seng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "oc greder hun i-saa saare;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "hun ber til den øfverste Gud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 15,
      "text": "det hun i ioren vare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "\"I greder icke, iomfru Ingebore,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "i hafve ret ingen møde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "ieg skal tage here Tidemand af dage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 16,
      "text": "alt i sin ferste grøde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "I greder icke, iomfru Ingeborig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "den aller-veneste lili!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "ieg skal tage here Tidemand af dage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 17,
      "text": "nor ham løste helst at lefve.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "Det var om someren der-efter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "det var om somersens tide:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "det var here Tide-mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 18,
      "text": "hand løster da ud at ride.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "Det var here Tide-mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "hand red seg uunder øø;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "hand feste her Adelkinds dater,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 19,
      "text": "det var saa venen mø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "Her Tidemand lader sit brølop bo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "det koster ham sølet hint hvide;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "her Nelafs lader sin gangere sko,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 20,
      "text": "til brølopet ville hand ride.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 21,
      "text": "Det var here Nelafs,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "rider i den brølops-gor;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 21,
      "text": "ude stor liden tieneste-mø",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 21,
      "text": "med silcke-fleted haar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 22,
      "text": "\"Hil stor du, liden tieneste-mø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 22,
      "text": "med silcke-fleted haar:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 22,
      "text": "i hvilcket hus sover her Tide-mand i,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 22,
      "text": "der brølop hade i-gor?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 23,
      "text": "\"Her Tidemand sover i høget-loft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 23,
      "text": "alt som ham fuld-vel sømer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 23,
      "text": "her Adelkind han sofver der uden-for,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 23,
      "text": "saa gode da hafver han geme.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 24,
      "text": "Støte hand paa brudehus-dør",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 24,
      "text": "alt med sin skarlagen-skind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 24,
      "text": "\"Stat op, here Tide-mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 24,
      "text": "du lad meg til dig ind!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 25,
      "text": "Han stack ham ind at skuldre-blad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 25,
      "text": "det oden i hierted vende:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 25,
      "text": "\"Der har du en elskofs-skaal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 25,
      "text": "din sligefred hun dig sende.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 26,
      "text": "Bruden seder i brude-seng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 26,
      "text": "oc greder hun i-saa saare:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 26,
      "text": "\"Give Gud-fader i Himerige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 26,
      "text": "det ieg i ioren vare!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 27,
      "text": "\"I greder icke, liden Kirstin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 27,
      "text": "i sører icke saa saare!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 27,
      "text": "ieg ved en halle venere lili,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 27,
      "text": "hun feller fast flere taare.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 28,
      "text": "Han red seg til vindvet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 28,
      "text": "oc ind der han saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 28,
      "text": "saa skøn da var den iomfru-dans,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 28,
      "text": "der gick inden-for.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 29,
      "text": "\"Lade i fare dansen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 29,
      "text": "oc lade i falle leg!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 29,
      "text": "gaa i eder i brude-hus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 29,
      "text": "i klede her Tidemands lig!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 30,
      "text": "Det var here Nelafs,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 30,
      "text": "rider i sin egen gor;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 30,
      "text": "ude stod skøne fru Ingeborig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 30,
      "text": "hun felte saa modige taar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 31,
      "text": "\"Gack hid, stalten Ingeborig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 31,
      "text": "du tag meg i din arm!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 31,
      "text": "ieg hafver veyet here Nelafs,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 31,
      "text": "der dig hafver giort den harm.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 32,
      "text": "Det var stalten Ingeborig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 32,
      "text": "hun gred oc hender slo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 32,
      "text": "\"Før hade ieg en hierte-sørig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 32,
      "text": "for eder da hafver ieg to;\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 33,
      "text": "Di bøde i-gen here Tidemand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 33,
      "text": "alt bode med ager oc ior;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 33,
      "text": "saa gafve de liden Kierstine",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 33,
      "text": "here Nellafs broder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 34,
      "text": "Di bøte i-gen here Tidemand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 34,
      "text": "alt bode med ager oc eng;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 34,
      "text": "saa gafve di liden Kirstine",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 34,
      "text": "her Nelafses broder i-gen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 34,
      "text": ":: Here Nelags oc here Tide-mand. ::",
