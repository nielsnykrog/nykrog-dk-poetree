  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Hvad er det got, i JEsu arme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Som skiøde-barn at sove ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Og ved hans naades bryst sig varme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Med et fra sorg befriet sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Hvad vil du dig med frygt besvære?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Gud kand din sorg allene bære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Hans trofasthed omskiftes ey,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Hand er dig altid troe forbleven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Og har sig med sit blod forskreven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "At føre dig den rette vey.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Hvor daarligt: som en hedning fare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "I alle kummers torne ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Du kunde jo den møye spare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Og favne JEsum i dit sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Da skulde sorgen selv sig glemme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Og du en liflig roe fornemme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "At see hvad hand fra evighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "For kierlighed har til dig baaret,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Som jo endnu er ubeskaaret,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Og evig, evig bliver ved.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Hvad vil du gremme dig for livet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Og hvad der hører livet til?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Gud, som dig har det første givet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Dig og det andet give vil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Den, sielen himmel-spise rekker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Og med sin JEsu purpur dekker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Som er saa hierte-huld og troe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Skal ogsaa nok din krop betænke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "At du dig derfor ey tørst krænke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "Men lade det paa Gud beroe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Umælende dig det kand sige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Naar du dig dem kun stiller for,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "Da seer du i Guds almagts rige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "Hans forsyns vey og klare spor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "Den lille fugl vor HErre nærer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "Sig aldrig over trang besværer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "Er altid lystig, mild og vel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "Giør mark og skov til paradiser,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "Og meer, end vi, vor HErre priser,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "At vi maae skamme os ihiel.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "See lilien i grønne dale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "Hvem har vel smykket denne bruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "Hun skulde, om hun kunde tale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "Dig skielde for en tidsel ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "Blant torne seer du rosens ynde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 4,
      "text": "At den dig vil til troen skynde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 4,
      "text": "Og alle blomsters rare top",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 4,
      "text": "I tal og skiønhed uden ende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 4,
      "text": "Som alle sig mod himlen vende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 4,
      "text": "Og vise dig til Gud hen op.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 5,
      "text": "Der seer man dem i deres smykke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 5,
      "text": "Som alle tider mildt at lee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 5,
      "text": "At Salomon i al sin lykke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 5,
      "text": "Ved dem kun ringe var at see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 5,
      "text": "Kand Gud et græs saa høyt begave,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 5,
      "text": "Hvad skal du da, min siel, vel have",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 5,
      "text": "For prydelse og herlighed?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 5,
      "text": "Som har den beste skiønhed arvet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 5,
      "text": "Og est med blodet purpur-farvet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 5,
      "text": "Som flød af JEsu vunder ned.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 6,
      "text": "Den deel vi bruge her i live,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 6,
      "text": "Er ikke megen kummer værd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 6,
      "text": "Een ting er nødig ret at drive,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 6,
      "text": "Og tage sig af hiertet nær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 6,
      "text": "Hvor mangen gaaer med suk, og klager",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 6,
      "text": "For det, som Gud sig selv antager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 6,
      "text": "Og bærer sorgen i sit bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 6,
      "text": "Da tit, naar ingen redning kiendes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 6,
      "text": "Ved hannem al vor jammer vendes",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 6,
      "text": "Til hiertens glæde, fryd og lyst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 7,
      "text": "Saa hviil, min siel! foruden plage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 7,
      "text": "Saa stille i din JEsu skiød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 7,
      "text": "Lad dig den glæde ey betage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 7,
      "text": "Men glæd dig derved til din død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 7,
      "text": "At Gud i Christo dig udvaldte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 7,
      "text": "Og alle dine taarer talte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 7,
      "text": "Har maalet al din gang og vey,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 7,
      "text": "O lad dig det dog eengang sige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 7,
      "text": "Din Gud, hand kand dig aldrig svige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 7,
      "text": "Ney! Gud allene sviger ey.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
