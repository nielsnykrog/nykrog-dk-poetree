{
  "id": null,
  "title": "83. Hvad er det got, i JEsu arme",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
