{
  "id": null,
  "title": "63. Kom regn af det høye! lad jorden oplives",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
