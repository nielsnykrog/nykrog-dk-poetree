{
  "id": null,
  "title": "Stolt Elins Hævn",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA28.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Thett war bollde her Renneld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hand red seg vnder ø:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "hand fester her Bundis datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "saa wen enn mø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: Hun sueg hanom y søffne. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Hand feste her Bundis datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "hand førde hind hiem:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "kongenn och wor erike-besp",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "thi red med dem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Och saa forde thi thend vnge brud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "y here Rienelds gaard:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "ther war icke thett røde guld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "for liegeren spardt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Saa fulde dy den vnge brud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "y sallenn ind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "for gick rider och suene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "dy bar hindis skiend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Och saa saatte dy den vnge brud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "paa brude-benk:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "frem gar rider och suene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "dy baar hindis skieenck.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Op stuod stuod staltenn Ellind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "hun tog seg kanden y hand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "saa gaar hun att skencke wyn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "men dagen waand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Saaa gaar hun att skencke win,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "men dagen wand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "saa wredlig tog hun søleff-kar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "aff brudens hand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Saa skenckitt dy vd denn klarre winn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "men suollen skiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "sildig om den afften fulde dy",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "bruden til senge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Saa fulde dy den vnge brud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "til brwde-husz:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "for gaar rider och suene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "dy bar dy blasz.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Saa satte dy den vnge brud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "y brude-seng:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "op stuod bolde her Renoldt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "hand duelde icke lenge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Alle daa monne thett guode folck",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "aff brude-husz gaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "for-vden stalten Ellind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "stuod vnder thett silcke smaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Tthett melltte bolde her Renoldt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "alt som hand luo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "\"Well y meg nu sigge, myn vnge brud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "men wj er iene thuo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "I siger meg nu thett, min vnge brud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "saa wen en wand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "huor-lunde løster eder att suoffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 12,
      "text": "huosz en troløsz mand?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "Alle myn chrestelig tro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "der Gud gaff meg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "denn gaff ieg staltenn Ellind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 13,
      "text": "førind ieg loffued deg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "\"I-men y haffde saa høffsk en mord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "i garde huosz eder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "huy red y daa till myn faders gard",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 14,
      "text": "och bad om meg?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "I-men y haffde saa høffske en mord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "y eders buo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "huy red y da till min faders gard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 15,
      "text": "gaff meg eders tro?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "\"Ieg wilde icke med stalten Ellind løffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "det sleffred-lyff:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "for-dy loffuet ieg eder, iumfrw Daamorr,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 16,
      "text": "till myn egtte-wyff.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "Dett suarid iumfru Daamor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "saa dydellig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "\"Saa well matte stalten Ellind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 17,
      "text": "haffd werit eders lig.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "Icke weste bolde her Reneldt anditt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "ind dy war enne tho:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "stallt Ellind hun stuod y brude-husz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 18,
      "text": "hun liuder der-paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "Tthett wor i thend første søffuen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "her Renoldt feck:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "thett wor stalten Ellend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 19,
      "text": "til brudseng gick.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "Hun drog vd forgyldene knyff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "aff erme rød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "hun slog till herre Renoldt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 20,
      "text": "thett hand bleff død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 21,
      "text": "Op daa wognet den vnge brud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "och wegnet hun seg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 21,
      "text": "\"Ieg beder theg for thend øffuerste Gud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 21,
      "text": "du sla icke meg!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 22,
      "text": "\"Haffde thett icke walditt denn guode ord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 22,
      "text": "thu suaridt for meg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 22,
      "text": "thend same død, her Renoldt feck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 22,
      "text": "haffde ieg actitz deg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 23,
      "text": "Sett du nu op dyn guld-krone",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 23,
      "text": "och din røde guld-baan!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 23,
      "text": "sa sandelig kamst du iumfru guod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 23,
      "text": "fraa Renaldts haand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 24,
      "text": "Skøndtt deg nu till dyn fader hiem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 24,
      "text": "och ber guld saa rød!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 24,
      "text": "thu komer wedst aff her Renoldts gard",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 24,
      "text": "saa wen en møø.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 24,
      "text": ":: Hun sueg hanom y søffuene. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}