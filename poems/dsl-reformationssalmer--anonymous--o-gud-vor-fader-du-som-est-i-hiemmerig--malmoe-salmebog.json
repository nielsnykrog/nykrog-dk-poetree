  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Gud vor Fader du som est i hiemmerig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "høgt offuer oss oc aandelig vilt du tilbeden vorde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "dit hellige naffn lad nu vdspress saa weldelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "ath det kan være priseligt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "i hiemmelen oc paa iorden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "dit Rige ttlkomme oss naadeligt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "som oss kan freden giffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "oc huess dig ey er",
      "part": false,
      "marginal_notes": []
    }
  ]
}