  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Hu, hu! hvor Du bider, Du skarpe Vind.",
      "part": false,
      "marginal_notes": [
        "Speaker: Drengen:"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Jeg vil kun kysse din røde Kind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Af saadanne Kys faar man hastig nok.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Ej Snak, jeg leger kun med din Lok.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Du Tyv, nu løber Du med min Hat!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Jeg vil kun lege med Dig Tagfat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Men Stormen dansed med Sus og Brus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "over Kongens Slot og Fattigmands Hus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Da titted Drengen fra Hyttens Rude:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Nu er vist Vorherre vred derude.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Nej, svared Moderen mild og glad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "men Storm og Solskin maa følges ad.",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
