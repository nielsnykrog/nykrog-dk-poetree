{
  "id": null,
  "title": "91. O JEsu, som har elsket mig",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
    "wiki": "Q348003"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Troens Rare Klenodie",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1739,
    "url": "https://tekstnet.dk/books/brorson-ha_troens-rare-klenodie/093/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O JEsu, som har elsket mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Ja med saa overmaade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Aldeles ubegribelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "En kierlighed og naade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "O tænd mit hierte an igien",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Med kierlighedens iver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "At jeg giver",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Mig gandske til dig hen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Og stedse hos dig bliver.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "O lad dog kierlighedens brand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Mit hierte saa indtage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "At uden dig mig intet kand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "I denne verden smage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Stød alting af mit hierte ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Som sielen vil forvende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Fra at brænde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Som din forelskte bruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Til livets sidste ende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Hvad er din kierlighed dog sød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Og meest i korsets plager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Hun giør, at baade nød og død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Saa vel som honning smager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Saa giv, at jeg ey andet veed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Ey tænker, hører, lærer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Elsker, ærer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "End denne kierlighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Som JEsus til mig bærer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Gid jeg, min skat, dig maatte heel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Til evig eye nyde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Og al mit hiertes inderdeel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "I dine luer syde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "O lad mig vaage dag og nat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "At ingen lyst og plage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "Skal borttage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "Dig, søde himmel-skat!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "I alle mine dage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "Det var jo idel kierlighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "Der bragte mig den naade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "At man dig allevegne sleed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "Paa mordisk viis og maade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "Ach maatte jeg din pines sag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "Hver smerte, hver en vunde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "Ret begrunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "At sielen nat og dag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "Af længsel bløde kunde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "Hvor reent og kraftigt er dit blod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "Du lodst paa korset flyde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "Hvor giftig er jeg derimod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 5,
      "text": "Og haard som staal og spyde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 5,
      "text": "Saa lad dit blod med kierlighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 5,
      "text": "Min arme siel besprenge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 5,
      "text": "Giennemtrænge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 5,
      "text": "At jeg ey andet veed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 5,
      "text": "End kun ved dig at hænge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "O! at mit hierte aaben stod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "For dine piners vinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 6,
      "text": "At regne JEsu sveed og blod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 6,
      "text": "I alle mine sinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 6,
      "text": "O! at mit øye som en strøm",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 6,
      "text": "Med taarer kunde rinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 6,
      "text": "Dig at minde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 6,
      "text": "Hvor hierte-vee og øm",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 6,
      "text": "Jeg er, for dig at finde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "Gid jeg dig fuldte ud og ind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 7,
      "text": "Med børne-graad og klage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 7,
      "text": "Til du bevæge lodst dit sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 7,
      "text": "Mig i din favn at tage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 7,
      "text": "At du, min længsel, Gud og mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 7,
      "text": "Saa liflig, som den søde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 7,
      "text": "Morgenrøde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 7,
      "text": "I kierlighedens brand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 7,
      "text": "Mit hierte vilde møde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 8,
      "text": "O drag mig, tag mig, hør mig til,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 8,
      "text": "Jeg lader mig ey tysse,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 8,
      "text": "Før jeg saa meget, som jeg vil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 8,
      "text": "Dig favne kand og kysse.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 8,
      "text": "Jeg af din søde rosen-mund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 8,
      "text": "I ordet vil fornemme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 8,
      "text": "Naadens stemme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 8,
      "text": "Saa er jeg glad og sund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 8,
      "text": "Og kand min nød forglemme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 9,
      "text": "Min trøst, mit lys, min beste ven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 9,
      "text": "Og største lyst i livet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 9,
      "text": "O hav mig, tag mig gandske hen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 9,
      "text": "Dig har jeg mig hengivet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 9,
      "text": "Thi uden dig jeg billig maa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 9,
      "text": "Den gandske verden kalde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 9,
      "text": "Gift og galde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 9,
      "text": "Ey værd at tænke paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 9,
      "text": "Langt mindre at befalde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 10,
      "text": "Men du est sielens trygge havn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 10,
      "text": "Mod alle modgangs vinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 10,
      "text": "Ach! lad mig i din naades favn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 10,
      "text": "Den rette hvile finde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 10,
      "text": "Din kierlighed, som ild i blaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 10,
      "text": "Mit hiertes trang fortære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 10,
      "text": "Balsom være",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 10,
      "text": "For mine synde-saar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 10,
      "text": "Som mig saa haardt besvære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 11,
      "text": "Hvad er der, som jeg ey udi",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 11,
      "text": "Din kierlighed kand tage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 11,
      "text": "Den er min soel paa vey og stie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 11,
      "text": "Min kilde sød at smage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 11,
      "text": "Min rare viin og himmel-brød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 11,
      "text": "Mit klæde for Guds throne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 11,
      "text": "Priis og krone,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 11,
      "text": "Min trøst i al min nød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 11,
      "text": "I velstand fryde-tone.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 12,
      "text": "Jeg vilde heller være død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 12,
      "text": "Ja, bare røg og avne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 12,
      "text": "Jeg ønsker, at jeg ey var fød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 12,
      "text": "Om jeg dig skulde savne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 12,
      "text": "Saa lær mig da, o søde lyst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 12,
      "text": "At jeg dig ret kand finde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 12,
      "text": "Ret kand vinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 12,
      "text": "Og aldrig af mit bryst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 12,
      "text": "Dig savne nogensinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 13,
      "text": "Du elskte mig af evig tiid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 13,
      "text": "Min sag at vilde føre;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 13,
      "text": "Før jeg fik viist den mindste fliid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 13,
      "text": "Din villie at giøre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 13,
      "text": "Indfandt sig strax din kierlighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 13,
      "text": "Ved haanden mig at tage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 13,
      "text": "Og ledsage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 13,
      "text": "I verden op og ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 13,
      "text": "Som det dig kand behage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 14,
      "text": "Saa lad den stand, hvori jeg staaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 14,
      "text": "Din kierlighed kun smykke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 14,
      "text": "Og hvor jeg lidt af veyen gaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 14,
      "text": "Mig strax tilbage rykke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 14,
      "text": "Lad den ved al min verk og daad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 14,
      "text": "Som lyset, for mig brænde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 14,
      "text": "Ret at kiende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 14,
      "text": "Og følge dine raad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 14,
      "text": "Til livets sidste ende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 15,
      "text": "Lad hende trøste mig i trang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 15,
      "text": "I svagheds tiid mig styrke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 15,
      "text": "Og naar jeg endelig engang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 15,
      "text": "Skal ind i dødens mørke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 15,
      "text": "Da lad din kierlighed staae bi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 15,
      "text": "Sig stille ved min side,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 15,
      "text": "Med mig stride,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 15,
      "text": "Saa gaaer jeg glad og frie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 15,
      "text": "Fra hele verdens qvide.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
