  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Den vaade Taage hænger dorsk over Mark og By,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Det gider ikke regne engang fra sorten Sky;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Selv Gaardens Ænder ligge saa tause hver og een,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Med Hovedet bag Vingen og ligne Kampesteen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Ja Bedstemoer i Stolen smaanikker, sover ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Den smukke Datterdatter med Haanden under Kind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Har gabet fire Gange, jeg veed hvad det spaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "See, over Brystet falder det lange gule Haar;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Jeg selv sidder søvnig med Benene paatvers,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Jeg gider ikke læse i mine egne Vers!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
