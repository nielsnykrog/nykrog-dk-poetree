  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "HErren sagde til mÿn Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "sid hooss mÿn høgre hand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Saa lenge ieg legger thÿne fiende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "een fodskammel vnder thÿne fødder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "Herren skall wdsende aff Sion thÿn sterckheds spÿr/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "haff herredømme mit iblant thÿne fiender.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Thit folk skal ther wære welwilige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "wdi hellige smøcke paa thÿn sterckheds dag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "Vdaff moders lÿff skall komme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "thÿn fødelsis dwg med morgen stund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 5,
      "text": "Herren haffuer sorid oc thet hannwm icke angrer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "tw æst effter Melchizedecks skick/ een prest ewindelig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 6,
      "text": "Herren wid thÿn høgre hand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "skall slaa konger paa grumheds dag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 7,
      "text": "Han skal dømme iblant hedningerne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "opfylde dale med døde kroppe:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "oc sønder slaa ett howid offuer mange lande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "Han skall dricke paa wæyen aff een bæck/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "ther fore skall han opløffte howedet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "Aere wære Gud fader oc Gud Søn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "oc Gud then Helliaand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 10,
      "text": "Som wærit haffuer aff begyndelsen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "nw oc altÿd/ oc bliffuer til ewig tÿd. AMEN.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 11,
      "text": "HWor fore stormede the hedninge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "oc folkene beramede vnyttige raad?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 11,
      "text": "Jorderigis konger haffue seg besterckede oc ere forsamlede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 11,
      "text": "mod Herren oc hans smurde mand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 12,
      "text": "Lad oss sønder bryde theris band/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 12,
      "text": "oc bortkaste theris aag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 13,
      "text": "Then som haffuer sÿn bolig wdi himmelen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 13,
      "text": "skall thennom bespotte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 13,
      "text": "oc Herren skall thennom haanlige foriage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 14,
      "text": "Tha skall han thennom wredelige tiltale/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 14,
      "text": "oc thennom ÿ sÿn grumhed forskrecke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 15,
      "text": "Men ieg haffuer skickit mÿn konge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 15,
      "text": "offuer mit hellige bierg Sion.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 16,
      "text": "Jeg skall predicke Guds bud att Herren sagde til meg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 16,
      "text": "Tw æst mÿn søn/ ÿ dag fødde ieg teg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 17,
      "text": "Eske aff meg oc ieg skall giffue teg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 17,
      "text": "the hedninge for een arff/ oc almwen till een eyedom.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 18,
      "text": "Thennom skaltu sønderbryde med een iernspÿr/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 18,
      "text": "oc som eet leerkar sønderslaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 19,
      "text": "Saa skulle ÿ konger nw wære klaage:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 19,
      "text": "oc lader eder vnderwÿse som ere iorderÿgis dommere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 20,
      "text": "Tiæner Herren wdi frøcht/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 20,
      "text": "oc glæder eder ÿ hannwm med een skelffwende fare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 21,
      "text": "Kysser sønnen att han skal icke worde wred/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 21,
      "text": "oc ÿ saa tabe weyen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 22,
      "text": "Nar hans grumhed begynder nogit att brende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 22,
      "text": "tha lider thennom wel som sette theris loffue till hannwm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 23,
      "text": "Aere wære Gud fader oc Gud Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 23,
      "text": "oc saa Gud then Helliaand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 24,
      "text": "Som wærid haffuer aff begyndelsen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 25,
      "text": "HErre hwem skall haffue sÿn bolig wdi thit pawlun?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 25,
      "text": "oc hwem skall bliffue paa thit hellige bierg?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 26,
      "text": "Then som wandrer forwden smitte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 26,
      "text": "oc then som giør retferdighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 26,
      "text": "oc wdaff sitt hierte taler sandhed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 27,
      "text": "Then som icke haffuer belackid med sÿn tunge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 27,
      "text": "oc icke giord sÿn næste ont oc førd hannwm paa nogen haanhedt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 28,
      "text": "The vfromme forachtis wdi hans øghen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 28,
      "text": "men thennom som frøchte Gud giør han ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 29,
      "text": "Then som loffuer sÿn næste med eed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 29,
      "text": "oc forwandler thet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 30,
      "text": "Then som icke wdgiffuer sÿne penninge paa aager/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 30,
      "text": "oc icke tager smwgeset offuer then vskyldige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 31,
      "text": "Hwo som thette giør/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 31,
      "text": "han skal aldrig forfaris.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 32,
      "text": "Aere wære Gud fader etc.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 33,
      "text": "KOm Helliaand herre Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 33,
      "text": "opfyld med thÿn naade oc miskund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 33,
      "text": "thÿne Christnes hiærte/ hw/ oc sind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 33,
      "text": "thÿn brendendis kierlighed ÿ thennom optend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 33,
      "text": "O Herre med thÿn naadis liwss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 33,
      "text": "ther med bepryd wort hiertis hwss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 33,
      "text": "hent tilsamen som ÿ werden boo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 33,
      "text": "aff alle tungemaal til een tro",
      "part": false,
      "marginal_notes": [
        "Actu. ij:"
      ]
    },
    {
      "id": 77,
      "stanza_id": 33,
      "text": "Alleluia Alleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 34,
      "text": "Tw hellige liwss oc wÿsdoms port/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 34,
      "text": "lad oss opliwsis med liffzens ordt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 34,
      "text": "oc lær oss Gud rett alle att kende/",
      "part": false,
      "marginal_notes": [
        "Math. vj. Rom. viij."
      ]
    },
    {
      "id": 81,
      "stanza_id": 34,
      "text": "aff hiertens grund hannwm fader att kalde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 34,
      "text": "O Herre beskerm oss fraa fremmede lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 34,
      "text": "att wÿ ingen mestere atspørrie meere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 34,
      "text": "en Jesum Christum wor frelsere kiære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 34,
      "text": "att wor tro kunde till hannwm allene wære",
      "part": false,
      "marginal_notes": [
        "Luce. j."
      ]
    },
    {
      "id": 86,
      "stanza_id": 34,
      "text": "Alleluia loffuer Herren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 35,
      "text": "Tw hellige ild oc søde trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 35,
      "text": "hielp oss nw ÿ all wor brøst/",
      "part": false,
      "marginal_notes": [
        "Joh. xiiij. oc. xvj."
      ]
    },
    {
      "id": 89,
      "stanza_id": 35,
      "text": "thÿn wilie altÿd effter att følge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 35,
      "text": "oc ingen modgang oss lade fraa teg skillie/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 35,
      "text": "O Herre med thÿn guddoms krafft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 35,
      "text": "styrck oss vsle oc giff oss macht/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 35,
      "text": "giennom sorrig oc bedrøffuelse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 35,
      "text": "att komme til teg wor frelsere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 35,
      "text": "loffuer Herren Alleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 36,
      "text": "O sandheds kielde oc hiertens frygd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 36,
      "text": "med aandelig smycke wort hierte bepryd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 36,
      "text": "att wÿ ÿ haab oc Christelig tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 36,
      "text": "med Gud oc wor næste ÿ kierlighed boo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 36,
      "text": "O hiertens Herre oc aandelig lÿff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 36,
      "text": "bestrÿd ÿ oss all syndzens kiff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 36,
      "text": "Skenck oss thÿn gunst oc staat oss bÿ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 36,
      "text": "att wÿ ey falle ÿ then aandelig krÿ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 36,
      "text": "Alleluia loffuer Herren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 37,
      "text": "O Gud allene wor hiertens trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 37,
      "text": "aff tho ÿ oss all syndzens brøst/",
      "part": false,
      "marginal_notes": [
        "j. Pet. j."
      ]
    },
    {
      "id": 107,
      "stanza_id": 37,
      "text": "Thÿn ild/ thit wand/ thit sandheds liwss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 37,
      "text": "lad brende oc tho wort aandelig hwss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 37,
      "text": "O Herre Gud ÿ ewighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 37,
      "text": "wÿ tacke thÿn barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 37,
      "text": "bewar ÿ oss thet tw haffuer giord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 37,
      "text": "med aandelig krafft oc hellige ord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 37,
      "text": "loffuer Herren Alleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 38,
      "text": "WAre Gud icke med oss thenne tÿd/",
      "part": false,
      "marginal_notes": [
        "Exod. xiiij."
      ]
    },
    {
      "id": 115,
      "stanza_id": 38,
      "text": "saa skal Jsrael sige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 38,
      "text": "Ware Gud icke med oss thenne tÿd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 38,
      "text": "wÿ hadde lid angist oc qwide/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 38,
      "text": "Gud saa the Christne store oc smaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 38,
      "text": "aff mange wantro foractis saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 38,
      "text": "ther thennom monne saare forfølge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 39,
      "text": "The menniske ere ÿ hw saa wrede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 39,
      "text": "the reese thennom mod oss alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 39,
      "text": "Saa leffuendis hadde the sunckit oss nedder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 39,
      "text": "med oss /",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 39,
      "text": "Wor siæl hun gick igiennom thet wand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 39,
      "text": "wÿ hadde forsunckid alle mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 39,
      "text": "hadde Gud icke med oss wærid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 40,
      "text": "Benedidet wære Herren ther oss ey gaff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 40,
      "text": "vnder theris tender fangne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 40,
      "text": "alt som een fwl ther snaren kommer aff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 40,
      "text": "saa er wor siæl vndgangen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 40,
      "text": "then snare er brøsten/ oc wÿ ere frÿ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 40,
      "text": "wor herris naffn thet staar oss bÿ:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 40,
      "text": "Som haffuer skapt himmel oc iorden.",
      "part": false,
      "marginal_notes": [
        "Gene. j."
      ]
    },
    {
      "id": 135,
      "stanza_id": 41,
      "text": "Aere wære teg Gud ÿ ewighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 41,
      "text": "wor fader lodst tw teg kalle/",
      "part": false,
      "marginal_notes": [
        "Math. vj."
      ]
    },
    {
      "id": 137,
      "stanza_id": 41,
      "text": "begaffue oss med thÿn miskundhed:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 41,
      "text": "wÿ bede tw oss ey vndfalle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 41,
      "text": "Then ære thÿn søn skall wære lÿg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 41,
      "text": "fraa nw oc ind til ewige tÿd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 41,
      "text": "Then Helliaand ey fraa skillies.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 42,
      "text": "ALlene Gud ÿ the høge wære ære",
      "part": false,
      "marginal_notes": [
        "Luce. ij."
      ]
    },
    {
      "id": 143,
      "stanza_id": 42,
      "text": "oc tack for sÿn store naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 42,
      "text": "Ther fore att oss nw aldrig meere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 42,
      "text": "kan røre siælsens skade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 42,
      "text": "Gud haffuer til oss nw ingen had/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 42,
      "text": "men her er nw fred wden all wlad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 42,
      "text": "All feide haffuer nw faait ende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 43,
      "text": "Wÿ loffue prÿse oc tilbede teg/",
      "part": false,
      "marginal_notes": [
        "Luce. ij."
      ]
    },
    {
      "id": 150,
      "stanza_id": 43,
      "text": "for thÿn ære wÿ teg tacke:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 43,
      "text": "att tw Gud fader ÿ ewighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 43,
      "text": "reghere oss wille achte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 43,
      "text": "Gantske vbegribelig er thÿn macht/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 43,
      "text": "all werden hun er teg vnderlagt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 43,
      "text": "Wel er oss for saadan Herre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 44,
      "text": "O Jesu Christe Guds eenborne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 44,
      "text": "een søn wor himmelske faders/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 44,
      "text": "forløøst haffuer tw the forlorne/",
      "part": false,
      "marginal_notes": [
        "Mat. j. ij. j. Petri. ij."
      ]
    },
    {
      "id": 159,
      "stanza_id": 44,
      "text": "att Gud thennom welbehager/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 44,
      "text": "Guds hellige lam wor herre oc Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 44,
      "text": "tag til teg wor skyld/ giør for oss bood/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 44,
      "text": "forbarme teg offuer oss arme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 45,
      "text": "O Helliaand almectigste Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 45,
      "text": "tw al ler ypperste trøster/",
      "part": false,
      "marginal_notes": [
        "Johan. j. iiij. oc. xvj."
      ]
    },
    {
      "id": 165,
      "stanza_id": 45,
      "text": "aff dieffuelsens wold leed thennom wd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 45,
      "text": "ther Jesus Christus forløste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 45,
      "text": "formiddels stor martyr oc bitter død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 45,
      "text": "affwend fraa oss alt iæmmer oc nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 45,
      "text": "Ther til wÿ oss forlade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 46,
      "text": "O Herre Gud benaade meg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 46,
      "text": "For thÿn store barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 46,
      "text": "Affslætt all mÿn wretwÿshed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 46,
      "text": "Jeg kendis mÿn synd hun er meg leed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 46,
      "text": "Tho tw meg wel aff ondskab mÿn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 46,
      "text": "oc giør meg reen aff all mÿn synd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 46,
      "text": "Thÿ ieg kender mÿn ondskab nw",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 46,
      "text": "mÿn synd er altÿd ÿ mÿn hw.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 47,
      "text": "O Herre Gud mod teg allene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 47,
      "text": "haffuer ieg syndet thet kendis ieg gierne:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 47,
      "text": "Ont haffuer ieg giord ÿ thÿn aasiwn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 47,
      "text": "att thet er wist som tw haffuer sagd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 47,
      "text": "att alle teg skulle bede om miskund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 47,
      "text": "thÿ wor natur er fuld aff synd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 47,
      "text": "Hwad hadde wÿ ellers naade behoff?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 47,
      "text": "tw winder thennom offuer som thette ey tro.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 48,
      "text": "See Herre ÿ synden vndfangen ieg er:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 48,
      "text": "mÿn moder meg ÿ synden fødde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 48,
      "text": "sandhed hun gielder altÿd for teg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 48,
      "text": "thÿn lønlige raad tw meg theede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 48,
      "text": "Tw haffuer wÿst meg hwordan ieg er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 48,
      "text": "fuld aff ont oc syndzens begiær/",
      "part": false,
      "marginal_notes": [
        "Roma. vij."
      ]
    },
    {
      "id": 192,
      "stanza_id": 48,
      "text": "thet kunde ieg icke før forstaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 48,
      "text": "før tw lodst meg thÿn wÿsdom faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 49,
      "text": "Bestenck meg sielluff o Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 49,
      "text": "med thÿn Jsop oc naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 49,
      "text": "tha bliffuer ieg reen oc bædre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 49,
      "text": "qwÿt fraa all syndzens waade:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 49,
      "text": "Thÿn kiære søns blod er then Jsop:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 49,
      "text": "ther hwider en snee giør siæl oc krop/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 49,
      "text": "Lad meg faa att høre thÿne glædelig ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 49,
      "text": "saa frøgdis the been som forsmaade wore før.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 50,
      "text": "Thit ansigt o Herre wend fraa mÿn synd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 50,
      "text": "slæt wd all mÿn wretwished",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 50,
      "text": "skaffe ÿ meg eet reent hierte igien/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 50,
      "text": "forny mit sind/ oc forskyd ey meg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 50,
      "text": "Tag ey fraa meg then Helliaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 50,
      "text": "giff meg glæde ÿ thÿn frelsermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 50,
      "text": "Med een sterck aand giør meg stadig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 50,
      "text": "hooss teg att bliffue ewindelig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 51,
      "text": "The troløse wil ieg lære thÿn wey/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 51,
      "text": "hworlunde the skulle hanwm kende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 51,
      "text": "att the maa vndgaa then falske stey/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 51,
      "text": "oc seg nw om til teg wende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 51,
      "text": "Beskerm meg herre mÿn saligheds Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 51,
      "text": "fraa blodige synder alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 51,
      "text": "O Herre lad op mit hierte oc mund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 51,
      "text": "thÿn loff oc ære att tale.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 52,
      "text": "Hadde tw legomligt offer elst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 52,
      "text": "tha wilde ieg thet wel giøre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 52,
      "text": "Een ydmyg aand saa tager tw helst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 52,
      "text": "eet angerfult hierte monne tw høre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 52,
      "text": "Bethee thit folk thÿn wilie god/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 52,
      "text": "oc byg thÿn Christen kircke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 52,
      "text": "saa skaltw retferdigheds offer faa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 52,
      "text": "The skulle teg Christelig dyrcke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 53,
      "text": "Aere wære teg Gud ÿ ewighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 53,
      "text": "for thÿn miskund oc naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 53,
      "text": "wÿ tacke thÿn barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 53,
      "text": "att tw wilt oss styre oc raade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 53,
      "text": "Ther till thÿn søn wor frelsermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 53,
      "text": "skall giffuis then samme ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 53,
      "text": "aff fattig oc rÿg ÿ alle land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 233,
      "stanza_id": 53,
      "text": "Then Helliaand bør thennom lÿg wære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 234,
      "stanza_id": 54,
      "text": "IEsu som er wor salighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 235,
      "stanza_id": 54,
      "text": "all wor attraa oc kierlighed/",
      "part": false,
      "marginal_notes": [
        "Johan. j."
      ]
    },
    {
      "id": 236,
      "stanza_id": 54,
      "text": "Allis wor Gud oc skabere blÿd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 237,
      "stanza_id": 54,
      "text": "som tog mandom sÿst ÿ werdzens tÿd.",
      "part": false,
      "marginal_notes": [
        "Col. j:"
      ]
    },
    {
      "id": 238,
      "stanza_id": 55,
      "text": "Hwilken miskundhed teg offuerwand/",
      "part": false,
      "marginal_notes": [
        "Gala. iiij: Esaie. liij."
      ]
    },
    {
      "id": 239,
      "stanza_id": 55,
      "text": "att tw saa drogst wor syndzens band/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 240,
      "stanza_id": 55,
      "text": "Then grumme død wilde tw lÿde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 241,
      "stanza_id": 55,
      "text": "att wÿ motte then ewig død qwit bliffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 242,
      "stanza_id": 56,
      "text": "Thet heluede monne tw igiennom gaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 243,
      "stanza_id": 56,
      "text": "thÿne fanger tw frelste saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 244,
      "stanza_id": 56,
      "text": "Jgien gangen til thÿn faders land/",
      "part": false,
      "marginal_notes": [
        "Marc. xvj. Esaie. liij."
      ]
    },
    {
      "id": 245,
      "stanza_id": 56,
      "text": "ther sidder tw hooss hans høgre hand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 246,
      "stanza_id": 57,
      "text": "Thÿn godhed twingde teg saa sterckelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 247,
      "stanza_id": 57,
      "text": "wor synd tw barst tolmodelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 248,
      "stanza_id": 57,
      "text": "wÿ bede giff oss then ewige roo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 249,
      "stanza_id": 57,
      "text": "hwor wÿ maa teg altÿd beskoe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 250,
      "stanza_id": 58,
      "text": "Then som aff døden opstanden er/",
      "part": false,
      "marginal_notes": [
        "Mat xxviij Johan. xx."
      ]
    },
    {
      "id": 251,
      "stanza_id": 58,
      "text": "hannwm wille wÿ loffue prÿse oc ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 252,
      "stanza_id": 58,
      "text": "Med fader oc then Helliaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 253,
      "stanza_id": 58,
      "text": "som sitt ord kundgiør ÿ alle land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 254,
      "stanza_id": 59,
      "text": "HEllig er Gud fader/",
      "part": false,
      "marginal_notes": [
        "Esaie. vj."
      ]
    },
    {
      "id": 255,
      "stanza_id": 59,
      "text": "Hellig er oc saa Gud søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 256,
      "stanza_id": 59,
      "text": "med thennom baade oc wor hugswalare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 257,
      "stanza_id": 59,
      "text": "then Helliaand/ er hellig oc skøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 258,
      "stanza_id": 59,
      "text": "een eniste weldæder/",
      "part": false,
      "marginal_notes": [
        "Math. vj."
      ]
    },
    {
      "id": 259,
      "stanza_id": 59,
      "text": "mod oss oc wore forfædre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 260,
      "stanza_id": 59,
      "text": "med flÿt han oss forsørger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 261,
      "stanza_id": 60,
      "text": "Stercke første oc mechtige Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 262,
      "stanza_id": 60,
      "text": "offuer Sabaot alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 263,
      "stanza_id": 60,
      "text": "Bode synd oc død oc ther till heluede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 264,
      "stanza_id": 60,
      "text": "for hannwm gantske motte falle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 265,
      "stanza_id": 60,
      "text": "Ther fore er bode himmel oc iord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 266,
      "stanza_id": 60,
      "text": "forfylt med thÿn ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 267,
      "stanza_id": 60,
      "text": "oc skrige nw Hosianna.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 268,
      "stanza_id": 61,
      "text": "Christo wære oc altÿd prÿss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 269,
      "stanza_id": 61,
      "text": "then ther kom ÿ Herrens naffn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 270,
      "stanza_id": 61,
      "text": "med vnderlig wÿss:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 271,
      "stanza_id": 61,
      "text": "wore synder allsammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 272,
      "stanza_id": 61,
      "text": "weldigen haffuer offuerwunden/",
      "part": false,
      "marginal_notes": [
        "Math. xxj. Luce. xix. Johan. xij."
      ]
    },
    {
      "id": 273,
      "stanza_id": 61,
      "text": "Oc haffuer sitt rÿge saa indnommen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 274,
      "stanza_id": 61,
      "text": "Nw rober alle Hosianna",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 275,
      "stanza_id": 62,
      "text": "O Guds lam vskyldig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 276,
      "stanza_id": 62,
      "text": "paa korsitt wor slachted/",
      "part": false,
      "marginal_notes": [
        "Johan. j. j. Petri. j. Esaie. liij. Joh. j. ij."
      ]
    },
    {
      "id": 277,
      "stanza_id": 62,
      "text": "altÿd wor funden dyllig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 278,
      "stanza_id": 62,
      "text": "ihwor tw æst foracted/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 279,
      "stanza_id": 62,
      "text": "Alle synder haffuer tw borttaged/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 280,
      "stanza_id": 62,
      "text": "ellers wore wÿ forsaged/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 281,
      "stanza_id": 62,
      "text": "Forbarme teg offuer oss o Jesu/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 282,
      "stanza_id": 63,
      "text": "O Guds lam vskyldig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 283,
      "stanza_id": 63,
      "text": "paa korsitt wor slachted/",
      "part": false,
      "marginal_notes": [
        "Johan. j. j. Petri. j. Esaie. liij. Joh. j. ij."
      ]
    },
    {
      "id": 284,
      "stanza_id": 63,
      "text": "altÿd wor funden dyllig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 285,
      "stanza_id": 63,
      "text": "ihwor tw æst foracted/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 286,
      "stanza_id": 63,
      "text": "Alle synder haffuer tw borttaged/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 287,
      "stanza_id": 63,
      "text": "ellers wore wÿ forsaged/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 288,
      "stanza_id": 63,
      "text": "giff oss med fred.",
      "part": false,
      "marginal_notes": []
    }
  ]
}