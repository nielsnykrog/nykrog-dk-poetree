{
  "id": null,
  "title": "Flyttedagen i April",
  "year_created": 1830,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Digte",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1830,
    "url": "https://tekstnet.dk/books/andersen-hc_digte-1830/028/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Nu Vintrens gamle Gubbe forlader sit Logi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Thi mellem ham og Vaaren er daarlig Harmoni.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "– I Kjælder og i Stue, ja selv høit under Tag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Man faaer Begreb om Chaos, thi det er Flyttedag;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Hist staae to gamle Tanter i Gadens Snavs og Snee",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Samt andre gamle Møbler der ei er værd at see. –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "– Nu kommer der en Liigvogn, see Følget er saa stort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Det er en fornem Herre der Ingenting har gjort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Han flytter – og hvis rigtigt man tør Avisen tro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Da er han meget salig og skal i Himlen bo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Nu staaer han alt deroppe og bukker med et Smiil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Dog jeg er grumme bange, han løber der April.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
