  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Rentzells Håndskrift",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/RNZ60.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Habor Kong oc Siuord kong",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "de begÿnte en kiff |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "alt om den stalten senil-lill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "hun er saa ven | en viff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: ræt aldrig vnder i mig saa vennen | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Ieg drømde ieg vaar i Himmerig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "det vaar | saa god en bÿ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Himmelen hand reffnedis, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "ieg faldt igennem den skÿ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": ":: ræt aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Haffuer du drømt om Himmerig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "da skalt | du vinde en mø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "oc drømte dig du fald | igennem den skÿ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "da skalt du for hende | dø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": ":: ræt aldrig. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Er det mig til ødelagd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "at ieg kand vinde en | mø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "i-saa hiertelig gierne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "vil ieg for hende død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": ":: ræt aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "Habor lod sig vexe haar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "oc Iomfrue-kleder | skere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "saa faar hand til kong siuords Land |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "hand vil sÿngen lære |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "Det vaar Habor kongens-søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "kom ridendis op-i gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "vde stod stalten senilllill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "hun vaar vel suøbt i mord |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "Hel staa i stalten senill-Lill",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": "oc i met alle | Eders quinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "Habor haffuer mig til Ether send |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "i skulde mig slyngen kiende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": ":: ræt | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 7,
      "text": "Al den slÿngen der ieg kand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 7,
      "text": "den vil ieg Ether | vel kiende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "i skulle æde met mig aff | fad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 7,
      "text": "oc soffue hosz min terne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": ":: ret aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 8,
      "text": "Ieg haffuer ædt met herrebørn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 8,
      "text": "oc soffuit | paa deris arm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 8,
      "text": "skulde ieg hosz den terne | soffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 8,
      "text": "da døde ieg aff den harm",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 8,
      "text": ":: ræt aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 9,
      "text": "Ieg haffuer ædt met herre-børn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 9,
      "text": "oc soffuet | hosz deris side,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 9,
      "text": "skulde ieg hosz den terne soffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 9,
      "text": "da døde ieg aff den Quide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 9,
      "text": ":: ræt | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 10,
      "text": "Lader det min stalten Iomfrue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 10,
      "text": "i bør huercken angist eller harm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 10,
      "text": "i skal æde | met mig aff fad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 10,
      "text": "oc soffue paa min | arm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 10,
      "text": ":: ræt aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 11,
      "text": "I Lader det min skøne Iomfrue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 11,
      "text": "ether bør | huercken angest eller quide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 11,
      "text": "i skulle æde aff | fad met mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 11,
      "text": "oc soffue hosz min side. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 12,
      "text": "Alle da sad stalt senilds møer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 12,
      "text": "oc sÿde huer | som de kunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 12,
      "text": "foruden Habor kongens-søn | ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 12,
      "text": "hand haffde sin naal i munde |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 13,
      "text": "De syde Hiort oc de syde hind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 13,
      "text": "paa skouen | som de rende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 13,
      "text": "aldrig fick Habor saa stor | en skaal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 13,
      "text": "hand drack den eÿ vd til bonde |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 14,
      "text": "Suaret det den Terne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 14,
      "text": "det hendeste der hun | torde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 14,
      "text": "aldri saa ieg en skønner Iomfrue, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 14,
      "text": "der drack de drick saa store,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 14,
      "text": ":: ræt aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 15,
      "text": "Lad du lad du Terne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 15,
      "text": "se icke effter mig, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 15,
      "text": "gaar du vd oc gaar du ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 15,
      "text": "ieg skøder | intet effter dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 15,
      "text": ":: ræt aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 16,
      "text": "Sildig om afften",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 16,
      "text": "den dug dreffuer offuer | guld-spang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 16,
      "text": "da løstet Habor kongenszøn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 16,
      "text": "met | stalt senill til seng at gange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 16,
      "text": ":: ræt aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 17,
      "text": "For gick stalten senild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 17,
      "text": "rød skarlagen hun | effter sig drog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 17,
      "text": "effter gick Habor kongeszøn |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 17,
      "text": "saa inderlig hans hierte der loe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 17,
      "text": ":: ræt aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 18,
      "text": "Det vaar Habor kongesøn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 18,
      "text": "saatte sig i sen-gen ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 18,
      "text": "det siger ieg paa min Christelig | tro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 18,
      "text": "hans harnsk det skingret der-ved |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 18,
      "text": ":: ret aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 19,
      "text": "Suaret det stalten senild-lille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 19,
      "text": "oc ret aff | hiertens verck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 19,
      "text": "aldri saa ieg saa skønne Iomfrue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 19,
      "text": "der haffue saa haarde serck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 19,
      "text": ":: ret | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 20,
      "text": "I siger det stalten senild-lille",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 20,
      "text": "meden wi | ere ene to;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 20,
      "text": "er der nogen i verden til",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 20,
      "text": "der | eders Hu er paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 20,
      "text": ":: ræt aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 21,
      "text": "Aldrig er nogen i verden til,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 21,
      "text": "der min | hu ligger paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 21,
      "text": "foruden Habor kongenszøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 21,
      "text": "oc | hannem kand ieg icke faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 21,
      "text": ":: ret aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 22,
      "text": "Er det Habor kongenszøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 22,
      "text": "der i haffuer | i hiertet kier,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 22,
      "text": "da vender eder hid al-kieriste | min",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 22,
      "text": "ieg er eder gantske nær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 22,
      "text": ":: ræt | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 23,
      "text": "Er i Habor kongeszøn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 23,
      "text": "hui vil i mig saa | skende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 23,
      "text": "hui red i icke i min faders gaard |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 23,
      "text": "met met hund oc høg paa hende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 23,
      "text": ":: ræt | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 24,
      "text": "Ieg vaar i eders faders gaard",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 24,
      "text": "alt baade | met høg oc hund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 24,
      "text": "det vaar ethers kiere | fader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 24,
      "text": "hand spottet mig mangelun,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 24,
      "text": ":: ræt | aldrig vinder i mig saa vennen | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 25,
      "text": "I gruer ick stalten senild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 25,
      "text": "i thenne her sam-me ferd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 25,
      "text": "emeden ieg haffuer min brÿnie |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 25,
      "text": "der-til min gode suerd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 25,
      "text": ":: ræt aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 26,
      "text": "Det vaar stalten senild-lille",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 26,
      "text": "hun mente de | vaare ene to,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 26,
      "text": "skam da faa den Terne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 26,
      "text": "hun | stod oc lÿdde der-paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 26,
      "text": ":: ræt aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 27,
      "text": "Skam da faa den terne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 27,
      "text": "hun stod oc lÿdde | der-paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 27,
      "text": "hun tog bort hans gode Suerd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 27,
      "text": "oc | saa hans Brÿnnie blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 27,
      "text": ":: ræt | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 28,
      "text": "Hun tog bort hans gode Suerd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 28,
      "text": "oc saa | hans Brÿnie blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 28,
      "text": "saa gick hun til høÿelofft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 28,
      "text": "som Sibor konge laa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 28,
      "text": ":: ræt aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 29,
      "text": "Soffue i eller vaager i min ædelig Herre, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 29,
      "text": "i soffuer alt for lenge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 29,
      "text": "nu ligger Habor | konge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 29,
      "text": "met eder daatter i senge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 29,
      "text": ":: ræt aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 30,
      "text": "Lad du lad du tieniste-mø",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 30,
      "text": "oc sig du icke | saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 30,
      "text": "senild er en Iomfru",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 30,
      "text": "hun aldrig Ha-bor saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 30,
      "text": ":: ræt aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 31,
      "text": "Hør i det min ædelig herre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 31,
      "text": "vil i det icke tro |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 31,
      "text": "da haffuer i her hans gode Suerd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 31,
      "text": "oc saa hans | Brÿnnie blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 31,
      "text": ":: ræt aldrig. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 32,
      "text": "Det vaar Sibor konge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 32,
      "text": "hand rober offuer | all sin gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 32,
      "text": "staar i op min gode hoffmend |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 32,
      "text": "oc tager Brÿnnie paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 32,
      "text": ":: ræt aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 33,
      "text": "Drager eder paa eders Brÿnnie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 33,
      "text": "oc ræt aff | eders falsk",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 33,
      "text": "det siger ieg paa min Christelig | tro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 33,
      "text": "Habord er fuld-haard en halsz.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 33,
      "text": ":: ræt | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 34,
      "text": "Det vaar stalten senild-lille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 34,
      "text": "sucker hun | i-saa saare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 34,
      "text": "ieg hører min kiere fader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 34,
      "text": "raabe i vaar gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 34,
      "text": ":: ræt aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 35,
      "text": "Hør I stalten senild-lill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 35,
      "text": "i giffuer eder | icke i denne ferd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 35,
      "text": "emeden ieg haffuer min | Brÿnnie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 35,
      "text": "oc saa min gode Suerd |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 36,
      "text": "Det vaar Habor kongeszøn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 36,
      "text": "hand sig til-bage | saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 36,
      "text": "borte da vaar hans gode Suerd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 36,
      "text": "oc saa | hans Brÿnnie blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 36,
      "text": ":: ret aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 37,
      "text": "Det vaar Sibor konge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 37,
      "text": "hand støtte paa dørren met fod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 37,
      "text": "stat op Habor kongeszøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 37,
      "text": "oc kom | til mig vd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 37,
      "text": ":: ret aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 38,
      "text": "Det vaar Habor kongesøn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 38,
      "text": "hand vorde sig som | en mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 38,
      "text": "meden de senge-Stølper",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 38,
      "text": "vdj hans hende | rand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 38,
      "text": ":: ræt aldrig, ret aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 39,
      "text": "Det vaar Habor kongeszøn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 39,
      "text": "hand vorde sig som | en Suend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 39,
      "text": "emeden hand haffde noget",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 39,
      "text": "oc noget aff | Sengen igien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 39,
      "text": ":: ræt aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 40,
      "text": "Toge de Habor kongeszøn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 40,
      "text": "satte hannem i bolter | fem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 40,
      "text": "dem brød hand saa snarlig i sønder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 40,
      "text": "som de | haffde været aff Tin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 40,
      "text": ":: ræt | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 41,
      "text": "Toge de Habor kongeszøn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 41,
      "text": "saatte hannem i bol-ter ni,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 41,
      "text": "dem brød hand saa snarlig sønder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 41,
      "text": "som de | haffde værit aff Blÿ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 41,
      "text": ":: ræt aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 42,
      "text": "Tager i Tho aff Senilds haar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 42,
      "text": "oc binder der-met | hans hender,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 42,
      "text": "er der kierlighed i hans Liff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 42,
      "text": "hand | brÿder dem icke sønder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 42,
      "text": ":: ræt aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 43,
      "text": "Saa toge de tho aff senilds haar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 43,
      "text": "oc bunde Habors hender,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 43,
      "text": "da sad hand saa stille",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 43,
      "text": "hand vilde | icke bryde dem sønder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 43,
      "text": ":: ret aldrig vinder i mig saa | vennen | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 44,
      "text": "Hør i stalten senild",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 44,
      "text": "i lader god vilge kiend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 44,
      "text": "alt | først i seer mig henge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 44,
      "text": "i lader eders bur op-brende |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 44,
      "text": ":: ret aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 45,
      "text": "Er her nogen i min faders gaard",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 45,
      "text": "som voldet haffuer i ether død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 45,
      "text": "da skal ieg lade det heffne i dag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 45,
      "text": "paa | deris festemør,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 45,
      "text": ":: ræt aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 46,
      "text": "Det vaar stalten senild-lill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 46,
      "text": "hun kalder sine Iomfruer til-sammen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 46,
      "text": "wi ville gaa i høÿelofft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 46,
      "text": "oc haffue baade lÿst oc gammen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 46,
      "text": ":: ræt aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 47,
      "text": "Henger i op min kaabe blaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 47,
      "text": "i lader stalt senild-lille | hende see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 47,
      "text": "i lader det stalt senild see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 47,
      "text": "huad mig | er vel eller vee",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 233,
      "stanza_id": 47,
      "text": ":: ret aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 234,
      "stanza_id": 48,
      "text": "Det vaar stalten senild-lill",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 235,
      "stanza_id": 48,
      "text": "hueger baade vde oc | indt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 236,
      "stanza_id": 48,
      "text": "hun saatte ild i sit bure,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 237,
      "stanza_id": 48,
      "text": "oc ild der trint omkring |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 238,
      "stanza_id": 48,
      "text": ":: ret aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 239,
      "stanza_id": 49,
      "text": "Det vaar Habor kongeszøn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 240,
      "stanza_id": 49,
      "text": "hand sig til-bage saa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 241,
      "stanza_id": 49,
      "text": "da stod stalten senilds bur",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 242,
      "stanza_id": 49,
      "text": "oc brende i lue hin blaa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 243,
      "stanza_id": 49,
      "text": ":: ret aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 244,
      "stanza_id": 50,
      "text": "Tager i neder min kaabe blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 245,
      "stanza_id": 50,
      "text": "i lader hende paa | Iorden ligge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 246,
      "stanza_id": 50,
      "text": "haffde ieg nu tre liffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 247,
      "stanza_id": 50,
      "text": "ieg vilde icke | et aff dem tigge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 248,
      "stanza_id": 50,
      "text": ":: ret aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 249,
      "stanza_id": 51,
      "text": "Det var Sibor konge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 250,
      "stanza_id": 51,
      "text": "hand vd aff vinduet saae |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 251,
      "stanza_id": 51,
      "text": "da stod stalt senilds Bur",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 252,
      "stanza_id": 51,
      "text": "i brennende lue hin | blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 253,
      "stanza_id": 51,
      "text": ":: ræt aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 254,
      "stanza_id": 52,
      "text": "Somme gaar til burdet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 255,
      "stanza_id": 52,
      "text": "oc redder senils Liff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 256,
      "stanza_id": 52,
      "text": "oc | somme gaar til gallie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 257,
      "stanza_id": 52,
      "text": "oc hugger Habor ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 258,
      "stanza_id": 52,
      "text": ":: ræt | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 259,
      "stanza_id": 53,
      "text": "Oc der de kom til bure",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 260,
      "stanza_id": 53,
      "text": "oc da vaar senild brend |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 261,
      "stanza_id": 53,
      "text": "oc der de kom til gallie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 262,
      "stanza_id": 53,
      "text": "oc da vaar Habor hengd |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 263,
      "stanza_id": 53,
      "text": ":: ræt aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 264,
      "stanza_id": 54,
      "text": "Saa toge de Habor kongeszøn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 265,
      "stanza_id": 54,
      "text": "suøbte hannem i huiden | lin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 266,
      "stanza_id": 54,
      "text": "saa lagde de hannem i Christen iord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 267,
      "stanza_id": 54,
      "text": "til allerkieriste sin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 268,
      "stanza_id": 54,
      "text": ":: ret aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 269,
      "stanza_id": 55,
      "text": "Saa tog de de vnge tho",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 270,
      "stanza_id": 55,
      "text": "lagde dennem i Christen iord, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 271,
      "stanza_id": 55,
      "text": "oc saa toge de den Terne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 272,
      "stanza_id": 55,
      "text": "oc giorde aff hende det ÿnckelig mord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 273,
      "stanza_id": 55,
      "text": ":: ræt aldrig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 274,
      "stanza_id": 56,
      "text": "Haffde ieg det førend vist,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 275,
      "stanza_id": 56,
      "text": "at kierlighed vaar saa | sterck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 276,
      "stanza_id": 56,
      "text": "ieg vilde dem icke at-skilliet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 277,
      "stanza_id": 56,
      "text": "for hundrede | tusind marck",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 278,
      "stanza_id": 56,
      "text": ":: ræt aldrig vinder i mig saa vennen | ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}