  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "GVd fader oc Søn och den Helligand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hannem bør oss prise oc ere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "han gør miskund i alle land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "som wi mue daglige lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Han haffuer beuist stor kerlighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "mod menniskens køn saa mangeled/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "som wi ville faa ath høre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "J dieffuelens wold ieg fangen laa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "ieg vor fordømt til døde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "min synd mig qualde baade nat oc dag/",
      "part": false,
      "marginal_notes": [
        "Gen. iii"
      ]
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "ieg hagde stor angist oc møde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Och alle tid sanck ieg dybere ned/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "der wor ey raad ey salighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "ieg wor i synden vndfangen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Mine gode gerninger hielpe mig icke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "de kunde ey døden offuerwinde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "den stercke dieffuel han sagde ney/",
      "part": false,
      "marginal_notes": [
        "Luce xi"
      ]
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "han vilde icke lade sig binde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Aff mig eller noget creature/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Jeg vor i hans wold aff min nature/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "fordømpt til euig pine",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Der wor oc ingen i verden til/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "der mig forløse kunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Jeg vid ret aldrig h ort ieg vil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "ieg maa til helffuedis grunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Gudz vrede der offuer mig er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "oc syndzens byrde der ieg nw bær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "fortabit maa ieg bliffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Da ynckede Gud i euighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "min elende offuer maade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "Han tenckte paa sin barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "han vilde mig hielpe lade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Sit faderlige hierte wende han til mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "han kaaste der paa for vden suig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "det keriste det han hagde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Han talede til sin kære Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "det er nu tid ath forbarme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "dw skalt det gøre for min bøn/",
      "part": false,
      "marginal_notes": [
        "Luce i Osee xiii Philp. ii Luce ii"
      ]
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "far heden oc frelss de arme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "Och løss dem vd aff syndens nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "oc sla i hiel den haarde død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "och lad dem met dig leffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "Gudz Søn sin fader lydactig vaar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "han kom til mig paa iorden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "aff en Jomfrw bode ren oc klar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 6,
      "text": "han vilde min broder worde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 6,
      "text": "Saa lønlige førde han sin statz/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 6,
      "text": "och leed alskøns nød och megen platz/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "for han vilde dieffuelen fange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 7,
      "text": "Gudz Søn han sagde kom hid til mig",
      "part": false,
      "marginal_notes": [
        "Math xi"
      ]
    },
    {
      "id": 50,
      "stanza_id": 7,
      "text": "ieg vil mig offuer dig forbarme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 7,
      "text": "ieg taalde den bittre død for dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 7,
      "text": "der met dw hiemmerig skal erffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 7,
      "text": "Nu er ieg din/ oc dw est min/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 7,
      "text": "oc huor ieg er/ der skalt dw være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 7,
      "text": "den fiende skall oss ey atskilye",
      "part": false,
      "marginal_notes": [
        "Roma. v"
      ]
    },
    {
      "id": 56,
      "stanza_id": 8,
      "text": "Huem haffuer hørt større kerlighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 8,
      "text": "en døden for wvenner ath lide?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 8,
      "text": "det haffuer ieg ene giort for dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 8,
      "text": "ath dw skulle met mig bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 8,
      "text": "Jeg er den ene/ der hielpe kand/",
      "part": false,
      "marginal_notes": [
        "Math. xi"
      ]
    },
    {
      "id": 61,
      "stanza_id": 8,
      "text": "thi kommer til mig baade quinde och mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 8,
      "text": "oss skall ret ingen atskilye",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 9,
      "text": "Mit blod det flyder paa iorden vd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 9,
      "text": "ieg bær det korss met møde/",
      "part": false,
      "marginal_notes": [
        "Joan. xix"
      ]
    },
    {
      "id": 65,
      "stanza_id": 9,
      "text": "ieg lider for dig den haarde død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 9,
      "text": "tag tro oc lad dig døbe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 9,
      "text": "Mit liff offueruinder den død met mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 9,
      "text": "all verdens synder vore paa mig lagt/",
      "part": false,
      "marginal_notes": [
        "Esa liii"
      ]
    },
    {
      "id": 69,
      "stanza_id": 9,
      "text": "thi est dw salig worden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 10,
      "text": "Til hiemmels igen til fader min/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 10,
      "text": "far ieg fra denne elende/",
      "part": false,
      "marginal_notes": [
        "Johan. xiiii oc xvi"
      ]
    },
    {
      "id": 72,
      "stanza_id": 10,
      "text": "der vil ieg være Mester din/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 10,
      "text": "den Helligand dig ath sende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 10,
      "text": "Som dig i angiste trøste skall/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 10,
      "text": "och dig vnder uise oc lære vel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 10,
      "text": "i sandhedz vey ath wandre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 11,
      "text": "Huad ieg haffuer giort vnderuist och lært/",
      "part": false,
      "marginal_notes": [
        "Mathei xxviii"
      ]
    },
    {
      "id": 78,
      "stanza_id": 11,
      "text": "det skalt du gøre oc lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 11,
      "text": "der met mit rige opfylt bliffuer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 11,
      "text": "mig selff til loff oc ære/",
      "part": false,
      "marginal_notes": [
        "Mat. xv"
      ]
    },
    {
      "id": 81,
      "stanza_id": 11,
      "text": "Foruare dig vel for menniskens sæt/",
      "part": false,
      "marginal_notes": [
        "Mar. vii"
      ]
    },
    {
      "id": 82,
      "stanza_id": 11,
      "text": "som oss foruender den Christelige ret",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 11,
      "text": "det giffuer ieg dig til kende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 12,
      "text": "Du skalt predicke den Christelige tro",
      "part": false,
      "marginal_notes": [
        "Mathei xxviii"
      ]
    },
    {
      "id": 85,
      "stanza_id": 12,
      "text": "som ieg befaler ath lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 12,
      "text": "Elsker huer ander bode silde oc fro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 12,
      "text": "det skal mit budord være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 12,
      "text": "For dieffuelens lerdom for vocte dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 12,
      "text": "thi han er falsk oc skadelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 12,
      "text": "Gudz ord det bliffuer euindelig",
      "part": false,
      "marginal_notes": [
        "Esaie xl"
      ]
    }
  ]
}