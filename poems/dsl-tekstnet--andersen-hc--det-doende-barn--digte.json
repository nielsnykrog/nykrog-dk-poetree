  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Digte",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1830,
    "url": "https://tekstnet.dk/books/andersen-hc_digte-1830/010/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Moder, jeg er træt, nu vil jeg sove,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Lad mig ved Dit Hjerte slumre ind;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Græd dog ei, det maa Du først mig love,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Thi Din Taare brænder paa min Kind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Her er koldt og ude Stormen truer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Men i Drømme, der er Alt saa smukt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Og de søde Englebørn jeg skuer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Naar jeg har det trætte Øie lukt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Moder, seer Du Englen ved min Side?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Hører Du den deilige Musik?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "See han har to Vinger smukke hvide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Dem han sikkert af vor Herre fik.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Grønt og Guult og Rødt for Øiet svæver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Det er Blomster Engelen udstrøer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Faaer jeg ogsaa Vinger mens jeg lever,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Eller, Moder, faaer jeg naar jeg døer?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Hvorfor trykker saa Du mine Hænder?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Hvorfor lægger Du din Kind til min?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Den er vaad, og dog som Ild den brænder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Moder, jeg vil altid være Din!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Men saa maa Du ikke længer sukke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Græder Du, saa græder jeg med Dig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "O, jeg er saa træt! – maa Øiet lukke –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "– Moder – see! nu kysser Englen mig!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
