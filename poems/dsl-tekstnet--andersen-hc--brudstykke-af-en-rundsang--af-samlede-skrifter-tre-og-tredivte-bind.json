    "url": "https://tekstnet.dk/books/andersen-hc_af-samlede-skrifter-tre-og-tredivte-bind/008/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Kurvene gjør just vor Lykke,",
      "part": false,
      "marginal_notes": [
        "Speaker: KURVEMAGEREN"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Kurve gjort med Vid og Aand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Kurven er et herligt Stykke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Naar den er i Pigehaand;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Dog, hvordan det ogsaa gaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Kurven først fra os hun faaer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Høvler, hamrer, muntre Svende!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Og husk paa, hvad tidt er sagt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Naar det Jordiske har Ende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "er vor Pragt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Men for Kisten, som jeg slaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Selv en Brudeseng jeg faaer.",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
