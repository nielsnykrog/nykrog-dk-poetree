{
  "id": null,
  "title": "Sang til Deres Majestæt Enkedronning Caroline Amalie",
  "year_created": 1853,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
