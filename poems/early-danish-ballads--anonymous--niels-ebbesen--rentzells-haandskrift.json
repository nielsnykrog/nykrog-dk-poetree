    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/RNZ19.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Greffuen drog y Dannemarck ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hannum fulde saa faffuer en skare:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "fire banner oc firesintztiuge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "huo thorde emodtt hanum stande!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Greffuenn skulle tiill Randers riide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "och didtt lod hann siig raade:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "och thett wor hannum for lannge spott,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "hand skulle sitt liiff ther thabe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Icke wiill hann thett lade fordi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "ennd wiille hannd thett freste:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "riider oc suene, bønder oc bomendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "thenum wiille hann hienne gieste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Greffuen sende Niels Ebbessøn budtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "att hand skulle tiill hannum riide:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "hann sagde hanum fredtt oc freliighett",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "oc nu att then same sinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Greffuen møtte Niels Ebessin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "ud wiid Rannders strande:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "\"Wer vel-komen, her Niels Ebiissøn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "oc huor gaar thieg tiill hande?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Hør du thett, Niels Ebbessøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "och warstthu smimen hiemme?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "huor liider thi Nøriuder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "oc kiere hustrue din?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Hør du, gode Niels Ebessøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "oc guode finde min!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "huor stor hoffuitt y Nøreiudlandt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "oc huor liider frennder thinne?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "\"Ennd haffuer ieg i Nøriutlanndtt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "bode frender oc venner:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "di skulle ethers naade tiill rede werre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "om y wiill thett aff thenum haffue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "\"Niels Ebissøn, du est en konnstiig mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "och ther-thiill estthu from:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "huore du kandt icke offuer komme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "tha riider thu laangtt ther-om.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "Hør thu thett, Niels Ebiissøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "wiilthu mit erindt bortt riide?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "mannge suenne haffuer du mett dieg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "ther du mott well po liide.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "\"Ennd haffuer ieg 40 karlle mett mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "sadan som thi ære:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "huad heller the ere flerre eller færre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "ennd haffuer ieg thenum fuld kierre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "\"Haffuer du 40 karlle mett dieg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "tha er thett well tiill made:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "y gaar red thu y her Bugis gaard",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "mett hundritt mend y plodt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "Dett vor alt Niels Ebessøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "hand wor saa bratt att suare:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "\"Er her anthen riider eller suenne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "ther haffuer mig then løgen po sagdtt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 13,
      "text": "Er thett annthenn mand eller quinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "po mig thett siige wiill:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "ieg wiill rett aldriig fløtte en fuodtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "før ieg wiill suare ther-thiill.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "\"Hør du thett, Niels Ebessøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "wy wiille ther icke merr om thalle:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "du riid tiill her Buge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "om hand wiill wenskab haffue!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 15,
      "text": "\"Skall ieg alt eders erinde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "tiill her Buge riide:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "tha giffuer y mig til kinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "huad ieg skall hanum siige!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 16,
      "text": "\"Her Buge hand haffuer mig undsagtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "oc saa hin unnge Pouell Gloss:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "her Anders Frost er och en aff dem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "oc er fremerst i thett raad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 17,
      "text": "Ennd flere ieg haffuer tiill wiillie verit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "the wiille mig nu forsmooe:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "y lide fast po her Bugis raadt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "y sier, huor thett wiill gaa!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 18,
      "text": "\"Her Bugge wed ieg inthett aff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "huad som hand wiill giøre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "Annderss Frost haffuer weriitt ethers thienner saa throff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "aldriig skall y annditt spøriæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 19,
      "text": "Annders Frost haffuer weritt ethers thienner thro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "aldriig skulle i andiit spøre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "wiille hand orloff aff ether tage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "hui motte handtt thett icke giøre?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 20,
      "text": "Dett er saa seedtt y Dannemarck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "haffuer werit y gamel dage:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "naar en suend icke lenger thiene wiill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "tha maa hand orloff haffue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 21,
      "text": "Da suarede greffue her Gertt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 21,
      "text": "hand løster thett icke att høre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "\"Ther maa ingen suendtt fra sin herre riide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 21,
      "text": "den stund hand løster hannom att føre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 22,
      "text": "\"Der er ingen samen wyitt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 22,
      "text": "uden muncken och hans kappe:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 22,
      "text": "hoffmand riider, och hoffmand komer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 22,
      "text": "huor hand kand thienne tiill tacke.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 23,
      "text": "\"Niels Ebissøn, du thaller mig fast emodtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 23,
      "text": "oc thu snacker altt-for lenge:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 23,
      "text": "du skaltt anthen Dannemarck røme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 23,
      "text": "eller ieg skall lade diig hennge.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 24,
      "text": "\"Skall ieg ud aff Dannemarck røme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 24,
      "text": "fra hustru oc børn saa smaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 24,
      "text": "vogssen skall y siige ther-aff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 24,
      "text": "att y mig nogen thid saa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 25,
      "text": "\"Riid du bortt, Niels Ebiissøn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 25,
      "text": "ieg wiill diig icke høre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 25,
      "text": "eller ieg briider mine brømner po dieg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 25,
      "text": "som ieg thør fuld-well giøre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 26,
      "text": "\"Alder saae y mig saa red,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 26,
      "text": "ieg thorde ey fuld-well skielle:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 26,
      "text": "greffue her Gertt, y sier well tiill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 26,
      "text": "och mandeliigen wocter ether sielffue!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 27,
      "text": "\"Niels Ebiissøn, thu snacker mig fast emodtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 27,
      "text": "saa haffuer du och giortt thyer:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 27,
      "text": "du skaltt fryliig for mig were,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 27,
      "text": "tiill solen gaar tiill huille.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 28,
      "text": "Heden da reed Niels Ebissøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 28,
      "text": "slor op mett huiden handtt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 28,
      "text": "\"Y lader ether mindis thett,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 28,
      "text": "ieg kommer fuld snartt igen!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 29,
      "text": "Saa red han att weyen fram,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 29,
      "text": "hand hug sin hest mett spore:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 29,
      "text": "epther stodtt greffuen mett alle sine mendtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 29,
      "text": "ingen epter hannom thorde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 30,
      "text": "Det wor alt Niels Ebisøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 30,
      "text": "och han kom ridende y sin egen gaardtt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 30,
      "text": "ude stod hans kiere høstru,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 30,
      "text": "hand spurde hinde om god raadtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 31,
      "text": "\"Hørde du thett, min kiere høstru,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 31,
      "text": "du skaltt mig guode raad kiende:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 31,
      "text": "greffuen hand haffuer mig undsagtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 31,
      "text": "hand siiger, hand wiill lade mig henge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 32,
      "text": "Thuenne kor lagde hand mig for,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 32,
      "text": "thett thridie wor icke gott:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 32,
      "text": "thett ieg skulle dett ieg skulle ud aff Dannemarck røme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 32,
      "text": "fra alt thett guotz wy aaer.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 33,
      "text": "\"Huad raad skall ieg ether kiende?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 33,
      "text": "ieg er en fattiig quinde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 33,
      "text": "de werste raad di bliffuer ether beest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 33,
      "text": "om i kunde paa them finde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 34,
      "text": "De werste raad er ether all-best,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 34,
      "text": "om y kunde paa thennom finde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 34,
      "text": "anthen greffuen y-heell att slaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 34,
      "text": "heller hannom inde att brende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 35,
      "text": "I lader ether hest tiill smide gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 35,
      "text": "saa inderliig well beslo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 35,
      "text": "alle hagerne wende fram,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 35,
      "text": "thett giffuer ieg ether for raadtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 36,
      "text": "Alle hagerne ind-att wende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 36,
      "text": "po sporitt de ether icke kiende:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 36,
      "text": "y lader thett ingen mand wiide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 36,
      "text": "thett radtt gaff ether en quinde!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 37,
      "text": "\"I eder och dricker, y dannissuene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 37,
      "text": "y giør ether fuld glade!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 37,
      "text": "først thenne natt forgangen ere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 37,
      "text": "tha fannger wy dagen y stadtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 38,
      "text": "Dagenn komer ick, for solen skin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 38,
      "text": "saa faa vy thidende ny:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 38,
      "text": "saa wiill ieg paa mine suene see",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 38,
      "text": "huilcken fra sin herre wiill fly.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 39,
      "text": "Op tha stod de dannissuene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 39,
      "text": "thi suarit deriis herre saa fry:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 39,
      "text": "\"Wy wiill mett ether riide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 39,
      "text": "woge bode guotz och liff.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 40,
      "text": "Saa redtt di tiill Fruuer-lundtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 40,
      "text": "ther bunde the theriis heste:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 40,
      "text": "saa ginge the y Randers indtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 40,
      "text": "greffue Giertt hanum wiille di gieste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 41,
      "text": "Dett wor Niels Ebiisen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 41,
      "text": "han kom tiill Randers-broe:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 41,
      "text": "\"Huilcken mig icke thine wiill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 41,
      "text": "och hand thage orloff nu!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 42,
      "text": "Fram tha giick hand liden Suend Trøst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 42,
      "text": "ham trode ham allerbest:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 42,
      "text": "\"Min herre, i giffuer mig orloff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 42,
      "text": "och ther-thiill sadell och hest!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 43,
      "text": "Hand begierdede orloff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 43,
      "text": "och ther-thiill sadell och hest:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 43,
      "text": "den same dag, førind afftenn kom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 43,
      "text": "handtt thienntte hannom allerbest.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 44,
      "text": "Dett vor Niels Ebisøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 44,
      "text": "hand klaper po dørenn mett skiold:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 44,
      "text": "\"Du statt op, unge greffue Gertt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 44,
      "text": "thu lad mig tiill theg indtt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 45,
      "text": "I staar op, greffue Gertt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 45,
      "text": "y lader mig tiill ether indtt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 45,
      "text": "ieg er hertug Hendriicks budtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 45,
      "text": "hand haffuer mig thiill ether sendt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 46,
      "text": "\"Estthu hertug Hendriicks budt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 46,
      "text": "thu ladtt dieg icke forlennge:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 46,
      "text": "thu mød mig y morriigen y broder-closter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 46,
      "text": "emellom mese och ottesanng!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 47,
      "text": "\"Hør i thett, greffue Giertt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 47,
      "text": "i dueller icke forlennge!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 47,
      "text": "Ribe thett er bestollitt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 47,
      "text": "Kolling thett er brentt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 48,
      "text": "Ribe thett er bestaallitt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 48,
      "text": "oc Kolling thett er brentt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 48,
      "text": "thett wiill ieg for sanndingen siige:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 48,
      "text": "Niels Ebiissen hand er henngtt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 49,
      "text": "\"Er thett sannden, du siiger mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 49,
      "text": "tha er thett thiende guodt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 49,
      "text": "hest oc kleder udi min gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 49,
      "text": "then stund wi leffue bode.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 50,
      "text": "Greffuen ud aff winduit saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 50,
      "text": "hand saae thi blancke spiude:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 50,
      "text": "\"Saa ussell ieg tiill Dannemarck kom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 50,
      "text": "Niels Ebiisen holler her-ude!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 51,
      "text": "De støtte paa dør mett skiold och spiud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 51,
      "text": "thi magler ginge alle y støcke:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 51,
      "text": "\"Est thu her-ende, greff Giertt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 51,
      "text": "wy wiille dieg en skolle tiil-driicke.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 52,
      "text": "\"Siider thu neder, Niels Ebiisøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 52,
      "text": "wi wiille oss beder forliige:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 52,
      "text": "sende wy bud effther hertug Hendriick",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 52,
      "text": "och her Claus Krumbdiige!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 53,
      "text": "\"Icke sagde thu saa y gaar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 53,
      "text": "altt ude wiidt Randers strande:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 53,
      "text": "thu sagde, thu skalt anthen lade mig henge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 53,
      "text": "eller ieg skulle røme aff lanndtt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 54,
      "text": "Suariit thett then sortte suend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 54,
      "text": "for hand vor icke huidtt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 54,
      "text": "\"Lege wy nether then lange thalle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 54,
      "text": "wy lader thi suerde biide!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 55,
      "text": "\"Icke haffuer ieg slott eller leenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 55,
      "text": "att giffue saa riig en fannge:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 55,
      "text": "y spare nu icke thi skarpe suerdtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 55,
      "text": "y lader thenum fast gannge!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 56,
      "text": "Saa toge de greffue her Gertt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 56,
      "text": "alt udi sin gulle locke:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 56,
      "text": "saa hugitt di hanum hoffuitt fra",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 56,
      "text": "altt offuer then sennge-stock.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 57,
      "text": "Denn thiid greffuen hand vor dødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 57,
      "text": "och tha slo thi po thieriis thrumer:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 57,
      "text": "thett vor Niels Ebiisøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 57,
      "text": "aff bienn wiille hand gange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 58,
      "text": "Heden gaar Niels Ebiisøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 233,
      "stanza_id": 58,
      "text": "hand wiille aff byen fly:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 234,
      "stanza_id": 58,
      "text": "effther gaar her Offue Halss,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 235,
      "stanza_id": 58,
      "text": "hanndtt wiille hannom thett forbiude.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 236,
      "stanza_id": 59,
      "text": "\"Hør du, her Offue Hals,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 237,
      "stanza_id": 59,
      "text": "lad du mig nu gaa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 238,
      "stanza_id": 59,
      "text": "du wedst, thu est min suager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 239,
      "stanza_id": 59,
      "text": "thu motte mig inthett skade.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 240,
      "stanza_id": 60,
      "text": "\"Altt wed ieg thett fuld-well,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 241,
      "stanza_id": 60,
      "text": "ieg skulle din suoger were:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 242,
      "stanza_id": 60,
      "text": "nu haffuer thu slagit min herre ihiell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 243,
      "stanza_id": 60,
      "text": "ieg maa thett icke giøre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 244,
      "stanza_id": 61,
      "text": "Niels Ebiisøn brugtte sitt guode suerd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 245,
      "stanza_id": 61,
      "text": "han wiille hanum inthett wiige:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 246,
      "stanza_id": 61,
      "text": "her Offue Halss mett thidske flere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 247,
      "stanza_id": 61,
      "text": "thi motte ther lade theriis liiff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 248,
      "stanza_id": 62,
      "text": "Faaritt breger, och gaassen keger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 249,
      "stanza_id": 62,
      "text": "och hanen galler poo halle:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 250,
      "stanza_id": 62,
      "text": "her Offue Hals bleff halff miere wiiltt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 251,
      "stanza_id": 62,
      "text": "po thi Holster mone hand kalle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 252,
      "stanza_id": 63,
      "text": "Her Offue Halss blieff halff miere wiltt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 253,
      "stanza_id": 63,
      "text": "po thi Holster monne hand kalle:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 254,
      "stanza_id": 63,
      "text": "greffuin bleff om dagen slagen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 255,
      "stanza_id": 63,
      "text": "och icke om nathen mett alle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 256,
      "stanza_id": 64,
      "text": "Dett vor Niels Ebiissøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 257,
      "stanza_id": 64,
      "text": "hand kom thiil Rannders-broe:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 258,
      "stanza_id": 64,
      "text": "ther stod liiden Suendtt Throst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 259,
      "stanza_id": 64,
      "text": "som føre orloff thog.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 260,
      "stanza_id": 65,
      "text": "Niels Ebiisenn gaar offuer Randers-broe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 261,
      "stanza_id": 65,
      "text": "thi løbe epther hanum saa fast:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 262,
      "stanza_id": 65,
      "text": "epther gaaer liden Suend Thrøst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 263,
      "stanza_id": 65,
      "text": "broen han epther hanum kaste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 264,
      "stanza_id": 66,
      "text": "Niels Ebiisønn hannd threen tiill sin hest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 265,
      "stanza_id": 66,
      "text": "tiill Norinsriiss monne hand ride;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 266,
      "stanza_id": 66,
      "text": "thett wiill ieg for sandingen siige:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 267,
      "stanza_id": 66,
      "text": "hand haffde bode angiist och quide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 268,
      "stanza_id": 67,
      "text": "Saa gieste hann en kierling,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 269,
      "stanza_id": 67,
      "text": "hun haffde icke uthen tho løffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 270,
      "stanza_id": 67,
      "text": "then enne gaff hun Niels Ebiisøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 271,
      "stanza_id": 67,
      "text": "for han slo then kullede greffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 272,
      "stanza_id": 68,
      "text": "Gud naade thinn siell, Niels Ebiisøn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 273,
      "stanza_id": 68,
      "text": "men du y liffuitt wor:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 274,
      "stanza_id": 68,
      "text": "saa manngenn thisk y Dannemarck",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 275,
      "stanza_id": 68,
      "text": "thenn same wey skall gaa.",
      "part": false,
      "marginal_notes": []
    }
  ]
}