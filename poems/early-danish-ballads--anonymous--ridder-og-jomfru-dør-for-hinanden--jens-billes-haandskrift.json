{
  "id": null,
  "title": "Ridder og Jomfru dør for hinanden",
  "year_created": [
    1555,
    1559
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Jens Billes Håndskrift",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1559,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/BILL67.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Iomffruenn boer siig ud vedtt stranndtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": ":: ther mynn hug legtiiss mig saa well ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "som rige købmenndtt thi legge till lanndtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Thenn rider hand beder thenn iomffru aldrig quide. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Ther kom seglindis snecker fem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "kongenns sønn aff Enngelanndt hand otthe them.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Then enne segliig miig saa ner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "hand kaste thett røde gulldtt paa mit kne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "Ther stodt skreffuit uti thett guld saa rødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "at kongensss sønn aff Engelandt handt vor dødtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "\"Viiste ieg, then koningen-søn hand vor dødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "ieg skulle lade brennde mytt bur utti glødtt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "Thenn tiid then bur stod oc branndtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 5,
      "text": "tha kom thenn konning-søn selling till landtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "Oc tha kom then konge-søn sellinge till landtt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "\"Huem er thenne illde-brandtt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "Huem er thenne illde-branndtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 7,
      "text": "ther skynner alt paa myn iomffruenns landtt?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "\"Oc thett er icke i thin iomffruens landtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 8,
      "text": "mæn thett er i thin iomffruess byur.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "\"Viiste ieg, thett myn iomffru hun vor dødtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 9,
      "text": "mitt egiitt suer skulle werre mynn dødtt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "Hanndtt seetthe knapenn modtt enn stenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 10,
      "text": ":: ther min hug legtiiss mig saa vell ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 10,
      "text": "thenn odtt hand giorde hanss hierte men.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 10,
      "text": ":: Thenn ryder hand beder then iomffru aldrig quide. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}