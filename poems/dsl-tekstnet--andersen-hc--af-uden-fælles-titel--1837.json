  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1837,
    "url": "https://tekstnet.dk/books/andersen-hc_af-uden-faelles-titel-1837/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Du er i Roma, Verdens gamle Stad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Hvor Oldtids Skatte, Oldtids Guder bygge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Du drikker Sydens Luft i Piniens Skygge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "O, vær dog glad!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Husk, denne Tid gjenkommer aldrig meer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Dog smerteknuust jeg mod mit Norden seer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Et Brev fra Vennerne! eet Brev! –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Men intet Ondt, ret modent Ondt, som dræber",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Er født, og skjænkes kan fra Venne-Læber,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Man ellers skrev!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Hvor her er deiligt! – skræm ei Drømmen bort!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Forund mig den, den er jo dog saa kort!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Jeg vender snart hjem til mit Fødested,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Og om ei mine Fjender jeg forsoner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "De sikkert dog vil lægge Svøben ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Thi Vennerne – de slaae med Skorpioner!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "O Almagts Gud, paa Dig jeg fast vil holde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Skal ei, som herligt Træ, sig her udfolde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Hvad i min Sjæl Du nedlagt har, som Frøe:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Før mig ei hjem! lad mig herude døe!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
