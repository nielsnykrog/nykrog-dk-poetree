{
  "id": null,
  "title": "Jomfruen og Dværgen",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift I",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVI37.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Ieg widt saa rig en Ridder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "en hertug datter godt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "mett elskoffuen oc guodt wilge, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "deris hue tillsammen stodt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Saa ingenn | mandt dett wiste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "dett wiste icke fiske ÿ | floden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "eÿ willen fogel paa quiste. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Min wenne jomffrue min skøne iomffrue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "ville ÿ giffue mig ethers troe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "ieg will ether elske oc ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "den stundt ieg leffue maa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "ieg | loffuer ether till min wiff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "ieg will ether elske | oc ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "den stund mig windis liff. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Loffuer ieg ether min troe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "oc suiger ÿ mig | da,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "oc da er ieg en fattige quinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "aff | fader oc moder forsmaait,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "siden ære wÿ bode | forødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "ethers liff oc ære min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "langt bedre | motte wÿ haffue werit wfødt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Min wenne jomffrue min skiøne iomffrue, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "tenck ÿ nu icke slig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "den onde oc den gode, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "dj ære icke bode ens lig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "men worde handt | wsel oc arm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "suige ham christ aff himmerig, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "den ether wille giøre den harm. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Di loffuit troe oc skildis att,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "wdÿ den samme | stundt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "dj satte huer steffne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "wdÿ den | grønne lundt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "huor komme dett till weÿe, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "den wecter er min wen saa guodt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "for ham will ieg dett sige. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Hun gick till denn wecter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "altt buode till | oc fraa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "oc wocter hun dett saa ide lig, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "att ingen mandt dett saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "O wecther wilt | du mig dett loffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "en liden stundt ÿ | grønnen lundt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "huosz rigen en ridder att soffue. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "Lader lader min stalte iomffrue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "ÿ tencker | icke saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "spør dett ethers fader,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 6,
      "text": "saa lader | handt mig ihielslaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 6,
      "text": "siden ære wÿ bode | forødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 6,
      "text": "ethers ære oc mitt liff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "langt mott | wÿ haffue werit wfødt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 7,
      "text": "Bort da gick den stalte jomffrue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 7,
      "text": "saa listelig widt sig allenne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 7,
      "text": "saa mørck wor natt | saa langt wor leedt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 7,
      "text": "oc manen icke skinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 7,
      "text": "dj nacter gale dj siunge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 7,
      "text": "der gleder | sig alt dett ÿ skoffuen er,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 7,
      "text": "denn eldste mett | den wnge. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 8,
      "text": "Dueler ieg forlenge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 8,
      "text": "oc ieg kommer icke igen, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 8,
      "text": "bær op en elskoffuens Visse,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 8,
      "text": "du wecker mig | mett din sang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 8,
      "text": "siden ere wÿ bode quideløsz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 8,
      "text": "oc bode fra angist oc meen. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 9,
      "text": "Der stodt den fule duerre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 9,
      "text": "oc lÿdit handt | der paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 9,
      "text": "endt skall ieg ether attskilie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 9,
      "text": "der | gannger siden huor dett maa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 9,
      "text": "handt recker hinde huiden handt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 9,
      "text": "den Ridder hafuer ether steffne satt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 9,
      "text": "haffuer mig til ether wd | sendt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 10,
      "text": "Saa tog hand den stolte iomffrue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 10,
      "text": "handt løffte hinde paa sin heste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 10,
      "text": "oc førde handt | hinde ÿ biergitt indt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 10,
      "text": "alt som handt kunde | best,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 10,
      "text": "O moder seer huad ieg haffuer førdt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 10,
      "text": "en den skøniste iomffrue, mandt haffuer | enten sett heller hørdt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 11,
      "text": "Ladt nu ladt kiere sønne min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 11,
      "text": "hun er | dig icke iett,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 11,
      "text": "hindis fader er en hertug | godt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 11,
      "text": "hindis moder aff keÿser art,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 11,
      "text": "du | loff hinde eÿ till din wiff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 11,
      "text": "du fører hinde eÿ snart igen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 11,
      "text": "der lader io tre der for | sitt liff. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 12,
      "text": "Der kom den Ridder ridendis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 12,
      "text": "wdaff saa møgen løst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 12,
      "text": "saa fantt handt krone aff dett | røde guldt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 12,
      "text": "hun hengde paa linde quist, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 12,
      "text": "saa tenckte handt paa dett mordt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 12,
      "text": "handt | stack sig paa sit egit suerdt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 12,
      "text": "handt | falt daa dødt til iordt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 13,
      "text": "Saa tog handt den stolte iomffrue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 13,
      "text": "oc | løffte hinde paa sin hest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 13,
      "text": "oc førde handt | hinde saa listelig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 13,
      "text": "altt till dett samme | stedt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 13,
      "text": "hun tenckte dett wor stuor harm, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 13,
      "text": "hun stack sig sielff paa dett samme suerd |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 13,
      "text": "hun faltt wdÿ hans arm. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 14,
      "text": "Der da stodt den fule duerre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 14,
      "text": "oc saae hand | der oppaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 14,
      "text": "aldrig saae ieg to welbÿrdige | børn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 14,
      "text": "en kranckere skiebne mon faa, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 14,
      "text": "handt tenckte dett wor stuor meen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 14,
      "text": "handt | hengde sig ÿ linde green. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 15,
      "text": "Den wecter bar op en wise,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 15,
      "text": "saa hederlig | der hand sang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 15,
      "text": "ÿ tredue winther fulde, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 15,
      "text": "wor natten mig icke saa lang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 15,
      "text": "gud rade | huor dett will gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 15,
      "text": "for disze her stercke | drømme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 15,
      "text": "som ieg haffuer drømpt ÿ aar. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 16,
      "text": "Wogen laae den hertug godt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 16,
      "text": "oc lÿdde | handt der paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 16,
      "text": "rade gudt fader ÿ himmerig |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 16,
      "text": "altt huor wor datter maa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 16,
      "text": "handt liete oc | icke fantt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 16,
      "text": "borte da war hans enniste datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 16,
      "text": "oc huem war were som handt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 17,
      "text": "Hand gick til den wecther,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 17,
      "text": "bode til oc fra,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 17,
      "text": "saae | du icke min datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 17,
      "text": "den enniste der ieg aae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 17,
      "text": "ieg | hinde icke saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 17,
      "text": "siden hun aff gaarden gick, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 17,
      "text": "mett lidell iomffruer oc smaa. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 18,
      "text": "Handt bødt wdt att lede offuer landt, oc | altt sitt rige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 18,
      "text": "saae du icke min datter, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 18,
      "text": "hand lette bode skoff oc mose,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 18,
      "text": "saa mange dÿbe diger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 18,
      "text": "saa funde dj paa huer | dj wnge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 18,
      "text": "dj laae daa bode ÿ lige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 18,
      "text": "dett | war ønnck att see der paa. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 19,
      "text": "Handt slo ham pust wedt øre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 19,
      "text": "hug ham | ÿ stÿcker smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 19,
      "text": "wee din fule morder, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 19,
      "text": "huj haffuer du mig forsmaait,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 19,
      "text": "du haffuer forradt min datter godt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 19,
      "text": "den enniste | der ieg aatte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 19,
      "text": "der for skalt du lide dette | mordt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 19,
      "text": ". |",
      "part": false,
      "marginal_notes": []
    }
  ]
}