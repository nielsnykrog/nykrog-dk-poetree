  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Med Billed tæt ved Billed her blev skrevet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "De Ord: »Vor Tak!« Du seer den lyser frem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "I Øinene hos hver som med Dig leved’.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Ved Dig er Hjemmet end det gamle Hjem;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Her Minderne som Skjønheds Svaner drage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Og dukke sig i Tanke-Vældet ned.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Bliv endnu hos os mange Aar og Dage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Du er vort Sammenhold, vor Kjærlighed!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Skjøndt fiirsindstyve Vingeslag af Tiden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Omsused’ Dig i Verdens travle Flugt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Beholdt Du Ungdoms Sind og Sjæle-Viden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Dit ædle Hjertes Ild blev aldrig slukt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Op see vi til Dig og »vor Tak« udsjunge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Ei mange Ord, men Du forstaaer os nok.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "»Vor Tak!« saa juble Ældre og de Unge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "»Vor Tak!« saa jubler Børnebørns Flok!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
