  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "En Anndenn Vise",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 1,
      "text": "Dett var Iomffru Rosennkinndt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "hunn | greder ÿ sÿtt bure,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "dett hørde hindis | kiere fader,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "paa thinngett som handt | stod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": ":: thu Rouer dig ved dinn aare. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Riider ÿ holder steffne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "och bønnder ÿ | setther thinngh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "ÿ-medenns ieg riider | thill buretth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "ieg thaller medt datter min. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "Rossennkinndt kiere dather minn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "och | huÿ da greder thu nu saa saare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "huadt | heller daa fattis dig guldt eller sølff; |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "heller vinenn hinn klare. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "Icke fattis mig guldt heller sølff, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "ÿcke heller vinenn hinn klare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "saa | manngen skiønne Iomffruer haffuer | Lønnlig sorrigh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "dÿ thør denn icki | Obennbare. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "Høre du dett Rosennkind kiere datther min |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 5,
      "text": "dinn sorrig denn siiger du mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Ihuad du | viltt aff mig begierre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "dett vill ieg giffue | digh. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 6,
      "text": "Høre ÿ thett kiere fader mÿnn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 6,
      "text": "och viider | ÿ mig Enn bønn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "ÿ giiffuer mig Nielus Marigreffuenns-sønn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "och siidenn haffuer guodt Lønn. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 7,
      "text": "Høre thu thett kiere datther mÿnn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 7,
      "text": "Ieg vider dig icki denn bønn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "Ieg giffuer dig | denn gamle greffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "saa fannger du mere | thill Lønn. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 8,
      "text": "Thett var Iomffru Rosennkindt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 8,
      "text": "hun | vredt sine hennder aff stuor nødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "skal | ieg haffue thenn gamle greffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "ieg sørger mig selff thill dødt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 9,
      "text": "Ther badt buode fruer och Iomffruer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 9,
      "text": "saa | mannge som bede thuorde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "att thett brøllup | motte opstaa enn maanett",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "om thett icki lenger buorde |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 10,
      "text": "Thett var Iomffru Rosennkinnd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 10,
      "text": "hun lader | dÿ lønne-breffue schriffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "dem sender | hunn Nielus Marigreffuens-sønn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "och dem | lader hunn hannom giiffue |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 11,
      "text": "Thett var Nielus Marigreffuenssønn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 11,
      "text": "der | hanndt dÿ lønne-breffue saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "Christ | signe Iomffru Rosennkinndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "som der | lagde vinndt opaa. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 12,
      "text": "Thett var denn gamle greffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 12,
      "text": "hannd lader | sitt brøllup bou,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "thett var Nielus marigreffuennssønn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "hanndt lader sinn | gannger skou. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 13,
      "text": "Thett var Nielus Marigreffuenssønn |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 13,
      "text": "hanndt banndt om sÿg sitt suerdt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 13,
      "text": "Nu vill ieg ride thill dett brølup,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "och | see paa denn brude-ferdt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 14,
      "text": "Thett forbiudt denn øffuerste gudt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 14,
      "text": "den | sorrig skulde mig hennde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "vill herre | gudt giffue mig lÿckenn ther-thill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "ieg | skall dett snarlig forvennde. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 15,
      "text": "Tack haffue Nielus Marigreffuenns-sønn, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 15,
      "text": "for hannd redt icki Enne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 15,
      "text": "hanndt redt imod | thenn gamle greffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "med XXX rask hoffmend |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 16,
      "text": "Thett var Nielus Marigreffuenns-sønn, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 16,
      "text": "hannd rider ÿ grønenn lundt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 16,
      "text": "ther møtthe | hannom greffuenns lidenn smaadrenng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "ÿ then | samme stundt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 17,
      "text": "Høre du det du lidenn smaadreng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 17,
      "text": "och huad | ieg siger dig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 17,
      "text": "vedstu nu denn gamle greffue, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "thu dølle hannom icki for mig, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 18,
      "text": "I gaardt saae ieg thenn gamle greffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 18,
      "text": "hans | brølup skall staa ÿ dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 18,
      "text": "hanndt er thenn | beste manndt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "ther ieg nogenn thidt medt øÿen | saa. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 19,
      "text": "Thett er beste mannd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 19,
      "text": "ÿ verdenn verre maa, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 19,
      "text": "hanndt haffuer sig enn Iomffru,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "thenn veniste der solenn offuerskinne maa, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 20,
      "text": "Och holthe dÿ der enn lidenn stundt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 20,
      "text": "och | icki holde lennge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 20,
      "text": "greffuenn medt sinn brude-skare | ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "kom offuer dÿ grønne Ennge |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 21,
      "text": "Ther holthe dÿ Enn lidennstund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 21,
      "text": "och buode | mett tuct och summe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 21,
      "text": "ther kom ridenn den | gamle greffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 21,
      "text": "hanndt Tog ham thill | sinn fannge. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 22,
      "text": "Høre du Nielus Marigreffuennssønn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 22,
      "text": "och | viltt du lade mig leffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 22,
      "text": "thett huide | sølff och thett røde guldt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 22,
      "text": "och thett | vill ieg diig giiffue. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 23,
      "text": "Haffue thu sielffuer ditt røde guldt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 23,
      "text": "ochsaa dinn guode gaffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 23,
      "text": "du giffue mig din | kiere festermøø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 23,
      "text": "ieg vill icki anndet haffue. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 24,
      "text": "Ieg vill icki haffue ditt huide sølff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 24,
      "text": "icki | heller ditt guldt saa rødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 24,
      "text": "giff mig din | kiere festermøø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 24,
      "text": "eller thu skaltt for hinde døø. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 25,
      "text": "Lennge stodt thenn gamle greffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 25,
      "text": "och tenckthe hanndt mett sig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 25,
      "text": "maa vell skee min | festermøø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 25,
      "text": "vnnder dig bedre ennd mig. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 26,
      "text": "Her liger skibe for lannde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 26,
      "text": "dÿ er alle rede | thill vanndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 26,
      "text": "tag du nu minn festermøø, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 26,
      "text": "før hennde nu mett dig hedenn vnder øø, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 27,
      "text": "Thag thu nu minn festermøø",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 27,
      "text": "før hennde aff | lanndt medt dig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 27,
      "text": "ieg haffuer dett for | sanndenn spuordt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 27,
      "text": "hunn vnnder dig beder | enndt mig |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 28,
      "text": "Ther holthe dÿ enn lidennstund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 28,
      "text": "och icki | holde lennge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 28,
      "text": "ther motthe hanndt see dÿ | forgÿlthe karme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 28,
      "text": "kom offuer dÿ grøne Enge |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 29,
      "text": "Thett var Nielus marigreffuenssønn, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 29,
      "text": "hanndt rider thill henngekarum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 29,
      "text": "hanndt | helsinett thenn skiønne Iomffru,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 29,
      "text": "och | tag hinnde ÿ sinn Arum. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 30,
      "text": "Høre ÿ dett Iomffru rosennkinndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 30,
      "text": "ÿ ere | enn lilie-vanndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 30,
      "text": "eders festermanndt | haffuer mig eder giffuitt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 30,
      "text": "vill ÿ følge | mig aff lanndt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 31,
      "text": "Dett suaritt ÿomffru Rosennkinndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 31,
      "text": "hun | smiller vnnder skinndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 31,
      "text": "ieg vill gierne | følge eder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 31,
      "text": "hierte-allerkieriste minn. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 32,
      "text": "Dett var stuor løst att see derpaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 32,
      "text": "dÿ | fulde denn iomffru thill strannde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 32,
      "text": "dÿ | lieger dÿ legthe dÿ Orer dÿ gick,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 32,
      "text": "dÿ | bølger dÿ legthe paa sanndt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 33,
      "text": "Hiem da red denn gamle greffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 33,
      "text": "och hand | haffde brudenn møst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 33,
      "text": "hunn vnnder | hannom Nielus Marigreffuennssønn |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 33,
      "text": "hunn vnnder hannom allerbest. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 34,
      "text": "Nu haffuer Nielus Marigreffuenns-sønn | ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 34,
      "text": "forvonndenn buode anngist och harm, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 34,
      "text": "saa haffuer och Iomffru Rosennkidt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 34,
      "text": "hunn soffuer vdj hanns Arm, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 34,
      "text": ":: Thu roffuer dig ved dinn Aarer. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 34,
      "text": "Ennde",
      "part": false,
      "marginal_notes": []
    }
  ]
}