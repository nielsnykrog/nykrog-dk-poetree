  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "SAlue Jesu Christe wor frelsermand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "tw som al Guds wrede offueruand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "att Adam ÿ teg naaden fandt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Thu æst wortt liff oc søde trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "bode ÿ modgang oc ÿ løst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "paa teg wÿ haabe O Jesu Christe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Wÿ paakalle teg vdi wor nødt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "som ere falne ÿ euig død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "met Heua wor moder alle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Wÿ raabe till teg aff thenne grædelige dal/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "wÿ græde oc sucke saadant ett fald/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Dog æst tw fuldt aff Guds gunst oc naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Thi hielp oss o naadefulde Christe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Eya Christe wor talsmand æst tw worden til wor Fader. Forlad oss for thin døds skyld alle sager.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "Oc wend thit naadefulde ansigt till oss wsle oc arme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "Oc lad teg mildelig altÿdt offuer oss forbarme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "O Jesu lær oss nw att kende Fader thin/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "hwes naade oc fromhed ÿ teg skÿn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 6,
      "text": "Lad oss saa kende hannom ÿ reth tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 6,
      "text": "att wÿ hans blide ansigt skoe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "Oc siden mett teg och hannom boo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 7,
      "text": "O gode Jesu/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 8,
      "text": "O milde Jesu/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 9,
      "text": "O søde Jesu.",
      "part": false,
      "marginal_notes": []
    }
  ]
}