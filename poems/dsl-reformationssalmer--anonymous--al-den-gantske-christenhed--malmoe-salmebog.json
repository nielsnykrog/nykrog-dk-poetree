  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "AL den gantske Christenhed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "priser Gudz barmhiertighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "for hans store kerlighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Det er nw sket som spaat hagde Esaias",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Gabrielis ord de ere nw fuldkomne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Eia Eia En Jomfru haffuer foster fød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "som Gud fader hagde iæt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "i fordom tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Nw er fød en frelsermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "en frelsermand i Jsrael/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "aff en Jomffru/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "som oss sagde Gabriel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Konningen wdaff hiemmerige/",
      "part": false,
      "marginal_notes": [
        "zach. ix"
      ]
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "kom her ned til iørderige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "ath han wilde gøre oss salige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Det er nw sket som spaat hagde Esaias",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "All den gantske menniskens køn",
      "part": false,
      "marginal_notes": [
        "Roma. v"
      ]
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "wor fortabit Gudz eniste søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "han haffuer henne nw løst igen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Det er nw sket som spaat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "Diffuellen hagde oss alle grebit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "met sin løgen oss beswegit/",
      "part": false,
      "marginal_notes": [
        "i. Cor ii Gene iii"
      ]
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "Christus haffuer hans mact knusid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "Det er nw sket som spaat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "Nu er kommen den salige tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "der Propheterne hagde om screffuit/",
      "part": false,
      "marginal_notes": [
        "Esa xlix"
      ]
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "ath Gud skulle giffue sin Søn her ned",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "Det er nw sket som spaat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "Huo som Gud Søn vil forsmaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": "och ey effter hans lærdom gaa/",
      "part": false,
      "marginal_notes": [
        "Deu xviii"
      ]
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "han kand aldrig naade faa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "Det er nw sket som spaat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "Hwo som synden wil offuergiffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 7,
      "text": "oc Gud om sin miskund bede/",
      "part": false,
      "marginal_notes": [
        "Esaie lv"
      ]
    },
    {
      "id": 34,
      "stanza_id": 7,
      "text": "han faar naade oc hiemmerige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "Det er nu sket som spaat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "Det haffuer oss Christus nu fortient der till haffuer hannem Gud vdsent/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 8,
      "text": "thi wor mact hun er inthit bewent",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 8,
      "text": "Det er nw sket som spaat",
      "part": false,
      "marginal_notes": [
        "ii Cor iii"
      ]
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "Der for bør oss tacke Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "frøcte hannem och holde hans bud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 9,
      "text": "thi han er den oss hielper aff nød",
      "part": false,
      "marginal_notes": [
        "Deutero xxx ii"
      ]
    },
    {
      "id": 42,
      "stanza_id": 9,
      "text": "Det er nu sket som spaat hagde Esaias",
      "part": false,
      "marginal_notes": []
    }
  ]
}