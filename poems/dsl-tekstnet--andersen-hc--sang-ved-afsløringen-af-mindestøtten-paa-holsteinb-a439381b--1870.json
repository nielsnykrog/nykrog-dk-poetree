{
  "id": null,
  "title": "Sang ved Afsløringen af Mindestøtten paa Holsteinborg, den 18de October 1870",
  "year_created": 1870,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1870,
    "url": "https://tekstnet.dk/books/andersen-hc_sang-ved-afsloeringen-af-mindestoetten-paa-holsteinborg-den-18de-october-1870/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Der var en Tid, – til Træl var Bonden kaaren,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Var ufri Mand, hans Huus en ussel Vraa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Uvidende fra Vuggen og til Baaren;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Men bedre Tider skulde Landet faae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Den Ufri blev fribaaren, Tanken klaret,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Nu sidder Bonden med i Kongens Raad;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Fra Slægt til Slægt, velsignet og bevaret,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Velgjører, staaer dit Navn, din ædle Daad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Her fra den gamle Gaard med Taarn og Fløie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "For Egnens Bønder Friheds-Ordet lød;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Snart Korn og Plantning krandsed’ Mark og Høie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Ind i hver Hytte Kundskabs-Straalen brød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Hil Frederik Adolf Holstein, vor Velgjører!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Her gik Du med din barnefromme Viv.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Til dette kjære Sted os Hjertet fører;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Bortgangne! see her Takkens Folkeliv!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Her, hvor I To gik kjærlige og stille",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Og virked’ Stort og Godt i Tro paa Gud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Skal Mindestøtten staae; er den end lille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Rigt Eftermælets Blomst groer fra den ud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Paa vor Velgjørers Fødselsdag vi mødes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Det hele Grevskabs Folk med Sang og Flag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Taknemlighed fra Slægt til Slægt gjenfødes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Den Dag i Dag er Hjertets Mærkedag!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Afsløret staaer med Indskrift Mindestenen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Og festligt staae i Hjerterne de To.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Hvert Foraar vil til Krandse Bøgegrenen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Sig snoe her, hvor Forglemmigeier groe;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Og Sagn fortælles om de ædle Tvende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Om Trofasthed i Glæde og i Sorg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "I Børn og Børnebørn vi dem gjenkjende. –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Velsigne Gud det kjære Holsteinborg!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
