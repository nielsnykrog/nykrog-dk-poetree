  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "HEllig er Gud fader/",
      "part": false,
      "marginal_notes": [
        "Esaie. vj."
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Hellig er oc saa Gud søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "med thennom baade oc wor hugswalare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "then Helliaand/ er hellig oc skøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "een eniste weldæder/",
      "part": false,
      "marginal_notes": [
        "Math. vj."
      ]
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "mod oss oc wore forfædre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "med flÿt han oss forsørger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Stercke første oc mechtige Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "offuer Sabaot alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Bode synd oc død oc ther till heluede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "for hannwm gantske motte falle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Ther fore er bode himmel oc iord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "forfylt med thÿn ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "oc skrige nw Hosianna.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Christo wære oc altÿd prÿss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "then ther kom ÿ Herrens naffn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "med vnderlig wÿss:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "wore synder allsammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "weldigen haffuer offuerwunden/",
      "part": false,
      "marginal_notes": [
        "Math. xxj. Luce. xix. Johan. xij."
      ]
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Oc haffuer sitt rÿge saa indnommen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Nw rober alle Hosianna",
      "part": false,
      "marginal_notes": []
    }
  ]
}