  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Mit Fædreland, hvor er du smukt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Midt i de sølvblaa Vande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Med Favnen fuld af gylden Frugt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Og Bøgekrands om Pande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Med Sagaskrift og Skjaldesang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Om gamle store Minder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Med Sprogets milde, bløde Klang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Og milde, bløde Kvinder!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Men mild og blød, som Landet selv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Som Himlen og som Jorden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Som Sprogets Fald og Kvindens Sjæl,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Den danske Mand er vorden;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Med uforskyldte Byrders Vægt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Han uden Harm vil skride,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Og heller end at handle kjækt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Han vil taalmodig lide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Han holder mest af Ro og Mag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Og helst med Lempe farer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Han hylder nok den gode Sag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "Men lunkent den forsvarer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "Han griber flux ej Stang og Staal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "Naar man hans Ret mon krænke;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "Nej - han maa først ha' \"Overmaal\",",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "Saa vil han - sig betænke!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "Men naar hans Elefantnatur",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "Engang er bleven vækket,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "Saa staar han ogsaa som en Mur,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "Standhaftig, uforskrækket;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "Saa har han Mod, saa har han Kraft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "Og for sin Ære flammer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "Saa har han Hænder to paa Skaft -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "Gud naade den, de rammer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 0,
      "text": "Mit Fædreland, mit skjønne Hjem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 0,
      "text": "Som tunge Tider trykke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 0,
      "text": "Du snart af dem skal gange frem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 0,
      "text": "Med Ærens frelste Smykke!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 0,
      "text": "Du skal ej atter vorde Træl",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 0,
      "text": "Og fremmed Svøbe smage!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 0,
      "text": "Ta'r man din Frihed bort - nu vel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 0,
      "text": "Saa ta'r vi den tilbage!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 0,
      "text": "Vi har et Hus ved Alfarvej,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 0,
      "text": "Kun tarveligt og lille;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 0,
      "text": "Til vore Vilkaar dog vist ej",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 0,
      "text": "Et større passe vilde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 0,
      "text": "Det vore Fædres Daad har set,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 0,
      "text": "Der har vor Barndom grædt og let,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 0,
      "text": "Der er vor Manddoms Gjerning sket,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 0,
      "text": "Der vil vi Øjet lukke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 0,
      "text": "Hvert Foraar hænges Taget paa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 0,
      "text": "De ranke Bøgestammer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 0,
      "text": "Og Bolstre grønne, gule, blaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 0,
      "text": "Opredes i hvert Kammer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 0,
      "text": "I Kjældren klapprer Møllens Drev,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 0,
      "text": "I Stuen Bonden, flink og gjæv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 0,
      "text": "Slaar Kornets tunge, gyldne Væv",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 0,
      "text": "Til Fuglesang fra Lofte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 0,
      "text": "Paa trende Sider har det Fred",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 0,
      "text": "Bag Havets blanke Gjerde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 0,
      "text": "Men intet Lukke eller Led",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 0,
      "text": "Det skærmer mod den fjerde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 0,
      "text": "Ja, Væggen der er styrtet ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 0,
      "text": "Saa Regnens Dryp og Solens Skin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 0,
      "text": "Saa fremmed Vrøvl og fremmed Vind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 0,
      "text": "Igjennem Huset trænger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 0,
      "text": "Vor Nabo ejer selv en Gaard",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 0,
      "text": "Med sexogtredve Bure,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 0,
      "text": "Men helst paa Eventyr han gaar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 0,
      "text": "Forinden vore Mure;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 0,
      "text": "I Hjemmet staar han under Pidsk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 0,
      "text": "Men her vil Fyren spille frisk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 0,
      "text": "Og sidde øverst ved vor Disk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 0,
      "text": "Og puffe os i Krogen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 0,
      "text": "Vel bli'r vi aldrig Herremænd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 0,
      "text": "I Verdens store Hige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 0,
      "text": "Og vi vil gjerne gaa i Spænd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 0,
      "text": "Med Smaafolk, vore Lige;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 0,
      "text": "Men vi vil ikke drikke Dus",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 0,
      "text": "Med den, som spytter i vort Krus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 0,
      "text": "Og Herrer i vort eget Hus",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 0,
      "text": "Vi først for Alt vil være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 0,
      "text": "Og derfor op, I Dannemænd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 0,
      "text": "Vor søndre Væg at bøde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 0,
      "text": "Med Ske i Haand og Sværd ved Lænd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 0,
      "text": "Som Een skal Alle møde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 0,
      "text": "Og Ingen blive ræd og træt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 0,
      "text": "Før vi har faaet Hytten tæt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 0,
      "text": "Saa kan vi sove trygt og let",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 0,
      "text": "Alt under Vaarens Pude!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 0,
      "text": "Vi har en lille Snekke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 0,
      "text": "Kun kort fra Stevn til Spejl;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 0,
      "text": "Lav er den oven Dække",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 0,
      "text": "Og lappede dens Sejl;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 0,
      "text": "Imellem Skær den krydser",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 0,
      "text": "Mod Vind og Strøm sig op,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 0,
      "text": "Og Bølgens Fraade kysser",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 0,
      "text": "Hel ofte Mastens Top.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 0,
      "text": "Engang i gamle Dage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 0,
      "text": "Saa vidt om Land den fo'r,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 0,
      "text": "Alt som en gylden Drage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 0,
      "text": "Med Vikinger ombord;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 0,
      "text": "Med Entrebiler fejed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 0,
      "text": "Den Bretlands rige Kyst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 0,
      "text": "Og Nevas Vover nejed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 0,
      "text": "Sig for dens brede Bryst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 0,
      "text": "Og Østersøens Nøgle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 0,
      "text": "Var naglet til dens Skrog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 0,
      "text": "Og Venderne i Bøjle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 0,
      "text": "Dens tunge Aarer drog. -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 0,
      "text": "Saa skred med Master trende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 0,
      "text": "Ad Tidens Flod den hen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 0,
      "text": "Snart svandt de ind til tvende;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 0,
      "text": "Nu er kun een igjen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 0,
      "text": "Men skjønt dens Glands er svunden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 0,
      "text": "Endnu den er ej Vrag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 0,
      "text": "Thi den er stærk i Bunden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 0,
      "text": "Og aldrig strøg den Flag;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 0,
      "text": "Og aldrig skal vor Snekke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 0,
      "text": "Er Storm og Sø end gram,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 0,
      "text": "I Havn sig lade trække",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 0,
      "text": "Som Tydsklands Mudderpram!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 0,
      "text": "Se, Friheds Vimpel vajer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 0,
      "text": "Fra Toppen, lys og ren!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 0,
      "text": "Den fører os til Sejer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 0,
      "text": "Naar Alle staa som Een.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 0,
      "text": "Lad Klogskabs Fyr os pejle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 0,
      "text": "Og følge Sandheds Naal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 0,
      "text": "Og Danmarks Skib skal sejle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 0,
      "text": "Med Ære til sit Maal!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 0,
      "text": "\"Danmark, du Perle, der svømmer paa Vove!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 0,
      "text": "Dig vil vi prise, og Dig vil vi love,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 0,
      "text": "Mens vi har Aande og Klang i vort Bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 0,
      "text": "Du af vor Arv er det dyreste Stykke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 0,
      "text": "Du er vor Hæders livsaligste Smykke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 0,
      "text": "Hjerternes Attraa og Øjnenes Lyst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 0,
      "text": "Tyv skal ej stjæle Dig, medens vi sove,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 0,
      "text": "Og lad den mægtigste Ransmand kun vove,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 0,
      "text": "Om han kan slukke dit Lys i sit Skrin!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 0,
      "text": "Du skal ej sælges til trælbaarne Sjæle!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 0,
      "text": "Du skal ej knuses af fremmede Hæle!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 0,
      "text": "Du skal ej kastes for vendiske Svin!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 0,
      "text": "Havet har slebet Dig Formerne bløde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 0,
      "text": "Solen har lært dine Kinder at gløde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 0,
      "text": "Og i dit Blik luer Stjernernes Glands:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 0,
      "text": "Spillende stedse i rigere Farve,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 0,
      "text": "Skal efter Fædre Dig Sønnerne arve,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 0,
      "text": "Funklende Led i den nordiske Krands!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 0,
      "text": "Vikingemoder, Dronning paa Havet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 0,
      "text": "Hvil paa din Græsbænk, rolig og kjæk!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 0,
      "text": "Sønnerne, som Du died og aved,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 0,
      "text": "Ubudne Gjæster skal gjenne væk!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 0,
      "text": "Kysse din Fod skal Ejderens Vove,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 0,
      "text": "Vifte din Kind skal Gefions Skove,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 0,
      "text": "Trygt i dit Skød skal Fremtiden sove,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 0,
      "text": "Tydske Herrer ej løse din Gjord!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 0,
      "text": "Thi naar Hejmdal griber Hornet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 0,
      "text": "Og dets Klang ruller hen over Sø, over Land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 0,
      "text": "Henad Heden, gjennem Kornet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 0,
      "text": "Skal vi haste til Slaget hver eneste Mand;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 0,
      "text": "Foran os ganger Thor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 0,
      "text": "Den stærke Gud i Nord;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 0,
      "text": "Thi han elsker det Folk, som er Asernes Æt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 0,
      "text": "Og han rammer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 0,
      "text": "Med sin Hammer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 0,
      "text": "Fjendeskaren, som bryder din Fred og din Ret.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 0,
      "text": "Vort Land, vort Land, vort Fædreland!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 0,
      "text": "Du Havets yngste Søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 0,
      "text": "Gom plasker i det blanke Vand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 0,
      "text": "Og tumler med det hvide Sand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 0,
      "text": "Og svinger, lys og mild og skjøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 0,
      "text": "Hver Vaar din Fane grøn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 0,
      "text": "Du fik ej Sølverbræ til Hat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 0,
      "text": "Til Skjold ej sorte Skær;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 0,
      "text": "Men i dit Fløjels Belte sat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 0,
      "text": "Der er af gyldne Ax en Skat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 0,
      "text": "Og Silkekappen, som Du bær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 0,
      "text": "Har Bræm af Svanefjer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 0,
      "text": "End er af Sind Du blød og veg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 0,
      "text": "Og end af Vilje svag;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 0,
      "text": "Du sysler helst med Skjemt og Leg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 0,
      "text": "Men blinker ej for Sværdets Eg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 0,
      "text": "Og gaar saa kaad og kjæk i Slag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 0,
      "text": "Som Andre til et Lag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 0,
      "text": "Og faar Du Lov at voxe ud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 0,
      "text": "Ved Friheds sunde Marv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 0,
      "text": "Du vorder nok en Kæmpe prud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 0,
      "text": "Og fæster Dig en Kongebrud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 0,
      "text": "Og løfter, klog paa eget Tarv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 0,
      "text": "De store Fædres Arv.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
