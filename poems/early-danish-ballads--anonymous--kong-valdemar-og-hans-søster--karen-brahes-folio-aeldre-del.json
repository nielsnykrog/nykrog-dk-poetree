{
  "id": null,
  "title": "Kong Valdemar og hans Søster",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA49.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Droning Soffe och kong Ollemuor seder offuer buord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": ":: Saa herlig gangis di pib. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "di snackitt saa mangtit skemffulds ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Mellom Roskieeld och Ribe. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "\"I wider meg en bøøn, kerre herre myn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "well y giffue Borris hind lidenn Kierstienn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "\"Tthett tøckis meg att werre fuld stuor en harnn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "att giffue myn søster en sleffred-barnn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "\"Ttha skall ieg ind sigge eder større harum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "liden Kiersten hun gaar med Borriesis baarnn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "Kongenn hand blegner y sin kiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "hand feck stuor sorig vdj synde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "Kongen gaar sieg i stoffuen ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 5,
      "text": "som ald hans rider drak mød och winn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "\"Her seder alle myn mend, drecker mød och wyn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "huelckenn well hiente hind liden Kierstinn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "Alle saad thi rider och thauffde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 7,
      "text": "for-vden liden Boris, hand suaritt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "\"Alle maa suendenn drecke wyn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 8,
      "text": "ieg well hiente hind liden Kierstinn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "\"Tu sed nu, Borre, du sed och thy!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 9,
      "text": "her Eller skall hente hind liden Kierstinn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "Statt op, her Eiller, och kled theg brat!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 10,
      "text": "du skalt hintte min søster y natt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "Her Eller hand kaam till klosters porrtt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 11,
      "text": "vd kaam den pribis, gick hanom imod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "\"Her stander y, pribis, buod fuoer och fienn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 12,
      "text": "huor lider liden Kierstenn, ker søster minn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "\"Her lieger ingen y kiender-liee:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 13,
      "text": "landgangs-siuge giør hinder stuor thrøe.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "Her Eyller rie till wienduet, och ind hand suo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 14,
      "text": "thaa brende der lysz y huerind wraa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "Ther brend liysz y huerend wraa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 15,
      "text": "och woxe-kiartter, som liden Kierstenn hun luo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "Her Eyller axler skaarlagen-skiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 16,
      "text": "hand gar y stoffuen for liden Kiersten ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "Her Eyller ind aff døren thrend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 17,
      "text": "lidenn Kiersten hinder fald thaar paa kiend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 18,
      "text": "Lidenn Kersten klaper paa hynde bllaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 18,
      "text": "\"Well y, kere broder, huile her-paa?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 19,
      "text": "Ieg falt vd aff wor hyffue-loffts-braa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 19,
      "text": "saa ilde der ieg mit hoffuet sluo.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 20,
      "text": "\"Tthu statt op, søster, kled theg braat!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 20,
      "text": "thu skalt følge meg til kongen y natt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 21,
      "text": "Liden Kiersten drog y sin sølleff-spent skuo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 21,
      "text": "\"Droning Soffe haffuer woldt meg denne v-ro.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 22,
      "text": "Lidenn Kierstenn drog y sinn silcke-serck:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 22,
      "text": "\"Skaam faa droning Soffi for hiartens werck!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 23,
      "text": "I thager myn datter, suøber hinder y lin!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 23,
      "text": "ret aldrig sier du merre moder dinn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 24,
      "text": "Dy slog offuer hinder kaaben blaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 24,
      "text": "saa løffte thi hinder paa ganger graa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 25,
      "text": "Kongen hand stuod och suo der-paa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 25,
      "text": "liden Kierstin falt thøse fra ganger graa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 26,
      "text": "Tøsser falt hun aff hyffuen hest:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 26,
      "text": "alt suo kongenn, hinder sadellgiord brast.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 27,
      "text": "Liden Kiersten rider y danerkongens gaard:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 27,
      "text": "dronig Soffi hun huoss hanom vde staar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 28,
      "text": "Kongenn klaper hinder wed huiden kiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 28,
      "text": "\"Thu werre well-komen, kerre søster myn!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 29,
      "text": "Kongen slo offuer hinder skaarlagen-skiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 29,
      "text": "hand fulde hinder selleff i hyffue-lofft ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 30,
      "text": "\"Hør thu, kerre søster, huad ieg siger deg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 30,
      "text": "en elskuoff-wisz daa qued thu meg!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 31,
      "text": "\"En elskoffues-wise ieg aldrig nam:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 31,
      "text": "ieg queder gierme en anden, thett fieerste ieg kand.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 32,
      "text": "Hun gick y dansz, och for hun quad:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 32,
      "text": "well fembten rider efter hinder trad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 33,
      "text": "Liden Kersten danzit buod vd och ind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 33,
      "text": "alt rinder hinder mielk vnder skaarlagen-skiend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 34,
      "text": "\"Hør thu, lidenn Kierstenn, kerr søster mynn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 34,
      "text": "wilt thu skiffte beltte med broder dinn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 35,
      "text": "Hun løste aff seeg buode belte och bond:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 35,
      "text": "hun stuod saa small som lile-wand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 36,
      "text": "Kongen sluo daner-kongen wed huiden kiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 36,
      "text": "\"Hui haffuer du løffuet paa søster myn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 37,
      "text": "Tthett giorde droning Soffi vdj stuor harum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 37,
      "text": "saa drog hun vd brysten aff liden Kierstens barum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 38,
      "text": "Hun molckitt den mielck for kongens fuod:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 38,
      "text": "\"Myn edelig herre, throer y myn ord!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 39,
      "text": "Kongen thaaller til suene sinne:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 39,
      "text": "\"Y hienter meg ind thj biedsell fem!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 40,
      "text": "I henter meg ind thi biesell feem!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 40,
      "text": "liden Kiersten skall slide alle dem.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 41,
      "text": "Hand sluo hinder y thimer ny:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 41,
      "text": "icke wilde droning Soffi hinder hielpe y dy.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 42,
      "text": "Hun krøb vnder innfru Soffies skiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 42,
      "text": "hun skød hinder vd med føder sinn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 43,
      "text": "Saa sluo hand hinder saa lenge:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 43,
      "text": "ind-til hand suo hindis luonge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 44,
      "text": "Hand sluo hinder saa møøde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 44,
      "text": "saa snarlig bleff hun døde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 45,
      "text": "Tthett melte droning Soffi, hun thog saa paa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 45,
      "text": "\"Y leger thett lig vnder Holste-bro!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 46,
      "text": "I leger thett ligg vnder Ribbe-bro:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 46,
      "text": "och huer dag vnder mym ganger skuo!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 47,
      "text": "\"Hun skall icke kome vnder Ribbe-bro:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 47,
      "text": "och aldrig vnder dinn ganger skuoff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 48,
      "text": "I ladder førre thett lig thill Wester-wig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 48,
      "text": "saa sielden skalt thu kome, Soffj, did.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 49,
      "text": "Der-til willde ieg giffue mit guld saa rød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 49,
      "text": "thett min ker søster war icke død.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 50,
      "text": "\"Haffde hun weritt søster min som din:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 50,
      "text": "da skulde ieg haffue skiulet hinder vnder min skiend.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 51,
      "text": "Tthett stuod saa y XV aar:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 51,
      "text": "op wegste stalt Lutze-lild, enn spedell saa klaar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 52,
      "text": "Kongen och droning Soffi di saad y swalle:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 52,
      "text": "ther bleff thi om stalt Luselild at thaalle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 53,
      "text": "\"Hør y, daner-kongen, huad ieg sigger eder:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 53,
      "text": "maa stalltt Lutzelild were huosz meg?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 54,
      "text": "\"Saa giernne giffuer ieg mit minde der-till:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 54,
      "text": "alt om hun Lutzelild hun selliff saa well.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 55,
      "text": "Kongen hand lader thi breffue vdschriffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 55,
      "text": "hand lader stalt Lutzelild dem y klosterit giffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 56,
      "text": "Tthett første stalt Luzelild breffuen suo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 56,
      "text": "\"Rad Gud, alt huor min morbroder maa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 57,
      "text": "I lader graa ganger aff stallen vd!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 57,
      "text": "saa leger y hanom gylt saadell paa!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 58,
      "text": "Ther hun kaam til borige-lied,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 58,
      "text": "daner-kongen hand stuod der-wed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 59,
      "text": "\"Well-komen, stalt Luzelild, kerre søster-dater myn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 59,
      "text": "huor haffuer theg y chloster lid?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 60,
      "text": "\"Well haffuer meg y chloster lid:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 60,
      "text": "Chreste segne eder, kerre morbroder myn!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 61,
      "text": "\"Hør thu, stalt Luselild, huad ieg siger deg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 61,
      "text": "welt thu thine droning Soffi, hun begierer deg?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 62,
      "text": "Du skalt icke giøre andit huoss hinder:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 62,
      "text": "ind berre hindis nøgele och tage hindies skiend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 63,
      "text": "Ind bere hindis nøgele och tage hinder skiend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 63,
      "text": "och følge hinder selleff buod vd och ind.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 64,
      "text": "\"Fuld ilde haffuer ieg steed mit fuorre haar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 64,
      "text": "om ieg skuld nu bliffue Soffis moorr!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 65,
      "text": "Fuld ilde haffde ieg steed min rosens-kind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 65,
      "text": "om ieg skulde følge Soffi vd och ind!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 66,
      "text": "Før skulde ieg meg y chloster giffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 66,
      "text": "och thiene wor frwe, men ieg maa løffue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 67,
      "text": "Tthett suaridt droning Soffi, som hun stuod:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 67,
      "text": "for hun war vnd och icke guod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 68,
      "text": "\"Første thu komer i kloster ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 68,
      "text": "saa yper du moders kynde dinn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 69,
      "text": "\"Kerr morbroder, giffuer meg luoff dertil:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 69,
      "text": "att suarre hinder, Soffi, alt som ieg well!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 70,
      "text": "\"Fuld well giffuer ieg myt loff der-till:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 70,
      "text": "thu matt well suare, alt som du wellt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 71,
      "text": "\"Loffuet myn muoder en fremit suend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 71,
      "text": "daa luodst du her Ouistalderind .",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 72,
      "text": "Du loffuet hanom icke iene:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 72,
      "text": "men erike-bespen aff Skaanne.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 73,
      "text": "\"Imeden ieg hørrer slig thiding til theg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 73,
      "text": "tha skynt deg snartt aff gaarde fraa meg!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 74,
      "text": "Men du haffuer laditt thi rider ind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 74,
      "text": "ret aldrig bliffuer du mer droning myn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 75,
      "text": "Stalt Luselild hun aff garden red:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 75,
      "text": "igen stuod dronig Soffi, sinn hender hun wred.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 76,
      "text": "Stalt Luzelild red aff gaarde saa brat:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 76,
      "text": ":: Saa herlig gangis di pib. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 76,
      "text": "hun kam til chloster y den same natt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 76,
      "text": ":: Emellom Roskield och Rippe. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}