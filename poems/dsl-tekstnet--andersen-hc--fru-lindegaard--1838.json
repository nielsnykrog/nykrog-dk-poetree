{
  "id": null,
  "title": "† Fru Lindegaard",
  "year_created": 1838,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1838,
    "url": "https://tekstnet.dk/books/andersen-hc_fru-lindegaard/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Jeg veed et Sted midt paa den fyenske Ø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Et deiligt Sted, saa skovrigt og saa bakket;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Der staaer, tæt ved den speilklar’ friske Sø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "En gammel Herregaard med Gavlen takket,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Hvor Svalen bygger og hvor Storken boer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Thi Egnen rundtom er et lille Eden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Og skal jeg nævne Gaardens Navn, jeg troer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Betegnende vi nævne: Gjæstfriheden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "»Velkommen!« lød det her med Hjertets Ord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Men hiint Velkommen siger hun ei længer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Hun, som for Armod dækkede sit Bord;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Ved aaben Dør nu Sørgefloret hænger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Hun var saa blid mod Fattig, som mod Riig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Tilfredshed, Glæde rundt om sig hun skabte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Nu staaer i Landsbykirken hendes Lig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Og Bonden græder, han en Moder tabte.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
