{
  "id": null,
  "title": "Valdemar vender tilbage",
  "year_created": 1861,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Carsten Hauch",
    "country": null,
    "wiki": "Q688529"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Valdemar Atterdag",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1861,
    "url": "https://tekstnet.dk/books/hauch-c_valdemar-atterdag/024/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Kong Volmers høie Snekke sig gynged under Ø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Dronning Helvig den speided alt langt udi Sø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Da sagde til de Terner den kongelige Viv:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "»Hvis Nogen os forraader, det gjelder hendes Liv.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Hun sagde: »Min Hu mig forkynder intet Godt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "En Kirke vil jeg bygge saa høi som et Slot,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Og hundrede Voxlys skal brænde deri",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "For Helgenes Billeder, om de vil staae mig bi.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Kong Volmer stod i Stavnen, han troede Lykken nær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Han haabed snart at favne den, han meest havde kjær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Han bragte Brev tilbage fra Pavens egen Haand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Ham Kirken havde løst fra hans Ægteskabsbaand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Hans Skib kasted Anker, han selv paa Stranden stod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Da hørte han de Tidender, der ginge ham imod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "I Borgportens Hvælving ham mødte det Bud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "At den, som meest han elsked, var vorden Dødens Brud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Da skjalv den Herres Læber, han sortned som Jord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Han satte sig i Hallen, han mæled intet Ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Meldte da Dronning Helvig: »Hun døde her af Pest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Den er nu i Danmark den allerværste Gjest.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Den har alt lagt i Graven saamangen faver Mø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Hendes Legem vi sænked i den dybeste Sø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Paa det ikke Smitten til Andre skulde naae.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "Kong Volmer sad stille, han svared ei derpaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Med dødningblege Læber han sad i Dage tre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Kun dem, Hr. Henning bragte, dem vilde han see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Da meldte den liden Hofdreng, han sagde det i Løn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "»Jer Hustru har myrdet den Jomfru saa skjøn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "Hun fandt i de glohede Bølger sin Død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Vi hørte hendes Skrig i den yderste Nød;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "Paa guldfarvet Sadel hun red gjennem By,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "Men bares bort i Kisten, beslagen med Bly.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "Da reiste sig Kong Volmer med dirrende Fod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Han slog sin Haand mod Bordet, saa den drypped med Blod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "Saa lod han Dronning Helvig bringe til sig ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "Hun spurgte: »Min Herre, hvi er I dog saa vred?«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "Han sagde: »Jeres Lige man finder ei paa Jord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Med mine værste Fjender I Eder sammensvor.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "Hun svared: »Min Herre, skjøndt det synes Jer saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "At gjøre Jer mindste Skade jeg aldrig tænkte paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "Jeg meente, det gjaldt kun om Tovelilles Sag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Mig Eckhard havde skuffet med List og Bedrag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "Jer Frihed at røve, det faldt mig aldrig ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "Jeg vilde Jer kun skille fra den listige Qvind.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "Han svared: »I har viist os, hvad Ondskab formaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "I Grusomhed og Avind Jer Ingen overgaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "Og heller ei i Rænker, hverken Viv eller Mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "En Djævel fra Helved knap dertil er istand.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "Han bød, hun skulde føres i Fangetaarnet ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "Hvor Guldgaasen blinked og dreied sig for Vind;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "Han sagde: »Der tilvisse Du bliver, til Du døer.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "Hun bad kun til Afsked at skue sine Møer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 13,
      "text": "Hun sukked: »Jeg vil, at der læses over mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "De Bønner og Vigilier, der læses over Lig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "Og lad dem synge Psalmer, som om jeg nu var død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "Og alt var bestedt i Skærsildens Nød.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "Den Herre red i Tanker heel tidt ved Gurresø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Hvor før han havde jaget med den ædelbaarne Mø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "Han satte sig ved Vandet ved den skovklædte Strand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "Ham fulgte hans Falk, den sørgede som han.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 15,
      "text": "Det lod, som om Sorgen havde sløvet hans Aand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "Det lod, som Danmarks Fjender igjen fik overhaand;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "Han sagde: »Hvad agter jeg de Menneskers Kiv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "Jeg er kjed af at herske, jeg er kjed af mit Liv.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 16,
      "text": "Da mæled en Dannerkæmpe: »Min ædle Herre god,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "I spilde dog ei saa Eders Kraft, Eders Mod!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "Paa Jorden har I tabt Eders kjæreste Ven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "Hos Gud i det Høie I findes igjen.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 17,
      "text": "Han svared: »Eders Drømme jeg kan ei forstaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "At vi skal atter samles, det troer jeg ikke paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "I den jordiske Sommer min Lykke jeg fandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "Alt Andet mig synes kun Daarskab og Tant.«",
      "part": false,
      "marginal_notes": []
    }
  ]
}
