  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Langebeks kvart",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1573,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/LNGK53.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Dette waar ungenn herre Karll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hannd skule | Aff lanndett fare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "hannd fick here Tore sinn | broder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "sinn feste-møø Att for-waare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: sinnn | Iomffrue for-glemer suennden Allderiig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Hør du dett mienn kiere broder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "ieg tooer theg | Allder-beste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Ieg beffaller Tiig mÿnn feste-møø |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "hun Ere mig Aller-kiereste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": ":: S ÿ f G S A | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Ieg skall hinder fuld-well wochete",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Ieg skall | hienne fulde-well frÿ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "hinnde shall inngenn | Annder ssuennde faa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Altt om mig winndes | liiff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": ":: S I f | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Ieg shall hiender fulde-well wochte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "ieg Skalle | hiennder fulde-well Gieme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "hinnder faar | Alderiig Annder suennde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "før-ennde Thu | komer sielffuer hieme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": ":: S I f | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "Dett war unnngenn herre karrle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "fore Aff | lanndett wde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "effter sade hanns festemøø |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "medth dageligie soriig ÿ hoffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": ":: S I f | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "Thette ware Icke der-effther",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "for-wdennn | Enn Stackett Thiide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "thett sporde here | Tidemanndt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "hannd Achett Att Giørde | hanum suig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": ":: S I f g S A | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "Thede war herre Tiidemannd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "hannde | kom der Riidenn ÿ Gaarde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "wde stander | herre peder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": "hannd ware well Suobett ÿ marde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 6,
      "text": ":: S I f | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "Her stannder ÿ herre peder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 7,
      "text": "ÿ Erer | Enn manndt Saa finn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": "ÿ giiffuer meg | eders datter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 7,
      "text": "Tiill kiere høstrue minn |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 7,
      "text": ":: S I f g S A | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 8,
      "text": "Thedtt ieg giiffuer eder mÿnn datter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 8,
      "text": "du maa | hiner Ickii haffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 8,
      "text": "Ieg haffuer giiffuett | hinnde hinn vnnge herre Karll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 8,
      "text": "Thedt | Anger mig Alle mÿnne dage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 8,
      "text": ":: S I f g s A | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 9,
      "text": "Saa well kiennder Ieg hinn vnnge | herre Karll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 9,
      "text": "Ieg wiill hannom icke | Ennde fordefraa wiige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 9,
      "text": "ÿ giiffuer mig | liidelenn kierstiinn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 9,
      "text": "Ieg welle hiende | Alderiig suig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 9,
      "text": ":: S ÿ f | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 10,
      "text": "fram Gick herre peder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 10,
      "text": "hannd ware En | manndt Saa haarde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 10,
      "text": "gaff hannd bortt | sinn datter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 10,
      "text": "for-wdenn hinndis Egenn | raadth:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 10,
      "text": ":: S: I | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 11,
      "text": "Inndt kom hienndes moder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 11,
      "text": "hun Sagde | hinder disse Tidenne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 11,
      "text": "Thinn fader | haffuer deg her Thiidemanndt giffuit |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 11,
      "text": "hannde Er Ennn Riider saa fin:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 11,
      "text": ":: S I f | g S A | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 12,
      "text": "Thede Suarde liidenn kierstinn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 12,
      "text": "med Angest | Oc soriige-fulde hauff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 12,
      "text": "huad shall ieg suare | hinn vnge here Karll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 12,
      "text": "som ieg haffuer | giffuet minn Troffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 12,
      "text": ":: S I | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 13,
      "text": "Her karll hannd Er aff lande wde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 13,
      "text": "du Seer | hanom Alderiig miere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 13,
      "text": "here Tiidemannd buode | slotte Att Leenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 13,
      "text": "hannd kannd Thiig holde | medt Erre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 13,
      "text": ":: S I f g S A | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 14,
      "text": "Ieg Acther icke Om here Thiidemanndt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 14,
      "text": "icke Eller Om hanns møgen riige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 14,
      "text": "mÿnn | fader haffuer mig hinnde wnnnge here karll | giiffuett",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 14,
      "text": "Ieg well hannomm Allderiig suige |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 14,
      "text": ":: S I f G S A | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 15,
      "text": "Dett war herre Tiidemand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 15,
      "text": "hannd war Ennn mand | Saa bradtt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 15,
      "text": "rider hannd Tiill sinn brøllup then | same mannetz-dag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 15,
      "text": ":: S I f | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 16,
      "text": "Liidell kierstinn hunn huerckenn Aede Ellder drecke |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 16,
      "text": "saa mangefolde war hinndis Quide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 16,
      "text": "før hun ficke | itthe saa Lonnligenn buode",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 16,
      "text": "herre Thuorde thii | Tiidenn s kunde siige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 16,
      "text": ":: S I f g S Aldriig | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 17,
      "text": "Thede ware lidenn kierstinn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 17,
      "text": "hun sende here | tuorde saa buode",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 17,
      "text": "minn fader haffuer mig here | Tiiedemannd giiffuitt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 17,
      "text": "thett Ere mig sare emodt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 17,
      "text": ":: S I f | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 18,
      "text": "Tu beder kierstinn hun sende herre Tuorde saa | buode",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 18,
      "text": "mÿnn fader haffuer meg her Tiidemanndt | giiffuitt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 18,
      "text": "thett Er mig saare emodt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 18,
      "text": ":: S I f | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 19,
      "text": "Tu beder her Tuorde hannd Tencker der-paa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 19,
      "text": "huad hannd loffuett sinn broder ÿ hannd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 19,
      "text": "att | tenncke paa tro Oc loffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 19,
      "text": "Oc hielpe mig Aff thenn | wannd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 19,
      "text": ":: S I f g S A | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 20,
      "text": "Thed suarede vngenn here Tuord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 20,
      "text": "der hannnd | the Thiidenn saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 20,
      "text": "weell Gud ieg leffuer |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 20,
      "text": "her tiidemannd schall hinner Allderig faa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 20,
      "text": ":: S I | f g S A | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 21,
      "text": "Bede hennde ede Oc dricke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 21,
      "text": "Oc were ÿ hiertett saa Frij, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 21,
      "text": "Ieg skall hennde wid thenn Anngiste skillie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 21,
      "text": "Alth Ohm | meg wendis liff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 21,
      "text": ":: s I fo | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 22,
      "text": "Komer ieg icke ohm leffuerdagenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 22,
      "text": "thaa komer ieg møgett | sildig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 22,
      "text": "thaa skall ieg komme ohm sonndag morgenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 22,
      "text": "Oc | følge hannom brudenn hiem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 22,
      "text": ":: s I f | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 23,
      "text": "Førde the thenn wnnge brud ÿ herre thiidemannds gaardt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 23,
      "text": "thett huide sølff thett røde guld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 23,
      "text": "ther war for thennom | wsparth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 23,
      "text": ":: s I f | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 24,
      "text": "Alle thaa saade the Brøllups-folck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 24,
      "text": "saa glaade offuer bordt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 24,
      "text": "thaa kom wnngenn herre thordt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 24,
      "text": "wdj thenn Brøllups-gaardt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 24,
      "text": ":: s I F | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 25,
      "text": "Slagenn Bliff herre thidemannd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 25,
      "text": "thett war enn ønckellig | mordth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 25,
      "text": "Oc fanngenn bliff wnngenn her thordt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 25,
      "text": "thett hagde hannd werrett wuerdt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 25,
      "text": ":: s: I: f: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 26,
      "text": "Slagenn bliff her thidemannd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 26,
      "text": "thett war enn ønckelig | farth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 26,
      "text": "fanngenn bliff wnngennn her thordt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 26,
      "text": "thett | hagde hannd werrett wuerdt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 26,
      "text": ":: s: I: f: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 27,
      "text": "Thog the herre thidemannds lig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 27,
      "text": "dij lagde thett liig | ÿ Iordt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 27,
      "text": "thoge the wnngenn her thordt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 27,
      "text": "satte hanom | ÿ hardenn Iernn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 27,
      "text": ":: s: I: f: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 28,
      "text": "Brudenn hun sider paa Brude-bennck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 28,
      "text": "hun greder | aff mange møde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 28,
      "text": "hun greder miere for her thordt | ere fanngenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 28,
      "text": "end for her thiide-mannds død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 28,
      "text": ":: s: I: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 29,
      "text": "Thett melthe Brudenns moder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 29,
      "text": "mett Angesth oc min, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 29,
      "text": "ÿ spennder nu Hestene hester for kiarmer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 29,
      "text": "met | sorig saa Faarer wÿ hiem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 29,
      "text": ":: s: I: F: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 30,
      "text": "Thett suarde her thiidemannds moder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 30,
      "text": "ÿ Raadenn war | hun icke sienn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 30,
      "text": "Ennd haffuer ieg enn Anndenn sønn |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 30,
      "text": "thenn giffuer wÿ lidenn kierstinn igien",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 30,
      "text": ":: s: I: F: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 31,
      "text": "Igur war ieg enn wnnger brud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 31,
      "text": "ÿ dag enn sorigfuld | Enncke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 31,
      "text": "Ieg wiill icke saa wdj Arffue gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 31,
      "text": "ÿ thør | thett icke thenncke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 31,
      "text": ":: s: I: F: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 32,
      "text": "Thett suarde henndis fader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 32,
      "text": "Oc saa thog hannd Paa, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 32,
      "text": "Icke skall thett Alsamenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 32,
      "text": "epter thinn egenn wilge | gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 32,
      "text": ":: s: I: F: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 33,
      "text": "Frem gick here Lauj",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 33,
      "text": "war kled wdj skarlagenn smaa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 33,
      "text": "her Peder giffuer meg Ethers dather,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 33,
      "text": "Menns min | broder icke leffue maath",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 33,
      "text": ":: s: I: f: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 34,
      "text": "Opstod herre Peder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 34,
      "text": "hannd war enn mand saa | haardt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 34,
      "text": "gaff hannd hennde thenn Anndenn broder | bort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 34,
      "text": "for-wdenn henndis egenn Radh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 34,
      "text": ":: s: I: F: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 35,
      "text": "I spennder nu Heste for karme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 35,
      "text": "ÿ lader osz fare hiem |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 35,
      "text": "ÿ Reder tiill Brøllupe ohm monettz mod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 35,
      "text": "wÿ komer | well Alle igienn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 35,
      "text": ":: s: I. F: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 36,
      "text": "Staalthe mettellille med henndis Iomfruer oc møer |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 36,
      "text": "the søir mett silcke oc guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 36,
      "text": "lidenn kiestenn hun | gaar baade wdh oc Innd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 36,
      "text": "hun er saa sorigfuld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 36,
      "text": ":: s: I: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 37,
      "text": "Thett melthe stalthe Frue Mettellile,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 37,
      "text": "Oc saa thog hun | Paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 37,
      "text": "hør thu lidenn kiestenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 37,
      "text": "huor-Fore sørger | thu saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 37,
      "text": ":: s: I: F: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 38,
      "text": "Hør thu min kiere dather,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 38,
      "text": "thu lader bortfaare thinn | quide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 38,
      "text": "her laffue hand ere thenn Rigeste Rider |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 38,
      "text": "som ere wdj thette Riige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 38,
      "text": ":: s: I: F: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 39,
      "text": "Meg ere icke ohm her laffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 39,
      "text": "eller ohm hanns | møgette guldh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 39,
      "text": "Aldrig leffuer hand saa goed | enn dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 39,
      "text": "Ieg bliffuer hannom wdj hiertett | huld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 39,
      "text": ":: s: I: f: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 40,
      "text": "Thett war lidenn kierstenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 40,
      "text": "hun writt hendis | huide hannd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 40,
      "text": "see thett wor-here forkiert |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 40,
      "text": "here karll skulle faare aff lanndh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 40,
      "text": ":: s: I: f: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 41,
      "text": "Fanngenn ere wnngenn her thordt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 41,
      "text": "her karll | hannd ere aff landett wde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 41,
      "text": "nu wed ieg Ingen | ÿ werdenn thiill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 41,
      "text": "ther meg wil hielpe aff thene Nød |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 42,
      "text": "Dett war icke ther-epter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 42,
      "text": "dage for-wden Moneth | fems,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 42,
      "text": "thaa kom wnngenn her Karll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 42,
      "text": "sielffuer ÿ | landett hiem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 42,
      "text": ":: s: I: for: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 43,
      "text": "Thett war wngenn her karll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 43,
      "text": "kom ÿ sinn Moders | gaardt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 43,
      "text": "thett war hanns kiere moder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 43,
      "text": "hun gaar | hannom wd emodh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 43,
      "text": ":: s: I: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 44,
      "text": "Epter skulle ieg Ether spørge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 44,
      "text": "Ieg wed icke huilcke | først",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 44,
      "text": "leffuer min her thordt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 44,
      "text": "eller ere min festemøe | fest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 44,
      "text": ":: s: I: F | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 45,
      "text": "Thiidinng skal ieg theg siige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 45,
      "text": "som ieg icke giernne giorde |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 45,
      "text": "thin festemøe ere Encke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 45,
      "text": "thinn broder sider fanger | ÿ Iernn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 45,
      "text": ":: s: I f | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 46,
      "text": "Ere min festemøe Enncke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 46,
      "text": "thaa staar hun thiill att | faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 46,
      "text": "Oc ere min broder fanngenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 46,
      "text": "ther-thiill | staar mange goede Raadh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 46,
      "text": ":: s: I: f: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 47,
      "text": "Hør thu thett min kiere sønn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 47,
      "text": "Ieg siger theg halffue | miere mien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 233,
      "stanza_id": 47,
      "text": "thett ere hinn Rige her laffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 234,
      "stanza_id": 47,
      "text": "haffuer | fest thinn Iomfrue igienn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 235,
      "stanza_id": 47,
      "text": ":: s: I: f: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 236,
      "stanza_id": 48,
      "text": "Haffuer her laffue min Iomfrue festh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 237,
      "stanza_id": 48,
      "text": "for hand | will giøre meg thett thiill harm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 238,
      "stanza_id": 48,
      "text": "Aldrig leffuer | hand saa goed enn dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 239,
      "stanza_id": 48,
      "text": "hannd leger hennde | ÿ sinn Arm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 240,
      "stanza_id": 48,
      "text": ":: s: I: f: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 241,
      "stanza_id": 49,
      "text": "Hør thu thett min kier søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 242,
      "stanza_id": 49,
      "text": "du were icke holle seenn, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 243,
      "stanza_id": 49,
      "text": "atthu giffuer lidenn kierstinn boede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 244,
      "stanza_id": 49,
      "text": "ther-aff Atthu | ere komenn hiem, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 245,
      "stanza_id": 50,
      "text": "Her Karll hand sende hanns festemøe bod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 246,
      "stanza_id": 50,
      "text": "lad hende | huerckenn sørge eller quide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 247,
      "stanza_id": 50,
      "text": "hand wil sielffuer thiill | henndis Brøllupe komme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 248,
      "stanza_id": 50,
      "text": "Ohm hanom windis liff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 249,
      "stanza_id": 50,
      "text": ":: s: I: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 250,
      "stanza_id": 51,
      "text": "Thett suarde lidenn kierstinn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 251,
      "stanza_id": 51,
      "text": "ther hun the thiidinng | saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 252,
      "stanza_id": 51,
      "text": "Raade gud-fader ÿ hemerig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 253,
      "stanza_id": 51,
      "text": "huad ende | thett will faa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 254,
      "stanza_id": 51,
      "text": ":: s: I: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 255,
      "stanza_id": 52,
      "text": "Førde the thenn wnge brud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 256,
      "stanza_id": 52,
      "text": "wdj her lauffuis gaardt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 257,
      "stanza_id": 52,
      "text": "thett huide søll thett røde guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 258,
      "stanza_id": 52,
      "text": "thett war ther | wspart,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 259,
      "stanza_id": 52,
      "text": ":: s: I: F: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 260,
      "stanza_id": 53,
      "text": "Her Kaarll wille huerckenn ede eller dricke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 261,
      "stanza_id": 53,
      "text": "icke | søffuenn ohm Nathenn soffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 262,
      "stanza_id": 53,
      "text": "førind hand fick | løsth sinn Broder aff Iernn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 263,
      "stanza_id": 53,
      "text": "fick wondenn sinn | skønne Iomfrue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 264,
      "stanza_id": 53,
      "text": ":: s: I: f: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 265,
      "stanza_id": 54,
      "text": "Thett war ohm enn sønndag Morgenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 266,
      "stanza_id": 54,
      "text": "the preste | the løste oc sange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 267,
      "stanza_id": 54,
      "text": "Bort red her Karll met frenner | sine",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 268,
      "stanza_id": 54,
      "text": "hand thog sinn broder aff fange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 269,
      "stanza_id": 54,
      "text": ":: s: I: f: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 270,
      "stanza_id": 55,
      "text": "Ennd giorde hand thenn same dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 271,
      "stanza_id": 55,
      "text": "førind folckenn | giennge thiil Boerds,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 272,
      "stanza_id": 55,
      "text": "saa red hand thiill thenn | Brøllups-gaardt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 273,
      "stanza_id": 55,
      "text": "slagenn bliff her lauffue, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 274,
      "stanza_id": 55,
      "text": "thett war enn ønckellieg mordt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 275,
      "stanza_id": 55,
      "text": ":: s: I: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 276,
      "stanza_id": 56,
      "text": "Thett giorde wnngenn her Karll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 277,
      "stanza_id": 56,
      "text": "thenn same dag | hand war enn Rider saa goed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 278,
      "stanza_id": 56,
      "text": "førde hand | hiem sinn festemøe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 279,
      "stanza_id": 56,
      "text": "thett war hende icke emod:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 280,
      "stanza_id": 56,
      "text": ":: s | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 281,
      "stanza_id": 57,
      "text": "Thack haffue wngenn herre Kaarll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 282,
      "stanza_id": 57,
      "text": "hand lod sinn | brøllupe giøre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 283,
      "stanza_id": 57,
      "text": "sidenn leffued hand met sinn festemøe |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 284,
      "stanza_id": 57,
      "text": "Baade mett glede oc Rooe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 285,
      "stanza_id": 57,
      "text": ":: S: I: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 286,
      "stanza_id": 58,
      "text": "Thacke haffue wngenn her Thordt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 287,
      "stanza_id": 58,
      "text": "hand war | sin Broder saa huldh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 288,
      "stanza_id": 58,
      "text": "Oc lidenn kierstinn holth | saa well sinn throe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 289,
      "stanza_id": 58,
      "text": "sinn Iomfrue forglemer | suenndenn aldrig. |",
      "part": false,
      "marginal_notes": []
    }
  ]
}