{
  "id": null,
  "title": "Rime-Djävelen",
  "year_created": 1830,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Digte",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1830,
    "url": "https://tekstnet.dk/books/andersen-hc_digte-1830/003/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "»Μὴ ἐισϵνϵγκηϛ ἡμᾶϛ ἐιϛ πϵιρασμον«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 1,
      "text": "Før jeg med Blæk Papiret vil bemale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "En lille Tale:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Troer, Læser, Du paa Aander, eller ei?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "– »Nei!!!« –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Det klang lidt negativt, dog lad saa være,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Hør videre, og svar mig saa, min Kjære!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "– Naar Du har Ærter spiist, saa mange som Du vil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Tør Du da nægte, der er Ærter til?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Naar i Din egen Krop en Aand logerer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Den existerer?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Hver Adams Søn en saadan føle vil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Og altsaa, seer man, der er Aander til;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Er mit Beviis Dig ikke klart, min Kjære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Læs Swedenborg – dog lad det heller være! –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "– De fleste Aander, som paa Jord har hjemme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Er’ slemme;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Blandt Andet opfandt deres Præ-Genie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Tallotterie;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Snørliv for Damer og for Officerer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Som fælt generer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "En saadan Djævel eller lille Nisse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "Tilvisse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "Var Slangen som, paa Fransk, i Paradiis",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 1,
      "text": "Til Eva sagde: »spiis Madame, spiis!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 1,
      "text": "– Dog, lad mig ei for vidt fra Texten springe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 1,
      "text": "Men paa Papiret mine Qvaler bringe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 1,
      "text": "Med Pennen af den dræbte Gaases Vinge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 1,
      "text": "– Orest, forfulgt af Helvedes Chariter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 1,
      "text": "Og Aphroditer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 1,
      "text": "Selv Don Juan i Flammer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 1,
      "text": "Er Børne-Leeg mod min ukjendte Jammer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 1,
      "text": "Thi viid, saalangt min Tanke naaer tilbage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 1,
      "text": "Ak! alle Dage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 1,
      "text": "Seer jeg en lille Djævel mig ledsage;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 1,
      "text": "Han lever i mig, om mig, allevegne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 1,
      "text": "Dog kan jeg ei hans Skikkelse betegne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 1,
      "text": "Skjøndt vaagen og i Drømme, hver en Time",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 1,
      "text": "Han gjør at jeg maa – rime. –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 1,
      "text": "Ved Dødsfald tidt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 1,
      "text": "Jeg seer han ogsaa plager Andre lidt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 1,
      "text": "Hvorfor om Aaret",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 1,
      "text": "Han har sit Visse paa Aviscontoiret,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 1,
      "text": "Men skjøndt af mig han aldrig noget fik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 1,
      "text": "Holdt han dog Stik.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 1,
      "text": "– I Skolen selv ved Typto og Amare ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 1,
      "text": "Jeg følte ham i mine Lemmer fare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 1,
      "text": "Selv ved Examen – disse Farens Dage –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 1,
      "text": "Han turde plage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 1,
      "text": "Skjøndt midt om Natten Badens Grammatik",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 1,
      "text": "Mig skræmmed’ med sit Robespjerre-Blik.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 1,
      "text": "Liig hiin – – (ja Navnet har jeg glemt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 1,
      "text": "Og det er slemt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 1,
      "text": "Men i Horatses Breve kan det findes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 1,
      "text": "Saa vidt jeg mindes),",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 1,
      "text": "Der hvad han rørte, Klæder, Vand og Muld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 1,
      "text": "Forvandlede til Guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 1,
      "text": "Saa gaaer det mig: hvorhen jeg end mig vender,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 1,
      "text": "Med Vers det ender;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 1,
      "text": "Derfor man skjænder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 1,
      "text": "Og raaber til mig vredt, i hver en Time:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 1,
      "text": "»Lad vær’ at rime!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 1,
      "text": "Ja, Herre Gud! just det jeg vilde gjerne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 1,
      "text": "Men jeg er født ved en usalig Stjerne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 1,
      "text": "Bedrøvet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 1,
      "text": "Naar dit og dat er røvet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 1,
      "text": "Jeg skrive maa en Elegie med Jamber,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 1,
      "text": "Og er jeg glad – det bliver Dithyramber.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 1,
      "text": "O, hvis jeg dog min Djævel undflye kunde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 1,
      "text": "Men selv ei Døden vil han mig forunde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 1,
      "text": "Nys vilde jeg i Peblingsøen blunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 1,
      "text": "Smukt paa Papiret stod min Svane-Sang;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 1,
      "text": "Og alt jeg satte Fødderne i Gang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 1,
      "text": "Men som jeg nu, i Afstand, øiner Vandet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 1,
      "text": "Min Djævel sender mig en Ven fra Landet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 1,
      "text": "Der blev nu talt om – Ingenting, med Mere;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 1,
      "text": "Jeg vil ei repetere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 1,
      "text": "Den lange Snak, da der var Intet i,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 1,
      "text": "Tilsidst kom Talen hen paa Poesie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 1,
      "text": "Da følte jeg en dyb veemodig Længsel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 1,
      "text": "At tage frem min Sang af Lommens Fængsel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 1,
      "text": "Og læse ham min Afskeds-Elegie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 1,
      "text": "Mens Folk paa Veien gik os taus forbi;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 1,
      "text": "Thi ærligt talt – for ei at sige Mere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 1,
      "text": "Jeg har den Feil med flere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 1,
      "text": "Og sikkerligt, den fra min Djævel kommer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 1,
      "text": "Har jeg et Vers i een af mine Lommer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 1,
      "text": "Da vee hver Ven, der kommer mig for Øie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 1,
      "text": "Han maa det døie! –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 1,
      "text": "Saa gik det her – ja, knap var Verset endt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 1,
      "text": "Før Tankerne var’ bort fra Peblingsøen vendt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 1,
      "text": "Jeg følte det saa sødt i denne Time,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 1,
      "text": "At kunne rime.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 1,
      "text": "Men nu forleden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 1,
      "text": "Kom jeg igjen i Heden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 1,
      "text": "Da stod mig Runde-Taarn som Trøstens Kjæmpe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 1,
      "text": "Der kunde mig min Rime-Djævel dæmpe;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 1,
      "text": "Jeg foer forbi smaae Huse og Pauluner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 1,
      "text": "Saae ei til Livets brogede Kattuner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 1,
      "text": "Uldstrømper, Sokker, Shawler, røde Baand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 1,
      "text": "Der hang paa høire, som paa venstre Haand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 1,
      "text": "Ei ReitzelsBogskab paa den brune Muur,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 1,
      "text": "Thi Gaden var mig som et Fangebuur;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 1,
      "text": "Nu følte jeg mig kold, nu atter varm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 1,
      "text": "Som jeg steeg op i Taarnets Snirkel-Tarm;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 1,
      "text": "Men da jeg nu var kommen i det Høie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 1,
      "text": "Med Graad i Øie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 1,
      "text": "Hvo dadler da, om før det store Spring,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 1,
      "text": "Jeg følte Lyst, at see mig lidt omkring?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 1,
      "text": "– De brune Tage smiilte mig imøde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 1,
      "text": "I Aftenrøde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 1,
      "text": "Og hist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 1,
      "text": "En Skræder sad og sang paa Husets Qvist,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 1,
      "text": "Og mens han syede paa Næstens Trøie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 1,
      "text": "Steeg Sang og Skorsteens Røg imod det Høie;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 1,
      "text": "Paa Søen Skibe fløi i hvide Frakker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 1,
      "text": "Og hist jeg skued’ Sveas gule Bakker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 1,
      "text": "Paa Ære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 1,
      "text": "Jeg maatte være",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 1,
      "text": "Lidt mindre følsom end en Kampesteen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 1,
      "text": "Hvis ikke Følelserne, hver og een,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 1,
      "text": "Var blevet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 1,
      "text": "Rørt ved hvad nys jeg daarligt har beskrevet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 1,
      "text": "Jeg stirrede, jeg skrev, jeg stirred’ om igjen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 1,
      "text": "Paa Tage, Skræder og paa Himmelen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 1,
      "text": "Vognlarmen bruste gjennem Byens Gader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 1,
      "text": "Med lange catalaniskeRoulader;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 1,
      "text": "Snart paa Papiret jeg en Ode saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 1,
      "text": "Hvoraf endnu jeg intet kan forstaae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 1,
      "text": "Jeg skrev og skrev – jeg hørte Sphærer klinge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 1,
      "text": "Men glemte reent at springe. –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 1,
      "text": "Saa gik det da, saa vil det altid gaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 1,
      "text": "En Rime-Djævel sagtens seire maa;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 1,
      "text": "Ja, voxte der paa Marken Hat og Frakke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 1,
      "text": "Var Morgenrøden noget Spiseligt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 1,
      "text": "Jeg lod den hele, vide Verden snakke;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 1,
      "text": "Men sligt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 1,
      "text": "Et Eldorado ei man finder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 1,
      "text": "Dog, muligt alt, man paa mit Liiglagen spinder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 1,
      "text": "Det sidste Bret til Kisten færdigt staaer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 1,
      "text": "Gid da, naar Laaget over mig man slaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 1,
      "text": "Det blive maa med denne Indskrift siret:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 1,
      "text": "»Han intet Ondt bedrev, kun klakkede Papiret.«",
      "part": false,
      "marginal_notes": []
    }
  ]
}
