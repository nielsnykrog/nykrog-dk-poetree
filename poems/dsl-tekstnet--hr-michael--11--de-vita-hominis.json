  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Candida vertuntur immixtaque, perdo laborem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Fulgida sternuntur, carnis sic muto decorem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Mynæ kindhær som førræ waræ hwidhæ och rødhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "the blegnæ nw ieg schal gaa til dødhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Ieg kwnnæ thet ickæ førræ sckiødhæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "at dødhen wildhæ mig swo saaræ hødhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "och ieg schullæ faa slig ændhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Hwo schal mig hielpæ nar ieg er død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "myn fadher eller myn modher?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "The swøbæ mig vti en sckidhen blee",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "at sckiffthæ myt gotz som hwer maa see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "myn søsther och myn brodher.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "mædhen ieg haffuer wæreth i lijffuæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Thijd som ieg kommer, er ieg vkænt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "och ieg schal ewigh bliffuæ.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
