  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Syndre! hvad er klokken slagen?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Tænker du ey snart herfra?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Det alt sildig er paa dagen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "See dig for paa Golgatha",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Og udi Gethsemane,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Begge stæder kand du see:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Om din korte tiid sig rimer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Med Guds pines lange timer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "JEsus maalede med sukke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Vor forløsnings dag og nat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Vilde intet øye lukke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Før hand fik vor frelse fat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "JEsu pines tynge stærk",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Driver naadens seyer-verk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Men ey øyeblik vil give",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Dig i vellyst at fordrive.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Fra skiertorsdags aften-svale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Til langfredags soel gik ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Saae man livsens soel at dale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Da hand for al verden leed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Denne døgn skal al din tiid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Rettes efter ind med fliid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Tænk, naar satan dig vil lokke:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Hvad er nu Guds pines klokke?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Sex var hand ved paaske-retter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Som det rette paaske-lam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Syv sit sacrament indsetter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "At vi skulde nyde ham,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Otte venlig afskeed tog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Ni til urtegaarden drog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Ti forraades, fanges, føres,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Elleve hand stærkt forhøres.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Tolv de falske vidner møde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "(Spøgelser om midnats-tiid),",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "Et blev hand fordømt til døde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "Tog mod dommen mild og bliid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "To er hver mands næve knyt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "Tre man saae ham fuld af spyt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "Fire narres, spottes, drilles,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "Fem igien for retten stilles.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "Mørket viger, natten endes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "Pinen var dog ey forbi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 5,
      "text": "Dødsens bue skulde spendes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 5,
      "text": "Før blev verden ikke fri,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 5,
      "text": "Det var den bestemte dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "Da al verdens frelses sag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "Skulde nu til ende føres,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "Inden aften reent afgiøres.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "Klokken sex vor JEsus gives",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 6,
      "text": "Over i Pilati magt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 6,
      "text": "Syv til kong Herodes drives,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 6,
      "text": "Hvor hand leed saa stor foragt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 6,
      "text": "Otte pidskes JEsu krop,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "Ni paa korset henges op,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "Ti for sine fiender beder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "Elleve sin moder glæder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 7,
      "text": "Tolv blev begge sole mørke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 7,
      "text": "Den formørkelse var stor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 7,
      "text": "Et endnu i vredens tørke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 7,
      "text": "Og den grumme pines mord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 7,
      "text": "To endnu i dødsens bad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 7,
      "text": "Tre hand skreeg og græd og bad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 7,
      "text": "Fire JEsu side rinder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "Fem sin roe i graven finder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 8,
      "text": "Tiden kun saa kort betegnes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 8,
      "text": "Og saa vit man slutte kand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 8,
      "text": "Efter hvilket kand beregnes",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 8,
      "text": "Resten af hans pines stand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 8,
      "text": "Men, min siel, din regning fik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 8,
      "text": "Om du kun et øyeblik",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 8,
      "text": "Af hans marter skulde kiende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 8,
      "text": "Aldrig fik din regning ende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 9,
      "text": "Hand ey eene lod sig spotte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 9,
      "text": "Henge, slide, pidske, flaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 9,
      "text": "Men Guds grumme vrede maatte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 9,
      "text": "Ham i Guddoms iver slaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 9,
      "text": "Ach! da Guds retfærdighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 9,
      "text": "Hele timer slog og sleed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 9,
      "text": "Paa det milde JEsu hierte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 9,
      "text": "Ach! hvad leed hand da for smerte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 10,
      "text": "O I dyre-bare timer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 10,
      "text": "Da man her paa jorden saae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 10,
      "text": "Naade-solens røde strimer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 10,
      "text": "Dødsens taage bort at slaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 10,
      "text": "Eders milde straalers skin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 10,
      "text": "Giør det lyyst for mine trin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 10,
      "text": "Naar I op i sielen rinder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 10,
      "text": "Al min nat og trang forsvinder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 11,
      "text": "Da min JEsus leed og døde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 11,
      "text": "Vredens nat og mørke sank,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 11,
      "text": "Naadens blide morgen-røde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 11,
      "text": "Lyser over sielen blank,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 11,
      "text": "Tidens skændsel JEsus bar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 11,
      "text": "Deraf blev min tiid saa klar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 11,
      "text": "At jeg uforsagt tør vove",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 11,
      "text": "Midt i dødsens nat at sove.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
