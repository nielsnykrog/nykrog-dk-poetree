{
  "id": null,
  "title": "262. Syndre! hvad er klokken slagen?",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
