{
  "id": null,
  "title": "Af Leilighedsdigte",
  "year_created": 1876,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Af Samlede Skrifter. Tre Og Tredivte Bind",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1876,
    "url": "https://tekstnet.dk/books/andersen-hc_af-samlede-skrifter-tre-og-tredivte-bind/030/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Frøet Liv Alherren giver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Spiren sprænger sine Baand;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Naar den da med Mildhed bliver",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Pleiet af en sikker Haand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Staaer den kraftfuld, reen og skjøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Skjænker ham sin rige Løn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Byrdefuldt, men ogsaa herligt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Kaldet monne vise sig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Men vi stræbe skal saa kjærligt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "At forsøde det for Dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Dan os da til Kraft, til Dyd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Og din Løn er salig Fryd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Lige tændtes ikke Flammen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Men ved Lærelyst og Flid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Vil vi stræbe tro tilsammen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "At benytte Ungdoms Tid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Styrke Himlen Dig og dem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Som til Held os leder frem!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Saa sidde vi igjen om Julebordet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Og synge høit vor Sang, vort Juledigt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "Og Glæden er i Hjertet og i Ordet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Skjøndt Aaret var saa taust, saa alvorsrigt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "Der rulled Kroner hen som Kiselstene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Men i vor lille Kreds vor Krone blev:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Vort Sammenhold og han, han, som alene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Sit Kongerige i vort Hjerte skrev.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 4,
      "text": "Mod Roskild Spir fløi Svanen frem og døde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 4,
      "text": "Ved Slesvig Kampens Paaskeklokker klang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Og Tre af Kredsen her gik til det Møde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "Hvor Døden stod, og hvor Kanoner sang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "Mod Savn og kolde Nætter, Oprørsflammen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "De gik, og selv vi bad: »I Guds Navn gaa!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Og see, vi sidde atter samled’ sammen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "Det er, som om en Drøm det var, vi saae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 5,
      "text": "Hver Sorg og Angst i Hjertet vi erindre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Og føle derpaa ret: Gud var os god!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "Vor Julestjerne see vi dobbelt tindre;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "Dens Straaler skal os give Fremtids Mod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "End mange Aar vort Huuslivs stille Scene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "Staae lykkelig, som selv iaar den blev,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "Vort Sammenhold og han, han, som alene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "Sit store Rige i vort Hjerte skrev.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "Og nu en Sang for Oldemoer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "Den Milde, Kloge, Kjære!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "Vi Alle synge vil i Chor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 6,
      "text": "Saaledes skal det være!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 6,
      "text": "Gid Rigmor kunde synge med",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 6,
      "text": "Som Børnene hos Thieles,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "Saa sang hun – mens i Kjærlighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 6,
      "text": "Her gjennem Taarer smiles.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 7,
      "text": "Derudenfor er Luften klar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 7,
      "text": "Men kold med Nordens Vinde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 7,
      "text": "I Børn og Børnebørn Du har",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 7,
      "text": "Din Blomsterflor herinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 7,
      "text": "Og Kinden blusser, Øiet leer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 7,
      "text": "Dig vil de Alle glæde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 7,
      "text": "Og naar Du ind i Hjertet seer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 7,
      "text": "Seer Du dit Herskersæde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 8,
      "text": "Engang – ja, naar vi skilles ad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 8,
      "text": "Det skeer kun for at mødes;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 8,
      "text": "Paa Mødet tænker Hjertet glad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 8,
      "text": "Og sød Fortrøstning fødes.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 8,
      "text": "Kort er et Jordlivs Fødselsdag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 8,
      "text": "Men langt og deiligt Aaret;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 8,
      "text": "Paa Kjærlighedens Vingeslag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 8,
      "text": "Du bliver hos os baaret.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 9,
      "text": "Dit Øie hviler paa os nu",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 9,
      "text": "Med stille, store Tanker!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 9,
      "text": "Ja, Oldemoer, saa smuk er Du,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 9,
      "text": "Saa ungt dit Hjerte banker!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 9,
      "text": "En evig Ungdom Sjælen fik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 9,
      "text": "Fra Øiet lyser Straalen!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 9,
      "text": "– Og nu: Hurra paa gammel Skik!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 9,
      "text": "For Oldemoer er Skaalen!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 10,
      "text": "De faae ingen Vise, De faae ingen Sang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 10,
      "text": "Men dog skal Sangværket sættes i Gang:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 10,
      "text": "En Tale paa Vers, men ei udenad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 10,
      "text": "Jeg læser den op fra det skrevne Blad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 10,
      "text": "Gaa med hen om Hjørnet og ligefrem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 10,
      "text": "Saa er vi strax ved det nye Hjem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 10,
      "text": "Det ligger der paa den venstre Haand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 10,
      "text": "Og det er et Huus for Kjød og for Aand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 10,
      "text": "Og Kjødet er godt, har Slagteren sagt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 11,
      "text": "Men ovenover har Aanden Magt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 11,
      "text": "Derfra skal bruse Tonernes Hær",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 11,
      "text": "I Verden vide, hørt fjernt og nær",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 11,
      "text": "Som Bølger, der orgle i Stormens Suus;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 11,
      "text": "Det bliver deromme et mærkeligt Huus!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 11,
      "text": "Hver Fremmed, som kommer til Kjøbenhavn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 11,
      "text": "Seer paa det og nævner da Gades Navn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 11,
      "text": "Derinde han boer med sit Jordlivs Skat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 11,
      "text": "Hun Hjerteslag har i Tonerne sat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 11,
      "text": "Det nye Hjem, der som Rosenknop",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 11,
      "text": "Endnu ikke har lukket sig op,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 11,
      "text": "Guds Solskin der i det fuldeste Maal!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 11,
      "text": "Det nye Hjem bringes denne Skaal!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 12,
      "text": "Om ogsaa ude Stormens Slag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 12,
      "text": "Med Hagl paa Ruden trommer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 12,
      "text": "November bringer os en Dag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 12,
      "text": "Med Solskin og med Sommer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 12,
      "text": "En deilig Dag, vi kalde vor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 12,
      "text": "Trods Aarets skarpe Vinde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 12,
      "text": "Om Sneen fyger udenfor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 12,
      "text": "Vi har dog Solskin inde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 13,
      "text": "En Moders Vei er Angstens Vei,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 13,
      "text": "Hvert Barn blev kjøbt med Smerte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 13,
      "text": "Hvor mangen søvnløs Nat laae ei",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 13,
      "text": "En Klippe paa dit Hjerte!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 13,
      "text": "Den spæde Knop blev Blomst og Frugt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 13,
      "text": "Ved dine Kjærtegn ømme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 13,
      "text": "Og Aar for Aar sig viste smukt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 13,
      "text": "Som Vished Haabets Drømme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 14,
      "text": "For dine Børn saa mangen Gang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 14,
      "text": "Du sang – de det ei glemme!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 14,
      "text": "Nu synge de for Dig en Sang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 14,
      "text": "Med sødt bevæget Stemme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 14,
      "text": "Bliv længe hos os, karsk og glad!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 14,
      "text": "Dig Børnbørn omringe!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 14,
      "text": "I mange Aar et Festens Qvad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 14,
      "text": "De Bedstemoder bringe!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 15,
      "text": "Tillad, at jeg tager Ordet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 15,
      "text": "Ja, læser det op denne Gang;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 15,
      "text": "Her sidder en Digter ved Bordet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 15,
      "text": "Der ikke har bragt en Sang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 15,
      "text": "Uagtet hans Hjerte banker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 15,
      "text": "I Glæde, deeltagende, rigt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 15,
      "text": "Der er i de svulmende Tanker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 15,
      "text": "Nok Stof til et Brudedigt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 15,
      "text": "Men Harpen er stemt kun for Kampen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 15,
      "text": "For Danmarks ærlige Sag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 15,
      "text": "I To greb Aladdins-Lampen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 15,
      "text": "Det er Eders Bryllupsdag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 15,
      "text": "Paa den Kanonerne runge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 15,
      "text": "Husk det i Tiden engang!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 15,
      "text": "Nu Landsoldaterne sjunge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 15,
      "text": "De døve min Bryllupssang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 15,
      "text": "Der er en Storhed i Tiden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 15,
      "text": "I den er Velsignelse med,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 15,
      "text": "Det sande I nu og siden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 15,
      "text": "Velsignet i Kjærlighed!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
