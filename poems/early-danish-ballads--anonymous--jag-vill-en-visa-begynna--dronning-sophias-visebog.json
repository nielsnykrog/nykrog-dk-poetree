{
  "id": null,
  "title": "Jag vill en visa begynna",
  "year_created": [
    1630,
    1639
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Dronning Sophias visebog",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1639,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/DRSIX.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Iagh will En wisa begÿna,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "om min lÿcka oblidh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "som sigh monde forgrÿma,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Emot migh j all tidh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "att migh bedröffuelse händer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Ehuar iagh stader är,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "och huart vth iagh migh wänder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "bedröffwatt hierrta iagh bär",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Kiär kåmne jfrån migh falla,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "effter tin willia o gudh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "du dem och till tig kallar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "igenom tin wisa budh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "och demm så till tigh tager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "jfrån dene onde wärdh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "som mången man bedrager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "medh sin arghett och flärdh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Iagh haffuer Eÿ begiärt Rikedom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Eÿ häller någon wärdzens pracht,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "vthan min slächt och wäner from,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "dom haffuer iagh Elskatt medh macht,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "och deres vmgenge åstundat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "och beditt min gudh medh flit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "att han migh dom will vnda,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "aff sine nåder blidh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "platt anars iagh månde förnima,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "gudh vet bäst huadh nÿtigt är,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "iagh thett och kan besinna",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "gudh näffser dom han haffuer kiär,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "dåk somlige bårt Rÿker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "att de skulle glädie få,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "de Andra medh bedröffuelse trÿcker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "dåck will han medh dem stå",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "så lennge wÿ her wistas,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "j denne jämerdall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "altidh glädien förminskas,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "och dageligh ökas quall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "att hiertatt måtte wäll brista,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "wor icke gudh wår tröst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "som alltidh när oss wistas",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "och hörer wår Elenda Röst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "Då iagh war vthan quida,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "vthÿ min vngdoms år,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "och effter min lÿcka förbida,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "tÿckte migh intett wara för suårt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "när andre sörde och gräte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 4,
      "text": "öffuer sina framfarnes dödh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 4,
      "text": "tÿckte migh dett wara aff kiätte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 4,
      "text": "och Räknat för ingen nödh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 4,
      "text": "En trogen wän att mista,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 4,
      "text": "giör hiertatt bedröffwatt försan,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 4,
      "text": "den wett som dett haffuer frestatt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 4,
      "text": "antinge quina äller man,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 4,
      "text": "o gudh iagh beder aff hiertatt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 4,
      "text": "för Christÿ blodh så rödh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 4,
      "text": "tagh jfrån migh min smerte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 4,
      "text": "och hielp migh aff all nödh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 4,
      "text": "vthÿ tit Euige Rike,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 4,
      "text": "där är förwaratt min frögdh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 4,
      "text": "den du will migh till lika,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 4,
      "text": "giffua j himels högdh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 4,
      "text": "jblandh dina Englar klare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 4,
      "text": "der finer iagh mina jgän,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 4,
      "text": "de frögdes der vthan fare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 4,
      "text": "men iagh leffuer j werden än",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 4,
      "text": "Barmhertige gudh iagh beder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 4,
      "text": "aff hugh och all min acht,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 4,
      "text": "att tu migh medh din handh leder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 4,
      "text": "att iagh Eÿ bliffuer förtapt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 4,
      "text": "vthan att den dagh måtte snart kåma,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 4,
      "text": "den glädien måtte migh ske,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 4,
      "text": "att migh weder fares den frome,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 4,
      "text": "mina wäner j gudz rike see",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 4,
      "text": "så will iagh här med beslutta,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 4,
      "text": "och tro tin ordh full wäll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 4,
      "text": "att tu migh Eÿ will förskiuta,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 4,
      "text": "vthan anamar min siall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 4,
      "text": "när iagh och henne till tigh taga,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 4,
      "text": "och gläden giffua med hast,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 4,
      "text": "tÿ iagh j mina dagar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 4,
      "text": "der effter längtar fast",
      "part": false,
      "marginal_notes": []
    }
  ]
}