  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "WAag op vaag op i Gudz naffn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "du verdige Christenhed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "oc tacke din kæriste Brudgom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "for denne naadelig tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "i huilcken han dig sit ord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "haffuer nu vdsent igen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Der met han vil oss frelse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "saa mange som det ræt elske/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Det klinger i alle Land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "⁕ Men Dieffuelen verdens første/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "som løgnens Fader er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "han vilde det gerne omstyrte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "met suig han forbiuder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "ath ingen skulde Gudz ord sige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "vid band oc Gotz oc Liiff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Han lader mange fordriffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "forbrende oc affliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "der hielper hannem dog inted",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "⁕ Huad skær fast met sine Tender/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Satan oc hans parti/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "met tru vil han forfærde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "dig verdige Christenhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Dog bliff du fast vid Gudz Ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Thi han sørger for dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "han siger huo dig nogen wret gør/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Hans øyen Sten han der met rører/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Han er din hielp visselige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "⁕ See huorledis Gud hialp Jøderne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "aff Egypti Land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "och røde Haff forsencte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "den Kong Pharao/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Hierico det maatte och falle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "for Gudz Folck strax paa stan/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "aff de Trommeters skalle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "alt saa hielper Gud dem alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "som sette deris Tro til hannem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "⁕ Oc de Madianiter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "giorde Gudz Folck platz oc møde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "Oc de Amalechiter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "Gudz Folck robte da til Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "Han dem naadelige reddede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "formedelst Gedeon/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "Den tid Gudz Folck Trommetede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "en Hedning den anden myrde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "Tiue hundrede Tusinde Mend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "⁕ Tenck huor tid Gud beskermede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "fra Sauls haand Kong Dauid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "den han haffde myrd saa gerne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 5,
      "text": "Gud beuarede hannem oc met flit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 5,
      "text": "For hans egen Søn den skøne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 5,
      "text": "som kallis Absolon/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 5,
      "text": "han vilde hans Liff bort nemme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 5,
      "text": "Dauid motte da rigit rømme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 5,
      "text": "Men dog der ind igen kom",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "⁕ Merck huorledis Gud halp at stride",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "alt mod Hieroboam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 6,
      "text": "J Kong Abia tide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 6,
      "text": "dem han omkring sæt haffde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 6,
      "text": "at han kunde icke vndkomme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 6,
      "text": "da robte Folckit til Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 6,
      "text": "saa flyde de fiende met skamme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 6,
      "text": "oc Gudz folck slo aff dem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 6,
      "text": "Femhundrit tusind døde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "⁕ Desligest halp Gud at kampe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 7,
      "text": "Assa den Kong Bold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 7,
      "text": "Da Serach vilde forderffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 7,
      "text": "Gudz Folck met mact och vold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 7,
      "text": "De monne da Gud paakalle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 7,
      "text": "aff gantske hiertens grund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 7,
      "text": "thi maatte de blaa mend falde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 7,
      "text": "Tusinde gange tusind talde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 7,
      "text": "For Gudz Folck samme stund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 8,
      "text": "⁕ See huorledis Gud reddede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 8,
      "text": "den Kong Ezechiam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 8,
      "text": "den storlige trued haffde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 8,
      "text": "Senacherib ved naffn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 8,
      "text": "Din sin her haffde stilled",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 8,
      "text": "alt mod Hierusalem/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 8,
      "text": "aff dem Gudz Engel felde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 8,
      "text": "Firesindz tiue Tusind oc flere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 8,
      "text": "Oc saa giorde han dem tamme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 9,
      "text": "⁕ Hør oc huor Gud lod krige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 9,
      "text": "for Kong Josaphat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 9,
      "text": "Den tid han vilde fordriffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 9,
      "text": "Amon oc Moab met mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 9,
      "text": "Gudz folck haffde sorg oc klage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 9,
      "text": "til Gud haffde det sin trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 9,
      "text": "De Hedninge lod Gud plaue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 9,
      "text": "de tog hin anden aff dage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 9,
      "text": "och Gudz Folck bleff forløst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 10,
      "text": "⁕ O Christenhed merck lige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 10,
      "text": "huor Gud sine fiende slar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 10,
      "text": "de mod hans Folck monne stride/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 10,
      "text": "hans mact er nu lige stor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 10,
      "text": "Han kan dig vel beskerme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 10,
      "text": "dine Haar ere alle talde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 10,
      "text": "Lad du men Dieffuelen suerme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 10,
      "text": "bliff du ved Gudz Ord gerne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 10,
      "text": "Altid saa est du vduald",
      "part": false,
      "marginal_notes": []
    }
  ]
}