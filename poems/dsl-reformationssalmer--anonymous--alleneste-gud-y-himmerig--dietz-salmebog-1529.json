  "source": {
    "id": null,
    "title": "Een ny handbog med Psalmer oc aandelige lofsange",
    "year_published": 1529,
    "publisher": "Ludwig Dietz",
    "printer": "Ludwig Dietz",
    "place": "Rostock",
    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/dietz-salmebog-1529/8/9"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "ALleneste Gud ÿ himmerig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "wære loff oc prÿss for all sÿn naade/",
      "part": false,
      "marginal_notes": [
        "j. Timot. j. Luce. ij."
      ]
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "ther han haffuer giord ÿ iorderig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "ÿ tesse samme naadelige dage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Paa iorden er kommen stor glæde oc fred/ menniskerne maa wæl glædis wid/",
      "part": false,
      "marginal_notes": [
        "Luce. ij."
      ]
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Guds ynnist oc gode wilie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Wÿ loffue wÿ prÿse wÿ neye teg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "wÿ tacke teg for thÿn erlighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "O herre Gud fader ÿ himmerig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "tw haffuer oss stor kierlighed.",
      "part": false,
      "marginal_notes": [
        "Roma. v. ij. Pa. xx."
      ]
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Alting haffuer tw ÿ thÿn macht oc wold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "hwad tw wilt haffue fram/ kan ingen forholde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "wel them ther teg kunde frøcte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "O Jesu Christ Guds eneste søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "som hooss Gud fader sidder /",
      "part": false,
      "marginal_notes": [
        "Johan. iij. j. Petri. iij."
      ]
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "tw som haffuer frelst all menniskens køn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "oc oss med Gud forliger/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "formiddels thit blod oc horde død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "haffuer tw løøst oss aff synd oc nød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "giff naade ÿ thÿn tro bliffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "Tw æst allene wor frelsermand/",
      "part": false,
      "marginal_notes": [
        "Esaie. xliij. Johan: j. Esaie. lv. Johan. j."
      ]
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "ther oss wil himmerig giffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "tw æst Guds faders vskyldig lam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "ther for oss døden wilde lide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Tw æst allene wor salighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "for thÿn skyld haffue alle naade fangit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "almechtigste Jesu Christe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 4,
      "text": "O Helliaand wor trøstermand/",
      "part": false,
      "marginal_notes": [
        "Johan. xiiij. xv. xvj. j. Petri. v."
      ]
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "som oss all sandhed kan lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "hielp oss att bliffue wid thÿn lærdom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "Gud fader oc søn oc teg ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "beskerm oss fraa dieffuelsens falske list/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "hielp oss att tro paa Jesum Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "nw oc ewindelig AMEN.",
      "part": false,
      "marginal_notes": []
    }
  ]
}