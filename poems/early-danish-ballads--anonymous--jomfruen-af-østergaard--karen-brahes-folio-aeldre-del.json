{
  "id": null,
  "title": "Jomfruen af Østergaard",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA185.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Lauy hannd taaller tell lyddenn Laui:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "\"Och wy weell oss till wage gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Och wy well gaa till Østergaard.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Saa weell daa gangis angist meg aff. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Tieell Øster-gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "der er møød och wynn vspaartt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Och der er ienn saa høffskenn quinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Saa høffskenn quinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "thett mieste, ieg sørger, thett er for hynnd.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Dy gick y gaarddenn, thi raadis weed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "Thi raadis weed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "y-huelckenn burre dy brydde skulde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "\"Saa mangtt ett bwr daa haffuer ieg brøtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "Daa haffuer ieg brøtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "och halleff flerre dørre aff henngseell løfft.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "Thi løfftte den dør aff hengseell niedder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "Aff henggseell nieedder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "thend iumfru hun wonitt och daanitt der-weed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "Hun kaam til sindde, och op hun suo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 6,
      "text": "Och op hun suo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "\"Huenn brydder mitt bure, huem gior nu saa?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 6,
      "text": "\"Och thett er eders brøder VII.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 7,
      "text": "Brødder syuff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "thi kaam i affttis saa sildig till by.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 7,
      "text": "\"Mynn brødder thi haffuer ind anditt till id.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 8,
      "text": "Anditt till idd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 8,
      "text": "ind brydde mitt bwr om natter-tidd.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 8,
      "text": "Laui hand thaaller till lidenn smaa-dreng.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 9,
      "text": "Till lidenn smaa-dreng:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 9,
      "text": "\"Thu hientt meg ind ett hornn med wynn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 9,
      "text": "Thu thape meg aff denn thønndde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 10,
      "text": "Denn thøønde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 10,
      "text": "ieg førrde iguor fraa syndenn!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 10,
      "text": "Hand luod y huornett, baar dett saa høgtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 11,
      "text": "Baar thett saa høgtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 11,
      "text": "thett war for inddenn med dualler støtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 11,
      "text": "Hun luod til munden, och aff hun drack.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 12,
      "text": "Och aff hun drack:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 12,
      "text": "saa sød en søffuen hun eftter feck.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 12,
      "text": "Dy sluo offuer hynder kaabe blaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 13,
      "text": "Kaabbenn bllaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 13,
      "text": "dy løfftte hyndder paa Lauy hans ganger graa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 13,
      "text": "Dy red saa lestelig offuer denn bro.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 14,
      "text": "Offuer denn broo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 14,
      "text": "thi hørde icke heeste eller heeste-skuo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 14,
      "text": "Dy red saa lestelig igiemell dem by.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 15,
      "text": "Igiemell denn by,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 15,
      "text": "dy hørdde icke hunde eller heeste gny.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 15,
      "text": "Och der dy kaam y grønenn eng.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 16,
      "text": "I grønenn enng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 16,
      "text": "ther baad Laui redde en seeng.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 16,
      "text": "Dy haffde icke anditt till brude-senng.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 17,
      "text": "Till brude-seng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 17,
      "text": "ind skaarlagen rød och løff-grønn eng.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 17,
      "text": "Op wognett denn iumfru, och op hun suo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 18,
      "text": "Och op hun suo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 18,
      "text": "\"Huem førdde meg aff myn faaders gaard?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 18,
      "text": "\"Du sier rett aldrig dynn faadders land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 19,
      "text": "Dynn faadders land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 19,
      "text": "altt førrind dynn sønn kand thage Aaarer y haannd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 19,
      "text": "Tthu sier rett aldrig dynn muodders bydd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 20,
      "text": "Dynn muodders by,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 20,
      "text": "allt førrind dyn datter kand skierre och sy.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 20,
      "text": ":: Och saa weell daa forgangis myn angist. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}