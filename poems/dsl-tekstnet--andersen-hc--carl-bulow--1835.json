  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1835,
    "url": "https://tekstnet.dk/books/andersen-hc_carl-buelow/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Du længtes efter Vaar og efter Sommer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Du sukked’ dybt, – og Vaaren for Dig stod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Saa skjøn, som aldrig den til Jorden kommer –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Din Bøn blev hørt, derfor Du os forlod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "En sjunken Stad, som Tidens Strømme ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Dig ligger Jorden nu; Du bort Dig svang!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Og Toner stige, svæve over Bølge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "De klinge som Levvel og Afskedssang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Ja, kun i Veemods skjønne Melodier",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Naae til Dig Venners Suk og Taarestrøm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Alt Guddomskysset Dig til Himlen vier,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Dit Liv paa Jorden var en Ungdoms Drøm.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
