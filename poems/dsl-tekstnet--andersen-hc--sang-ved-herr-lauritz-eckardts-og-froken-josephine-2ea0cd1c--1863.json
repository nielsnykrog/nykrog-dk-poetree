{
  "id": null,
  "title": "Sang ved Herr Lauritz Eckardt’s og Fröken Josephine Thorberg’s Bryllup den 17de Juni 1863",
  "year_created": 1863,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1863,
    "url": "https://tekstnet.dk/books/andersen-hc_sang-ved-herr-lauritz-eckardts-og-froeken-josephine-thorbergs-bryllup-den-17de-juni-1863/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Hvor boer paa Sundets Hjørne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Der gik en lille Dreng med Tankeblik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "I Stuen og bag Kystens hvide Tjørne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Historier og Eventyr han fik.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Han kjendte Tycho Brahe, saae jo Øen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Med Stjerneborgen, hans Urania;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "For Drengens Tanke, svømmende paa Søen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Alt det Fortalte løftede sig da.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Han blev Student, men Sangfugl af Naturen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Svang han sig ind i Kunstens Helligdom;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Fata morgana lyste da fra Muren,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Med Havfru-Blik Urania der kom",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "I »Tycho Brahes Ungdom«; Scenen bragte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Lyslevende hans Barndoms Drømme-Syn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Han saae sin Brud, hans Genius det sagde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Og Altrets Ild blev tændt ved Øiets Lyn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "God Søn Du var, og det vil hun Dig lønne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Hun som er heel din første Kjærlighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Hun Scenens Datter, Qvinden, hun den Skjønne!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "En Rigdom er i Kjærlighed lagt ned.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "I dele Livets Prøvelse og Lykke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "I Kjærlighed sig Livet folde ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "I Kjærlighed er godt at boe og bygge;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Vor Sang Henfarne synge med hos Gud.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
