{
  "id": null,
  "title": "† † † Tanker ved en ituslagen Jydepotte",
  "year_created": 1830,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Digte",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1830,
    "url": "https://tekstnet.dk/books/andersen-hc_digte-1830/048/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "– minuentur atræ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "carmine curæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Du er ei meer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Din Digter græder ved Dit brudte Leer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Det blev Din Lod at taale Røg og Flamme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Dog stod Du fast; Du altid blev den samme!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Faa kjendte Dig paa denne store Jord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Dog i Din Død Du nævnes skal i Nord;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Jeg i Avisen vil et Grav-Vers sætte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Saa Taarer skal de Skjønnes Kinder tvætte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "– Først var Du Leer, nu bliver Du det atter!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Saa gaaer det selv Naturens bedste Datter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Ak, var Du falden i en Kunstners Haand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Du havde vundet ved hans Skaber-Aand;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Som Vase skulde Du da Øiet gotte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Men Skjæbnen bød – Du blev en Jydepotte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Dit Liv svandt hen saa stille ingetogen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Som Askepot Du stod i Skammelkrogen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Tidt saae jeg Dig imellem Røg og Ild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Naar Maanens Straale flød paa Ruden mild;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Jeg saae Din Damp, i den steeg Aander frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "Og søgte gjennem Skorsteens-Piben hjem;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "Dig glemte de, naar de saae Stjerner tindre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "Da hørte jeg det koge i Dit Indre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 1,
      "text": "Ja, Du har følt og lidt som en Heltinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 1,
      "text": "Fred med Dit Minde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "– En Digter hører helst sin egen Sang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Thi vil jeg læse min saa mangen Gang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Til Alfen kommer paa de hvide Vinger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "Og Trøsten bringer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "– Om Æg og Linned drømte jeg i Nat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Da vidste jeg, det ei var rigtigt fat;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "Et Skrig fra Kjøkkenet jog mig af mine Drømme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "Der saae jeg Dine Skaar i Suppe svømme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "Alt var Forvirring, slukt var Skorsteens-Flammen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "Malene græd og samlede Dig sammen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "I Gaarden skal nu Dine Stumper hvile,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "Smaa-Blomster snart vil fra Din Gravhøi smile;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "Lad Tiden dække Alt med sine Vinger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "Maaskee i Døden den Dit Held Dig bringer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 3,
      "text": "Hvor nu er Land, var fordums Tid et Hav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 3,
      "text": "En Bøge-Skov kan voxe om Din Grav;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 3,
      "text": "Et Sekel gaaer –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 3,
      "text": "En Antiquar vil finde Dine Skaar;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 3,
      "text": "Dybt i hans Indre taler høit en Stemme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 3,
      "text": "At Konge-Støv Du engang maatte gjemme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 3,
      "text": "Til et Musæum skal Du Veien finde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 3,
      "text": "Som Skaar og Stumper Livets Krandse vinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 3,
      "text": "Og nu Farvel! jeg skal Din Grav besøge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 3,
      "text": "Men lov mig, at Du aldrig her vil spøge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 3,
      "text": "Græd ei, Malene!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 3,
      "text": "Hun har det godt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 3,
      "text": "Den salig Pot!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 3,
      "text": "Snart hvile ogsaa vore trætte Bene.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
