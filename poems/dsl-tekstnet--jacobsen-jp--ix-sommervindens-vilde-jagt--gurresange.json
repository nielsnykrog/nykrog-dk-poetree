{
  "id": null,
  "title": "IX Sommervindens vilde Jagt",
  "year_created": 1886,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Jens Peter Jacobsen",
    "country": null,
