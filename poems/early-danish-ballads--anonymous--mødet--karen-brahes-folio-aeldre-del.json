    {
      "id": 0,
      "stanza_id": 0,
      "text": "Ett werdskab, war ieg beddenn till,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "stuor løst oh tid att fordriffue |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "ther heedenn saa waar ieg ridenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "forløste mitt vnge liff |",
