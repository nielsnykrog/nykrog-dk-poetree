{
  "id": null,
  "title": "Jens Højby",
  "year_created": 1905,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Thøger Larsen",
    "country": null,
    "wiki": "Q323530"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Dagene, Viser Og Digte",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1905,
    "url": "https://tekstnet.dk/books/larsen-t_dagene/012/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Fuglene stige og svinde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "ind under Skyernes Uld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Ormene bore sig, blinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "gennem den mørke Muld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Langsomt Skæbnerne tvindes.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Øjeblikkene gaar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Enkelte Stunder vi mindes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "spredt, i enkelte Aar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Lys og Mørke har hersket",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "skiftevis i hvert Døgn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Blev Sandhed i Langhalm tærsket,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "jubled vi over en Løgn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Jag af Luner og Briser.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Idelig Bølgegang ...",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Efter de muntre Viser",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "gør vi en sørgelig Sang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Dagen sin Rigdom naadig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "mod levende Øjne vender.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Ormene higer med graadig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Blindhed i begge Ender. –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Paa de velsignede Agre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "trives de frodige Køer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Ensom ligger den magre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "Bonde Jens Højby og dør.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Mager det var han saalænge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "skønt han tærede kendeligt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "paa Kvæg og Marker og Enge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "Hvo æder sig fra sit Endeligt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "Han dør just ikke af Alder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "er kun et Halvhundred Aar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "Des mere kedsomt det falder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "og trægt og langsomt det gaar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "Han ligger i kalket Kammer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "ser med dogrende<button id=note11 type=button class=\"btn btn-outline-secondary btn-sm comment\" data-container=body data-toggle=popover data-template=\"<div class='popover' role='tooltip'><div class='arrow'></div><h3 class='popover-header'></h3><div class='popover-body'></div></div>\" data-placement=auto data-html=true data-content=\" <p> dogrende = sløv, sløret (maaske af dugget).</p> <p>( Dogrehoved = Halvtosse, glemsom Person).</p> \" data-title=\" Fodnote 11\">F11</button> Hjerne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "ud gennem Rudernes Rammer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "hen i det drivende fjerne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "Vender omsider Bagen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "med et taalmodigt Besvær",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "til sin Kvadrat af Dagen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "mens han fordøjer et Skær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "Hvert et Skær over Himlen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "vækker bestemte Minder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "Levede Timers Baggrundslys",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "inde i Hovedet skinner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "Han mindes den Ungdomshaaben,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "der spøger i Midnatsdrøm –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "en Seen Himmelen aaben",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "bagved en Kjolesøm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "Hun, som han højest ophøjede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "sejled for vildfar Vind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "Hun, som med ham sig nøjede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "blev en krasbørstig Kvind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 13,
      "text": "Lad Knægtene knubbes om Glæde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "der vindes i Tøseleg!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "Han har opgivet at æde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "og ligger paa Dydens Vej.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "Han føler ej mange Piner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Han følger i Ensomhed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "Vinduets skiftende Miner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "og Mindernes løse Skred.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 15,
      "text": "Han husker ogsaa, hvorledes",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "hans Moder, da han var Dreng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "laa Aar igennem og sledes",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "af Sygdom i samme Seng.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 16,
      "text": "Ja, ja. Det Liv, som man sanker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "sig møjsomt sammen paa Jord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "falmer til blege Tanker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "som i Ens Hoved bor.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 17,
      "text": "Edderkopperne kravle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "rejsende op og ned",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "ad Væggens hvidtede Tavle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "En Mus ved Døren bed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 18,
      "text": "Fra Revnen, vidt forgrenet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "i Væggen, ved Hjørneknækket,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "falder Klør-Attenbenet<button id=note12 type=button class=\"btn btn-outline-secondary btn-sm comment\" data-container=body data-toggle=popover data-template=\"<div class='popover' role='tooltip'><div class='arrow'></div><h3 class='popover-header'></h3><div class='popover-body'></div></div>\" data-placement=auto data-html=true data-content=\" <p> Klør-Attenben = Tusindben.</p> \" data-title=\" Fodnote 12\">F12</button>",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "ned paa Pudebetrækket.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 19,
      "text": "Han husker, at da hans Mo'r laa svag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "her i den samme Seng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "kaldte hun paa ham en Dag:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "»Kom herhen lille Dreng!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 20,
      "text": "»Se, hvad er det, som pirker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "»her paa min venstre Side.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "»Det er ved at gøre mig ræd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "»Det vilde jeg gerne vide«.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 21,
      "text": "Hastig til Sengestok",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 21,
      "text": "lille Jens Højby løb.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "Det var en Tvestjært-Flok<button id=note13 type=button class=\"btn btn-outline-secondary btn-sm comment\" data-container=body data-toggle=popover data-template=\"<div class='popover' role='tooltip'><div class='arrow'></div><h3 class='popover-header'></h3><div class='popover-body'></div></div>\" data-placement=auto data-html=true data-content=\" <p> Tvestjært = Ørentvist.</p> \" data-title=\" Fodnote 13\">F13</button>,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 21,
      "text": "som paa hans Moder krøb.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 22,
      "text": "Han fik ondt i sin Sjæl.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 22,
      "text": "Dyrene løb paa hans Mo'r,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 22,
      "text": "som naar man letter en Fjæl,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 22,
      "text": "der længe har ligget mod Jord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 23,
      "text": "Naa jaja. Herre Gud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 23,
      "text": "Kravler det lidt under Uld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 23,
      "text": "værre det er med alskens Kravl",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 23,
      "text": "nede i Sengen af Muld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 24,
      "text": "I Gaarden stryges en Le med Klem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 24,
      "text": "De lange Staalstrøg hvæse.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 24,
      "text": "Stift krummer sig Lyden frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 24,
      "text": "som snydt fra en næb-lang Næse.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 25,
      "text": "Riven skraber mod Gavl.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 25,
      "text": "Kløvren er tjenlig til Slæt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 25,
      "text": "Andre skal fælde Jens Højbys Avl.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 25,
      "text": "Selv er han altfor træt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 26,
      "text": "Karlen hujer paa Pigen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 26,
      "text": "Nu skal de følges af Sted",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 26,
      "text": "ned for at meje ved Sigen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 26,
      "text": "Kom det Jens Højby ved?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 27,
      "text": "Fluerne om ham summer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 27,
      "text": "Lydens løsagtige Spind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 27,
      "text": "hilder i Slør og Slummer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 27,
      "text": "Jens Højbys flakkende Sind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 28,
      "text": "Han drømmer om Velmagtsdage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 28,
      "text": "og det i sit Ansigts Sved.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 28,
      "text": "Det rokker i Leens Knage<button id=note14 type=button class=\"btn btn-outline-secondary btn-sm comment\" data-container=body data-toggle=popover data-template=\"<div class='popover' role='tooltip'><div class='arrow'></div><h3 class='popover-header'></h3><div class='popover-body'></div></div>\" data-placement=auto data-html=true data-content=\" <p> Knage = Haandtag (paa Le).</p> \" data-title=\" Fodnote 14\">F14</button>,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 28,
      "text": "saaledes mejer han ned.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 29,
      "text": "Men længe sover han ikke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 29,
      "text": "Han vaagner skuffet og træt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 29,
      "text": "Paa Panden Fluerne prikke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 29,
      "text": "Han blev ej færdig med Slæt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 30,
      "text": "Han ligger i Afmagts Hede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 30,
      "text": "og drejer sig lidt omkring.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 30,
      "text": "Solen er ikke nede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 30,
      "text": "Alt lader som ingenting.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 31,
      "text": "Han giver sin vaade Pande",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 31,
      "text": "et Strøg af sin haarde Haand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 31,
      "text": "Han pirker ved Livets Tande",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 31,
      "text": "og strækker et Senebaand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 32,
      "text": "Han ønsker, mens andre jage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 32,
      "text": "mod kommende Tiders Svøb,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 32,
      "text": "at skrue Jorden tilbage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 32,
      "text": "en tredive Solomløb.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 33,
      "text": "Dog hvad ... Den vilde jo rende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 33,
      "text": "igen som før af Sted.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 33,
      "text": "Og naar de Aar var til Ende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 33,
      "text": "hvad var da vundet derved?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 34,
      "text": "Saa kunde En atter ligge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 34,
      "text": "her i den samme Seng",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 34,
      "text": "og rundt i Krogene kigge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 34,
      "text": "og huske paa noget iflæng.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 35,
      "text": "Langsomt fremad der vindes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 35,
      "text": "men naar En Dødslejet naar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 35,
      "text": "kan i et Nu man mindes",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 35,
      "text": "hele det Slæb af Aar .....",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 36,
      "text": "Alt, hvad der blev tilbage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 36,
      "text": "er kun en Eftersmag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 36,
      "text": "Den er lidt flov at smage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 36,
      "text": "Jens Højby gaber i Dag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 37,
      "text": "Andre gøde og grave",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 37,
      "text": "og vente paa Frugt og Frø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 37,
      "text": "Hele hans Livs-Opgave",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 37,
      "text": "er nu at ligge og dø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 38,
      "text": "– Med Skrue bag i Skuden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 38,
      "text": "styrer et Spyfluejærn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 38,
      "text": "hovedkulds imod Ruden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 38,
      "text": "Stop! Du slog nok din Stjern.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 39,
      "text": "Bagved sit stille Garn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 39,
      "text": "haaber Edderkoppen:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 39,
      "text": "»Bare jeg havde det Skarn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 39,
      "text": "Den Satan har Sul paa Kroppen.« –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 40,
      "text": "Vinduet falmer omsider.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 40,
      "text": "Tusmørkekvidder høres.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 40,
      "text": "Nu er det nok ved de Tider,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 40,
      "text": "Sol over Havet føres. –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 41,
      "text": "Konen kommer at spørge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 41,
      "text": "til, hvorledes det gaar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 41,
      "text": "Hun bliver fed af at sørge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 41,
      "text": "Hun har lidt færre af Aar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 42,
      "text": "Jens Højby faar Mælk at drikke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 42,
      "text": "Hun sidder paa Sengestok.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 42,
      "text": "Meget taler de ikke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 42,
      "text": "De har jo talt mer end nok.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 43,
      "text": "»Aaja. Nu tænker jeg, Karen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 43,
      "text": "du snart skal blive mig kvit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 43,
      "text": "Du kan, naar du skynder dig lidt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 43,
      "text": "nok lokke en anden i Snaren.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 44,
      "text": "Igen dette Vrøvl. Jo Tak.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 44,
      "text": "Hun tager sin Kande ved Tud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 44,
      "text": "I Tavshed vrikker hun ud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 44,
      "text": "Det svier ej mere, det Hak.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 45,
      "text": "Saa angrer Jens Højby. Hun var",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 45,
      "text": "dog den af Menneskeskaren,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 45,
      "text": "der flest af hans Byrder bar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 45,
      "text": "Han stønner: »Karen! – Aa Karen!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 46,
      "text": "Men hun er jo gaaet sin Vej.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 46,
      "text": "Der er kun den tætte Dør.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 46,
      "text": "Den hører og svarer ej.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 46,
      "text": "Han skulde betænkt sig før.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 47,
      "text": "Sommernatsmørket er blødt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 47,
      "text": "Følsomt forer det Rummet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 47,
      "text": "hvor han ensom, forstummet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 47,
      "text": "ligger og stirrer forknyt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 48,
      "text": "Det skjuler Smaadyr i Spræk",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 48,
      "text": "og dem, som kravler i Krogen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 48,
      "text": "Om Huset gaar Nattens Træk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 48,
      "text": "en evig Konkyliekogen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 49,
      "text": "Himlen mod Ruderne klemmer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 49,
      "text": "sin duggede Drømmehinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 49,
      "text": "Saa varsomt Alverden glemmer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 49,
      "text": "Jens Højby i Mørket inde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 50,
      "text": "Det grønneste Træ staar for Truen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 50,
      "text": "af Ormen og Øksen og Saven.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 50,
      "text": "Jens Højby, som visner i Stuen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 50,
      "text": "faar Haab om lidt Hygge i Graven.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 51,
      "text": "Om Englekaar i det høje",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 51,
      "text": "har han kun lidtvorn drømt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 51,
      "text": "Han lader sig gerne nøje",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 51,
      "text": "med ej at blive fordømt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 52,
      "text": "Lad bare et Hul i Grønningen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 52,
      "text": "sluge det hele til Slut. – –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 52,
      "text": "Uglen sidder paa Mønningen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 52,
      "text": "Hør! Den hujer: Herut! –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 53,
      "text": "Jens Højby veed paa en Prik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 53,
      "text": "hvorledes han nu er faren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 53,
      "text": "Mod Døren søger hans Blik.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 53,
      "text": "Han stønner: »Karen! – Aa Karen!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 54,
      "text": "Den røde Maane saa nabo-nær",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 54,
      "text": "nu ses for Vinduet stige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 54,
      "text": "den arrede Sten i sit stille Skær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 54,
      "text": "de dødes rejsende Rige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 55,
      "text": "Bag Laden stryges en rusten Le",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 55,
      "text": "med slappe, slæbende Skrab.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 55,
      "text": "Det gør Jens Højby saa søvnig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 55,
      "text": "Hans Mund staar en Smule paa Gab.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 56,
      "text": "Gud, som er ensom og naadig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 56,
      "text": "sin Fred til Jens Højby sender.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 56,
      "text": "Ormene higer med graadig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 56,
      "text": "Blindhed i begge Ender.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 57,
      "text": "Ormene de er hellige Dyr.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 57,
      "text": "De stopper sig Hulningen fuld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 57,
      "text": "Ved deres hungrige Stræben",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 57,
      "text": "dannes den gode Muld.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
