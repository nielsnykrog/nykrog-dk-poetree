  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Dynæs Digte",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1915,
    "url": "https://tekstnet.dk/books/skjoldborg-j_dynaes-digte/008/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Naar Vinteren rinder i Grøft og i Grav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "og Rugens de krøllede Blade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "sig ranker i Solen, som spejles i Hav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "jeg griber med Længsel, jeg ved knap deraf,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "min Hakke, min Skovl og min Spade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Jeg hvæsser paa Stenen den rustnede Æg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "og retter den bøjede Plade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "saa springer jeg uden for Mur og for Væg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "hvor Marken har Klumper og Mosen har Klæg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "med min Hakke, min Skovl og min Spade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Jeg lytter til Vaarens det syngende Kor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "til Lærken den jublende glade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "vi kender hinanden fra Somren ifjor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "den kvidrer, jeg grøfter og graver min Jord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "med min Hakke, min Skovl og min Spade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Naar Solen gaar ned i et luende Baal",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "bag Lyng-Hedens vidtstrakte Flade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "jeg retter min Ryg, og jeg skimter et Maal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "da blaaner og blinker det blankslidte Staal",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "i min Hakke, min Skovl og min Spade.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
