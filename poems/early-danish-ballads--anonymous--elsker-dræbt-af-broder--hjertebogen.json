    "year_published": 1555,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/HJB69.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "LXIX |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 1,
      "text": "Iomfru Illins-borre stanner | y hoffuetlofft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "och seer hund vd sa | wide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "hisset seer ieg her Oluff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "y gr-onen Lund att ride,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": ":: thy sørrer hund | y-saa lønligh. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Hisset seer ieg her Oluff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "ieg kenner hans ganger huid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "giffuet gud-fader | y hymmerig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "thet hand wyll | ride hiidt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": ":: T S H I s: L: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "Iomfru Illinsborre wenner seg | om y-gien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "och tiill sin mør att tale |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "hissett seer ieg her oluff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "och huad ska | ieg ham suare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": ":: Thi sorrer hund y-saa | lønligh. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "I suarer ham will y suarer | ham tiitt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "alt som y ful-well | kunne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "y har ham y ethers hiarthe | saa kier,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "som y ethers broder funne, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": ":: thy sørrer hund y-saa lønligh. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Slig er her Oluff for andre mend, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "som solen for liuszen stiernne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "ware ieg | sligenn Iomfru som y",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "hans wille giøre ieg saa giernnhe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": ":: Thi sørrer hund | y-saa lønligh. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Slig er her Oluff for andre mend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "som solen for mørcken skie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "war | yeg sligen Iomfru som y.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": "Ieg wyll | giernne aaff landen mett hannum fly |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": ":: T S H S L. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "Hossen vntt harm |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "machtt manigen som | veren |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 7,
      "text": "Thett war herre Oluff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 7,
      "text": "han | kom ther ridendis y gardt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "vde | star Iomfru Illins-borre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 7,
      "text": "hund | war well suobt y mardt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": ":: Thy | sørrer hun y-saa lønligh. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 8,
      "text": "Hell stanner du Iomfru Illins-borre |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 8,
      "text": "du est well suobt y skinnd |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 8,
      "text": "wiltu lenne meg hus y natt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 8,
      "text": "och | giffue meg troen din.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 8,
      "text": ":: Thi sørrer | hun y-saa lønligh. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 9,
      "text": "Suaret thett Iomfru Illins-bore |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 9,
      "text": "och hinne rand tare paa kind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 9,
      "text": "saa gie-rnne yeg thet giøre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 9,
      "text": "motte ieg for brødernne myn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 9,
      "text": ":: T S H I S L: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 10,
      "text": "Slig er y her Oluff for andre mend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 10,
      "text": "som solen for liuszen | stiernne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 10,
      "text": "hade y ycke wed mynn | moderbroder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 10,
      "text": "eders wille giørde ieg | saa giernne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 10,
      "text": ":: T S H y S L: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 11,
      "text": "Har yeg wed thin moder-broder |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 11,
      "text": "och giørth teg thet imodt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 11,
      "text": "godtz och pennige och guld och sølff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 11,
      "text": "thet beder yeg for | ham bod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 11,
      "text": ":: Thy sørrer hun y-saa løn-lig | . | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 12,
      "text": "Godts och pendinge och guld och | solff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 12,
      "text": "thett beder ieg for ham bod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 12,
      "text": "huad wyll y mer vdaff meg haffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 12,
      "text": "ieg | faller ether giernne tiill fod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 12,
      "text": ":: Thi | Sør H I s L. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 13,
      "text": "I Rider saa lystelig offuer | then broe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 13,
      "text": "saa listelig offuer thi hede, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 13,
      "text": "ther møder eder myn brøder vij",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 13,
      "text": "y | har god ord tiill rede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 13,
      "text": ":: T S H I s L: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 14,
      "text": "Thett war herre Oluff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 14,
      "text": "hand bod | hind gode-natt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 14,
      "text": "herre gud lade osz leue then dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 14,
      "text": "att wi maa fynnes snart |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 14,
      "text": ":: thy sørrer hund y-saa lønlig. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 15,
      "text": "Hand red saa listelig offuer then | broe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 15,
      "text": "saa listelig offuer thii hede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 15,
      "text": "ther | møtte ham Iomfruerens broder vii |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 15,
      "text": "de war bode rasske och wrede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 15,
      "text": ":: thy | sørrer hund y-saa lønligh. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 16,
      "text": "Hell mød du herre Oluff |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 16,
      "text": "hui rider du meg y-mod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 16,
      "text": "du har | wed wor moder-broder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 16,
      "text": "du løst | wøsz aldrig bod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 16,
      "text": ":: Thy sørrer hund y-saa lønligh. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 17,
      "text": "Har yeg wed eders naderbroder, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 17,
      "text": "da beder yeg for ham bod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 17,
      "text": "gods och | pennig guld och erlig søll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 17,
      "text": "thet beder yeg | for ham bod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 17,
      "text": ":: T S H y S L: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 18,
      "text": "Godts och pendinge guld och sølf |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 18,
      "text": "thet beder ieg ether tiill bod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 18,
      "text": "huad wil | y mere vdaff meg haffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 18,
      "text": "yeg fall-er | eder giernne tiill fod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 18,
      "text": ":: Thy sørrer | hund I-saa lønligh. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 19,
      "text": "Du har wed wor moder-broder |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 19,
      "text": "wy wille ycke haffue for ham bod. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 19,
      "text": "och du har locket wor suster,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 19,
      "text": "och | giørth osz mange hoffmod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 19,
      "text": ":: thy sørrer | hund y-saa lønlig. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 20,
      "text": "Iomfru Illinsbore er yend Roszen-blad |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 20,
      "text": "Crist giemme hynnes her och hennes ere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 20,
      "text": "wyll y meg hynne tiill myn | hustru giffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 20,
      "text": ":: T S H I s L: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 21,
      "text": "Thett war herre peder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 21,
      "text": "hand siitt | suerd vddrog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 21,
      "text": "thet war herre Oluff |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 21,
      "text": "han ner tiill Iorden woff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 21,
      "text": ":: Thy sør-rer | hund y-saa lønlig. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 22,
      "text": "Melte thett Herre peder, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 22,
      "text": "hand banth siitt suerd wed sie, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 22,
      "text": "høre i thet myn kiere brodere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 22,
      "text": "nu | , wyll wy tiill stalt Illin ride |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 22,
      "text": ":: T S H y s L: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 23,
      "text": "Thett war herre peder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 23,
      "text": "hand kom | ther ridendis y gardt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 23,
      "text": "vde star stalten | Ellinsbiere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 23,
      "text": "hun war well suobt y mard |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 23,
      "text": ":: Thy sørrer hun y-saa lønlig. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 24,
      "text": "Hell stanner du stalten Illin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 24,
      "text": "och | kiere søster myn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 24,
      "text": "wor her icke herre | oluff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 24,
      "text": "snimhen hiem tiill dint,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 24,
      "text": ":: thy | sørrer hund y-saa lønligh. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 24,
      "text": "Raadis ieg efter ieg | haffuer |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 25,
      "text": "Hand wor her y garen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 25,
      "text": "och | hand redt borth y-gienn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 25,
      "text": "godtz | och pending guld och sølff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 25,
      "text": "thett | beder hand for kier moder-broder |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 25,
      "text": ":: T S H y S L: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 26,
      "text": "Godts och pendinge guld och | sølff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 26,
      "text": "thett beder hand wosz tiill | bod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 26,
      "text": "huad wyll wy mere vdaff | ham haffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 26,
      "text": "hand faller osz giernne tiill fod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 26,
      "text": ":: thy S H y s L: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 27,
      "text": "Hør du stalten Illin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 27,
      "text": "och kiere | suster myn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 27,
      "text": "far du deg tiill breden | aa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 27,
      "text": "och klag her oluffs lig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 27,
      "text": ":: thy | sørrer hund y-saa lønlig. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 28,
      "text": "Melthe thett stalten Illin |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 28,
      "text": "hun vred sin henner aff nød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 28,
      "text": "herre gud lade deg leffue den | dagh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 28,
      "text": "du for-trider her | Oluffs død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 28,
      "text": ":: thy sørrer hun y-saa | lønligh. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 28,
      "text": "O gud hussuale alle bedrøued hierter, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 28,
      "text": "och vnne dem alle thett Gud er tackeligt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 28,
      "text": "och mennissken er nøtteligt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 28,
      "text": "bode tiill liff och siell. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 28,
      "text": "5 * 5 |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 28,
      "text": "A V V M E S E |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 28,
      "text": "1564 |",
      "part": false,
