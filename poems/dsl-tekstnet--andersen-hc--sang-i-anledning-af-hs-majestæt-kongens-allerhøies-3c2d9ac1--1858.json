  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Saa smukt os Kæmpevisen sang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Om Kjærlighed i Norden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Dens Styrke og dens Troskab klang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "I Sagn vidt over Jorden;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Den har i Danmark fæstet Rod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Det er ved Gjerning tolket;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Her Konge-Styrken, sund og god,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Er Kjærlighed i Folket.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Ja, Folkets Aand og Hjerte-Lag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Er en Usynlig Kirke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Der straaler frem paa Alvors Dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Et herligt Dannevirke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Dybt Konge-Hjertet det forstod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Skrev det til Skjoldemærke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "– Vi er’ ved Dig, vor Konge god,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "I Sammenholdet stærke!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Gud holde over Dig sin Haand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Og over Danmarks Rige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Han løsne altid Smertens Baand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Og lade Sygdom vige;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Da, Konge, sees i Huus og Stad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Som Festblus, Hjerte-Flammen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Kom mellem os, kom tidt og glad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Vor Styrke voxer sammen!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Sankt Hans du bringer os Sommertid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "din Fest skal staa i det Grønne;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Stadsen koster os ikke en Hvid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Kukker og Drossel synge: Kom hid!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Alle Smaapiger er kjønne!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Kjønnere gjør dem nu Kildens Væld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Lykke og Held!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Lykke og Held!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "Det vilde Skovæble trives.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "Hexene flyve henover Vang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "Hesten er kun en Humlestang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "Klog Mand trækker da med sin Kabuds,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "seer ei derpaa, seer ei derpaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "Bonden tænder paa Marken Blus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "saa kan ei Sot og Syge ham naa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "Hil være Sanct Hans!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 3,
      "text": "Hil være Sanct Hans!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "Snart komme alle de Stjerner smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "de blinke smukt ned fra oven;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "Nattergalene høre vi slaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "Kjærestefolk med hinanden gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 4,
      "text": "der er saa dejligt i Skoven.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 4,
      "text": "Sammen de vandre til Kildens Væld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 4,
      "text": "Lykke og Held!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 4,
      "text": "Lykke og Held!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 4,
      "text": "Ei skjønnere Aften gives.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 4,
      "text": "Rumlende, tumlende kommer en Flok,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 4,
      "text": "nogle paa Krykke, andre med Stok;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 4,
      "text": "Skillinger blanke de kaste paastand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 4,
      "text": "i Kildens Vand, i Kildens Vand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 4,
      "text": "Sundheds Urt er den bedste Urt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 4,
      "text": "den er langt meer end Guldet purt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 4,
      "text": "Hil være Sanct Hans!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 4,
      "text": "Hil være Sanct Hans!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 5,
      "text": "Sanct Hans, du bringer os Sommertid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 5,
      "text": "din Fest skal staa i det Grønne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 5,
      "text": "Stadsen koster os ikke en Hvid;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 5,
      "text": "Kukker og Drossel synge »Kom hid!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 5,
      "text": "Alle Smaapiger er kjønne;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 5,
      "text": "Kjønnere gjør dem nu Kildens Væld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 5,
      "text": "Lykke og Held!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 5,
      "text": "Lykke og Held!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 5,
      "text": "Det vilde Skovæble trives.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 5,
      "text": "Lykke og Held!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 5,
      "text": "Lykke og Held!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 5,
      "text": "Det vilde Skovæble trives.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 5,
      "text": "Lykke og Held!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 5,
      "text": "Lykke og Held!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 6,
      "text": "Nu er her i Skoven en Stilhed og Fred;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 6,
      "text": "dog tys! Hør Sang af hjemvandrende Skarer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 6,
      "text": "Hør enkelte Stemmer:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 6,
      "text": "Hallo, kom med!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 6,
      "text": "Hallo, kom med!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 6,
      "text": "Ekkoet svarer Hallo, kom med! Kom med!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 6,
      "text": "Og atter Stilhed!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 6,
      "text": "Stilhed! Nat!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 6,
      "text": "Deilige klare opløftende Nat!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 6,
      "text": "Til et helligt Sted staar nu indviet fraoven",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 6,
      "text": "Skoven!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 6,
      "text": "Deilig er Skoven!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 6,
      "text": "Deilig er Skoven!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 7,
      "text": "Til et helligt Sted staar nu indviet fraoven",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 7,
      "text": "Skoven;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 7,
      "text": "Deilig er Skoven!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 7,
      "text": "Deilig er Skoven!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 8,
      "text": "I det brændende Skib, paa det rullende Hav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 8,
      "text": "I Rædsler, som ei vi udholde at høre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 8,
      "text": "Har Du lidt, har Du endt, har Du fundet din Grav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 8,
      "text": "Dødsmaaden og Kampen naae aldrig vort Øre!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 9,
      "text": "Du dristige, kraftfulde Sjæl, Du Dig holdt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 9,
      "text": "I et skrøbeligt Legem; høit stod Du i Vrimlen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 9,
      "text": "Og aldrig dit ildfulde Hjerte blev koldt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 9,
      "text": "Her Faa kun forstod Dig, men Flere i Himlen!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 10,
      "text": "Du var mig en Søster deeltagende stærk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 10,
      "text": "Min Sjæl holdt Du oppe, naar Verden mig traadte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 10,
      "text": "Du kjendte, forstod mig, og det er dit Værk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 10,
      "text": "At tit jeg ei sank, naar synke jeg maatte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 11,
      "text": "Det Falske, det Tomme, det Bjældeklangs Smaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 11,
      "text": "Har Hobens Beskyttelse, bæres af Strømmen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 11,
      "text": "Dens Løb ei forandres –, Skumbølgerne gaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 11,
      "text": "Og Jordlivet gaaer, – det er endt snart, som Drømmen!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 12,
      "text": "Farvel min Veninde fra Barndommens Aar!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 12,
      "text": "Du var mig meer god, end jeg det fortjente,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 12,
      "text": "Nu har Du stridt ud –; hos en Broder Du staaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 12,
      "text": "Med hvem alt paa Jorden Dig Længsel foreente.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 13,
      "text": "Din Kiste blev Havet, det rullende Hav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 13,
      "text": "Og Indskriften over Dig staaer i vort Hjerte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 13,
      "text": "Din Sjæl er i Himlen, der Herren Dig gav",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 13,
      "text": "Lyksalighed tifold for Dødsstundens Smerte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 14,
      "text": "I det brændende Skib, paa det rullende Hav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 14,
      "text": "I Rædsler, som ei vi udholde at høre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 14,
      "text": "Har Du lidt, har Du endt, har Du fundet din Grav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 14,
      "text": "Dødsmaaden og Kampen naae aldrig vort Øre!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 15,
      "text": "Saa hurtigt flyver Tiden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 15,
      "text": "Man selv det knap forstaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 15,
      "text": "Nys leged’ man som liden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 15,
      "text": "Nu graaner alt vort Haar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 15,
      "text": "Men Kjærlighed udfolder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 15,
      "text": "En indre, stadig Vaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 15,
      "text": "Et Blomsterflor, der holder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 15,
      "text": "Igjennem alle Aar!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 16,
      "text": "Hvad bittert var, forsvinder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 16,
      "text": "Hvad tungt var, bliver let,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 16,
      "text": "Man faaer en Skat af Minder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 16,
      "text": "Og Livet skeer sin Ret;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 16,
      "text": "Man lærer det at skatte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 16,
      "text": "Og Prøvelserne med,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 16,
      "text": "En Krands Gud om det satte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 16,
      "text": "Og den er Kjærlighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 17,
      "text": "Og hvor i den To mødes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 17,
      "text": "Og troligt holde ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 17,
      "text": "Et Aandens Samliv fødes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 17,
      "text": "Fra her og ind til Gud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 17,
      "text": "Det siger Eders Øie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 17,
      "text": "Det hvisker Eders Mund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 17,
      "text": "Det jubler mod det Høie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 17,
      "text": "Den dybe Hjertegrund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 18,
      "text": "See, rundt om sidde Mange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 18,
      "text": "Endnu fra første Fest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 18,
      "text": "Sølvbryllups-Festens Sange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 18,
      "text": "Istemmer gammel Gjest;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 18,
      "text": "Og Fader er tilstede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 18,
      "text": "Som før paa dette Sted,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 18,
      "text": "Ak, hvad var Festens Glæde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 18,
      "text": "Naar ikke han var med!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 19,
      "text": "Nu er Sølvbryllups Sommer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 19,
      "text": "Med Børnekredsens Vaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 19,
      "text": "Guldbryllups-Festen kommer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 19,
      "text": "Om fem og tyve Aar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 19,
      "text": "Paa Sangens Svanevinge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 19,
      "text": "Faaer Ordet dobbelt Magt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 19,
      "text": "I Sang lad »Hurra« klinge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 19,
      "text": "og Gottlieb bragt!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
