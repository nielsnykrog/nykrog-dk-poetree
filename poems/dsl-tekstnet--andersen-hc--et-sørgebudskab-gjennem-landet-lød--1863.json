  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Et Sørgebudskab gjennem Landet lød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "»Kong FREDERIK DEN SYVENDE er død!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Lyd Sørgesang ud over Thyras Vold!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Et Konge-Hjerte brast i Danmarks Skjold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Et Hjerte, sendt af Gud til Folk og Land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Meer Dansk end Kongen var der ingen Mand!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Fra Hedenold og til vor Fremgang nu",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Har Ingen elsket Danmark meer end Du!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Du er for Verden Kongemagtens Tolk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "I Kjærlighed velsignet af et Folk.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Tak for dit Hjertelag, Alt, hvad Du gav!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Taknemlighed nu græder ved Din Grav.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
