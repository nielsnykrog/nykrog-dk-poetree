  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Gud wor Fader tw som æst ÿ Himmerig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "høgt offuer oss oc aandelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "wilt tw tilbeden worde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Thit hellige naffn lad nw vdsprees saa weldelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "ath thet kandt wære priseligt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "y Himmelen och paa iorden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Thit rige tilkomme oss naadeligt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "som oss kandt freden giffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Och hwes teg ey er behageligt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "ÿ oss thu wilt vddriffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "paa thet att wÿ maa ewindelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "vdi thit rige bliffwe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "O milde Gudt thÿn wilie lad ske ÿ iorderig /",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "ÿ alle maade ath wære lig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "som vdi himmerige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Ther hæden oc ingen komme kandt och maa bestaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "foruden then hwes wilie er saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "thin aldelis liige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Oc giff oss nw wortt daglige brødt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "som siælen skall bespise/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Jeg meen thit hellige Guddoms ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "at wÿ thet høre oc priise.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "Ther mett tw oss til salighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "then rette wey wilt wiise.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Wor misgerning oc all wor skyld forlad oss heer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "hwad tw aff oss fortørnedt er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "wilt tw oc vdslette",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Tesligest giøre wÿ ÿ same maade wore schyldener/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "oc hwes the oss fortørnet haffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "thet wil wÿ plat forgette.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "J nogen frestelse oss ey indføør/ att wÿ ther ÿ forfares/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "Fra saadant ont tw oss beware/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "ther siælen kan forderffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 2,
      "text": "Oc giøre oss alle samen lige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 2,
      "text": "ath wÿ thit rige maa ærffue/ AMEN.",
      "part": false,
      "marginal_notes": []
    }
  ]
}