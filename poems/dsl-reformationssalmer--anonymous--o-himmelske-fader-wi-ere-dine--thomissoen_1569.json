    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/thomissoen_1569/21"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Himmelske Fader wi ere dine",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Wi soffue eller vaage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Wi leffue eller dø/ da ere wi dine/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Til dig naar wi monne haabe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Wi tacke dig ved Jesum Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Du haffuer oss denne dag foruist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Beuarit/ aff blote naade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Fra alskens vaade/ baade last oc skam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Oss monne stedse offuerhenge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Paaførd aff Dieffuelen/ vor fiende gram/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Som en grum Løffue monne omuancke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Leeder huem hand kand sluge op",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Baade met Siel och saa met krop/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Met sine snedige rencker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Vor forsømmelse haffuer værit stor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "J det wi skulde vdrette",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Dit naffn til ære vor neste til gode/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Wi kunde det intet necte:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Det volder vor store skrøbelighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Wi intet gaat kunde komme aff stæd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Vden du hielper met din naade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Wi bede dig aff hiertet gierne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "Vilt naadelig forgiffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Huess du aff oss fortørnit er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Met vort syndige leffnit:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Aff gantske hierte er det oss leedt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Forlad det for Christi pine oc død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Vor gierning kand det ey betale.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Beskerm oss oc fra all vor nød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "Vnder din barmhiertigheds skygge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "Fra vore fienders farlige anstød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "J fristelse giør oss trygge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Mørckhedsens Fader vden all frist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "Baade Siel oc liff alt met sin list",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "Gierne fordærffue vilde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Effter du gaffst vor skrøbelighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "Natten til ro oc huile/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "Aff din store barmhiertighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "Oss Arme forleske vilde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "Aff syndsens møye oc store kummer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "Vort vsle krop stedse offuerhenger/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "Aarle saa vel som silde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "Thi bede wi dig vor Fader blid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "J nat vilt rolig giøre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "Vort sind oc alle vor tanckers ijd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 6,
      "text": "Formedelst Christum vor Herre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 6,
      "text": "Fra samuittighedsens suare wro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 6,
      "text": "Formedelst en sand Christelig tro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "Met din Aand vilt oss beuare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 7,
      "text": "Giff vor syndige Jordesæck",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 7,
      "text": "Fredsommelig at soffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 7,
      "text": "Den kunde vederquegis oc bliffue sterck",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 7,
      "text": "Mod dagens tilkommendis møye.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 7,
      "text": "Opliuss vort hierte hu oc Siel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 7,
      "text": "At de maatte vaage alt lige vel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 7,
      "text": "Oc i fast tro til dig haabe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 8,
      "text": "At wi kunde baade i søffn oc vect/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 8,
      "text": "Vdaff din hellig Aands naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 8,
      "text": "J din fryct stille vor idret",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 8,
      "text": "Baade Siel oc liff til Bade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 8,
      "text": "Wi kunde omsier euindelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 8,
      "text": "Findis liusens Børn i himmerig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 8,
      "text": "Ved Christi fortienist allene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 9,
      "text": "Paa denne tillid befale wi nu",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 9,
      "text": "J dine Guddommelig hænder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 9,
      "text": "Baade Siel oc liff/ du trofaste Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 9,
      "text": "Alt ont vilt fra oss vende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 9,
      "text": "Fra huss folck oc alt huess wi aaer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 9,
      "text": "Til dig allene vort haab nu staar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 9,
      "text": "Vor bøn vilt naadelig høre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 10,
      "text": "Gud Fader dig ske loff oc ære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 10,
      "text": "For alle velgierninger dine/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 10,
      "text": "Oc Jesu din Søn vor Frelser kier",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 10,
      "text": "Oss løste met sin død oc pine/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 10,
      "text": "Der til vor trøster den hellig Aand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 10,
      "text": "Som fornyet oss i Daabsens vand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 10,
      "text": "Wi siunge aff hiertet/ Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 11,
      "text": "Christe du est baade liuss oc dag/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 11,
      "text": "Nattens mørckhed du monne forklare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 11,
      "text": "du sigis at være liusens liuss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 11,
      "text": "lær oss veien til din Faders huss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 12,
      "text": "Wi bede dig O hellige Herre Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 12,
      "text": "Vocte oss denne nat fra Dieffuelens list/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 12,
      "text": "Vnde oss i dig den euige ro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 12,
      "text": "Giff oss en rolig Nat oc god.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 13,
      "text": "At syndsens søffn oss ey besuare kand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 13,
      "text": "Ey Dieffuelen den onde Fristermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 13,
      "text": "At Legemit ey samtycker hans raad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 13,
      "text": "Oc ey komme i din vrede oc had.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 14,
      "text": "Først vore øyen tage søffn til sig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 14,
      "text": "Da lad vort hierte vaage til dig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 14,
      "text": "Din høyre haand beskerme her",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 14,
      "text": "Dine tienere/ som dig haffue kier.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 15,
      "text": "See til oss Gud vor Beskermermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 15,
      "text": "Vocte oss fra Dieffuelen den skadelig Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 15,
      "text": "Regere dem vel dig tiene met tro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 15,
      "text": "Som du løste met dit dyrebar Blod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 16,
      "text": "O Herre vilde du der tencke paa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 16,
      "text": "J dette suare Legeme wi nu gaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 16,
      "text": "Du est allene Sielens trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 16,
      "text": "Vær du met oss i all vor brøst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 17,
      "text": "Gud Fader hannem hører ære oc priss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 17,
      "text": "Hans eniste Søn disligeruiss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 17,
      "text": "Den hellig Aand oc lige der met/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 17,
      "text": "Fra denne stund oc til euig tid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 18,
      "text": "Christe du est den klare dag/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 18,
      "text": "for dig kand skiulis ingen sag/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 18,
      "text": "du liuser oss aff Faderen her/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 18,
      "text": "oc du est liusens Predicker/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 18,
      "text": "Predicker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 19,
      "text": "Herre ved dit Ord det dyrebar skat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 19,
      "text": "Beuar oss vel i denne nat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 19,
      "text": "Oc lad oss i dig huile naa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 19,
      "text": "Oc fra Sathans list tryghed faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 20,
      "text": "Naar søffnen falder vor øyen paa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 20,
      "text": "Vort hierte lad for dig vaagen staa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 20,
      "text": "Holt offuer oss din høyre haand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 20,
      "text": "At wi ey falde i syndsens baand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 21,
      "text": "O Christe Jesu til oss see/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 21,
      "text": "Driff bort vor Fiende som giør oss vee:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 21,
      "text": "Lad hannem met oss haffue ingen mact",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 21,
      "text": "Som oss at myrde haffuer i act.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 22,
      "text": "Wi ere dog din Arffuedeel god/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 22,
      "text": "Forhuærffuit met dit hellige Blod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 22,
      "text": "Det vaar din euige Faders raad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 22,
      "text": "Der hand dig oss gaff aff sin naade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 23,
      "text": "Befal dine Engle til oss komme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 23,
      "text": "Oc oss beuage din Eiedom:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 23,
      "text": "Lad dem vore Vectere være saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 23,
      "text": "At wi for Sathan huile faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 24,
      "text": "Saa soffue wi Jesu i dit naffn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 24,
      "text": "Aff dine Engle faa wi det gaffn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 24,
      "text": "O du hellige Trefoldighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 24,
      "text": "Wi loffue dig i euighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 25,
      "text": "O du Trefoldig enighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 25,
      "text": "Oc en sand Gud aff euighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 25,
      "text": "Solen met dagen gaar oss fra/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 25,
      "text": "dit Guddoms liuss lad hoss oss staa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 26,
      "text": "Wi loffue dig om Morgenstund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 26,
      "text": "Om Afftenen bede om din miskund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 26,
      "text": "Vor Arme loffsang priser dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 26,
      "text": "Nu oc altid euindelig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 27,
      "text": "Gud Fader ske nu euig ære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 27,
      "text": "Gud Søn som er vor enist Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 27,
      "text": "Oc vor trøster den hellig Aand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 27,
      "text": "Ske loff oc priss i alle Land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 28,
      "text": "O Herre Gud som alting skob",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 28,
      "text": "Himmel oc Stierner met sit laab/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 28,
      "text": "Tho store liuss haffuer du opsat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 28,
      "text": "Soel til dag oc Maane til nat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 29,
      "text": "Oc Dagen er saa skabt aff dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 29,
      "text": "At da skal huer mand bruge sig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 29,
      "text": "Men alle de paa Jorden bo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 29,
      "text": "Skulle om natten haffue ro.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 30,
      "text": "All Creatur huert i sin skick",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 30,
      "text": "Er opsat til at prise dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 30,
      "text": "Oc end er mennisken skabt saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 30,
      "text": "At hand alle Diur skal faarestaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 31,
      "text": "Men huer mand maa beklage det",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 31,
      "text": "At synden er indkommen met/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 31,
      "text": "Vort regiment haffuer hun forkrenckt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 31,
      "text": "Oc oss met sig i Døden senckt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 32,
      "text": "Wi bede dig O Herre mild/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 32,
      "text": "Huad wi haffue brut giff oss det til.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 32,
      "text": "Giff oss din naade/ O Herre Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 32,
      "text": "At wi i Christo holde dine bud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 33,
      "text": "Beuar oss denne nat/ hør vor bøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 33,
      "text": "Ved din hellig Aand oc din Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 33,
      "text": "Som est en sand Trefoldighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 33,
      "text": "Oc regnerer i euighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 34,
      "text": "Effter Guds skick gaar det saa til/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 34,
      "text": "at Natten nu paakomme vil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 34,
      "text": "oss denne dag fremgangen er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 34,
      "text": "mørcket met søffnen kommer her.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 35,
      "text": "Saa haffue wi nu det ey fordrag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 35,
      "text": "At tacke Gud for denne dag/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 35,
      "text": "Som hafft haffuer paa oss den act",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 35,
      "text": "At wi ere end nu vel ved mact.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 36,
      "text": "Oss ligger der oc mact oppaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 36,
      "text": "At wi Gud bede met oss staa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 36,
      "text": "At Dieffuelen som oss hader saa brat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 36,
      "text": "Slaar oss ey ned i denne nat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 37,
      "text": "Wi bede dig/ O Herre kier/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 37,
      "text": "Du som vor rette Fader er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 37,
      "text": "Giør met oss effter din miskund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 37,
      "text": "Beuare oss vel i allen stund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 38,
      "text": "Ære oc priss ske Faderen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 38,
      "text": "Aff oss/ disligest oc Sønnen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 38,
      "text": "Den hellig Aand ske nu oc saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 38,
      "text": "At der er ingen ende paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 39,
      "text": "SOlen er nu nedgangen plat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 39,
      "text": "Oc kommen er den mørcke Nat:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 39,
      "text": "O Jesu vær vort liuss oc skin/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 39,
      "text": "At wi ey skreckis i mørckheds trin.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 40,
      "text": "Dig ske tack at du oss denne dag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 40,
      "text": "Fra skade fare oc mangen plage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 40,
      "text": "Ved dine Engler beuarit haffuer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 40,
      "text": "Aff faderlig naade gunst oc gaffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 41,
      "text": "Men huess wi haffue fortørnet dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 41,
      "text": "Alt det forlad oss naadelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 41,
      "text": "Tilregne det icke vor arme Siel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 41,
      "text": "Lad oss met fred oc ro soffue vel.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 42,
      "text": "Lad dine Engler hoss oss vaage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 42,
      "text": "At Dieffuelen ey giør oss wmage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 42,
      "text": "Fra spøgelsse/ drømme/ skreckelss oc Jld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 42,
      "text": "Fri oss denne nat/ O Herre mild.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 43,
      "text": "Dig Herre mild/ ieg tacke vil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 43,
      "text": "for all godhed mig er beteed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 43,
      "text": "besynderlig du haffuer mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 43,
      "text": "i Nat(Dag) bistand giort met din haand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 43,
      "text": "oc beder end din hielp forlen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 43,
      "text": "i denne Dag(Nat) mod min wuen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 44,
      "text": "Beuare vel baade liff oc Siel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 44,
      "text": "Gods huss oc hiem/ for alle dem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 44,
      "text": "Som gierne see oc der at lee",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 44,
      "text": "At mig misgaar/ din Engel klar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 44,
      "text": "Være mig nær/ O Herre kier/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 44,
      "text": "At ieg altid flyer ond begær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 45,
      "text": "Jeg beder oc nu/ aff all min hu/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 45,
      "text": "Du vær mig huld/ for Christi skyld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 45,
      "text": "Oc giff mig til/ O Herre mild",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 45,
      "text": "Vdi huad deel met mig er feil",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 45,
      "text": "Det er mig leedt/ som du vel veedt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 45,
      "text": "Alt huad som imod dig er skeedt.",
      "part": false,
      "marginal_notes": []
    }
  ]
}