{
  "id": null,
  "title": "1. Skræk og Beroligelse",
  "year_created": 1836,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Ørsted",
    "country": null,
    "wiki": "Q44412"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Luftskibet",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1836,
    "url": "https://tekstnet.dk/books/oersted-hc_luftskibet/003/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Østens Lys sig over Samos hæver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Duggen glimter paa det friske Græs,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Men trods Lyset, Nattens Skræk omsvæver",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Folkestimlen paa det vestre Næs.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Dagen forud mindst de ahned Fare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Vegen var den hele Tyrkemagt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Men i dybe Nat en fjendtlig Skare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Skuffet har den altfor trygge Vagt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Kaldt fra Søvnens Favn ved Skrig og Flammer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Kæmped man iblinde, uden Frugt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Selv den Kjekkeste fra denne Jammer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Øined ingen Redning uden Flugt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Med bevinget Fjed mod Havet iler",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Hver, som undgik Fjendens Morderslag;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Nu hvert Blik paa Bølgesletten hviler,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Ængstligt søgende et fremmed Flag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "»Lyst til Bytte holder end tilbage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Fjenden i den røgomslørte By;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Men hvorhen skal vi vel Tilflugt tage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Naar han blodig nærmer sig paany!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "»Fader, see! jeg har af Nattens Lue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Frelst Din Kikkert,« lød en barnlig Røst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "»Prøv, om ei Du gjennem den kan skue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "Paa den fjerne Bølge nogen Trøst.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "»Vel! lad see! skjøndt neppe fra det Fjerne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Hjælp kan ventes i den bratte Nød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Vil ei Himlens Magter om os værne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "Kommer før en Times Løb vor Død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "Men hvad seer jeg; skuffer mig mit Øie?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Intet Skib det er paa blanken Søe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "Nei en Kugle svæver i det Høie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "Nærmer sig hist over Ikars Øe!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "»Sophron! lad Dit Syn Dig ei bedrage!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Ak! Umulighed er det, Du troer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "Himmelbudskab ei paa vore Dage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "Dale ned til denne usle Jord.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "»Vist er Synet; rørt af ingen Bølge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Men usynlig baaren, svæver den,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "Og som løftet med den, seer jeg følge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "Under den en Baad med tvende Mænd.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "»Daarer, som for Himlen Jorden glemme!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Fjenden har forladt den øde Bye!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "Lyder heftigt en fortvivlet Stemme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "»Snart I høre vil hans Vaabengnye.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "Men den Rædsel, Tidenden indjager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Viger hastigt for et Glædesskrig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "Nu hvert Øie Luftens Skib opdager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "Troer at himmelsk Redning nærmer sig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "Alt som Synet voxer, Jublen stiger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "Skingrende den naaer Barbarens Hær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "Selv han seer, og rædselslagen viger;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "»Hvad formaaer mod Himlens Magt vort Sværd!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 13,
      "text": "»O! nu vækkes i min Sjæl en Tanke!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "Siger Sophron, »det et Luftskib er,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "Sagn jeg hørte derom af en Franke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "Før jeg tvivled, nu er Vished nær.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "Dog den glædedrukne Flok fornemmer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Lidt kun af den kloge Gubbes Ord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "»Det er Engle,« lyde tusind Stemmer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "»Oldtids Under gjeste vil vor Jord.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 15,
      "text": "Solgyldne Kugle paa Himmelens Ætherblaae!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "Jordiske Øine vist aldrig din Lige saae!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "Engle Du bærer i Skjød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "Da os paa vestlige Himmel en Sol oprandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 15,
      "text": "Natlige Flammer og Anfald og Rædsler svandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 15,
      "text": "Flygted’ den truende Død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "See til vor Øe nu nedsvæve de Evige!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "Lad os modtage dem ydmygt tilbedende!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 16,
      "text": "Hæve lovsyngende Røst!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 16,
      "text": "Glade vi Hænder opløfte mod Himmelen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 16,
      "text": "Qvinden og Manden, Barnet og Oldingen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 16,
      "text": "Alle her sendes jo Trøst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 17,
      "text": "Evige Væsener iførte Støvets Dragt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 17,
      "text": "Frelsende Engle, beklædte med Guddomsmagt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 17,
      "text": "Signer den Samiske Jord!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 17,
      "text": "Svag er den Lov, vi kan bringe paa vores Viis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 17,
      "text": "Lærer os værdigt at synge til Engles Priis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 17,
      "text": "Lærer os himmelske Ord!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 18,
      "text": "»See! med Tegn de af os Taushed kræve!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 18,
      "text": "Vi fornemme skal et Himmelbud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 18,
      "text": "Lad da hellig Stilhed os omsvæve!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 18,
      "text": "Lad i Lyd ei Tanken aandes ud!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 19,
      "text": "»Standser Eders Lovsang! ei tilbeder!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 19,
      "text": "Vi er Støvets Børn, saavel som I,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 19,
      "text": "Glade bragte Redning vi til Eder;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 19,
      "text": "Men som blinde Redskab brugtes vi.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 20,
      "text": "Intetsteds vi noget Budskab hørte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 20,
      "text": "Om den Nød, som trued Eders Land;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 20,
      "text": "Vinden vores lette Luftskib førte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 20,
      "text": "Hurtigt svømmende mod Samos’ Strand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 21,
      "text": "Da vort klare Seerør os lod skue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 21,
      "text": "Mens vi svæved i den høie Skye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 21,
      "text": "Eders Stimmel, og den sidste Lue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 21,
      "text": "Som endnu steg op fra Eders Bye.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 22,
      "text": "Glade saae vi Tyrkehæren vige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 22,
      "text": "Glade gjettede vi Flugtens Grund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 22,
      "text": "Salig Glæde var det at nedstige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 22,
      "text": "Til den lette Hjælp i saadan Stund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 23,
      "text": "Trøst vi bringe fra vort høie Stade!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 23,
      "text": "Øen laae for os i Morgengry;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 23,
      "text": "Paa hvert Punkt maae Fjenden den forlade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 23,
      "text": "Slagen overalt han er paa ny.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 24,
      "text": "Hver til Hjemmet ile nu tilbage;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 24,
      "text": "Meget skaantes end fra Nattens Brand;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 24,
      "text": "Vi paa lette Luftskib Veien tage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 24,
      "text": "Hen mod Østen til et fremmed Land.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 25,
      "text": "Haab og Frygt ved elsket Arnes Fare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 25,
      "text": "Driver Folket mod dets Villie hjem;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 25,
      "text": "Men da svundet er den tætte Skare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 25,
      "text": "Sees en ædel Olding træde frem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 26,
      "text": "»Høie Gjester! I, hvis blotte Skue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 26,
      "text": "Har saa herlig Redning Samos bragt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 26,
      "text": "Evig Tak til Eder her skal lue;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 26,
      "text": "Lad den krænkes ei med Ringeagt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 27,
      "text": "Ei det lette Skib strax Eder bære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 27,
      "text": "Flygtigt bort som Fuglens Vingeslag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 27,
      "text": "Nyder hos os høie Gjesters Ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 27,
      "text": "Dvæler idetmindste her een Dag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 28,
      "text": "Philon er mit Navn, skjøndt ukjendt Eder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 28,
      "text": "Dog i Landet her uhædret ei,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 28,
      "text": "Thi jeg sattes til den første Leder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 28,
      "text": "For den christne Flok paa Sandheds Vei.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 29,
      "text": "Kunde jeg den Gunst af Eder vinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 29,
      "text": "At som Gjester I drog ind hos mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 29,
      "text": "Skulde ved mit Huus et Hædersminde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 29,
      "text": "Bygt af Marmor, derfor reise sig.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 30,
      "text": "»Ædle Biskop vi med Tak modtage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 30,
      "text": "Eders Gjestfrihed, skjøndt altfor stor!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 30,
      "text": "Gjerne til et Fredens Huus vi drage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 30,
      "text": "Trygge der at vexle Venskabs Ord.«",
      "part": false,
      "marginal_notes": []
    }
  ]
}
