  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Milde Gud fader i hiemmelen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "som gaffst din Søn i døden for vore synder/",
      "part": false,
      "marginal_notes": [
        "Corin xv"
      ]
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "och flyde oss alle seyer vinding i hans opstandelse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "wi bede dig ydmygelige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "ath du giffuer oss naade til ath være tacknemmelige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "for saadanne velgerninger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Giff oss vederstyggelighed til det som er emod din Guddommelige vilge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "och naade til ath fuldkomme det som er effter dit hellige bud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "for den samme vor herris Jesu Christi skyld Amen",
      "part": false,
      "marginal_notes": []
    }
  ]
}