{
  "id": null,
  "title": "Herr Bugges Død",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift II",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVII68.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Her Buggi hand bygger op Haldt met ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hand acter den aldrig i fremet mands være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": ":: Hand rider saa frit udaff Iutlandt. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Op Hald met ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "hand acter den aldrig i fremmit mandtz være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Her Buggi sidder offuer sin breden bordt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "koningen aff Danmarck sender hannem ordt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "\"I beder hannem snarlig til mig komme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "finde oss i Otthensse i same stunde!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "Ind kom der bud och stedis for bord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "\"Min naadige herre haffuer send ether ordt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "Hand bad, i skulle snarlig til hannem komme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 4,
      "text": "i Otthense skulde i hans naade finde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 5,
      "text": "Her Buggi hand rader met hustru sin:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 5,
      "text": "\"Skal ieg drage til koningen henn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "\"Her Buggi, i giører, som ieg ether beder:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 6,
      "text": "i drager til Hald, holder den met ære!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 7,
      "text": "I setter ether bord met gode hoffmendt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 7,
      "text": "i tror icke paa hans leeding och endt!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 8,
      "text": "Her Buggi lyde paa sin frues ord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 8,
      "text": "hand sende koningen bud emodt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 9,
      "text": "\"Her paa Hald vil ieg hannem bide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 9,
      "text": "huad eller hand vill storme eller stride.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 10,
      "text": "Ind kom der budt, sagde koningen saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 10,
      "text": "huad ord hand aff her Buggi mone faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 11,
      "text": "Tha slo kongen sin haand emod bordt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 11,
      "text": "\"Det angrer her Buggi, det hør ieg nu.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 12,
      "text": "Koningen sende hannem bud igien:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 12,
      "text": "\"I beder hannem komme och ver ey sien!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 13,
      "text": "Vill hand mig icke tro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 13,
      "text": "min søster-sønner sender ieg hannem baade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 14,
      "text": "Och vil hand icke min liede tro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 14,
      "text": "min søster-sønner skall gissel staa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 15,
      "text": "Kongens bud kom til her Buggi brat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 15,
      "text": "att hand skulle komme till kongen snart.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 16,
      "text": "Kongen sende bud til Medelfar indt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 16,
      "text": "bad, de skulle ride her Buggi igienn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 17,
      "text": "\"Førind de lader her Buggi undgaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 17,
      "text": "da bed thennem thage min søster-søner bode!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 18,
      "text": "Her Buggi hand saae de breffue saa brat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 18,
      "text": "hand red till kongen udi samme natt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 19,
      "text": "Hans frue hun gred, och hender hun strøg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 19,
      "text": "for hand lyde icke hindis raadt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 20,
      "text": "Her Buggi hand ind for kongen tren,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 20,
      "text": "dan-kongen stod hannem op igien.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 21,
      "text": "Lenge stod her Buggi och tencte met sig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 21,
      "text": "\"Hui monne min herre staa op mod mig?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 22,
      "text": "Kongen fick hannem sin haandt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 22,
      "text": "\"Huor staar nu i Nør-Iutlandt?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 23,
      "text": "Saa drack de i dage fem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 23,
      "text": "her Buggi gaff sligt ey udi gienn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 24,
      "text": "Her Buggi hand skulle til Iutland fare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 24,
      "text": "da bad hand koningen følge i skare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 25,
      "text": "Kongen suarde, hand kunde icke fare:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 25,
      "text": "\"Min søster-sønner skulle paa hannem vare.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 26,
      "text": "Her Buggi hand kom paa Medelfar-gade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 26,
      "text": "da møder di borgere, vor kled i plade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 27,
      "text": "Der møtte de bode til hest och fod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 27,
      "text": "alle vor de her Buggi emodt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 28,
      "text": "For rider koningens søster-sønner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 28,
      "text": "de vogit deris liff som erlig mendt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 29,
      "text": "De Medelfar-mend Gud giffue dennem træd!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 29,
      "text": "di vog her Buggi i felig leidt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 30,
      "text": "De vog her Buggi, den velbyrdig mandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 30,
      "text": "och der-til koningens søster-sønner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 31,
      "text": "Snart kom bud til Halds porte:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 31,
      "text": "\"Hind guode her Buggi hand er alt borte.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 32,
      "text": "Fru Ingeborrig slo hender samell:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 32,
      "text": "guld-ringe de stunck emod skamell.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 33,
      "text": "Frue Ingeborrig slo hindis hender mod bord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 33,
      "text": "\"Nu tør mand ey tro paa kongens ordt!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 34,
      "text": "Hun holt Hald it aar eller saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 34,
      "text": "meer kand ieg icke sige fra.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 34,
      "text": ":: Der de rider saa fri udaff Iutlandt. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}