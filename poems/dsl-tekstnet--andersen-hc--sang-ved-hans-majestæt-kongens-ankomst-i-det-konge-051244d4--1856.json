{
  "id": null,
  "title": "Sang ved Hans Majestæt Kongens Ankomst i det Kongelige Theater den 8de October 1856",
  "year_created": 1856,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1856,
    "url": "https://tekstnet.dk/books/andersen-hc_sang-ved-hans-majestaet-kongens-ankomst-i-det-kongelige-theater-den-8de-october-1856/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Blandt Nordens Lande Danmark er en Have,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Saa frodig frisk med dybe blanke Söer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Om Oldtids Stordaad mæle Kjæmpegrave,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Og Nutid selv har Klang, som aldrig döer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Ved Meiselslag, ved Skjaldes Sang vi kjendes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Ved Folkets Sammenhold, Soldatens Mod;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "I Kjærlighed er Styrke, den ei endes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Her, den i Drot og Folk har samme Rod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Det löfter Sindet: her er godt her hjemme!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "»Danmark og Dansk,« de Ord er som Musik!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "O Konge, Du vil alt det Godes Fremme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Hvo er meer dansk, end Du Kong Frederik!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "God Gjerning gjör saa lykkelig tilmode,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "I den Tilfredsheds skjönne Roser groe!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Velsignelse der er i alt det Gode,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Velsignelse i Sammenhold og Tro!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Paa Festens Dag klart straaler Blus og Kerte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Ja Glædens Ild – og Øiet har just den,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Livs-Sundhed gjennemströmme rigt Dit Hjerte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Til det den ringe Mand saa trygt gaaer hen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Gud glæde, styrke Dig i Alvors Dage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Gud lönne Dig i Villiens gode Færd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Gid Du see Danmarks Herlighed tiltage;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Og Korn og Blomster slynges om hvert Sværd!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
