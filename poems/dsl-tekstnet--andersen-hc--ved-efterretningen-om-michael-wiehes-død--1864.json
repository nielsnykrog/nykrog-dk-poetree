  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Det er en Trængsels Tid med Tab paa Tab;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Mens Blod er flydt og Blod er til at græde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Gaaer Døden frem mod Konst og Videnskab,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Det Danevirke med sin Fod at træde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Vor Herlighed Een efter Anden Døer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Ydmygede og smaa vi staae tilbage;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Der ruller over Danmark tunge Søer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Farvel, I Storheds Svaner, som bortdrage!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
