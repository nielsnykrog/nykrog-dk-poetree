{
  "id": null,
  "title": "Östergade, poetisk betragtet",
  "year_created": 1830,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Digte",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1830,
    "url": "https://tekstnet.dk/books/andersen-hc_digte-1830/044/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "»Wandl’ im Grünen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Willst Du die Blumen verstehn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Mußt Du erst den Wald durchgehn.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Det hele Liv, ret som det staaer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Og gaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Kan findes paa en simpel Promenade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Igjennem Østergade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "– Først stirre vi med Barnets Drømmeblik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Paa al den smukke Stads i Hois’s Boutik.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "O hvilken Verden! skjøn og underfuld;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Hvor straaler den med deiligt Glimmer-Guld!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Ja Alt er Strængespil, fra Faar til Nattergalen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Selv Hestene man seer med Pibe midt i Halen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Vi drømme os en evig Blomster-Mai, –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Men Klokken slaaer paa Nicolai;;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Rask trækker Tiden os i Barne-Kjolen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Vi maae i Skolen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "I Efterslægten sidde vi paa Bænken,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Nu skal man lære lidt fornuftig Tænken,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Beklappes smukt med Viisdoms Ferle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Til en Examens Perle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "Saa dimitteres vi til Brummers Stue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "Rundt om vi skue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "En Mængde – stive Bind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 1,
      "text": "Af Svinelæder, Pap og Kalveskind;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 1,
      "text": "Ret smukke Folk, men tørre – Jammerskade!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 1,
      "text": "Thi Livet vinker – – – ud paa Østergade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 1,
      "text": "– Brogede Vrimmel!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 1,
      "text": "Oppe sig hvælver den skyklare Himmel;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 1,
      "text": "O hvilket Liv! ha, lystig og fro!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 1,
      "text": "Skilles og mødes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 1,
      "text": "Puffes og stødes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 1,
      "text": "Slide paa Livet, paa Støvler og Skoe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 1,
      "text": "Flagrende Baand og flagrende Qvinder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 1,
      "text": "Sminkede Hjerter og sminkede Kinder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 1,
      "text": "Heste paa fire, og Heste paa to;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 1,
      "text": "Fromme Matroner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 1,
      "text": "Bitte Baroner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 1,
      "text": "Riigmand og Tigger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 1,
      "text": "Lystigt i Drosker, Kareter og Gigger;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 1,
      "text": "Alle vil larme;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 1,
      "text": "Gud sig forbarme!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 1,
      "text": "Heden os qvalte med Haar og Skind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 1,
      "text": "Gjorte ei Damerne Vind. –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 1,
      "text": "Her en Frugthandler",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 1,
      "text": "Vinker med Æbler, Rosiner og Mandler,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 1,
      "text": "Svulmende Druer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 1,
      "text": "Ak Hjertet luer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 1,
      "text": "Det kriller saa sært i Marv og Been,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 1,
      "text": "Man føler sig blive en løierlig Een.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 1,
      "text": "Man snakker om Længsel i sit Bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 1,
      "text": "Om Silke som Blaae-Violer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 1,
      "text": "Om Sølverskyer og Lysets Kyst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 1,
      "text": "Samt Smertens Piil og Pistoler,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 1,
      "text": "Og før man har sig ret selv beseet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 1,
      "text": "Er man Poet. –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 1,
      "text": "Electrisk gnistrer Haaret;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 1,
      "text": "Ind paa Aviscontoiret",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 1,
      "text": "Man styrter nu. Høit strutte alle Lommer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 1,
      "text": "Af Digterblommer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 1,
      "text": "– Saa gaaer det fort i Ungdoms glade Flugt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 1,
      "text": "Alt er saa smukt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 1,
      "text": "I Harmonie det store Hele svinder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 1,
      "text": "Fra Skraldemanden til de ni Gudinder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 1,
      "text": "Men som man allerbedst paa Flisen dandser,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 1,
      "text": "Man standser.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 1,
      "text": "Hos Jürgensen bag Rudens Glar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 1,
      "text": "Man bliver vaer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 1,
      "text": "En Mængde Uhre; hvert os minder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 1,
      "text": "At Tiden svinder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 1,
      "text": "At som vi bedst vil nyde Promenaden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 1,
      "text": "Staae vi ved Enden alt af Gaden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 1,
      "text": "Forskrækket i vort Sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 1,
      "text": "Vi falde strax paa Apotheket ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 1,
      "text": "Beværte Sjæl og Krop med Draaber og med Piller,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 1,
      "text": "Kort sagt, man stiller",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 1,
      "text": "Sit Febergys med saadant Slikkeri,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 1,
      "text": "Og hopper fort – – men det er snart forbi;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 1,
      "text": "Vi staae ved Gadens Ende;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 1,
      "text": "Paa Hjørnet kan vi kjende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 1,
      "text": "Som Tidens Billed, mutationum mater,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 1,
      "text": "Komedie Placater.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 1,
      "text": "Hver Dag man spiller,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 1,
      "text": "Der vexle sært Tragedier og muntre Vaudeviller.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 1,
      "text": "– Nu staae vi her, i Kjole eller Trøie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 1,
      "text": "Det store Ny-Torv ligger for vort Øie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 1,
      "text": "Vi see Theatretvel, men vide ikke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 1,
      "text": "Hvad vore Blikke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 1,
      "text": "Skal bag det store, dunkle Forhæng skue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 1,
      "text": "I magisk Lue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 2,
      "text": "Vi grunde – – ak! kun kort er her vort Stade;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 2,
      "text": "Et Skridt – og saa – Farvel vor Østergade!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
