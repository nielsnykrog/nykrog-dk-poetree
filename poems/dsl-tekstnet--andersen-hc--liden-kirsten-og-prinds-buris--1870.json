{
  "id": null,
  "title": "Liden Kirsten og Prinds Buris",
  "year_created": 1870,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
