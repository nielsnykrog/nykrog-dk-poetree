  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1870,
    "url": "https://tekstnet.dk/books/andersen-hc_liden-kirsten-og-prinds-buris/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Der var en Duft af det friske Hø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Og Luften var klar som den stille Sø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "En deilig Stjerne funklede i Øster.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Med Kind mod Kind to Lykkelige sad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Ret som i Rosen sidder Blad ved Blad;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Det var Prinds Buris og Kongens Søster.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Et Kys, endnu eet, saa skiltes de ad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "En Drossel fløited’ sit Elskovs-Qvad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "I Pragt, med bitter Frugt stod Tjørnehækken;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Dugdraaben faldt som Taare ned i Bækken.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "En Midnat var det, med Vold og Magt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Prinds Burisblev blindet, i Lænker lagt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Mens lystig Musik lød fra Slottets Sale.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Der dandsed’ en Qvinde med Skarlagens Flig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Valdemars Søster, bleg som et Liig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Som det skarpe Sværd faldt Kongens Tale:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "»I Dandsen groer Kinden nok frisk og rød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Som Konge-Rosen, Prinds Buris brød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "For Sladderens Gift jeg udsletter din Brøde!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "– Og Kongen dandsed’ sin Søster tildøde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Et Fangetaarn var der ved ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Der jordede man Liden Kirstens Liig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Hvidtjørnen sin Blomst paa Graven lagde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Hver Aften aabnedes Taarnets Dør,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Og ud kom en Blind, saa svag som et Rør;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Fra Fængslet til Graven hans Lænke rakte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Om denne Naade han Kongen bad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Og Duggen som Taarer faldt fra hvert Blad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Paa Kirstens Grav brast Buris’s Hjerte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "– Et Sagn, en Sang er nu hiin Elskovs Smerte.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
