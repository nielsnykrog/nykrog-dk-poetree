    "year_published": 1854,
    "url": "https://tekstnet.dk/books/andersen-hc_af-samlede-skrifter-femtende-bind/009/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Naar Bølgerne dandse om Merset lidt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Og synge, saa Plankerne knage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Naar Skroget bliver for Roret qvit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Saa har vi kun Lidt tilbage;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Men tager Søen den hele Klat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Ja saa god Nat!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Saa seile vi Alle derneden om,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Men den Vei Mange til Himlen kom.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Naar Stormen i Land jager vildt afsted,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Og Torden og Lyn er i Følge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Den knækker Egen; – dog den Fortræd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Er værre paa Dybets Bølge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Matrosen er vant til det Vaade vel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "– Det slaaer ihjel! –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "I Glaskiste ligger han da saa smukt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Hans Øie og Kistens Laag er lukt!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
