  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Herre Gud som bør ath heffne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "O Gud som bør at heffne/ lad dig nu see",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Forhøye dig O Dommere paa Jorden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "betale de hofferdige effter deris forskyldning",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "O Herre huor lenge skulle de wgudelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "huor lenge skulle de wgudelige saa prale.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Hui skulle de saa bryde aff sig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "och tale saa fortredelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "Hui skulle de saa braske/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "alle som synde oc gøre ilde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 5,
      "text": "O Herre dit folck fortrenge de/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "oc din Arff fortrycke de",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 6,
      "text": "De myrde Viduer oc vdlendige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "och ihiel sla de Faderløse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 7,
      "text": "De sige ath Gud seer det icke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "oc ath Jacobs Gud acter det icke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 8,
      "text": "Ath gribe forstand i gecke blant folcket",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "oc i Daarer naar ville i vorde kloge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 9,
      "text": "Skulde han icke høre som haffuer skabt øret/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "Skulde han icke see som haffuer giort øyet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 10,
      "text": "Skulde han icke straffe/ som kan plage Hedninge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 10,
      "text": "han som lærer Menniske det som de vide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 11,
      "text": "Ja Gud kender vel Menniskens tancker/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 11,
      "text": "at de ere forfengelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 12,
      "text": "O Gud salig er den mand som du reffser/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 12,
      "text": "oc lærer all din Lou",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 13,
      "text": "Ath han kan vere tolmodig i de onde dage/ ind til Graffuen bliffuer bered for de wgudelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 14,
      "text": "Thi Herren vil icke forskyude sit folck",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 14,
      "text": "oc ey forlade sin arff or eyedom",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 15,
      "text": "Thi Retferdighed kommer vel igen til rette/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 15,
      "text": "oc den effterfølge alle de som ere aff hiertet retskabne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 16,
      "text": "Huo vil træde mig emod de vdediske/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 16,
      "text": "huo vil staa hoss dennem som gøre ilde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 17,
      "text": "Vden Gud vaare selff min hielpere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 17,
      "text": "da vaare min Siæl fuld nær bleffuen stille",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 18,
      "text": "Der som ieg sagde min Fod glider/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 18,
      "text": "Herre da styrckede mig din fromhed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 19,
      "text": "Naar ieg haffuer megen vduertis bekømrelse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 19,
      "text": "da huiler min Siæl sig ved din fortrøstning",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 20,
      "text": "Thi huad skulde det skalckactige parti haffue met dig at skaffe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 20,
      "text": "som haffuer for seed at fare icke wden met offueruold",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 21,
      "text": "De fordriste dem megit mod den retferdige mandzsiæl/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 21,
      "text": "oc fordømme wskyldigt Blod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 22,
      "text": "⁕ Men Herren er mig til en beskermelse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 22,
      "text": "och min Gud en Klippe/ der ieg maa haffue min tilfluct til",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 23,
      "text": "⁕ Oc han skal betale dem for deris ondskaff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 23,
      "text": "oc i deris Synder han skal forderffue dem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 23,
      "text": "Ja vor Herre Gud han skal forderffue dem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 24,
      "text": "Gud Fader Søn oc den Helligaand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 24,
      "text": "Ske priss oc ære i allen stund",
      "part": false,
      "marginal_notes": []
    }
  ]
}