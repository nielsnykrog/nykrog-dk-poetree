    "year_published": 1739,
    "url": "https://tekstnet.dk/books/brorson-ha_troens-rare-klenodie/181/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Lær mig, hvordan jeg skal dig, JEsu, finde,",
      "part": false,
      "marginal_notes": [
        "Speaker: Sielen."
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Hvordan jeg mig ved dig kand overvinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Fra, hvad mit eget er, forløst at blive,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Og hvad sig søger selv, at overgive.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Stat i hengivenhed opofret stille,",
      "part": false,
      "marginal_notes": [
        "Speaker: JEsus."
      ]
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Og efterlev med fliid min gode ville,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Dig overgiv mig plat i fryd og plage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "At intet dig formaaer fra mig at drage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Hvor kand jeg arme orm saaledes blive?",
      "part": false,
      "marginal_notes": [
        "Speaker: Sielen."
      ]
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Hvor kand jeg mig saa plat dig overgive?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "Din villeskal du mig til offer bære,",
      "part": false,
      "marginal_notes": [
        "Speaker: JEsus."
      ]
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "Min ville skal din roe allene være,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 4,
      "text": "Din siel du grundig ned i mig skal senke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "Saa har jeg dig i mig stor kraft at skenke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 5,
      "text": "Naar jeg saaledes, dig hengiven, lever,",
      "part": false,
      "marginal_notes": [
        "Speaker: Sielen."
      ]
    },
    {
      "id": 15,
      "stanza_id": 5,
      "text": "Og over alting, som i luften, svever,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "Hvorledes skal jeg det saa siden giøre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "At du dit billed kandst i sielen føre?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 6,
      "text": "Lad hiertets grund af Gud først ret beredes,",
      "part": false,
      "marginal_notes": [
        "Speaker: JEsus."
      ]
    },
    {
      "id": 19,
      "stanza_id": 6,
      "text": "Og fra dig selv gak ud, af ham at ledes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "Behold dig intet for i nogen maade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 6,
      "text": "Som ikke virkes af min kraft og naade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 7,
      "text": "Hvad skal jeg siden da i mig fornemme,",
      "part": false,
      "marginal_notes": [
        "Speaker: Sielen."
      ]
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "Naar jeg er hos mig selv som ikke hiemme?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 7,
      "text": "Skal jeg da ikke snart dig i mig finde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 7,
      "text": "At du med mig dig vil ret nær forbinde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 8,
      "text": "Naar jeg til saadan stand vil veyen bane,",
      "part": false,
      "marginal_notes": [
        "Speaker: JEsus."
      ]
    },
    {
      "id": 27,
      "stanza_id": 8,
      "text": "Da har jeg mestendeels den viis og vane,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 8,
      "text": "Alt hvad jeg givet har, jeg fra dig tager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 8,
      "text": "Saa staaer du raadvild der i alle sager.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 13,
      "text": "O JEsu! lær mig, at jeg ret dig favner,",
      "part": false,
      "marginal_notes": [
        "Speaker: Sielen."
      ]
    },
    {
      "id": 31,
      "stanza_id": 13,
      "text": "Forkaster verden heel, som jord og avner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 13,
      "text": "At jeg, om aaben stod Guds himles sæde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 13,
      "text": "Dog uden dig derind ey vilde træde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 14,
      "text": "Følg du kun efter mig, min bruud og due,",
      "part": false,
      "marginal_notes": [
        "Speaker: JEsus."
      ]
    },
    {
      "id": 35,
      "stanza_id": 14,
      "text": "Saa skal du i mig stor forundring skue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 16,
      "text": "Jeg legger mig da ned i haabet stille,",
      "part": false,
      "marginal_notes": [
        "Speaker: Sielen."
      ]
    },
    {
      "id": 37,
      "stanza_id": 16,
      "text": "Og venter, hvad der er din gode ville,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 16,
      "text": "Døe vil jeg fra mig selv og alle gaver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 16,
      "text": "Nok, naar jeg kun min Gud allene haver.",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
