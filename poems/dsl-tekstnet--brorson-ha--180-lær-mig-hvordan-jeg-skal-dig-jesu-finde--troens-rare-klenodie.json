{
  "id": null,
  "title": "180. Lær mig, hvordan jeg skal dig, JEsu, finde",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
