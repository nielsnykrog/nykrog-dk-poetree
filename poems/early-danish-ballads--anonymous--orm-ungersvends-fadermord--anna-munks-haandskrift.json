    "place": null,
    "year_published": 1591,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/MUNK34.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "En Anden Vise |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 1,
      "text": "Det tha var then gamle | Greffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "hanndt vogner Om midinatt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "da tholde hanndt Sÿnn Stercke | drøm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": ":: Aff Iudlanndt. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "Mig Tøckthe som ieg paa vanndett var, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "huos dig allerkieriste minn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "der kom | Enn Orm skridenndis",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "hannd vilde mig | fredenn formenne. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "Mig haffuer drømpt Saa wnnderlig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "buode Skiøtt och obene-bratt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "der | kom enn Orm aff dinn barm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Saa | ÿlde hanndt mig Stack. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "I leger eder neder minn Edelig herre, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "ÿ giffuer dett icke ÿgienn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "ÿ femthenn Och Tiuffue vinnther",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "da | stannder Enn Sønndags drøm, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "Somme dÿ stannder ÿ Trødue vennther",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "och Somme icki vdenn itt Aar, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 5,
      "text": "Som menndt vedt Stalthe fru metthelille",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "fordj Sørger ieg Saare. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 6,
      "text": "Thett vor icki lanngtt ther-effther, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 6,
      "text": "hun fick saa stuor enn harm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 6,
      "text": "hun | fandt da wormen hinn wnger-Suend |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "war queg ÿ hinndis barm |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 7,
      "text": "Hunn thett hulde och hunn thett dulde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 7,
      "text": "saa | vell monne hunn dett giemme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 7,
      "text": "hunn vilde | icke lade dett greffuenn viide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "for sÿnn stercke drøme, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 8,
      "text": "Fru Metthelille gannger ÿ hÿffuennlofftt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 8,
      "text": "altt | mett saa mannge liste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 8,
      "text": "der føde hunn enn | Sønn saa guodt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "Saa græffuenn dett icki | viste. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 9,
      "text": "Fosteritt hunn hannem ÿ vinter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 9,
      "text": "och vell | ÿ vinnther nÿe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 9,
      "text": "denn gamle greffue hanns | fader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "fick hannom icki att See. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 10,
      "text": "Thett var stalthe fru metthelille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 10,
      "text": "hunn liger | dett guldt ÿ skrinn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 10,
      "text": "Sennder hunn ha-nom thill Enngelanndt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "thill kiere morste | Sinn |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 11,
      "text": "Hunn Sennder hannom thill sÿnn morster |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 11,
      "text": "droninngenn ÿ Enngelanndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 11,
      "text": "der var hand | ÿ vinnther nÿe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "ham gick saa vell ÿ haand |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 12,
      "text": "Ther var hanndt ÿ vinnther nÿe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 12,
      "text": "och buode | mett Tuct och Ere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 12,
      "text": "konngenn och Engelanndz droninng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "thÿ haffde hannom saa | kiere |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 13,
      "text": "Hanndt thog droninngenn ÿ sÿnn Arm",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 13,
      "text": "hand | klapett hennder ved sÿnn kinndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 13,
      "text": "dett | Saa Enngelanndz konnge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 13,
      "text": "hanndt bleff | Saa vredt ÿ Sinndt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 14,
      "text": "Thett spurde Ormenn hinn vnngersuend |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 14,
      "text": "att konngenn hanndt dett saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 14,
      "text": "hand lod | sig pilegrims-kleder skiere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "hannd monne | aff lannditt gaa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 15,
      "text": "Hanndt lodt skiere sÿg pilegrims-kleder, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 15,
      "text": "och staffuenn ÿ sÿnn haanndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 15,
      "text": "Saa | gaar hanndt denn Lannge veÿ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 15,
      "text": "hiem | thill sÿnn faders lanndt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 16,
      "text": "Ther hannd kom ÿ sinn faders lanndt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 16,
      "text": "saa liditt viste hanndt aff quide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 16,
      "text": "handt | kiøffthe sÿg hest thog dannesuenne ann, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 16,
      "text": "hiem thill sÿnn moder att riide. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 17,
      "text": "Thett war vorum hinn vnnge-suendt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 17,
      "text": "hanndt kom ther ridenndis ÿ gaardt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 17,
      "text": "vde Stodt hanns kiere moder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 17,
      "text": "hun | var vell Suøbtt ÿ mordt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 18,
      "text": "Vell-komenn Orum hinn vnnge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 18,
      "text": "och kiere | Sonne minn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 18,
      "text": "huor liider Droninngenn ÿ | Enngelanndt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 18,
      "text": "Och kiere morsøster dinn. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 19,
      "text": "Vell tha liider dennom buode,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 19,
      "text": "Suaridt handt | Saa bratt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 19,
      "text": "Som menndt vedt minn kiere | moder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 19,
      "text": "thÿ sagde Eder thusinndt guodnatt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 20,
      "text": "Thett var hanns kiere moder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 20,
      "text": "hunn hanom | ÿ armenn thog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 20,
      "text": "vde stodt denn gamle greffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 20,
      "text": "och saa hanndt der-opaa. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 21,
      "text": "Thett tha melthe denn gamle greffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 21,
      "text": "och | saa tog hanndt opaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 21,
      "text": "huem tha var den | fremmede Suenndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 21,
      "text": "Som du ÿ armenn thog. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 22,
      "text": "Thett var stalthenn fru metthelille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 22,
      "text": "hun melthe itt Ord mett Ere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 22,
      "text": "thett er vormenn | hinn vnnger-Suenndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 22,
      "text": "hanndt begis vor søn | monne verre. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 23,
      "text": "Thett var vorum hinn vnnge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 23,
      "text": "hanndt vredis ved dÿ ordt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 23,
      "text": "hanndt drog vdt sÿtt | guode Suerdt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 23,
      "text": "hanndt Slog sÿnn fader | thill Iordt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 24,
      "text": "Lennge stodt stalthenn frue mettelille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 24,
      "text": "hennde | tøckthe dett verre Stuor møde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 24,
      "text": "Saa saare | daa ranndt hennder thorre paa kinndt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 24,
      "text": "hun Saa Sÿnn herre døde. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 25,
      "text": "Nu haffuer ieg veÿett minn fader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 25,
      "text": "och eder | der-medt giortth harm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 25,
      "text": "nu ville ieg | slaa mig Sielff ÿhiell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 25,
      "text": "Och lege mig | ÿ hanns Arm. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 26,
      "text": "Thu thÿe kuer Ormenn hinn vnnge-Suenndt | ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 26,
      "text": "Och sige thu icki saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 26,
      "text": "Thu skalt | dig buortt gannge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 26,
      "text": "Och Schriffthemol | skalthu thage. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 27,
      "text": "Saa lodt hun rede Enn Spidalsdrick |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 27,
      "text": "thenn gaff hunn hannom att dricke, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 27,
      "text": "Saa loffuitt hunn hannom saa Sandelig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 27,
      "text": "thett hannom skulde aldrig skee | lÿcke. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 28,
      "text": "Nu haffuer thu druckitt enn spidals-drick | ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 28,
      "text": "dig falmer buode haanndt och | foedt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 28,
      "text": "var alle dÿ mester ÿ verdenn | ere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 28,
      "text": "dÿ kunnde icki raade dig boedt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 29,
      "text": "Thett var dig bedre for dÿnn Siell",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 29,
      "text": "Enndt | thu dig sielff skulde døde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 29,
      "text": "nu mottu gannge | menns du kanndt leffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 29,
      "text": "dine Sÿnnder | maa thu bøde. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 30,
      "text": "Hanndt thog Staffuenn ÿ sÿnn hanndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 30,
      "text": "handt | monne fra sÿnn moder gannge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 30,
      "text": "hanndt Setthe | Sig offuer Enngelanndz kongis bord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 30,
      "text": "buode | mett Sorrigh och thuannge. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 31,
      "text": "Thett melthe Enngelanndz droning,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 31,
      "text": "Saa | tog hunn paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 31,
      "text": "huem haffuer bedett den | Spidalske manndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 31,
      "text": "thill voris bordt att | gaa. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 32,
      "text": "Tha lodt hanndt sÿg kiennde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 32,
      "text": "och Suaritt | hannd hinnder saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 32,
      "text": "Ieg er icki anndenn spidalske manndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 32,
      "text": "Enndt thenn ÿ ÿ eders | arum thog. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 33,
      "text": "I tog mig ÿ eders fosterlig arum",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 33,
      "text": "thett sÿger | ieg paa minn thro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 33,
      "text": "dett tøckthe mig saa | ÿlde att verre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 33,
      "text": "ÿ skulde liide Sorrig derfor. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 34,
      "text": "Saa drog ieg mig aff lannden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 34,
      "text": "ieg frøctett | eders herre var vredt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 34,
      "text": "thett vill Ieg | forsanndenn siige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 34,
      "text": "mig sielff thill anngist | och vee |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 35,
      "text": "Thøckthe diig thett Saa ÿlde att verre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 35,
      "text": "ath | ieg skulde verre dig vredt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 35,
      "text": "skulde det | haltt mitt rige koste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 35,
      "text": "tha lader ieg digh | helbrett giøre. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 36,
      "text": "Thett var Enngelanndz koninng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 36,
      "text": "hand | leger thett guldt ÿ skrinn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 36,
      "text": "Saa Sennde | hanndt hannom thill viise menndt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 36,
      "text": "alt | offuer thenn Salthe Riinn. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 37,
      "text": "Saa da bleff hanndt helbrett giordt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 37,
      "text": "hanndt bleffue enn hellett saa finn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 37,
      "text": "dett | var Enngelanndz koninng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 37,
      "text": "hanndt gaff | hannom Søster Sÿnn. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 38,
      "text": "Nu haffuer vormenn hinn vnnge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 38,
      "text": "forvonndenn all sÿnn harum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 38,
      "text": "hanndt er sÿg | Enn veldige konnge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 38,
      "text": "Soffuer ÿ Kongens | Søsters Arum. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 39,
      "text": "Hanndt Soffuer Sig Saa gladelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 39,
      "text": "ved | konngenns søsters side,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 39,
      "text": "huadt lÿcke gudt | haffuer en mandt forseett,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 39,
      "text": "handt skal den | viszelig biide. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 40,
      "text": "Huadt lÿcke gud haffuer en mandt forseett,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 40,
      "text": "dett | skall hannom offuergannge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 40,
      "text": "derfor bleffue | Orum hinn vnge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 40,
      "text": "Sÿnn kiere faders bane, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 40,
      "text": ":: Aff Iudlanndt. | ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}