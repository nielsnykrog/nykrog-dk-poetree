  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Kommer til mig sagde Guds Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "som ere besuaret huer oc en/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "met synden hart beladen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "vnge oc gamle/ quinde oc Mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "ieg vil eder vederquege forsant/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "oc hele eders skade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Mit aag er søt/ min byrde er læt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Huo den bær oc mig følger ret/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Helffuede skal hand vnduige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Jeg vil selff met hannem bære saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "At hand ved min hielp vist skal faa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Det euige Himmerige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Min gierning oc det Kaarss ieg bar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Den stund ieg her i liffue vaar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Det følger Aarle oc silde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Alt huad i tencke tale oc giør/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Det bliffuer gaat som det sig bør/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Naar det skeer effter Guds villie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Huo sit Kaarss ey tager paa sig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Oc i min fodspor følger mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "Til liffuit skal hand ey gange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Thi den ieg reffser haffuer ieg kier/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "Jeg ihielslar oc ieg leffuendis giør/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Gennem kaarssit i æren fange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Endog i monne her hyle oc græde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 4,
      "text": "Oc Verden sig kand fryde oc glæde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 4,
      "text": "Til glæde skal det eder vorde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 4,
      "text": "Giør du ellers Anger for din synd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Der met du mig saa mangelund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "Suarlig fortørne torde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 5,
      "text": "Kalde paa mig i din modgangs tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 5,
      "text": "J gudelig bøn oc fast tillid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 5,
      "text": "Oc stadelig paa mig haabis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 5,
      "text": "Jeg vil dig trøste vdi din nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 5,
      "text": "Fri dig fra Dieffuelens suare anstød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Saa ieg kand aff dig loffuis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 6,
      "text": "Det ieg dig Kaarssit monne paaføre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 6,
      "text": "For din skade ieg det icke giør:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 6,
      "text": "Fra det onde vil ieg dig drage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 6,
      "text": "Fra kiødelig tryghed oc syndsens meen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 6,
      "text": "Til Christeligt leffnit i troen reen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 6,
      "text": "At du vndgaar euig plage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 7,
      "text": "Gierne vilde Verden salig være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 7,
      "text": "Skulde hun ey den suare pine bære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 7,
      "text": "Den alle Christne her lide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 7,
      "text": "Men det icke andet være vil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 7,
      "text": "Der for giff dig der villig til/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 7,
      "text": "Vilt du vndgaa euig quide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 8,
      "text": "All Creatur vidnisbyrd bær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 8,
      "text": "Som i Haffuit oc paa Jorden er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 8,
      "text": "Sin plage kand det ey vndgange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 8,
      "text": "Huem det i Guds naffn icke vil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 8,
      "text": "Skal endelig taale Dieffuelens spil",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 8,
      "text": "Met samuittighed hin bange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 9,
      "text": "Gennem time glasset saa løber det sand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 9,
      "text": "Oc boblen falder paa klaren vand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 9,
      "text": "Opblest i samme stunde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 9,
      "text": "Mennisken falder saa i Dødsens tuang/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 9,
      "text": "Hans værelse er her icke lang/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 9,
      "text": "Hand falder bort sammelunde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 10,
      "text": "J dag er Mennisken karsk oc sund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 10,
      "text": "J morgen siug oc suag mangelund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 10,
      "text": "Snart Døden hannem monne kryste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 10,
      "text": "Som blomsteren visner i grønen Eng/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 10,
      "text": "Saa snart oc Verdsens praal bliffuer endt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 10,
      "text": "Saa hastelig falder oc bryster.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 11,
      "text": "Verden frycter for den timelig død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 11,
      "text": "Men naar mand ligger i siste nød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 11,
      "text": "Da vilde huer først from vorde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 11,
      "text": "Den ene giorde det/ den anden det/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 11,
      "text": "Deris arme Siel monne de forgæde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 11,
      "text": "Den stund de leffde paa Jorden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 12,
      "text": "Naar mand icke lenger leffue kand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 12,
      "text": "Da beklager sig først mangen mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 12,
      "text": "Vil sig da til Gud giffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 12,
      "text": "Jeg frycter sandelig at Guds naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 12,
      "text": "Som hand stedse spottelig haffuer forsmaad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 12,
      "text": "Vil neppelig offuer hannem bliffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 13,
      "text": "Den Rige hielper ingen stat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 13,
      "text": "Den vnge mands mod falder her saa brat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 13,
      "text": "Hand maa dog aff dette grøne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 13,
      "text": "Haffde en end all Verden i vold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 13,
      "text": "Huer pennings verd aff Sølff oc Guld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 13,
      "text": "J dantzen maa hand dog trine.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 14,
      "text": "Her hielper ey Lærdom eller konst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 14,
      "text": "Ey verdslig pract ey Herre gunst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 14,
      "text": "Døden bliffuer alles ende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 14,
      "text": "Den her ey Christum haffuer til ven/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 14,
      "text": "Den her ey giøris aff Synden reen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 14,
      "text": "Til euig pine bortsendis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 15,
      "text": "Thi er eder Modgang merckelig god",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 15,
      "text": "Oc giøret at i met sorrigfuld mod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 15,
      "text": "Eders synd oc Ondskab bekiende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 15,
      "text": "Oc bede Gud om forladelse blid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 15,
      "text": "At i kunde i en salig tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 15,
      "text": "Skillies fra dette ælende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 16,
      "text": "J Guds børn hører oc mercker ret/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 16,
      "text": "Som eder i Guds vold giffue slet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 16,
      "text": "Fortryder icke den møde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 16,
      "text": "Men Guds ord stedse beholder vel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 16,
      "text": "Som trøster eder til liff oc Siel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 16,
      "text": "Gud vil eder trøste oc glæde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 17,
      "text": "J skulle ey ont for det onde giffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 17,
      "text": "Seer til at i her wskyldig leffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 17,
      "text": "Lader Verden eder men klaffe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 17,
      "text": "Giffuer Gud baade heffn oc all ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 17,
      "text": "Den sneffre Sti i vandre here/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 17,
      "text": "Gud skal Verden vel straffe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 18,
      "text": "Maatte kiødet faa huad det begær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 18,
      "text": "Glæde/ sundhed/ Verdsens lyst oc ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 18,
      "text": "Til dyd bleffue i snart kolde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 18,
      "text": "Thi kommer der offte modgang paa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 18,
      "text": "Som kiødsens onde lyst tucte maa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 18,
      "text": "Oc eder i Guds fryct holde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 19,
      "text": "Er Kaarssit eder for bitter oc leed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 19,
      "text": "Da tencker huad Helffuede er heed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 19,
      "text": "Did som Verden monne rende:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 19,
      "text": "Met liff oc Siel der lide maa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 19,
      "text": "Den pine som aldrig ende kand faa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 19,
      "text": "Oc kand dog icke opbrende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 20,
      "text": "J Christne skulle effter denne tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 20,
      "text": "Met Christo haffue den euige fryd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 20,
      "text": "Der hen saa skulle i tencke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 20,
      "text": "Den ære oc glæde ey nogen mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 20,
      "text": "Betencke eller fortælie kand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 20,
      "text": "Som Herren vil eder skencke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 21,
      "text": "ALt huad den euige gode Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 21,
      "text": "Tilsiger oss i sit løffte oc bud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 21,
      "text": "Det faa wi allesammen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 21,
      "text": "Hand føre oss fra all nød oc fare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 21,
      "text": "Hand føre oss til sine Engleskare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 21,
      "text": "Ved Jesum Christum/ Amen.",
      "part": false,
      "marginal_notes": []
    }
  ]
}