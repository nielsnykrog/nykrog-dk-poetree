  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Datter och sin moder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": ":: Men gøgen hand gaall. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "dy seder y derris burre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Vnder hiuffue-loffts sualle. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: Men Malldfreed hun greder vdj lundenn, ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": ":: vdj loffttenn der hun sørgett. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "\"Hør du, Malldfred, datter min:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "huy falmer rosenns-kinder dynn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "\"For-dy daa falmer min kiender saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "allt for ieg giør mitt guld saa smaa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "\"Andier iumfrwer giør och gulditt saa smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "men icke daa fallmett dier kender saa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 4,
      "text": "\"Mynn kerr moder, y werer meg guod:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "al min sorrig klager ieg eder nu.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 5,
      "text": "Tthett burde icke att were duld for eder:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 5,
      "text": "denn elffuer-konnge haffuer lockett meg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 6,
      "text": "Ieg haffuer med denn elluer-konge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 6,
      "text": "otte søner, er buode øske och vnge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 7,
      "text": "Thend nyende denn er en datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 7,
      "text": "hun giørris min kiender suortt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 8,
      "text": "Tthett er thett X, ieg nu metet er,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 8,
      "text": "min kerre moder, thett klager ieg eder.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 9,
      "text": "\"Er thett nu sandingenn, du sigger for meg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 9,
      "text": "tha skønntt theg, Maldfred, aff bure fra meg!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 10,
      "text": "Førrind dy ord thaalit war,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 10,
      "text": "daa kaam denn elluer-kong ridenn y gaard.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 11,
      "text": "Denn elluer-kong hand y gardenn rende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 11,
      "text": "guld-skuo vnder hans ganger skeenndde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 12,
      "text": "Denn elluer-konng stander vnder offues bordt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 12,
      "text": "hand liude paa beege dj fruer deris ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 13,
      "text": "Mallfred hun vd aff dørenn thrennd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 13,
      "text": "elle-konge stander hind op igenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 14,
      "text": "\"Hør thu thett, Maldfred, allerkereste min:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 14,
      "text": "hui klagitt du meg for moder din?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 15,
      "text": "Haffde du nu kund elskuo lenger duold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 15,
      "text": "daa matte du och nu lenger dinn moder haffd fuld.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 16,
      "text": "Hand sluoff offuer hinder kobenn bla,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 16,
      "text": "hand førde hinder saa snatt aff sinn moders gaard.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 17,
      "text": "Saa fullde hand hinder y berigitt ind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 17,
      "text": "hindis otte sønner gick hinder igenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 18,
      "text": "Dy thuo thi thuog hinder høynde och stuoffuell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 18,
      "text": "dy thuo dy bred hind thield for fuod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 19,
      "text": "Dy thuo thi thuog hinders skaarlagenn-skiennd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 19,
      "text": "dy thuo fuld hinder y bergett ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 20,
      "text": "Op stuod hindis datter saa small som wand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 20,
      "text": "hun haffde thuo sølleff-kand y huidenn haand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 21,
      "text": "Dett enne med mød, thett anditt med wynn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 21,
      "text": "saa herlig daa skenckett hun moder synn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 22,
      "text": "\"Mynn kerr moder, drecker wyn aff hoffuedett,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 22,
      "text": "denn elluer-konge skall werre edder guod.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 23,
      "text": "Stalltt Lusellid thaller till thieneste-quende:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 23,
      "text": "\"Du hinthte meg ind ithett huornn med wyn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 24,
      "text": "Du hinthte meg ind itht dyrebar huorn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 24,
      "text": "du kast der-y tho ieder-kornn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 25,
      "text": "Dett er møgit bedere att werre død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 25,
      "text": "ind leffue alt med etht sorrigfuld liff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 26,
      "text": "Mynn kerre moder, dricker wynn med meg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 26,
      "text": "\"War thett ind wand, ieg wilde drecke med eder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 27,
      "text": "Fuld vssenn ieg thinn moder war:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 27,
      "text": "ieg deg aldrig kledder skaar.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 28,
      "text": "Saa thog hun hornitt, och aff hun drack:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 28,
      "text": "all werdenn heender aff huffuenn gick.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 29,
      "text": "Denn ell-kong end aff dørrenn threend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 29,
      "text": "Malfred stander hanom op igenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 30,
      "text": "Hannd klaper hinder wed huiden kind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 30,
      "text": "\"Du wer ind wellkomen y bierigit ind!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 31,
      "text": "Hand thog Maldfred y sin arrum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 31,
      "text": "hand gaff hinder guld-krone och droninge-naffuen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 32,
      "text": "Dett giorde hand for lilly-wand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 32,
      "text": ":: Men gøgen hand gaall. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 32,
      "text": "hand luod chrestne bod seeg och altt sin land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 32,
      "text": ":: Vnder hyffue-loffts sualle. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 32,
      "text": ":: Men Maldfred hun greder y lundenn, ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 32,
      "text": ":: y lofftenn der hun sørger. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}