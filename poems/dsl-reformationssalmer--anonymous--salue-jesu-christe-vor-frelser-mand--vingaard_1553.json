  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "SAlue/ Jesu Christe vor Frelser mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Du som all Gudz vrede offueruand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Ath Adam i dig naade fand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "⁕ Du est vor liff oc søde trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "baade i modgang oc i løst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Paa dig wi haabe O Jesu Christe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "⁕ Vi paakalle dig vdi vor nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "som ere falne i euig død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "met Heua vor moder alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "⁕ Vi raabe til dig aff denne grædelige dal/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "wi græde oc icke sucke saadant ith fald",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "dog est du fuld aff Gudz gunst oc naade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Thi hielp oss O naade fuld Christe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "⁕ Eya Christe vor Talsmand est du vorden til vor Fader/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "Forlad oss for din Dødz skyld alle sager",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 5,
      "text": "⁕ Oc vent dit naadefulde Ansicte til oss wsle oc arme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "Och lad dig mildelige altid offuer oss forbarme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 6,
      "text": "⁕ O Jesu lær oss nu at kende Fader din/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 6,
      "text": "huess naade oc fromhed i dig skin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 7,
      "text": "⁕ Lad oss saa kende hannem i ret Tro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 7,
      "text": "Ath wi hans blide Ansict skue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 7,
      "text": "oc siden met dig oc hannem bo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 7,
      "text": "Oc gode Jesu/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "O milde Jesu/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 7,
      "text": "O søde Jesu",
      "part": false,
      "marginal_notes": []
    }
  ]
}