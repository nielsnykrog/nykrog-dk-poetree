  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Wÿ tro allsammen paa een Gud /",
      "part": false,
      "marginal_notes": [
        "Gene. j."
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "himmels skabere oc iordens/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Gud søn sÿn faders wilie giorde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "paa thet wÿ sÿne børn skulde bliffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Han wil oss forsee wor næring/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "lÿff oc siæl ÿ hans bewaaring/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "altÿd han oss wil bewaare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "inthit ont skal oss wederfare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "han sørger for oss dag oc nat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "for han haffuer alting ÿ sÿn macht.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Wÿ tro oc alle paa Jesum Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "som er Guds søn oc wor Herre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Som aff then Helliaand vndfangen wor/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "aff guddommelig krafft oc ære /",
      "part": false,
      "marginal_notes": [
        "Luce. j."
      ]
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "aff Maria then reene Jomffru/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "eet sandeligt mennisk er worden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Pÿnt vnder Pontio Pilato/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "korsfest/ død/ oc iordet/ til heluedis foer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "wor dommer er han worden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Wÿ tro oc paa then Helliaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "lÿg med fader oc med søn/",
      "part": false,
      "marginal_notes": [
        "Johan. xv."
      ]
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "som alle bedrøffuedis hugsualer er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "med dyrebare gaffue oc naader skøne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "All gantske Christenhed paa iorden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "eet samffund giord med sÿne orde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "med hannwm wore synder tilgiffne worde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Wÿ menniske skulle alle opstande/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "effter thette ælende/ Eet leffnit er oss forred/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "ewigt ÿ ewighed.",
      "part": false,
      "marginal_notes": []
    }
  ]
}