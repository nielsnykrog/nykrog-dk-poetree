  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "»Hustrue! Moder! Du har os forladt!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Saa klage Dine i den mørke Nat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Armod græder ved Dit kolde Leer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "»Moder! ak! vor Moder er ei meer!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Venskab planter Blomster paa Din Grav;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Om os alle trøstende Du svæver;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Aanden ei forgaaer i Tidens Hav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Støvet døer kun, evig Aanden lever.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Livet svinder, som en Drøm saa brat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "– Stjerneskud i Evighedens Nat –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Men vi gaae til Livets Morgenrøde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Christ og alle Gode der at møde.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
