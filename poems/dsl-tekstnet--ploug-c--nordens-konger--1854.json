  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1854,
    "url": "https://tekstnet.dk/books/ploug-c_nordens-konger/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Straal gyldenblank, du Sandets rustne Nøgle!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Sæt Krands om Panden, gamle Mærkismand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Som saa' Carl Gustaf tabe Havets Tøjle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Og Stenbocks Drenge feje Skånes Strand!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Thi bag din Mur, de mørke Tiders Minde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Staa disse Landes Fyrster Haand i Haand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Med lige Huld og lige Tro i Sinde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Hil Kongebrødrene i Nordens Aand!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Og Eders Venskab er ej Lunets Bjelde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Ei stakket Egennyttes Maskeleg;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Af samme Grund, som bærer Eders Vælde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Af Folkehjertet, sundt og skært, det steg;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Den Trang, som drev Jer i hinandens Arme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Var ædle Folkeviljers ædle Tolk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "En Flamme klar af mange Hjerters Varme:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Hil Broderkongerne for Broderfolk!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Og Eders Venskabs Tvillingblomst skal trives,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Og sno sig lunende om Tronens Fod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Og intet Blad skal bort af Blæsten rives.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "Og ingen Orm skal gnave paa dens Rod!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "Engang til mægtigt Træ den skal sig forme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "Med stærke Grene og med Løvets Pragt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "Hvorunder Slægter trodse Fremtids Storme!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "Hil Nordens Haab, dets Kongers Broderpagt!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
