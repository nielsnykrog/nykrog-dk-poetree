{
  "id": null,
  "title": "Sange ved det kongelige Opfostringshuus’s hundredeaarige Fest, den 29de Juni 1853",
  "year_created": 1853,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
