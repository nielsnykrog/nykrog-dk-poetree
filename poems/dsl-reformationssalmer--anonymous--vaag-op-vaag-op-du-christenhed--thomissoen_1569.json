  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "VAag op vaag op/ du Christenhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Betenck dit gaffn oc beste:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Vocte dig i denne farlighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "J huilcken Sathan dig frester.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Hand veed den yderste dag tilstande/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Och Verden paa sit siste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Oc Herrens Dom at være for haande/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Thi bruger hand alle liste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Salig er den sig tager til vare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "J disse farlige tider:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "At hand lader sig her icke daare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Men trolig til enden strider.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Mod Dieffuelen oc all forargelse:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Som kommer paa alle sider/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "De Christus sagde at skulle skee/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Vdi disse siste tider.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "De tegn som skulle for Dommen skee/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Giffuer Christus oss tilkiende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Hoss Mattheum/ at wi kunde see",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Tilstunde Verdsens ende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Thi Antichristen Paffuen i Rom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Haffuer nu lenge regerit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "J Christi sted sagde at hand kom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "All mact være sig antuordit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Tyrcken indsetter met mord oc brand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Den Christelig tro at fordriffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Paffuen disligest/ i huor hand kand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Tager Guds Bekiender aff liffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Vdøser ynckelig Christnes Blod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "For de vilde icke tilfalde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Den Babylonske Hore til Foed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Oc hende deris Herre kalde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Krig oc Orloff maa mand høre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "J mange atskillige Lande:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "Stor tuist oc strid wi daglige spøre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "Stor plage sorrig oc vaande:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "Met wuonlig kranckeder oc brad død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "Pestilents oc andit mere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "Dyre Aaring/ stor Hunger oc nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "Saa Gud det bode oc bedre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "Alle Synd staar i deris høyeste grad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "J alle fordømmelig maade:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 5,
      "text": "Gerighed haffuer offuerhaand faaet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 5,
      "text": "Til Rigdom oc stor Bade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 5,
      "text": "All kierlighed er aff Landen rømt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "All miskund/ tro oc loffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "Den Arme ligger aff alle forsømt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "Men Verden skraber Guld tilhobe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "Guds rene Euangelium/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 6,
      "text": "Som Christus selff før sagde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 6,
      "text": "Er predicket i gantske Verden om:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 6,
      "text": "Thi Jøderne det først haffde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 6,
      "text": "Oc alle de Land i Østen dernest/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "J Sønden oc Vesten dislige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "Oc haffuer sig sist nu i Norden befest/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "Vdi disse Nordiske Riger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 7,
      "text": "Gud giffuer oss sit Euangelium/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 7,
      "text": "Det klinger i disse Lande:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 7,
      "text": "Oc vil at huer skal være from/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 7,
      "text": "Aff Synden snart opstande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 7,
      "text": "Men Verden hun passer her intet paa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 7,
      "text": "Ey saadan dyrebar gaffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 7,
      "text": "All Lærdom hun slet i vinden hen slaar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "Vdi disse siste dage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 8,
      "text": "Huor er nu all broderlig Kierlighed?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 8,
      "text": "God villie/ wi skulle beuise?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 8,
      "text": "Guds fryct oc all Retfærdighed?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 8,
      "text": "Der met wi skulle Gud prise?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 8,
      "text": "Mand acter nu Gud slet intet meer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 8,
      "text": "Ey formaning/ ey gode lære:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 8,
      "text": "Huer stunder effter sin egen ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 8,
      "text": "Hoffmod vil Herre være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 9,
      "text": "De sige/ wi haffue slet ingen nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 9,
      "text": "Her er slet ingen fare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 9,
      "text": "Saa suerme de hen til deris død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 9,
      "text": "J Dieffuelens garn oc snare:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 9,
      "text": "J Guds foract oc all skendelighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 9,
      "text": "Optencke alle ny Finantze/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 9,
      "text": "Met skalckeri oc all wbarmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 9,
      "text": "Guds vrede kunde de ey santze.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 10,
      "text": "De leffue som Gud vaar icke til/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 10,
      "text": "Berøffue deris fattige Neste:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 10,
      "text": "Met ret oc wret de haffue vil",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 10,
      "text": "Deris Broders Gods det beste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 10,
      "text": "Bedrage oc liuffue er ingen skam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 10,
      "text": "Wkyskhed at bedriffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 10,
      "text": "J slemmen oc demmen ruse de frem/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 10,
      "text": "Saa lenge de tagis aff liffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 11,
      "text": "Der plagis den arme Menighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 11,
      "text": "De acte ingen være deris lige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 11,
      "text": "Met trældom oc sleff i tyranskhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 11,
      "text": "Guds Ord ville de ey vige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 11,
      "text": "De skulle betale den Armis sued/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 11,
      "text": "Hans Blod oc trældoms dage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 11,
      "text": "J Euig pine oc Helffuedis glød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 11,
      "text": "Skal Dieffuelen dennem plage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 12,
      "text": "Christi Kiortel de sønderslide/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 12,
      "text": "Det skal dem lidet bade:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 12,
      "text": "Aldrig kunde de mette bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 12,
      "text": "Alting ville de selff raade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 12,
      "text": "De arme Guds tienere lide nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 12,
      "text": "Oc mange ælendige hierter:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 12,
      "text": "De tage fra dem aff munden Brød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 12,
      "text": "Slet nøgen staar Christi Kircke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 13,
      "text": "De Høste det de haffue icke saait/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 13,
      "text": "Vdsue deris fattige Lemmer:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 13,
      "text": "Guds tienere fortryckis i alle vraaer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 13,
      "text": "Men Verden horer oc slemmer:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 13,
      "text": "Det haffuer alt Christus tilforne sagt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 13,
      "text": "Sine tiener skulle offuerkomme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 13,
      "text": "Aff Verden/ met Tyranni oc mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 13,
      "text": "Dog det hende lidet skal fromme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 14,
      "text": "Den gantske Verden er forblindt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 14,
      "text": "Den Christen Hiord er ringe:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 14,
      "text": "Forgiffuit er hierte tancke oc sind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 14,
      "text": "Det Christet Blod maa springe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 14,
      "text": "Alle Synd de ville til enden vare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 14,
      "text": "Oc Dieffuelen vil regere:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 14,
      "text": "Thi Gud vil hannem saa lenge spare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 14,
      "text": "Siden vil hand ene regnere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 15,
      "text": "Derfor bruger Sathan all sin konst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 15,
      "text": "J disse siste dage:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 15,
      "text": "At hand hoss Gud i stor wgunst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 15,
      "text": "All Verden met sig kand bedrage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 15,
      "text": "Derfor er ondskab saa mangfoldelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 15,
      "text": "Oc Christi Lemmer maa holde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 15,
      "text": "Der bruser oc stormer de wgudelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 15,
      "text": "Met Tyranni mangfolde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 16,
      "text": "Mand bygger oc planter nu allermest/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 16,
      "text": "Mod Herrens snare tilkomme:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 16,
      "text": "Kresmer Legemet som mand kand best/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 16,
      "text": "At det kand skinne oc bramme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 16,
      "text": "Met Æden oc Dricken oc all vellyst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 16,
      "text": "For næring met stor omsorrig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 16,
      "text": "Dog wi skulle haffue nu der aff minst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 16,
      "text": "Ja alting skal bliffue forlaarit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 17,
      "text": "Soel oc Maane oc Stierner alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 17,
      "text": "Aff saadant mangfoldigt onde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 17,
      "text": "Miste deris skin/ oc monne nedfalde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 17,
      "text": "De sørge i alle stunde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 17,
      "text": "De kunde icke see saadan Tyranni/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 17,
      "text": "Der for ære de saa bange:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 17,
      "text": "De ville saa gierne være fri/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 17,
      "text": "Forløsning de effter lange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 18,
      "text": "All Creatur sucker i Himmelen op/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 18,
      "text": "Aff saadan wgudelig væsen:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 18,
      "text": "Begærer dom offuer den wgudelig Krop/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 18,
      "text": "Hans ondskaff/ vellyst/ oc kressen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 18,
      "text": "Der for kom snart/ Herre Jesu Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 18,
      "text": "Den gantske Verden at dømme:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 18,
      "text": "Oc lad oss see met glæde oc lyst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 18,
      "text": "Din herlige tilkomme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 19,
      "text": "Men du Jesu Christi lille Hiord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 19,
      "text": "Skalt dig slet intet mistrøste:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 19,
      "text": "Din Brudgom som dig haffuer hellig giort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 19,
      "text": "Dig met sit Blod forløste:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 19,
      "text": "Skal snarlige komme oc dig befri/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 19,
      "text": "Oc alle dine Fiender nedfelde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 19,
      "text": "Oc du skalt bliffue til Euig tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 19,
      "text": "Hoss hannem/ i fryd oc glæde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 20,
      "text": "Du onde Forsamling tenck dig om/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 20,
      "text": "Du est i Dieffuelens snare:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 20,
      "text": "Omuent dig snart/ leff erlig oc from/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 20,
      "text": "Du maatte vndgaa denne fare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 20,
      "text": "Guds vrede oc Helffuede henger offuer dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 20,
      "text": "Vil dig nedsiuncke til grunde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 20,
      "text": "Derfor vent om/ leff Christelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 20,
      "text": "Forlad snart alt det onde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 21,
      "text": "Dig truis met straff aff Himmel oc Sky/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 21,
      "text": "Aff Haffuit oc Jorden alleuegne:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 21,
      "text": "Tag dig vare/ du maatte vndfly",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 21,
      "text": "Det onde de dig betegne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 21,
      "text": "Du bliffuer forraskit før du tror/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 21,
      "text": "Saa est du Euig borte:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 21,
      "text": "Jndfly til Guds Barmhiertighed stor/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 21,
      "text": "Oc oben staar Himmerigis porte.",
      "part": false,
      "marginal_notes": []
    }
  ]
}