  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Ieg wor oc konning en stacket tijd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "tijl ieg aff helsot døde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Meg hobes tijl Gud han wor myg blijd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "I Sore hwiles nw myn krop",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "och bidher ther dommedaghe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Tijl han skal staa aff iorden op",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "och løn for werdskyld haffue.",
      "part": false,
      "marginal_notes": []
    }
  ]
}