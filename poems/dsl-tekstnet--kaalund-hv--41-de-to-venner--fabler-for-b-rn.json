  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Med Killingen voxede Hvalpen op;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "de spiste og drak af samme Kop,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "de leged Skjul og de leged Tagfat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Og Hvalpen blev Hund og Killingen Kat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Dog trods deres Klør og skarpe Tænder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "blev Katten og Hunden de bedste Venner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Og Alle, som saae det, tyktes det sært;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Naturen havde dem Fjendskab lært,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "den havde skilt deres Slægter ad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "fra Skabelsens Tid med det bitre Had;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "dog aldrig saae man de To at stride,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "de spiste og sov ved hinandens Side.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
