  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "HErre Gud hielp mig/ ieg raaber til dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Du vilt icke fra mig vige:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Paa min siste End/ din trøst mig send/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Naar Døden monne sig fremsnige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "At du kant mig prøffue rettelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "At ieg kiendis dig min Herre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Oc Læge sand at være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "J den samme tid/ Herre met mig strid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Naar den haarde Død/ i alskens nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Gruelig vil met mig kempe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Kaarssit er suart/ oc trycker mig hart/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Til Seier giff raad oc lempe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "O Jesu Christ/ forsant du est",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Veien/ Sandhed oc Liffuit:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Hielp mig at ieg kand tryggelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Mig vnder dig gantske giffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Oc vandre fri/ paa Sandheds sti/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Ret effter din villie giøre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Til det gode du mig føre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Mit Kiød oc Blod staar der imod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Til det haffuer had oc er wglad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "Som du monne mig befale/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "Der til god lyst giff mig/ Herre Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "Oc euige Liffs husuale.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "O hellig Aand/ kom da paa stand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Naar Siel oc Krop skal skillies:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Vær i samme tid icke fra mig vijt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Bestyrcke mit hierte oc villie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Saa bliffuer ieg sund/ oc i samme stund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "Met en sand tro kand fare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "Til dine Englers skare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "Til euig ære/ som ieg begær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "Oc stat mig bi/ at ieg kand fri",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 2,
      "text": "Aff dig anammit vorde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 2,
      "text": "Mig dit Barn her/ O Fader kier/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 2,
      "text": "Tag i dit Skød fra Jorden.",
      "part": false,
      "marginal_notes": []
    }
  ]
}