  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "DEr Jesus Christus vor Herre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Viste sin tid kommen at være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "At hand skulde tagis aff dage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Til Bords met sine Discipler sad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Det Paaskelam hand met dem aad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Der hand nu Døden vilde smage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Sagde/ ieg begærede hiertelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Førend ieg døer/ nu endelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Met eder æde Paaskelammit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Jeg siger eder at her effter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Aff dette æder ieg icke meer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Førend Guds Rige kommer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Da vilde hand dem til hiertens trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "(At de skulde icke aff syndsens brøst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "J Mishaabs banghed falde)",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Jndsette sit hellige Sacrament/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Tog Brødit met tacksigelss i hend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Brød det/ gaff dem/ oc talede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Tager hen/ æder/ mit Legem det er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Paa Kaarssens træ alt for eder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Skal det bortgiffuit vorde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "Det giører til hukommelse min",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "At ieg eder frelser met min pine/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "Alle som tro her paa Jorden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Der Naderen vaar da vel fuldendt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Fuldkommede hand sit Sacrament/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Styrckte sine Discipler suage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Tog Kalcken lige maade i sin haand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Tackit oc gaff dem saa paa stand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "Oc venlig til dem sagde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "Tager hen/ dricker alle/ denne Kalck god",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "Er det ny Testamentis Blod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "Som ieg paa Kaarssit ophengder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 2,
      "text": "Vdgiffue vorder for eders Synd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 2,
      "text": "Saa offte i Dricke sammelund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 2,
      "text": "Det giøre ati paa mig tencker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "Huem nu vil æde aff dette Brød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "Oc dricke aff Herrens Kalck/ som hand bød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "Den skal hans død forkynde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "At Jesus Christus Guds Søn god",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 3,
      "text": "Paa Kaarssit giorde fuld plict oc bod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 3,
      "text": "For alles vore Synder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 3,
      "text": "Oc at Gud nu er oss naadig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 3,
      "text": "Om wi aff Hiertens grund tro sligt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 3,
      "text": "Oc det til enden fast holde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 3,
      "text": "Saa skulle wi Guds børn bliffue da/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 3,
      "text": "Oc Himmerigs Arffdeel visselig faa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 3,
      "text": "Det kand Guds naade volde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 4,
      "text": "Saa skal huert Menniske prøffue sig vel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 4,
      "text": "Før hand til Guds bord gaar met skel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 4,
      "text": "At hand sit hierte ret kiender",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 4,
      "text": "Om hand rettelig i Troen staar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 4,
      "text": "Oc wdi sand Kierlighed fremgaar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 4,
      "text": "Oc hiertelig staar aff Synden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 4,
      "text": "At hand ey æder den euige dom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 4,
      "text": "Der hand ey paa Christi Legem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 4,
      "text": "Ret forskel monne giøre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 4,
      "text": "Saa skal mand oc Syndsens surdey",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 4,
      "text": "Ved den hellig Aand ret vdfeye/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 4,
      "text": "Christo Guds lam til ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 5,
      "text": "Der for lader oss alle tillige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 5,
      "text": "Gud Fader vdi Himmerige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 5,
      "text": "Aff gantske hierte bede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 5,
      "text": "Ved Jesum Christ hans enbaarne Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 5,
      "text": "Som frelste oss ved sin pine oc Bøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 5,
      "text": "Oc Døden for oss lidde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 5,
      "text": "At hand oss met den hellig Aand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 5,
      "text": "Styrcker/ til en fast tro oc sand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 5,
      "text": "Effter hans ord at leffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 5,
      "text": "J kierlighed oc enighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 5,
      "text": "At hand oss effter denne tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 5,
      "text": "Den euige glæde vil giffue.",
      "part": false,
      "marginal_notes": []
    }
  ]
}