{
  "id": null,
  "title": "66. Gøtrik, Gorms søn, kaldet Godfred",
  "year_created": 1495,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Rimkrøniken",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1495,
    "url": "https://tekstnet.dk/books/anon_rimkroeniken/069/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "I thes høgræ løcken hwn ær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "thes snarre kan hwn fallæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Ee hwo som ondhe tiæner haffuær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Meth orloff twyngde ieg Tydeskæland,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "ieg willæ them intheth spare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "och saadan skath them foræ fand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "han mwnne dog mwelig ware.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "the skullæ then herre gestæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "och saa hans nade ath hedræ oc thy",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "meth hundrede hwidhe hestæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "Nar han skullæ them oc høwetzman faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "Fare tijl hannum meth ydmyg traa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "och hannum the hestæ føre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "Thet skullæ the gøre alth tijl eth teghn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "ath the wore affuer wundhnæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "saa kort wore the tha bundhnæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "Thernest sendæ ieg en godher mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "indh wthi Swerigis rigæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "ath spøriæ om ieg kwnde faa thet land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 6,
      "text": "Hannum sloffue the meth forrædels en nath,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "the offuenbare thet ey thorde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 6,
      "text": "Thi foor ieg tijd saa offuer brath",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 6,
      "text": "ieg spurdhe wij the saa giordhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "theres faltzmoll ieg saa sætthæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 7,
      "text": "som i thet mordh lade theres arth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 7,
      "text": "ath the skullæ bliffue vthrætthe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 8,
      "text": "Hwer man som ther wor meth ath slaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 8,
      "text": "Men hwer swenskman som ther wor fraa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 8,
      "text": "lodh ieg for twenne scriffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 9,
      "text": "Men ther ieg Swerigis rigæ wandh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 9,
      "text": "meth allæ syne land saa wenæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 9,
      "text": "och nøddhe them seg ath tiæne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 10,
      "text": "Thi for ieg hannum hoss Ælffuen imodh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 10,
      "text": "och slo hannum vdh tijlbagæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 10,
      "text": "Ieg lade thet land plat vnder fæfodh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 11,
      "text": "Siden holth ieg krij i xxx aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 11,
      "text": "meth hannum paa Franckærigæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 11,
      "text": "och landheth war ødhe, som skreffuit staar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 11,
      "text": "Fryslandh och theslighæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 12,
      "text": "bemannedæ oc wel bespijsde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 12,
      "text": "Thertijl saa manghen howethhøøs",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 12,
      "text": "ieg fræm ath landhene wijsdhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 13,
      "text": "Siden bleff ieg slaffuen vndher mit paulwn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 13,
      "text": "Thet giorde en aff myn eygæn dwn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 13,
      "text": "imodh godh throo och loffue.",
      "part": false,
      "marginal_notes": []
    }
  ]
}