  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Iudicium pergo, sum de tellure vocatus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Timor inest ergo quia pandam facta reatus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Ieg er nw for then grwmmæ dom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "we mig at ieg til wærdhen kom!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Huart schal ieg mig nw wændhæ?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "O Himmæriges drotning, Paradises æræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "til dommen han faar ændhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Nw staar ieg bløy och møghet rædh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "ieg er i syndzens klædhebonæ klædh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "ieg maa mig ynckælighen giffuæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "wij skilliæs adh som wij hær staa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "huar mwnæ ieg nw schullæ bliffuæ?",
      "part": false,
      "marginal_notes": []
    }
  ]
}
