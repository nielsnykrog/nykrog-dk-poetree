  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "I Amsterdam i »Herregaden«,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Ved den brede Canal og de grønne Træer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Byen paa Bjælker, Nordsøes Staden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Der mødtes vi, Foraaret aandet her,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Et Vers sprang frem – gjem dette Blad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "– Gode Minder gjør Hjertet glad. –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Paris hvor er Du dog lystig og glad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "En dandsende Adam uden Figenblad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Du spiser af Frugten uden al Sky,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Og naar Den er spiist vil Du have en ny! –",
      "part": false,
      "marginal_notes": []
    }
  ]
}
