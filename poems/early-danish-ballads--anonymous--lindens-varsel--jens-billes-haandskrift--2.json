  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Iegh wiilt ether Siige aff thu Koniinge-Børnn | ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "huadt the loffuede huer-andenn | j lønn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": ":: j danszenn da trede wj | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "De loffüede hüer-andenn aff Saa Møgenn | løszt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "ther spriinger vdt løff pa ljnden-quist |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": ":: j danszen da trede wii | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Skulle j iar i lediingh fare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "huem da szeter | j mjgh tell ware",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": ":: j d d t w | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "Iegh skall Sette diigh liindenn for thjnn | loffts-Bro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "wiinter och Somer tha skall | hun gro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": ":: j d S t w | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 4,
      "text": "FFørste thenn liind hun felder Sjn Bladtt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "da Matt tu wede att iegh er icke glad, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": ":: j d S d w | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 5,
      "text": "Første thenn ljnd hun felder Sjnn løff |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "da Ma j wede att iegh er dodt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": ":: j d s tw | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 6,
      "text": "Altt ther thi tallede tj tennckthe de | wor enne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 6,
      "text": "allt Stodt hendes ternne | och liiude der-paa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": ":: j d S t w | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 7,
      "text": "Her chriist Sa gÿffue denn ternnee | menn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 7,
      "text": "hun Brød løff aff liinden grønn |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": ":: j danszenn da trede wj | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 8,
      "text": "Saa stodt dett j Monett tre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 8,
      "text": "Sa løstee | Ionffruen tjll liindenn att See",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 8,
      "text": ":: j da S | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 9,
      "text": "Hun lod op jtt wiindu och vd hun saa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 9,
      "text": "ljnde-løff pa Iorden la",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 9,
      "text": ":: j d S t w | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 10,
      "text": "Wesztee iegh att Mjnn herre wor dødt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 10,
      "text": "da skulde iegh Brennde Mjn Burd j | glød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 10,
      "text": ":: j d S t w | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 11,
      "text": "Hun Satte jld j Burd sjnn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 11,
      "text": "och brend | Siigh jn Mett all Sjn mør",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 11,
      "text": ":: j d d t w | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 12,
      "text": "Der denn Burd stod j gloenn brandtt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 12,
      "text": "da kam denn riider Seglens tjll land |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 12,
      "text": ":: j d d t w | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 13,
      "text": "Huen er thenn gloende Brandtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 13,
      "text": "alltt | pa mjn Ionffrus land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 13,
      "text": ":: j d d t w | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 14,
      "text": "Weszte iegh att Mjnn Ionffru war dødt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 14,
      "text": "da skulde mjt egtt Suerdt bliiffue | mjn dødt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 14,
      "text": ":: j d d t w | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 15,
      "text": "Hann Satte helttenn j-Modt enn stenn |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 15,
      "text": "och uddenn j hans hertte geck",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 15,
      "text": ":: j d d t | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 16,
      "text": "Nu skall thett kalle Iernn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 16,
      "text": "slocke Sorgh | och Sualle harm",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 16,
      "text": ":: vdj dantzenn da tre-de wj | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 16,
      "text": "ffÿnis |",
      "part": false,
      "marginal_notes": []
    }
  ]
}