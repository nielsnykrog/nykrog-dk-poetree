{
  "id": null,
  "title": "Herr Enevolds Søster",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift I",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVI79.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Her Ienuold sporde hand syster sin:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": ":: Y rider offuer grønen vold! ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "\"Och hui daa falmer din fogre kiend?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Ditt siger den suend, hinder haffuer loffuit. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Dig falmer lyd, dig falmer hoer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "som then, ther hiertelig sorig haffuer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Du kommer aldrig saa sildig ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "du setter i sorinde hand under kind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "Du gaaer aldrig saa sildig at soffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "thu haffuer y such och sorig y hoffue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "\"Min kiere broder, du sider huoss mig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "och all min sorig siger ieg for dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "Ieg vor gangen ud till aae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 5,
      "text": "och flere iomfruer giorde och saa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "Der kam rydende di ryder ny,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "di veniste, mand ville med øyen sie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "Di otthe di red dieris vie bort frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 7,
      "text": "then niende hand holte, ieg tallit med ham.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "Hand talde mig till med tuct och ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 8,
      "text": "ieg suarit hanem vell effter sin begiere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "Hand lagde itth guld-bond y min hand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 9,
      "text": "ieg fich den sorig, ieg aldrig foruandt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "Ditt er tre vinter, siden ieg hannem saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 10,
      "text": "siden monne hand mig aldrig aff hiertit gaa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "\"Hør du, kiere søster, huad ieg siger dig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 11,
      "text": "och lad du mig dett røde guld sie!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "Ditt første her Ienuoll det guld-bond saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 12,
      "text": "\"Then suend hand mone i Iudt-landt boe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "Min kiere søster, du ichi sorig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 13,
      "text": "ieg skall dig snarit til hannem føre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "Her Ienuold hand lod sin sneche boe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 14,
      "text": "hindis ganger lod hand med røde guld skoff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "Hand vandt op sielchi-segell med forgyldene fløff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 15,
      "text": "saa segler her Ienuold under øø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "Her Ienuold styrde sin sneche for landt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 16,
      "text": "her Folmer hand rende sin ganger paa sand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "\"I vere velkomen, y udkommens mend!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 17,
      "text": "och leffuer her Ienuolds søster end?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 18,
      "text": "\"Iaa, vid mend, thaa giør hun saa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 18,
      "text": "hinder kand ingen rider foe.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 19,
      "text": "\"Herre Gud daa segne ditt sledell klar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 19,
      "text": "for en gang ieg med hinder tallit!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 20,
      "text": "Ditt er III vinter, siden ieg hinder saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 20,
      "text": "siden monne hun mig aldrig aff hiertit gaa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 21,
      "text": "\"I-meden i haffuer den iomfru saa kier,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 21,
      "text": "y dag saa ere hun komen herre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 22,
      "text": "\"Haffuer tach, herre Ienuold, for eders ere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 22,
      "text": "y haffuer mig ført min hiertens-kiere!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 23,
      "text": "Herre Follmer druch brøllupe med den møø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 23,
      "text": ":: Thu rider paa grønen vold! ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 23,
      "text": "saa seglet her Ienuoll under øø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 23,
      "text": ":: Dett siger den suend, der hun haffuer loffuit. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}