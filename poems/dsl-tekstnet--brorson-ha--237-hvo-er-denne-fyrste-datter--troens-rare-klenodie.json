{
  "id": null,
  "title": "237. Hvo er denne fyrste-datter",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
    "wiki": "Q348003"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Troens Rare Klenodie",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1739,
    "url": "https://tekstnet.dk/books/brorson-ha_troens-rare-klenodie/227/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Hvo er denne fyrste-datter,",
      "part": false,
      "marginal_notes": [
        "Speaker: JEsus."
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Der saa prægtig her gaaer frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 2,
      "text": "Hvo er den, som fra sin throne",
      "part": false,
      "marginal_notes": [
        "Speaker: Sielen."
      ]
    },
    {
      "id": 3,
      "stanza_id": 2,
      "text": "Bøyer rigets scepter ned?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "Hvo er den, hvis konge-krone",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "Er saa fuld af herlighed?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Den, som gaaer i konge-stads",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Af sit elfenbeens palads,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Med en kæmpe-hær omgivet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Som har lyst at vove livet?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "Du min søster uden lige,",
      "part": false,
      "marginal_notes": [
        "Speaker: JEsus."
      ]
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "Skiøn og deylig seer du ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Mod dig intet har at sige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Esther Ahasveri bruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Hvor manerlig er din gang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Hvor livsalig er din sang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "Hvor anstændig dine fagter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "Som jeg ynder høyt og agter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Du est høy- og himmel-baaren,",
      "part": false,
      "marginal_notes": [
        "Speaker: Sielen."
      ]
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Frem for nogen som er fød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "Du for alle est udkaaren,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "Du est deylig, hviid og rød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 6,
      "text": "Ret som carmel er dit hovet",
      "part": false,
      "marginal_notes": [
        "Speaker: JEsus."
      ]
    },
    {
      "id": 23,
      "stanza_id": 6,
      "text": "Og som elfenbeen saa fiin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Munden, som mig troe har lovet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Er som deyligste rubiin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Duers øyne har min bruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "Marmor-glat er hendes hud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "Hendes kinder rosen-røde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": "Som granate-æblers grøde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "Som saphirer og turkoser",
      "part": false,
      "marginal_notes": [
        "Speaker: Sielen."
      ]
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "Er min brudgoms deylighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "Læber haver hand som roser,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 7,
      "text": "Hvor af myrrha flyder ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 7,
      "text": "Høy anseelig hans gestalt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "Ret som libanon udvaldt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 7,
      "text": "Og hans øyne ikke mindre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": "End de blankest stierner tindre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 8,
      "text": "Kom, min søster! lad mig smage",
      "part": false,
      "marginal_notes": [
        "Speaker: JEsus."
      ]
    },
    {
      "id": 39,
      "stanza_id": 8,
      "text": "Troens kys af hiertens grund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 8,
      "text": "Sød som melk og honning-kage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 8,
      "text": "Er din søde rosen-mund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 8,
      "text": "Dine klæder, du har paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 8,
      "text": "Alle farver overgaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "Som det guld og ædel-stene",
      "part": false,
      "marginal_notes": [
        "Speaker: Sielen."
      ]
    },
    {
      "id": 45,
      "stanza_id": 10,
      "text": "Paa hans hænders melk og blod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 10,
      "text": "Marmor-støtter er hans bene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 10,
      "text": "Satte paa en gylden fod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 10,
      "text": "Som det hvide elfenbeen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 10,
      "text": "Hand er over alt saa reen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 10,
      "text": "Oversat med blaa saphirer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 10,
      "text": "Al fuldkommenhed ham zirer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 11,
      "text": "Vend dig bort, dit øyes lue",
      "part": false,
      "marginal_notes": [
        "Speaker: JEsus."
      ]
    },
    {
      "id": 53,
      "stanza_id": 11,
      "text": "Har min siel i lue sat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 11,
      "text": "Vil du hiertet reent udsue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 11,
      "text": "Hold dog lidet op, min skat!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 11,
      "text": "Vend dig, vend dig, din gestalt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 11,
      "text": "Har mig saaret over alt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 11,
      "text": "Vil du hiertet slet borttage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 11,
      "text": "Saa behold det alle dage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 12,
      "text": "Kom! i døden og i livet",
      "part": false,
      "marginal_notes": [
        "Speaker: Sielen."
      ]
    },
    {
      "id": 61,
      "stanza_id": 12,
      "text": "Er jeg din og dermed klar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 12,
      "text": "Dig aldeles overgivet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 12,
      "text": "Er jeg, hvad jeg er og har,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 12,
      "text": "Jeg, som ved dit blod er kiøbt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 12,
      "text": "Jeg, som paa dit blod er døbt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 12,
      "text": "Vil dig troe til døden blive.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 12,
      "text": "Amen, det vil JEsus give!",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
