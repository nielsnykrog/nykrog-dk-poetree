{
  "id": null,
  "title": "Prise vil vi den sommertid",
  "year_created": 1605,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Dronning Sophias visebog",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1605,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/DRSXVII.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Prise will wy den sommes thi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "med ørth de staande y grøde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "det lilige-blade staar alle min lide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "den saarige tuinge mig thiil død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: He-ia, he-ia. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Wore icke klaffuer, saa wore ieg glade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "de kunde baade lacke och føre;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "de før min kierest y allen stade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "de huiske i hend høre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": ":: He-ia, den saarige tuinge mig thiill thiill død. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Før lønlige saarige mitt hiert ber",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "før kierlige och gode wille",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "de maang små fule de haffue mig kiere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "de will de klaffue aat-skielle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": ":: He-ia, he-ia. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Det sist ieg min kierst saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "blant fru och høffuest staande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "it ønneblicke hund thiill mig saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "sidan maand ieg gleden faange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": ":: He-ia, he-ia, mit hiert haffue thiill hende laangeis. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "Det er ingin fulig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "thi ieg saa kuede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "det er en høffuest lile,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "huar den dag mit hiert giør glade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": ":: He-ia, he-ia, det maan iag før sanni sig. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "Nu er den wise queden fram,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "hun er well komen thiill ende;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "y leth ij skaale y dricke mig thiill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "sida wile wy gaa til senge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": ":: He-ia, he-ia. Gud giffue wort maalle en god enda. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}