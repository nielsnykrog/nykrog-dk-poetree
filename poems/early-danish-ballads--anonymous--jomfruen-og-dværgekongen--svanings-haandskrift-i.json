{
  "id": null,
  "title": "Jomfruen og Dværgekongen",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift I",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVI93.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Rider holder under busk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": ":: Der tiden giøris mig saa lang. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "och hand begynte att ynske",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Eya, huad sorigen du est tung! ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "\"Herre Gud giffue, ieg motte ynske saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "att ieg motte kongens datter foe!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Thett hørde duerigen, under buske:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "\"Dett skall rett aldrig vorde saa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "Ditt melte duerigen under grønen lyde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "\"Hun skall rett aldrig vorde din.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "Hør du, ryder hin rige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "vilt du hid till mig ryde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "Huad daa viltu giffue den mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 5,
      "text": "der teg kand fly kongens daatter till hand?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "\"Ieg vill giffue hannem guld och sølff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "och tage sielff, mens hand haffue vill.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "\"Huad da heder den iomfru rig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 7,
      "text": "der du ber for y hiertit kuide?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "\"Den iomfru heder iomfru Erme-rige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 8,
      "text": "sig mig, huor du est kommen hid?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "Sig mig, huad du est for en mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 9,
      "text": "di rame roner skriffue kand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "Ieg giiffuer dig dett guld saa rød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 10,
      "text": "viltu fly mig den vene møø.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "\"Rid bort, ryder, sig ditt ingen mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 11,
      "text": "y afften skall iomfruen komme dig tiill hand.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "Bort red ryder met saa fritt itt mod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 12,
      "text": "effter stod den duerig saa suige-fuld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "Duerigen suøber sitt hoffuit y skiend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 13,
      "text": "hand ganger y lofft for sin moder ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "\"Min kiere moder, y kiender mig rad:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 14,
      "text": "huor ieg skall kongens datter foe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "Hinder haffuer gillit en ryder rig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 15,
      "text": "herre, huor gierne ieg hannem sueg!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "\"Min kiere søn, glem ichi din gang:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 16,
      "text": "y afften vill iomfruen till afften-sang.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "Hand skreff ronner paa sponge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 17,
      "text": "som iomfruen skull offuer gange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 18,
      "text": "Hand skreff ronner paa stye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 18,
      "text": "som iomfruen skulle offuer ryde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 19,
      "text": "Syldig om afften, dag faldt paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 19,
      "text": "den iomfru tog offuer sig kobe bloe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 20,
      "text": "Den iomfru hun vilde till afftens-sang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 20,
      "text": "hun tog den stye, till biergit loe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 21,
      "text": "Iomfruen ind att biergitt tren,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 21,
      "text": "duerigen recher hinder handen igen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 22,
      "text": "Duerigen recker hinder huiden hand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 22,
      "text": "\"Huor er y kommen y disse fremmede land?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 23,
      "text": "Ditt suarit den iomfru met sorig-fuld sindee:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 23,
      "text": "\"Ieg vid rett aldiig, huor ieg er kommen her-ind.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 24,
      "text": "\"I haffuer eder en ryder loffuit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 24,
      "text": "och hand haffuer eder met roner bedragit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 25,
      "text": "I haffuer eder en ryder fest:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 25,
      "text": "y afften skall y vere duerigens giest.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 26,
      "text": "Om afftenen bleff hun y biergit der,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 26,
      "text": "om morigen fulde hand hinder till moder sin.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 27,
      "text": "Och ditt stod saa y otte aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 27,
      "text": "oc hinder ryder bedell bode till och fra.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 28,
      "text": "Hinder ryder bedell bode till och fraa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 28,
      "text": "ingen kunde god ansuar aff hinder faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 29,
      "text": "Hinder beder rige konger fem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 29,
      "text": "oc ingen vill hun haffue aff dem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 30,
      "text": "Hinder beder ryge greffuer ny,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 30,
      "text": "oc ingen vill hun haffue aff dy.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 31,
      "text": "Iomfru Ermerig och hindis moder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 31,
      "text": "saa ene syder di y dieris bure.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 32,
      "text": "\"Hør du, kiere datter min:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 32,
      "text": "och hui daa falffmer dine faffuere skind?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 33,
      "text": "Hui daa falmer din kiender saa?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 33,
      "text": "hui kand dig ingen ryder foe?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 34,
      "text": "Dig haffuer beditt konger och greffuer rige:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 34,
      "text": "hui lader du ingen vere din lige?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 35,
      "text": "\"Min kiere moder, vredis ichi vid:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 35,
      "text": "alle min sorig siger ieg eder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 36,
      "text": "Ditt duer iche at dulle for eder:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 36,
      "text": "den duerig-konge haffuer lochit mig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 37,
      "text": "Ieg haffuer mig y biergit inde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 37,
      "text": "VII sønner vid den duerig saa fin.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 38,
      "text": "Siuff sønner och end en dotter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 38,
      "text": "ieg dem rett aldrig met øgen saa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 39,
      "text": "Alt tenchte hun, di vor ene tho:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 39,
      "text": "alt stode den duerig-konge och lyde der-opaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 40,
      "text": "Oc hand slog hinder met elffuer-tre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 40,
      "text": "\"Du skøndt dig till biergit effter mig!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 41,
      "text": "Oc hand slog hende met elffuer-rod:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 41,
      "text": "\"Du skøndt dig till mitt egitt bure!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 42,
      "text": "Syldig om afftenen, dog drøff paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 42,
      "text": "den iomfru tog offuer sig kobe bloe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 43,
      "text": "Den iomfru tog offuer sig kobe bloe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 43,
      "text": "till hindis faders lofft saa mone hun gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 44,
      "text": "Hun klapitt paa loffuis-dør met sin skind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 44,
      "text": "\"Gode-natt, kiere fader och moder myn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 45,
      "text": "Gode-natt, fader oc moder min!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 45,
      "text": "min søster oc min broder!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 46,
      "text": "Och der-till venner flere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 46,
      "text": "och venner och frender till-lige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 47,
      "text": "Och segne eder Christ hin rige:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 47,
      "text": "y syer mig aldrig miere!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 48,
      "text": "Och segne eder alt dett, Gud haffuer skabt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 48,
      "text": "och beder løche saa vor mig act.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 49,
      "text": "Saa saare daa rand hinder taare paa kind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 49,
      "text": "der hun skulle skyldis fra moder sin.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 50,
      "text": "Saa slog hun offuer sig skarlagen-skind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 50,
      "text": "saa sorig-fuld gaar hun i biergit ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 51,
      "text": "Den iomfru ind y biergitt trend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 51,
      "text": "hindis VII sønner gaar hinder igen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 52,
      "text": "Den ungiste gaaer hinder gredendis imod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 52,
      "text": "den elste sette hinde hønde och stoell.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 53,
      "text": "\"Hør y, kiere moder min:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 53,
      "text": "hui da røbte y fader min?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 54,
      "text": "Saa sore daa rand hinder tore paa kiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 54,
      "text": "hun gade ichi suarit sønner sine.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 55,
      "text": "Hun gad dem icki suarit for sorig och nød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 55,
      "text": ":: Der tiden giøris mig saa lang. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 55,
      "text": "oc end før mydnat vor hun død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 55,
      "text": ":: Eya, sorigen, huad du est tung! ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}