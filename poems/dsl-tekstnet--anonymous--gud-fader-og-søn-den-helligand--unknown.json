{
  "id": null,
  "title": "Gud fader og søn, den helligånd",
  "year_created": null,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": null,
    "url": "https://tekstnet.dk/books/anon_gud-fader-og-soen-og-helligaanden-maa-han-velsigne-os/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Gudh Fadher och Søn, Then Heliandh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "han segnæ os met syn høghre handh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "och lesæ oss wdh aff Diffelsøns bandh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "bodhe leegh och lerdh j thette landh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "the tegh wel andh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Maria, modher och iomfrw klare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "hielp oss ath kommæ til Hemmerigis skare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Tha sywnghe wy alleluia,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "then mectusthe Gudh wyllæ wy paakallæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "han lather oss ey saa swarligh falle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "ath wy smaghe pynens beske galle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Kyrieleys, Christeleys.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Jhesu Christe, Gud Fadhers søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "tu loot tik thertil mødhe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "thi thu wasth meneskens besthe wen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "for hanum paa korsseth dødhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "befool thu thin andh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Maria, som stodh tik ner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "hwn giør oss tek j hierthet kier.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Tha siunghe wy alleluia,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "ath wy kwnnæ thertil nadhen faa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "styræ oss effther Gutz wyliæ saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "ath wy maa æren j hemmerigh naa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "Kyrieleys, Christeleys.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "I hælighe englæ j høysthe koor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "wy bedhe edher och fulgiernæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "som met Gudh j Hemmerigh boor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "J oss beskermæ och wernæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "then ledhe gram.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "Maria, bedhe wy til met",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "aff thyn søn forwerwe oss thet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "ath siunghe alleluia,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "ath blywe til siælen bodhe saligh oc sundh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 2,
      "text": "Saa tyænæ wy Gudh j all wor tiidh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 2,
      "text": "ath han bliwer oss bodhe mildh oc blydh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 2,
      "text": "Kyrieleys [etc.]",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "met patriarcher oc prophete,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "Christi fødels met lysthæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "J lenge besporda och lethæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "Thu glædis wydh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 3,
      "text": "ath Ihesus wor innen Maria.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 3,
      "text": "Oss bør them bwæ och neyæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 3,
      "text": "ther wy siunghe alleluia,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 3,
      "text": "alleluia, then listeligh sangh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 3,
      "text": "Gutz bwdhordh reth ath høræ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 3,
      "text": "them fulkomæ och giøræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 3,
      "text": "Kyrieleys [etc.]",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 4,
      "text": "Appostel och ewangelisth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 4,
      "text": "wskilligh børn som æra met Cristh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 4,
      "text": "och alle Gutz serdeles wenner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 4,
      "text": "I bedhe for oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 4,
      "text": "Then renæ rooss,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 4,
      "text": "ath wy ey kommæ j Diefflens snare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 4,
      "text": "Tha siunghe wy alleluia,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 4,
      "text": "alleluia met hierthens glædhe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 4,
      "text": "ath wendhe fra oss Wors Herræ wredhe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 4,
      "text": "j Hemerigs righe ath fonghe room.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 4,
      "text": "Kyrieleys, Christeleys.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 4,
      "text": "[Etc.]",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 5,
      "text": "Martires, for edher pynæ och dødh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 5,
      "text": "Frelsæ oss wdh aff all wor nødh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 5,
      "text": "i æræ och twcth oss giømæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 5,
      "text": "Modh Diefelsøns kraffth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 5,
      "text": "I fly oss makth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 5,
      "text": "thet sorfull swerdh jgemmen tik gik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 5,
      "text": "lath siunghe oss alleluia,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 5,
      "text": "alleluia met ynngelighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 5,
      "text": "thertil faa fornwmstighedh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 5,
      "text": "wel forwynnæ thet oss er imodh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 5,
      "text": "Kyrieleys [etc.]",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 6,
      "text": "versus Besper, presther, confessor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 6,
      "text": "och mwnker och heremitæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 6,
      "text": "som kalles annachorite,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 6,
      "text": "all ondh wyliæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 6,
      "text": "jfran oss skilliæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 6,
      "text": "Maria, ladh oss then løcke ske,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 6,
      "text": "Tha siunghe wy alleluia,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 6,
      "text": "alleluia, then sang sa ween,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 6,
      "text": "ath lewe forwdhen skiensels meen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 6,
      "text": "Sa stiræ wore ordh och synnæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 6,
      "text": "Kyrieleys [etc.]",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 7,
      "text": "versus Iomfrwer, møør och wyduæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 7,
      "text": "J hæligh, werdigh skaræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 7,
      "text": "ath wy Gutz blyde anlæth maa see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 7,
      "text": "wære oss til wyllæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 7,
      "text": "ther oss giør illæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 7,
      "text": "Hielp, Maria, renæ møø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 7,
      "text": "ladh os ey j sindhen døø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 7,
      "text": "alleluia, met hierthens fryd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 7,
      "text": "eth goth reth leffwen met andher dydh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 7,
      "text": "wskikkelighedh maa wendis oss fra,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 7,
      "text": "som siel och liff ligher mack oppa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 8,
      "text": "versus Alle hellien i Hemmerigh kalle wy oppa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 8,
      "text": "the ladhe oss ey forwordhe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 8,
      "text": "ath wy ey j sindhen forgaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 8,
      "text": "ther kroppen stundher til iordhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 8,
      "text": "the ladhe oss wynnæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 8,
      "text": "Hielp, Maria Modher, tha snarth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 8,
      "text": "met them j Hemmerigh ath fanghe parth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 8,
      "text": "Tha siunghe wy alleluia,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 8,
      "text": "met them j Hemmerigh ath fanghe ther løn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 8,
      "text": "som han iæth synæ wenner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 8,
      "text": "the hanum met troskap tyæner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 8,
      "text": "Kyrieleys [etc.]",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 9,
      "text": "som pynes for edher brødhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 9,
      "text": "Ihesus Christus blywe edher myldh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 9,
      "text": "for edher paa korsset dødhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 9,
      "text": "Hans helly fem saar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 9,
      "text": "Maria hwn thedhe syn spener",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 9,
      "text": "och frelsæ aff pynæ al wore wenner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 9,
      "text": "tha siunghe wy alleluia,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 9,
      "text": "alleluia, then sangh soa boldh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 9,
      "text": "Kommæ ther the faa hwylæ och roo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 9,
      "text": "sydhen met Gudh i Hemmerigh boo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 9,
      "text": "Kyrieleys [etc.]",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 10,
      "text": "Syndyghe meniske j werdhen lewe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 10,
      "text": "Gudh han wyl edher wenskap giuæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 10,
      "text": "och allæ edher syndher forladhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 10,
      "text": "Met mack och mwæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 10,
      "text": "j syndhen rwæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 10,
      "text": "som rowæren paa korsset gaff til trøøsth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 10,
      "text": "Tha siunghe wy alleluia,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 10,
      "text": "alleluia til Ihesum, wor brodher,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 10,
      "text": "thertil hielp, Maria Modher.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 10,
      "text": "the ladhe oss ey i møstrøsth fallæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 10,
      "text": "Kyrieleys [etc.]",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 11,
      "text": "Thennæ wysæ I hawæ nw hørth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 11,
      "text": "then skullæ I kierlighe læræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 11,
      "text": "Gudh lathe them lewæ met æræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 11,
      "text": "met syn och skiel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 11,
      "text": "regeræ seg wel.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 11,
      "text": "Maria willæ wy tilseyæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 11,
      "text": "Tha siunghe wy alleluia",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 11,
      "text": "alleluia met yngelig listh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 11,
      "text": "wyllæ wy siunghe bodhe førsth och systh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 11,
      "text": "til wy faa æryns krwnæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 11,
      "text": "Kyrieleys, Christeleys.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 11,
      "text": "Then Hælliæandh, hielpp oss i all wor reys.",
      "part": false,
      "marginal_notes": []
    }
  ]
}