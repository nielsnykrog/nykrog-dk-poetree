{
  "id": null,
  "title": "Stolt Signild og Dronning Sofie",
  "year_created": [
    1590,
    1591
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Anna Munks Håndskrift",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1591,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/MUNK44.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Det er y natt voge-natt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "der vaager y-huem som vill:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": ":: der vogner hinn stolthenn Segnillildt unnder saa grønenn. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Staltt Metthelille spurde sinn moder saa bratt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": ":: Der vaager y-huem som vill! ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "\"Maa ieg gaa att vaage y natt?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": ":: Der voger hinn stolthenn Signild under saa grønenn. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "\"Huad viltu thill vogestuffue giøre?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "du haffuer der huerckenn søstre eller brødre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "Och huerckenn brødre eller fester-mannd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "icki skalthu thill voge-stuffue gannge.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "Saa lennge badt den iomffru finn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 4,
      "text": "dett hunn fick louff aff moder synn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 5,
      "text": "\"Du gack, du gack nu, daatther minn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 5,
      "text": "thill vogestuffue gick aldrig moder dynn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "Der kommer konngen och alle hanns mennd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 6,
      "text": "lyder du mitt raadt, tha bliffuer du hieme.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 7,
      "text": "\"Der kommer droningen medt alle sine møer:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 7,
      "text": "minn moder, loffue mig mett dennom att thalle!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 8,
      "text": "\"Thu gack, du gack nu, dather minn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 8,
      "text": "thill voge gick alldrig moder dinn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 9,
      "text": "Hunn gick sig y burde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 9,
      "text": "saa monne hunn thill voge-stuffue gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 10,
      "text": "Hun satte guld-krone offuer udslaget haar:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 10,
      "text": "saa monne hunn thill voge-stuffue gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 11,
      "text": "Ther hunn kom offuer grønenn eng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 11,
      "text": "da var droningen ganngenn thill senng.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 12,
      "text": "Ther hunn kom thill borge-leedt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 12,
      "text": "beder-danndtz den gick der-vedt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 13,
      "text": "Ther danndtzer alle dy kongens mend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 13,
      "text": "sielff tradt konngenn dandtz for dem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 14,
      "text": "Konngenn reckitt hannd haannd fra sig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 14,
      "text": "\"Ville y, skiønne iomffru, danndtze huos mig?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 15,
      "text": "\"Ieg er ganngenn her offuer dall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 15,
      "text": "for ieg vill med dannske droninng thalle.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 16,
      "text": "\"I danndtze mett oss enn liidenn stund!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 16,
      "text": "saa maa y thill droninngenn gannge.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 17,
      "text": "Frem gick Signildt, small som vannd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 17,
      "text": "hun gaar y danndtz huos konngenns haanndt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 18,
      "text": "\"Hør du, stalthenn Signillille, huad ieg siiger dig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 18,
      "text": "enn elskoenns-vise da queder du mig!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 19,
      "text": "\"Enn elskoenns-viise ieg aldrig nam:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 19,
      "text": "ieg queder enn anndenn, som ieg kanndt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 20,
      "text": "Staltt Signelille begønnte enn viise att quede:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 20,
      "text": "dett hørde droninngenn, y loffthenn laa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 21,
      "text": "Thett melthe droninngenn, y loffthenn laa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 21,
      "text": "\"Huilckenn aff mine iomffruer queder visenn saa?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 22,
      "text": "Huilcken aff mine iomffruer danndtzer saa lenge?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 22,
      "text": "huy fulde dy mig icke y sennge?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 23,
      "text": "Thett suaritt denn suenndt udi kiortell rødt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 23,
      "text": "\"Dett er icki aff eders møer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 24,
      "text": "Thett er icki aff eders møer:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 24,
      "text": "dett er stalthenn Signild unnder øø.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 25,
      "text": "\"I thager mig hidt minn skarlagenn smaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 25,
      "text": "ieg skall gaa buortt, denn iomffru att skoe.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 26,
      "text": "Der hunn kom thill borgeledt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 26,
      "text": "beder-danndtz saa gick der-vedt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 27,
      "text": "Tøsser danndtzitt dy denn danndtz omkring:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 27,
      "text": "altt stodt droningenn och saa paa hennde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 28,
      "text": "Thett thøckthe droninngen verre stuor vand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 28,
      "text": "dett Signillille danndtzett vedt konngens haanndt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 29,
      "text": "Sophiæ thaller thill thienniste-quinnde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 29,
      "text": "\"Hennthe du mig itt huornn mett vinn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 30,
      "text": "Hennthe du mig itt horn saa høytt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 30,
      "text": "lad thett verre med ieder støtt!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 31,
      "text": "Konngenn racte hannd haanndt fra syg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 31,
      "text": "\"Vill y, Sophia, danndtze huos mig?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 32,
      "text": "\"Icke der ieg danndtze vill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 32,
      "text": "førennd stalthen Signild dricker mig thill.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 33,
      "text": "Hunn holthe thett thill munde, och ud hun drac:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 33,
      "text": "ett uskyldige hierthe y brøstett sprack.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 34,
      "text": "Lennge stod konngenn, hannd saa der-paa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 34,
      "text": "iomffruenn for hanns føder laa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 35,
      "text": "\"Rett aldrig saa ieg enn venner møe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 35,
      "text": "saa uskyldige komme thill sin dø!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 36,
      "text": "For hennde græd møer och guode quinnder:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 36,
      "text": "dy bar henndis lig y kirckenn ynndt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 37,
      "text": "Haffde hun lyd sinn moders raadt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 37,
      "text": ":: Der voger y-huem som vill! ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 37,
      "text": "thett haffde hennde icki saa ilde gaaitt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 37,
      "text": ":: Der vaager hinn stalthenn Signilldt under saa grønenn. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}