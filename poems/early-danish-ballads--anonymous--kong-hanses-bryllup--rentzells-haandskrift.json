  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Koning Hans hand seder paa kiøbinhaffn, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hand lader the lønne breffue schriffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "sender | hand thennum tiill Nørild land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "her Eriick | Otteszen att giffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: ther kom aldriig saa riig | En Iomffruue till Dannmark | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Dett wor her Eriick Ottesz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "ther hand | the lønne brieffue saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "hand kaste the | therning, och skiød warthaffuell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "och bad | sadell sin gunger graae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": ":: Och ther kom | Aldriig saa riig enn Iomffrue till | Danmarck | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "B |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "The ledde wd hans høge hest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "lagde po | forgiltte mÿlle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "End red hand till Kiøbenhaffn |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "førind hanum løste att huile.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": ":: O. th: k. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "Ind kom her Eriick Otteszen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "och stedhis hand | for bord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "huad wiille ÿ mig min Nadiig herre |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "hui haffuer ÿ send mig ordtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": ":: O t k A s. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "Hør ÿ her Eriick Otteszen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "i Er vor egenn | Mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "ÿ schulle fare tiill Miszenn ÿ aar |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Och bede om then lilie vandtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 4,
      "text": ":: O. t. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "Dett wor her Eriick Otteszen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "hand bliff | saa bratt att suare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "skall ieg Ind tiill | Miszen i aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": "Ieg kand icke enne fare, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "Her Wernner Pasbieriig aff Holbeck husz |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "skall mett ether fare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "her Claus Rønu aff | Oringboriig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": "ether følger saa faffuer en skare, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 6,
      "text": ":: d. k. A. s R en I. t D. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "Thy wantt op thieriis silckesegell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 7,
      "text": "sza | høgtt i forgildene raa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": "Dannebrog i framer | staffuen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 7,
      "text": "dj lod thiill Miszeren staa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 7,
      "text": ":: d.k. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 8,
      "text": "Kurenn stander paa høffuen wern,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 8,
      "text": "och | seer hand wd ÿ strande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 8,
      "text": "Ieg seer saa | mange aff danske skib,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 8,
      "text": "de føre forgildene | brande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 8,
      "text": ":: d. k. A. s. R. e. I. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 9,
      "text": "Ieg seer saa mange aff danske skib,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 9,
      "text": "the | føre forgildene brande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 9,
      "text": "Christ signe then | lidenn kierstenne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 9,
      "text": "the agther ether till hande, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 10,
      "text": "Kaste the theriis acker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 10,
      "text": "poo then huide sandtt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 10,
      "text": "the Edeliig riider aff Dannemarck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 10,
      "text": "the thren | ther først ÿ Landtt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 10,
      "text": ":: d. k. a. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 11,
      "text": "Mitt vdj then gaarde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 11,
      "text": "ther agseller thi theris | skind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 11,
      "text": "Och saa ganger thj ÿ høffuen lofftt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 11,
      "text": "for hertog aff Miszeren Ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 11,
      "text": ":: Och ther kom, | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 12,
      "text": "Hell siider i hertog aff Miszernn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 12,
      "text": "och i och | ethers kiere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 12,
      "text": "then vng koning aff danne-marck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 12,
      "text": "beder om ethers dother mett ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 12,
      "text": ":: d.k. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 13,
      "text": "Hand thog vd thj lugtte brieff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 13,
      "text": "och leste hand | ther po,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 13,
      "text": "loff were gud fader i himmeriig |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 13,
      "text": "ieg then datther aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 13,
      "text": ":: d. k. a. s. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 14,
      "text": "I Edeliig Riider i thager i wandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 14,
      "text": "och | i gaar ether tiill bordtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 14,
      "text": "thøffuer ÿ thiill | morgen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 14,
      "text": "wÿ wiider ether Andsuar guodtt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 15,
      "text": "Di wor ther ÿ maanitt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 15,
      "text": "och the wor | ther ÿ thre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 15,
      "text": "icke kunde the Iomffrue | kierstine",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 15,
      "text": "mett theriis øgen see |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 16,
      "text": "Dagenn dagiis østen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 16,
      "text": "och bølgen bleszer | blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 16,
      "text": "the edeliig riider aff danemarck",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 16,
      "text": "the | gaar for hertogen att staa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 16,
      "text": ":: d. k: s: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 17,
      "text": "Dagen dagiis østenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 17,
      "text": "och bølgen bleszer ÿ | landtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 17,
      "text": "then vnge koning beer soriig | for oss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 17,
      "text": "att wÿ er suncken, ÿ strandtt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 18,
      "text": "Dett wor hertog aff Miszernn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 18,
      "text": "handtt | kalder po rider sine,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 18,
      "text": "beder i Iomffrue | kiersten,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 18,
      "text": "att hun ganger y stoffuen Indtt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 18,
      "text": ":: d.k. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 19,
      "text": "Otte wor the miszers Fruuer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 19,
      "text": "hindis hoer, bode | , børste och flete,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 19,
      "text": "thett wor IIII førsterinder, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 19,
      "text": "hendis hoffuett guld po sette,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 19,
      "text": ":: d. ko: a. s. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 20,
      "text": "De satte hinde thett hoffuettguld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 20,
      "text": "thett skinnett som en | loffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 20,
      "text": "thett waar well giortt ÿ VIII suig bur |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 20,
      "text": "altt offuer then skiønne Ioffrue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 20,
      "text": ":: d.k.a | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 21,
      "text": "Dett var lidenn kierstenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 21,
      "text": "hun Ind att døren | threin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 21,
      "text": "hindis fader och hindis farbrøder | thre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 21,
      "text": "dj stander hinder op igienn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 21,
      "text": ":: d. k. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 22,
      "text": "Hindiis fader och hindis farbrøder thre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 22,
      "text": "the | stander hinder op igien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 22,
      "text": "the Edele rider | aff danemarck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 22,
      "text": "the ragtte hinder handen igen, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 23,
      "text": "Dett vor hertog aff miszern,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 23,
      "text": "hand thaller | tiill riiderne sine,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 23,
      "text": "hinther y terning, och | warthaffuell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 23,
      "text": "I ber thett ÿ stoffuen Inndtt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 23,
      "text": ":: d. k. a. s r. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 24,
      "text": "Hertog hannd kaste the therning fra siig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 24,
      "text": "the | vor aff rødenn guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 24,
      "text": "ÿ kaster her Werner | Pasbieriig, førind ieg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 24,
      "text": "i kongenhuldtt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 25,
      "text": "Dett vor her Werner Pasbieriig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 25,
      "text": "handtt | kaster thij therning fra siig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 25,
      "text": "kaster ÿ her | Claus Rønu",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 25,
      "text": "ÿ er Eldre Ind ieg. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 26,
      "text": "Dett vor her Claus Rønu,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 26,
      "text": "hand skiød dj | terning fra siig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 26,
      "text": "kaster danemarckis | hoffmester, før ieg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 26,
      "text": "ether bør langtt for | ieg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 26,
      "text": ":: d. k. a. s. R e I t D | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 27,
      "text": "Dett vor her Eriick Othesz",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 27,
      "text": "tog therning | i sin hand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 27,
      "text": "hielp gud fader ÿ himeriig |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 27,
      "text": "then lilie thiill dannemarckis handtt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 28,
      "text": "Thenn første therning po thaffuelbordtt | randtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 28,
      "text": "saa well mett ærre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 28,
      "text": "her Eriick | Otteszin wantt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 28,
      "text": "then skiønne Iomffru, tiill | koningens hierthens kiere |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 29,
      "text": "Lenge stod Iomffrue kierstenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 29,
      "text": "tiill hinde | rand thor po kindtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 29,
      "text": "schall ieg fare tiill | danemarck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 29,
      "text": "saa lanngtt Fra fader min |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 30,
      "text": "Dett vor hertog aff Miszernn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 30,
      "text": "hand thager | sin datther att lere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 30,
      "text": "thett wiill ieg forsanden | siige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 30,
      "text": "thett wor altt mett ære. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 31,
      "text": "Wer kier att Ider och schoninger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 31,
      "text": "thÿ | ere, buode thriige och throff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 31,
      "text": "stund thu | aldriig epther Sueriig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 31,
      "text": "thett er ick lett att | faae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 31,
      "text": ":: d. k. a. s. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 32,
      "text": "Bedtt gott for fattiige Encker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 32,
      "text": "som fader-løsbørn skall føde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 32,
      "text": "Bedtt gott for fattiig | fanger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 32,
      "text": "lad ingen i thornitt dø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 32,
      "text": ":: d. k. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 33,
      "text": "Skattu icke thij fattiige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 33,
      "text": "ieg thett icke haffue | wiill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 33,
      "text": "fattiis thig anthen guld eller | sølff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 33,
      "text": "thu siig thin fader thiill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 33,
      "text": ":: d k. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 34,
      "text": "Dett tha vor then sortte Iord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 34,
      "text": "hun vor | mett silcke bredtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 34,
      "text": "thett wor Iomffru | Kierstin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 34,
      "text": "hun bleff tiill stranden ledtt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 35,
      "text": "Dij blest i theriis thromether,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 35,
      "text": "i theriis | forgildenne liudtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 35,
      "text": "thij fulde then frøgcken | thiill strande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 35,
      "text": "dj kallitt hinde danemarcks | brudtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 35,
      "text": ":: d k. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 36,
      "text": "Saa wanntt thj op theriis silcke siigell, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 36,
      "text": "saa høgtt ÿ forgildene raae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 36,
      "text": "saa siiglitt | thj thill dannemarck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 36,
      "text": "Och minder Ind | maanitt thoff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 36,
      "text": ":: d. k. a. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 37,
      "text": "Kaste the theriis acker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 37,
      "text": "po then huide | sandtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 37,
      "text": "thj edle Rider aff danemarch |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 37,
      "text": "dj løffthe then Iomffru po landtt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 38,
      "text": "Dee møtthis po then grøne woldtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 38,
      "text": "Christ | giffue thett bliffuer thil gaffn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 38,
      "text": "then | herre fra hest, then Iomffru fra | karum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 38,
      "text": "thij thog huer Andre ÿ Arm |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 38,
      "text": ":: der kom aldriig saa riig en Ionffru | till danemarck. | ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}