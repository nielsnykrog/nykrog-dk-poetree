  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Iegh haffuer formærcht at møgel macht",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hwn bliffuer ey lengæ ved en pacht.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Thet fich iek at se then same thijd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "tha Otthen, myn fadher, bleff slawen i stryd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "the fwldhe meg fra so offuerbrath.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Thydeskæ fik ieg bestrydh igen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "meth Wbbæ hyn sterke, myn gode wen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Iegh døde aff soth oc ey aff slagh,",
      "part": false,
      "marginal_notes": []
    }
  ]
}