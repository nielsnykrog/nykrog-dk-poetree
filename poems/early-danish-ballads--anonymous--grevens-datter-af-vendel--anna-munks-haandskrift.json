{
  "id": null,
  "title": "Grevens Datter af Vendel",
  "year_created": [
    1590,
    1591
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
