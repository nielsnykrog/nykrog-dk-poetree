{
  "id": null,
  "title": "24. Amled, Røriks dattersøn",
  "year_created": 1495,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Rimkrøniken",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1495,
    "url": "https://tekstnet.dk/books/anon_rimkroeniken/027/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Ieg throer och wed ful wel tijl gørst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "at thet ær snylhed alsom størst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "hwor man kan ey kome frem meth mackth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Thet kunne ware et stoort wskæll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "myn faderbrodher slo myn fader ihiell.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "So hade han och tencth at giord vedh meg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "och lod som ieg hade været wiss,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "tha hade han myrd meg som en grijss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "So togh han seg tha modher myn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "och hade henne sien tijl husfrw syn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "i arnen paa hweriæ lem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Ther giorde ieg krogæ bode nat oc daw",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "och ladhe them bort fwlwel i law.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Ihwo som meg fich ther at sporth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "ieg sade: »Ieg skall myn fadhers død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "heffne thermeth før ieg ode brød.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Therfore tha bar han vedh meg iæff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "han troode mich illæ alt som en ræff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "at han skullæ fongæ at vide tijl vissæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "om ieg wor daarskær som ieg lodh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "eller ieg giorde thet aff widerlicth modh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "Først lod han meg sættæ paa en hest",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "Han meg tijl skowen vdføre lodh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "och visdhe meg ther en kone imodh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "Men tha ieg sadh paa hesthen op,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "ieg vende myg ffra hans endetop",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "»how, how,« sade ieg, »myn gode perth.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "Tha the som hoss ware, mwnne thet ssee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "tha thogæ the allæ tijll ath lee.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "Men ieg holt meg alligæ thøst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "Tha wi kome fram i skowen bæder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "saa stor en wlff møtthæ voss ther.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 0,
      "text": "Tha sade en meg som hoss meg wor:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 0,
      "text": "»See ther, hwilken en hest ther gor.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 0,
      "text": "sodan en hest paa syn stoldh.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 0,
      "text": "Som wij komme bort tijl then strandh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 0,
      "text": "wij funde eth styre paa then sandh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 0,
      "text": "The sade thet war then størstæ kniff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 0,
      "text": "Ieg gaff them ther tijl swar meth skeell:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 0,
      "text": "»Ther hører ful stort eth fflycka tijl.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 0,
      "text": "Tha wij komme harth nedh tijl then strand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 0,
      "text": "tha tog ieg aff then hwide sand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 0,
      "text": "»Alth meel,« sade the meg for et swar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 0,
      "text": "Tha swarede ieg them saa igen:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 0,
      "text": "»En wædermøllæ haffuer thet malet, ieg men.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 0,
      "text": "So fulde the meg bort tijl en bood",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 0,
      "text": "Saa gingæ the bort oc stode paa skywll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 0,
      "text": "om stwbbæ, oc annen i hulsther oc dwll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 0,
      "text": "om ieg hade noget wedh konen giorth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 0,
      "text": "Som ieg hade hennæ oc entheth sporth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 0,
      "text": "giffuit meg thegen, han wor ey seen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 0,
      "text": "ath ieg skullæ see meg wel omkring",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 0,
      "text": "och lade megh ey kænne meth lidhen ting.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 0,
      "text": "Omkring en bremss bant han eth straa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 0,
      "text": "Ieg kunne thermeth formærchæ paa stand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 0,
      "text": "ath ther wor swig oc falsk i bland.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 0,
      "text": "Thi tog ieg konnen oc lede henna borth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 0,
      "text": "om stubbæ och annen, the wistæ ey hurth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 0,
      "text": "Hwer annens wiliæ giorde wij tha ther.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 0,
      "text": "Ieg badh hennæ thiæ oc gyffuet ey gem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 0,
      "text": "som hwn oc giorde ther hwn kom hiem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 0,
      "text": "Ther ieg kom hiem tha meth en faarth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 0,
      "text": "Om ieg hade noget wedh konen giorth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 0,
      "text": "som han hade aff myne stolbrøder sporth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 0,
      "text": "Tha sade ieg thertijl genesthen iaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 0,
      "text": "»Hworpaa lowe I?« sade han thaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 0,
      "text": "wij haffde ey klædher eller annen dwss,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 0,
      "text": "och sidhen paa en hanekom",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 0,
      "text": "oc paa hoffuen aff en hest, wel from.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 0,
      "text": "Tha stodh ther hwer annen och loo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 0,
      "text": "So spurde han synderlig konen ath",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 0,
      "text": "om ieg hade sidet meth henne tijl fadh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 0,
      "text": "Hwn sade thet hade ey wæret vthen last",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 0,
      "text": "at tagæ thet aff then galnæ gast.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 0,
      "text": "at han skullæ wide myn hiarthens grundh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 0,
      "text": "Han lucthæ meg meth myn moder i huss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 0,
      "text": "och lade ther innæ en karll i dwss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 0,
      "text": "at han skullæ liggæ thervedh then iordh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 0,
      "text": "Tha wi komme bode i huseth ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 0,
      "text": "tha worth ieg æn saa tijl sind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 0,
      "text": "Ieg spranck ther op wppaa en stooll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 0,
      "text": "och sammen slo myne hender oc gool.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 0,
      "text": "oc fandh ther genesthen hwor karlen laa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 0,
      "text": "Tha begynthæ myn modher at grædæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 0,
      "text": "ath ieg skulle ware tijl sind so flædæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 0,
      "text": "»Gredh for theg selff,« sade ieg, »forthy",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 0,
      "text": "meth then som slo thyn hosbund ihiell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 0,
      "text": "myn kæræ fadher, fforvthen skeell.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 0,
      "text": "Hadæ thet ickæ waret at ieg saa goll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 0,
      "text": "tha hade ieg ickæ nw set sooll.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 0,
      "text": "hwi skullæ han sparæ syn brodhers søn?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 0,
      "text": "Hans dødh ieg ey forgløme will",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 0,
      "text": "nar ieg kan fangæ ther lemppe tijll.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 0,
      "text": "Saa tog ieg karlen i halmen loo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 0,
      "text": "Saa kastæ ieg hannum meth handen myn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 0,
      "text": "i gømmen eth hysken nedh for swyn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 0,
      "text": "Ther ode the hannum alsammen opp",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 0,
      "text": "med ben oc bruskæ, skynd oc kropp.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 0,
      "text": "tha spurde han fast hwor karlen waar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 0,
      "text": "Han spurde och meg om ieg hannum saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 0,
      "text": "»Ieg saa hannum,« sade ieg, »tijl hysken gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 0,
      "text": "Ther falld han nedh meth skynd oc krop,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 0,
      "text": "Thertijl begynttæ the alle ath lee",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 0,
      "text": "och holdhæ thet alt ffor spott och spee.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 0,
      "text": "Ther næst han meg tijl Ængæland screff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 0,
      "text": "och bød saa koningen meth bud oc breff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 0,
      "text": "och bodæne skullæ han faffne well.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 0,
      "text": "Om nathen ther the soffue harth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 0,
      "text": "tha gik ieg tijl alt meth en farth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 0,
      "text": "Ieg tog vdh the runæthræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 0,
      "text": "Ieg screff at han skullæ hænga the budh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 0,
      "text": "och giffue meg so syn dotther tijl brudh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 0,
      "text": "Tha wi komme tha meth koningen tijl ordh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 0,
      "text": "saa bødh han oss meth seg tijl bordh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 0,
      "text": "for dricken oc madhen vor ey godh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 0,
      "text": "Om affthenæn ther ieg skullæ i sængh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 0,
      "text": "i herbæryth hade han wijst en drengh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 0,
      "text": "ath han skullæ liggæ oc lyde therpaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 0,
      "text": "Tha spurde meg først myn stolbroder ath",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 0,
      "text": "hwi ieg bar lede vedh øll oc math.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 0,
      "text": "»Aff manneblodh smagede alt thet brødh,«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 0,
      "text": "sade ieg, »thesligest giorde oc thet kødh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 0,
      "text": "och lucthæde theraff bode nær oc fiærn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 0,
      "text": "Ieg siær edher thet foruthen drudh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 0,
      "text": "kongen seer aff ij thrælssøwen vdh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 0,
      "text": "Thrændæ storæ slemhetz theghen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 0,
      "text": "Tha drenghen fick thet for konghen sawth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 0,
      "text": "the ordh som wij hade samen hawth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 0,
      "text": "han sade ieg wor encthen megeth klogh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 0,
      "text": "eller ieg foor aldels meth hiogh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 0,
      "text": "hwar thet same korn opwaxen waar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 0,
      "text": "som thet same brødh war baget aff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 0,
      "text": "och hwat som kødheth stod tijl straff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 0,
      "text": "Han spurde oc hwor the fyngæ thet vandh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 0,
      "text": "Tha funde the thet om kornit saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 0,
      "text": "ath marken fuld meth dødhe men laa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 0,
      "text": "forti ther hade en fordum dag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 0,
      "text": "wæryth eth mecthigt orloff oc slag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 0,
      "text": "hade ædet en dødh man aff en graff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 0,
      "text": "I brønden som the mwnne wanneth faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 0,
      "text": "saa mangæ rwstich swærdh i laa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 0,
      "text": "Tha kongen hade fundet at thet vor santh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 0,
      "text": "Han nøddhe syn modher meth høtzel oc listh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 0,
      "text": "ath vndherwysæ hannum syn fadher tijl wisth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 0,
      "text": "Hwn kændes han wor en fatig swen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 0,
      "text": "dog wor han deylig nog for en.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 0,
      "text": "som ieg hade merth paa drotninghens vegen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 0,
      "text": "Thet førsta sade ieg aff visdom myn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 0,
      "text": "wor thet hwn skywlde meth koben syn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 0,
      "text": "sith howeth som en tærne ffwll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 0,
      "text": "Thet annet wor hwn giorte seg saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 0,
      "text": "som pygher the plæye i stegers at gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 0,
      "text": "Tredie hun stanghet syne tendher paa straa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 0,
      "text": "och raaerkaal odh som for hennæ laa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 0,
      "text": "han holt meg for en wiser mandh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 0,
      "text": "Han gaff meg genesthen dotther syn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 0,
      "text": "och lod ophengæ stolbrodher myn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 0,
      "text": "Tha lod ieg som ieg wor therfor wred",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 0,
      "text": "Ther gaff han meg fore megeth gwldh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 0,
      "text": "ieg støfftæ theraff too staffue fwldh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 0,
      "text": "Wdij myne hendær tog iegh them,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 0,
      "text": "saa for ieg thædhen tijl Danmark hiem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 0,
      "text": "the druckæ mith ærfwe oc giorde gywss,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 0,
      "text": "som myn modher oc iæg haffde sammen ord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 0,
      "text": "ffør ieg vdh tijl Ængæland ffor.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 0,
      "text": "Tha sade myn steffader oc sade tijl meg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 0,
      "text": "Tha racthæ ieg fram myne staffue meth gwldh:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 0,
      "text": "»Hær æræ the bode, so worde meg hwldh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 0,
      "text": "Thoor, myn gudh, oc Otthen meth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 0,
      "text": "i hweryæ stund oc hweryæ stæth.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 0,
      "text": "ath thet samfwndh wor ffor meg giort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 0,
      "text": "»Tha bør meg falket at gøre glath,«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 0,
      "text": "sade ieg, »alth inthil medynath.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 0,
      "text": "Thi bant ieg op mith swerd saa bolth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 0,
      "text": "Som ieg ther gik oc skæncthe thet wijn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 0,
      "text": "mith swerdh fall vdh aff balyen syn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 0,
      "text": "och skar meg nogeth vdi myn handh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 0,
      "text": "Thi sætthæ ieg thet igen paa standh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 0,
      "text": "ath thet skullæ inghen gøre meer øm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 0,
      "text": "Saa giorde ieg saa drwckæt folk aff wyn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 0,
      "text": "ther laa then enæ paa annen som swyn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 0,
      "text": "Saa tog ieg alle sperlagen nødh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 0,
      "text": "Saa henthæ ieg tha mynæ krogæ indh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 0,
      "text": "som ieg hade giorth effter myth syn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 0,
      "text": "Ther koblædæ ieg them alle sammen vdy",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 0,
      "text": "at en kunne ey ffor annen ffly.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 0,
      "text": "och giorde them ther fulondhen gywss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 0,
      "text": "Saa gik ieg wp som myn steffadher laa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 0,
      "text": "ieg togh hans swærdh som ther mwnne staa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 0,
      "text": "och sættæ mith swærdh i stædhen igen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 0,
      "text": "»Woge wp,« sade ieg, »thet ær nw thijd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 0,
      "text": "ath holde reghenskapp om gamel ydh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 0,
      "text": "Tyne gode men liggæ nw brende i glødh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 0,
      "text": "Ieg wil nw hæffne myn fadhers dødh.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 0,
      "text": "som stodh alth ænde hans howetgærdh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 0,
      "text": "Men han tha ffast paa swerdeth droo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 0,
      "text": "ieg hannum snarlig tijl døde sloo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 0,
      "text": "Thereffter ieg ickæ tijl synæ kom",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 0,
      "text": "Ieg fick thet spurt the øncket myn nød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 0,
      "text": "och mesthen wore glade at han wor død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 0,
      "text": "Ieg ffor meth myne wenner tijl tingh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 0,
      "text": "och kærde myn nødh trynth omkringh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 0,
      "text": "the keyssde meg tijl theris koning paa stand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 0,
      "text": "So lodh ieg scriffue vdi myn skioldh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 0,
      "text": "forscreffne myne gerninger so mangæffoldh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 0,
      "text": "So seylde ieg tha tijl Ængaland igen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 0,
      "text": "Tha ieg kom offuer hennes faders bordh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 0,
      "text": "han tha ffornam aff nogher myne ordh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 0,
      "text": "at ieg hade slawet myn steffader ihiell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 0,
      "text": "hwilketh hannum ickæ ynthes wel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 0,
      "text": "ath hwilken aff them som sloffues meth macth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 0,
      "text": "tha skullæ then annen hæffne hans dødh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 0,
      "text": "oc lade thet ickæ ffor skade eller nødh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 0,
      "text": "Tha wor i Skothland en drotning sa doll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 0,
      "text": "Woræ the ickæ som hwn gatz aa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 0,
      "text": "tha lod hwn hwggæ them howedeth ffraa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 0,
      "text": "Thil hennæ badh han meg ware syt bwdh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 0,
      "text": "ath hwn willæ ware hans kæræ brudh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 0,
      "text": "Tog han willæ ickæ ther wedergaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 0,
      "text": "Tha ieg kom vdhen hennes gord oc grund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 0,
      "text": "ther ladhæ ieg meg at soffue en stund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 0,
      "text": "Saa sændhe hwn meg eth selskap imodh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 0,
      "text": "Tha the sowæ ieg soff saa fast,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 0,
      "text": "the togæ myn skyold bort meth en hast.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 0,
      "text": "The boræ hannum bort for drotningen indh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 0,
      "text": "paa scriffthen ther stodh, gaff hwn oc syndh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 0,
      "text": "meth eth syht budh som wor ey sen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 0,
      "text": "Saa gik ieg tha tijl hennæ i gordh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 0,
      "text": "och thalde hennæ tijl oc fick god swaar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 0,
      "text": "Hwn sade ath hennæ vndræde paa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 0,
      "text": "och haffue tijl hwsfrw hans dotther vnød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 0,
      "text": "effter han wor ickæ aff æchtæ fødh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 0,
      "text": "»Bedræ woræ ieg sodan en man wærdh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 233,
      "stanza_id": 0,
      "text": "saa mannelig woræ wdi syn ffærdh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 234,
      "stanza_id": 0,
      "text": "som ieg haffuer seth, han ær vel boldh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 235,
      "stanza_id": 0,
      "text": "Tha kunne ieg gøre tegh tijl koning meth megh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 236,
      "stanza_id": 0,
      "text": "och tw saa mech tijl drotning meth tegh.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 237,
      "stanza_id": 0,
      "text": "Saa tog hwn meg vdi syn arm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 238,
      "stanza_id": 0,
      "text": "och førde hænne saa tijl Engeland meth megh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 239,
      "stanza_id": 0,
      "text": "Thi willæ meg koningen haffue giort et swegh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 240,
      "stanza_id": 0,
      "text": "han bødh meg hiem meth seg tijl gest.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 241,
      "stanza_id": 0,
      "text": "Ffor myt wærstæ giorde han thet mest.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 242,
      "stanza_id": 0,
      "text": "thi bæddre han fick ther ey løcken tijl.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 243,
      "stanza_id": 0,
      "text": "Han mangæ dog aff myne thiæneræ sloo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 244,
      "stanza_id": 0,
      "text": "tha ieg fra hannum tijl ryggæ droo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 245,
      "stanza_id": 0,
      "text": "Annen daghen bødh han meg atther stridhæn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 246,
      "stanza_id": 0,
      "text": "Ieg reysde the døde tijl stok oc sten",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 247,
      "stanza_id": 0,
      "text": "ath wi skullæ synes megeth folck igen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 248,
      "stanza_id": 0,
      "text": "Ther han tha kom och saa myn hær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 249,
      "stanza_id": 0,
      "text": "tha wenthæ han seg fwll onth eth blær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 250,
      "stanza_id": 0,
      "text": "ieg ffwldha fasth effther oc wor ey sen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 251,
      "stanza_id": 0,
      "text": "Ieg slo hannum ther oc Ængælandh wandh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 252,
      "stanza_id": 0,
      "text": "meth hwsfrw myn ieg Skothland fandh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 253,
      "stanza_id": 0,
      "text": "Sao for ieg tha the land omkring",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 254,
      "stanza_id": 0,
      "text": "Soo toog ieg myne hwsfrwær thoo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 255,
      "stanza_id": 0,
      "text": "meth them ieg hiem tijl Danmark droo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 256,
      "stanza_id": 0,
      "text": "Tha ieg wor kommen hiem tijl landh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 257,
      "stanza_id": 0,
      "text": "tha hade myn modher en annen mandh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 258,
      "stanza_id": 0,
      "text": "ffor han hade tijl rigeth stoor figh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 259,
      "stanza_id": 0,
      "text": "Myn drotning hwn iættæ ath stoo meth meg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 260,
      "stanza_id": 0,
      "text": "men hwn foer alt meth falsk och sweg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 261,
      "stanza_id": 0,
      "text": "Hwn tog then man, hwn vnthæ hannum well,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 262,
      "stanza_id": 0,
      "text": "So plæyæ stwndum ondhe quindhers iæth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 263,
      "stanza_id": 0,
      "text": "ath holdes meth en skrobeligh sæth.",
      "part": false,
      "marginal_notes": []
    }
  ]
}