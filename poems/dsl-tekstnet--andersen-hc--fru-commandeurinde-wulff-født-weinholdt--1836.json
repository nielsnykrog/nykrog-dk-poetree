  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "I Hjemmet er nu Sorgens stille Qvæl,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Der hvor en Moder savnes vorder øde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Og hun var Moder med sin hele Sjæl,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "En mere kjærlig Hustru aldrig døde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Græd kun! er Tabets Smerte ret grædt ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "I prise Gud, som hun hans Dødsbud priste;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Hun lider ikke meer, hun er hos Gud!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Jord dækker ikkun Jord i hendes Kiste!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
