  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "I myn tijd for aff Danmark wdh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hwer triediæ man meth skiold oc spywdh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "som liggæ wthi then øster strand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "The bleffue ther sydende, oc æræ ther en,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "ther the hade slaffueth theris men.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "I xi aar ieg konning waar",
      "part": false,
      "marginal_notes": []
    }
  ]
