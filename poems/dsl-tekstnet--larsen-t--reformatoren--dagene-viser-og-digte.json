  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Tys! Sæt dig hos os! Fra et Hul i et Skæg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "flyver heftige Ord gennem Salen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "og Meninger laskes mod Dør og mod Væg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "og Livssynet løftes en Alen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Kom! Skynd dig! Og hør, hvor det knalder i Luft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "med Sandhed – i løse Patroner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Her smaddres der Drømme med Brølfornuft.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Her skydes der Myg med Kanoner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Han skælder forstenede Tusindaars-Mænd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "som staar paa de Tusindpunds Sokler",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "og vender det døveste Øre til Skænd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "forglemmende Knipler og Knokler.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Hvad! Knurrer I, Folk? Slog han Hul paa jer Gud?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Kom der Spyt paa jer lutherske Mening?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Tilgiv ham. Han vil, I skal hugge ham ud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "i en overnaturlig Forstening.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
