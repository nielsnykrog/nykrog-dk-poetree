  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Salig er den i Guds fryct staar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc gierne paa hans veye gaar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Aff dit Arbeid nær dig met skel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "saa leffuer du ret/ oc gaar dig vel.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Jnden dit Huss skal din Hustru",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Være som en rancke met mange Vindru/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Oc dine Børn om din egen disk",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Som Olie planter sunde oc frisk.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "See saa velsignis huer den Mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Som vdi Guds fryct stande kand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Fra den forbandelse er hand fri",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Som Adams børn fødis vdi.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Velsigne skal dig Gud aff Zion/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "At du maat see hans gode laan/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Jerusalems lyst oc lycke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Hans Kirckis ære oc smycke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Dit liff Gud dig lenge skone vil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Oc megit gaat dig føye til/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "At du skalt see dine Børns mange Led/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Oc siden hin rette Jsraels fred.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Salig er den Mand der Gud frycter/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "oc vdi hans veye vandrer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Hand tror Guds ord aff hiertens grund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "det siunis paa hans gierning allelund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Jntet Menniske besuiger hand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Hand hielper alle huor hand kand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Oc met sit Handuerck føder sig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "Thi gaar hannem vel/ oc er altid salig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "Hand skyer hoer oc all wrenhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Oc i Ecteskab giffuer hand sig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "Hans Hustru i hans Huss vancker/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "Som it Vintræ alt fult aff Vinbær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "Hans Børn side omkring hans bord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Hand lærer dem at tro Guds Ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "De ere som Olie planter/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "Fra synd oc ondskab hand dem tucter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "See saadan naade faar det Menniske",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Som tror paa Christi fortieniste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "At det kand Gud elske oc frycte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "Christus haffuer hannem fortient saadan lycke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "O du Guds Menniske altid salig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Herren aff Zion velsigne dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "Oc du skalt see i dine Dage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "Huad got Guds folck Hierusalem skal haffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "Du skalt oc faa saa lang Liffs frist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "At du skalt see dine Børnebørn vist:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "Du skalt oc see den fred oc glæde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "Der Gud offuer Jsrael monne giffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "Huo som vil salig vdi Verden leffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "J Herrens ord oc fryct skal hand sig øffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 13,
      "text": "Den euige Herre Gud skal hand oc dyrcke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 13,
      "text": "J troen til hannem sig altid styrcke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 14,
      "text": "Vilt du ocsaa leffue met Gud oc ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 14,
      "text": "Aff dine hænders arbeide skalt du dig nære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 15,
      "text": "Fructsommelig skal oc din Hustru være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 15,
      "text": "Som it Vintræ mange vindruer mon bære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 16,
      "text": "Oc skulle dine Børn deilige oc rene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 16,
      "text": "Om dit bord side/ som Oliue grene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 17,
      "text": "Saa skal den mand aff gud velsignet være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 17,
      "text": "Som hannem hiertelig vil frycte oc ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 18,
      "text": "Herren skal dig oc lenge i Verden spare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 18,
      "text": "Oc altid met sit salige Ord beuare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 19,
      "text": "At du maat see dine Børnebørn vden skamme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 19,
      "text": "Oc siden Jsraels fred euig anamme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 20,
      "text": "Her til beslutte wi nu allesammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 20,
      "text": "Sigendis huer aff hiertet/ Amen Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 21,
      "text": "RÆt salig er foruist den mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 21,
      "text": "Som sig paa Gud forlader:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 21,
      "text": "J Herrens fryct staar altid hand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 21,
      "text": "All synd hand skyer oc hader.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 21,
      "text": "Hand vandrer oc i Herrens vey/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 21,
      "text": "De ondis raad samtycker hand ey/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 21,
      "text": "Guds bud hand altid elsker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 22,
      "text": "Aff dit Handuerck føder du dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 22,
      "text": "Som Herren selff dig lærer:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 22,
      "text": "Du bruger ey falskhed oc suig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 22,
      "text": "Met retuished dig nærer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 22,
      "text": "Du est foruist en salig mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 22,
      "text": "Det skal oc gaa dig vel i haand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 22,
      "text": "Fra alt ont Gud dig frelser.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 23,
      "text": "Saa er oc din fromme Høstru/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 23,
      "text": "Den Gud gaff dig selff here:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 23,
      "text": "Som en fructsommelig Vindru/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 23,
      "text": "Sine børn føder hun met ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 23,
      "text": "Hun er en prydelse i dit Huss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 23,
      "text": "Lige som Solen/ det klare liuss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 23,
      "text": "Den deylige Himmel pryder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 24,
      "text": "Men dine børn den deylige Fruct/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 24,
      "text": "Som dig aff Herren giffuis:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 24,
      "text": "Dem føder du op i Christelig tuct/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 24,
      "text": "Saa de Guds børn kunde bliffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 24,
      "text": "Som Olie quiste side de",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 24,
      "text": "Omkring dit bord/ saa du maat see",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 24,
      "text": "Du Guds velsignelse nyder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 25,
      "text": "Velsignet bliffuer saa den Mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 25,
      "text": "Som Herren altid frycter:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 25,
      "text": "Hand prises høyt i alle Land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 25,
      "text": "J troen hand sig styrcker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 25,
      "text": "Hand faar oc siden Himmerig vist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 25,
      "text": "Formedelst den Herre Jesum Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 25,
      "text": "Som oss igenløste alle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 26,
      "text": "Saa skal Herren velsigne dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 26,
      "text": "Aff Zion i Verden here:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 26,
      "text": "At du skalt see ret visselig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 26,
      "text": "Jerusalems lycke oc ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 26,
      "text": "Det er fred oc endrectighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 26,
      "text": "Glæde/ velsignelse oc rolighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 26,
      "text": "J alle dine liffs dage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 27,
      "text": "Her til giffuer Gud dig oc liffs frist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 27,
      "text": "At du maat see oc kiende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 27,
      "text": "Dine deylige Børnebørn foruist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 27,
      "text": "Den lycke skal Gud dig sende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 27,
      "text": "Du skalt oc nyde Jsraels fred/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 27,
      "text": "Baade her oc der i euighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 27,
      "text": "Det giffue oss Gud allesammen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 28,
      "text": "Loff ære oc tack til euig tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 28,
      "text": "Skee dig Gud Fader kiere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 28,
      "text": "Met din Søn Christo mild oc blid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 28,
      "text": "Vilt vor beskermer være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 28,
      "text": "Der til ocsaa den hellig Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 28,
      "text": "Det ynske wi baade Quinde oc mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 28,
      "text": "Sigendis alle Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 29,
      "text": "Hielp oss Gud Fader i Himmerig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 29,
      "text": "som oss haffuer skabt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 29,
      "text": "oc offuer alltingist i Jorderig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 29,
      "text": "haffuer giffuit oss mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 29,
      "text": "hand er vor skiold oc verie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 30,
      "text": "Hielp oss oc Guds søn Jesus Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 30,
      "text": "Som oss haffuer frijd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 30,
      "text": "Alt met sin død oc pine vist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 30,
      "text": "Haffuer giort oss quit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 30,
      "text": "Fra Helffuedis angist oc møde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 31,
      "text": "Hielp oss oc Gud den hellig Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 31,
      "text": "Som oss trøster/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 31,
      "text": "Oc lærer ret Sandhed alle mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 31,
      "text": "Som dem lyster",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 31,
      "text": "At høre/ oc vel beuare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 32,
      "text": "Gud Fader Søn oc den hellig Aand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 32,
      "text": "Er en sand Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 32,
      "text": "Som vil at alle baade quinde oc Mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 32,
      "text": "Skulle holde hans Bud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 32,
      "text": "Oc hannem allene frycte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 33,
      "text": "Wi ville Guds ord atlyde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 33,
      "text": "Om Ecteskab/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 33,
      "text": "Oc alt Horerij bortdriffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 33,
      "text": "Som Gud oss bad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 33,
      "text": "Gud vnde oss der til naade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 34,
      "text": "Ecteskabs stat er hederligt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 34,
      "text": "J alle Land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 34,
      "text": "Thi Gud haffuer det selff skicket",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 34,
      "text": "Met quinde oc Mand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 34,
      "text": "Det ville wi faa at høre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 35,
      "text": "Den tid Gud haffde Adam skabt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 35,
      "text": "Den hederlig Mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 35,
      "text": "Da haffde alle Diur sin mage faait",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 35,
      "text": "Foruden hand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 35,
      "text": "Sin lige kunde hand icke finde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 36,
      "text": "Da sagde Gud vor Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 36,
      "text": "Det er ey gaat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 36,
      "text": "At Mennisken leffuer saa ene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 36,
      "text": "Der til maa raad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 36,
      "text": "Wi ville hannem hielpen giøre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 37,
      "text": "Da loed Gud falde paa Adam",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 37,
      "text": "En søffn saa dyb/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 37,
      "text": "Saa tog hand it aff hans Rebbeen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 37,
      "text": "Vdaff hans liff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 37,
      "text": "Oc steden met kiød opfylte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 38,
      "text": "Oc Gud hand giorde en Quinde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 38,
      "text": "Aff det Rebbeen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 38,
      "text": "Der hand tog samme sinde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 38,
      "text": "Aff Mennisken/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 38,
      "text": "Oc monne hende til hannem lede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 39,
      "text": "Det er it Been aff mine been/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 39,
      "text": "Sagde Adam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 39,
      "text": "Det Kiød er aff mit kiød vden meen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 39,
      "text": "Mandinde er hendis naffn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 39,
      "text": "Thi hun er aff Manden kommen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 40,
      "text": "Thi skal mand Fader oc Moder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 40,
      "text": "Offuergiffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 40,
      "text": "Och saa ved denne Stalbroder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 40,
      "text": "Sin Hustru bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 40,
      "text": "Jt Legem de tho skulle være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 41,
      "text": "J skulle formere Verden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 41,
      "text": "Oc øge hende fuld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 41,
      "text": "Oc lære eders Børn at frycte Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 41,
      "text": "Oc være hannem huld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 41,
      "text": "Da er hand eders skiold oc verie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 42,
      "text": "Nu haffue wi hørt den gamle Scrifft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 42,
      "text": "Gud Faders ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 42,
      "text": "Guds Søn haffuer dem oc selff samtyct/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 42,
      "text": "Oc faste giort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 42,
      "text": "Baade met ord oc gierning.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 43,
      "text": "Hand vaar til Bryllups kaldit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 43,
      "text": "Oc kom der hen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 43,
      "text": "Oc den tid dem Vinen fattis",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 43,
      "text": "Vende Vand om til Vin/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 43,
      "text": "Ecteskab hand der met priste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 44,
      "text": "Hand stadfeste met Orden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 44,
      "text": "Den hellige stat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 44,
      "text": "Der hand bød/ ingen paa Jorden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 44,
      "text": "Skulde skillie dem at",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 44,
      "text": "Som Gud haffde sammen føyet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 45,
      "text": "Den hellig Aand det samme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 45,
      "text": "Oc monne sige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 45,
      "text": "At Mand oc quinde de tuende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 45,
      "text": "Skulle sammen bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 45,
      "text": "J kierlighed en ting være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 46,
      "text": "Huer anden skulle de elske",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 46,
      "text": "Aff hiertens grund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 46,
      "text": "Som Christus (der oss frelste)",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 46,
      "text": "Giorde allelund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 46,
      "text": "Sit liff hand for oss ey sparde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 47,
      "text": "Hand gaff sig selffuer i døden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 47,
      "text": "Alt for sin Brud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 47,
      "text": "Oc løste hende saa aff møde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 47,
      "text": "Alt met sit Blod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 47,
      "text": "Sin kierlighed saa beuiste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 48,
      "text": "Thi siger Sancte Pouel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 48,
      "text": "Til alle Mend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 48,
      "text": "J skulle elske eders Hustruer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 48,
      "text": "Ret saa igen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 48,
      "text": "Som Christus oss alle elskte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 49,
      "text": "Quinderne skulle oc høre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 49,
      "text": "Oc ære deris Mend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 49,
      "text": "Som den gode Sara monne giøre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 49,
      "text": "Mod Abraham/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 49,
      "text": "Sin Herre monne hun hannem kalde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 50,
      "text": "Nu haffue wi hørt om Ecteskab",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 50,
      "text": "Guds hellige Bud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 50,
      "text": "Thi ville wi alle være glad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 50,
      "text": "Oc tacke Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 50,
      "text": "Oc oss i hans vold befale.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 51,
      "text": "Hielp oss O HERre Jesu Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 233,
      "stanza_id": 51,
      "text": "Gud Faders søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 234,
      "stanza_id": 51,
      "text": "vor eniste frelsermand foruist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 235,
      "stanza_id": 51,
      "text": "oc altid hør vor bøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 236,
      "stanza_id": 51,
      "text": "saa vorde io Jesus vor skiold i huærinde vaade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 237,
      "stanza_id": 52,
      "text": "Nu ville wi siunge en vise/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 238,
      "stanza_id": 52,
      "text": "J denne stund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 239,
      "stanza_id": 52,
      "text": "Vor Konning der met at prise/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 240,
      "stanza_id": 52,
      "text": "Vdaff ret hiertens grund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 241,
      "stanza_id": 52,
      "text": "Saa vorde io Jesus vor skiold i huerinde vaade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 242,
      "stanza_id": 53,
      "text": "Du est den deiligst i Verden er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 243,
      "stanza_id": 53,
      "text": "Baade mild oc blid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 244,
      "stanza_id": 53,
      "text": "Der for haffuer Gud dig saare kier/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 245,
      "stanza_id": 53,
      "text": "Alt ind til euig tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 246,
      "stanza_id": 53,
      "text": "Saa vorde io Jesus vor skiold i huerinde vaade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 247,
      "stanza_id": 54,
      "text": "Du veldige Først/ baade klog oc viss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 248,
      "stanza_id": 54,
      "text": "Bint op dit Suerd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 249,
      "stanza_id": 54,
      "text": "Thi du est prydet met loff oc priss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 250,
      "stanza_id": 54,
      "text": "Oc est det fulduel verd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 251,
      "stanza_id": 54,
      "text": "Saa vorde io Jesus vor skiold i huerinde vaade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 252,
      "stanza_id": 55,
      "text": "Lycksalig est du i din Herlighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 253,
      "stanza_id": 55,
      "text": "For sandheds ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 254,
      "stanza_id": 55,
      "text": "Oc vnderlig gierninger oc Salighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 255,
      "stanza_id": 55,
      "text": "Din høyre haand haffuer det giort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 256,
      "stanza_id": 55,
      "text": "Saa vorde io Jesus vor skiold i huerinde vaade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 257,
      "stanza_id": 56,
      "text": "Dine ord ere skarpe som pile/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 258,
      "stanza_id": 56,
      "text": "J hiertit ind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 259,
      "stanza_id": 56,
      "text": "Da monne de sig først huile/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 260,
      "stanza_id": 56,
      "text": "De dræbe oc døde dine Fiender/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 261,
      "stanza_id": 56,
      "text": "Saa vorde io Jesus vor skiold i huerinde vaade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 262,
      "stanza_id": 57,
      "text": "O Herre Guds Søn som himmelen reger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 263,
      "stanza_id": 57,
      "text": "Til euig tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 264,
      "stanza_id": 57,
      "text": "Da bliffuer dit Rige oc Kongelig spir/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 265,
      "stanza_id": 57,
      "text": "Met loff oc priss giør du din flid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 266,
      "stanza_id": 57,
      "text": "Saa vorde io Jesus vor skiold i huerinde vaade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 267,
      "stanza_id": 58,
      "text": "De onde dem haffuer du intet kier/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 268,
      "stanza_id": 58,
      "text": "Men de Retuise/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 269,
      "stanza_id": 58,
      "text": "Thi skencker Gud dig sine gaffuer fler/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 270,
      "stanza_id": 58,
      "text": "End hand dine brødre beuiste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 271,
      "stanza_id": 58,
      "text": "Saa vorde io Jesus vor skiold i huerinde vaade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 272,
      "stanza_id": 59,
      "text": "Dine Klæder de lucte aff dyrebar Mirr/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 273,
      "stanza_id": 59,
      "text": "En Kongelig sed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 274,
      "stanza_id": 59,
      "text": "Alt naar du ganger aff Høyelofft neer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 275,
      "stanza_id": 59,
      "text": "Vdi din Herlighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 276,
      "stanza_id": 59,
      "text": "Saa vorde io Jesus vor skiold i huerinde vaade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 277,
      "stanza_id": 60,
      "text": "Her dantze de Jomfruer baade skøne oc blide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 278,
      "stanza_id": 60,
      "text": "Oc Sallen er fuld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 279,
      "stanza_id": 60,
      "text": "Din Brud staar ved din høyre side/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 280,
      "stanza_id": 60,
      "text": "Prydet met Perler oc Guld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 281,
      "stanza_id": 60,
      "text": "Saa vorde io Jesus vor skiold i huerinde vaade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 282,
      "stanza_id": 61,
      "text": "Min Daatter du skalt icke forsømme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 283,
      "stanza_id": 61,
      "text": "At høre mine ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 284,
      "stanza_id": 61,
      "text": "Oc der vdoffuer forglemme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 285,
      "stanza_id": 61,
      "text": "Dit Folck oc Faders gaard.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 286,
      "stanza_id": 61,
      "text": "Saa vorde io Jesus vor skiold i huerinde vaade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 287,
      "stanza_id": 62,
      "text": "Kongen vdaff din deylige mod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 288,
      "stanza_id": 62,
      "text": "Bær lyst oc glæde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 289,
      "stanza_id": 62,
      "text": "For hand er Gud oc Herre god/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 290,
      "stanza_id": 62,
      "text": "Hannem skalt du tilbede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 291,
      "stanza_id": 62,
      "text": "Saa vorde io Jesus vor skiold i huerinde vaade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 292,
      "stanza_id": 63,
      "text": "Der kommer til dig baade quinder oc mend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 293,
      "stanza_id": 63,
      "text": "De Rigiste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 294,
      "stanza_id": 63,
      "text": "De skencke dig gaffuer huer oc een/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 295,
      "stanza_id": 63,
      "text": "Oc Folcket disligeste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 296,
      "stanza_id": 63,
      "text": "Saa vorde io Jesus vor skiold i huerinde vaade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 297,
      "stanza_id": 64,
      "text": "Du est vor Konningis Daatter ven/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 298,
      "stanza_id": 64,
      "text": "Saa ærefuld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 299,
      "stanza_id": 64,
      "text": "Dine Klæder ere besæt omkring/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 300,
      "stanza_id": 64,
      "text": "Alt met det røde Guld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 301,
      "stanza_id": 64,
      "text": "Saa vorde io Jesus vor skiold i huerinde vaade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 302,
      "stanza_id": 65,
      "text": "J kaastelige Klæder oc herlige Bram/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 303,
      "stanza_id": 65,
      "text": "Til Kongen ind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 304,
      "stanza_id": 65,
      "text": "Dine Jomfruer følge dig erlige fram/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 305,
      "stanza_id": 65,
      "text": "Oc tiene dig effter dit sind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 306,
      "stanza_id": 65,
      "text": "Saa vorde io Jesus vor skiold i huerinde vaade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 307,
      "stanza_id": 66,
      "text": "Dine Jomfruer føre sig vdi skarlagen skind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 308,
      "stanza_id": 66,
      "text": "Met glæde oc fryd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 309,
      "stanza_id": 66,
      "text": "Gaa de til Kongen i Høyelofft ind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 310,
      "stanza_id": 66,
      "text": "Altsammen met ære oc dyd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 311,
      "stanza_id": 66,
      "text": "Saa vorde io Jesus vor skiold i huerinde vaade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 312,
      "stanza_id": 67,
      "text": "Dine Børn voxe op met ære oc tuct/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 313,
      "stanza_id": 67,
      "text": "Offuer alle deris Fædre i Verden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 314,
      "stanza_id": 67,
      "text": "Saa vide at giøre fruct/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 315,
      "stanza_id": 67,
      "text": "Oc Førster der at være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 316,
      "stanza_id": 67,
      "text": "Saa vorde io Jesus vor skiold i huerinde vaade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 317,
      "stanza_id": 68,
      "text": "Her ville wi ende vor Vise/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 318,
      "stanza_id": 68,
      "text": "Dit hellige Naffn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 319,
      "stanza_id": 68,
      "text": "Det ville wi loffue oc prise/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 320,
      "stanza_id": 68,
      "text": "Oss alle til gaffn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 321,
      "stanza_id": 68,
      "text": "Saa vorde io Jesus vor skiold i huerinde vaade.",
      "part": false,
      "marginal_notes": []
    }
  ]
}