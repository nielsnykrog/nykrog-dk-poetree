{
  "id": null,
  "title": "Kong Erik belejrer Halmstad",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Rentzells Håndskrift",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/RNZ21.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "I esu naffn y hører tiill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "itt wnderliig spiill ieg quede wiill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "som nylliig er skied for sande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "ther mand skriiff po thett thridie aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "huad ther sked i Sueriigs lande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Koning Eriick hand siider paa Stockholms slott,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "mett sine 4 greffuer giør anslagtt saa kortt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "huad raad dj kunde poo finde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "att thj kund Dannemarck thiill Sueriig faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "thj danske mend att tuimge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Koninng Eriick lod breffue skriiffue saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "och lodtt thj giødninnger saa forstaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "om thj wiille gaa hannom tiil hande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "hand wiille were thenum en herre saa guod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "thett suor hand wiid sin kronne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Dÿ giøndinger suaritt som thj kunde best:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "\"Wy kinder koninng Eriick thenn threrske giest;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "hannom skier aldriig thenn ærre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "att wy schulle falle wor koninng fra,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "thett maa slett inthett werre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "Wi thienner koninng Frederiick, thenn høgborne mandtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "then annden koninng i Dannemarck aff then naffn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "wii wiille hanum icke wndfalle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "men throliig mett hanum staa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "wor nadiige herre att kalle.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "Der tiil tha suariitt thj greffuer alle:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "\"I Hallandtt och Skonne wiill wy indfalle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "och giør thenum soriig och wonnde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "och tuimge thenum bode mett suerdtt och spiudtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": "saa gaar thj ethers naade tiill hande.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "Tha suared greffue Suanthj, then herre saa stour,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "som haffde aff sin faders foredeliig blodt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "gamell her Steenn Staare hans fader monne were:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": "\"Wy wiill oss nu tiill Dannemarck indtt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 6,
      "text": "och giør the danske bannge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "Wii wiill slaae dannske ihiell for fuode",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 7,
      "text": "och skonne slett ingen aff theriis blodtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": "men slo thenum alle tiill døde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 7,
      "text": "och felle thenum neder, som mand felder korn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 7,
      "text": "oc giøre thenum plage och møde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 8,
      "text": "Then anndenn greffue, Peder Brade heder handtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 8,
      "text": "som agtis y Sueriig for en veldiig mand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 8,
      "text": "\"Nadiig here, ieg wiil ether raade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 8,
      "text": "i lader en hob i Blegind ind fare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 8,
      "text": "och giør thenum stuor skade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 9,
      "text": "Att røffue och brende och giør thenum wæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 9,
      "text": "och driffue thennom alt for spe och spott",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 9,
      "text": "och Rundby ind att thage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 9,
      "text": "och Blegen ødelege,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 9,
      "text": "saa skulle the gannge ethers naade tilhande.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 10,
      "text": "Ther tiil suariit thenn thridie greffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 10,
      "text": "her Giistj Iohansøn saa heder handtt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 10,
      "text": "\"Hei røster ether, i suenske fromme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 10,
      "text": "nu wiill wi geste the danske mendtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 10,
      "text": "thj winther inthett wor komme.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 11,
      "text": "Denn suenske rider, her Stenn Eriickszøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 11,
      "text": "som vor vd korenn att drage ind y Thislandtt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 11,
      "text": "att besolde lanndtz knigtte fronne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 11,
      "text": "hand bliiff andthagenn i Kiøbenhaffuen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 11,
      "text": "hand kunde ey lennger komme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 12,
      "text": "Her Giistj Olluffsenn, en aff thj suenskis gammle blod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 12,
      "text": "en onnd end tiill hanns hiertis rodtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 12,
      "text": "thett raad hialp hand att beslute;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 12,
      "text": "karthoffuer och slannger wi icke forget",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 12,
      "text": "och diiffuels mother huos thennom att sette.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 13,
      "text": "Koninng Eriick aff Stockhollom vdrog",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 13,
      "text": "mett alle sin magtt Halmsted emodtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 13,
      "text": "thett bethiide strax att winde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 13,
      "text": "Halland, Skone, Selland och Fin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 13,
      "text": "om thj wiille gaa hanum tiill hande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 14,
      "text": "Denn thiid konng Eriick for Halmstedt kom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 14,
      "text": "hand prollitt och holtt siig from,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 14,
      "text": "sin skud lod hand ther høre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 14,
      "text": "Hallomstettz borger skull faa att wiide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 14,
      "text": "huad skade hannd skulle thenum førre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 15,
      "text": "En Hallanndtz bunde hannd for siig kalle lodtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 15,
      "text": "saa snartt fulde hann thenn herre tiil fodt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 15,
      "text": "wyldradiig mon hand werre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 15,
      "text": "\"Statt tha,\" sagde thenn suenske koninng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 15,
      "text": "\"min landmand skalthu were.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 16,
      "text": "Hannd gaff hanum strax en herregaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 16,
      "text": "som ind i Halland staar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 16,
      "text": "hannd soer om sin konngeliig kronne:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 16,
      "text": "\"Thu skalt wiise mig then rethe wey",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 16,
      "text": "tiill Halmstedt och Lanndtzkronne.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 17,
      "text": "\"Naadiige herre, wiill y ether besinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 17,
      "text": "Lantzkronn er icke guod att winde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 17,
      "text": "y lader ether icke forhaste;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 17,
      "text": "thj haffuer brøgett øll for ether sa sterck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 17,
      "text": "thj agter icke suennske gieste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 18,
      "text": "Malmø er en faster by,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 18,
      "text": "stercke wolde, mur och portte aff ny,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 18,
      "text": "y kunde ther icke indkomme;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 18,
      "text": "kunde y Hallomstett fannge først,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 18,
      "text": "thett kunnde ether møgitt fromme.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 19,
      "text": "Koninng Eriick lod skod affgaa, bode stuore och smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 19,
      "text": "hand actede Halmstett strax att faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 19,
      "text": "thett vor ydeliig i hans sinde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 19,
      "text": "hand wiille fordriiffue, huad ther wor inde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 19,
      "text": "alt bode mandtt och quinnde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 20,
      "text": "Enn weldiig skud, huem thett haffuer hørdt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 20,
      "text": "diffuels mother, saa er alt hind naffn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 20,
      "text": "alt saa mon the hinde kalde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 20,
      "text": "huo hindis aande bleszer paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 20,
      "text": "ther røstiis mur och thinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 21,
      "text": "Hand skriiff the borger tiill alt saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 21,
      "text": "och tiill høffuitsmendtt thiill borger i Halmestedt laa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 21,
      "text": "om thj wiille gaa hanum tiill hande:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 21,
      "text": "hand wiille werre thenum en herre saa guodtt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 21,
      "text": "och giiffue thenum guode gaffuer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 22,
      "text": "Thj borger och thj høffuitzmend guode",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 22,
      "text": "wiille holde then æd, som thj haffuede soritt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 22,
      "text": "theriis nadiige herre och koninng;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 22,
      "text": "thj bad hand skulle anndkomme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 22,
      "text": "thj wiille thenum tapertt werge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 23,
      "text": "Høgbornne fiirste, koninng Frederiich, thett fornam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 23,
      "text": "saa snartt giorde hand thj suenske veyen trang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 23,
      "text": "mett nogen folck mone hand wddrage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 23,
      "text": "och slo aff thj suenske 5000 mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 23,
      "text": "thj andre monne hand bortiage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 24,
      "text": "\"I werrer welkomen, y suenske, til oss,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 24,
      "text": "løster ether att plucke sanctj Morthensgoesz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 24,
      "text": "fieder wiill wi aff riffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 24,
      "text": "saa thj skulle om ethers ørnne fliige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 24,
      "text": "om Gud giffuer osz ther thiill liicke.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 25,
      "text": "Sanctj Morthenssskaall then drucke thj vd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 25,
      "text": "thj danske skennck y mett lod och krudtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 25,
      "text": "the glimpthe att siunnge sanctj minde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 25,
      "text": "och sanctj Byritt bliiff och glemptt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 25,
      "text": "for hunn wor en helliig quinnde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 26,
      "text": "Thj finge ther skøtt buode stuore och smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 26,
      "text": "som thj suenske lod siig iage fra,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 26,
      "text": "diiffuels moder mett hindiis søster alle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 26,
      "text": "karthoffuer, slanger och falckenither,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 26,
      "text": "alt saa mone thj thennum kaldhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 27,
      "text": "Ach suenske huem gaff thieg thett tiill radtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 27,
      "text": "att thu koninng Frederich saa saare forsmor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 27,
      "text": "thett maa icke werre mett rethe;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 27,
      "text": "ther aff er komen en hadt sa stor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 27,
      "text": "och ther thiill mett stuor thrette.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 28,
      "text": "Hannd er en koninng oc herre guod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 28,
      "text": "och ther tiill komen aff fiirsteliig blodtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 28,
      "text": "thett tennck y thinne sinde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 28,
      "text": "vor icke then edeliig rudekrantz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 28,
      "text": "huad wiilt thu tha begiiønnde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 29,
      "text": "Nu wiill wy giøre Gud ærre och tack",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 29,
      "text": "for siine welgierninger aff hue och agtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 29,
      "text": "beuisse wor koninng stuor ærre;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 29,
      "text": "Gud giffue hanum liicke femthuszind foldtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 29,
      "text": "Gudt werre hanns skiold att werre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 30,
      "text": "Nu haffuer thenne wiisse fanngitt en godtt ennde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 30,
      "text": "Gud osz thenn helliigaandtz naade sennde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 30,
      "text": "thin naade oc wennskab att haffue;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 30,
      "text": "att wy maa bliffue Gutz euige børn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 30,
      "text": "wdi hanns euige riige. Amen.",
      "part": false,
      "marginal_notes": []
    }
  ]
}