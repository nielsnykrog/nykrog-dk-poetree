  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "VJ loffue dig alle Jesu Christ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "ath dw menniske worden est",
      "part": false,
      "marginal_notes": [
        "Luce ii"
      ]
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "oc aff en Jomfru fødder vor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "thi frøyde sig alle Engle skare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "kirieleyson",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Gudz ewige faders eniste søn/",
      "part": false,
      "marginal_notes": [
        "Luce ii"
      ]
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "han haffuer anammit menniskens køn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "han laa i krubben ned paa straa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "han vilde oss vsle icke forsmaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Kyrieleyson",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Den verden all ey beslute kunde/",
      "part": false,
      "marginal_notes": [
        "Philip ii"
      ]
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "han er i Marie skød funden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "han er nu vorden ith barn saa spæt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "der alting haffuer ene opræt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Kyrieleyson",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Det euige liuss kom da her ind/",
      "part": false,
      "marginal_notes": [
        "Esaie ix Esa xlii"
      ]
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "ath opliuse verden met sit skin/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "det liuser vel i den mørckeste nat/",
      "part": false,
      "marginal_notes": [
        "Joan i"
      ]
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "ath bliffue Gudz børn/ giffuer det oss mact",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Gud faders søn aff hiemerig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "er vorden en gest i iørderig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "ath føre oss aff den grædelig dall/",
      "part": false,
      "marginal_notes": [
        "Ro viii Luce ix"
      ]
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "oc gøre oss til arfuinge i sin sall/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "Kyrieleyson",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "Han vor her i verden fattig oc arme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "thi han ville sig offuer oss forbarme/",
      "part": false,
      "marginal_notes": [
        "Joan iii"
      ]
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "oc gøre oss saa i hiemmelen rig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "oc alle sine hellige Engle lig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "Kyrieleyson",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": "Dette haffuer han oss alle beted/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "till ath bewise sin kerlighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "dess frøyder sig all den Christenhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "och tacker hannem dess til euighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": "Kyrieleyson",
      "part": false,
      "marginal_notes": []
    }
  ]
}