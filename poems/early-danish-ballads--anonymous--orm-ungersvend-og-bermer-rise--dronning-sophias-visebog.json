{
  "id": null,
  "title": "Orm Ungersvend og Bermer-Rise",
  "year_created": 1584,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Dronning Sophias visebog",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1584,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/DRS42.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Thet war høgenn Bermer riss,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hannd war høg och møgen uhyre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "hand war gal och aller wiss,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "och ingen mand kunde hannom styre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: Menss skouen stander ald y blomster. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Och thet war høgenn Bermer riis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "hannd binder seg suerd wed side:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "saa will hannd thill konngens gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "som kiemper monne sla och stryde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "\"Her seder y, Danner-kongen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "offuer ethers brede bord!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "i skall meg ethers datter giffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "och skiffte med meg hall ethers iord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Nu skall y meg ethers datter giffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "och skiffthe med meg halff ethers iord och lannde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "eller y skall wisse meg then mandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "y kredtzen thør mede meg stande.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "\"Thu fannger icke aff datter min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "icke heller ud-aff min lannde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "menss ieg skall well wisse thig thend mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "y kredtzen thør med theg stannde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Thet war Danner-kongen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "hand gannger y borrestuen ind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "\"Huilchen ud-aff y dannske hoffmendt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "will winde saa wennen møe?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Alle sade kiemper och dannske hoffmendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "och ingen thorde suare et ord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "foruden Worum hin unger-suend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "hand sad ald-nerst thill bordss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "\"Will y meg ethers datter giffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "och skiffthe medt meg halff ethers lannde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "tha will ieg were thend same mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "som y kredtzen thør med hannom stande.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Thet war Danner-kongen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "hand seg offuer axell saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "\"Och huem tha er thend møssling,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "ther thaller saa store ord?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "\"Ieg er ingen møssling,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "for-di y monne meg saa kalle:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "kong Sefred hiede min fader,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "hand monne y bierget falde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "\"Er kong Sefred din fader,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "tha est thu hannom icke holde ulig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "thu est well snarlig woxen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "thu est icke uden femten aar.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Thet war sildig om affthen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "ther suenne red heste y becke:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "tha løster Worm hind unger-suend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "sin fader wilde hand op wecke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "Thet war Worum hin unger-suendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "hannd støtte paa bierget med leste:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "ther reffnet mure och malmerstien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 12,
      "text": "och nerst y bierget røste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "\"Huem wecker meg saa warlig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "och huem giør meg stør meyn?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "och kannd ieg icke met naade were",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 13,
      "text": "op under thesse harde stienn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "\"Ieg wecker thig icke saa warlig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "och ieg giør thig icke stor mien:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "ieg er Worum hin unger-suend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 14,
      "text": "aller-kiereste sønne thin.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "\"Och est thu Worum hin unger-suend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "aller-kiereste sønne min:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "huad helder begerer thu guld eller sølff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 15,
      "text": "eller penningen aff fader din?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "\"Ieg begerer icke guld eller sølff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "eller pennding af mig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "ieg begerer hinder Bierthing,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 16,
      "text": "at wennde saa wennen møe.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "\"Och thu fannger icke aff Bierthing,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "at winde so wennen møø:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "før thu fannger werit y Isseland",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 17,
      "text": "och heffned din faders død.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "\"Och kanndt ieg icke aff Bierthing faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "och kand ieg hannom icke niude:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "tha skall ieg thage hand y harden hald",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 18,
      "text": "och bierget paa thig bryde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "Hannd ragte hannom Bierthing aff bierget ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "hannd bød hannom hielten emod:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "\"Bliff thu heldig och hande-sterck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 19,
      "text": "och kiemper falder for thin fod!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "Thet war Worm hin unger-suend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "hannd binder seg suerd wed side:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "och saa gannger hand y bore-stuen ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 20,
      "text": "som kiemper wilde sla och stride.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 21,
      "text": "Ind kom Worum hin unger-suend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "och stedis hannd for borde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 21,
      "text": "\"Huore er nu thi thyske hoffmendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 21,
      "text": "y iaffthes thalde saa store ord?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 22,
      "text": "Alle saadde thi thyske hoffmendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 22,
      "text": "och ingen thuorde suarde et ord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 22,
      "text": "for-uden høgen Bermer riis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 22,
      "text": "hannd spranck øffuer breden bord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 23,
      "text": "Thet war høgen Bermer ris,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 23,
      "text": "och suard hannd saa for sig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 23,
      "text": "\"Thu skalt for-suere hinder Bierthing,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 23,
      "text": "alt førend ieg fegter med thig.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 24,
      "text": "\"Och ieg haffuer icke Bierthing,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 24,
      "text": "ieg hinder ret aldrich kiennde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 24,
      "text": "min fader hand er y bierget begraffuen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 24,
      "text": "och hannd haffuer Bierthing y hende.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 25,
      "text": "Och thi skreff kredtzenn paa thend wold",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 25,
      "text": "met tho forgyldenne skiolde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 25,
      "text": "och thet will ieg for sanndingen sige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 25,
      "text": "thet war tho helte saa bolde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 26,
      "text": "Och ther war rosk y pere-busk",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 26,
      "text": "och rosk y pere-thre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 26,
      "text": "och thet war høgenn Bermer ris,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 26,
      "text": "hannd bleff hogen aff wed kue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 27,
      "text": "\"Nu haffuer ieg weret y mangen kuiff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 27,
      "text": "met kiemper och danske hoffmendt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 27,
      "text": "aller war ther nogen goud kiemper theris sed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 27,
      "text": "thj monne saa uerlig felde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 28,
      "text": "\"Thu warst høg, och ieg war laug,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 28,
      "text": "och huer war god for sig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 28,
      "text": "ieg hog thill thig, som ieg kunde nha,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 28,
      "text": "och lenngher kunde ieg icke recke.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 29,
      "text": "Thet war Worum hin unger-suend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 29,
      "text": "hannd styrde sin sneck fra lannde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 29,
      "text": "saa wilde hand thill Isselannd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 29,
      "text": "och heffne sin faders død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 30,
      "text": "Och thet war Worum hin unger-suend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 30,
      "text": "hand gannger ud medt thend strannde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 30,
      "text": "ther møder hannom Gierd och Gaar-land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 30,
      "text": "op-paa then huide sande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 31,
      "text": "\"Wer wellkommen, gouden unger-suend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 31,
      "text": "wer well-kommen thill wore lande!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 31,
      "text": "och kiender thu icke Worom hin unger-suend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 31,
      "text": "er hannd icke end worden thill mandt?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 32,
      "text": "\"Nu kiender ieg Worum hind unger-suend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 32,
      "text": "nu er hand worden thill mandt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 32,
      "text": "nu er ieg kommen thill Isseland",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 32,
      "text": "och will haff bod for fader min.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 33,
      "text": "Och thet war Gierd og Arlannd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 33,
      "text": "thi støtte paa mold met suerd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 33,
      "text": "\"Thu fannger aller for fader thin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 33,
      "text": "enthen pennding eller pendingis werdt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 34,
      "text": "Och thi skreffue kredtzenn paa thennd wold",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 34,
      "text": "med thre for-gyldenne skiolde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 34,
      "text": "thet will ieg for sandingen sige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 34,
      "text": "thet war thre helte saa bolde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 35,
      "text": "Thi fegte y dage, thi fegte y tho,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 35,
      "text": "thend III. lige-saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 35,
      "text": "thett will ieg for sanndingen sige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 35,
      "text": "thi kunde icke huoll paa hin-anden faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 36,
      "text": "Och thet tha suarde thend haffue-quinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 36,
      "text": "wed haffsens bunde hun sadt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 36,
      "text": "\"Høre thu, Worm hin unger-suend!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 36,
      "text": "thit suerd thet er for-giordt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 37,
      "text": "Thu kast hinder thre gange offuen om thit hoffuit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 37,
      "text": "och steck saa odenn y iord!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 37,
      "text": "saa hog thill Gierd och Gaarlandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 37,
      "text": "at thi falder for thin fod!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 38,
      "text": "Hand kasten thre gannge oued om sit hoffuet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 38,
      "text": "saa stack hannd oden y iord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 38,
      "text": "saa hog hand Gierd och Gaarland",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 38,
      "text": "nedt for sin fod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 39,
      "text": "Ther hannd haffde werit y Isseland",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 39,
      "text": "och heffnet sin faders død:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 39,
      "text": "saa drog hand thill kongens gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 39,
      "text": "alt thill sin wonden møø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 40,
      "text": "Nu haffuer Worum hin unger-suend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 40,
      "text": "for-wonden alt bode angest och quide:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 40,
      "text": "och nu soffuer hannd saa gladelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 40,
      "text": "aldt wed sin feste-møes side.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 41,
      "text": "Nu haffuer Worum hind unger-suend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 41,
      "text": "for-wonden boude angest och harum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 41,
      "text": "nu soffuer hand saa gladelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 41,
      "text": "alt y hans festemøs arum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 41,
      "text": ":: Mens skouen stander ald udi blomster. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}