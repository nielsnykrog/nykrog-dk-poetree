  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "ALleluia det bør oss altid siunge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Herren loffue och prise aff hiertens grund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Thi hans miskund haffuer vore synder alle vdslæt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "all kerlighed oc gaat haffuer han oss beted",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Alt det som liff haffuer/ det skall Gud loffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "for hans megne miskund oc store naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "han haffuer oss giffuit wenskab/ styrcke/ liff oc krafft/",
      "part": false,
      "marginal_notes": [
        "Eph ii"
      ]
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "han haffuer forderffuit synd/ død oc all dieffuel sens mact",
      "part": false,
      "marginal_notes": [
        "Ephe i"
      ]
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Gud haffuer dem som tro paa hannem iæt naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "vil dem hielpe oc trøste i all waade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "hiemmerigis rige vill han dem alle giffue/",
      "part": false,
      "marginal_notes": [
        "Psalmo cxiv ii Cor i"
      ]
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "det holder han wist/ thi han kan icke liwe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "O Gud fader dig være loff oc ere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "met din Søn Jesu Christ vor frelser kære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "desligest den Helligand aff oss alle sammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "wi tacke dig nu oc euindelige AMEN",
      "part": false,
      "marginal_notes": []
    }
  ]
}