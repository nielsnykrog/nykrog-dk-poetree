{
  "id": null,
  "title": "Tyge Hermandsøn hævner Spot",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
