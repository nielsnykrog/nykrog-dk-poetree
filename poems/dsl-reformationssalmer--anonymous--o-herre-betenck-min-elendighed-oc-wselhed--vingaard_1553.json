    {
      "id": 0,
      "stanza_id": 0,
      "text": "⁕ O Herre betenck min elendighed oc wselhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Paa denne bitterhed oc beskhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Ja vist vilt du tencke der paa det kan min egen Siel sige mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Det samme legger ieg paa mit hierte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Der fore vil ieg nu haabe",
      "part": false,
      "marginal_notes": []
    }
  ]
}