  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Herren veere med eder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 1,
      "text": "Oc med din aand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 2,
      "text": "Opløffter eders hiertter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 3,
      "text": "Vi haffue dennem til herren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 4,
      "text": "Lader oss nu tacke herren vor Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 5,
      "text": "Det er tilbørligt oc retuist.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 6,
      "text": "SAndeligen er det tilbørligt oc retuist.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 6,
      "text": "verdigt oc helsomt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 6,
      "text": "Att vij altiid oc alle steder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 6,
      "text": "loffue oc tacke dig hellige herre almegtiste fader oc euige gudt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 6,
      "text": "Vid Jesum christum vor herre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 6,
      "text": "Vid huilken din maiestet loffue alle engle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 6,
      "text": "Tilbede herredømmene oc scelffue veldighedene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "Disligest himlene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "oc saa himlernis kraffter Oc hellige Seraphim.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "vdaff stoor glede dig høgtideligen begaa alle tilhobe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 6,
      "text": "Met dennem vij bede tillad vore stemmer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 6,
      "text": "aff hiertit i ydmygelig bekendelse.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 6,
      "text": "att siunge Sanctus",
      "part": false,
      "marginal_notes": []
    }
  ]
}