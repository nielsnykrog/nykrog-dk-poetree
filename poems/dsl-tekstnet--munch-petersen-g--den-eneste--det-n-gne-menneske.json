{
  "id": null,
  "title": "den eneste",
  "year_created": 1932,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Gustaf Munch-Petersen",
    "country": null,
    "wiki": "Q1364400"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Det Nøgne Menneske",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1932,
    "url": "https://tekstnet.dk/books/munch-petersen-g_det-noegne-menneske/050/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "– min elskede er skøn –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hun vækker med sin skønhed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "min attraa's lurende tiger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "og tørrer fraaden af dens mund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "med sin skønheds hænder –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "– min elskede er stærk –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "hun bader mine saarede lemmer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "i sin latters stærke hav",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "og aander sine hede smil",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "paa mine frysende hænder –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "– livet er min unge elskerinde –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "– min elskede –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "hun er en ung moder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "der længselsfuldt venter sit barn –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "min elskede er en skøge –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "stolt af sit nøgne legeme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "haaner hun verdens fattige begær –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "hun har en nonnes svale øjne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "hendes smil er klosterhavens ro –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "– livet er min unge elskerinde –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "– jeg elsker en amazone –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "der drypper blod fra hendes hests hove –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "jeg er hendes træl,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "der i snærende tøjler følger hendes rasende ridt–",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "jeg lytter med straalende øjne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "til hendes metalskarpe trodsige raab –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "jeg følger min elskede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "indtil solen engang gaar ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "beskæmmet af glansen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "fra hendes kobberrøde syngende spyd –",
      "part": false,
      "marginal_notes": []
    }
  ]
}
