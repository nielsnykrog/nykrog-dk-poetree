  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Thet syes ath stæffueth ær alder so søth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "man sowæ dog hællær at thet wore døth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "thi iegh vnthæ hannum ey rygheth well.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Siden døde ieg aff alders meen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "och lades paa marken vndher en steen.",
      "part": false,
      "marginal_notes": []
    }
  ]
}