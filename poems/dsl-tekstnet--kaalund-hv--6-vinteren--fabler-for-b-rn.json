  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Nej se, nej se,",
      "part": false,
      "marginal_notes": [
        "Speaker: Moderen:"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "der har vi da den første Sne!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "I Ovnen Ilden brænder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "jeg nuller Eders Hænder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "- Saa putted de Smaa sig sammen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "og kiggede ind i Flammen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Men da de vaagnede næste Dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "da dækkede Sneen Gaard og Tag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "da kjørte de Smaa i Slæde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "det var et Liv, en Glæde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "ved Aftentid de listed ind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "og titted igjen i Flammens Skin.",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
