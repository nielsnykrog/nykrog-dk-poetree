{
  "id": null,
  "title": "Cordouan",
  "year_created": 1854,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Carl Ploug",
    "country": null,
    "wiki": "Q347860"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1854,
    "url": "https://tekstnet.dk/books/ploug-c_cordouan/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Med Stemme lav og Øjet sænket",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Sit Ærind han fremstammet fik!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Den rige Handelsherre skænked",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Ham kun et haanligt Sideblik.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Sveddraaber fra hans Pande rulled",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Mer hastig, end fra Læben Ord;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Den Gamle sad saa kold som Guldet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Der stod i Stabler paa hans Bord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Omsider var hans Tale færdig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Og taus sin Dom han vented paa;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Da rejste ogsaa, stiv og værdig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Hans Rheder sig og talte saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "\"Mit Skib - det fører I med Ære;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "\"Mit Barn - det er en anden Sag;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "\"Det anstaar hende ej, min Kjære;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "\"At sejle under Eders Flag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "\"Ja, stod I end paa Ærens Stige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "\"Var gammel Æt I stammet fra,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "\"Var I ved Rigdom halvt min Lige -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "\"Jeg vraged Jer maaske endda.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "\"Let derfor snarest Eders Anker!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "\"Og vil I blive i mit Brød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "\"Saa sænk de elskovssyge Tanker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "\"Ned i Atlanterhavets Skød.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "Han gik - og snart hans Bramsejl svulmed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "Igjen af Havets friske Vind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "Og Dagens haarde Gjerning dulmed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "Den bittre Smerte i hans Sind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "Men hun, som ikkun elsked Manden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "Og ei hans Rang, hans Byrd, hans Guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "Brød sig om ham og ingen Anden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "Og var den Fjerne tro og huld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 0,
      "text": "Hun, der besad i Arv og Eje",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 0,
      "text": "Sin Faders egen Viljekraft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 0,
      "text": "Lod ingen Magt sin Nakke neje,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 0,
      "text": "Men bar sin Sorg og gav ej tabt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 0,
      "text": "Sit Smil hun ej bag Taarer dulgte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 0,
      "text": "Men det var koldt som Sneens Blink;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 0,
      "text": "Og hendes Øje Ingen fulgte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 0,
      "text": "Af dem, der sprang paa hendes Vink.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 0,
      "text": "Forgjæves venter hendes Fader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 0,
      "text": "Et andet Kjærlighedens Gry;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 0,
      "text": "Forgjæves han sit Hus oplader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 0,
      "text": "For Liv og Lyst, for Land og By.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 0,
      "text": "Parises Herlighed og Vrimmel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 0,
      "text": "Besejrer hendes stolte Sind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 0,
      "text": "Saa lidt, som Andalusiens Himmel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 0,
      "text": "Med Roser maler hendes Kind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 0,
      "text": "Men Tiden gaar - og Livets Kræfter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 0,
      "text": "Bort fra den Gamles Lemmer fly,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 0,
      "text": "Og han begynder tænke efter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 0,
      "text": "Paa Ting, der er ham ganske ny.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 0,
      "text": "Ej sine Penge mer han tæller,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 0,
      "text": "Men Dagene, han har til Nat;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 0,
      "text": "Og han ser aaben Gravens Kjælder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 0,
      "text": "For sig, men ikke for sin Skat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 0,
      "text": "Han regner ej sin Handels Renter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 0,
      "text": "Nu, men sin Handlings Facit ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 0,
      "text": "Og ser, at tusinde Procenter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 0,
      "text": "Betale ej hans Gjæld til Gud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 0,
      "text": "Han ikke mer Metaller vejer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 0,
      "text": "Men Ordets Sølv og Tankens Guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 0,
      "text": "Og undres paa, hvor Skaalen svajer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 0,
      "text": "Som om den var af Avner fuld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 0,
      "text": "Han ser paa hende, der er levnet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 0,
      "text": "Alene i hans Varetægt: -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 0,
      "text": "Har han for hende Vejen jevnet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 0,
      "text": "Og lettet hende Livets Vægt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 0,
      "text": "Har han ej hendes Hjerte saaret",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 0,
      "text": "Til Døden med hovmodigt Sind?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 0,
      "text": "Har han ej hendes Lykke kaaret",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 0,
      "text": "Til Offer for et usselt Skin?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 0,
      "text": "Paa hendes hvide Pande sporer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 0,
      "text": "Han Mærkerne af Sorgens Hæl,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 0,
      "text": "Og hendes stumme Øje borer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 0,
      "text": "Som giftig Pil sig i hans Sjæl.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 0,
      "text": "Da smelter han, - og mens han glatter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 0,
      "text": "Med visne Fingre hendes Haar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 0,
      "text": "Han hvisker: \"Vær nu glad, min Datter!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 0,
      "text": "\"Snart kommer Han, hvem Du attraar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 0,
      "text": "\"I Cadix han en Ladning hented;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 0,
      "text": "\"Saasnart han lander, er han din.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 0,
      "text": "\"Saa faar Du Bod, for Du har ventet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 0,
      "text": "\"Sy altsaa paa dit Brudelin!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 0,
      "text": "Hun sy'de; - og imens hans Sejler",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 0,
      "text": "Ad Havet mere fløj end krøb,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 0,
      "text": "Og snart det spanske Kap den pejler,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 0,
      "text": "Og styrer mod Girondes Løb.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 0,
      "text": "Alt dybt i Horizonten øjner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 0,
      "text": "Han Fædrelandets lave Kyst;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 0,
      "text": "Da mulner Himlen, Havet højner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 0,
      "text": "I voldsom Bølgegang sit Bryst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 0,
      "text": "Og Stormen ud af Skyen farer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 0,
      "text": "Og pidsker Bølgerne til Skum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 0,
      "text": "Og kun et enkelt Lynglimt klarer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 0,
      "text": "Det tætte, sorte Himmelrum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 0,
      "text": "Hans sikkre Sandser dog ej glippe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 0,
      "text": "Og rigtig har sin Kurs han sat; -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 0,
      "text": "Men midt i Løbet staar en Klippe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 0,
      "text": "Der op af Dybet voxer brat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 0,
      "text": "Lumsk under Fladen den sig dølger;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 0,
      "text": "Naar Havet soler sig i Ro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 0,
      "text": "En Kam af aldrig trætte Bølger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 0,
      "text": "Advarer for dens hvasse Klo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 0,
      "text": "Nu, da hans Spryd er Synets Grændse,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 0,
      "text": "Og Havet hvide Roser bær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 0,
      "text": "Han paa sin Lykke frem maa lændse,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 0,
      "text": "Og kommer - Cordouan for nær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 0,
      "text": "Som spiddet Flue Skibet hænger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 0,
      "text": "Et Øjeblik paa Klippens Top;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 0,
      "text": "Saa ruller der en Sø - det krænger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 0,
      "text": "Og Havet har sit Rov slugt op.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 0,
      "text": "Skum blev Kaptainens Bryllupslagen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 0,
      "text": "Og Brændingen hans Brudeseng, -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 0,
      "text": "Det meldte dem et Bræt, som Dagen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 0,
      "text": "Derpaa drev op ved Flodens Eng.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 0,
      "text": "Da slukkedes den Gamles Øje",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 0,
      "text": "I Sorg og Anger, Angst og Gru;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 0,
      "text": "Hun lærte sig for Gud at bøje,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 0,
      "text": "Og tog sit Kors med ydmyg Hu.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 0,
      "text": "Men dette Guld, der havde suget",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 0,
      "text": "Al hendes Faders Sjælefred;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 0,
      "text": "Der som en Drage havde ruget",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 0,
      "text": "Paa hendes unge Kjærlighed;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 0,
      "text": "Der havde hendes Vilje lænket,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 0,
      "text": "Og tvende varme Hjerter skilt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 0,
      "text": "Der havde Himlens Love krænket,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 0,
      "text": "Og hende Livets Foraar spildt, -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 0,
      "text": "Det gad hun ikke gjemme ene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 0,
      "text": "Men bort det til et Storværk gav;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 0,
      "text": "Det sænked hun som Kæmpestene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 0,
      "text": "Ned i sin tabte Brudgoms Grav.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 0,
      "text": "Hvor Klippen stod med skarpe Sider,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 0,
      "text": "En Huggetand i Flodens Mund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 0,
      "text": "Snart over Havets Flade skrider",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 0,
      "text": "Et muret Bjerg, en Fæstning rund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 0,
      "text": "Den skal ej trodse Landets Fjende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 0,
      "text": "Men Stormens Magt og Bølgens Brud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 0,
      "text": "Og Trøst og Tryghed fra dens Tinde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 0,
      "text": "Skal straale over Havet ud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 0,
      "text": "Den minde skal om ham, der døde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 0,
      "text": "Idet den frelser Manges Liv;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 0,
      "text": "I Kalken Enkens Taarer fløde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 0,
      "text": "Men den skal fryde mangen Viv.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 0,
      "text": "Thi højt et mægtigt Taarn sig strækker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 0,
      "text": "Fra Stenkolossens faste Plan,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 0,
      "text": "Omsat af ranke Søjlerækker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 0,
      "text": "Der bær' dets luftige Altan.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 0,
      "text": "Forinden, bag Kapellets Bue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 0,
      "text": "Guds Moder troner, høj og ren,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 0,
      "text": "Og derfra flyver Troens Due",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 0,
      "text": "Tilsøs med Haabets Oljegren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 0,
      "text": "Men øverst Taarnets Kegle ender",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 0,
      "text": "Sig som et kuplet Marmortelt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 0,
      "text": "Hvorfra et Fyr hver Nat udsender",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 0,
      "text": "Sit Lys vidt over Havets Felt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 0,
      "text": "Trehundred Aar er gangne siden:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 0,
      "text": "I Højde voxed Taarnets Krop,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 0,
      "text": "Og hvad der gnavedes af Tiden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 0,
      "text": "Har andre Slægter pyntet op.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 0,
      "text": "Men at det var en ædel Kvinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 0,
      "text": "Som Frankrigs Eddystone har skabt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 0,
      "text": "Det er et Sagn, et helligt Minde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 0,
      "text": "Som Havets Sønner ej har tabt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 0,
      "text": "De huske det, saa tidt de pløje",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 0,
      "text": "I Storm og Mulm den spanske Sø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 0,
      "text": "Og deres Tanker sammenføje",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 0,
      "text": "Med Himlens Jomfru Jordens Mø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 0,
      "text": "Og naar de Taarnets klare Øje",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 0,
      "text": "Opdage over Himlens Rand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 0,
      "text": "De tause deres Hoved bøje",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 0,
      "text": "For Jomfruen af Cordouan.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
