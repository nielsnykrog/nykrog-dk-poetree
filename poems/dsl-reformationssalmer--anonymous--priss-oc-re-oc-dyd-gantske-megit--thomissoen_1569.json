  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Priss oc ære oc dyd gantske megit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "summo Iesu Christo pro isto,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "den tid Gud saa oss trengde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "dedit auxilium,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "wi vaare i nød saa lenge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "tunc misit filium,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "hans loff ville wi siunge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "baade met hierte oc tunge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "canendo dulciter coæqualiter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Engelen bar oss trøst/ met sin røst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Verbum dixit Aue suaue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Maria fuld met Naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "sit tecum Dominus",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "All Verden frelste aff vaade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "procul et cominus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Eua Verdens quinde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Kunde den naade ey finde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "quam virgo reperit, Deum peperit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Den som Himmel oc Jord met it ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "in ortu creauit, portauit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Maria foruden all møde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "in ventris gremio.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "De glæddis som før vaar døde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "De vitæ præmio.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Aff sin Faders rige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Hand kom/ oc bleff vor lige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "natus de virgine, sine semine.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Ræt i en salig tid/ kom hand hid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "nuncius fidelis, de coelis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "For vor skyld vilde hand lide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Mundi tristitiam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Hand tog bort sorrig oc quide/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "reddens læticiam.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "Wi ville hannem der for loffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "Aff alt det wi formoffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "pro nostro studio, cum tripudio.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "Vel er oss det wi ere skabt/ wfortabt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "in Bethlehem rex gratus, est natus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "Som oss skal frelse oc verne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "ab hostis fraudibus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "Wi loffue hannem saa gierne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "cunctis temporibus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "Haffde hand ey ladet sig føde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "Da haffde wi alle værit døde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "Iam vita claruit, lux apparuit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "Sorrigen er bortuent/ som er kient/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "Omnes ergo lætè gaudete.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "Maria/ som kallis at være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 5,
      "text": "impleta gratia,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 5,
      "text": "Hun monne det Foster bære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 5,
      "text": "Nobis solatia",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 5,
      "text": "Alt monne der aff riise/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 5,
      "text": "Wi ville det loffue oc prise/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 5,
      "text": "cunctis temporibus, cum honoribus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "Hun haffuer fød en Søn/ faur oc skøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "reddens omnem mundum iucundum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 6,
      "text": "Der glædis all Himmerigs skare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 6,
      "text": "de partu Dominj,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 6,
      "text": "All Verden er frelst aff fare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 6,
      "text": "pax datur hominj.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 6,
      "text": "Gud vilde til oss vende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 6,
      "text": "Sin glæde/ foruden all ende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 6,
      "text": "post hoc exilium, propter filium.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "Alt men wi ere til/ met got skæl/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 7,
      "text": "grati simus Deo, pro eo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 7,
      "text": "Hand vilde oss dyre kiøbe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 7,
      "text": "ad vitæ meritum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 7,
      "text": "Nu maa wi alle vndløbe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 7,
      "text": "Mortis interitum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 7,
      "text": "Hand vilde oss Himmerig giffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 7,
      "text": "At wi maa met hannem bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 7,
      "text": "in regno gloriæ, omni tempore.",
      "part": false,
      "marginal_notes": []
    }
  ]
}