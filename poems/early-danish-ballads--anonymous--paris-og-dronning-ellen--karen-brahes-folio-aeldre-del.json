{
  "id": null,
  "title": "Paris og Dronning Ellen",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA198.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Parris hannd wor enn herre saa bolld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "well otte kong-rigger haadde hand y wolld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": ":: Well op, rosser, om y well Paaris følgge! ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Well otte kongee-rigger och ind et land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "iligee-weell thieentte hand en anddenn mand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "Hannd thieennte konng Niellius y aaar feem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "men icke wilde hand haffue lønn for dem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "Hand thintte kong Nillus y aaar ny,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "menn icke wilde hand haffue lønn for dy.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "Hand thienntte hanom icke for anddenn lønn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "ind for droning Ellind hun waar saa skiønn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "Kong Niellus hand skulde y lieeding faare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "I lieeddinng faarre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 5,
      "text": "Paaris skulde werre hieme och thage landdenn waarre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "\"Wogtte du nu weell buode rige och land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "men miest droning Ellind, myn lili-wand!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "Kong Nieellus skuldde styrre synn skibb fraa land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 7,
      "text": "saa gladd war Paaris, hand rende synn ganger paa saanndd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "Paaris mone seg y loffttet gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 8,
      "text": "droning Ellind hun wilde icke siee hannom paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "Paarris monne sieg till guldsmiedden gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 9,
      "text": "der luod hannd harpe aff rødde guld slaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "Harpenn vd-aff thett røde guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 10,
      "text": "menn alle wor strenngenn saa suige-fuld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "Paarisz gick sieg vndder murenn att staa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 11,
      "text": "alltt som droning Ellind skulde liudde der-paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "Først legtte hand lieg, saa lieegtte hand thuo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 12,
      "text": "alt saad dronning Ellind, hun liude der-paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "Droning Ellind hun smiller vndder skaarlagenn-skieennd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 13,
      "text": "\"Chrest gyffue, Paaris, du warst aldder-kiereste mynn!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "Paaris hand tøgte thett weell att werre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 14,
      "text": "\"Chrest giffue, droning Ellind, i wilde haffue mieg kierre!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "Buod lyuff och laand och allt thett ieg aae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 15,
      "text": "thett skuldde y, min naaddige frwe, for raadde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "Ind lagde Paariss sinn taall saa slett,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 16,
      "text": "thett droning Elinnd hun gaff hanom syn thro saa braatt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "Denn thid hun haffdde hanom giffuet synn thro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 17,
      "text": "och daa lagde thi saa snilde rad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 18,
      "text": "Enn mur luod dy vndder iordenn slaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 18,
      "text": "fraa slottitt och nedder till straandden mone gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 19,
      "text": "Kong Nieellus hand kaam fraa lieeding hieem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 19,
      "text": "Paaris hand red hanom vd igenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 20,
      "text": "\"Veell møtt, Paaris, søster-sønn mynn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 20,
      "text": "huor lider droning Ellinnd, mynn edelig førstinndde?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 21,
      "text": "\"Weell lydder droning Elind, edders førstinde skønn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 21,
      "text": "kong Nieellus, och widder y meg en bønn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 22,
      "text": "Giffuer meg luoff att faare hiem till lande myn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 22,
      "text": "och giffuer meg droning Ellind hindis thienste-quinndde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 23,
      "text": "\"Parris, tthett kaam alldrig y dynn huoff heelder synde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 23,
      "text": "att thu wilde loffue droning Ellins thieeneste-quindde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 24,
      "text": "Dog weell ieg seelliff ride till burre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 24,
      "text": "och rade med myn droning saa prudde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 25,
      "text": "Alltte thett thi thaalde saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 25,
      "text": "alltt stuod droning Ellinnd och lyedde der-paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 26,
      "text": "Kong Nieellus hand meelltte ett ord fraa seeg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 26,
      "text": "\"Ieg suo aldrig enn møø were droning Ellind saa lig.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 27,
      "text": "Saa faast kong Nieellus till slottitt red,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 27,
      "text": "halleff faster droning Ellind vndder iorddenn skreed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 28,
      "text": "Kong Nieelus ind paa slottett monne gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 28,
      "text": "droning Ellinnd hun gaar hanom vd imuod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 29,
      "text": "\"I wer weell-komen, kieere herre mynn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 29,
      "text": "huor haffuer edder y lieding lid?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 30,
      "text": "\"Weell haffuer mig y lieeding lid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 30,
      "text": "menn dieg lidder weell, alderkierste mynn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 31,
      "text": "Hør thu thett, allder-kieereste mynn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 31,
      "text": "Paaris beedder om thinn thieneste-quind.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 32,
      "text": "\"Paaris hand er enn konge saa rig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 32,
      "text": "hand weell icke haffue en iumfru slig.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 33,
      "text": "\"Daa weell ieg nu ridde till sttraandde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 33,
      "text": "och skaffe hanom med dyn møø fraa landde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 34,
      "text": "Saa faast som hannd fra slottett red,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 34,
      "text": "haleffaster hun vndder iorddenn skreed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 35,
      "text": "Der hand kaam till stranndde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 35,
      "text": "daa stuod droning Ellind paa saandde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 36,
      "text": "\"Hør y thett, mynn eddelig herre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 36,
      "text": "giffuer mig denne lili med hier och erre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 37,
      "text": "Kong Nillus hand sluo synn huoffuett muod buord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 37,
      "text": "\"Monne thett icke werre med falskhieed giortt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 38,
      "text": "Rett aldrig suo ieg en møø nu slig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 38,
      "text": "der kundde och were mynn droning saa lig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 39,
      "text": "Ieg weell inndnu ridde till slottitt igenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 39,
      "text": "och rade med myn droning saa ween.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 40,
      "text": "Den tid hand kaam till burre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 40,
      "text": "daa møtte hanom droning Ellind saa prudde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 41,
      "text": "\"Hør thu thett, aldderkiereste mynn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 41,
      "text": "du skalt giffue Paarisz dynn thieeneste-quind.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 42,
      "text": "\"Daa weell ieg med edders willi och rad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 42,
      "text": "giffue hanom den, hand begier att haffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 43,
      "text": "Medt eders villie och raad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 43,
      "text": "giffue hannem dend, hand begierer at haffue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 43,
      "text": "Thridi gang red hand till stranddenn iigenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 43,
      "text": "alt stuod Paaris och bad om hind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 44,
      "text": "Kong Nieelus hand fraa hestenn stuod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 44,
      "text": "saa gaff hand Paaris syn droning guod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 45,
      "text": "Paaris styrer synn snecke fraa land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 45,
      "text": "kong Nieelus hand red till slottitt igenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 46,
      "text": "Tther hand kaam till slottitt igenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 46,
      "text": "bortte waar droning Ellind, thett wor stuor mien.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 47,
      "text": "Saa luod hand rede alle synn skibbe till strid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 47,
      "text": "for Tryøborig y saa vnd en thidd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 48,
      "text": "Hand luo der-for siuff aaar om-kring,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 48,
      "text": "hand kundde icke sieer aff Paaris vynde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 49,
      "text": "Saa kaam der gangind saa gamell enn maannd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 49,
      "text": "saa vnde rad daa kieendde han hanom.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 50,
      "text": "\"I laadder enn heest aff kobber giørre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 50,
      "text": "siuff hunddrett mennd laader y dder-y førre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 51,
      "text": "Laadder saa thiding offuer landitt gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 51,
      "text": "thett alld edders guld y heestenn mone staa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 52,
      "text": "I laadder daa heestenn for slottett kiørre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 52,
      "text": "saa stuortt ett vnder maa y daa hørre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 53,
      "text": "Der hestenn kaam for puortten att staa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 53,
      "text": "saa giørlig thuog dy daa waare paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 54,
      "text": "Paarris hand suøber seg hoffuett y skiend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 54,
      "text": "hand gaar y lofft for droning Ellinnd ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 55,
      "text": "\"Denn kobber-hest mone for puorttenn staa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 55,
      "text": "raadder y, att wy skaall ladde hanom att puortenn ind-gaa?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 56,
      "text": "Tthett meelltte dronning Ellinnd, hun glieemer som guld:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 56,
      "text": "\"Kong Nieellus er edder saa suigge-fuld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 57,
      "text": "Hand haffuer lieett her for vdi siuff aaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 57,
      "text": "ieg frøgtter saa saare, hand weell oss forraadde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 58,
      "text": "Paarris klaper hyndder weed huiddenn kiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 58,
      "text": "\"Y sørger icke, hiartt-alder-kieereste mynn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 59,
      "text": "Thrøborig er fast buodde vdde och indde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 59,
      "text": "kong Nillus hand kaand oss aldrig her vd winndde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 60,
      "text": "I denn gang, som nieedder till puorttenn monne gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 60,
      "text": "huert aar kand wi siuff pund kiornn der-y saaa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 61,
      "text": "\"Dog skaallt thett, Paaris, were mitt raad:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 61,
      "text": "y lader den hest vden puorten staa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 62,
      "text": "Paaris hand smiller vnder skieend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 62,
      "text": "\"Hesten well ieg nu laadee her innd.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 63,
      "text": "Hand baad, att thi skuldde puorttenn op-slaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 63,
      "text": "saa hestenn maatte paa slottitt gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 64,
      "text": "Saa luod thi alle aff slottett staa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 64,
      "text": "att thi kund hestenn inden puorttenn faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 65,
      "text": "Thi finge denn hest paa slottett ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 65,
      "text": "hand giordde denom sorig och blegge kieend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 66,
      "text": "Denn første naatt, der efftter kaam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 66,
      "text": "dy rieesner vd aff heestenn spraanng.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 67,
      "text": "Hestenn thuog till att sprude,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 67,
      "text": "den gluendis ild att skiiude.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 68,
      "text": "Saa sluo dy nieder buod mur och thieendde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 68,
      "text": "ind-till dy mone thett feeste wyndde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 69,
      "text": "Paaris hand den thiddenn fornam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 69,
      "text": "hand wor forrad och alle hans lannd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 70,
      "text": "Paaris hand monne med droning radde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 70,
      "text": "huad raade thi skuldde denom till thaage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 71,
      "text": "\"Hør y, droning Ellind, myn lili-wand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 71,
      "text": "weell y nu gaa kong Nillus till haand?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 72,
      "text": "Hun suaritt hanom snartt aff haarddenn synde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 72,
      "text": "\"Wy weell icke att-skillies, men liffuett kand wyendde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 73,
      "text": "Wy weell lade begge wor midillaner slaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 73,
      "text": "enn leetter død kand wy aldrig faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 74,
      "text": "Wy laadder heelder blod løbe oss till dødde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 74,
      "text": "ind løffue y werden med sorrig och møødde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 75,
      "text": "Dy luod slaa dieris aarrer vdi den haarum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 75,
      "text": "saa sualltt di buodde y huer-anddres arum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 76,
      "text": "Kong Nillus hand ind paa slottett kaam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 76,
      "text": "droning Ellind wor død, hand bleff saa graam.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 77,
      "text": "Thett wor kong Niellus hanss største harum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 77,
      "text": "droning Ellind hun dødde y Paarisz arum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 78,
      "text": "\"Nu wilde ieg icke agtte om all dienne myenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 78,
      "text": "haade Paaris icke weritt mynn søster-sønn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 79,
      "text": "Miest er mig for myn førstinde, hun waar saa wen.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 79,
      "text": "Saa luod hand leegge denom buode vndder en mallumer-stieenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 79,
      "text": ":: Well op, roser om y well Paariss føllgge. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}