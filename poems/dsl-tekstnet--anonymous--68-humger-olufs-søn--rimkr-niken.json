    {
      "id": 0,
      "stanza_id": 0,
      "text": "meth Lodwig keyser at stride.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Thi giorde ieg meth hannum en wenlig pacth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "ieg lod ey lengher bide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "I sodan modhe ath Egdher flodh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Och wære hwær anners wenner godh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "meth kerlighed och god willi.",
      "part": false,
      "marginal_notes": []
    }
  ]
