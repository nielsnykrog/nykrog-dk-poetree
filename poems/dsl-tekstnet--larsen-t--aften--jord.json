  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Det damper af Eng, det skinner af Dugg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "og Vandene slumrer i vage Vugg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Der daler Fred over Jorden ned",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "og over mit Hjertes Ensomhed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "Den glider saa sagtelig fra det blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "hvor evige Verdner lydløst gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Min Sjæl er af dybe Drømme fuld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "den spejder og lytter over Mark og Muld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "Og Dæmringen drømmer i Vest og Nord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "og Smaaskyer sover højt over Jord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 5,
      "text": "Jeg renser mit Blik i Himlens Blaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "og gemmer i mit Sind alt fagert, jeg saa.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
