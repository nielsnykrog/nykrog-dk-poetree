  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "NV frøyder eder alle Christne mend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc lader oss frylig springe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "At wi ere trøstit alle paa en/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "met løst saa ville wi siunge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Huad Gud mod oss haffuer beted/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "aff sin store barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "forløst haffuer han oss dyre",
      "part": false,
      "marginal_notes": []
    }
  ]
