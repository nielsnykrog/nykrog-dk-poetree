  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "LOffuer Herren alle Hedninge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "och tilhobe loffuer Gud alle Folck",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Fordi hans miskundhed er stadfest offuer oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Och Herrens sandhed bliffuer euindelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "⁕ Ere vere Gud Fader och hans Søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "oc saa Gud den Helligaand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Som verit haffuer aff begyndelsen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "nu oc al tid er/ fra euigtid och til euighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "Amen",
      "part": false,
      "marginal_notes": []
    }
  ]
}