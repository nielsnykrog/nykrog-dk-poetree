  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Mit Livs Eventyr (Inklusive Fortsættelse Og Tillæg). 1855-1877",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1855,
    "url": "https://tekstnet.dk/books/andersen-hc_mit-livs-eventyr-inklusive-fortsaettelse-og-tillaeg-1855-1877/029/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Det var Udstillings Tiden paa Charlottenborg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Alt der var nyt og Meget godt og Deiligt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Et Billed greb mig, ung og smuk stod Munken",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Og saae to unge Ægtefolk tilæsels",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Reed hjem saa lykkelige begge to.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Og Munkens Ungdoms Sjæl og varme Tanke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Gjød Veemod over hele dette Skue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Man følte, kun et Hjerte maler Sligt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "– Hvert Aar fremstod et nyt et herligt Billed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Vi Samson saae iblandt Philisterne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Vi saae Barberen, vi saae Romerdrengen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Livs Smerten, Lunet just i sandt Humeur.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Nu kom »Prometheus«, Sneen smæltet bort",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Fra Mængdens Øine, hvilket Storheds Billed;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Hvor var jeg glad med hele Kjøbenhavn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Da saa vi mødtes, Du var som jeg tænkte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "En Barne-Sjæl og dog saa mandig klog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Beskeden, tvivlende om egen Styrke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Og dog forvisset om Din Guds Mission",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "Thi ellers aldrig kunde den fuldføres",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "Da fik jeg Dig saa kjær, tag mine Blomster,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "Som Tegn paa Glæden og paa Hjertelaget.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "Farvel Prindsesse Dagmar, Du gaaer til Storhed og Glands,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "En Keiserkrone groer der udi Din Brudekrands,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 1,
      "text": "Gud lade sit Solskin lyse i Dig og Dit nye Hjem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 1,
      "text": "Da bliver til Perle hver Taare, som Skilsmissen kalder frem!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
