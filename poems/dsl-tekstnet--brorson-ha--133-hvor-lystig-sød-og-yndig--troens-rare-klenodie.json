  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Hvor lystig, sød og yndig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Er deres fødders lyd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Som kraftig, liflig, fyndig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Bebuder fred og fryd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "De bange og de arme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Som føle syndens byld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "At GUd sig vil forbarme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "For JEsu pines skyld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Den lov, som GUd har givet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Er vel et herligt bud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Men skaffer ingen livet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Og fører ey til GUd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Naar vi den gift fornemmer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Af kiødets onde lyst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Og satan hiertet klemmer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Veed loven ingen trøst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Hun vil, at sielen efter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "GUds villie skal gaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Dog dertil ingen kræfter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Hos hende er at faae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Hun siger, vi skal høre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Den GUd, som os har skabt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Men evne, det at giøre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Har sielen gandske tabt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "De onde kand hun vække",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Med hendes tordenslag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Samvittigheden skrekke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Med dommens store dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Hvordan GUds vrede brænder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Naar hun er overtraad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Men naar man det erkiender,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Saa veed hun ingen raad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Saa prædiker de arme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "Det ret i hiertet ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "At GUd sig vil forbarme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "Med meer end faders sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "At giøre dennem rene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "I JEsu dyre blod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "Og livets kraft forlene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "I deres hierte-rod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "GUd, som os skulde straffe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "Har selv udi sin søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 5,
      "text": "Os redning vildet skaffe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 5,
      "text": "Da syndens beeske løn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 5,
      "text": "Blev lagt paa JEsu hierte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "Da hand for verdens flok",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "Til døden lod sig smerte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "Det var betalning nok.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "Vi røve GUd hans ære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 6,
      "text": "Med synd saa tyk som sand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 6,
      "text": "Og satans merke bære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 6,
      "text": "Af Evæ æbletand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 6,
      "text": "GUd selv vor borgen bliver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "Da det om redning galdt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "Og sig i døden giver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "At faae vor gield betalt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 7,
      "text": "Vor jammer hand paatager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 7,
      "text": "Dog gandske synde-fri,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 7,
      "text": "I alle andre plager",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 7,
      "text": "Et menniske som vi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 7,
      "text": "Ja meer, i alt det andet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 7,
      "text": "Af satan, synd og nød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 7,
      "text": "Blev fristet, ja forbandet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "Til korsets beeske død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 8,
      "text": "Der haver hand da kæmpet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 8,
      "text": "Med GUd, som ham forlod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 8,
      "text": "Og al hans vrede dæmpet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 8,
      "text": "Der hand sin prøve stod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 8,
      "text": "Det havde at betyde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 8,
      "text": "Den hele satans leyr",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 8,
      "text": "For os at giennembryde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 8,
      "text": "Og vinde saadan seyr.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 9,
      "text": "Nu er vor GUd forsonet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 9,
      "text": "Og al vor skyld forladt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 9,
      "text": "Vor JEsus hand er kronet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 9,
      "text": "Og GUd ved siden sat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 9,
      "text": "Og satan hand maa høre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 9,
      "text": "Den sag med skændsel paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 9,
      "text": "Hvad vil hand os nu giøre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 9,
      "text": "Ham kand hand ikke naae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 10,
      "text": "Nu maa den slange vide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 10,
      "text": "Naar hand os fange vil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 10,
      "text": "Den hos GUds høyre side,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 10,
      "text": "Hand siger ney dertil.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 10,
      "text": "Hand kiender vor formue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 10,
      "text": "Hvor lidet vi formaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 10,
      "text": "Hand selv vil satan kue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 10,
      "text": "At vi kand seyren faae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 11,
      "text": "Fri ere vi og blive",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 11,
      "text": "Fra lovens tordensky,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 11,
      "text": "GUd vil i hiertet give",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 11,
      "text": "Sit eget sind paa nye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 11,
      "text": "Hans aand vil hiertet sette",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 11,
      "text": "I kierlighedens brand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 11,
      "text": "Og al vor vandring rette",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 11,
      "text": "Til himlens fryde-land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 12,
      "text": "Saa har da lovens trusel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 12,
      "text": "Fremdeles ingen fynd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 12,
      "text": "Guds søn har skiult vor blusel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 12,
      "text": "Og gandske reen fra synd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 12,
      "text": "Os stiller for sin fader,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 12,
      "text": "Og lindrer al vor vee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 12,
      "text": "Ey fra sin haand os lader,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 12,
      "text": "Før vi ham faae at see.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 13,
      "text": "See, der er mad at smage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 13,
      "text": "I evangelio",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 13,
      "text": "For dem, som synder plage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 13,
      "text": "Og søge siele-roe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 13,
      "text": "Som dødens beske miner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 13,
      "text": "Og satan bange giør,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 13,
      "text": "Samvittigheden piner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 13,
      "text": "Og lukker naadens dør.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 14,
      "text": "Her ingen vrede findes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 14,
      "text": "Vor straf vor JEsus leed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 14,
      "text": "Og alle saar forbindes",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 14,
      "text": "I JEsu blod og sveed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 14,
      "text": "Her ængstes intet hierte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 14,
      "text": "Al fare er forbi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 14,
      "text": "Thi JEsu død og smerte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 14,
      "text": "Har giort os gandske fri.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 15,
      "text": "GUds søn, vor viisdom bleven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 15,
      "text": "Var satans magt for klog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 15,
      "text": "Som blev med skam fordreven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 15,
      "text": "Før hand sig vare tog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 15,
      "text": "Retfærdighed hand bliver",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 15,
      "text": "Os, naar vi naade faae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 15,
      "text": "Og hellighed i iver",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 15,
      "text": "Paa livets vey at gaae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 16,
      "text": "Den sag var høy og vigtig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 16,
      "text": "At redde Adams kiøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 16,
      "text": "GUd kom og gav os rigtig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 16,
      "text": "Sin egen kiere søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 16,
      "text": "I ham sit eget hierte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 16,
      "text": "Og alting gandske hen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 16,
      "text": "Og det en steen maa smerte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 16,
      "text": "Hand elskes lidt igien.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 17,
      "text": "Den naade vil jeg prise",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 17,
      "text": "Til døden inderlig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 17,
      "text": "I gierning vil jeg vise,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 17,
      "text": "Hvad hand har giort mod mig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 17,
      "text": "Jeg vil ham evig tiene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 17,
      "text": "Og den retfærdighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 17,
      "text": "Hand vilde mig forlene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 17,
      "text": "Er al den pragt jeg veed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 18,
      "text": "Min JEsum blaa og blodig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 18,
      "text": "Jeg har i troen paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 18,
      "text": "Og dermed vil frimodig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 18,
      "text": "For HErrens ansigt staae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 18,
      "text": "Vil synd og satan skade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 18,
      "text": "Jeg tager JEsum fat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 18,
      "text": "Hand kand mig ey forlade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 18,
      "text": "Hand er min egen skat.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
