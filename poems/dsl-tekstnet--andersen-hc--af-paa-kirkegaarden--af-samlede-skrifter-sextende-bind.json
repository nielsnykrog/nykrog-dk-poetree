  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Tænk kun paa ham hvis Støv er Graven bragt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Erindring, udfold heel din Blomsterpragt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Et Smiil sad i hans Øie, om hans Mund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Det lyste fra den rene Hjerte-Bund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "Husk Julens Glæder, naar han spøgte glad;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "Saa rigt og stort er Hjertets Mindeblad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Hos Eder lykkelig og glad han stod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "For Danmarks Sag, han Hjemmets Hjem forlod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "Den vaade Jord og Nattens kolde Vind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "Skjød Dødens Kugle i hans Hjerte ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 5,
      "text": "Sit unge Liv han glad for Danmark gav.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "De Runer vil’ vi riste paa hans Grav!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
