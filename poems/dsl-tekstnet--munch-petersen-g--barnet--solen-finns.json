  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Solen Finns",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1936,
    "url": "https://tekstnet.dk/books/munch-petersen-g_solen-finns/046/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "när barnet vill plocka en blomma",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "och icke får,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "då gråter barnet utanför stängslet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "eller skriker högt och stampar med foten",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "eller går tyst bort att söka annat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "som det kanske får och som också är vackert att ta -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "........ och när de gamla",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "har byggt så mycket stängsel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "att inget finns för dem, som de får,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "och. som tillika är vackert och mjukt att ta i,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "då bygger de sig mörkbruna hus",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "att sitta i på kvällarna och sjunga",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "dova krypande sånger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "till gudar utav spindelväv och damm -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "när barnen sover, förgråtna eller lugnt leende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "då låter från de stängda mörkbruna husen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "klagosångerna mot dödens lycka bakom tillbommade fönster -",
      "part": false,
      "marginal_notes": []
    }
  ]
}
