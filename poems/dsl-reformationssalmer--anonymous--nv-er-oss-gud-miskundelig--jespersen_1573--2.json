  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "NV er oss Gud miskundelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc hand vil oss velsigne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Sit ansict offuer Jorderig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "det lader hand offuer oss skinne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "At wi paa Jorden maa forstaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "hans vey oc hellige naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Oc Jesus Christus kiendis saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "blant folck i mange maade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Gud styre for oss oc raade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Wi tacke Gud oc loffue dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Dit Hedenske folck offuer alle:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Oc alle Land de glæde sig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Dit naffn de nu paakalde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "At du retfærdig Dommer est/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Lad oss icke mere vildfare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Dine Ord kunde oss beskerme best/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Jhuo dem vil beuare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Hand leffuer foruden all fare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Wi tacke Gud oc loffue dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Dit folck i mange maade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Din Jord bær fruct oc bedrer sig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Det kand dine ord vel raade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Signe oss Gud Fader oc Guds Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Oc signe oss Gud den hellig Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "For hannem skulle rædis alle Land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Thi alting stander vdi hans haand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Wi siunge aff hiertet Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Ære være Gud Fader i Himmerig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Som alting haffuer at raade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Disligest hans Søn euindelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Som frelst haffuer oss aff vaade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Oc loffuit være den hellig Aand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "Som giffuer oss aff sin naade/ Den ære haffuer værit aff euig tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "Oc bliffuer foruden all ende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "Gud oss sin naade sende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "ECce Deus adiuuat me,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "et Dominus susceptor est animæ meæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "auerte mala inimicis meis in veritate tua,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "disperge illos protector meus Domine.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "Deus in nomine tuo saluum me fac,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "et in virtute tua iudica me.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "Gloria Patri et Filio et Spiritui sancto:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 5,
      "text": "Sicut erat in principio et nunc et semper,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 5,
      "text": "et in secula seculorum, Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "HAleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 6,
      "text": "Attendite popule meus in legem meam.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 6,
      "text": "Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 7,
      "text": "VDen Herren opholder vort Huss oc gaard/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 7,
      "text": "oc skaffer huad der er inde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 7,
      "text": "Oc sender sin huert Aar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 7,
      "text": "at wi maa altid finde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 7,
      "text": "hans Guddoms gaffue gifft oc laan/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 7,
      "text": "som hand giffuer met sin milde haand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 7,
      "text": "ellers er vort arbeid forlaarit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 8,
      "text": "Vden Herren selff den Stad beuarer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 8,
      "text": "Oc vocter baade Land oc Rige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 8,
      "text": "Oc met sin Guddoms mact forsuarer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 8,
      "text": "Oc holder dem saa ved lige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 8,
      "text": "Vden Gud giffuer selffuer naade oc fred",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 8,
      "text": "Forgeffuis da vaage de Voctere ved/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 8,
      "text": "All konst oc raad monne falde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 9,
      "text": "Thi seer til i som aarle opstaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 9,
      "text": "Oc side om afftenen silde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 9,
      "text": "Met sorrig arbeide oc stor vantro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 9,
      "text": "Saa ville i giøre eder rige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 9,
      "text": "Met kummer i æde det harmelig brød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 9,
      "text": "Thi Gud sender sine baade klæde oc føde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 9,
      "text": "Naar de monne sødelig soffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 10,
      "text": "Seer eders Fruct oc Børn saa smaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 10,
      "text": "Dem haffuer Herren skabit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 10,
      "text": "Alt effter sin euige Vissdoms raad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 10,
      "text": "Oc eder met dem begaffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 10,
      "text": "Hand vil oc dem saa vel forsee/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 10,
      "text": "At deris føde skal være til rede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 10,
      "text": "Det skulle i selffuer befinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 11,
      "text": "Ligeruiss som mange pile oc skud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 11,
      "text": "En Stridsmand haffuer i hænde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 11,
      "text": "Oc effter sin villie oc effter sit bud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 11,
      "text": "Monne dem forskiude oc sende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 11,
      "text": "Saa giør oc Gud ved Quinde oc Mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 11,
      "text": "Aff atskillige Stæder oc fremmede Land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 11,
      "text": "Kommer hand dem vnderlig sammen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 12,
      "text": "Vel er den Mand/ der Gud vil giffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 12,
      "text": "Slig vnge folck oc mange/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 12,
      "text": "At hand færdig oc rystig maa bliffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 12,
      "text": "Mod sine Fiender at stande/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 12,
      "text": "Naar hand taler met dem i Porte oc Taarn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 12,
      "text": "Da skal hand altid gaa dem tilforn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 12,
      "text": "Hand skal icke bliffue forhaanit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 13,
      "text": "Gud Fader oc Søn oc den hellig Aand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 13,
      "text": "Hannem bør oss alle at prise/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 13,
      "text": "At hand beuarer vort Huss oc Land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 13,
      "text": "Oc oss velsignelse beuiser.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 13,
      "text": "Hand styrcke vor Tro oc Kierlighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 13,
      "text": "At wi ey met wtacknemmelighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 13,
      "text": "Hans godhed skulde bortkaste.",
      "part": false,
      "marginal_notes": []
    }
  ]
}