{
  "id": null,
  "title": "Mig elsker af hjertet en fuldtro ven",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
