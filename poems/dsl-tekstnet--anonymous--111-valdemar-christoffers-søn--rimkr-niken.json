{
  "id": null,
  "title": "111. Valdemar, Christoffers søn",
  "year_created": 1495,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Rimkrøniken",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1495,
    "url": "https://tekstnet.dk/books/anon_rimkroeniken/114/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "i fattig kones posæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Men kommer katten oc driffuer henne fraa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "hwn tørf ther lidheth aff rosæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Hwor mussen oc katten giøre bode eth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Wthen han seer ther tijl fulbreth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "tha holles han for en abe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Tha Cristoffer, myn fader, aff ganghen waar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "och myne sysken tesligæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "ath ieg motte faa theris rigæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "Twsende oc saa tryhundrede aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "och ther effther fyretiwe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "effter ath Gutz søn føddher waar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 4,
      "text": "tha foer greue Gerd aff Holtzeland",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "oc ind i Iutland ath stride",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "meth xi twsend ey fære en mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "i Randerss tha willæ han bliffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "ath legge aldelis ødhe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "om han kunne nogherletz fanghet thes macth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "The iudher giorde han stor mødhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 6,
      "text": "Som han tha best i Randerss laa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "tha kom Niels Ebbessøn och hannum ther sloo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 6,
      "text": "meth syw och fyretiwe ey flere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 7,
      "text": "Siden sloos han selff for Skandelborig ihiel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "han thet bestallet tha hade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 7,
      "text": "thet wor fulstoor en skade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 8,
      "text": "Tha foer ieg fran keyseren oc tijl Sleswig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 8,
      "text": "hertug Woldemar ieg ther geste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 8,
      "text": "Hans dotther ionfrw Helwig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 9,
      "text": "Saa bleff ieg tha kest tijl konning i stad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 9,
      "text": "aff iwdernæ och siælantzfare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 9,
      "text": "Men tydeskæ hade tha slottenne fat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 9,
      "text": "the willæ meg intheth sware.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 10,
      "text": "ath the skullæ meg them oplade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 10,
      "text": "och fare saa selff tijl lande hiem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 10,
      "text": "och intheth paa Danmark hade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 11,
      "text": "Tha swarede the meg endræcthelig saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 11,
      "text": "Paa annen dægen willæ wij ey gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 11,
      "text": "wij holle thee rødhe stene.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 12,
      "text": "Thi lade ieg først for Kaldenborig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 12,
      "text": "och fik thet tijl gode rede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 12,
      "text": "och fik thet samme leede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 13,
      "text": "Siden wand ieg ther nest Friseland",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 13,
      "text": "en xi twsend iomfrwes affthen at qwælle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 13,
      "text": "och kom thet ighen wndher danes hand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 14,
      "text": "Ther effther fik ieg Worenborg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 14,
      "text": "wndher myn wern och haffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 14,
      "text": "och saa Korsør paa Pædeborig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 14,
      "text": "saa holt ieg them wed affue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 15,
      "text": "meth manghe aff Danmarks rigæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 15,
      "text": "och sloos tijl ridder som Gud meg gaff;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 15,
      "text": "ieg sloo ther andre theslighe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 16,
      "text": "Tha ieg kom syen tijl lande hiem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 16,
      "text": "tha løsde ieg manghe slot aff them",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 16,
      "text": "som the hade tha i wære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 17,
      "text": "Siden giorde ieg eth mode i Helsingborg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 17,
      "text": "meth hedherlig herrer oc mange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 17,
      "text": "som ieg hade iæt forlanghe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 18,
      "text": "Han giorde stoor skade och fik oc saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 18,
      "text": "i Siæland tha han tijd færdis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 18,
      "text": "Thi ieg ther tijl gemmen fingher saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 19,
      "text": "Tree reyser giorde ieg tijl Tydeskeland.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 19,
      "text": "Først brende ieg Landtopøle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 19,
      "text": "Annen tijd foer ieg myn swawer tijl hand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 19,
      "text": "ieg lade hans fiende i søle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 20,
      "text": "och kærlighe hannum forlicthe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 20,
      "text": "meth twenne greffuer som wore i Stetyn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 20,
      "text": "och lodh ther breff paa dicthe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 21,
      "text": "Men tha ieg foer tijl ryggæ ighen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 21,
      "text": "tha giorde han meg fuldstoort eth men,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 21,
      "text": "segh skreff aff Wendis lande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 22,
      "text": "Thi brende ieg hans slot, stædher oc by",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 22,
      "text": "och sloo hans folk tijl døde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 22,
      "text": "them giorde ieg meghen nøde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 23,
      "text": "Paa somme lod ieg skære næsen op",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 23,
      "text": "och somme theris ørnæ aff skære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 23,
      "text": "Saadan lyde paa theris krop",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 24,
      "text": "Siden wand ieg oc saa Traneker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 24,
      "text": "som tydskæ hade them tijl hande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 24,
      "text": "och Nørreborig meth samme her",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 24,
      "text": "alt før wij fore tijl lande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 25,
      "text": "som ieg hade iæt them førre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 25,
      "text": "och wand thet wndher danes hand;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 25,
      "text": "ther holt hwercken porte eller dørre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 26,
      "text": "Ther nest foer ieg tijl Skoneland",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 26,
      "text": "Och Helsinborig ieg offuerwand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 26,
      "text": "konning Magnus tordhe't ey wnsætte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 27,
      "text": "Saa fik ieg ther oc allæ slot,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 27,
      "text": "them torde meg inghen nethe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 27,
      "text": "stoer kærliched the meg wethe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 28,
      "text": "Konning Magnus hade køfft all Skoneland",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 28,
      "text": "lith effther myn fadher døde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 28,
      "text": "aff tydskæ som thet tha hade i hand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 29,
      "text": "Halfierde synnetiwe twsende løde mark",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 29,
      "text": "och alt i sølff hyn bone",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 29,
      "text": "hade han them giffuet wd aff syn ark",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 29,
      "text": "for Helsinborig i Skone.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 30,
      "text": "som ey wore eyer tijl rætte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 30,
      "text": "tha wille ieg haffue't tijl righeth ighen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 30,
      "text": "elder wære meth hannum i trætte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 31,
      "text": "Saa foer ieg tha bædher i øster wd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 31,
      "text": "Borcholmen wand ieg meth skiold oc spiwd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 31,
      "text": "och landheth mellom bægge ænde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 32,
      "text": "Siden foer ieg tijl Gulland ful gladh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 32,
      "text": "och stride paa landheth wel saare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 32,
      "text": "han stodh meg obenbare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 33,
      "text": "Ther fik ieg mere kostelig ting",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 33,
      "text": "indhen Wijsby stad all ene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 33,
      "text": "end ieg hade foeth ther nogher stad omkring,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 34,
      "text": "Tha hense stædher finghe thet sport",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 34,
      "text": "at ieg hade Wijsby wundet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 34,
      "text": "the ginghe i raad, the slowe'th wel stort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 34,
      "text": "thet the fulsaare grundet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 35,
      "text": "the sade the skullæ thet wrecthe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 35,
      "text": "for theris gotz ther arresteret bleff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 35,
      "text": "om the wore fød aff æcthe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 36,
      "text": "Thi skreff ieg them eth breff ighen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 36,
      "text": "meth samme theris bud, ieg wor ey seen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 36,
      "text": "ieg skreff hwerken meer elder mynne:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 37,
      "text": "»Søwen vnde søwentich henseen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 37,
      "text": "hefft søwen vnde søwentech gensen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 37,
      "text": "de hensen frage ich nicht en skiten.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 38,
      "text": "Thi wdgiorde the theris største macth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 38,
      "text": "Helsingborig the genesthen belade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 38,
      "text": "Thet wor saa mest i theris acth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 39,
      "text": "Sexten blidher hade the ther rest",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 39,
      "text": "och kaste bode nat och dawe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 39,
      "text": "The hade tha tenckt Danmark mest",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 39,
      "text": "hade the ey fanghet got awe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 40,
      "text": "som the toghe mest at bramme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 40,
      "text": "en mectig hob ther nogheth droo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 40,
      "text": "The andre fore hiem meth skamme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 41,
      "text": "Twsende iij hundrede aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 41,
      "text": "effter at Gutz søn fødher waar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 41,
      "text": "ieg wil thet ickæ lywe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 42,
      "text": "tha giorde ieg konning Hagen thet tijl gaffn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 42,
      "text": "och saa myn dotther Margrethe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 42,
      "text": "then hedher ieg them ther wethe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 43,
      "text": "Konning Mawensses søn aff Swerigis land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 43,
      "text": "wor han aff æchte och rætthe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 43,
      "text": "Han hadde tha Norghe vndher syn hand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 44,
      "text": "Om syer bleff ieg paa Gorffue døt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 44,
      "text": "paa Wordingborig lafft i iorde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 44,
      "text": "Margrethe, myn dotther, hwn siden thet bøt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 44,
      "text": "ath ieg skullæ føres tijl Soræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 45,
      "text": "och fæm oc halfierdesynne tiwe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 45,
      "text": "tha bleff ieg døt som screffuet staar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 45,
      "text": "thy tørff ther inghen om lywe.",
      "part": false,
      "marginal_notes": []
    }
  ]
}