  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Siælantzfaer, the ædeligæ men,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "them tacker ieg allæ hwer oc en.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "The mentha so aff alt there acth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Thi hwlde the meg ffor en forman",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "och koning at bliffue i theris land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Tha Otthen koning han fick thet spurth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "at the hade meg tijl koning giorth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "och sænctæ meg ther neder tijl grwndh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Theraff fick først thet swnd sit naffn;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "thet siær ieg eder: ther gaar aff saffn.",
      "part": false,
      "marginal_notes": []
    }
  ]
}