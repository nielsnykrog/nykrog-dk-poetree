  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Iegh Gram, myn fader, aff Norge dref",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "och i hans sted ther koning bleff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "ffør ieg slo hannum meth allæ ihiell",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "och fick tha allæ hans rygæ thry",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "meth allæ theres landh oc allæ theres by.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Hadding, myn halfbroder, hannum thet fortøttæ,",
      "part": false,
      "marginal_notes": []
    }
  ]
}