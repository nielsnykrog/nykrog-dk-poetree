  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Gud aff Himmelen see her til/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc lad dig det forbarme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Gantske faa da ere dine tienere til/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "besuigne ere wi arme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Dine ord vil mand ey giffue mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "oc Troen er skøt gantske forlat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "hoss alle Menniskens Sønner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "De lære idel falsk oc suig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Huad deris Vissdom paafinder:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Deris hierte er icke samdrectelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Til Guds ord at forkynde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Den ene vil dette/ den anden vil det/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Bedrage oss met Menniskens sæt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Oc siunis dog hellig vduortis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Gud vil den Scrifft met roden oprycke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Som falsk hellighed oss lærer:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Der til deris Tunge stolt obenbare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Taler stort/ wi ville oss verge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Wi haffue Ret oc mact i haand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Huad wi bescriffue det skal gaa frem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Huem er den der oss vil straffe?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Derfor taler Gud/ Jeg vil opsee/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "De arme leggis fast øde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Deris suck oc sorrig de mig betee/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Jeg vil deris kæremaal høre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Mine salige Ord de skulle nu frem/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Begærlig de anamme dem/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Paa dem de arme sig trøste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Mand prøffuer Sølff met Jlden vel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "Saa vorder det klart befundet:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "Paa Guds ord mand vel vocte skal",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "Disligest i alle stunde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Det vil met Kaarssit beskermis bæst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "Saa lærer oss den hellige Lest/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "Dets krafft lucter i alle Lande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "O milde Gud/ beuare dine ord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "Fra alle falske Lærer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "At alle wi her sammen bo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "Du vilt vor beskermer være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "De Guds forgangne monne du her finde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "Dit folck acte de nu offuer at vinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "O Gud forbiud dem det/ Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "Ære være dig Fader euindelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "Oc Christ din Søn vor Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "Der til vor Trøster den hellig Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 6,
      "text": "Aff hiertet wi det begære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 6,
      "text": "Giff oss din naade/ oc styrck vor tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 6,
      "text": "At wi tilsammen met kierlighed bo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "J it sind effter din villie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 7,
      "text": "DE ventre matris meæ vocauit me Dominus nomine meo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 7,
      "text": "et posuit os meum vt gladium acutum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 7,
      "text": "sub tegumento manus suæ protexit me,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 7,
      "text": "posuit me quasi sagittam electam.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 8,
      "text": "Bonum est confiteri Domino:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 8,
      "text": "Et psallere nomini tuo altissime.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 8,
      "text": "Gloria Patri et Filio et Spiritui sancto:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 8,
      "text": "Sicut erat in principio et nunc et semper,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 8,
      "text": "et in secula seculorum, Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 9,
      "text": "HAleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 9,
      "text": "Jnter natos mulierum non surrexit maior Johanne Baptista.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 9,
      "text": "Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 10,
      "text": "LOffuer Gud i fromme Christne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 10,
      "text": "quæder oc værer glad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 10,
      "text": "Met Konning Dauid Psalmiste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 10,
      "text": "priser Gud i allen stad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 10,
      "text": "at Guds ord monne nu klinge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 10,
      "text": "saa vijt offuer alle Land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 10,
      "text": "der met wi Christum finde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 10,
      "text": "vor eniste Frelsermand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 11,
      "text": "Gud haffuer aff sin naade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 11,
      "text": "Opuect en Christen Mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 11,
      "text": "Guds ord monne hand fremdrage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 11,
      "text": "Der met beuiser hand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 11,
      "text": "At wi som kaldis Christne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 11,
      "text": "Haffue lenge farit vild/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 11,
      "text": "Til alt gaat værit visne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 11,
      "text": "Det vaar vor Lærefædris skyld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 12,
      "text": "Ret vey til Himmerige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 12,
      "text": "Er Guds Ord vden tuil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 12,
      "text": "Som Christus selffuer siger/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 12,
      "text": "Huo hannem følger far ey vild.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 12,
      "text": "Men wi haffue det foractit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 12,
      "text": "Jngen tro satte wi der paa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 12,
      "text": "Thi haffuer oss Gud bortkastit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 12,
      "text": "Oc loed oss i Mørcke gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 13,
      "text": "Alt det som wi monne giøre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 13,
      "text": "Vaar ingen Mand nytteligt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 13,
      "text": "Thi Dieffuelen monne oss føre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 13,
      "text": "Ret mod Guds Ord altid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 13,
      "text": "Met falske Jertegen oc Drømme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 13,
      "text": "Satte hand sin snare for oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 13,
      "text": "At wi skulle Guds ord glemme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 13,
      "text": "Oc saa met hannem forgaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 14,
      "text": "Hand haffuer oc ladit scriffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 14,
      "text": "Mod Guds ord Lærdom ny/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 14,
      "text": "Der met hand monne forgiffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 14,
      "text": "Alle dem som Guds Ord sky/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 14,
      "text": "Oc sette deris haab til andit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 14,
      "text": "End Christi pine oc Død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 14,
      "text": "De ere aff Gud forbandit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 14,
      "text": "Oc komme til Helffuedis glød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 15,
      "text": "Der paa skal Mand dem mercke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 15,
      "text": "Som Dieffuelens Lærdom følge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 15,
      "text": "At de ville altid gierne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 15,
      "text": "Haffue deris egen villie/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 15,
      "text": "Oc følge deris egen sinde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 15,
      "text": "Oc Menniskens Lærdom falsk/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 15,
      "text": "Guds Ord ville de ey nemme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 15,
      "text": "Det er dem beskt oc huast.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 16,
      "text": "De holde mere aff deris vane",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 16,
      "text": "Oc gamle Forfædris dict/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 16,
      "text": "End aff Guds ord det sande",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 16,
      "text": "Oc Gud Faders hellige Scrifft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 16,
      "text": "Som aff euig tid haffuer værit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 16,
      "text": "Dog sige de at det er nyt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 16,
      "text": "Guds ord haffue de forladit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 16,
      "text": "Dieffuelens Lærdom til dem byt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 17,
      "text": "De klæde Stocke oc Stene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 17,
      "text": "Oc holde besynderlige dage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 17,
      "text": "Der met ville de Gud tiene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 17,
      "text": "Oc derfor Himmerig haffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 17,
      "text": "De Fattige lade de fryse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 17,
      "text": "Oc lide hunger oc nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 17,
      "text": "Gud bød wi skulle dem spise/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 17,
      "text": "Hans bud wi intet skøde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 18,
      "text": "Er det icke en stor blindhed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 18,
      "text": "At de ville Gud ey tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 18,
      "text": "Som er den euige Sandhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 18,
      "text": "Oc vil giffue euige ro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 18,
      "text": "Alle dem hans Lærdom følge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 18,
      "text": "Det haffuer Christus fortient",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 18,
      "text": "Alt oppaa Kaarssens gallie/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 18,
      "text": "Der til vaar hand vdsent.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 19,
      "text": "Gud Fader haffuer sin Søn skickit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 19,
      "text": "Til alles vor Salighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 19,
      "text": "Hand haffuer oss sin Scrifft giffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 19,
      "text": "Hun er fuldkommelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 19,
      "text": "Hun kand dig all Sandhed lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 19,
      "text": "Alt det dig er nytteligt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 19,
      "text": "Wi behøffue ey Mestere flere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 19,
      "text": "Christus giffuer Himmerig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 20,
      "text": "Thi lade wi dem nu fare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 20,
      "text": "Som tro paa sin egen krafft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 20,
      "text": "Wi ville hoss Guds ord være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 20,
      "text": "Tro huad Christus haffuer sagt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 20,
      "text": "J hannem all Sandhed findis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 20,
      "text": "All Naade oc all miskund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 20,
      "text": "De skulle met Dieffuelen tuingis",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 20,
      "text": "Som hannem tro ingelund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 21,
      "text": "Seduane kand dem ey hielpe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 21,
      "text": "Naar Dommen holdis skal/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 21,
      "text": "Oc ey deris gamle Forfædre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 21,
      "text": "Christus bliffuer offuer dem alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 21,
      "text": "Hans Ord skulle da fremgange/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 21,
      "text": "Oc alle skulle Himmerig faa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 21,
      "text": "Som hannem haffue gangit til haande",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 21,
      "text": "Oc effter hans Lærdom gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 22,
      "text": "Priss være Gud euindelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 22,
      "text": "Som oss haffuer sine Ord send/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 22,
      "text": "Met dem wi kunde bliffue salig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 22,
      "text": "Oc komme fra Dieffuelens tant/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 22,
      "text": "De lære at tro Gud allene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 22,
      "text": "Altid foruden galle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 22,
      "text": "Oc vor Jeffnchristen at tiene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 22,
      "text": "Det vnde oss Christus alle.",
      "part": false,
      "marginal_notes": []
    }
  ]
}