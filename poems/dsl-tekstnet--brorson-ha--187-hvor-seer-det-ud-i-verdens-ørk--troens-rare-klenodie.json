{
  "id": null,
  "title": "187. Hvor seer det ud i verdens ørk",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
