  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "En Aften-Underholdning var før, naar Een kom frem",
      "part": false,
      "marginal_notes": [
        "Speaker: CICERONEN"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "I sine egne Klæder og sang, Gud veed om hvem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Derpaa blev declameret, saa fulgte lidt Musik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Men nu vil Tiden mere, end følge gammel Skik.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Man fordrer nogen Heelhed, og Noget til at see!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "– Derfor vi brød vor Hjerne, vi søgte en Idee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Og tømred blev en Ramme, saa godt man kunde det,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Og tusind’ skjulte Hensyn har ei gjort Tingen let!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "– Hvert Billede vil leve! – men Rammen staaer kun kort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Jeg veed, naar Teppet falder, man kaster Rammen bort!",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
