    "year_published": 1598,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/DRSXV.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Iag war mig saa trett och mod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "iag gick mig onder en linnd och stod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": ":: Saa maatt minn sorg før-gaange. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Ieg stod mig en liden stonnd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "der kom enn skøn iomfru y same stund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "\"Fagre onger-suenn, hui staannde y saa her?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "hui erre y icke der, som di iomfruer er?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "\"Ieg er enn saa reder, ieg tør icke gillee:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "for eder, skønn iomfru, klager iag min willig.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "\"Fager onger-suenn, ieg eder lerre will,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "y-hørre y skulle gillige iomfrur y løn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "I skulle iomffrur baade kuse och klape,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "saa tager di iomfrur eder till tage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "Siger hun ney, hunn icke will,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "saa byeder eeder saa lystlige till.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "Siger hund nye, hunn icke kannd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "daa kysen och klapenn och tag hennd y fangn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "Iomffrueens nye dett er hinndis ia:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "hunndt siger offtta niye, dett hund gernne will ha.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 8,
      "text": ":: Saa maatt minn sorg før-gonge. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}