  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "NAar Gud fonger løst Sions fengsel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Som en drøm da skal siunis vort trengsel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Da fyldis wi saa met glede oc frøyd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "at man maa sige/ Gud haffuer oss ophøyd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "Gud haffuer och nw beuist sig vel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "Ath wi mue glede oss met skel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Men wilde Gud plat ende vor synd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "som becke tyrckis aff solens brynde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "Da wilde wi gerne grede saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "Paa det wi motte fruct met glede faa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 5,
      "text": "Thi saandant arbeyde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "hør her til/ huo som liffuit haffue vil",
      "part": false,
      "marginal_notes": []
    }
  ]
}