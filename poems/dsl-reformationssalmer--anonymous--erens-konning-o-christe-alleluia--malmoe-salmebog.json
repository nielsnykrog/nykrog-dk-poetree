  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Erens konning o Christe Alleluia",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 1,
      "text": "O Fader vdi hiemmelen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "vid din Søn hør vor bøn/",
      "part": false,
      "marginal_notes": [
        "Mat vi"
      ]
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Han er oss fød oc giffuen vist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "til all vor hielp och trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "ver oss mild o fader Alleluia",
      "part": false,
      "marginal_notes": [
        "Luce xi"
      ]
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Hwilken som wor død oc for oss giffuen Alleluia",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "O Christ Konning i euighed wi bede dig vær oss blid Du som døden haffuer forderffuit/",
      "part": false,
      "marginal_notes": [
        "Psal ii"
      ]
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "och salighed oss forhuerffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "bønhør oss o Herre Alleluia",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "Han er opstanden som han sagde",
      "part": false,
      "marginal_notes": [
        "Mathei xxviii."
      ]
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "Han er upfaren som han sagde Loffuer Herren",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "Helligand vor bøn er til dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 5,
      "text": "O Gud vor trøstermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 5,
      "text": "Samuittighedzens trøst/",
      "part": false,
      "marginal_notes": [
        "Joh. xiiii oc xvi"
      ]
    },
    {
      "id": 15,
      "stanza_id": 5,
      "text": "hiertens løst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "Affslæt alle Christnis brøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "fred oc glæd giff oss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 6,
      "text": "Loffuer Herren",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 7,
      "text": "Bed Gud for oss Alleluia. Loffuer Herren Alleluia Alleluia",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 8,
      "text": "Konningens daater aff euighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 8,
      "text": "Christi brud glæder sig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 8,
      "text": "For den hun haffuer i aanden vndfangen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 8,
      "text": "han er som han sagde opstanden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 9,
      "text": "Han er som han sagde opfaren",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 10,
      "text": "Hun sig paa Gud forlader Alleluia",
      "part": false,
      "marginal_notes": []
    }
  ]
}