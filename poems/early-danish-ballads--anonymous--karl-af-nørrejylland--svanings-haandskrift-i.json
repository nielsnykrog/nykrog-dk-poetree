  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift I",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVI141.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Hin vnge herre Karl aff Nørÿøllandt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hand | kand saa listerlig gille",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "och rider hand sig til Selandt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "der fremer hand alle sin villie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: i biuder osz vnder | tiellen min allerskiønist. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Her karl hand sidder i hÿge Lofft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "hand ligger medt | racke och fiende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "huadt vil i mig suare min skiøne | Iomfru",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "medt æren vil ieg Eder vinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": ":: y b o v t m a | s | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Her Karll hand sÿdder offuer breden buordt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "hand | liger met racker oc finnde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "huad will ÿ meg suare | min skiøne Iomfru",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "medt eren vill ieg Eder vinde. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": ":: y b o v t m a s | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Ieg er meg en Kongenns barin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "och i en greffue saa | Riig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "ÿ er icke saa aff slect eller biørd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "att ÿ kand vere | min lige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": ":: y b o v t m a s. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "I er vist ett kongens barn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "och ieg en ridder saa riig |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "ieg beder eder aller keiriste min",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "ÿ lader mig vere | Eders lige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": ":: i b o v t m a s. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "Her Karl ÿ kand saa listelig gille",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "som ieg haffuer | hørt en mandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "ieg tør dog icke for fader min",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "suare | der som ieg Eder vnndt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": ":: i b o v t m a s. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "Leger ÿ aff Ethers ridderkleder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "kleder eder i Iomfru | lige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "i suer mig paa Ethers Christelig tro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": "i will | mig icke suige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 6,
      "text": ":: i b o v t m a s. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "I maa lade Eders har vduoxe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 7,
      "text": "och Iomfru kleder | skiere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": "saa fare i till min faders gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 7,
      "text": "ieg will | Eder sleuen lere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 7,
      "text": ":: i b o v t m a s | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 8,
      "text": "I haffue tack allerkieriste min",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 8,
      "text": "alt for Eders guode | rad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 8,
      "text": "ieg vil kome Innden hell Aars frest",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 8,
      "text": "dett maa | wel gaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 8,
      "text": ":: i b o v t m a s | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 9,
      "text": "Saa lodt hand sig hor vduoxe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 9,
      "text": "och Iomfru Kleder att | skiere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 9,
      "text": "oc saa foer handt till kongens gardt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 9,
      "text": "som handt | mon en Iomfru were",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 9,
      "text": ":: i b o v t m a s | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 10,
      "text": "Thett var vnge herre Karl,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 10,
      "text": "hand indt aff døren tren |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 10,
      "text": "det war fruer oc Iomfruer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 10,
      "text": "de stande hannom op igien |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 10,
      "text": ":: i b o v t m a s. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 11,
      "text": "Her sider ÿ lÿdell kiersten",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 11,
      "text": "eder følger buode tucht | och ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 11,
      "text": "ieg er Eder sendt aff fremmede landt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 11,
      "text": "vil i mig sleuennd ler",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 11,
      "text": ":: i b o v t m a s | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 12,
      "text": "Alle denn sleuenndt der ieg kandt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 12,
      "text": "den lerer ieg Eder mett | ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 12,
      "text": "ieg spør min fader adt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 12,
      "text": "om wi maa samell vere |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 12,
      "text": ":: i b o v t m a s | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 13,
      "text": "I stander op 2 aff mine Iomfruer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 13,
      "text": "ÿ snacker medt | hinder bode",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 13,
      "text": "ÿmeden ieg ganger i hiffuen lofft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 13,
      "text": "och | spøre min fader til raade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 13,
      "text": ":: i b o v t m a s | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 14,
      "text": "Her sidder i Danner Kongen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 14,
      "text": "aller kieriste fader min |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 14,
      "text": "er kommen en Iomfru aff fremmede landt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 14,
      "text": "hun | gierne sleuenndt leer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 14,
      "text": ":: i b o v t m a s | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 15,
      "text": "Mig er sendt en Iomfru",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 15,
      "text": "saa lang fraa fremmed | landt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 15,
      "text": "saa gierne da vil hun sleuenndt ler |",
      "part": false,
      "marginal_notes": []
    }
  ]
}