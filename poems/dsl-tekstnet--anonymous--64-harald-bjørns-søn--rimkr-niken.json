  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Then tijdh ieg konning i Danmark war",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "tha wor meg skriffuer ickæ nær",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "ihwor ieg for i herre færdh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Thy staar ieg nw som ieg woræ glæmth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "forwthen thet mith naffn ær kænth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "som scriffue the gerning som vndder thidhen ske.",
      "part": false,
      "marginal_notes": []
    }
  ]
