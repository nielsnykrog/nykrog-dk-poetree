    "url": "https://tekstnet.dk/books/andersen-hc_velkomstsang-til-j-p-hartmann-fra-hans-venner/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Hvad herligt ude Du har seet og hørt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Hvad Dig har glædet og dit Hjerte rørt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Du os fortælle vil i Melodier:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Det travle Byliv, Kjern’ og Politur,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Den evig unge, kraftige Natur",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Med Dissonantser og med Harmonier.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "I Preussens Sand Du Diamanter fandt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Du fløi mod Syd, og meer Dig Kunsten vandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Skjøndt Donaunixen sært med Hjemvee rørte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Hvor Stephans-Taarnet speiler sig saa smukt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Du husked’ Øresund og Kjøgebugt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Og Tanken Dig til Dine Kjære førte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Natur og Kunst Din Ungdoms Sjæl henrev,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Mens sød, vemodig Længsel hos Dig blev,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Lad denne Treklang kun fra Strængen klinge!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Syd-Schweits’s Storhed og Melankoli,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Pariserlivets lette Trylleri,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "I Tone-Afrids Du til Danmark bringe!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Dig favner nu din Hustru blid og øm;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Din Reise synes Dig en broget Drøm;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "Dog Drøm det var den ei og vil ei blive.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Begeistring drak Du for Dit hele Liv!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "Dig styrke Kjærlighed hos Slægt og Viv!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Velkommen! vi Dig ærligt Haanden give!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
