    {
      "id": 0,
      "stanza_id": 0,
      "text": "Nyligt for vort Øre",
      "part": false,
      "marginal_notes": [
        "Speaker: CHOR AF BØNDERFOLK"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Over Søen klang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Unge Karles Sang;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Det var smukt at høre!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Her vi sidde ville",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "I det friske Hø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Ved den blanke Søe;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Aftnen er saa stille.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Jeg troer der er skjønnest i Danmark!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "– Skjønnest i Danmark!",
      "part": false,
      "marginal_notes": []
    },
    {
