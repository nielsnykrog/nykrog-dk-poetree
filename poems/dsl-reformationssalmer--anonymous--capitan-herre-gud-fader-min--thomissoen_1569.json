  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "CApitan Herre Gud Fader min/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "vdsend mig naaden din/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "den stund ieg her i liffue er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Stor vildelse nu i Verden er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "miskunde oss Herre kier/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "at mig regere dine Ord oc lære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "kundgiør mig Herre den rette grund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "den stund her er den største nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "dit hellige Ord forholt mig ey/ ret vey",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "til liffuit gennem døden vd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "est du allene min Herre oc Gud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "SIg skynder fast den forsagde tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "O Herre giør oss frj",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Fra alt ont baade til liff oc Siel.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "J all vor nød wi til dig fly/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Din Naade begære wi/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Frelss oss O Herre fra Verdsens qual.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Oc vær oss alle miskundelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Forlig oss Herre formedelst din Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "At wi kunde ret bliffue Christne vden meen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Det er min begære oc bøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "Hielp at wi alle din villie giøre kunde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "MERe giøris behoff at bede dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "O Herre/ forlad ey mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Du som skabt haffuer alleting.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Lad mig faa aff din Vissdom hid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Oc gack ey bort fra mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Met din Naade mit hierte vent omkring.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Oc skab i mig en retter Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "Du kant vel vide huad mig giør møde oc vonde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "Thi alt mit haab haffuer ieg til dig/ kom mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "Til trøst/ Herre Jesu Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "Thi du allene vor Frelser est.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "MARck/ Stæder/ oc alle mine vndersaatte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "Haffuer ieg aff dig faat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "Beskerme dem alle for falske lære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "Herre Gud her er nu kommen fram",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "En onder seduan/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "Foruar oss alle i din ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "Tag dine hellige Ord oc vebne oss met/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 3,
      "text": "Paa det at Dieffuelen oss ey besuige kand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 3,
      "text": "Met verdzslig praal oc menniskens tant/ optend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 3,
      "text": "Oss alle til saadan begære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 3,
      "text": "At vor tro kunde ret til dig ene være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "GREFVEr/ Herrer/ Ridder oc Knecte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 4,
      "text": "Oc alle Slecte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 4,
      "text": "Befaler ieg dig min Herre oc Gud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 4,
      "text": "Forøg vor tro/ oc giør hende ret/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 4,
      "text": "Den Verden haffuer forgæt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 4,
      "text": "Jeg beder dig for din haarde død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 4,
      "text": "Forlad oss ey i saadan nød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 4,
      "text": "Langt før haffuer du det selff forkyndet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 4,
      "text": "At falske Propheter skulle komme/ siunis fromme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 4,
      "text": "Som Faar/ men induortis Vlffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 4,
      "text": "Som Scrifften vduiser/ oc wi haffue befundit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 5,
      "text": "TIL din store Barmhiertighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 5,
      "text": "(Huilcken allene dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 5,
      "text": "Opdrog paa Kaarssit for vore Synder slet)",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 5,
      "text": "Jeg flyer/ til dig O Herre i dit skød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 5,
      "text": "Mig aldrig offuergiff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 5,
      "text": "Jeg maner dig for din Guddoms foriet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 5,
      "text": "Den du haffuer loffuit for langen tid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 5,
      "text": "Til dig rober nu saa mangen bedrøffuit aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 5,
      "text": "Oplad dine øern oc hør vor røst/ oc trøste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 5,
      "text": "Oss met din godhed alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 5,
      "text": "Beskerme oss at wi icke i falsk tro falde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 6,
      "text": "BRENde mercke haffue de i deris samuittighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 6,
      "text": "Som oss haffue wret ledit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 6,
      "text": "For dem Sancte Pouel beder oss at tage vare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 6,
      "text": "De haffue foruent den hellige Scrifft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 6,
      "text": "Met deris falske dict:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 6,
      "text": "O Herre frelss oss for din pine suar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 6,
      "text": "See her til oss dine fattige Faar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 6,
      "text": "Du haffuer betalit for all vor Synd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 6,
      "text": "Christus haffuer oss met dig forligt/ det beuiss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 6,
      "text": "Sancte Pouel met scrifft oc mund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 6,
      "text": "Foruar oss i din Naade alle stund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 7,
      "text": "DEN rette tro wi bede aff dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 7,
      "text": "Hør oss nu Herre kier",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 7,
      "text": "Før end Døden oss omkuld støder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 7,
      "text": "Til din miskund vort haab haffue wi",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 7,
      "text": "Aff hiertens begær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 7,
      "text": "O Herre wi ere saa ynckelig forførde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 7,
      "text": "Fra din Naade til vore egne gierninger/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 7,
      "text": "Thi styrck oss/ at wi kunde allene til dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 7,
      "text": "Haffue all vor tro/ oc haabit vort/ dine ord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 7,
      "text": "Ere sandhed visselig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 7,
      "text": "Giff oss at wi maa leffue euindelig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 8,
      "text": "BORGer Ræt giff oss i dit Rige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 8,
      "text": "Oc giør oss lige:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 8,
      "text": "Oc stat met oss alt ind til enden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 8,
      "text": "At Diefflene oss ey besuige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 8,
      "text": "O Herre ey fra oss vige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 8,
      "text": "Din naadelige øyen ey bort fra oss vende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 8,
      "text": "At naar wi komme i vor yderste nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 8,
      "text": "At Døden met grumhed vil oss tage fat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 8,
      "text": "Saa redde du/ oc vær vor skiold/ Herre bold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 8,
      "text": "Wi bede dig alle met graad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 8,
      "text": "Jeg beder for alle mine Vndersaatte.",
      "part": false,
      "marginal_notes": []
    }
  ]
}