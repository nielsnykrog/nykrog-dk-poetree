{
  "id": null,
  "title": "Liden Kirstin og Dronning Sofie",
  "year_created": [
    1555,
    1559
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Jens Billes Håndskrift",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1559,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/BILL80.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Liidenn Kiistiin hun tenner uti kongens gar:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": ":: Som iegh haffuer eiider sagdtt. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "hun sliider rød skar-lagenn, hun draffuer mar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Hun er sa sarre udlagtt bade fra venner och frender. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Hun sliider rødtt skarlagenn, hun drager søll:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "och riider och suene de untte hende vell.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Riider och suenne de unntte hende vell:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "och saa gorde danner-konyngh selff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "Och kongenn hann taller till sma-drengenn siin:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "\"Du bed liidenn Kiistiin ynn for megh ga!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "Inn kom liidenn Kiistenn, och stedes hun for bord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "\"Huad viille y mygh, herre, huii sende y mygh bud?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "\"Herre Gud giiffue, att mynn drøniingh vor død!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 5,
      "text": "da skulde y verre myn feste-mø.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "\"I thiier, mynn herre, y siiger ike saa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "her star miin drøniingh, hun liiuder der-pa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "Och drøngenen taller tell ternenn siin:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 7,
      "text": "\"Du bed liidenn Kiistenn yn for megh gaa!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "\"Och hørdu, liidenn Kiistenn, huad iegh siiger diigh:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 8,
      "text": "huad vorder, mynn herre hann snakytt met degh?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "Och drøniingenn hun taller tell rad-giiffuer siin:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 9,
      "text": "\"Huad viille vy aff liidenn Kiistenn gørre?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "Helder uelle vy hende y balliidtt brende?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 10,
      "text": "eller vii viillee hende tell denn hennyske konyngh sende?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "\"Icke welle vii hende y balliid brende:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 11,
      "text": "wy velle hende tell denn heneske koniingh sende.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "Om fred-dagenn lade de arer paa bor:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 12,
      "text": "om mad-dagenn kame de tell denn heiiniske koniinghs land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "Mytt udy denn gar der axseller de deres skiin:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 13,
      "text": "dy giinge y høffuett-lofftt for denn heniiske koniingh ynn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "\"Hell siide y, henne-koniingh, offuer eders brede bord!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 14,
      "text": "konyngenn aff Dane-mark haffuer sendt eiider or.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "Hann haffuer send eiider ord och siin talle:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 15,
      "text": "om y velle liidenn Kiistiin tiill eders drøniingh haffue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "\"Och før iegh vell denn henske konyngh haffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 16,
      "text": "da vell iegh før were y iordenn nedt graffuenn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "\"Och før iegh viill denn ionffru myste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 17,
      "text": "daa vell iegh før lade miigh bade døbbe och kriistenn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 18,
      "text": "Om ons-dagenn lod hand siigh bade døbbe och kriistenn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 18,
      "text": ":: Som iegh haffuer eder sagtt. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 18,
      "text": "om sønd-dagenn gorde han deres brulup tiill-sammen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 18,
      "text": ":: Hun er sare langtt alltt bade frann venner och frender. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}