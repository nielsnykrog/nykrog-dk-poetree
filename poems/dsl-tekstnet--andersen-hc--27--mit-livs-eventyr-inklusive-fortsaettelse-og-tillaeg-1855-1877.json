  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "»Her Grækenlands Vaaben og Danmarks Flag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Dig hilse og føle Dit Hjerteslag.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Hvis Billeder og Lamper kunde tale",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "De vilde sige: kom til Fest, min Ven.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Men Taushed boede i de rige Sale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Man hørte ikkun Guldet rulle hen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Og unge Qvinder sad med Feber-Gløden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Og kastet Guld og greb den vundne Skat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Men ude lød et Skud, der griinte Døden:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "»Jeg vandt et Liv i denne Spillenat.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "I Glands og Stilhed stod’ de tause Sale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Der Guld og Pulseslag kun føre Tale.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Saa er Svanen da nu svævet hid til det Sted,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Hvor i Barndommens Rede den laae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Mens de Andre med Medynk og Spot skued’ ned",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Paa den Stakkel med Dunene graae;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "Hvor den drømte saa ene bag Buskenes Skjul,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "Fordi Ingen til den vilde see;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Kun en Vantrivning var dem den fremmede Fugl,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Fordi den var ikke som de.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "De forstod ei dens Færd, og de anede ei,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "At i Drømmen var Sandhed og Magt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "At den snart over Sky skulde søge sin Vei",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "I den lysende Sangsvanedragt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "At dens Flugt skulde stævne saa viden om Land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "Og end videre flyve dens Ry,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "At dens Navn skulde trindtom ved fremmede Strand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "Sprede Glands om dens Fædreneby;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "At dens Sang skulde trænge til Hjerternes Grund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": "Lige mægtigt hos Store og Smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "Just fordi den saa godt kunde mindes den Stund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "Da den selv kun var lille og graa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "Tag vor Tak da, Du Sanger med tryllende Røst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 7,
      "text": "For Besøget i Barndommens Hjem!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 7,
      "text": "Det er stolt af sin Søn, og fra jublende Bryst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "Trænger Takken i Toner sig frem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "Hist, hvor Gaden slaaer en Bugt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 8,
      "text": "Ligger Huset indelukt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 8,
      "text": "Der, har Skolemester sagt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 8,
      "text": "Storken Andersen har bragt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 8,
      "text": "Ole kom med lette Hop",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 8,
      "text": "Og slog Parapluien op;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 8,
      "text": "Mens han sov med Drømme smukke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 8,
      "text": "Nissen gynged’ glad hans Vugge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 9,
      "text": "Her han gik ved Byens Aa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 9,
      "text": "Havfru, Aamand der han saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 9,
      "text": "Og ved Aaens grønne Bred",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 9,
      "text": "Hyldemo’er han talte med;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 9,
      "text": "Naar det føg ved Juletid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 9,
      "text": "Saae han Sneens Dronning hvid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 9,
      "text": "Og, hvad selv han deiligt tænkte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 9,
      "text": "Han os Allesammen skjænkte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 10,
      "text": "Tak for hver en Time glad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 10,
      "text": "Naar vi rundt om Bordet sad!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 10,
      "text": "Lampen brænder, Moder syer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 10,
      "text": "Fa’er han læser Eventyr;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 10,
      "text": "Prindser og Prindsesser smaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 10,
      "text": "See vi om paa Tæppet gaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 10,
      "text": "Alfer dandse, Trolde buldre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 10,
      "text": "Tinsoldater staae og skuldre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 11,
      "text": "Feegaloscherne Du fik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 11,
      "text": "Op paa Kongens Slot Du gik;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 11,
      "text": "Først og sidst Dit Navn dog staaer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 11,
      "text": "Der, hvor Tuk og Ida gaaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 11,
      "text": "Legestuens Digter tag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 11,
      "text": "Mod de Yngstes Tak idag;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 11,
      "text": "Større Haand vi ei kan række,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 11,
      "text": "Men saa kan Du faae dem begge!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 12,
      "text": "Ud vi skal, det veed vi godt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 12,
      "text": "Fra vort gyldne Barneslot;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 12,
      "text": "Eventyrets Blomst dog groer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 12,
      "text": "Om man bliver nok saa stor. –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 12,
      "text": "Nu Musik, spil rigtigt til!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 12,
      "text": "Høit vi Hurra raabe vil!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 12,
      "text": "Spurven vaagne skal og kviddre;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 12,
      "text": "Og saa vil vi dandse vid’re.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 13,
      "text": "af Johan Krohn.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
