    {
      "id": 0,
      "stanza_id": 0,
      "text": "Kom O Herre hellig Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "opfyld din Christnes hierte met ret forstand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Oc din brendendis kierlighed i dennem optend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "du som atskillige tungemaal sender/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "oc der ved Hedninger til Troens endrectighed omuender.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Haleluia/ Loffuer Herren.",
      "part": false,
      "marginal_notes": []
    }
  ]
