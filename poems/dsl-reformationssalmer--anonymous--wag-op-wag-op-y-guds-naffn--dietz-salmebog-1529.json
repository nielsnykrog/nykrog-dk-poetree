    "title": "Een ny handbog med Psalmer oc aandelige lofsange",
    "year_published": 1529,
    "publisher": "Ludwig Dietz",
    "printer": "Ludwig Dietz",
    "place": "Rostock",
    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/dietz-salmebog-1529/8/16"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "WAg op wag op ÿ Guds naffn",
      "part": false,
      "marginal_notes": [
        "Esaie. lx. Osee. ij. ij. Corin. vj"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "tw werdige Christenhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "oc tacke thÿn kiæriste brudgam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "for thenne naadelig tÿd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "ÿ hwilken han teg sitt ord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "haffuer nw vdsend igien/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Ther med han wil oss frelse/",
      "part": false,
      "marginal_notes": [
        "Psalm. cvj"
      ]
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "saa mange som thet rett elske",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "thet klinger ÿ alle land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Men dieffuelen werdzens første/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "som løgnens fader er/",
      "part": false,
      "marginal_notes": [
        "Johan. xiiij."
      ]
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "han wilde thet gierne omstørte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "med swig han forbiwder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "att ingen skulde/ Guds ord sige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "wid band/ oc gods oc liff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "han lader mange fordriffue /",
      "part": false,
      "marginal_notes": [
        "Acto. iiij."
      ]
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "forbrende oc affliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "thet hielper hannwm dog inthet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Han skær fast med sÿne tender/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Satan oc hans parthÿ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "med trw wil han forfære/",
      "part": false,
      "marginal_notes": [
        "Acto. vij."
      ]
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "tw werdige Christenhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Dog bliff tw fast wid Guds ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "thÿ han sørger for teg/",
      "part": false,
      "marginal_notes": [
        "Math. vj."
      ]
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "han siger hwo teg nogen wret giør/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "hans øgesteen han ther med rører/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "han er thÿn hielp wisselig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "See Hworledis Gud hialp Jøderne/",
      "part": false,
      "marginal_notes": [
        "Exod. xiiij. Jos. vj."
      ]
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "vdaff Egypti land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "oc ÿ røde haff fordrencte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "then Konning Pharao/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Hierico thet motte oc falle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "for Guds folk strax paa staen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "aff the thrommeters skalle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "alt saa hielper Gud thennom alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "som setter theris tro till ham.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "Oc the Madianiter",
      "part": false,
      "marginal_notes": [
        "Jud. vj. vij"
      ]
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "giorde Guds folk plads oc møde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "oc the Amalechiter/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "Guds folk ropte tha til Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "han them naadelig reddede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "formiddels Gedeon/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "then tÿd Guds folk trommetede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "een hedning then anden myrde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "tiwe hundrid tusind mend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "Thenck hwor thÿt Gudt beskermede/",
      "part": false,
      "marginal_notes": [
        "j. Reg. xviij oc. xix."
      ]
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "fraa Sauls hand Konning Dauid:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "then han hadde myrd saa gierne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 5,
      "text": "Gud bewarid hannwm oc med flÿd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 5,
      "text": "for hans eghen søn then skøne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 5,
      "text": "som kallis Absolon/",
      "part": false,
      "marginal_notes": [
        "ij. Reg. xvj."
      ]
    },
    {
      "id": 51,
      "stanza_id": 5,
      "text": "han wilde hans lÿff bort nømme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 5,
      "text": "Dauid motte rÿgit rømme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 5,
      "text": "men dog ther ind igien kom.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "Merck hworledes Gud hialp strÿde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "alt mod Hieroboam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 6,
      "text": "ÿ Konning Abia tÿde",
      "part": false,
      "marginal_notes": [
        "ij. Par. xiij. iij. Reg. xv."
      ]
    },
    {
      "id": 57,
      "stanza_id": 6,
      "text": "then han omkring satt hadde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 6,
      "text": "att han kunde icke vndkomme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 6,
      "text": "tha ropte folkit til Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 6,
      "text": "tha flyde the fiende med skamme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 6,
      "text": "oc Guds folk slo aff thennom",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 6,
      "text": "fem hundrit tusend død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "Desligist hialp Gud att kempe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 7,
      "text": "Assa then Konning bold/",
      "part": false,
      "marginal_notes": [
        "ij. Par. xiij."
      ]
    },
    {
      "id": 65,
      "stanza_id": 7,
      "text": "tha Serach wilde forderffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 7,
      "text": "Guds folk med macht oc wold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 7,
      "text": "the monne tha Gud paakalle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 7,
      "text": "aff gantske hiertens grund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 7,
      "text": "thÿ motte the blaamend falde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 7,
      "text": "tusind gange tusind talde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 7,
      "text": "for Guds folk samme stund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 8,
      "text": "See hworledes Gud reddede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 8,
      "text": "then Konning Ezechiam:",
      "part": false,
      "marginal_notes": [
        "iiij. Re. xix. ij. Pa. xxxij"
      ]
    },
    {
      "id": 74,
      "stanza_id": 8,
      "text": "then storlig truwid hadde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 8,
      "text": "Sennacherib wid naffn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 8,
      "text": "then sÿn her hadde stellid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 8,
      "text": "alt mod Hierusalem/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 8,
      "text": "aff them Guds Engel felde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 8,
      "text": "firsinds tiwe tusind oc flere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 8,
      "text": "oc saa giorde han them tham.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 9,
      "text": "Hør oc hwor Gud lod krige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 9,
      "text": "for Konning Josaphat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 9,
      "text": "then tÿd hanwm wilde fordriffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 9,
      "text": "Amon oc Moab med macht:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 9,
      "text": "Guds folk hadde sorg oc klage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 9,
      "text": "til Gud hadde thet sÿn trøst/",
      "part": false,
      "marginal_notes": [
        "ij. Pa. xx."
      ]
    },
    {
      "id": 87,
      "stanza_id": 9,
      "text": "the hedning lod Gud plage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 9,
      "text": "the toge hind anden aff dage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 9,
      "text": "oc Guds folk word forløøst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 10,
      "text": "O Christenhed merck lÿge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 10,
      "text": "hwor Gud sÿne fiende slaar/",
      "part": false,
      "marginal_notes": [
        "Esaie. l. Esaie xxxj. Math. x."
      ]
    },
    {
      "id": 92,
      "stanza_id": 10,
      "text": "the mod hans folk monne stride/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 10,
      "text": "hans macht er nw lÿge stor/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 10,
      "text": "Han kan teg wel beskerme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 10,
      "text": "thÿne haar ere alle tald/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 10,
      "text": "lad tw men dieffuelen swerme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 10,
      "text": "bliff tw wid Guds ord gierne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 10,
      "text": "altÿd saa æstw vdwald.",
      "part": false,
      "marginal_notes": []
    }
  ]
}