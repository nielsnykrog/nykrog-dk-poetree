  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Verdens velde met sit belde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "haffuer ieg forsmaat met alle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "For den Kierlighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "i huilcken ieg maa met min Herre Christ indfalle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Huilcken det første ieg fick at see/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "fick ieg hannem kier met alle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Betrode hannem vel i glæde oc vee/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "ieg elste hannem vden all galle.",
      "part": false,
      "marginal_notes": []
    }
  ]
}