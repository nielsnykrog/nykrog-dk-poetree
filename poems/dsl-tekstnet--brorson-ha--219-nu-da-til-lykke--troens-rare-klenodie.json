  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Nu da til lykke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Mandhaftig christen-siel!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Lad dig ey trykke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Her er Immanuel!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Gak fri i sinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Din JEsus med dig gaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Fat mod at vinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Det alt paa troen staaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Lad satan finde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Hvad Christi kraft formaaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Hvad hand har vundet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "I Adams svare fald,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Det er forsvundet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Ved JEsu naades kald,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Det maa hand vide:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "De folk, det støv og jord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Som her i tide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Omvender sig og troer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Slaaer ham til side,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Var hand end nok saa stor.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Vel er hand listig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "At føre ud sit verk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Forvoven, dristig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Forfærdelig og sterk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Hvo ey vil fegte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Og gaae ham stærk imod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Sig selv fornegte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Og staae, som træ ved roed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Den maa forsmægte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "Og daane for hans fod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Men de, som hede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Og ere christne, de,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "Som allerede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "GUd her i troen see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "Den flok har andet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "I deres hu og agt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "End saa forbandet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "At svige naadens pagt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "Den gaaer bemandet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "Mod alle sortes magt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "Est du vansmægtig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "At hiertet i dig slaaer?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "See! hand er mægtig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "Som for i spidsen gaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "Følg ham kun efter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 4,
      "text": "Saa har det ingen nød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 4,
      "text": "Naar sielen hefter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 4,
      "text": "Saa faaer hun kræfter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 4,
      "text": "Mod alle satans stød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 5,
      "text": "Op! op! og spender",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 5,
      "text": "GUds sandheds belte fast",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 5,
      "text": "Om eders lender",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 5,
      "text": "Mod fiendens haarde kast,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 5,
      "text": "Sank dine sandser",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 5,
      "text": "I JEsu blodig sveed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 5,
      "text": "Tag til dit pandser",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 5,
      "text": "GUds søns retfærdighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 5,
      "text": "Og satans skandser",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 5,
      "text": "Skal revne for dig ned.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 6,
      "text": "Din storme-hue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 6,
      "text": "Skal være skriftens trøst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 6,
      "text": "Dit sverd og bue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 6,
      "text": "Er bønnens stærke røst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 6,
      "text": "I det du beder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 6,
      "text": "Og ikke bliver træt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 6,
      "text": "Hvad JEsus heder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 6,
      "text": "For alting uforgiet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 6,
      "text": "Og om du sveder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 6,
      "text": "Da er det krigens ret.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 7,
      "text": "Op, kun at tage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 7,
      "text": "GUds fulde harnisk paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 7,
      "text": "Gaa kun du svage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 7,
      "text": "GUds Søn vil med os gaae;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 7,
      "text": "Lær kun at føre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 7,
      "text": "Det stærke troens skiold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 7,
      "text": "Det er at giøre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 7,
      "text": "Sin JEsum til sin vold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 7,
      "text": "Hvem vil dig røre?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 7,
      "text": "Du est i god behold.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 8,
      "text": "GUd, lad os prøve",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 8,
      "text": "Og giøre alvor af,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 8,
      "text": "Den striid at øve",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 8,
      "text": "Frimodig til vor grav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 8,
      "text": "Den lunkne vane",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 8,
      "text": "Kand ikke taale stød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 8,
      "text": "GUds kæmpers bane",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 8,
      "text": "For os med blodet flød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 8,
      "text": "Op, blodig fane!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 8,
      "text": "Og viis os JEsu død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 9,
      "text": "Her skal du være",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 9,
      "text": "I daglig kamp og striid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 9,
      "text": "Der skal du bære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 9,
      "text": "Din krands til evig tiid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 9,
      "text": "Den sag er vigtig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 9,
      "text": "Og skal det have klem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 9,
      "text": "Faaer man forsigtig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 9,
      "text": "Og mandig at gaae frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 9,
      "text": "Saa gaaer man rigtig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 9,
      "text": "Til GUd i himlen hiem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 10,
      "text": "Nu da til lykke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 10,
      "text": "Mandhaftig christen-siel!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 10,
      "text": "Lad dig ey trykke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 10,
      "text": "Her er Immanuel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 10,
      "text": "Gak fri i sinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 10,
      "text": "Din JEsus med dig gaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 10,
      "text": "Fat mod at vinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 10,
      "text": "Det alt paa troen staaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 10,
      "text": "Lad satan finde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 10,
      "text": "Hvad Christi kraft formaaer.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
