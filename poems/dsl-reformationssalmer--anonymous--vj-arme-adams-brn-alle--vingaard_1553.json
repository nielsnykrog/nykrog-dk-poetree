  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "VJ arme Adams Børn alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "wi ere saa dybt i Synden faldne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Thi ville wi alle Gud paa kalle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Nu bede wi ⁕",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Nu bede wi den Helligaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "alt om den Christelige tro oc ræt forstaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Der oss Gud beuare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "oc sin naade sende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Naar wi heden fare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "aff dette elende Kyrieleys",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "VOr natur er baade mørck oc blind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "met all forstand skel/ Siæl oc sind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "thi ville wi alle til Gud falde ind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "⁕ Du verdige liuss giff oss dit skin/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Lær oss ath kende Christum Jesum all ene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "At wi met hannem bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "vor kære Frelsermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "Som oss monne indlede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "til det foriette land/ Kyrieleyss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "VJ hade alt det oss er emod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "Een vil ey vere den anden god/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "Thi giff du oss ith bedre mod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "⁕ Du søde Aand skenck oss foruist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "At wi maa dricke aff dit kerlighedsens bryst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "At wi vdaff hiertet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "huer anden elske/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "Met ith sind i Christo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "haffue baade fred oc ro Kyrieleys",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "HVer er gantske forfengelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": "Ey wden Kød oc Blod/ met falsk oc suig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "Thi ville wi nu alle bede dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "⁕ Du ypperste trøstere i all vor nød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "Hielp at wi forsmaa Verdens spaat och wselhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 7,
      "text": "At wi bestandige bliffe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 7,
      "text": "paa vor siste ende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "Naar wi met Dieffuelen kiffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 7,
      "text": "Om dette elende Kyrieleys",
      "part": false,
      "marginal_notes": []
    }
  ]
}