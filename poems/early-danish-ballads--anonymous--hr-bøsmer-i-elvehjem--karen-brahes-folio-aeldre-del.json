{
  "id": null,
  "title": "Hr. Bøsmer i Elvehjem",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA177.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Her Bunde hand buor seg vde wed aaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "saa wen daa haffde hand døtter thuo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Dotter thuo och sønner V.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Men lindenn hun løffues. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Dotter thuo och søner V,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "her Bøsomer war den wenest aff dem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Den elle-kuone buode seg vdde wed aaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Vdde wed aaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "weell femthtenn winhter lagde hun det y thra.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Femthtenn winthter och ynd ett aar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "Och ind ett aar:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "alt huor hun skulde er Bøsmer faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Syldig om afftten, der dag dreff paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "Der daag dreff paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "den ellkuone thog offuer seg kaabe blaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "till her Bøsmers løfft saa mone hun gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "Kaabbe blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "till her Bøsmers lofft saa mone hun gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "Hun klaper paa loffttis-dør med synn skieennd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 6,
      "text": "Meed sinn skieend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "\"Staar op, her Bøsmer, och lader meg innd.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 6,
      "text": "\"Ingen dem haffuer ieg støffne saatt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 7,
      "text": "Støffuene saatt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "och ingenn komer y mitt lofftt om naatt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 7,
      "text": "Saa smaa daa haade hun finger med lieste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 8,
      "text": "Finnger med lieste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 8,
      "text": "fuld well hun dy naffler west.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 8,
      "text": "Fuorlig haffde hun finger och smaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 9,
      "text": "Finger och smaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 9,
      "text": "och seeleff thuog hun dy laase fraa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 9,
      "text": "Hun saatte seg paa hans sennge-stock.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 10,
      "text": "Hans seenge-stock,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 10,
      "text": "hun lieger fast med hans gulle lock.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 10,
      "text": "Hun saatte seg paa hans seenge-fieell.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 11,
      "text": "Hans seenge-fieell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 11,
      "text": "saa lieestelig hun till hanom thaalde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 11,
      "text": "\"Du giør thett, her Bøsmer, for dynn thro.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 12,
      "text": "For dynn thro:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 12,
      "text": "mød meg y morgenn paa stieene-bro.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 12,
      "text": "Her Bøsmer hand wagner om midinatt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 13,
      "text": "Om mydi-natt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 13,
      "text": "vd-aff synn drøme sigger hand saa bratt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 13,
      "text": "\"Meg tøckt, enn iumfru for meg stuod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 14,
      "text": "For meg stuod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 14,
      "text": "hun war saa weenn som wox waar snod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 14,
      "text": "Meg tøgtte, enn iumfru for meg waar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 15,
      "text": "For meg waarr,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 15,
      "text": "y silcke-serck, med vdslagen haard.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 15,
      "text": "Ieg haffuer hindder loffuet alt paa min thro.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 16,
      "text": "Paa mynn thro:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 16,
      "text": "ieg skaall hynd mødde paa stiene-broo.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 16,
      "text": "\"Dw lieg, her Bøsmer, giff den drøm icke igieem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 17,
      "text": "Giff den drøm icke igiem:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 17,
      "text": "thett er en elkune, wilder deg y søffuene.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 17,
      "text": "\"Min drøm den gaar, som here Gud well.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 18,
      "text": "Som herre Gud maa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 18,
      "text": "saa weslig skaall ieg holde mynn thro.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 18,
      "text": "Aarlig om morgenn, suollenn skieenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 19,
      "text": "Suollenn skieenn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 19,
      "text": "her Bøsmer kledde seg for synn seenng.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 19,
      "text": "Hand drog y synn skiortte smaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 20,
      "text": "Synn skiortte smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 20,
      "text": "och offuer y fløffuelss thrøøe blaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 20,
      "text": "Buock-skieends støffuelle drog hand offuer fuod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 21,
      "text": "Drog hand offuer fuod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 21,
      "text": "forgyldenne spuore spender hand imuod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 21,
      "text": "Her Bøsmer thaller til suene thuo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 22,
      "text": "Suene thuo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 22,
      "text": "\"Y saaddeller meg min ganger graa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 22,
      "text": "Y saadler meg mynn gannger huid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 23,
      "text": "Mynn ganger huid:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 23,
      "text": "till stieenne-bro saa weell ieg ridde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 23,
      "text": "Her Bøsmer hand bindder synn suerd weed side.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 24,
      "text": "Synn suerdt wed sidde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 24,
      "text": "hans muoder hun mone syn hinder wridde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 24,
      "text": "Her Bøsmer vd aff gaardden rie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 25,
      "text": "Aff gaarddenn riee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 25,
      "text": "hans muodder hun gred, och hiender hun wred.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 25,
      "text": "Och der hand kaam paa stiene-bro.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 26,
      "text": "Paa stieenne-bro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 26,
      "text": "der snaffued hans gaanger y røde guld-skuo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 26,
      "text": "Och gangerenn snaffuett y røde guld-som.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 27,
      "text": "Rødde guld-søm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 27,
      "text": "her Bøsmer vd for striden strøm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 27,
      "text": "Och saa saam hand till eluer-hieem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 28,
      "text": "Till elluer-hiem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 28,
      "text": "denn elluer-møø gaar hanom igenn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 28,
      "text": "\"Well-komen, her Bøsmer, hiem till minn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 29,
      "text": "Hiem till mynn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 29,
      "text": "och ieg haffuer blenditt buod møød och wynn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 29,
      "text": "\"Beholt du selleff buod miød och wynn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 30,
      "text": "Dyn miød och wynn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 30,
      "text": "saa vseell kaam ieg hiem till dynn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 30,
      "text": "\"Sigger meg, her Bøsmer, paa edders maall.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 31,
      "text": "Paa edders maall:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 31,
      "text": "huor er y fød, huor er y baarnn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 31,
      "text": "\"Y Danmarck er ieg fød och borenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 32,
      "text": "Fød och borenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 32,
      "text": "och der er alle myn hoff-kledder skaarne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 32,
      "text": "Der er ochsaa mynn feestemøø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 33,
      "text": "Mynn feestemøø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 33,
      "text": "med hinder well ieg buode løffue och dø.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 33,
      "text": "Denn ellemøø thaaller till thieniste-møø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 34,
      "text": "Till thieneste-quinde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 34,
      "text": "\"Du hintte meg ind ett horren med wynn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 34,
      "text": "Du hyntt meg ind ett dyrris-hornn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 35,
      "text": "Ett dyris-hornn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 35,
      "text": "och kaast der-y thuo elluer-kornn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 35,
      "text": "Denn thieeneste-møø ind aff døren thrend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 36,
      "text": "Aff dørenn threend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 36,
      "text": "huornett y hyndis hynder skieenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 36,
      "text": "\"Y drecker, her Bøsmer, och dricker med meg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 37,
      "text": "Dricker meed mieg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 37,
      "text": "\"Saa weell ieg giøre, naar y meg beedder.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 37,
      "text": "Hand lagde till munden, och aff hand drack.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 38,
      "text": "Och aff hand drack:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 38,
      "text": "ald werdenn hanom aff huoffue gick.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 38,
      "text": "Hand glemtte sinn faadder och muodder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 39,
      "text": "Synn faadder och synn muodder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 39,
      "text": "hans søster och hans brødder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 39,
      "text": "Hand glemtte och synn festemøø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 40,
      "text": "Synn feestemøø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 40,
      "text": "som hand skulde med buode løffue och dø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 40,
      "text": "\"Sigger meg, her Bøsmer, paa edders maall.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 41,
      "text": "Paa edders maall:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 41,
      "text": "huor er y fød, huor er y bornn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 41,
      "text": "\"Y elluer er ieg født och bornn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 42,
      "text": "Fød och baarenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 42,
      "text": "och der er alle min kleder skaarne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 42,
      "text": "Och her staar y, min feste-mø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 43,
      "text": "Mynn festemøø:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 43,
      "text": "med edder weell ieg buode løffue och dø.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 43,
      "text": "Den elluer-møø haffuer forwonden nu alle sin quide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 44,
      "text": "Alld synn quidde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 44,
      "text": "hun leeger her Bøsmer wed sinn sidde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 44,
      "text": "Ham grede for faader och muoder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 45,
      "text": "Faader och muode,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 45,
      "text": "hans søster och hans brødder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 45,
      "text": "Men halleff merre daa sørggitt hans feestemøø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 45,
      "text": ":: Der liendenn hun løffues. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}