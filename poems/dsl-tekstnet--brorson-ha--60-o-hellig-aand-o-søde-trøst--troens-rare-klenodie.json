{
  "id": null,
  "title": "60. O Hellig Aand! o søde trøst",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
