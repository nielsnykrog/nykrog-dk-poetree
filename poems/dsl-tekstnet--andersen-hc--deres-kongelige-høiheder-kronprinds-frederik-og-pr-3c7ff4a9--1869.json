{
  "id": null,
  "title": "Deres Kongelige Høiheder Kronprinds Frederik og Prindsesse Lovisa, Formælingsdagen den 28de Juli 1869",
  "year_created": 1869,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1869,
    "url": "https://tekstnet.dk/books/andersen-hc_deres-kongelige-hoeiheder-kronprinds-frederik-og-prindsesse-lovisa-formaelingsdagen-den-28de-juli-1869/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Fra Nordens Ishav ned til Østersøen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Tre Lande med beslægtet Folkefærd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Paa Fjeld, i Birkelund, paa Bøge-Øen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "I Tiden skiltes ved det dragne Sværd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Der voxte Had, de gode Minder blunded’,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Men det blev Daggry, stille Søen laae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Sangfugles Røst lød over Øresundet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Saa lifligt, Hjertet kunde det forstaae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Ungdommen var det, som da først gav Møde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Gav Haandslag, følte Broder-Hjertets Slag;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "I Prøvelsernes Tid glad’ Frænder døde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Svensk, Norsk og Dansk stred for det danske Flag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "I Kjærlighed sig løfted’ Folkeaanden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Ungdommen var det, og den varer ved;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "To Kongebørn hinanden række Haanden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Syng Sverrig, Norge, Danmark: »Kjærlighed!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Du Sverrigs elskelige Kongedatter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Du er i Danmarks Skjold et Hjerte meer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Velkommen! et Velkommen lyde atter!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Ja, glad for Dig det danske Folk Du seer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "En trofast, ædel Husbond har Dig vundet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Vor elskte Kongesøn, Gud med I To!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Forlængst er gammel Tid og Taage svundet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Klart skinner Solen, Troskabs Roser groe!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
