  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1854,
    "url": "https://tekstnet.dk/books/andersen-hc_den-foerste-april-1854/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Man siger at ved Alfarvei",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Groer ikke Poesien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Det Skjönne med dets Glemmigei",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Det sees kun fra Gangstien.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Dog ikke Alt staaer til at troe!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "For her at være sikker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Vi gaaet er til Vesterbro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Hvor Landeveien ligger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Strax her et Huus vi standsed ved,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Der Digter födtes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Og længer ude, sees det Sted,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "og mödtes;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "I Haverne som ligge nær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Staaer Rosen, Gyldenlakken –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Og over Söndermarkens Træer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Det gamle Slot paa Bakken.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Det korte Stykke Landevei",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Har Poesi og Minder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Og see – ifjor man saae det ei, –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "En Bygning nu man finder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Den staaer med Krandse og med Flag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Herinde Liv sig rörer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Det er i Dag dens Födselsdag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Og derfor Sang man hörer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Her kan man faae ved Alfarvei",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Hvad der har Aandens Mærker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Om smaat kun, dog en Glemmigei",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Fra Snillets Mesterværker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "En lille Blomst, dog Tanken heel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Saa smuk, nok værd at eie!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Alt dette paa saa lille Deel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Af vore Alfarveie!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Gid Held og Fremgang være med!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "– Flyv Sang, udbred din Vinge!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "Det Dygtige paa dette Sted,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "Vi vil vort Hurra bringe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "Thi nu, jeg tænker nægtes ei:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "– det grundes skal herinde –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "Tæt ved den aabne Landevei",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "Kan hver det Skjönne finde!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
