  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "LOffuer Gud at han er saa god/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc ath hans miskundhed vaarer euindelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Saa sige och nu Jsraelss folkat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "hanss miskundhed waarer euindelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "Saa siger nu Aaronss huss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "at hans miskundhed vaarer euindelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Saa sige oc nu alle som frøcte Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "at hanss miskundhed waarer euindelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "J min nød kallede ieg paa Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "saa hørde Gud mig rundelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 5,
      "text": "Effter thi ath Gud er met mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "da frøcter ieg icke huad mennisken kan gøre mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 6,
      "text": "Effter thi at Gud er min eniste hielpere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "da wil ieg vel see paa mine fiende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 7,
      "text": "Der er bedre ath sette sit haab till Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "en ath forlade sig paa menniskene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 8,
      "text": "Ja det er fast bedre at sette sit haab till Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "en ath forlade sig paa Herrer och Førster",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 9,
      "text": "Alle hedninge haffue belagt mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "men i Gudz naffn fonger ieg vel heffn offuer dem alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 10,
      "text": "De haffue belagt mig tringt om kring/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 10,
      "text": "men i Gudz naffn vil ieg vel offuer vinde dem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 11,
      "text": "De haffue belagt mig lige som bierg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 11,
      "text": "de ere dog vdsløckte lige som ild i torne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 12,
      "text": "Men i Gudz naffn vill ieg well faa heffn offuer dem alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 13,
      "text": "De skøde och støtte mig/ ath ieg skulde haffue faldet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 13,
      "text": "men herren holt mig oppe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 14,
      "text": "Gud er all min styrcke/ oc den loffuer ieg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 14,
      "text": "thi han er vorden mig till salighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 15,
      "text": "Der lyder en gladelig oc salig røst/ i de retferdige menniskis bolige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 15,
      "text": "at Gudz høygre hand beuiser styrcke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 16,
      "text": "Gudz høygre hand er høgt oprackt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 16,
      "text": "Gudz høygre hand er megtig oc sterck",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 17,
      "text": "Jeg skal icke dø/ men leffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 17,
      "text": "och forkynde Gudz store gerninger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 18,
      "text": "Men Gud maa vel reffse mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 18,
      "text": "dog offuer giffuer han mig icke i døden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 19,
      "text": "Oplader retferdighedens porte for mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 19,
      "text": "ath ieg maa gaa der ind och loffue Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 20,
      "text": "Ja det er visselige herrens port de retferdige mue indgaa ath hannem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 21,
      "text": "Jeg tacker dig ath dw hører mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 21,
      "text": "oc ath dw est min salighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 22,
      "text": "Den sten som bygningis mendene bort kaste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 22,
      "text": "han er bleffuen till en hiørne sten",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 23,
      "text": "Ja det er alt sammen sket aff herren",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 23,
      "text": "en dog det er vnderligt i vore øgen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 24,
      "text": "Dette er den sande dag som herren haffuer førre skabt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 24,
      "text": "lader oss frøydis/ oc glædis i hannem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 25,
      "text": "O herre hielp/ o herre giff løcke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 25,
      "text": "velsigened were den som kommer i herrens naffn/ wi velsigne eder i Gudz huss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 26,
      "text": "Gud er en herre oc han opliuser oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 26,
      "text": "pryder høytiden met may til alterens hiørner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 27,
      "text": "O herre dw est min Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 27,
      "text": "och ieg vil tacke dig o min Gud/ ieg vill holde megit aff dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 28,
      "text": "Loffuer Gud ath han er saa god",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 28,
      "text": "ath hans miskundhed waarer ewindelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 29,
      "text": "Gud fader Søn och helligand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 29,
      "text": "ske priss oc ære i allen stund",
      "part": false,
      "marginal_notes": []
    }
  ]
}