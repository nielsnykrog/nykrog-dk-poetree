      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Hiemlene och iorden ere opfylte met din ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Salig gør oss i det øffuerste.",
