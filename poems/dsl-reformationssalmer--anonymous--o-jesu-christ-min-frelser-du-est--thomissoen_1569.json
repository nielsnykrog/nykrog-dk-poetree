  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Jesu Christ/ min Frelser du est/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Aff hiertet ieg for dig klager/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "At ieg mod dig/ aff skrøbelighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Haffuer syndet alle mine dage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Min synd er stor/ men du est god",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Oc naadig mod alle synder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "J huem sig vil bekiende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "O naadige Gud/ kom icke ihu",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Mine synder saa slem/ men dem forglem/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "All Christenhed met mig raaber.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Wi raabe til dig samdrectelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "O Herre du oss bønhøre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "O Jesu reen/ ieg klager allen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "For dig min sorrig oc vaande/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Som Verden nu mig vel hadskelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Fører ved Tiranner paa haande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "De Løffuer saa grumme/ de Vlffue tamme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "De ville mig sønderriffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "De ville dit Ord fordriffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "De samle deris Raad/ alt met stor had/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Mig Arme Lam ere de saa gram/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "De ville mig fra dig iage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "Mit haab til dig er fuldkommelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "Lad mig icke fra dig tagis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "O Christendom kier/ om det saa skeer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Tiranner ville dig fortrenge:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Da tenck paa mig/ ret hiertelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Huor snarlig ieg kand det vende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Jeg giffuer dem tid/ aff syndige ijd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "At de skulde sig omuende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "Oc mig for en Herre kiende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "Men de bliffue fast i Synd oc last/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "Oc tencke ey paa huor det vil gaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 2,
      "text": "Naar ieg vil ene regere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 2,
      "text": "O Verden blind i alle de ting",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 2,
      "text": "Din salighed monne anrøre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "O Jesu viss/ dit Ord giff priss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "Jeg maa det oc for dig kære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "Den største gaffue wi aff dig haffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "Det er dit Ord det skære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 3,
      "text": "Nu seer du vel/ huor det gaar til/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 3,
      "text": "Huor mangen dit Ord foracter/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 3,
      "text": "Oc mere paa Synden tracter/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 3,
      "text": "De spotte dine tienere/ du til dem sender/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 3,
      "text": "De dem fast true/ met mact forkue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 3,
      "text": "De skulle icke Synden straffe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 3,
      "text": "O Jesu Guds Søn/ giff dem deris løn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 3,
      "text": "Dine ord de daglig beklaffe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 4,
      "text": "O Christendom skøn/ de fange vel løn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 4,
      "text": "Som mit Ord icke maa lide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 4,
      "text": "All din salighed/ retfærdighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 4,
      "text": "Aff ordit lær du alle tide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 4,
      "text": "Den Dieffuel met list hand veed vel vist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 4,
      "text": "At det giffuer salighed allene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 4,
      "text": "Hans Lemmer dog det formene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 4,
      "text": "O Verden blind mod Liusens skin/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 4,
      "text": "Din fordømmelsser/ du acter meer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 4,
      "text": "J mørckit altid at bliffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 4,
      "text": "End acte mit Ord/ haffde du det giort",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 4,
      "text": "Da skulle du euindelig leffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 5,
      "text": "O Christe god/ det er tit spaad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 5,
      "text": "At farlige tider skulle komme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 5,
      "text": "Thi tenck hoss dig miskundelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 5,
      "text": "At frelse dine Christne fromme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 5,
      "text": "All miskundhed oc barmhiertighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 5,
      "text": "Dine arme Lemmer skulde haffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 5,
      "text": "Det er nu slet begraffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 5,
      "text": "Hofferdighed met gerighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 5,
      "text": "Foractelse/ forplaggelse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 5,
      "text": "De mod dine Arme beuise/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 5,
      "text": "Dine Faar foriagis/ dine Arme plagis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 5,
      "text": "O Herre naar skal det faa lise.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 6,
      "text": "O Jesu mild/ om du saa vilt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 6,
      "text": "Lade lenge dine Lemmer plagis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 6,
      "text": "Dine Armis nød slet intet skødis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 6,
      "text": "Men meer aff alle foractis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 6,
      "text": "Den mectig i mact/ den Rige i act/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 6,
      "text": "Dine Arme i sult oc hunger/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 6,
      "text": "J iammer sorrig oc kummer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 6,
      "text": "O Herre sød/ hielp her aff nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 6,
      "text": "Oc see her til dette vnderlig Spil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 6,
      "text": "Dine Faar ere flest de Arme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 6,
      "text": "O Jesu giff trøst/ see de Armis brøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 6,
      "text": "Dig snarlig offuer dem forbarme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 7,
      "text": "All Christenhed/ bøye hiertet hid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 7,
      "text": "Oc act vel huad ieg taler:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 7,
      "text": "Skøt ingen mact/ paa Ordit giff act/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 7,
      "text": "Jeg vil dig vel husuale.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 7,
      "text": "Jhuo dig rør/ hand mig det giør/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 7,
      "text": "Mit øyesten ieg dig ligner/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 7,
      "text": "Jeg vil dig aldrig suige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 7,
      "text": "All Christenhed/ glæde dig met mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 7,
      "text": "Naar Diefflen met sine til euige pine",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 7,
      "text": "Fordømmis aff mig allene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 7,
      "text": "Du bliffuer hoss mig euindelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 7,
      "text": "Met fryd oc glæde mig tiene.",
      "part": false,
      "marginal_notes": []
    }
  ]
}