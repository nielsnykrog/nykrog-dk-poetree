  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Tiden ejes af Kloderne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "og gribes af Mands og Kvindes",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "solbesværgede Jordsjæl,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "der savner og tror at mindes",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "den inter-astrale Lykke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "der vist maa i Verden findes.",
      "part": false,
      "marginal_notes": []
    }
  ]
