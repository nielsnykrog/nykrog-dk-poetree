{
  "id": null,
  "title": "68. O søde GUd! din naades magt",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
    "wiki": "Q348003"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Troens Rare Klenodie",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1739,
    "url": "https://tekstnet.dk/books/brorson-ha_troens-rare-klenodie/070/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O søde GUd! din naades magt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Som du, før verdens grund blev lagt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Saa evig fast har grundet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "At jeg nu ved din Aand og Søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Til livets krands saa tryg og kiøn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "En himmel-vey har fundet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Giør mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Trøstig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Til at træde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Fuld af glæde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Fra min smerte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Hart og nær ind til dit hierte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Dog det er endnu ikke nok,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "At du dig selv mod satans flok",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "For os saa vældig setter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "At du i kierlighedens glød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Ved Sønnens egen aand og død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Vor trang og byrde letter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Din lyst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Dit bryst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Os at eye",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "Og at pleye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "Giør at dine",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "Himmels-fyrster ere mine.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Dit engle-koor, som stedse kand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "I u-ophørlig glædes brand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Dit blide ansigt skue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Som staaer for thronen idelig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Og til din ære viser sig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "Saa fyrig som en lue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "De maae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "Og staae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "Os til rede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 2,
      "text": "Os at lede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 2,
      "text": "Os at bære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 2,
      "text": "Og fortrolig hos os være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "Din glands, som paa dem Straaler ned",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "Af Guddommens fuldkommenhed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "Og majestætisk rige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "Har dem i saadan glæde sat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 3,
      "text": "Og kierlighedens brynde, at",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 3,
      "text": "De aldrig fra dig vige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 3,
      "text": "Bøy du",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 3,
      "text": "Vor hu",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 3,
      "text": "Ligeledes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 3,
      "text": "At vi kedes",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 3,
      "text": "Ved den kolde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 3,
      "text": "Verden, og til dig os holde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 4,
      "text": "Den store flok i himlens sal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 4,
      "text": "Det tusind, tusind, tusind tal",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 4,
      "text": "Af engle-hær og skifter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 4,
      "text": "I deres skiønhed, glands og pragt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 4,
      "text": "Forenede af gandske magt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 4,
      "text": "Til himmelske bedrifter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 4,
      "text": "Seer nok",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 4,
      "text": "GUds flok,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 4,
      "text": "Hvor de ere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 4,
      "text": "GUd saa kiere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 4,
      "text": "Dog i fare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 4,
      "text": "Derfor vil de dem forsvare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 5,
      "text": "Saa skiøtte vi slet intet om,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 5,
      "text": "At satans hele rige kom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 5,
      "text": "Og vilde os forfærde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 5,
      "text": "Vi har i HErrens engle-hær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 5,
      "text": "Som er os nat og dag saa nær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 5,
      "text": "En mægtig vold og gierde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 5,
      "text": "Lad de",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 5,
      "text": "Mørke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 5,
      "text": "Aander grue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 5,
      "text": "Ved at skue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 5,
      "text": "Vores hvile,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 5,
      "text": "Fuld af engle-spyd og pile.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 6,
      "text": "Slet intet kand opholde dem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 6,
      "text": "De fare ubehindret frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 6,
      "text": "Som luftens stærke vinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 6,
      "text": "Igiennem al hans modstand gaaer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 6,
      "text": "De i en hast, som ild i blaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 6,
      "text": "Al mørkheds magt maa svinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 6,
      "text": "Hvad vil",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 6,
      "text": "Da til",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 6,
      "text": "Dette rige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 6,
      "text": "Satan sige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 6,
      "text": "Eller gielde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 6,
      "text": "Mod en hær saa stor af vælde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 7,
      "text": "Ach vilde jordens himmel-slægt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 7,
      "text": "Kun driste paa GUds varetægt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 7,
      "text": "Og frygte ingen farer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 7,
      "text": "O! Christen siel! kun vel til freds,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 7,
      "text": "Du gaaer jo tryg og allesteds",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 7,
      "text": "Blant lysets englers skarer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 7,
      "text": "Som sig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 7,
      "text": "Villig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 7,
      "text": "Til os vender,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 7,
      "text": "Og paa hænder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 7,
      "text": "Altid bære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 7,
      "text": "Hvo vil da bedrøvet være?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 8,
      "text": "Dog maae vi gaae i lysets trin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 8,
      "text": "Og flye det bare falske skin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 8,
      "text": "GUds englers vey betræde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 8,
      "text": "Ved synden krænkes dette sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 8,
      "text": "Hvo paa GUds frygt vil legge vind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 8,
      "text": "Kand alle engler glæde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 8,
      "text": "Den mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 8,
      "text": "Som kand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 8,
      "text": "GUd behage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 8,
      "text": "Hand kand drage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 8,
      "text": "Engle-hænder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 8,
      "text": "Efter sig, hvor hand sig vender.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 9,
      "text": "Vi ønske i GUds rige jo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 9,
      "text": "I deres selskabs lyst at boe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 9,
      "text": "Og dennem liig at blive,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 9,
      "text": "Velan saa maae vi ligne dem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 9,
      "text": "At GUd os ret er angenem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 9,
      "text": "End ogsaa her i live,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 9,
      "text": "At vi",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 9,
      "text": "Og i",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 9,
      "text": "GUd at tiene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 9,
      "text": "Os forene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 9,
      "text": "Og bevise",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 9,
      "text": "Al vor konst hans navn at prise.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 10,
      "text": "Saa vil de søge vores gavn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 10,
      "text": "Og bære os som børn i favn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 10,
      "text": "Vor skade aldrig taale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 10,
      "text": "De mørke aanders vid og kunst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 10,
      "text": "Skal svinde som en damp og dunst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 10,
      "text": "For deres glands og straale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 10,
      "text": "Var hand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 10,
      "text": "Satan,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 10,
      "text": "End saa modig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 10,
      "text": "De skal blodig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 10,
      "text": "Ham bortvise,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 10,
      "text": "Og os skaffe roe og lise.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 11,
      "text": "Naar vi i fare sikre gaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 11,
      "text": "Da give de os at forstaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 11,
      "text": "Hvordan vi kand undvige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 11,
      "text": "Er ingen ven saa god og kier,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 11,
      "text": "At hand i nøden er os nær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 11,
      "text": "De vil os aldrig svige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 11,
      "text": "Og om",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 11,
      "text": "Der kom",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 11,
      "text": "End saa mange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 11,
      "text": "Os at fange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 11,
      "text": "Sorte drager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 11,
      "text": "HErrens engler dem forjager.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 12,
      "text": "De gaae for os i kamp og striid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 12,
      "text": "Naar satan bruger al sin fliid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 12,
      "text": "Vor krop og siel at skiende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 12,
      "text": "De vaage hos os dag og nat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 12,
      "text": "Og kalde os Guds egen skat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 12,
      "text": "Ja, naar vort liv har ende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 12,
      "text": "Da er",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 12,
      "text": "Strax der",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 12,
      "text": "Engler rede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 12,
      "text": "Os at lede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 12,
      "text": "Vel saa blide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 12,
      "text": "Ind at staae hos Lammets side.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 13,
      "text": "Des skee dig priis af gandske magt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 13,
      "text": "O GUd! som os din engle-vagt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 13,
      "text": "Saa gierne vilde unde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 13,
      "text": "Vi vilde, mens vi vandre her,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 13,
      "text": "I saadan yndig engle-færd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 13,
      "text": "Dig prise hvad vi kunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 13,
      "text": "Til vi",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 13,
      "text": "Og i",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 13,
      "text": "Himmerige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 13,
      "text": "Engle-lige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 13,
      "text": "Frisk tilhaabe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 13,
      "text": "Hellig, hellig, hellig raabe.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
