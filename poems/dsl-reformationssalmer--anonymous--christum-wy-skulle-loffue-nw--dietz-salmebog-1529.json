  "source": {
    "id": null,
    "title": "Een ny handbog med Psalmer oc aandelige lofsange",
    "year_published": 1529,
    "publisher": "Ludwig Dietz",
    "printer": "Ludwig Dietz",
    "place": "Rostock",
    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/dietz-salmebog-1529/2/4"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "CHristum wÿ skulle loffue nw/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Marie søn then reene Jomffru/",
      "part": false,
      "marginal_notes": [
        "Mat. j."
      ]
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "saa wÿt som solen offuer skÿn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "bekende wÿ Jesum een Herre alleen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Then som skapte himmel oc iord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "han tog mandom een træl han word/",
      "part": false,
      "marginal_notes": [
        "Phil. ij."
      ]
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "att han oss icke gantske wilde fortabe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "thÿ wilde han seg til oss vmage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Guds krafft wdaff himmelen kom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "ÿ thet Jomffruelig lÿff giorde een mandom/",
      "part": false,
      "marginal_notes": [
        "Luce. ij. Esaie. vij."
      ]
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "then Jomffru som then naade bar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "hun wiste ey fuldkommelig hwad thet war.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Thet kyske hiertens hwss forwist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "snarlig annam med Jesum Christ/",
      "part": false,
      "marginal_notes": [
        "Luce. j."
      ]
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "hun bleff een Jomffru klar oc sand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "sÿn søn hun vndfick aff then helliaand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Then ædle moder bar oss then/",
      "part": false,
      "marginal_notes": [
        "Mat. j. Luce. j."
      ]
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "som Gabriel forkynde wdsend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "then Jomffru hun søgte Elizabet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "oc fands att haffue thet henne wor iætt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Johannes ÿ sÿn moders barm/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "frygdet seg bode med food oc arm/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Maria wdaff Guds samffund/",
      "part": false,
      "marginal_notes": [
        "Luce. j."
      ]
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "sang Magnificat bode med hierte oc mund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Then som all werden haffuer ÿ wold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "føddis ÿ een asne stold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "een liden mielk fødde hans natur/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "som føder oc wederqweger alle creatur.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "Then Engelske skare glæddis wid/",
      "part": false,
      "marginal_notes": [
        "Luce. ij:"
      ]
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "att wor kommen aff Abrahe sæd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "thet hørde the hiyrder som wochtet theris queeg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "att Christ wor fød oss menniske lÿg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "Aere wære teg Christ med konge naffn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "som føddis aff een Jomffru werden til gaffn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "holt thÿn spÿr med kongelig acht:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "att dieffuelsens rÿge faar icke macht.",
      "part": false,
      "marginal_notes": []
    }
  ]
}