  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "NV bede wi den Helligand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "om den Christelig tro oc ret forstand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Ath wi Gud elske kunde/",
      "part": false,
      "marginal_notes": [
        "Psal xix"
      ]
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "oc hannem kalle paa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "helst i dødzens stunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "naar wi aff verden gaa/ Kyrieleyss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Du verdige liwss giff oss dit skin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Lær oss Jesum Christ kende allen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "ath wi hoss hannem bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "den tro frelsermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "der for wor synd vilde lide/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "ingen kan oss frelse vden han Kyrieleyss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "O søde aand skenck oss din løst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "giff oss kerlighed vdi vort bryst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "at wi kun de huer mand elske",
      "part": false,
      "marginal_notes": [
        "Acto iiii"
      ]
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "aff hiertens grund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "hans lærdom der oss frelste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "følge i alle stund/ Kyrieleyss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "O høgeste trøster i alle nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "hielp ath wi icke frøcte skendzel eller død/",
      "part": false,
      "marginal_notes": [
        "Joan xvi"
      ]
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "men fast i troen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "mod dieffuelsens falske list/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "lad ingen ting oss driffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "fra vor frelser Jesu Christ/ Kyrieleyss",
      "part": false,
      "marginal_notes": []
    }
  ]
}