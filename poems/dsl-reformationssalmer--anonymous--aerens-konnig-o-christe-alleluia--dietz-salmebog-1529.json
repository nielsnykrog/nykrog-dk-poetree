  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Aerens konnig o Christe Alleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 1,
      "text": "O Fader wdi himmelen/",
      "part": false,
      "marginal_notes": [
        "Math. vj."
      ]
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "wid thÿn søn hør wor bøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Han er oss fød oc giffuen wist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "till all wor hielp oc trøst/",
      "part": false,
      "marginal_notes": [
        "Luce. xj."
      ]
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "wer oss mild o fader Alleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Hwilken som wor død oc for oss giffuen Alleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "O Christe Konning ÿ ewighed/",
      "part": false,
      "marginal_notes": [
        "Psalmo. ij."
      ]
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "Wÿ bede wær oss blÿd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "Tw som døden haffuer forderffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "oss salighed forhuerffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "bønhør oss o Herre Alleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 4,
      "text": "Han er opstanden som han sagde/",
      "part": false,
      "marginal_notes": [
        "Matthei xxviij."
      ]
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "Han er opfaren som han sagde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 5,
      "text": "¶ Loffuer Herren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "Helliaand wor bøn til teg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 6,
      "text": "O Gud wor trøstermand/",
      "part": false,
      "marginal_notes": [
        "Joh: xiiij. oc. xvj."
      ]
    },
    {
      "id": 17,
      "stanza_id": 6,
      "text": "Samwittighedzens trøst/ hiertens løst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 6,
      "text": "Affslætt alle Christens brøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 6,
      "text": "Fred oc glæde giff oss. ¶ Loffuer Herren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 7,
      "text": "Bed Gud for oss Alleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 7,
      "text": "Loffuer Herren Alleluia Alleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 8,
      "text": "Konningens dother aff ewighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 8,
      "text": "Christi brud glæder seg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 8,
      "text": "For then hun haffuer ÿ aanden vndfangen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 8,
      "text": "han er som han sagde opstanden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 9,
      "text": "Han er som han sagde opfaren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 10,
      "text": "Hun seg paa Gud forlader Alleluia.",
      "part": false,
      "marginal_notes": []
    }
  ]
}