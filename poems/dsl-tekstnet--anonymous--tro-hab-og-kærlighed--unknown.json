  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Fides, Spes et Caritas",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "swo fagre søstræ tree.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Earum viget claritas",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "swo bolde ære the at see.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "swo faa ære nw aff thee.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Vinum sumptum dulciter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "fforderwer swo manghen man.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Sic et mala mulier",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Salomon fert taliter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "thet sigher han for sant.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Omnis amor mulieris",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "han ær swo swigefwld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "thet han ær selden hwld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Ffellico corde defrauderis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "thet ær cober, thet synes guld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Hamo piscis capitur,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "Mellitis verbis quatitur,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "han ey forstande kan,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "et si sensus dabitur,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "swo omwendes han.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "han brødh Wor Herres boodh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "Dauid rex, in semine,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "ther han kom thette i hwæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "petit vxorem Urie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "Omnis homo caueat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "schridher han met en foodh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "ne vigore careat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "hannum stondher annen omoodh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "tha fangher han thes wel boodh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": "Qui festucam irripit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "j syn brodhers øyæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "trabemque non decepit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "Deus est qui conspicit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": "Han dømme effther leuendis dødhæ.",
      "part": false,
      "marginal_notes": []
    }
  ]
}