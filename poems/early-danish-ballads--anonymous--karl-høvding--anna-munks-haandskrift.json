{
  "id": null,
  "title": "Karl Høvding",
  "year_created": [
    1590,
    1591
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Anna Munks Håndskrift",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1591,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/MUNK47.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Karll Høffdinng hannd siider paa Raffnsøø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": ":: mynn hierteliig rosenn er minn kier ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "taller hanndt om saa venn en møø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Menns hannom vindis liffuitt. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "\"Ieg vill mig ride op-unnder øø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "feste Innge-borrig Iffuers-datter, saa ven enn møø!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Dett suaritt denn suendt y kiorthellen suortt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "\"Denn iomffru hunn er giffuenn buortt!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "Dett suaritt denn suenndt, som ham stodt nest:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "\"Her Magnnus haffuer den iomfru fest!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "\"Førenndt hunn skulde bliffue her Magnusis viiff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "førenndt skulde dett kaaste mitt unnge liiff!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "Huilcke aff mine suenne ville med mig fare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 5,
      "text": "och sytt liiff ey for mig spare?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "\"Alle saa ville wi med eder fare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "och hielpe eder adt vinde den spegell klare!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "Karll Høffding hand lader sin snecke bou,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 7,
      "text": "hand actter adt vinde den skiønne iomfru.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "Di wanndt op seigell och for-gyldene fløig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 8,
      "text": "saa seigled di fra Raffnsøe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "Karll Høffdinng hand kom icke føre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 9,
      "text": "førend der brende bluss for brudde-huss-dørre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "Brudenn hun sig offuer axell saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 10,
      "text": "\"Hised seer ieg seigell baade brune och blaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "Brudenn wende sig thill mor-søster sinn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 11,
      "text": "\"Ieg sier hans seigell aller-kierist min.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "Ieg sier hans seigell baade brune och blaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 12,
      "text": "ieg haabes, Charll Høffding hand ere der-paa!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "\"Høer du, Ingeborig, kiere søster-datter min:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 13,
      "text": "lad here Magnus vere aller-kiereste dinn!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "\"Høer du, Therckell, kiere broder min:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 14,
      "text": "du rid thil strande for søster dinn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "Du rid thill strande for søster din:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 15,
      "text": "ere ded Karll Høffding, du beed hanem innd!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "Karll Høffding hand styred sin snecke for land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 16,
      "text": "Therckell hand vende sin ganger paa sannd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "\"Welkommen, Therckell, kiere stalbroder min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 17,
      "text": "huor lider iomfru Inngeborigh, kier søsterre dinn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 18,
      "text": "\"Minn søster hun leffuer, ere frou och glad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 18,
      "text": "ded ere i-dag hindes brøllups-dagh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 19,
      "text": "Ded ere brudens første bøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 19,
      "text": "adt i, Charll Høffding, ville følge mig hiem!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 20,
      "text": "\"Fuld lided kand ded min glede vere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 20,
      "text": "en anden soffuer hoss min hierttens-kierre!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 21,
      "text": "Terckill hannd soer om Gud och meenn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 21,
      "text": "\"Brudenn hunn icki fra kierckenn kom enndt!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 22,
      "text": "\"Høre thu, Terckill, kiere stollbroder min:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 22,
      "text": "viltthu lanne mig gannger dinn?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 23,
      "text": "Wiltthu skiiffthe dinn kleder med mig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 23,
      "text": "och all minn snecke saa giiffuer ieg dig.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 24,
      "text": "\"Ieg giør dett icki for gaffue eller guldt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 24,
      "text": "ieg suiger icki her Mognus, hannd er mig huld.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 25,
      "text": "\"Wilthu skiiffthe dinn kleder mett mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 25,
      "text": "liidenn Kierstinn, minn søster, giiffuer ieg dig!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 26,
      "text": "Thi fuldis igiemmel denn grønne lundt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 26,
      "text": "dy skiiffthe dieris kleder saa suar en stundt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 27,
      "text": "\"Emedenn du haffuer skiifftt kleder med mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 27,
      "text": "ladt mig y-dag skienncke for diig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 28,
      "text": "Vy haffuer nu skiifftt voris kleder mett ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 28,
      "text": "ladt mig vinn for brudenn bære!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 29,
      "text": "Thy redt udy den bruder-skare;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 29,
      "text": "dy viste icki, huilckenn Karll Høffdinng vaare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 30,
      "text": "Hannd red fram for denn brude-karm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 30,
      "text": "hand haffde deraff baade glede och harm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 31,
      "text": "Thi førde brudenn y her Mognusis gaardt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 31,
      "text": "der var icki guldt for legerenn spardt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 32,
      "text": "Dy satthe brudenn paa brude-bennck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 32,
      "text": "Karll Høffdinng gaar paa gulffuitt att skienncke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 33,
      "text": "Karll Høffdinng hannd luder offuer bredenn bordt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 33,
      "text": "hanndt taller thill brudenn itt skempthis ordt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 34,
      "text": "\"Huad heller ville y verre her Mognusis møø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 34,
      "text": "eller y vill følge mig thill Raffnsøø?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 35,
      "text": "\"Heller vill ieg følge eder thill Raffnsø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 35,
      "text": "ennd ieg vill verre her Mognusis møø!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 36,
      "text": "Førenndt ieg vill bliffue her Mognusis viiff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 36,
      "text": "tha ville ieg voffue mitt unge liiff!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 37,
      "text": "\"Thier quer, minn aller-kieriste, y siiger icke saa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 37,
      "text": "itt bedre raadt saa ville vy faa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 38,
      "text": "Sildig om affthenn, rim faldt paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 38,
      "text": "denn unnge brudt løsther att soffue gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 39,
      "text": "Di fulde bruden thil brude-hus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 39,
      "text": "di bare for hinder di høie blus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 40,
      "text": "Thy fulde brudenn thill brude-senng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 40,
      "text": "droninngen fulde hender sielff der-indt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 41,
      "text": "Dy fulde brudenn y sennge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 41,
      "text": "Karll Høffdinng dualtt ey holde lennge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 42,
      "text": "Karll Høffdinng hannd y denn brude-seng sprannck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 42,
      "text": "hannd slucte ud blus medt høyre haanndt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 43,
      "text": "Thett melthe droninngenn, och hun bleff vredt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 43,
      "text": "\"Huem slucker udt lius, vy skall vid see?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 44,
      "text": "Huem er nidinng y brude-hus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 44,
      "text": "huem slucker for thenn unnge brudt blus?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 45,
      "text": "\"Ieg er ey nidinng, ieg vill haffue den møø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 45,
      "text": "ieg heder Karll Høffding thill Raffnsø!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 46,
      "text": "Droninngenn thaller thill sinne møer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 46,
      "text": "\"Huem haffuer hørtt slig unnder før?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 47,
      "text": "Udgick denn droninng med sinne møer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 47,
      "text": "Karl Høffdinng lucte denn loffthis-dør.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 48,
      "text": "Droninngenn gaar ad sallenn frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 48,
      "text": "hun recker her Mognus sinn huide haannd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 49,
      "text": "\"Saa unnderlig thidinnder ieg thill dig bære:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 49,
      "text": "Karll Høffdinng soffuer huos dinn hierthenns-kierre!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 50,
      "text": "Karll Høffdinng soffuer huos dinn lille-vanndt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 50,
      "text": "om heffne dett, her Mognus, om thu kanndt!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 51,
      "text": "Her Mognus hanndt thog thill sinn kniiff:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 51,
      "text": "\"Dett skall kaaste hanns unnge liff!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 52,
      "text": "Saa snartt vortt brøner aff bielckenn røct,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 52,
      "text": "oc haardenn hielm paa hoffuitt skøtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 53,
      "text": "Dy støtte paa dør mett glaffuinnd och spiud:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 53,
      "text": "\"Statt op, her Karll, och gack her-udt!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 54,
      "text": "Karll Høffdinng hannd ud adt vinduett saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 54,
      "text": "\"I er saa mannge, vy er saa faa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 55,
      "text": "I er saa mannge, vy er icke udenn thoff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 55,
      "text": "dog skall ieg gierne thill eder gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 56,
      "text": "Dett er minn aller-største harm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 56,
      "text": "ieg skall aff denne iomffru henndis arm.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 57,
      "text": "Karll Høffdinng hannd paa gulffuitt sprang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 57,
      "text": "denn iomffru slo seiers-kleder offuer ham.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 58,
      "text": "\"Her haffuer y saa godt itt suerdt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 58,
      "text": "udi orme-blodt saa er dett herdt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 59,
      "text": "Inngenn suerd eder skade kannd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 59,
      "text": "imedenn y haffuer dett suerdt i haannd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 60,
      "text": "Her haffuer y enn brønnie saa guodt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 60,
      "text": "der bider inngenn staall paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 61,
      "text": "Thagers y nu eders suerd y haannd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 61,
      "text": "y forskoner minn fader, om y kanndt!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 62,
      "text": "Karll Høffdinng ud adt dørrenn løb,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 62,
      "text": "sitt guode suerdt hanndt for syg bødt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 63,
      "text": "Hand voffue y denn første flock",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 63,
      "text": "her Mognus mett synn gule lock.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 64,
      "text": "Hannd voffue y denn annden skare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 64,
      "text": "her Mognusis threy brødre och stoltt Innge-lillis fader.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 65,
      "text": "Stoltt Inngeborrig fick stuor møde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 65,
      "text": "hunn saa hinndis fader bløde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 66,
      "text": "\"Udi enn sorrig-fuldt stundt saa er ieg født:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 66,
      "text": "minn fader er for minn skyldt død!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 67,
      "text": "Hannd klappitt hinnde vidt huidenn kindt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 67,
      "text": "\"I sørger icki, aller-kieriste minn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 68,
      "text": "Ieg kunnde dett icki volde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 68,
      "text": "om iegh mitt liiff vilde beholde!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 69,
      "text": "Karll Høffdinng stack sig suerd ved siide:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 69,
      "text": "\"Iomffru, ville y mett mig riide?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 70,
      "text": "\"Ieg vill dog følge diig aff lanndt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 70,
      "text": "alltt for nogenn verdsenns manndt!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 71,
      "text": "Saa gladt var alle Karll Høffdinngs mend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 71,
      "text": "dy fulde denn iomffru offuer grønnen enng.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 72,
      "text": "Dy fulde denn iomffru thill stranndenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 72,
      "text": "henndis broder fulde dem thill lanndt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 73,
      "text": "Dy vanntth op segell och for-gyldenne flø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 73,
      "text": "saa seyler dy thill Raffnnsøø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 74,
      "text": "Tack haffue Karll Høffdinng, hannd holthe sinn thro:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 74,
      "text": "saa lodt hanndt sitt brøllup bo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 75,
      "text": "Hannd lodt syg der-thill løste:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 75,
      "text": "hannd gaff Terckill hanns søster.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 76,
      "text": "Hannd gaff ham sinn søster, saa ven enn møø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 76,
      "text": ":: minn hiertelige rosenn och minn kier ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 76,
      "text": "mett hinnder halff Raffnnsøø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 76,
      "text": ":: Menn hannd vinnder hinnder saa liiden. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}