  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Jens Billes Håndskrift",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1559,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/BILL41.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Niels fiiskere hand haffuer saa feden gaass,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": ":: hui staa y saa? ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "huer en natt lycker hand hende y laaess.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Lad dantzen gaa, ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: thi hand well maa, ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": ":: y affthen er god tiid oppaa. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Niels fiiskere hand skulle tiill torriitt age,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "hand glemde att lycke syn gass y lass.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Bratt kom bud for Niels fiiskere ind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "\"Reffuen løffuer mett gassen thin.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "Niels fiiskere hand skuder thett brede bord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "then brune miød paa gulffuit stod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 4,
      "text": "Niels fiiskere løff offuer bierg oc dale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "alt før hand fick then reff om hale.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 5,
      "text": "\"Mynn kiere Niels fiiskere, lad mig leffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 5,
      "text": "alt men ieg maa myn sielle-gaffue giffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 6,
      "text": "Ffoueden giiffuer ieg mytt øre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 6,
      "text": "hand skall saa megit paa tingitt høre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 7,
      "text": "Ffouede-suenen giiffuer ieg myn stertt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 7,
      "text": "hand thett saa megit som erliigt er vertt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 8,
      "text": "Kierlingen giiffuer ieg myn thend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 8,
      "text": "hand siider saa hartt, hun fick hannem icke end.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 9,
      "text": "Tiill graa-brødre-closter giiffuer ieg myn krop,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 9,
      "text": "the lege mig for thøn senge-stock.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 10,
      "text": "Tiill nunde-closter giiffuer ieg myn skynd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 10,
      "text": "thi bede myn siell y hemmeriig ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 11,
      "text": "Lenge stod Niels fiskere oc lyde ther-paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 11,
      "text": ":: huj staa y saa? ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 11,
      "text": "reffuen lod att skuouen staa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 11,
      "text": ":: Lad dantzen gaa, ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 11,
      "text": ":: thij hand well maa, ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 11,
      "text": ":: y affthen er god tiid oppaa. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}