  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "»Nei Danmark skal ei eie Holberg meer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Jeg bryder Leret, som hans Aand omfatter!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Saa talte Døden. »Af det kolde Leer,«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Bød Thorvaldsen, »skal Holberg fødes atter.«",
      "part": false,
      "marginal_notes": []
    }
  ]
}
