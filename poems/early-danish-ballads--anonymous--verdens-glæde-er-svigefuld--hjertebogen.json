{
  "id": null,
  "title": "Verdens glæde er svigefuld",
  "year_created": [
    1553,
    1555
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Hjertebogen",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1555,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/HJB54.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Werszens glede ær suyge-fuld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "beblant mett suck och sorrig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "aff hin annen skall were huld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "bliffuer mand snarist forsmaatt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "thy troskab ær saa ringen ting",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "bade blant mand och quinne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "lede siig nu alt werden om-kringh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "saa syellind skall mand troskaff finne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Rett troskab for-vden suyg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "ær dyrer end søll eller guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "huem kyerlighed beer yderlig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "och reth dydefuld;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "hund tencker ther-paa y allen stund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "thett saa att skicke mett lyste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "sin aller-kyerist att suige rett yngen-lunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "for skulle hynnes hierthe bryste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Wer siig anthen quinde eller mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "syn wen haffuer kyer y synde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "thy rett yngen-lund dølle kand;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "were wyd huem thett wyll rettelig achte saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "saa offte thy fanger theris kyerist att see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "thett kendis well paa theris fachte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "Lad siig och talle, huem ther wyll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "thy haffuer ycke andett att giøre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "som theris acht och synd ther-tiill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "att thy kunne fange att føre;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "huad wyll thy siige, thy maa tyenne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "vtack bliffuer alle theris bade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "thy skall rett aldrig aff bade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "yegh wyll myn kyerist forholle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "I dyd och ære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "skall yeg hoss hynde bliffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "hund skall for-ynden mytt hierthe were,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "myn sorrig kand hund fordriffue;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "yeg haffuer hynde kier end all thend ting, y werden staar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "theris att winde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "skall aller nogen wynne fraa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "thett stund mig liffuet kand wynne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "Stor lengels, atttraa for-vden raad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "skall then saa yderlig bere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "sin kyerist skulle att see faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "som hannum løste hielst hoss att were,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 5,
      "text": "hand skall ther wyde god lempe tiill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 5,
      "text": "thett hiemmelig hoss siig haffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 5,
      "text": "huem yngen sin sorrig for syge wyll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "hannum giøris saa lange dage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 6,
      "text": "Skaal troskab hollis, som før ær sagt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 6,
      "text": "myn kyerist wyll myg ey suige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "yeg elsker hynd yennist aff sind och acht",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 6,
      "text": "offuer bode fattig och riige;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 6,
      "text": "then yennist som alting haffuer y wold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 6,
      "text": "och iennist kand styre och raade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 6,
      "text": "befaler yeg ether myn aller-kyerist y wold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "hand wochte hynnes liff fra wade.",
      "part": false,
      "marginal_notes": []
    }
  ]
}