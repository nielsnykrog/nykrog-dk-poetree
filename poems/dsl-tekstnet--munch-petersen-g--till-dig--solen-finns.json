      "text": "vill livet-",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "..... vad du och jag vill -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
