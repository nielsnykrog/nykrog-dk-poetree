  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Helge",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1814,
    "url": "https://tekstnet.dk/books/oehlenschlaeger-a_helge/003/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 170,
      "text": "Stedse sidder her Du rolig",
      "part": false,
      "marginal_notes": [
        "Speaker: HELGE"
      ]
    },
    {
      "id": 1,
      "stanza_id": 170,
      "text": "Under Egetræets Skygge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 170,
      "text": "Broder! vilst Du evig bygge?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 170,
      "text": "Graven blier din sidste Bolig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 170,
      "text": "Du est ung endnu og vakker;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 170,
      "text": "Riid dog eengang under Øe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 170,
      "text": "Fæst Du Dig saa væn en Mø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 170,
      "text": "Mens paa Havet Helge flakker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 171,
      "text": "Helge flakker om paa Hav!",
      "part": false,
      "marginal_notes": [
        "Speaker: HROAR"
      ]
    },
    {
      "id": 9,
      "stanza_id": 171,
      "text": "Vil da Helge evig flakke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 171,
      "text": "Paa den luegyldne Smakke?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 171,
      "text": "Bølgen blier din sidste Grav.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 171,
      "text": "Daarligt Du bebreider mig;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 171,
      "text": "Hvorfor har da Du ei Dronning?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 171,
      "text": "Du est Danmarks ældste Konning,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 171,
      "text": "Ætten stamme bør fra Dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 172,
      "text": "Det er ikke skeet som sagt.",
      "part": false,
      "marginal_notes": [
        "Speaker: HELGE"
      ]
    },
    {
      "id": 17,
      "stanza_id": 172,
      "text": "Ofte har alt Freias Kerte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 172,
      "text": "Tændt i Flammer dette Hierte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 172,
      "text": "Helge kiender Freias Magt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 172,
      "text": "Men i hendes Frugt jeg fandt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 172,
      "text": "Fæle Nastronds Orme nage;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 172,
      "text": "Bitterheden blev tilbage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 172,
      "text": "Og den korte Sødme svandt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 173,
      "text": "Ilden funkler i Dit Øie,",
      "part": false,
      "marginal_notes": [
        "Speaker: HROAR"
      ]
    },
    {
      "id": 25,
      "stanza_id": 173,
      "text": "Bleghed hviler paa Din Kind!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 174,
      "text": "Snart det kan igien sig føie,",
      "part": false,
      "marginal_notes": [
        "Speaker: HELGE"
      ]
    },
    {
      "id": 27,
      "stanza_id": 174,
      "text": "Helge blusser fro i Sind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 174,
      "text": "Han er syg - maa læges først.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 175,
      "text": "Hvilken Sygdom kan det være?",
      "part": false,
      "marginal_notes": [
        "Speaker: HROAR"
      ]
    },
    {
      "id": 30,
      "stanza_id": 176,
      "text": "Saaret brænder i hans Ære,",
      "part": false,
      "marginal_notes": [
        "Speaker: HELGE"
      ]
    },
    {
      "id": 31,
      "stanza_id": 176,
      "text": "Hævnen er hans Febertørst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 177,
      "text": "Oluf trodser paa sit Slot.",
      "part": false,
      "marginal_notes": [
        "Speaker: HROAR"
      ]
    },
    {
      "id": 33,
      "stanza_id": 178,
      "text": "Stille, Broder! Stille, stille!",
      "part": false,
      "marginal_notes": [
        "Speaker: HELGE"
      ]
    },
    {
      "id": 34,
      "stanza_id": 179,
      "text": "Stolte Dronning.",
      "part": false,
      "marginal_notes": [
        "Speaker: HROAR"
      ]
    },
    {
      "id": 35,
      "stanza_id": 180,
      "text": "Skiønne Frille!",
      "part": false,
      "marginal_notes": [
        "Speaker: HELGE"
      ]
    },
    {
      "id": 36,
      "stanza_id": 180,
      "text": "Alt endnu kan vorde godt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 181,
      "text": "Siig, hvad svulmer i Din Barm?",
      "part": false,
      "marginal_notes": [
        "Speaker: HROAR"
      ]
    },
    {
      "id": 38,
      "stanza_id": 181,
      "text": "Sælsomt Du paa Jorden stirrer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 181,
      "text": "Øiet funkler, Læben dirrer -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 182,
      "text": "Hører Du den muntre Larm?",
      "part": false,
      "marginal_notes": [
        "Speaker: HELGE"
      ]
    },
    {
      "id": 41,
      "stanza_id": 183,
      "text": "Dine Helte gaae ombord;",
      "part": false,
      "marginal_notes": [
        "Speaker: HROAR"
      ]
    },
    {
      "id": 42,
      "stanza_id": 183,
      "text": "Hundred skiønne stolte Snekker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 183,
      "text": "Med de hvide Seil bedækker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 183,
      "text": "Fladen af min Issefiord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 184,
      "text": "Det var Fugle, som Du saae;",
      "part": false,
      "marginal_notes": [
        "Speaker: HELGE"
      ]
    },
    {
      "id": 46,
      "stanza_id": 184,
      "text": "Fugle, som paa hvide Vinger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 184,
      "text": "Sommeren til Saxen bringer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 184,
      "text": "Over alle Bølger blaae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 184,
      "text": "Reden venter hist paa Væg! -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 185,
      "text": "Kommer Du da snart tilbage?",
      "part": false,
      "marginal_notes": [
        "Speaker: HROAR"
      ]
    },
    {
      "id": 51,
      "stanza_id": 186,
      "text": "Ja! naar først min vrede Drage",
      "part": false,
      "marginal_notes": [
        "Speaker: HELGE"
      ]
    },
    {
      "id": 52,
      "stanza_id": 186,
      "text": "Ud har ruget sine Æg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 193,
      "text": "Ungerne vide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 193,
      "text": "Hvad Biørnen maa lide;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 193,
      "text": "Kløerne voxe, dem lyster at stride.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 193,
      "text": "Munter, Herr Konge! munter, fat Mod!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 193,
      "text": "Snart er Forsmædelsen sonet med Blod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 193,
      "text": "Listigt vi komme, som Freia til Jetten.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 193,
      "text": "Ikke forglemme vi Skioldungaætten.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 193,
      "text": "Stene paa Barmen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 193,
      "text": "Hamren i Armen -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 193,
      "text": "Ha hvilken Fest!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 193,
      "text": "Odin skal sadle sin Ottefods-Hest!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 193,
      "text": "Ingen vi dræbe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 193,
      "text": "Svagt kun vi saare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 193,
      "text": "Kysse kun vil jeg forbittrede Læbe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 193,
      "text": "Blod skal ei flyde; men brændende Taare!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 193,
      "text": "Taarer kun flyde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 193,
      "text": "Lidet da vist har Din Hævn at betyde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 193,
      "text": "Dannemarks Drot.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 193,
      "text": "Husk vore Fiender",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 193,
      "text": "Ere kun Qvinder!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 193,
      "text": "Mindes at Spotten bør hævnes med Spot!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 193,
      "text": "Ha hvilken Fest!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 193,
      "text": "Men Ørnen kun truer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 193,
      "text": "Høgen, og ei de uskyldige Duer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 193,
      "text": "Hellig os være",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 193,
      "text": "Pigernes Ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 193,
      "text": "Hende kun henter den luende Drage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 193,
      "text": "Nu har vi lidet af Veien tilbage;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 193,
      "text": "Hisset vi see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 193,
      "text": "Taarnene tre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 193,
      "text": "Spirene blinke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 193,
      "text": "Heimdals Haner fra Spirene vinke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 193,
      "text": "Skoven skal skiule",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 193,
      "text": "Snekkerne gule.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 193,
      "text": "Rask nu paa Land!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 193,
      "text": "Skyder de vuggende Skuder i Sand!",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
