{
  "id": null,
  "title": "65. Gorm, Haralds søn",
  "year_created": 1495,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Rimkrøniken",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1495,
    "url": "https://tekstnet.dk/books/anon_rimkroeniken/068/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Som andræ kongær toghe them tijl idh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "i orloff oc krij ath øffuæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "saa tog ieg meg foræ vdhi myn tijdh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Ieg spurde ther bodhe en iætthæ i nøør",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "megeth righ paa kostellighæ eyæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Thet sade meg Torkyld, myn tiæner føør,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "han wistæ wel ther tijl veyæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "thet rwcthæ gik aff saa widhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Tijl hannum hade ieg meghen figh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "ey andheth kunne ieg meg tagæ tijl idhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "Thi lodh ieg rede meg holkæ tree",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "och hundrede men i hwer aff thee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "ther hædhen tha mwnne ieg acthtæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "Saa seglde ieg hedhen wdhi then søø",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "paa hyn syde Norgis rigæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "ther bode saa arghæ tigæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "Ieg kaste mit acker paa then sandh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "iegh hade saa lith at thæræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "Thi sænde ieg buth oppaa thet landh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 6,
      "text": "Om nathen kom ther so manghe troldh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "oppaa then strandens bankæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 6,
      "text": "The spurde at hwo oss gaff then woldh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 6,
      "text": "ath wij theres dywr skullæ sanckæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "som eth wort mast kwnde wære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 7,
      "text": "Tha ieg thet saa ieg hade nar døøth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 7,
      "text": "saa mwnne meg thet forfæræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 8,
      "text": "Thet beddis aff hwert wort skiff en mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 8,
      "text": "om wij skullæ komme bort fran thet land;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 8,
      "text": "then bøn wij genesten wethæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 9,
      "text": "Saa seglde wij thædhen tijl Gutmwntz land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 9,
      "text": "i stor bekommer oc waadhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 9,
      "text": "wij gleddis at wy thet naadhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 10,
      "text": "Ther bad oss Torkell hwer och en",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 10,
      "text": "ath wij skullæ thiæ som stene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 10,
      "text": "om wij willæ hiem tijl lande igen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 11,
      "text": "Han oss forbøth ath ædhe meth them",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 11,
      "text": "elder noger theres ting ath røræ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 11,
      "text": "om wij willæ komme tijl Danmark hiem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 11,
      "text": "och sye hwat wij ther høræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 12,
      "text": "och daghen mwnne bort fallæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 12,
      "text": "tha kom Gwdmwndh for oss at staa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 12,
      "text": "bode stoor oc grwm meth allæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 13,
      "text": "Han helsæde oss hwer wedh sith naffn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 13,
      "text": "Han iættæ oss bode meth hand oc saffn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 13,
      "text": "han willæ oss gøræ thet bestæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 14,
      "text": "Han settæ oss op tijl høffue bordh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 14,
      "text": "ther wore saa kostelligæ rætther.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 14,
      "text": "meth kemper elder meth iætther.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 15,
      "text": "Xij hans søner, wel deyligæ mæn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 15,
      "text": "the gynge ther fore at tiænæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 15,
      "text": "kledde i gyldene støckæ hwer oc en",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 16,
      "text": "Then ælstæ oc wænestæ bød han megh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 16,
      "text": "the andræ mynæ ypperste swenæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 16,
      "text": "Ieg menthe ther wor allt vnder eth swegh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 16,
      "text": "thi laa ieg helder enæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 17,
      "text": "the gyngæ meth them at soffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 17,
      "text": "The bleffue forwendæ paa en stedh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 17,
      "text": "tijl trold ther som the loffuæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 18,
      "text": "Ther the sowe ath wij tawdhe saa quer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 18,
      "text": "tha wor them ildh i lengher oc wer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 18,
      "text": "the togæ thet tijl mystyckæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 19,
      "text": "Tha swarede Torkell for oss saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 19,
      "text": "han badh them ey wære wredhe:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 19,
      "text": "thi geffuer ether nw tijl fredhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 20,
      "text": "The hollæ oc fwlmegeth tijl hadh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 20,
      "text": "ath the bliffue skullæ sywgæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 20,
      "text": "om the ædhe aff thenne fræmmede madh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 21,
      "text": "Tha han thet hørdhe at wij sade ney",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 21,
      "text": "och wore aldeles saa tryggæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 21,
      "text": "tha lod han følghæ oss paa then wey",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 21,
      "text": "tijl Gerutz, hans broder, byggæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 22,
      "text": "for døde mentz howeth ther wore",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 22,
      "text": "paa steyler seth i hwerth wighskaar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 22,
      "text": "och hwnde som ther laa foræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 23,
      "text": "The hwnde gaff Torkel eth horn meth feth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 23,
      "text": "Wij steyæ then mwr oc gyngæ saa breth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 23,
      "text": "wij fwndhe ther trold saa ledæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 24,
      "text": "Thet wor bode grwmth oc rædelicth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 24,
      "text": "alt thet som wij soffue tæræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 24,
      "text": "ieg syer thet paa myn æræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 25,
      "text": "Ther roddæ oss Torkill atther saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 25,
      "text": "at wij skullæ wære wel trøstæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 25,
      "text": "och hwer meth annen manneligæ staa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 26,
      "text": "Hwo som tagher her noghen tingh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 26,
      "text": "tha hængher hwn wedh hans hænder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 26,
      "text": "Thi ær thet raadh at gaa omkringh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 26,
      "text": "elder han bliffuer forwænder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 27,
      "text": "som Geruth wor selffuer indhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 27,
      "text": "Ther fwndæ wij hannum aff døden qwal",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 27,
      "text": "meth tre kroghryggæde qwinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 28,
      "text": "Meth døde hwghormæ wor gulffueth strøth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 28,
      "text": "Menneskæ sade ther som lengæ wor døth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 28,
      "text": "All gletskaff wor ther borthe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 29,
      "text": "The sode alle paa sædæ aff iern,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 29,
      "text": "the mwnne saa ildhe lucthæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 29,
      "text": "saa tog ieg tijl ath fructhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 30,
      "text": "Tha wij soffue oss bedher omkring",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 30,
      "text": "wthi then sal saa widhe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 30,
      "text": "wij soffuæ ther faffuer oc løstelig ting",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 31,
      "text": "En hwalstan laa ther slawen meth gwld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 31,
      "text": "eth horn meth dyræ stenæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 31,
      "text": "en fading giord meth konsten fwld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 31,
      "text": "Alt sammen meth gwll hynth renæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 32,
      "text": "the togæ the kleynodæ skøne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 32,
      "text": "The frommestæ men man kunne see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 32,
      "text": "the mwnne thet illæ røne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 33,
      "text": "Then tand, han wendis om tijl eth swerdh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 33,
      "text": "Then fading, en orm han giorde syn gerdh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 33,
      "text": "The dræptæ the men saa fagæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 34,
      "text": "Tha tog then sall i same stwnd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 34,
      "text": "ath røstes och ath skelffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 34,
      "text": "the døde op sprwngæ ther selffuæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 35,
      "text": "The kerlingher tree the roptæ ioduth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 35,
      "text": "ath wij skullæ ther saa røffuæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 35,
      "text": "The orme paa gulffueth wthi then puth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 36,
      "text": "Tha fingæ wij ther ful storth eth meen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 36,
      "text": "wij kwnde oss ey saa weriæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 36,
      "text": "ath wij bleffue ey wthen tywæ igen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 36,
      "text": "som kwnde wort liff tha beriæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 37,
      "text": "meth thet folk wij hade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 37,
      "text": "och seglede saa hiem tijl Danmark igen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 37,
      "text": "Wij wore saa drabelig glade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 38,
      "text": "Tha ieg kom hiem tha kedis meg wedh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 38,
      "text": "Thi gifftæ ieg meg oc bleff meth fredh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 38,
      "text": "thet gik meg wel tijl handhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 39,
      "text": "Siden fik ieg spurth ath menneskens siell",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 39,
      "text": "skall altijd bliffue i liffuæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 39,
      "text": "hwor myn siæll skullæ bliffuæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 40,
      "text": "Ther swarede meg mit rod saa tijl:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 40,
      "text": "»Thet inghen tijl stor ath widhe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 40,
      "text": "wthen eders nadis gudh, om han so wil.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 41,
      "text": "Thertijl widhe wij ey bæder budh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 41,
      "text": "wthen Torkil, eders swen hyn snare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 41,
      "text": "han maa thet spøriæ aff ethres guth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 41,
      "text": "oc widhe hwat han will suare.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 42,
      "text": "och bødh hannum tijd ath faræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 42,
      "text": "Ieg badh hannum koræ tijl seg aff thæm",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 42,
      "text": "som deyligæ wore och snaræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 43,
      "text": "Ieg badh hannum faræ tijl Wgartilock",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 43,
      "text": "och spøriæ hannum ath for wthen drock",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 43,
      "text": "hwath løn myn siæll skullæ fangæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 44,
      "text": "Ieg lod hannum redhe eth skiff saa fast",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 44,
      "text": "ath seglæ meth tijl the gwder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 44,
      "text": "betacth meth tiwræ hwder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 45,
      "text": "The seglidæ saa lengæ bort i nør",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 45,
      "text": "ath the i mørken komme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 45,
      "text": "En segidlæ the tha som the giorde før",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 46,
      "text": "Lancth om syer tha mathe the see",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 46,
      "text": "en ildh for staffnæn brændhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 46,
      "text": "Ther seglidæ the effther i daghe tree",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 46,
      "text": "før en the kunnæ ther lændhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 47,
      "text": "och gik imodh then lwæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 47,
      "text": "Tha han tijd kom han ther tha fandh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 47,
      "text": "saa røghet och sorth en stwæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 48,
      "text": "Ther sade too kompaner hoss then bool,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 48,
      "text": "oc horde som horn elder som stoll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 48,
      "text": "oc thertijl krogedæ som andræ stangæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 49,
      "text": "Meth them rørdhe the bode nath oc daw",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 49,
      "text": "i ildhen som ther laa foræ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 49,
      "text": "ath røræ i brandænæ och poræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 50,
      "text": "Them spurde Torkell fræmdeles om vey",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 50,
      "text": "hwor han kunne myn gudh fyndhe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 50,
      "text": "och om tijdh wor lancth elder ey",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 51,
      "text": "Tha sade then enæ oc paa han sordh:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 51,
      "text": "»Skall ieg teg wæen kændhe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 51,
      "text": "tha skalltu syæ meg trænde ordh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 51,
      "text": "som wel kunne wære sændhe.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 52,
      "text": "»Ieg wil thet syæ paa loffuæ:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 52,
      "text": "Ieg aldrig slemmer næser saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 52,
      "text": "noger handhe menneskæ owæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 53,
      "text": "Aldrig wor ieg oc nogher stedh gesth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 53,
      "text": "Thi holder ieg then fod altsom besth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 53,
      "text": "meg først kan hedhen bæræ.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 54,
      "text": "Tha swarede troldhit: »The samme ordh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 54,
      "text": "the kunde wel wæræ sændæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 54,
      "text": "alth weyen oc seglinghen kendæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 55,
      "text": "Fyre dags segling skalth tw ga paa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 55,
      "text": "før tw thet lanth kanth fyndæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 55,
      "text": "som thin herres guth ær oppaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 56,
      "text": "Saa gik Tørkel tijl then bool",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 56,
      "text": "han willæ aff ildhen tyggæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 56,
      "text": "»Ney,« sade troleth paa sith mool,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 56,
      "text": "»tw skalt hannum lade lyggæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 57,
      "text": "som inghen kan driffue tijl ryggæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 57,
      "text": "annen gawe elder bedæ stordh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 57,
      "text": "wil ieg ey aff teg tyggæ.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 58,
      "text": "Tha swarer Torkil, han wor saa bradh:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 58,
      "text": "ath høre oc tagæ aff nuttiligæ raadh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 58,
      "text": "i hwædhen som the mwnne kommæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 59,
      "text": "Kan ieg nw wel komme hæden igen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 59,
      "text": "ieg wil hijdh aldrig mere faræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 59,
      "text": "som hijd oc hedhen meg baræ.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 60,
      "text": "Saa fik han ild oc seglidæ saa fws",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 60,
      "text": "som trollet hannum foræ sadæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 60,
      "text": "Han fand myn gudh ther i eth hws,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 61,
      "text": "Han tænde eth lyws oc gik ther indh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 61,
      "text": "ther wor saa græsæligt indhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 61,
      "text": "Han hade nar tabeth bode andh oc sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 61,
      "text": "hannum kunde ey raadh tijl rindhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 62,
      "text": "wor bwnden meth boyær sterkæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 62,
      "text": "som han hade sidhet wthi en stok,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 62,
      "text": "thet kwnde Torkell wel merkæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 63,
      "text": "Hwert haar som wor paa hans krop,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 63,
      "text": "The stode alle och styrlede op",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 63,
      "text": "som the hade wæret thornæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 64,
      "text": "The lucthedæ werræ en noghen vting",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 64,
      "text": "man kan i werdhen fyndhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 64,
      "text": "thet hws som han wor indhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 65,
      "text": "Han ructæ eth haar odaff hans skegh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 65,
      "text": "meg hiem tijl thegn ath føræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 65,
      "text": "Thet gaff aff seg then lucth oc dregh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 66,
      "text": "Tha sprungæ the ormæ oc ander trold",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 66,
      "text": "paa hannum oc hans følgæ saræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 66,
      "text": "Ther vndgik ey vthen v aff theres wold",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 66,
      "text": "som seg kunde for them varæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 67,
      "text": "the ormæ effther them flwæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 67,
      "text": "The hwitzlede oc spwtæ paa them venen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 67,
      "text": "ath them mottæ ther foræ grwæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 68,
      "text": "En aff them vndher thiællynghen waar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 68,
      "text": "och stynghæ sith howeth ther vdh saa snaar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 68,
      "text": "han thet ther genesthen møstæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 69,
      "text": "En annen racthe ther vdh syn hand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 69,
      "text": "han skullæ thet thiæll tijl draue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 69,
      "text": "saadan fick han ther plaue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 70,
      "text": "Then trediæ skullæ oc se ther tijl",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 70,
      "text": "hwedhen them kom then wode.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 70,
      "text": "Thet kwnde well ware eth iamerlig spel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 71,
      "text": "Tha bad Torkel al mectichste gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 71,
      "text": "ath han skullæ hannum benodhe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 71,
      "text": "och frælsse hannum wdaff then nød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 71,
      "text": "oc aff then høwelig wodhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 72,
      "text": "han lod tijl Tydeskæland standæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 72,
      "text": "Ther tog han dob oc kristendom",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 233,
      "stanza_id": 72,
      "text": "før han kom hiem tijl lande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 234,
      "stanza_id": 73,
      "text": "Siden han kom tijl meg meth thet hoor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 235,
      "stanza_id": 73,
      "text": "ther dødhe aff mangæ och ladis paa boor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 236,
      "stanza_id": 73,
      "text": "saa iamerlig mwnne thet lucthæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 237,
      "stanza_id": 74,
      "text": "Tha han fik sacth meg aff then wroo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 238,
      "stanza_id": 74,
      "text": "myn syæl skullæ haffue och mødæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 239,
      "stanza_id": 74,
      "text": "Aff angher oc sorgæ ieg dødæ.",
      "part": false,
      "marginal_notes": []
    }
  ]
}