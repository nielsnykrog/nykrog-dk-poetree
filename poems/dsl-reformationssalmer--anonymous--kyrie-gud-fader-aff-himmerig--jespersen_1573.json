  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "KYrie/ Gud Fader aff Himmerig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "du sende oss din Søn til Jorderig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "fordi du vilde være oss miskundelig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Christe Guds Søn aff Himmerig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Du lodst dig føde til Jorderig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "At wi maatte vorde Guds børn met dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "O Hellig Aand/ som varst i den gierning Mestermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "at Jomfru fødde vden Mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "lad oss ey dø i Syndsens baand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Men fød Christum i oss/ O hellig Aand.",
      "part": false,
      "marginal_notes": []
    }
  ]
}