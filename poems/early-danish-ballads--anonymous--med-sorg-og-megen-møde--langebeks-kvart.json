{
  "id": null,
  "title": "Med sorg og megen møde",
  "year_created": [
    1570,
    1573
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Langebeks kvart",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1573,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/LNGK35.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Mædt soriig och møgin møde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "mit hiarte thett er beklemtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "som thenn ther skal pinnis till dødt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "och er i iærnitt spenntt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "hanndt monne thenndt tiidt forbiide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "hanns dagge kunde ennde faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "hanndt schulle ichÿ lengir liide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "then quide szom hannom maanne faarstaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Alldt thett hannd monne paa thenche",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "thett er thenndt haarde dødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "hans armme liiffh maann wennde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "att schilliis fraa thenne her øø;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "saadinn er och minn pinne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "huor taalliigh ieg hinde bær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "faar enn saa høffuischenn quinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "faar hinnder ieg haffuir i hiartett kiær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Riider ieg, ellir ieg gangiir,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "elliir huadt minn idrett er,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "saa saarre ieg epther hinde langher,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "faar hinde ieg saariigin bæer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "menn mothe iegh hos hinder werre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "och driiffue rett ellschoffhuins spill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "ieg wille ichÿ mierre glæde begieræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "fast mier thenn stundt mitt liiff er till.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Ieg er for hindis schølldt thuonginn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "iegh kandt ey gledinn faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "saa saarre er ieg bebundinn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "wttÿ thenn staarre atraa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "att ieg kanndt neppelliigh talle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "nar wÿ tilsammin er,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "saa leggis mit hiarthe y dualle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "aff thenn qualle ieg alltiid for hinnder bær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Nar ieg i fremde stedir",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "blandt frwer och iomffrwer er,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "dÿ mercher well paa min sæædiir,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "ieg hemelligh saariigin bær;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "iegh thencher thett schulle inginn merche,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "ieg war aff saariiginn krysth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "thett giør alldt wæinn hin sterche,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "thett wercher alldt bode i hiarthe och brøsth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "Riigdom ellir dyrbar stienne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "iegh liidit achther paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 5,
      "text": "ey hellder gulldit hin rænne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 5,
      "text": "ieg will thett allsamin forsmaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 5,
      "text": "ther-till baade wennir och frennder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "wndtaggit thenn liillie-quisth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "saa manghe som ieg rett kiennder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "fraa-wender hun huff och sinndt foruisth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "Ieg will ichj for hinndis schølldt sparre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 6,
      "text": "at woffue mitt wnnghe liiff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 6,
      "text": "om enndt ieg wisthe saa werræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 6,
      "text": "att enthin mett suerdt ellir kniiff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 6,
      "text": "igiennum mitt hiarthe schulle gannge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "dogh wille ieg liide thenn nødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "thett schulle megh ichj forlanghe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "att fanghe for hindis schølldt thenn dødt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 7,
      "text": "Nw will ieg helliir før",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 7,
      "text": "lade migh rinde blodt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 7,
      "text": "ennd nogin mandt schulle thett spørre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 7,
      "text": "ieg wille giørre hinde imodt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 7,
      "text": "hinder sømir baade tucktt och eærre;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 7,
      "text": "hun er saa dydeffulld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 7,
      "text": "till hinde er alld min begieringh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "fasth mier inndt epther søllff och gulldt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 8,
      "text": "Gudt wnnde megh thenn dagh at leffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 8,
      "text": "om thett hanns williæ er,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 8,
      "text": "att iegh mothe ellschoffuin prøffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 8,
      "text": "alldt mett min hiarthins-kiærre;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 8,
      "text": "ieg will hinder ichj offuir-giiffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 8,
      "text": "om thett war i min macth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 8,
      "text": "menn helliir hosz hinnder at blliiffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 8,
      "text": "och leffue alltiidt, som vÿ haffuir sagtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 9,
      "text": "Kiarlliighett, dydt och erre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 9,
      "text": "thennom kallder mandt søsther thræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 9,
      "text": "ihuor som dÿ monne werre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 9,
      "text": "dÿ er saa bollde att se;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 9,
      "text": "dÿ finndis hosz hinnde saa riigge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 9,
      "text": "som Sallomonn war paa gulldth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 9,
      "text": "ieg wedth ichj flierre hinde liigge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 9,
      "text": "aff at siigge, som er saa dydeffulldt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 10,
      "text": "Inndschir hun nathinn at werre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 10,
      "text": "saa langh som dagin ix,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 10,
      "text": "da wor thett minn begieringh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 10,
      "text": "at hun wor nÿ ganngh x;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 10,
      "text": "meg wille huerchin hungher ellir tørsthe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 10,
      "text": "epther wersiins øll ellir madth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 10,
      "text": "menn mier epther kiarlliighetts løsth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 10,
      "text": "thett første wÿ ware tilsamin gladth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 11,
      "text": "War hun møø ellir ennchj,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 11,
      "text": "tha war min huff well trøst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 11,
      "text": "thett kand huer wedth seg thennche,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 11,
      "text": "min pinne wor da well løsth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 11,
      "text": "tha monne hun segh forbarme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 11,
      "text": "megh err och dydt betthæ;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 11,
      "text": "hun soffuir i enn andin suends arm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 11,
      "text": "then harm thett giør mitt hiarthe stor wææ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 12,
      "text": "Ieg wedt ichj flierre min liigge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 12,
      "text": "som elschoffuins pinne bær",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 12,
      "text": "forwdin Floris hin riigge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 12,
      "text": "som hade Blandzefflor kier;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 12,
      "text": "hand monne for hinde liide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 12,
      "text": "paa thenne wersins øø",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 12,
      "text": "baade angist, soriigh och quide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 12,
      "text": "then tiidt dog rech hand ichj at dø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 13,
      "text": "Nw er ther ichj flerre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 13,
      "text": "blanntt wersins quinder till,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 13,
      "text": "ieg elscher aff hiartett mierre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 13,
      "text": "ey helliir mith liiff fallder ther-till;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 13,
      "text": "wthinn enn roszins-blaame,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 13,
      "text": "hinder sømir eærre och priis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 13,
      "text": "kunde wÿ ichj paa iordinn samin kome",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 13,
      "text": "os till frome, Gudt wnde osz pariidis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 14,
      "text": "Salliighett frædt och naade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 14,
      "text": "wdaff faderinn och sønn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 14,
      "text": "saa ønscher ieg os baade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 14,
      "text": "Her Gudt, dw hørre wor bønn;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 14,
      "text": "at wÿ mothe endgang bliffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 14,
      "text": "tillsaminn i kiarlliighett,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 14,
      "text": "alldt syndt och lasth fordriiffue",
      "part": false,
      "marginal_notes": []
    },
    {
