{
  "id": null,
  "title": "Jeg har mig en jomfru fæstet",
  "year_created": [
    1579,
    1583
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Langebeks kvart",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/LNGK82.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Yeg haffuer meg enn yomffru ffesth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "ieg well henne priisze och ere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "syger hun ney, tthett hun icke well,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "tthett er mynn høgeliige kere;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "huy monne hennes maall nu were saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "hun leger medtt hiertte y langenn tthraa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "hun rader der yngenn bode paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Harr haffuer hun som spunden guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "hennes kynder ere roszenn-røde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "y dødenn wiille ieg ffor henne gaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "och ttholle ffor hennde denn møde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "wiille hun setth angesictth tthiill meg tthee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "saa blydeliig wiille ieg tthiill henne see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "hennes bogstaff staar skriffuen y abesetth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Hennes bogstaff staar skriffuen, ieg wed well huor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "ieg tthør tthet icki offuen-bare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "y-huor mand leder mellem Paridys och Rom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "mand ffynder icki hennis mage;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "icki med tthuctt, icki med gode syind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "hun haffuer enn rosze y beges hennes kyinnd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "well err denn swend, der yomffruenn kannd wynde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Der stod enn dore, hannd liide der-paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "god wellig kunde hannd well mercki;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "huy monne denn swennd seg klaage saa?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "huy monne hanns hirtte saa wercki?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "denn leffuer icki tthiill, der dem kannd bode atth-skylle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "fforwdenn Gud-Ffader, y-nar thett er hanns willyge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "ieg tthackes gerne Gud, mynn aller-kiresthe err tthiill.",
      "part": false,
      "marginal_notes": []
    }
  ]
}