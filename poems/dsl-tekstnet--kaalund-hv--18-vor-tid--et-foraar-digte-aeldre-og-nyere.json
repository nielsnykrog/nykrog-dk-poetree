{
  "id": null,
  "title": "18. Vor Tid",
  "year_created": 1858,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Vilhelm Kaalund",
    "country": null,
    "wiki": "Q2362214"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Et Foraar. Digte, Ældre Og Nyere",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1858,
    "url": "https://tekstnet.dk/books/kaalund-hv_et-foraar/019/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Nu skriver fast Alle den dejligste Stil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "man digter og rimer saa yndigt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Kritiken gaar efter med Høvl og med Fil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "og det saa det næsten er syndigt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Saa priser man Literaturens Held -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "men det smager ikke af Livets Væld!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Forstanden driver saa kløgtigt et Spil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "den alt i Systemer vil føje;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "ja vist skal af Øjne der skarpe til",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "at træde et Synaaleøje!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "men Musen dog aldrig fødte et Fjeld -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "som før græder Aanden for Livets Væld!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Ja, Verden bliver saa led og saa kjed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "den gaber og skaber sig kræsen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "saa kildrer man den med lidt Vittighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "i Siderne og under Næsen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "og Narrenes Brixe slaa Smæld i Smæld;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "men det smager ikke af Livets Væld!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Helt broget er Smagen fra Taa og til Top,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "modern, antik og romantisk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "min Stol pompeijansk og chinesisk min Kop;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "dog skaber sig Dværgen gigantisk:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "Et Ben i Dalen og ét paa Fjeld -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "men det smager ikke af Livets Væld!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "Effekten! Effekten tilbeder vor Slægt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "Man skyder paa Fyrster og Konger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "saa kappes Ens Hoved med megen Effekt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "man nævnes af tusinde Tunger;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "der prækes og gjøres urimeligt Spræl -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "men det smager ikke af Livets Væld!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "Lidt Nyt skal det være! ja vist noget Nyt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "Nu trænge vi til det Pikante;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 0,
      "text": "saa vender man Tingen paa Vrangen - Pyt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 0,
      "text": "Til Pirringen ere vi vante.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 0,
      "text": "Den Nyhedslyst er mig forskruet og grel -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 0,
      "text": "ældgammelt som Livet er Livets Væld!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 0,
      "text": "Med Dampen man sejler, trods Vejr og Vind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 0,
      "text": "og kalder sig Kræfternes Herre;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 0,
      "text": "man damped sig gjerne i Himmelen ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 0,
      "text": "men bliver dog ude desværre!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 0,
      "text": "Som før er af Hunger og Død man Træl -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 0,
      "text": "af Kuldamp smager ej Livets Væld!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 0,
      "text": "Ja, trods al vor Kløgt og vor smukke Stil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 0,
      "text": "og alle de mange Maskiner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 0,
      "text": "vor Tid har om Munden saa sygt et Smil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 0,
      "text": "og sørgende ere dens Miner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 0,
      "text": "Det tykkes mig tidt, som det lider mod Kvæld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 0,
      "text": "som vi skal gjenfødes i Livets Væld!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 0,
      "text": "Naar Bølgen sig løfter, den synke maa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 0,
      "text": "for atter sig mægtigt at hæve -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 0,
      "text": "saa lad det kun falde, som ej kan bestaa;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 0,
      "text": "hvad Aanden tilhører, skal leve!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 0,
      "text": "Jeg tror det forvist, det hæver sig vel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 0,
      "text": "med sejerrig Pande af Livets Væld!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 0,
      "text": "Jeg tror det forvist, jeg stoler paa Gud!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 0,
      "text": "Til Lise for Menneskesorgen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 0,
      "text": "den Kamp for Lyset skal kæmpes ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 0,
      "text": "og Dæmringen følges af Morgen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 0,
      "text": "ja friskere Slægter til Jorderigs Held",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 0,
      "text": "opdukke, forklared', af Livets Væld!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 0,
      "text": "Men naar skal den komme, den store Idé,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 0,
      "text": "som Tiden forjetter at føde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 0,
      "text": "Skal fjernere Slægter dens Straaler først sé,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 0,
      "text": "naar vi, som den aned, er døde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 0,
      "text": "Jeg havde saa gjerne badet min Sjæl",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 0,
      "text": "i Livets evige Sundheds Væld -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 0,
      "text": "Jeg havde saa gjerne hilset med Sang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 0,
      "text": "de lysere, skjønnere Dage!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 0,
      "text": "men Tiden henvandrer urokket sin Gang;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 0,
      "text": "det hjælper slet ikke at klage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 0,
      "text": "Thi maa jeg end synge som Lærken i Kvæld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 0,
      "text": "jeg jubler som den dog for Livets Væld!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
