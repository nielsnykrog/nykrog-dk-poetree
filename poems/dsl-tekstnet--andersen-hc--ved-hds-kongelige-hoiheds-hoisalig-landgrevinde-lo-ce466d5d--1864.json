    "printer": null,
    "place": null,
    "year_published": 1864,
    "url": "https://tekstnet.dk/books/andersen-hc_ved-hds-kongelige-hoeiheds-hoeisalig-landgrevinde-louise-charlottes-bisaettelse-i-roeskilde-domkirke-den-7-april-1864/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "I Kongesal, i Armods Stue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Med samme Magt Dödsenglen staaer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Stöv bliver Stöv, men Aandens Lue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Ind til sin Gud og Herre gaaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "I Armods Vraa, i Kongeborg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Kan raade samme Savn og Sorg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Kun Minderne fra svundne Dage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Har Solblink da, de gaae forbi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Og de vil aldrig heelt bortdrage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Gjensynets Glæde boer heri.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "I Sörgende, græd Smerten ud;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "En Ven meer, har I nu hos Gud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Her faldt den Green af Kongestammen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Der satte Blomst ind i den ny,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Det Træ der groer med Folkets sammen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Mens Lyn slaaer ned fra Uveirs Sky.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Hvert Moder-Hjerte beder nu,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Og hos Gud Herren beder Du!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Hviil trætte Stöv i Gravcapellet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "I Kraft til Gud sig Sjælen svang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "Bruus Orgeltoner til Farvellet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Det löfter sig paa Psalmesang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "Den föler ei til Sorg og Savn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Der gaaer til Gud i Jesu Navn!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
