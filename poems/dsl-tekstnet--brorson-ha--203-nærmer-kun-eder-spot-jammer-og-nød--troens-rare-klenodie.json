  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Nærmer kun eder, spot, jammer og nød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Kommer tillige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Mod os at krige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Her er GUds tempel og himlenes rige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Mægtig at tage mod blodige stød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Nærmer kun eder, spot, jammer og nød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Elskende siele er alting en lyst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Giftigste bue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Hedeste lue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Kand dem fra striden ey skrekke og true,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Himlen de bære i hierte og bryst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Elskende siele er alting en lyst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Haabet hun triner i sikkerste spor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Midt i sin møye",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Har hun et øye",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Altid paa kronen, som staaer i det høye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Skal hun da lide, da veed hun hvorfor.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Haabet hun triner i sikkerste spor.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Ach det kand giøre os sielen saa sund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Trusel og vrede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "Er kun en hede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Hvori vi verden af sindet udsvede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "At det kand læges i inderste grund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Ach det kand giøre os sielen saa sund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Det maa du grundig forlade dig paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 4,
      "text": "Naar du skal finde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 4,
      "text": "Taarerne rinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 4,
      "text": "Striid og anfegtninger ude og inde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Det er just veyen til himlen at gaae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "Det maa du grundig forlade dig paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 5,
      "text": "Troe kun din JEsum, saa bliver du stærk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 5,
      "text": "Bitterste sager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 5,
      "text": "Skændsel og plager",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 5,
      "text": "Endelig liflig som sukkeret smager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 5,
      "text": "Det er vor HErres hans herligste verk.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Troe kun din JEsum, saa bliver du stærk.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 6,
      "text": "Bange gemytter er alting til last,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 6,
      "text": "Vil GUd dem føre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 6,
      "text": "Det kand de høre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 6,
      "text": "Riset dem aldrig en finger maa røre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 6,
      "text": "Verdens fornøyelse holder dem fast.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 6,
      "text": "Bange gemytter er alting til last.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 7,
      "text": "Alt for utidig betænkning er slem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 7,
      "text": "GUds raad at kiende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 7,
      "text": "Derhen sig vende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 7,
      "text": "Skiønt man umuelig seer anfang og ende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 7,
      "text": "Det maa, naar andre forvirres, gaae frem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 7,
      "text": "Alt for utidig betænkning er slem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 8,
      "text": "Priser den store alviseste GUd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 8,
      "text": "Naar hand fordrager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 8,
      "text": "At man os plager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 8,
      "text": "Da vil hand drive de vigtigste sager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 8,
      "text": "Alting skal falde saa ønskelig ud!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 8,
      "text": "Priser den store alviseste GUd.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
