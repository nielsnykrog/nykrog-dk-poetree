{
  "id": null,
  "title": "† Madame K. M. Iversen i Odense",
  "year_created": 1838,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
