{
  "id": null,
  "title": "Med kummer må jeg klage",
  "year_created": 1584,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Dronning Sophias visebog",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1584,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/DRS49.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Medt kommer maa ieg klage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "elenndig maa ieg leffue;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "allenne paa Gud saa forlader ieg meg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "saa well y sorig som y glede;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "forlenne mig tholmodighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "thin faderlig karsz at bere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Huad min Gud will, thet skee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "ieg kand thet icke emod-sige;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "hand wed bedst, huad mig nøttelig er,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "meg ske alt effther hans wilge;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "huad Gud will haffue frem, kand ingen foruende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "hand haffuer ald-thingest y wolde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Thill Gudt seter ieg mit hoff och lid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "hannd well mig icke forlade;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "werdenn er fuld met falsk och suig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "och wndt y alle maade;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "thj rader ieg bode quinde och mandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "at ingen seg paa hinde forlader.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "O Gud, thu est thennd mandt, som osz",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "kannd thrøste y alle moedtganng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "med thin meskunde och naade;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "ieg haaber paa thig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "thu forlader icke meg;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Gud hielp osz alle aff sønd och sorig.",
      "part": false,
      "marginal_notes": []
    }
  ]
}