{
  "id": null,
  "title": "256. See dagen bryder frem med magt.",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
    "wiki": "Q348003"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Troens Rare Klenodie",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1739,
    "url": "https://tekstnet.dk/books/brorson-ha_troens-rare-klenodie/246/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "See dagen bryder frem med magt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Giør himlen lys igien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Og driver mørket hen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Op hierte paa din morgen-vagt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Lad ingen trygheds blund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Formørke naadens stund;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Hierte, tag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Denne dag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Vel i agt, og tænk derpaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Mueligt seer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Aldrig meer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Dine øyne soel opstaae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Hvor mangen morgen-rød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Var inden aften død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Og i et øyeblik",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Sin afskeed fik!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Hvad hielper øynene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Den lyse dag at see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Naar sielen vandrer blind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "I tiden ind?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Kom morgen-røde rosen-skiøn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "Giør himlen lys og blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "At mørket vige maa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "Min morgen-røde er GUds søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 1,
      "text": "Hans vunders røde glands",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 1,
      "text": "Forfrisker sind og sands,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 1,
      "text": "JEsu død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 1,
      "text": "Purpur-rød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 1,
      "text": "Giør mig Sielen himmel-blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 1,
      "text": "At mit sind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 1,
      "text": "Kiger ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 1,
      "text": "Hvor jeg skal for thronen staae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 1,
      "text": "Den dug, som over alt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 1,
      "text": "Paa græs og urter faldt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 1,
      "text": "At væde bierg og dal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 1,
      "text": "Ey svinde skal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 1,
      "text": "Før jeg i JEsu blod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 1,
      "text": "Forfrisket har mit mood",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 1,
      "text": "Og ret bedugget faaer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 1,
      "text": "Udi hans saar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 2,
      "text": "Ach det forfrisker al min tiid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 2,
      "text": "Naar jeg til sengen gaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 2,
      "text": "Naar jeg igien opstaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 2,
      "text": "Det giør min morgen-stund saa bliid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 2,
      "text": "Det skyder glæder ind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 2,
      "text": "Som straaler i mit sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 2,
      "text": "At jeg veed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 2,
      "text": "Den, som leed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 2,
      "text": "For mig, JEsus, er min skat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 2,
      "text": "At jeg paa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 2,
      "text": "JEsum maa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 2,
      "text": "Sikker bygge dag og nat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 2,
      "text": "Saa tryg jeg lagde mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 2,
      "text": "Og sov saa sødelig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 2,
      "text": "Fordi mit hierte paa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 2,
      "text": "Dit hierte laae;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 2,
      "text": "Saa sund paa siel og krop",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 2,
      "text": "Saa glad jeg vogned op,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 2,
      "text": "Og JEsu kys jeg fandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 2,
      "text": "Før natten svandt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 3,
      "text": "Tak derfor, søde siele-ven!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 3,
      "text": "For saadan tiids-fordriv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 3,
      "text": "At du er selv mit liv.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 3,
      "text": "Mit liv jeg ofrer dig igien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 3,
      "text": "Thi jeg vil idelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 3,
      "text": "I tiden leve dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 3,
      "text": "Al min tiid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 3,
      "text": "Al min fliid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 3,
      "text": "Giver jeg min Frelser-mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 3,
      "text": "Og jo meer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 3,
      "text": "Jeg dig seer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 3,
      "text": "Tændes jeg i saadan brand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 3,
      "text": "Ach straal i sielen ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 3,
      "text": "Min soel! og giør mig blind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 3,
      "text": "Til verdens lyst at see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 3,
      "text": "Saa skal det skee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 3,
      "text": "At hverken medgangs tiid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 3,
      "text": "Ey heller kors og striid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 3,
      "text": "Skal kunde hindre mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 3,
      "text": "At elske dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 4,
      "text": "Saa gaaer jeg da saa vel til freds",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 4,
      "text": "Hen i mit kald og stand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 4,
      "text": "At giøre hvad jeg kand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 4,
      "text": "Min JEsus føer mig allesteds",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 4,
      "text": "Ved haanden som sin bruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 4,
      "text": "Hvor jeg gaaer ind og ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 4,
      "text": "At jeg maa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 4,
      "text": "Færdig staae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 4,
      "text": "Hver minut at gaae herfra,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 4,
      "text": "Siden hist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 4,
      "text": "Gandske vist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 4,
      "text": "Synge mit hallelujah.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 4,
      "text": "Hallelujah! min trang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 4,
      "text": "Gaaer bort ved tidens gang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 4,
      "text": "Gaaer dagen, min fortred",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 4,
      "text": "Gaaer ogsaa med:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 4,
      "text": "Som strømmen føre kand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 4,
      "text": "Det tunge skib til land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 4,
      "text": "Saa fører tiden mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 4,
      "text": "Til himmerig.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
