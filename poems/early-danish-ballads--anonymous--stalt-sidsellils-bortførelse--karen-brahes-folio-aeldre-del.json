{
  "id": null,
  "title": "Stalt Sidsellils Bortførelse",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA70.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Stalltt Sedsellild er en rosens-blad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": ":: y skuoffuen ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "saa offtte giør hun mitt hiartte glad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "ieg fryder meg allenn stunde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: Seleff gangis hun hanom ey aff. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Herr Rybboltt kaam fraa thynnge hiem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "stalt Sedsellild hans datter gaar hanom igenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "\"I wer well-komen, kerr fader myn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "huad war der thiden i-dag paa thinnge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "men y er komen saa snarlig hiem?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "\"Thett wor thidenn och thett wor miest:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "her Thymand haffuer deg paa thingitt fest.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Hun sagde: \"Thett skuld blyffue hanom til angest miest.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "Stalt Sedesellild weende seg snartt omkreng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "hun thalde thaa til synn lidenn smaa-dreng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "hun sende her Laui buod igenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "\"Thu bed hanom kome y affttenn her,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "om hand haffuer mig y hiartet kierr,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "ellers faar hand meg rett aldrig merre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 6,
      "text": "Thennd smaa-drenng sprang till ganger graa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "hand red bratt till her Lauis gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 6,
      "text": "saa gick hand ind for denn herre at staa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 7,
      "text": "Thennd smaa-dreng ind att dørren thrend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "her Lauy reker hanom haanden igenn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 7,
      "text": "\"Du wer well-komen, du lidenn smaa-dreng.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 8,
      "text": "\"Her sedder y, her Lauy, offuer eders bord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 8,
      "text": "myn iumfru haffuer send eder buod och ord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 8,
      "text": "y skall y afftten till hynder kome.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 9,
      "text": "I skall y afftten huosz hynd werre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 9,
      "text": "om y haffuer hynder y hiartett kier,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 9,
      "text": "helder thett y faar hynder aldrig merre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 10,
      "text": "Her Lauy skødt thett brede bordtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 10,
      "text": "thend brune mød paa guolden stuo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 10,
      "text": "\"I dansk hoffmend, skønder eder paa guold.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 11,
      "text": "I raske heellind, skønder eder till hest!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 11,
      "text": "y afftten well wy her Ribboltt geeste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 11,
      "text": "thaalde med thend iumfru, ieg vnder best.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 12,
      "text": "Hand red op y her Ribboltts gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 12,
      "text": "vd stuod stalt Sedsellild, war suøbtt y mord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 12,
      "text": "\"Stalt Sedsellild, well y nu følge meg aff gard?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 13,
      "text": "Hun ragtte hanom haand, hun gaff hanom thro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 13,
      "text": "hun wilde med hanom buod biuge och buo;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 13,
      "text": "saa løffte hand hinder paa ganger graa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 14,
      "text": "Hand sluo offuer hynder kobenn best,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 14,
      "text": "hand løfftte hynder paa synn hygge hest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 14,
      "text": "hun glembtte att syge synn fader guod natt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 15,
      "text": "Hand red frem for Lunde-by,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 15,
      "text": "ther haltt her Thimand y bryne ny,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 15,
      "text": "och hand thuorde huerkenn halde eller fly.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 16,
      "text": "Her Lauy thaaller till her Tymand saa bratt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 16,
      "text": "\"Her Thi-mand, thu haffue saa mange guod-natt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 16,
      "text": "stalltt Sedsellild haffuer thig altt for-giett.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 17,
      "text": "Stallt Sedsellild haffuer loffuet meg throuen før-ind deg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 17,
      "text": "ther-for skall hun nu følge meg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 17,
      "text": "rett aldrig well hun haffue deg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 18,
      "text": "Hun følger meg till mynn egenn gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 18,
      "text": "ther skall hun slide buode sabbell och muor;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 18,
      "text": "her Thimand, du hind aldrig faarr!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 19,
      "text": "Nu gaar stalltt Sedsellild y her Laues gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 19,
      "text": "hun slider rød skaarlagen, hun drager muordt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 19,
      "text": "her Thimand hand daglig sorig ber.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 20,
      "text": "Hun slider skaarlagenn med guld och perler,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 20,
      "text": ":: i skuoffuen ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 20,
      "text": "her Lauy vnder hynder aff hiartet well,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 20,
      "text": "her Thimand hand sørgett seg selliff ihiell",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 20,
      "text": ":: Selleff gangis hun hanom ey aff. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}