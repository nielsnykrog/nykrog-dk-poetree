{
  "id": null,
  "title": "102. Valdemar, Sankt Knud hertugs søn",
  "year_created": 1495,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Rimkrøniken",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1495,
    "url": "https://tekstnet.dk/books/anon_rimkroeniken/105/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Thet ær wel sænth i lesthen staar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "ath hwilket rigæ wsamæ faar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "tha skal thet legges ødhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "tha Danmark fik oss kongæ tree;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "thet kunne ey mynner fødhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Wij hade sammen stor orloff oc kijff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Thet galt førsth Knudh oc saa Swendz lijff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Men syden ther the wore slaffne ihiell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "ieg ene regerede Danmark wel;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "och kom mith paa thet tørræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Ieg hade saa megeth nabo hadh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Ieg kunde meg ey forswaræ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "før ieg fik giort mellom oss en gaar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Han stor ther wel i twsende aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "om han bliffuer taghen tijl waræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Bisp Absolon halp ther fast till,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "som wor i Lunde kyrkæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "Ther wor ey før wthen kast en wold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "men wi sættæ ther en mwr wel bold;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "M half annit hundrede paa thet viij aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "effther ath Gutz søn fødher waar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "tha bleff then mwr alth redhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "Try aar thereffther meth gudelig hoff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "then kærliched han henne tedhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "Siden for ieg ind wthi Ryland",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "och alt thet folk ieg offuer wand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "ieg lod them cristnæ och døbe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "m hundrede paa thet halfierdesynne tiwe aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "ther wedh tha kan thet løbe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": "Thet samme aar giorde ieg Siælantz low,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "hwor the skullæ skifftæ mark oc skow",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "Tha bleff oc myn fadher paa alter reysth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "oc Knud, myn søn, tijl konning keysth;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": "then glædæ lodh Gudh meg sømæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 7,
      "text": "Meth herræskiold ieg oc offuer wand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "ther hedhen fik ieg goth wedher.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 7,
      "text": "I Tydeskæland wand ieg oc Damyn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": "Camyn, Walgasth oc Stettyn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 7,
      "text": "meth andre sloth oc stedher.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 8,
      "text": "han sændæ meg budh ieg tijl hannum kom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 8,
      "text": "i Lybeckæ stadh wi ther møthes.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 8,
      "text": "Ieg gaff hans søn ther dotther myn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 8,
      "text": "och han gaff meg allæ landenæ syn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 9,
      "text": "Han gaff meg ther bewysning oppaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 9,
      "text": "och Innocencius pawæ stadfestning aa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 9,
      "text": "meth buller aff gwldh thet klaræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 9,
      "text": "tijl ewigth widhnæsbyrd oc teghen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 9,
      "text": "skullæ danskæ konning swaræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 10,
      "text": "M c fyresynne tiwe paa thet førstæ aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 10,
      "text": "effther at Gutz søn fødher waar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 10,
      "text": "tha giordes thenne contracten.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 10,
      "text": "tha kom helsoth oc worde myn gesth;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 10,
      "text": "han tog fra meg allæ macthen.",
      "part": false,
      "marginal_notes": []
    }
  ]
}