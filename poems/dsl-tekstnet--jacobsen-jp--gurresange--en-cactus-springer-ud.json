{
  "id": null,
  "title": "Gurresange",
  "year_created": 1886,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Jens Peter Jacobsen",
    "country": null,
    "wiki": "Q370246"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "En Cactus Springer Ud",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1886,
    "url": "https://tekstnet.dk/books/jacobsen-jp_en-cactus-springer-ud/006/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Den blaalige Dæmring nu dæmper",
      "part": false,
      "marginal_notes": [
        "Speaker: Valdemar"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Hver Tone fra Sø og Land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "De flyvende Skyer har lagt sig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Til Hvile ved Himlens Rand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "I lydløs Tynge samlet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Er Skovens luftige Bo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Og Søens klare Bølger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Har vugget sig selv til Ro.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "I Vesten kaster Solen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Sin straalende Purpurdragt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Saa drager den over sig Bølgen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Og drømmer om Dagens Pragt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Ej mindste Løv sig rører",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Og kalder paa min Sands,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Ej mindste Tone klinger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Og vugger mit Sind i Dands,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Nej, hver en Magt er sunken",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "I egne Drømmes Elv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Og skyder mig blidt og stille",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "Tilbage til mig selv.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "O, naar Maanens Straaler milde spille,",
      "part": false,
      "marginal_notes": [
        "Speaker: TOVE"
      ]
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "Naar omkring mig Alt er tyst og stille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "Da er Vand mig ikke Søens Vove,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "Træer ej de dunkle, tavse Skove,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 1,
      "text": "Sky ej, hvad mig Himlens Hvælving dølger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 1,
      "text": "Dal og Bakke ikke Jordens Bølger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 1,
      "text": "Form ej Form og Farven ikke Farve,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 1,
      "text": "Alt: et Udtryk for hvad Gud har drømt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Ganger, staar du nu og drømmer!",
      "part": false,
      "marginal_notes": [
        "Speaker: VALDEMAR"
      ]
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "Nej, jeg ser det, Vejen strømmer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "Hurtig bort dig under Hoven.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "Stærkere dog frem du sprænge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "Du er endnu midt i Skoven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 2,
      "text": "Medens jeg dig ventet længe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 2,
      "text": "Har ved Gurre Borgeled.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 2,
      "text": "Skoven slipper, alt jeg øjner Tovelilles fagre Bur,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 2,
      "text": "Skovens Træer bag os glide sammen til en dunkel Mur;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 2,
      "text": "Men end vildere du jage!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 2,
      "text": "Ser du Skyens Skygge trække",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 2,
      "text": "Over Mark og Mose frem?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 2,
      "text": "Før den Gurres Grund kan række,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 2,
      "text": "Maa vi staa ved Toves Hjem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 2,
      "text": "Før den Tone, som nu klinger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 2,
      "text": "Gaar for Evighed til Ro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 2,
      "text": "Maa dit rappe Hovslag ryste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 2,
      "text": "Gurre-Borgens lille Bro;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 2,
      "text": "Før det Blad, der falder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 2,
      "text": "Bækkens Bølger naar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 2,
      "text": "Maa din Vrinsken gjalde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 2,
      "text": "Lydt i Gurregaard.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 2,
      "text": "Skygge kom og Tone dø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 2,
      "text": "Dyk dig Blad i Vove,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 2,
      "text": "Volmer ser sin Tove!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 3,
      "text": "Stjerner juble, Søen lyser,",
      "part": false,
      "marginal_notes": [
        "Speaker: TOVE"
      ]
    },
    {
      "id": 54,
      "stanza_id": 3,
      "text": "Trykker sit bankende Hjerte mod Kyst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 3,
      "text": "Løvet nynner, Duggen dandser,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 3,
      "text": "Vinden sig kaster saa kaad til mit Bryst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 3,
      "text": "Vejrhanen synger og Taarnene nikke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 3,
      "text": "Svendene spanke med flammende Blikke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 3,
      "text": "Ternerne dæmpe med Haanden forgjeves",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 3,
      "text": "Barmen, der sælsomt uroligen hæves.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 3,
      "text": "Roserne stirre med Haand over Bryn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 3,
      "text": "Faklerne hjelpe det daarlige Syn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 3,
      "text": "Skoven nu aabner sit Ly,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 3,
      "text": "Hundene glamme i By,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 3,
      "text": "Stien, i stedse nærmere Bølger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 3,
      "text": "Vugger den dristige Rytter mod Havn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 3,
      "text": "Og i den næste Stigning, som følger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 3,
      "text": "Slynger den ham i min aabnede Favn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 4,
      "text": "Ej dandse de Engle for Herren saa herligt,",
      "part": false,
      "marginal_notes": [
        "Speaker: VALDEMAR"
      ]
    },
    {
      "id": 70,
      "stanza_id": 4,
      "text": "Som Verden nu dandser for mig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 4,
      "text": "Ej juble for ham de mer ydmygt og kjerligt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 4,
      "text": "End Valdemars Hjerte for dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 4,
      "text": "Men stoltere satte ej heller sig Krist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 4,
      "text": "Hos Herren, og lo ad sin Kvide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 4,
      "text": "End Valdemar, glemmende Kummer og Tvist,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 4,
      "text": "Sig sætter ved Tovelils Side.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 5,
      "text": "Ej længes de Sjæle for Himmerigs Mure",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 5,
      "text": "Mer efter at svinge sig ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 5,
      "text": "End Valdemar, da han fra Øresunds Kure",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 5,
      "text": "Saa Gurres guldglimtende Tind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 5,
      "text": "Og ej vil jeg bytte dets fredsæle Vang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 5,
      "text": "Og Perlen den lønligen varer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 5,
      "text": "For Himmerigs Glands og bedøvende Klang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 5,
      "text": "Og alle de Helliges Skarer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 6,
      "text": "Nu siger jeg dig for første Gang:",
      "part": false,
      "marginal_notes": [
        "Speaker: TOVE"
      ]
    },
    {
      "id": 86,
      "stanza_id": 6,
      "text": "\"Kong Volmer, jeg elsker dig.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 6,
      "text": "Nu kysser jeg dig for første Gang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 6,
      "text": "Og slynger min Arm om dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 6,
      "text": "Og siger du, at jeg det før har sagt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 6,
      "text": "Og at du til Kysset er vant,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 6,
      "text": "Saa siger jeg: \"Kongen han er en Nar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 6,
      "text": "Der mindes forfængelig Tant.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 6,
      "text": "Og siger du, saa er jeg selv slig Nar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 6,
      "text": "Saa siger jeg: \"Kongen har Ret,\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 6,
      "text": "Men siger du, at jeg det ikke er,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 6,
      "text": "Saa siger jeg: \"Kongen er slet.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 6,
      "text": "For alle mine Roser har jeg kysset ihjel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 6,
      "text": "Alt mens jeg tænkte paa dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 7,
      "text": "Det er Midnattens Stund,",
      "part": false,
      "marginal_notes": [
        "Speaker: VALDEMAR"
      ]
    },
    {
      "id": 100,
      "stanza_id": 7,
      "text": "Og usalige Slægter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 7,
      "text": "Staa frem af glemte, sunkne Grave,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 7,
      "text": "Og de stirre med Længsel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 7,
      "text": "Paa Borgens Kjerter og Hyttens Lys,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 7,
      "text": "Og Vinden ned over dem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 7,
      "text": "Spottende ryster",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 7,
      "text": "Harpeslæt og Bægerklang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 7,
      "text": "Og Elskovssange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 7,
      "text": "Og svindende de sukke:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 7,
      "text": "\"Vor Tid er forbi!\" -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 7,
      "text": "Mit Hoved vugges paa levende Bølger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 7,
      "text": "Min Haand fornemmer et Hjertes Slag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 7,
      "text": "Ned over mig livssvulmende strømmer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 7,
      "text": "Kyssets glødende Purpurregn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 7,
      "text": "Og min Læbe jubler:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 7,
      "text": "\"Det er min Tid nu!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 7,
      "text": "Men Tiden flygter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 7,
      "text": "Og jeg skal færdes",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 7,
      "text": "Ved Midnatstide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 7,
      "text": "En Gang som død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 7,
      "text": "Skal samle Ligdragten om mig tæt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 7,
      "text": "Mod de kolde Vinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 7,
      "text": "Og liste mig frem ved sildig Maane,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 7,
      "text": "Og smertebunden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 7,
      "text": "I Muldet riste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 7,
      "text": "Med sorte Gravkors",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 7,
      "text": "Dit kjære Navn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 7,
      "text": "Og synkende sukke:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 7,
      "text": "\"Vor Tid er forbi!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 8,
      "text": "Du sender mig et Elskovsblik",
      "part": false,
      "marginal_notes": [
        "Speaker: TOVE"
      ]
    },
    {
      "id": 130,
      "stanza_id": 8,
      "text": "Og sænker saa Øjet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 8,
      "text": "Dog Blikket trykker din Haand i min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 8,
      "text": "Og Trykket dør;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 8,
      "text": "Men som et elskovsvækkende Kys",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 8,
      "text": "Du lægger mit Haandtryk paa min Læbe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 8,
      "text": "Og du har for Døden et Suk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 8,
      "text": "Naar et Blik kan opstaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 8,
      "text": "Som et flammende Kys!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 8,
      "text": "De lysende Stjerner paa Himlen hist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 8,
      "text": "Vel blegne hver Gry,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 8,
      "text": "Men blusse dog hver en Midnatsstund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 8,
      "text": "I evig Pragt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 8,
      "text": "- Saa kort er Døden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 8,
      "text": "Som rolig Slummer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 8,
      "text": "Fra Kveld til Gry,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 8,
      "text": "Og naar du vaagner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 8,
      "text": "Hos dig paa Lejet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 8,
      "text": "I nyfødt Skjønhed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 8,
      "text": "Du straale ser",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 8,
      "text": "Din unge Brud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 8,
      "text": "Saa lad os da tømme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 8,
      "text": "Den gyldne Skaal",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 8,
      "text": "For den mægtigt forskjønnende Død;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 8,
      "text": "Thi vi gange til Grav",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 8,
      "text": "Som et Smil, der dør",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 8,
      "text": "For et saligt Kys.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 9,
      "text": "Vidunderlige Tove!",
      "part": false,
      "marginal_notes": [
        "Speaker: VALDEMAR"
      ]
    },
    {
      "id": 157,
      "stanza_id": 9,
      "text": "Saa rig ved dig er jeg nu,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 9,
      "text": "At end ej et Ønske jeg ejer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 9,
      "text": "Mit Bryst er saa let,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 9,
      "text": "Min Tanke saa klar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 9,
      "text": "En vaagen Fred er over min Sjæl.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 9,
      "text": "Der er saa stille i mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 9,
      "text": "Saa sælsomt stille.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 9,
      "text": "Læben vil bygge paa Ordets Bro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 9,
      "text": "Men synker igjen til Hvile;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 9,
      "text": "Thi det er mig som banked mit Bryst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 9,
      "text": "Ved dit Hjertes Slag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 9,
      "text": "Og som mit Aandedrag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 9,
      "text": "Hæved, Tove, din Barm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 9,
      "text": "Og jeg ser vore Tanker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 9,
      "text": "Fødes og glide sammen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 9,
      "text": "Som Skyer, der mødes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 9,
      "text": "Og samlede vugges de i vekslende Former.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 9,
      "text": "Og min Sjæl er stille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 9,
      "text": "Jeg ser i dit Øje og tier.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 9,
      "text": "Vidunderlige Tove!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 11,
      "text": "Herre, ved du, hvad du gjorde,",
      "part": false,
      "marginal_notes": [
        "Speaker: VALDEMAR"
      ]
    },
    {
      "id": 178,
      "stanza_id": 11,
      "text": "Da du Tove fra mig tog?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 11,
      "text": "Ved du, at det var mit sidste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 11,
      "text": "Fristed, hvorfra du mig jog?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 11,
      "text": "Herre, rødmer du ej af Skam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 11,
      "text": "Det var den Fattiges eneste Lam!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 12,
      "text": "Herre, jeg er ogsaa Hersker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 12,
      "text": "Jeg har lært paa Kongestol,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 12,
      "text": "Man fra sine Undersaatter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 12,
      "text": "Ta'r ej sidste Glimt af Sol.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 12,
      "text": "Herre, du er paa vilse Vej,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 12,
      "text": "Saadan vel knuser, men hersker man ej!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 13,
      "text": "Herre, dine Englehære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 13,
      "text": "Fylde Øret dig med Lov,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 13,
      "text": "Ingen Ven du har, der dadler,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 13,
      "text": "Naar du Dadel har Behov.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 13,
      "text": "Ak, og Ingen er altid klar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 13,
      "text": "Herre, lad mig derfor være din Nar!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 14,
      "text": "Vaagner, alle Kong Volmers Mænd!",
      "part": false,
      "marginal_notes": [
        "Speaker: VALDEMAR"
      ]
    },
    {
      "id": 196,
      "stanza_id": 14,
      "text": "Spænder rustede Sværd ved Lænd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 14,
      "text": "Henter i Kirker det støvede Skjold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 14,
      "text": "Prydet med Mærker af Dyr og af Trold.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 14,
      "text": "Væk Eders Heste, der græsse i Muld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 14,
      "text": "Sæt dem I Siden de Kringler af Guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 14,
      "text": "Sprænger mod Gurreby,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 14,
      "text": "Det er Dødningegry!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 15,
      "text": "Klap, klap med Kistelaag,",
      "part": false,
      "marginal_notes": [
        "Speaker: BONDENS SANG"
      ]
    },
    {
      "id": 204,
      "stanza_id": 15,
      "text": "Tunge Trin af Nattetog;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 15,
      "text": "Græstørv skyder af Muld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 15,
      "text": "Toften klinger af Guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 15,
      "text": "Klirren og Klappen i Vaabenhus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 15,
      "text": "Hvisten og Kasten med gammelt Grus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 15,
      "text": "Stenene ramle i Kirkegaardsdige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 15,
      "text": "Høgene suse fra Taarnet og skrige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 15,
      "text": "Kirkeporten slaar op og i, -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 15,
      "text": "Ned under Dynen, der for de forbi.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 15,
      "text": "- Jeg slaar tre hellige Herrens Kors",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 15,
      "text": "For Folk og Hus, for Ko og Hors,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 15,
      "text": "Tre Gange nævner jeg Frelserens Navne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 15,
      "text": "Saa skade de ikke min Sæd for en Avne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 15,
      "text": "Saa tegner jeg mig paa Ledemod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 15,
      "text": "Hvor Herrens hellige Vunder stod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 15,
      "text": "Da bliver for Elverskud jeg fri,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 15,
      "text": "For Mareridt og for Troldespi;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 15,
      "text": "Sidst lægger for Døren jeg Staal og Sten,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 15,
      "text": "Da voldes slet Ingen i Huset Men.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 16,
      "text": "Vær hilset, Konge, ved Gurre Sø!",
      "part": false,
      "marginal_notes": [
        "Speaker: VALDEMARS MÆND"
      ]
    },
    {
      "id": 224,
      "stanza_id": 16,
      "text": "Nu spænde Jagten vi over Ø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 16,
      "text": "Vi Pile sende fra strengløs Bue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 16,
      "text": "Med Øjne sigte, som ej kan skue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 16,
      "text": "Vi Hjortens Skygge med Vunder slaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 16,
      "text": "Og Engvand siver som Blod af Saar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 16,
      "text": "Hør Valravn svinge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 16,
      "text": "Med sorten Vinge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 16,
      "text": "Og Løvet skumme om Hestens Bringe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 16,
      "text": "Saa skal vi jage, har Somme sagt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 233,
      "stanza_id": 16,
      "text": "Hver Nat til Dommedags vilde Jagt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 234,
      "stanza_id": 16,
      "text": "Holla, Hest, og Holla, Hund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 235,
      "stanza_id": 16,
      "text": "Standser Jagten stakket Stund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 236,
      "stanza_id": 16,
      "text": "Her er Slottet, som fordum var;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 237,
      "stanza_id": 16,
      "text": "Hest skal fodres med Lokes Havre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 238,
      "stanza_id": 16,
      "text": "Mand kan æde sit Ry til Davre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 239,
      "stanza_id": 17,
      "text": "Skoven hvidsker med Toves Røst,",
      "part": false,
      "marginal_notes": [
        "Speaker: VALDEMAR"
      ]
    },
    {
      "id": 240,
      "stanza_id": 17,
      "text": "Søen skuer med Toves Øje,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 241,
      "stanza_id": 17,
      "text": "Stjerner lyse med Toves Smil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 242,
      "stanza_id": 17,
      "text": "Skyen svulmer som Barmens Høje.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 243,
      "stanza_id": 17,
      "text": "Sandserne jage for hende at fatte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 244,
      "stanza_id": 17,
      "text": "Tankerne kjerape for hende at samle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 245,
      "stanza_id": 17,
      "text": "Men Tove er hist og Tove er her,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 246,
      "stanza_id": 17,
      "text": "Tove er fjern og Tove er nær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 247,
      "stanza_id": 17,
      "text": "Er du da, Tove, med Trolddomsmagt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 248,
      "stanza_id": 17,
      "text": "Bundet i Søens og Skovens Pragt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 249,
      "stanza_id": 17,
      "text": "Hjertet svulmer, som skulde det sprænges,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 250,
      "stanza_id": 17,
      "text": "Tove, Tove, Valdemar længes!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 251,
      "stanza_id": 18,
      "text": "\"Aalen hun er en sælsom Fugl,",
      "part": false,
      "marginal_notes": [
        "Speaker: CLAUS NAR"
      ]
    },
    {
      "id": 252,
      "stanza_id": 18,
      "text": "Lever som helst i Vandet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 253,
      "stanza_id": 18,
      "text": "Vrider sig dog i Maaneskin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 254,
      "stanza_id": 18,
      "text": "Ofte en Stund paa Landet.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 255,
      "stanza_id": 18,
      "text": "Det har jeg sunget om Andre en Gang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 256,
      "stanza_id": 18,
      "text": "Bedst passer nu paa mig selv min Sang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 257,
      "stanza_id": 18,
      "text": "Jeg er ikkun Husmand nu og mit Hus er lille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 258,
      "stanza_id": 18,
      "text": "Og skjøndt ej jeg bad en Gjest, leved ganske stille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 259,
      "stanza_id": 18,
      "text": "Blev jeg halvvejs dog ædt ud af mit Hus det lille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 260,
      "stanza_id": 18,
      "text": "Saa jeg kan ej byde Stort, skjøndt jeg gjerne vilde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 261,
      "stanza_id": 18,
      "text": "Dog – den skal faa min Nattero,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 262,
      "stanza_id": 18,
      "text": "Som kan mig det forklare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 263,
      "stanza_id": 18,
      "text": "Hvorfor jeg skal hver Midienat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 264,
      "stanza_id": 18,
      "text": "Omkring et Vandhul fare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 265,
      "stanza_id": 18,
      "text": "At Palle Glob og Erik Paa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 266,
      "stanza_id": 18,
      "text": "Det skulle, kan jeg godt forstaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 267,
      "stanza_id": 18,
      "text": "De var saa lidet fromme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 268,
      "stanza_id": 18,
      "text": "De doble nu, endskjøndt til Hest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 269,
      "stanza_id": 18,
      "text": "Om svalest Sted og Døren næst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 270,
      "stanza_id": 18,
      "text": "Naar de til Helved komme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 271,
      "stanza_id": 18,
      "text": "Og Kongen, han som løber gal ved mørke Nattetide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 272,
      "stanza_id": 18,
      "text": "Og raaber paa en Pige, som for Aar og Dage siden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 273,
      "stanza_id": 18,
      "text": "Med Engle og med Vildgjæs fløj, han maa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 274,
      "stanza_id": 18,
      "text": "med Rette ride;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 275,
      "stanza_id": 18,
      "text": "Thi han var altfor raa oprigtig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 276,
      "stanza_id": 18,
      "text": "Og man maa være højst forsigtig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 277,
      "stanza_id": 18,
      "text": "Og tage mægtigt sig i Agt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 278,
      "stanza_id": 18,
      "text": "Naar man er Nar hos slig en Magt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 279,
      "stanza_id": 18,
      "text": "Som ham, der bor hinsides Maanen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 280,
      "stanza_id": 18,
      "text": "Men at jeg, Claus Nar til Farum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 281,
      "stanza_id": 18,
      "text": "Jeg, som trode, at de Døde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 282,
      "stanza_id": 18,
      "text": "Vare fri for Legemsmøde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 283,
      "stanza_id": 18,
      "text": "At Ens Støv blev Aandens Anker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 284,
      "stanza_id": 18,
      "text": "Saa i Fred man sine Tanker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 285,
      "stanza_id": 18,
      "text": "Kunde samle til den store",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 286,
      "stanza_id": 18,
      "text": "Hoffest, som Bro'r Knud har sagt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 287,
      "stanza_id": 18,
      "text": "Blæses ind med Guldbasuner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 288,
      "stanza_id": 18,
      "text": "Hvor vi Gode vel ved Magt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 289,
      "stanza_id": 18,
      "text": "Æde Onde som Kapuner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 290,
      "stanza_id": 18,
      "text": "Ak, at jeg paa en Fole galen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 291,
      "stanza_id": 18,
      "text": "Med min Næse vendt imod Halen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 292,
      "stanza_id": 18,
      "text": "Skal humpe om, mens Folk er i Senge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 293,
      "stanza_id": 18,
      "text": "Var ej det for sent, jeg vilde mig hænge. -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 294,
      "stanza_id": 18,
      "text": "O, men hvor sødt det skal smage forvist,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 295,
      "stanza_id": 18,
      "text": "Naar jeg nu dog bliver salig tilsidst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 296,
      "stanza_id": 18,
      "text": "Vel har jeg syndet lidt mer end de Fleste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 297,
      "stanza_id": 18,
      "text": "Kan dog vel snakke mig fra det Meste:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 298,
      "stanza_id": 18,
      "text": "Hvem gav den nøgne Sandhed Klæder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 299,
      "stanza_id": 18,
      "text": "Og tog dens Prygl paa Vej og Stræder?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 300,
      "stanza_id": 18,
      "text": "Jo – ifald der er Billighed til,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 301,
      "stanza_id": 18,
      "text": "Saa maa jeg bænkes i Himmerigs Sale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 302,
      "stanza_id": 18,
      "text": "Naa, hvor jeg der skal Verten bagtale!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 303,
      "stanza_id": 19,
      "text": "Nu ler du deroppe,",
      "part": false,
      "marginal_notes": [
        "Speaker: VALDEMAR"
      ]
    },
    {
      "id": 304,
      "stanza_id": 19,
      "text": "Du strenge Dommer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 305,
      "stanza_id": 19,
      "text": "Men dette drage du dig til Minde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 306,
      "stanza_id": 19,
      "text": "Naar Dommedag kommer:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 307,
      "stanza_id": 19,
      "text": "En Sjæl er elskende Mand og Kvinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 308,
      "stanza_id": 19,
      "text": "Du rive ikke vor Sjæl i tvende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 309,
      "stanza_id": 19,
      "text": "Til Helved mig og til Himlen hende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 310,
      "stanza_id": 19,
      "text": "Thi da faar jeg Magt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 311,
      "stanza_id": 19,
      "text": "Da splitter jeg din Englevagt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 312,
      "stanza_id": 19,
      "text": "Og sprænger med min vilde Jagt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 313,
      "stanza_id": 19,
      "text": "I Himmerige Ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 314,
      "stanza_id": 20,
      "text": "Hanen løfter sit Hoved til Gal,",
      "part": false,
      "marginal_notes": [
        "Speaker: VALDEMARS MÆND"
      ]
    },
    {
      "id": 315,
      "stanza_id": 20,
      "text": "Har alt Dag i Kroppen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 316,
      "stanza_id": 20,
      "text": "Og Morgenduggen driver rød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 317,
      "stanza_id": 20,
      "text": "Af Rust, fra vore Sværd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 318,
      "stanza_id": 20,
      "text": "Omme er Tiden!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 319,
      "stanza_id": 20,
      "text": "Graven kalder med aaben Mund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 320,
      "stanza_id": 20,
      "text": "Og Jorden suger al lyssky Rædsel.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 321,
      "stanza_id": 20,
      "text": "Synker, synker!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 322,
      "stanza_id": 20,
      "text": "Livet kommer i Magt og Glands",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 323,
      "stanza_id": 20,
      "text": "Med Daad og bankende Hjerter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 324,
      "stanza_id": 20,
      "text": "Og vi er Dødens,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 325,
      "stanza_id": 20,
      "text": "Sorgens og Dødens,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 326,
      "stanza_id": 20,
      "text": "Smertens og Dødens.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 327,
      "stanza_id": 20,
      "text": "Tilgravs! tilgravs! til drømmesvanger Ro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 328,
      "stanza_id": 20,
      "text": "O, fik i Fred vi hvile!",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
