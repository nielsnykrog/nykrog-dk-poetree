  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Jeg kan ej sidde lig en heldig Fisker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Tryg i et Hjem og frydes ved min Skat;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Thi Perlen, som alt funkled' for mit Øje,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "En Andens lykkelige Haand fik fat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Men han, der fik den kan ej ret den skatte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Han ser dens Glands og frydes ved dens Værd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Han lader den i alskens Lysning spille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Dog aldrig saa han end dens bedste Skjær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Og kunde han sin Perle skue funkle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "En Gang ved mine Øjnes stærke Skjær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Han vilde sin i den ej mere kjende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "For ham den mistet havde da sit Værd",
      "part": false,
      "marginal_notes": []
    }
  ]
}
