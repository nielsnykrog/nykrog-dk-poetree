  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Et Foraar. Digte, Ældre Og Nyere",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1858,
    "url": "https://tekstnet.dk/books/kaalund-hv_et-foraar/016/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Naar Aftnen breder om Jorden sit Slør,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "da ligge i Vesten de dejligste Øer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "fra skinnende Sletter, hvor Alferne bo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "hensuser om Jorden den himmelske Ro.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Og Menneskesjælen sig stirrer fast blind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "med Længsel i Paradisdalene ind;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "den drømmer at sé paa den rødmende Sky",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "bag gyldene Bjerge Serafernes By.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Som Barn, naar jeg leged i Dæmringen før,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "jeg skued med Undren de straalende Øer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "da tænkte jeg: naar jeg engang bliver stor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "til dem vil jeg gaa om den vidtstrakte Jord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Ja dem vil jeg søge bag Bjerg og bag Hav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "med Randsel paa Ryggen og Pilegrimsstav;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "naar rigtigt jeg søger, jeg finder dem vist,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "og bygge hos mig skal de Elskede hist.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Ak, nu er jeg voxen! - Arabiens Hest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "saa rap og saa vild som den susende Blæst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "med Sporer i Siden og flagrende Man",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "mig bringer ej til det forjettede Land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "Og gik jeg om Jordkloden mødig min Vej",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "over svimlende Bjerge, jeg naaede det ej,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "hvad enten jeg jager mod Vest eller Øst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "med higende Savn i mit Menneskebryst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "Ak, Elskte, jeg er ej uskyldig som før!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "I Taage forsvinde de himmelske Øer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "og var selv et Eden den rødmende Sky,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "hvad skulde jeg Daare i Englenes By!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
