{
  "id": null,
  "title": "Af Stambogs-Blade i Efternævntes Stambøger",
  "year_created": 1855,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Af. Samlede Skrifter. Sextende Bind",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1855,
    "url": "https://tekstnet.dk/books/andersen-hc_af-samlede-skrifter-sextende-bind/005/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Du gav Sylphiden smukke Tonevinger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Og Saras Sorg Du lagde Ynde i.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Kun modigt fremad – Hydra Du betvinger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Ved det hun just forfølge vil, – Geni!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Som vildsom Fugl Du flere Gange fløi",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Bort fra dit Hjem, fra vore grønne Øer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Og Blæsten peb og Skramlet gjorde Støi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Det ferske Hverdags-Liv har slemme Søer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Nu flyver Du igjen, men mere stærk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Vi kjende dit Talent, som Du det kjender.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Du viste Villie – og vi see dit Værk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Et Glædes-Blus her det i Øiet brænder;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Godt er dit Hjerte, Du har Ungdoms Hu,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Hvo svinger Glædens Tryllestav som Du.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Du førte os til Byrons Guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Der kom en Glands fra Steenkuls-Øen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Og af hvad selv din Sjæl er fuld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Vi fik et Skjær i Øie-Søen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Lad Hjertet være Skjaldens Fyr,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Flyv over hver en Sky og Skygge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "See Livet, som et Eventyr",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Der kun opruller Lykke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "Du Kjærlige, Du Milde, med et Hjerte som Faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Bramfri, som altid den sande Aand man saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Beskeden og saa rig dog paa Digtekunstens Skatte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "– I disse fattige Ord, dit Billede jeg satte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 4,
      "text": "Din Sjæl er blød og gjennemsigtig selv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 4,
      "text": "Som Vandet er det i den svenske Elv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Hver Stjerne speiler sig i den til Grunden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "Og naar et Smiil Dig bæver mildt om Munden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "Til Dig betroer sig gjerne da hver Een.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "– Gud gav en Digter Dig, som Ædelsteen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 5,
      "text": "Da Skotlands Skjalde i Bjergene sang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 5,
      "text": "Skotlands Tidsel som Rose udsprang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 6,
      "text": "Hvem Gud har kjær gav han Geniets Flamme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 6,
      "text": "I tusind Farver kvæger det vort Syn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 6,
      "text": "Men ham, som fik det, bittre Smerter ramme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 6,
      "text": "Han halvfortæres af sit Guddoms Lyn;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 6,
      "text": "Tidt gaaer han ene – lyser, som en Kjerte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 6,
      "text": "Og lysende fortæres han som den,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 6,
      "text": "Men elsker Gud ham, vil et trofast Hjerte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 6,
      "text": "Sig slutte til ham, kalde ham sin Ven.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "En Skytsaand følger ham, en ædel Qvinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "Hun styrker ham paa Stridens tunge Dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "Hans Sorg hun lukker i sit Hjerte inde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 6,
      "text": "Og mere kraftigt er hans Vingeslag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 6,
      "text": "Du er en saadan Skytsaand god og stærk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 6,
      "text": "Hans Navn, hans Lykke, blev dit Hjertes Værk.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 7,
      "text": "Fra Hindostan, – som Digterne jo sige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 7,
      "text": "Er Phantasiens Hjem og Alfers Rige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 7,
      "text": "Du kom, da Du var Barn, op til vort Norden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 7,
      "text": "Hvor vaade Taager svæve over Jorden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 7,
      "text": "Og Svanen vintrer paa den stride Elv.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 7,
      "text": "Dansk var din Slægt og nordisk er Du selv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 7,
      "text": "Alt Sagaen og Kjæmpevisen priste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 7,
      "text": "Hvad ubevidst Du os i Nutid viste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 7,
      "text": "At i det stille Liv tidt Blomsten groer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 7,
      "text": "Som Norden sjelden veed og sjelden troer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 8,
      "text": "Hvor Luther talte og hvor Goethe sang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 8,
      "text": "I Nabolandet gik din Vuggegænge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 8,
      "text": "Hvor Bølgen bruser høit om Dannevang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 8,
      "text": "Dig blomstre Livets Rose frisk og længe!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
