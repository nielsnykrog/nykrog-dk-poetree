  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "»Hvad vil Rigdom vel sige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Hvad er Glands og Herlighed!« –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Du nye Gaard, gid Lykke maa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Boe her som i den gamle;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "Nu er den »gamle Minder.« –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 3,
      "text": "»– en Krands af Bøgerødder og af danske Blomster« –",
      "part": false,
      "marginal_notes": []
    }
  ]
}
