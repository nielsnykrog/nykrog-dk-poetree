  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Alle Smaablomster, trip, trip, trip",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Hen til min Elskedes Kammer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Lok hende, drag hende, plag hende ud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Med Duft af Violer, Konvaller, Jasminen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Men faar hun nu ikke ved al den Duft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Længsel efter mig og den friske Luft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Gjør hende det saa kun rigtig broget,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Tal Blomstersproget.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
