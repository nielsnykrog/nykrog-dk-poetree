{
  "id": null,
  "title": "86. Nu JEsus til sin pine gaaer",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
    "wiki": "Q348003"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Troens Rare Klenodie",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1739,
    "url": "https://tekstnet.dk/books/brorson-ha_troens-rare-klenodie/088/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Nu JEsus til sin pine gaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Ham taarerne i øyne staaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Og strømme-viis nedrinder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "O! hvem der kunde græde blod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Ved denne klare livets flod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Paa JEsu rosen-kinder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Hvi græder du, som aldrig loe?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Hvi græder verdens lyst og roe?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Hvi græder himlens glæde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Hvorledes skal jeg finde dig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Immanuel, saa ynkelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Paa denne jord at græde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Var det, fordi du kunde see",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Din pinebenk, gethsemane,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Og dødens kalk iskienket;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Da satan og den store stad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Til dig at lave dødens bad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Var ret som sammenlænket.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Ney derfor græd min JEsus ey,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Hand traadde paa sin piinsels vey",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Med kæmpe-mod og længsel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "Hans død var beesk at tænke paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "Men større var hans lyst at faae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "Os frelst af evigt fængsel.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Men sagen var, fordi hand saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "De fleste skiønne intet paa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Hans bittre dødens vaade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Men leve hen foruden bod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Ja træde paa hans død og blod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "Og himmel-søde naade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "Dog tænke fast i deres sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "At de skal løbe lige ind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "I søde himmerige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 2,
      "text": "Den sag maa hiertet sprekke ved,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 2,
      "text": "Som JEsus og paa dette sted",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 2,
      "text": "Ey kand for graad udsige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "Hand saae, der blussed\" over dem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "Som boede i Jerusalem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "Guds grumme vredes lue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "Fordi de naadens lys forskiød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 3,
      "text": "Og torde med saa haard en død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 3,
      "text": "Saa kier en Frelser true,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 3,
      "text": "Hans egen pine har hand glemt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 3,
      "text": "Men over staden hierte-klemt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 3,
      "text": "I suk og graad udbryder:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 3,
      "text": "O arme stene-blinde stad!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 3,
      "text": "Jeg græder, men du leer kun ad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 3,
      "text": "Den naade, jeg dig byder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 4,
      "text": "Du, fordum hele verdens priis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 4,
      "text": "Guds egen stad og paradiis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 4,
      "text": "Hans residentz og sæde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 4,
      "text": "Din tempel i dig yndefuld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 4,
      "text": "Som demant spiller i sit guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 4,
      "text": "Var alle frommes glæde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 4,
      "text": "Jerusalem! hvor seer du ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 4,
      "text": "Er saadan deylig jomfru-bruud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 4,
      "text": "Nu til en hore bleven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 4,
      "text": "En synde-sølet skiden soe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 4,
      "text": "De sorte aanders myre-boe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 4,
      "text": "Til dødens dom opskreven?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 5,
      "text": "Ach! vilde du, endog i dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 5,
      "text": "Besinde ret din frelses sag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 5,
      "text": "Med bedrings graad og sukke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 5,
      "text": "Da skulde end min taare-regn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 5,
      "text": "Dig være vist et naade-tegn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 5,
      "text": "Til vredens ild at slukke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 5,
      "text": "Men satan har dig slet forrykt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 5,
      "text": "Du lever uden sands og frygt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 5,
      "text": "Og vil dig ey omvende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 5,
      "text": "At Gud maa føre over dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 5,
      "text": "En jammerfuld og græsselig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 5,
      "text": "Forstyrrelse og ende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 6,
      "text": "See dog, hvor det din søster gik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 6,
      "text": "Synd-sikre Christenhed, hun fik",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 6,
      "text": "Den deel du og skal finde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 6,
      "text": "Saa fremt du ey omvender dig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 6,
      "text": "Og søger naaden flittelig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 6,
      "text": "At bedrings graad kand rinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 6,
      "text": "At skiemte med vor HErres ord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 6,
      "text": "Betyder hunger, pest og mord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 6,
      "text": "Ja evig helved-klage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 6,
      "text": "Det staaer kun paa oprigtig bod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 6,
      "text": "Hvor den er, der er sagen god,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 6,
      "text": "Men ellers evig plage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 7,
      "text": "Om dig forkyndtes sverd og brand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 7,
      "text": "Ja HErrens vredes grumme band",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 7,
      "text": "Af alle Guds propheter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 7,
      "text": "Om jorden brændte under dig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 7,
      "text": "Og himlen spaade pest og kriig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 7,
      "text": "Med tusinde cometer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 7,
      "text": "Hvad var det dog at ligne mod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 7,
      "text": "At himlens Gud paa jorden stod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 7,
      "text": "Din ondskab at begræde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 7,
      "text": "Du dog kun frek til verden seer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 7,
      "text": "Og derved virkelig beleer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 7,
      "text": "Vor JEsu øyne-væde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 8,
      "text": "Saa græd, o sikre siel! engang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 8,
      "text": "Den tiid, den tiid er alt for lang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 8,
      "text": "Du levet har saa ilde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 8,
      "text": "Lad hiertet smelte bort i vand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 8,
      "text": "At bittre taarer flyde kand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 8,
      "text": "Af øyet som en kilde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 8,
      "text": "Da skal din JEsu øyne-taar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 8,
      "text": "Formilde hiertets dybe saar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 8,
      "text": "Og al din graad forsøde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 8,
      "text": "Da bliver glæden meer end stor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 8,
      "text": "I englernes udvaldte koor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 8,
      "text": "At du fra synden døde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 9,
      "text": "Thi græd hand for den fule stad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 9,
      "text": "Som satan selv i skiødet sad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 9,
      "text": "Den helved-drage-bolig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 9,
      "text": "Det folk, som slog ham selv ihiel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 9,
      "text": "Saa kand du tænke, kiere siel!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 9,
      "text": "Hand mener det saa trolig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 9,
      "text": "Hand løber dig med graad imod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 9,
      "text": "Her skal du staae, og holde fod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 9,
      "text": "Ey paa hans taarer træde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 9,
      "text": "Men følge JEsu øynes raad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 9,
      "text": "Hvor kandst du, naar du seer hans graad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 9,
      "text": "Dig bare for at græde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 10,
      "text": "Hand har dig som en stad belagt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 10,
      "text": "Med sine taarers vold og magt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 10,
      "text": "Du skal ham ey undvige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 10,
      "text": "Besee hans vaade rosen-kind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 10,
      "text": "O! see ham ret i øyne ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 10,
      "text": "Der blinker naadens rige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 10,
      "text": "Nu JEsu, kom med livets vand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 10,
      "text": "Som hiertet ene ledske kand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 10,
      "text": "Og al min jammer slukke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 10,
      "text": "Derefter tørster alt mit sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 10,
      "text": "Det suer jeg i sielen ind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 10,
      "text": "Med dybe længsels sukke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 11,
      "text": "Tak, JEsu! for hver draabe vand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 11,
      "text": "Som du i din fornedrings stand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 11,
      "text": "Min siel til trøst lod rinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 11,
      "text": "Jeg græder her og længes, til",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 11,
      "text": "Din kierlighed mig unde vil",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 11,
      "text": "I himlen dig at finde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 11,
      "text": "Naar skal jeg see de øyne paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 11,
      "text": "Som til min nød saa naadig saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 11,
      "text": "Som for mig vilde græde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 11,
      "text": "Som brast for mig i dødens vee?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 11,
      "text": "Naar skal jeg dog de øyne see",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 11,
      "text": "I evig fryd og glæde?",
      "part": false,
      "marginal_notes": []
    }
  ]
}
