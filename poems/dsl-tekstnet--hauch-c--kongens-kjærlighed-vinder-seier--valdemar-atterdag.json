{
  "id": null,
  "title": "Kongens Kjærlighed vinder Seier",
  "year_created": 1861,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Carsten Hauch",
    "country": null,
    "wiki": "Q688529"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Valdemar Atterdag",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1861,
    "url": "https://tekstnet.dk/books/hauch-c_valdemar-atterdag/018/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Om nu det var den Trolddom, der var i Ringen lagt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Eller det var Elskovs og Kjærligheds Magt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Der paa Tovelil virked, dog siges det for vist,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "At hun for Kongens Villie sig bøied tilsidst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Men efter den Time hun aldrig var fro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Og aldrig meer hun spøgte, og aldrig meer hun loe;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Kongen sig ængsted, han halv sin Daad fortrød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Han frygted, den skulde volde den Jomfru hendes Død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Han sendte hende Hermelin og Skarlagens Klæder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Og Perler og Klenodier og kostbare Kjæder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "De allerbedste Skatte fra Gullands rige Kyst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Dog fandt den æde Jomfru deri kun liden Trøst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Den hvideste Silke blev lagt for hendes Fod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Han smykked hendes Midie med Rubinernes Blod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Han smykked hendes Haller med Narhvalens Tand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Dog sukked end i Stilhed den favre Lilievand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Han sagde: »Tovelille, Du sørge dog ei saa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Alt, hvad Din Hu begjerer, det skal Du ogsaa faae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Alt, hvad jeg Dig har lovet, det opfyldes skal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Guldkronen skal Du bære i Dankongens Hal.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Hun svared: »Min Herre, det længe vare kan,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Og da maaskee Jer lokker en anden Lilievand.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Gjensvared Konning Volmer: »Nei, før jeg skifter Sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "Skal ved Jagthornets Klang Du standse vilden Vind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Paa det jeg Dig kan vise min Tillid og min Tro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Jeg vil en Skat Dig skjenke, der sikkrer Din Ro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "En Skat, der henter Kræfter fra Aandernes Rige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "Visselig Du paa Jorden ei finder dens Lige.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "Saa tog han af sin Finger den Ring stor og rund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Den glimted som Stjerner i Midnattens Stund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "Den skinned i Hallen med usædvanlig Glands,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "Sig Ædelstene fletted om Ringen i Krands.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "Han lagde den i Tovelilles sneehvide Haand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Han sagde: »Nu jeg bindes til Dig med slige Baand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "At selv om jeg det vilde, de aldrig briste kan,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "Med denne Ring jeg vier Dig til Dronning i mit Land.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "Derefter han fortalte, hvordan ved Stjerneskjær",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Han havde fulgt Fru Helvig bag Busk og bag Træer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "Hvordan han erhverved ved Hurtighed og Mod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "Den Skat, som ei Fru Helvig at gribe forstod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "Mæled end den Herre: »Havde mig Nogen sagt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "At slige sære Kræfter, at saadan Tryllemagt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "I natvandrende Stjerner og Stene kunde boe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "Jeg havde derom tvivlet, dog nu jeg maa det troe.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "Den Jomfru ham hørte med skjælvende Mod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Blussende saae hun Ringen, hun sagde: »Min Herre god,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "I har med den mig voldet stor Kummer og Spee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "Dog vil jeg den ei miste, mens jeg kan Lyset see.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "Den er som Ild at skue, og dog saa kold som Snee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "Jeg hænger den ved mit Hjerte, den skal ei Dagen see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "Med Tryllemagt, min Herre, I drog mig til Jer hen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "Saa maa jeg Jer vel binde paa samme Viis igjen.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 13,
      "text": "Svared med Smiil Kong Volmer: »Du stole frit paa mig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "Heel stærkt er det Baand, der binder mig til Dig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "Naar Ringen Du monne bære, da vil med sølvgraae Haar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "Saa høit af mig Du elskes, som i Din Ungdomsvaar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "Dog Himlen være lovet, der end er længe til,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Med eller uden Ringen jeg dog Dig elske vil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "Der gives ei paa Jord noget fastere Baand.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "- »Nei,« svarede Fru Tove, »naar blot af Kirkens Haand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 15,
      "text": "Velsignet det bliver, men indtil det kan skee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "Jeg aldrig ganske glemmer min Kummer og Spee.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "- »Ak« svared den Drot behænde, »der var en anden Tid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "Jeg ofte derom forsked, inden jeg kom hid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 16,
      "text": "Ved Hoffet hos Keiseren jeg læste tidt derom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "Der hersked andre Sæder i Grækenland og Rom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "Der havde man andre Guder, der leved man mere fri,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "Jeg næsten kunde sørge, fordi det er forbi.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 17,
      "text": "Da korsed sig den Jomfru, hun angst paa ham saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "Hun sagde: »Min ædelig Herre, I tale dog ei saa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "Det var jo dog kun Hedninger, som høre Djævlen til,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "Gud fri og bevar os for onde Aanders Spil!« ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 18,
      "text": "Svared med Smiil Kong Volmer: »Ængst Dig ei for mig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "Jeg siger ei til Andre, hvad jeg har sagt til Dig;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "Jeg veed, at nu der hersker en renere Tro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "Dog var man i gamle Dage ved Livet mere fro.«",
      "part": false,
      "marginal_notes": []
    }
  ]
}
