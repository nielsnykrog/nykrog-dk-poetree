{
  "id": null,
  "title": "Krist omvend min ulykke til glæde",
  "year_created": [
    1570,
    1573
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Langebeks kvart",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1573,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/LNGK41A.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Christ omvende miinn uløcke tiill glede |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "och wende uløcke lanngtt fraa meg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "wÿ maa | nu baade adskeliis",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "doch bliiffuer hiiartt mod | och siind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "hos diig hos diig alenne for nogenn |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "ieg wed ieg formercker du esth enn andenn | forseetth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "thed gøres meg aff altth miitth hiiartte | Wee |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Naar ieg tencker paa dii klageliig ord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "somm | ieg ofte aff diig haffuer hørtth och spurtth |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "daa eer thed miinn tancke och weseliig tro |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "atth waare uvener haffuer thed saa giiortth |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "atth ieg icke iddeliig maa were hos diig |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "tthed ofthe aff hiiartted bekømrer meg |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "tro meg ieg teg aff hiiartted well annd |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Esth du end hartth forpliichtiid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "daa lad | thed icke skaade for meg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "huem wed huaar | thed siig kannd skiicke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "om løckenn wiilde | anderlediis føye siig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "huemm reetth | betencker med tiilbørlliig lemmpe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "eÿiaa | eÿiaa dii lannge dage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "somm ieg monne | ofte for diig haffuee |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Miitth hiiartte haffuer stor forlengelss |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "efter thennd meg ganske well befalder |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "hunn haffuer miitth hiiartte vndfangenn |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "dii maa ieg liide enn kyømerliig klage |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "ieg seer ad ted wiill were saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "och | ted icke anderlediis were maa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "da | wennde meg gud miitth siind der-fraa |",
      "part": false,
      "marginal_notes": []
    }
  ]
}