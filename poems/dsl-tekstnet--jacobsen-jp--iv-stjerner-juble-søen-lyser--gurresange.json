{
  "id": null,
  "title": "IV »Stjerner juble, Søen lyser«",
  "year_created": 1886,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Jens Peter Jacobsen",
    "country": null,
