{
  "id": null,
  "title": "104. O! kiere siel, som bliver ey",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
