    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/HJB76.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "LXXVI |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 1,
      "text": "Ien Ridder om yen morgen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "spassere saa wylle hand gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "huad fanth | hand v-forborgen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "yen skønne Iomfro | , staa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "hand grøssett hind mett stor ære |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "hand kallett hind kieriste sin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "vill y nu | hoss meg were,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "thett er myn høgeste begiering",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "thett sade then Ridder fyn. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Den Iomfru suaret hannum mett | tugte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "sin ordt hund fuld-well kunnhe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "at | gange mett ether yen liden stund;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "thett kunne meg lidet frommhe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "ther er saa mange | y werden tiill;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "ther meg thet wylle forkiere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "att liue meg fra heder och ær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "thet wyll | i ycke begiere. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Hør y thett myn skønne Iomfru",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Y | skall ycke gronnhe saa witt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "y gaar med | meg yend liden stund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "hoss meg gieller ingen strid;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "yeg will meg giernnhe holle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "ihuad | I aff mig begerer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "y lader yett tro hierte | raade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Icke meg saa høgelig forsmaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "och y | hannem saa haart for-suare. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 4,
      "text": "Den Iomfru hund hannum | vnner øgen saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "saa spasskelig hun | hannum suareth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "meg siunes y ær | end vnger-suend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "eders ord kand y ycke | for-ware,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "ieg tør thett well betro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "then | sag er ycke wiss,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "yeg will eder beder | beskoe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "om y en Ridder-skemt tør voge |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "om før Ridder-pris. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "Skøn Iomfru lader meg ycke vndgielle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "thett yeg saa vnger mand er,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "yeg wil | myth hierte stelle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "epther eders egen begiering |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "faer meg eders huide hand;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "besuer meg liff | och siell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 5,
      "text": "trofast aff hierte och synne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 5,
      "text": "thenn | stund meg liffued kand wynne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 5,
      "text": "yeg aldrig annet begier. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 6,
      "text": "Vnger-Suend du est behendig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 6,
      "text": "du sier | well aff den ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 6,
      "text": "som teg rett aldrig kan | hennes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "saa mangen tro hierte for-kier |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 6,
      "text": "ther-paa wyll yeg betencke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 6,
      "text": "huad sligt | haffuer ind att bere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 6,
      "text": "att du mig | ycke forkrencker;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 6,
      "text": "mett thinne liste-lig | suencke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "forgeues ær Din begier-Ing | |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 7,
      "text": "Kand yeg eder ycke bewighe, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 7,
      "text": "thett er mytt høgelig klage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 7,
      "text": "yeg wil | eder aldrig suige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 7,
      "text": "alle myn liffs dage |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 7,
      "text": "faar meg eders huide hand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 7,
      "text": "yeg nadin | aff eder begierer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 7,
      "text": "lader meg aldrig for-suinde | ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 7,
      "text": "lader meg trohed befynde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 7,
      "text": "yeg | aldrig annett begier, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 8,
      "text": "Then Iomfru wende seg om y-gien |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 8,
      "text": "hund hørde then ridder klage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 8,
      "text": "hund tengte | ald saa innerlig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 8,
      "text": "huad hun hannum wille suare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 8,
      "text": "far meg eders huide hand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 8,
      "text": "besuer | meg liff och siell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 8,
      "text": "trofast aff hierte och | synne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 8,
      "text": "then stund ther liffuet kand wynne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 8,
      "text": "du vnner meg hiertelig Well. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 9,
      "text": "Den vnger-suend suarett mett ere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 9,
      "text": "hand | hade saa frythet modt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 9,
      "text": "myn kierist yeg er | ethers egen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 9,
      "text": "mytt liff och ald mytt godtz;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 9,
      "text": "yngen | skall oss att-skillie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 9,
      "text": "then stund ieg leffue maa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 9,
      "text": "for-vden gud allyennhe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 9,
      "text": "hand rader for mod | och synne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 9,
      "text": "altingest tiill hannum staa. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 10,
      "text": "Then Iomfru suaret mett | lempe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 10,
      "text": "sin løcke kand ingen for-wennhe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 10,
      "text": "Men thu wilt trofast were,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 10,
      "text": "skalt thu meg trofast fynne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 10,
      "text": "yeg giffuer | teg modt och synne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 10,
      "text": "gandske vnner thin | forpligt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 10,
      "text": "skaltu meg trofast fynne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 10,
      "text": "then | stund meg liffuet kand winnhe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 10,
      "text": "Ther-epther | wil ieg meg berede |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 11,
      "text": "Der bleff thy bode tiill-samenn |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 11,
      "text": "mett alder-erligste suencker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 11,
      "text": "huad ther-om | bleff fordelet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 11,
      "text": "thett staar well till att tencke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 11,
      "text": "thenn wechter paa then Muer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 11,
      "text": "hand | bleste y sin sincke then saa høgt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 11,
      "text": "hand saa | then dages kommhe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 11,
      "text": "war thennum saa lideth tiill frommhe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 11,
      "text": "theris glede bleff thennuum forrøgt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 12,
      "text": "Arlig om morgen thett war dag, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 12,
      "text": "thenn Ridder løste att ride,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 12,
      "text": "hund kla-gett seg saa ynnerlig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 12,
      "text": "att hand ey | lenger kunne bide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 12,
      "text": "hand tog hind | y sin Arm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 12,
      "text": "hand gaff hynne siitt | hierte tiill kenne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 12,
      "text": "y lader eder ycke | forlange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 12,
      "text": "y giør well end annhen saa | bange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 12,
      "text": "thet kenner ey y eders synne. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 13,
      "text": "Then Iomfru slo ham fraa hiertet |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 13,
      "text": "hund hørde thet falsske sned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 13,
      "text": "thett skal | end annhen vndgielle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 13,
      "text": "alt første yeg kommer wed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 13,
      "text": "Mand skulle seg well betencke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 13,
      "text": "huad epther kommhe kand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 13,
      "text": "Ware | seg for falsske krencker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 13,
      "text": "tro ey paa listig | suencker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 13,
      "text": "see huem du tager Wed hand. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 13,
      "text": "Mandne-liste er behendig, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 13,
      "text": "quinnen-liste har ingen ende |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 13,
      "text": "Well er then mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 13,
      "text": "som seg for | quinne-liste wochte kand |",
      "part": false,
      "marginal_notes": []
    }
  ]
}