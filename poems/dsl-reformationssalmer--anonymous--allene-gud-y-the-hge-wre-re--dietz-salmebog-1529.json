  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "ALlene Gud ÿ the høge wære ære",
      "part": false,
      "marginal_notes": [
        "Luce. ij."
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc tack for sÿn store naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Ther fore att oss nw aldrig meere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "kan røre siælsens skade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Gud haffuer til oss nw ingen had/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "men her er nw fred wden all wlad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "All feide haffuer nw faait ende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Wÿ loffue prÿse oc tilbede teg/",
      "part": false,
      "marginal_notes": [
        "Luce. ij."
      ]
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "for thÿn ære wÿ teg tacke:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "att tw Gud fader ÿ ewighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "reghere oss wille achte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Gantske vbegribelig er thÿn macht/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "all werden hun er teg vnderlagt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Wel er oss for saadan Herre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "O Jesu Christe Guds eenborne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "een søn wor himmelske faders/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "forløøst haffuer tw the forlorne/",
      "part": false,
      "marginal_notes": [
        "Mat. j. ij. j. Petri. ij."
      ]
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "att Gud thennom welbehager/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Guds hellige lam wor herre oc Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "tag til teg wor skyld/ giør for oss bood/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "forbarme teg offuer oss arme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "O Helliaand almectigste Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "tw al ler ypperste trøster/",
      "part": false,
      "marginal_notes": [
        "Johan. j. iiij. oc. xvj."
      ]
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "aff dieffuelsens wold leed thennom wd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "ther Jesus Christus forløste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "formiddels stor martyr oc bitter død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "affwend fraa oss alt iæmmer oc nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Ther til wÿ oss forlade.",
      "part": false,
      "marginal_notes": []
    }
  ]
}