  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Af Havets Skum, saa hvid og let,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Skjøn, som en Gud kun tænker det,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Hun evig ung sig hæver;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Slægt jorder Slægt paa Verdens Ø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Men Kjærlighed kan aldrig døe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Gudinden evig lever!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "»Kennst Du das Land!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Sødt dufter Juletræets Blad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Det stod igaar i Laurbærlunden!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Lad os, som Barnet, være glad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Vi er’ jo Alle Børn i Grunden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Den ene Forskjel kun jeg seer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Een veed lidt mindre, Een lidt meer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Husk, hvor det hjemme dog var smukt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Ved Juletid, da vi var mindre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Vi stod ved Døren, der var lukt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "Saae gjennem Sprækken Lyset tindre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "Tidt Nabobørnene var med –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Her finder nu det samme Sted.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Dansk, Svensk og Norsk, et Kløverblad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "Med Sundheds-Kraften, Troskabs-Flammen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "De Brødre tre, der skiltes ad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "I Roma knyttes atter sammen!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "Eet Sprog, eet Hjem os Himlen gav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Og Broder er hver Skandinav!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "Ei Drot og Hjem vor Sjæl forlod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "Hvad Hjertet elsker, maa det prise,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "Held DanmarksFred’rik Eiegod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "Held Sverrigs Carl Johan den Vise,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": "Den Skaal gjensidigt tømmes maa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 5,
      "text": "Thi Brødre her hos Brødre staae!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "Saa selsomt skifter Livet om,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "Saa mangt et deiligt Billed svinder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": "Dog denne Julefest i Rom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 6,
      "text": "Vil staae blandt vore skjønne Minder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 6,
      "text": "Thi grib og nyd med Barnets Sjæl",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 6,
      "text": "Vor lykkelige Juleqvæl!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": "Du er i Rom, i Verdens gamle Stad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 7,
      "text": "Hvor Oldtids Skatte, Oldtids Guder bygge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 7,
      "text": "Du drikker Sydens Luft i Laurens Skygge;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 7,
      "text": "O, vær dog glad! – – – –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 7,
      "text": "Husk, denne Tid gjenkommer aldrig meer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 7,
      "text": "Dog smerteknuust jeg mod mit Norden seer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 7,
      "text": "Et Brev fra Vennerne! – kom dog et Brev! –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 7,
      "text": "Men intet Ondt, ret modent Ondt, som dræber,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 7,
      "text": "Er sendt og samlet end fra Vennelæber,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 7,
      "text": "Man ellers skrev!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 8,
      "text": "Her er saa smukt – o skræm ei Drømmen bort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 8,
      "text": "Forund mig den – den er jo dog saa kort!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 8,
      "text": "Jeg vandrer snart jo til mit Fødested,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 8,
      "text": "Og om ei mine Fjender jeg forsoner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 8,
      "text": "De sikkert dog vil lægge Svøben ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 8,
      "text": "Thi Vennerne – de slaae med Skorpioner!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 9,
      "text": "Mellem lilla Bjerge drømmer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 9,
      "text": "Klædt i Hvidt, Neapels By,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 9,
      "text": "Ischia paa Havet svømmer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 9,
      "text": "Som en purpurfarvet Sky.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 9,
      "text": "Sneen mellem Bjergets Kløfter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 9,
      "text": "Ligger som en Svaneflok;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 9,
      "text": "Sort Vesuv sit Hoved løfter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 9,
      "text": "Med den røde Flammelok<button id=note5 type=button class=\"btn btn-outline-secondary btn-sm comment\" data-container=body data-toggle=popover data-template=\"<div class='popover' role='tooltip'><div class='arrow'></div><h3 class='popover-header'></h3><div class='popover-body'></div></div>\" data-placement=auto data-html=true data-content=\" <p>See Digtet » Vandring paa Vesuv «, Digte, anden Deel Side 24.</p> \" data-title=\" Fodnote 5\">F5</button>.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 10,
      "text": "Har Sydens Flamme ei Dit Bryst med Sødhed tændt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 10,
      "text": "Saa digt og syng til Straf en Serenade hjemme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 10,
      "text": "Faa Kys om Dagen af en iiskold Recensent",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 10,
      "text": "Og Vægterfavnetag om Natten for Din Stemme!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 11,
      "text": "Jeg saae det Land, hvis Luft har himmelsk Lyst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 11,
      "text": "Hvor under Pinien Skjønheds Børn os møde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 11,
      "text": "Hvor Ilden sprudler frem af Bjergets Bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 11,
      "text": "Og Oldtids Byer opstaae fra de Døde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 12,
      "text": "Der klædt i Marmor høie Guder staae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 12,
      "text": "Der Duft og Toner i hver Luftning vifte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 12,
      "text": "Mens Havet er en Olie, azurblaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 12,
      "text": "Og Bjergene med tusind Farver skifte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 13,
      "text": "Der Alt er Maleri ved Maleri,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 13,
      "text": "Der klart Guds Skaber-Kjærlighed man skuer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 13,
      "text": "See Bondens Gjerde: Laurbær groer deri,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 13,
      "text": "Den høie Cactus, Ranken tung med Druer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 14,
      "text": "Der blev mit Hjerte Barn, men Tanken Mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 14,
      "text": "Der lærte jeg Natur og Kunst at kjende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 14,
      "text": "Du Farvernes og Formens skjønne Land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 14,
      "text": "Farvel – min smukke Drøm er nu tilende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 15,
      "text": "Was sich stets und immer hat begeben,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 15,
      "text": "Das allein veraltet nie!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 16,
      "text": "Gleiches Stam erkennt sich wieder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 16,
      "text": "Läg in Mitten eine Welt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 16,
      "text": "Gleiche Treue, gleiche Lieder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 16,
      "text": "Nännen Dän’ und Teutsche Brüder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 16,
      "text": "Leugnet’s murrend gleich der Belt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 17,
      "text": "Es ist eine seltsame Sache:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 17,
      "text": "Ich sprach Deutsch und Dänisch Du,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 17,
      "text": "Und doch verstanden wir uns im Nu.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 17,
      "text": "Ja Freund! im Aug’ liegt die Sprache",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 17,
      "text": "Und im Herzen der Schlüssel dazu.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
