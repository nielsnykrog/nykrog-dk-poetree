{
  "id": null,
  "title": "Kongedatteren og Løven",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift I",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVI32.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Met lyst daa wille wy siunge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc siunge mett Dauidz flydt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "mett iammer oc stuor marter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "y mercker well dett mett flidt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "huor dett en konnge-dather gick",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "oc saa denn wnnge greffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "y mercker dett wel mett flidt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Der tiente wdy hindes faders gaardt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "saa mange welbyrdig mandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "saa well befald hinde den greffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "for alle hun ham y hiertit wel andt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "huorledis Gudt haffuer dett forøtt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "mett itt hiemmeligt bedrøffuit hierte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "sorgit dj for hin-annden saa saare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Den enne tuorde den anden icke obenbare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "huad dennem y hiertit war,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "men huer mon stadelig hobis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "att dj skulle findis snartt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "alt paa dett siste, der ditt saa kom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "den enne mon den anden tilschriffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "offuergiffue alle deris fryct.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Di sette hin-anden steffne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "paa en saa grøn en woldt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "alt wnder en lindt saa grøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "der stander en kielde saa koldt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "y-huilchen der først kom til den killdsens flodt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "handt skulle den anden bide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "oc saa wor beggis deris ordt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Denn jomffrue monne sig klede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "tog offuer sig en mantel huidt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "sinn brøst monne hun opsnørre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "vel silckit mett gandske flidt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "oc sagde den jomffrue skiøn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "\"Ingen mandt skall mig opsnørre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "foruden den greffue-søn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Oc der den jomffrue till kielden kom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "hun actit sinn kieriste att finnde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "\"Aff alle min nødt bliffuer ieg forløst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "aff alle min nødt bliffuer ieg forløst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "min sorrig monne sig forsuinnne.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 6,
      "text": "Der kom en løffue løbennde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 6,
      "text": "aff den wilde skoff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "den jomffrue lodt sig forfære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "saa snart flyde hun der-fraa;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "oc der tabte hun sin mantell huidt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 6,
      "text": "der-aff kom iammer oc quide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 7,
      "text": "Denn løffue fick sinn wnger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 7,
      "text": "alt paa den mantel godt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 7,
      "text": "then mantell bleff besmittet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 7,
      "text": "mett suedt oc suorten moldt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 7,
      "text": "oc saa mon løffuen att skoffuen gaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 7,
      "text": "att skoffuen mett sinn vnnger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 7,
      "text": "daa kom den greffue-sønn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 8,
      "text": "Oc der den greffue mantelen saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 8,
      "text": "war stenckt mett blodt rødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 8,
      "text": "handt monne sig saa iammerlige klage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 8,
      "text": "saa stuor daa war hans kiere:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 8,
      "text": "\"Ah we, y-men hun er dødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 8,
      "text": "hun haffuer for min skyldt dødt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 8,
      "text": "oc lidt denn stuore nødt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 9,
      "text": "Haffuer hun nu for min dødt skyldt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 9,
      "text": "oc liditt den stuore nødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 9,
      "text": "daa skall ieg aldrig flere jomffruer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 9,
      "text": "for min skyldt were dødt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 9,
      "text": "hindis liff will ieg betale",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 9,
      "text": "altt mett min egen dødt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 10,
      "text": "Christ signe dig soel oc maane,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 10,
      "text": "Christ signe dig løff oc gress,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 10,
      "text": "Christ signe dig kongelig krone",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 10,
      "text": "oc alt dett iorden bær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 10,
      "text": "oc saa min hierte-allerkierist,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 10,
      "text": "der haffuer for minn skyldt dødt\".",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 11,
      "text": "Hand satte hialtet imodt en steen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 11,
      "text": "oc odden imodt sin bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 11,
      "text": "handt stack sig ihiel alt paa hans suerdt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 11,
      "text": "handt lagde sig wnder linden saa grønn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 11,
      "text": "daa kom den jomffrue skønn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 12,
      "text": "Oc der den jomffrue till kiellen kom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 12,
      "text": "hun fant sin kierist war dødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 12,
      "text": "hun monne sig saa iammerlige kiere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 12,
      "text": "saa stuor daa wor hindis møde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 12,
      "text": "\"Ah we, min kierist er nu dødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 12,
      "text": "handt haffuer for min skyldt dødt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 12,
      "text": "oc lidt den stuore nødt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 13,
      "text": "Handt haffuer for min skyldt dødt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 13,
      "text": "oc lidt denn stuore nødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 13,
      "text": "hanns liff will ieg betale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 13,
      "text": "altt mett min egen dødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 13,
      "text": "att der skall aldrig flere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 13,
      "text": "for min skyldt mer dødt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 14,
      "text": "Christ signe dig soel oc mane,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 14,
      "text": "Christ signe dig løff oc gress,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 14,
      "text": "Christ signe dig kongelig krone",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 14,
      "text": "oc altt dett iorden bær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 14,
      "text": "oc min hierte-allerkierist,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 14,
      "text": "ther ieg skall nu for dig dødt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 15,
      "text": "Hun sette hialtet imodt en steen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 15,
      "text": "oc odden imodt sitt bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 15,
      "text": "hun stack sig siellff ihiel alt paa hans suerdt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 15,
      "text": "hun lagde sig forinden hans arm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 15,
      "text": "der wor stuor jammer oc klage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 16,
      "text": "Det hagde werit bedre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 16,
      "text": "den løffue hagde werit wfødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 16,
      "text": "endt slig to høuiske konge-børn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 16,
      "text": "saa skulle haffue bleffue dødt.",
      "part": false,
      "marginal_notes": []
    }
  ]
}