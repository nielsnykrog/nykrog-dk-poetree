  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift I",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVI51.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Det var bolder Her Nelus",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hand red sig under | øø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "feste hand stalter Hille lil",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "hun var saa ven | en møø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: de legte en Leeg oc legen var alt vdaff | vrede | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Drocke de deris Brøllup",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "vel i dage fem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "den sette | dag at quelde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "da fulde di Bruden hiem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": ":: De. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "De lod saddele heste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "oc rede al hiem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "der de komme | paa heden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "der bleste saa sterck en storm. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Det bleser fast oc det regner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "oc verit det giøris | kalt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "hør i det stalt Hille lil",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "Huor vil vi slaa voris | tilt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Rider vi osz til Henels holm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "det er saa langt | aff led,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "Rider vi osz til frurlund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "Eders Morbroder er mig vred |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Rider vi osz til fruerlund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "oc lyger vi der vdi nat |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "Er min Morbroder hiemme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "Hand giører eder icke andet | end got. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Her staar i Her peder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "oc kiere Morbroder Min |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "Det var bold Her Nielus",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": "hand kom der riden i | gaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "vdstaar Her peder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "hand vor vel suebt i Maar. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "Her staar i Herre Peder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 7,
      "text": "oc kiere Morbroder | min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 7,
      "text": "I loner Her Nielus hus i nat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "met alle | sine Mend. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "Gud nade dig stalten Hille lil",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 8,
      "text": "saa lit got der | fandt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 8,
      "text": "alt haffde ieg dig acktet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 8,
      "text": "en halffriger Mand. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "Der i haffde mig arktet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 9,
      "text": "en halff riger mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 9,
      "text": "aller | giffue i mig den",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 9,
      "text": "ieg onder saa vel som hannem. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "Ieg vil laane hannem hus i nat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 10,
      "text": "hannem oc | alle sine,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 10,
      "text": "saa vel ved bold her Nielus",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 10,
      "text": "det hand | veid brødre mine. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "Saa fulde de stolten Hille lil",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 11,
      "text": "forinden den Høffue loffts bord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 11,
      "text": "saa fulde de Her Nielus",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 11,
      "text": "vdi den | Borgestuff. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 12,
      "text": "Skenckte de bolde Her Nielus",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 12,
      "text": "bode Mød oc klare | Vin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 12,
      "text": "vdgor herre Peder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 12,
      "text": "vaabner sig oc alle sine. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 13,
      "text": "Ind kom Herre Peder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 13,
      "text": "hand kaste sin Suerd paa | bord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 13,
      "text": "Mindis du det Her Nielus",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 13,
      "text": "det du mine | brødre vou. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 14,
      "text": "Det ved ieg saa giørlig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 14,
      "text": "som det haffde skied | i gaar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 14,
      "text": "Ieg vil eder for broder staa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 14,
      "text": "de dage ieg | leffue maa. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 15,
      "text": "Du skalt dig i freden fare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 15,
      "text": "met alle dine Mand |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 15,
      "text": "foruden dine søster sønner tho",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 15,
      "text": "de skal her bliffue | igien. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 16,
      "text": "Aap da stod de helte tho",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 16,
      "text": "de giordet dem med deris | suerd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 16,
      "text": "Min Herre i giffuer osz orloff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 16,
      "text": "selff ville | vi staa vor ferd. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 17,
      "text": "Alt stod Herre Nielus",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 17,
      "text": "oc saa hand der paa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 17,
      "text": "til | hans søster sønner tho",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 17,
      "text": "de døde paa Iorden laa. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 18,
      "text": "Det loffuer ieg paa den hellige graff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 18,
      "text": "alt som vor | herre tolde død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 18,
      "text": "ieg skulde icke min suerd vdrage | om søndag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 18,
      "text": "foruden mig trengde stor nød. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 19,
      "text": "Aap stod her Nielus",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 19,
      "text": "oc hand sin suerd vdrog, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 19,
      "text": "det vil ieg forsandingen sige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 19,
      "text": "saa mandelig hand | hug: |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 20,
      "text": "Det vor herre Nielus",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 20,
      "text": "oc hand hug alt saa fast |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 20,
      "text": "til hans gode suerd i hans hand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 20,
      "text": "sønder brast. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 21,
      "text": "Hand virred sig med de hÿnder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 21,
      "text": "oc met de bolster | blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 21,
      "text": "vden for den stuffue dør",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 21,
      "text": "der fick hand sit | baane saar. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 22,
      "text": "Det melte Herre Nielus",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 22,
      "text": "alt bode med sorrig oc | quide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 22,
      "text": "kommer nu stolten Hille lil",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 22,
      "text": "det er nu tid | at ride |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 23,
      "text": "Det var Herre Nielus",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 23,
      "text": "satte sig til sin hest",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 23,
      "text": "saa | red hand til Henels holm",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 23,
      "text": "alt som hand kunde best. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 24,
      "text": "Det vor Herre Nielus",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 24,
      "text": "hand kom der ridendis | i gaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 24,
      "text": "vdstod hans kiere søster",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 24,
      "text": "hun vaar vel suebt | i Maar. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 25,
      "text": "Velkommen min kier broder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 25,
      "text": "oc hui rider du saa ene, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 25,
      "text": "huor er mine sønner tho",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 25,
      "text": "som dig skulde idelig thiene. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 26,
      "text": "Ieg red mig til fruerlund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 26,
      "text": "alt med stalt Hillelils raad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 26,
      "text": "der bleff dine sønner tho",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 26,
      "text": "selff fick | ieg bane saar. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 27,
      "text": "Hør du min kiere søster",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 27,
      "text": "du lad mig rede en | seng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 27,
      "text": "oc ver stalten Hille lil i Moders sted,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 27,
      "text": "hun | er en frue saa ven. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 28,
      "text": "Herre gud nade mig fattig Quinde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 28,
      "text": "huor skal | ieg vere hende god,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 28,
      "text": "for hendis skÿld miste | ieg mine sønner tho,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 28,
      "text": "min Broder i skarlagen | graa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 29,
      "text": "Det vor ÿnck i høffuelofft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 29,
      "text": "oc halff mere | stor harm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 29,
      "text": "det vor Bolde her Nielus",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 29,
      "text": "hand døde | i sin søsters arm. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 30,
