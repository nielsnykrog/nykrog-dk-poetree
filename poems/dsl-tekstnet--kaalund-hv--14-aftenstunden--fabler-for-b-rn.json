  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Bølge, Du grumme, Du stolte, Du vilde,",
      "part": false,
      "marginal_notes": [
        "Speaker: Vandringsmanden:"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hvorfor bli'er Du med Et saa stille?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Vind, hvorfor mon Du sagtnes nu?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Fugl, hvi sidder saa rolig Du?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Menneske, ser Du ej Solen dale?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Hvor kan Du spøge og larme og tale!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Fuglen stille paa Kvisten sad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "stirred i Aftenrøden glad;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "neppe sig rørte et Blad foroven;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Vandreren gik sin Gang gjennem Skoven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "og da han kom til Markens Led,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "hilste ham Bonden mildt: Guds Fred!",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
