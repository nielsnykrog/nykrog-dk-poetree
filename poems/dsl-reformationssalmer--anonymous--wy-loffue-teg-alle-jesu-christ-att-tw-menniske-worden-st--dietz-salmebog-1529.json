  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Wÿ loffue teg alle Jesu Christ: att tw menniske worden æst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc aff een Jomffru fødder wor/",
      "part": false,
      "marginal_notes": [
        "Luce. ij."
      ]
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "thÿ frøgde seg alle Engle skare Kyrioleys.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Guds ewige faders eneste søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "han haffuer annammit menniskens køn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Han laa ÿ kryben nid paa straa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "han wilde oss vsle icke forsmaa Kyrioleys.",
      "part": false,
      "marginal_notes": [
        "Phil. ij."
      ]
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Then werden all ey beslutte kunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "han er ÿ Marie skød funden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "han er nw worden eet barn saa spæt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "ther alting haffuer eene opræt Kyrioleys.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "Thet ewige liws kom tha her ind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "att opliwse werden med sitt skÿn/",
      "part": false,
      "marginal_notes": [
        "Esaie. ix Esaie. xlij."
      ]
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "thet liuser wel ÿ then mørckeste natt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "att bliffue Guds børn giffuer thet oss macht.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "Guds faders søn aff himmerig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "er worden een gest ÿ iorderig/",
      "part": false,
      "marginal_notes": [
        "Johan. j."
      ]
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "att føre oss wdaff then grædelig dall/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "oc giøre oss til arffuinge wdi sÿn sall/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Kyrioleys.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Han wor her ÿ werden fattig oc arm/",
      "part": false,
      "marginal_notes": [
        "Roma. viij Luce. ix."
      ]
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "thÿ han wille seg offuer oss forbarme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "oc giøre oss saa ÿ himmelen rÿg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "oc alle sÿne hellige Engle lÿg Kyrioleys.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Thette haffuer han oss alle beteed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "til att bewyse sÿn kierlighed/",
      "part": false,
      "marginal_notes": [
        "Johan. iij."
      ]
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "dess frøgder seg all then Christenhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "oc tacker hannwm dess til ewighed Kyrioleys.",
      "part": false,
      "marginal_notes": []
    }
  ]
}