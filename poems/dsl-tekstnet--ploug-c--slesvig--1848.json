  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "\"Nu har vi Ledet hængt tilret,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Og Gud vil Vangen hyre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "At ingen Fremmed bryder det.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Saa mælte Dronning Thyre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Men tidlig sluktes Thyres Aand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Og Ledet sank for Fjendehaand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Og smeddet blev et Slavebaand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "For Anguls frie Sønner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Hvor \"Danmarks Hertug\" Knud med Staal",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Skrev Venden danske Love,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Tør nutildags det danske Maal",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Sig knap til Thinge vove;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Der staver nu hver Skolepog",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Hel drøvelig sin tydske Bog;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Der tør Guds Ord i Hjertets Sprog",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Ej Vej til Hjertet finde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Har da det danske Folk ej Gnist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Af Fædres Kraft tilbage?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Har det mod Vold og Argelist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "Til Værn kun daadløs Klage?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "Og vil det pleje Ro og Mag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "Indtil det ser engang den Dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "Da Danmarks himmelfaldne Flag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "For \"Brændenelden\" stryges?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "Nej, Brødre! nej, vi har udtømt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "Vor Kummers Kalk til Bunden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "Og al den Lykke, vi har drømt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "For Nuets Krav er svunden:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "Hvad Folket vil, det Folket kan; -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "Nu vil vi, at vort Fædreland",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "Forynget skal fra Gravens Rand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "Til Sejr og Frihed stige!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 0,
      "text": "Og se - det lysner alt i Syd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 0,
      "text": "Midt paa de Tydskes Thinge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 0,
      "text": "Peer Hjort Lorenzen slog til Lyd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 0,
      "text": "Med Modersmaalets Klinge;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 0,
      "text": "Og Thyres Vold er rejst paa Tryk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 0,
      "text": "Og Slesvigs Bønder, Ryg mod Ryg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 0,
      "text": "Vil slaa en Skandse fast og tryg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 0,
      "text": "Om Danmarks nye Rige!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
