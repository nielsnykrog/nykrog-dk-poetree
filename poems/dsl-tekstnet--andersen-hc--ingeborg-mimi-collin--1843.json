  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1843,
    "url": "https://tekstnet.dk/books/andersen-hc_ingeborg-mimi-collin/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Ved Dørens Trin Dødsenglen stille sad;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Der indenfor en Moder laa i Smerte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "For hende sorgfuldt Kjærligheden bad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Og Livets Straale blev i hendes Hjerte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "I Stuen tætved legede de Smaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Den ældste var en lille deilig Pige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "En Rosenknop – Dødsenglen Blomsten saae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Og tog den med sig til sit stille Rige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Der voxer hun nu op i himmelsk Glands!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Et Eventyr er hende Jordelivet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Thi Barnet saae ei Jordens Tornekrands:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Hun selv i den som Rosenknop blev givet.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
