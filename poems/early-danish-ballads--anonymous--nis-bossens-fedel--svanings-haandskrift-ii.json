{
  "id": null,
  "title": "Nis Bossens fedel",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift II",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVII31.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Nis Boszen giorde mig saa megen wro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "saa solde hand bort min eniste ko.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": ":: Saa kiøffte hand sig en fidel. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Nis Boszen tog fidelen paa sin bag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "hand lackit til barselhusz i sin mag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": ":: For hand haffde faat en fidele. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "\"Hør du, Nis Boszen, huad ieg siger dig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "och en god læg saa giffuer du mig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": ":: For du haffuer faat en fidele.\" ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "\"Och icke faar du leeg aff mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "foruden ieg faar pending aff dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": ":: For ieg har faat en fidele.\" ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 4,
      "text": "Di tog Nis Boszen i halsz och haar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "och slo hannom mod den sorte iord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": ":: I sønder brast hans fidele. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 5,
      "text": "Nis Boszen løb offuer kier och mosz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "hand hade icke vden en fedel posz.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": ":: I synder vaar hans fidele. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 6,
      "text": "Nis Bodszen lacker offuer agger och eng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 6,
      "text": "hand hade icke vden en fedel streng.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": ":: I synder vaar hans fedele. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 7,
      "text": "Der hand kom til borgens led,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 7,
      "text": "der stod hans høstru, lenit sig ved.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": ":: \"Huor har du latt din fidele?\" ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 8,
      "text": "\"Och min kære hustru, magger eder icke saa kreng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 8,
      "text": "saa vel faar ieg min fedel igien.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 8,
      "text": ":: Saa vell far ieg min fidele.\" ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 9,
      "text": "Och hun faar op hinde suarede rock,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 9,
      "text": "hun slo Nis Boszen paa hans krop.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 9,
      "text": ":: \"Du skalt faa skam for fedelen.\" ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 10,
      "text": "Hun fick op en elnestock,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 10,
      "text": "hun slo hanem tuert och ende langs.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 10,
      "text": ":: \"Du skalt faa skam for fidele. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 11,
      "text": "Du haffuer giort mig saa megen vraa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 11,
      "text": "du solde bort min kollede ko.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 11,
      "text": ":: Saa kieffte du dig en fidele.\" ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}