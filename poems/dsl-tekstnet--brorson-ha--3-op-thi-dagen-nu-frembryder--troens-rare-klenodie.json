{
  "id": null,
  "title": "3. Op! thi dagen nu frembryder",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
