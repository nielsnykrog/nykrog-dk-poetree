  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "»Vor Fader i Himlen unævnelig stor!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Dit hellige Navn os i Hjerterne groe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Lad ind i dit Rige os bygge og boe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Din Villie raade i Liv og i Død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Du vil os give vort daglige Brød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Forlad os vor Skyld, som vi dem forlade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Der skulde os takke og ikke hade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Hold Fristelsen fra os, dens Synd og Last,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Frels os fra det Onde, hold Du os fast;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Thi dit er Riget og Magten og Æren,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "I Jesu Navn og vor evige Væren!«",
      "part": false,
      "marginal_notes": []
    }
  ]
}
