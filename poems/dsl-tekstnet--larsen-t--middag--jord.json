    "url": "https://tekstnet.dk/books/larsen-t_jord/025/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Et heftigt Ildstænk mod det haarde Blaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "staar Middagssolen hed i strittende Straalen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Den tørre Muldbrink er saa pulvergraa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Insekter summer over Agerkaalen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Den stille Dag sig strækker vidt og højt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Omkring mig Myg og Sommerfugle svirrer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Fra Luft og Løv der pibler klare Fløjt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "I glarfin Dis de fjerne Flader dirrer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "– –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "I Søens blanke, afmagtstunge Vand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "staar Fisken stiv og dum fra Gab til Hale.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Nu slog den Snuden mod den bratte Strand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "og nøs og dasked hen i Dybets Dale.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Der ligger den paa Bund i Søen klar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "og fra dens Snude gaar tilvejrs en Boble:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "den stirrer op mod Overfladens Glar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "hvor Solen gynger som en ildgul Gople.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "– –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "En Bondepige sidder i en Grøft –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "med korte Særkeærmer, nøgne Arme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Man ser det øverste af Barmens Kløft –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "der ligger Draaber, Sol og Kødets Varme. – –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "Det er saa varmt og godt ved Muld og Strand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Det er en Sommerdag i Danmarks Land.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
