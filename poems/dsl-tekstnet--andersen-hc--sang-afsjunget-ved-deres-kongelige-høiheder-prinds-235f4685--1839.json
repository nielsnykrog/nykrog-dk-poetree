{
  "id": null,
  "title": "Sang afsjunget ved Deres kongelige Høiheder Prinds Christians og Prindsesse Caroline Amalies Møde paa Gisselfeldt den 30 August 1839",
  "year_created": 1839,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1839,
    "url": "https://tekstnet.dk/books/andersen-hc_sang-afsjunget-ved-deres-kongelige-hoeiheder-prinds-christians-og-prindsesse-caroline-amalies-moede-paa-gisselfeldt-den-30-august-1839/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Nu er det Høst, nu er det Vandre-Tiden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Nu flyver Storken bort til Pyramiden;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Her Farvepragten svinder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Snart Skyen ryster Snee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Men da i skjønne Minder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Det Svundne vi gjensee.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Fyrste-Par! I mindes Sommer-Glandsen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Gisselfeldt staaer med som Blomst i Krandsen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Gisselfeldt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Fyrstinde! Du med Tanken gjæster Øen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Seer Hjemmet, Dine Kjære hist bag Søen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Der hvor Din Vugge gynged’,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Hvor Englen hos Dig stod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Hans Arm da fast omslynged’",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "En Søster, skjøn og god.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Uskylds Smaae steeg ned til Fyrstens Datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Uskylds Smaae paa Jord Du søger atter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Uskylds Smaae!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Vi veed, o Prinds! at Gisselfeldt gjenkommer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "I Minde hos Dig skjønnest denne Sommer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Thi her var Eders Møde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Her samledes I fro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Trofaste Hjerter bøde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Velkommen Eder To.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Snillets Ven! Hjerternes Fyrstinde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Gjennem Aar den Dag i Dag vi minde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Gjennem Aar!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
