  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "\"Du Edderkop, vil Du til Hækken spinde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Hvor kan Du Vej over Strømmen finde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Om Dag og Nat Du løber din Vej,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "den brusende Bæk omgaar Du ej.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "\"Tys Vandringsmand, hvor ej Flid forslaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "man ofte ved Taalmod Maalet naaer.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Dér sad den nu med sit lette Spind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Da sused en sagte Aftenvind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "den svævende Traad sig til Hækken bandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "saa den liden Spinderske Vejen fandt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "den havde jo ventet saa ufortrøden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "nu sad den derovre i Aftenrøden.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
