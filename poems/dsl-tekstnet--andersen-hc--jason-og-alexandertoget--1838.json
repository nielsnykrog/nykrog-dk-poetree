{
  "id": null,
  "title": "Jason og Alexandertoget",
  "year_created": 1838,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1838,
    "url": "https://tekstnet.dk/books/andersen-hc_jason-og-alexandertoget/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Man bygged’ et Skib; det hele Skrog",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Var reist, som det skulde være;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "En Krands med det vaiende Dannebrog",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Var ophængt til Værkets Ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "En gammel Matros paa Reisningen saae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Og udbrød: »see, der er vor Hæder!« –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Bag Bjelken en lille Dreng der laae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Han var kun i fattige Klæder;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Men Danmarks Genius til ham gik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Usynlig, som Luftninger svale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Og gjentog den Gamles Tale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Men fæsted’ paa Drengen sit Blik.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Som vilde Svaner Skibene foer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Til Jordens de fjerneste Lande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Hver bragte en Skat, saa riig og saa stor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Det spøgte i Drengens Pande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Han saae, hver Seiler havde sit Navn;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Paa een, den var værd nok at føre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Stod »Jason« udhugget i høien Stavn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Og Drengen fik Mythen at høre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Om Argonauternes dristige Tog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "Det gyldne Skind, som blev vundet;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "Og Drengens Tanker til Kolchis drog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "I ham selv en Jason var fundet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Og Musaen kom i den natlige Stund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Til Billedskjærerens Stue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Hun kyssed’ det fattige Barn paa hans Mund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Saa fra Panden der lyste en Lue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Og Kunstens Kolchis for Drengen laae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "Med Farver, med Duft og med Toner;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "De høie Guder han for sig saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "Med Magtens evige Kroner;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "Men Christus-Solen steeg stor og reen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 2,
      "text": "Da blev’ de til Taage og Skyer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 2,
      "text": "Der sank, og blev’ Bjergenes Marmorsteen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 2,
      "text": "Ei langt fra de Christnes Byer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 2,
      "text": "Den skinnende hvide Væg var at see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 2,
      "text": "Der det klang, som naar Orgelet stormer:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 2,
      "text": "»Hvo løser os atter fra denne Vee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 2,
      "text": "Til Guders og Skjønheds Former!« –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 2,
      "text": "Da faldt Fortrøstningens milde Ord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 2,
      "text": "Som Dug til hvert Blad paa Grenen:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 2,
      "text": "»En Yngling kommer der høit fra Nord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 2,
      "text": "Han løser jer ud af Stenen!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 3,
      "text": "Det Syn var svundet og Drømmen med,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 3,
      "text": "Den Lille laae vaagen der hjemme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 3,
      "text": "Men Dag og Nat drev ham Tanken afsted,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 3,
      "text": "Han hørte sin Musas Stemme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 3,
      "text": "Og Snillet voxte, men ei hans Navn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 3,
      "text": "Knap vidste han selv, han var fremme;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 3,
      "text": "Han havde en Længsel, han følte et Savn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 3,
      "text": "Skjøndt savnet af Moder-Arme;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 3,
      "text": "Han bad: »tag, Jesus, Du mig i din Favn,«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 3,
      "text": "Og gik – hvor Bølgerne larme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 4,
      "text": "Til Kolchis-Italia, Kunstens Land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 4,
      "text": "Han drog fra de danske Bøge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 4,
      "text": "Geniet kan adle en Dreng til en Mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 4,
      "text": "Og Manden maa Kamp forsøge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 4,
      "text": "Hver Kunstner gjør sit Argonautertog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 4,
      "text": "Hans Vei er de skuffende Bølger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 4,
      "text": "Og om ei Stormen hans Skib nedslog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 4,
      "text": "Ham Stymphaliden forfølger;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 4,
      "text": "Det ædleste Hjerte tør Pilene naae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 4,
      "text": "Døgn-Niddets forgiftede Pile,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 4,
      "text": "Dog, den som er Jason, vil Kolchis naae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 4,
      "text": "– Vi saae ham til Kolchis ile.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 5,
      "text": "Hiin Mythe ham altid for Øret klang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 5,
      "text": "Han gik mistrøstet og stille.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 5,
      "text": "Nu slog han mod Fjeldet, og Jason fremsprang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 5,
      "text": "Da først begreb han sit Snille.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 5,
      "text": "Geniet ei længer som Mythe stod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 5,
      "text": "Til Klarhed man saae det fremspringe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 5,
      "text": "En ung Alexander fra Isse til Fod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 5,
      "text": "Der vil og skal Verden betvinge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 5,
      "text": "Som han det først frygter: »Hver Seier er endt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 5,
      "text": "Hvad bliver for mig tilbage!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 5,
      "text": "Men Kunstens Grændser har Ingen kjendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 5,
      "text": "De voxe, hvor Aander tiltage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 5,
      "text": "Bucephalos tæmmes, til Kamp det gaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 5,
      "text": "O, Jorden er altfor liden!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 5,
      "text": "Geniet som Alexander staaer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 5,
      "text": "Og bliver et Mærke for Tiden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 6,
      "text": "Hans Seire kjender Alverden godt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 6,
      "text": "Stolt lyder det Navn, han har vundet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 6,
      "text": "Fra Vaticanet til Czarens Slot,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 6,
      "text": "Fra hiin Side Themsen og Sundet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 6,
      "text": "Geniet drog ind i Babylon,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 6,
      "text": "Det Seierstog maatte han give,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 6,
      "text": "Og Gratierne sang da paa Helicon:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 6,
      "text": "»For Dig vil et lignende blive!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 7,
      "text": "Det var i September, en deilig Dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 7,
      "text": "Rundtom saae man heiset det danske Flag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 7,
      "text": "Da Danmarks Genius stolt nedskrev",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 7,
      "text": "Sin Mythe om Jason den anden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 7,
      "text": "Om Alexandertoget, der blev",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 7,
      "text": "Hvor Folket strømmed’ til Stranden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 7,
      "text": "Og under sit Banner hver Kunstner drog",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 7,
      "text": "Imod ham ved Jublen: »han lander!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 7,
      "text": "En syvfarvet Bue Solstraalerne slog’",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 7,
      "text": "Som Æreport for Alexander!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 8,
      "text": "See, Hverdagslivets smaalige Dunst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 8,
      "text": "Dog maatte Minuter vige!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 8,
      "text": "I ham har vi hyldet den hellige Kunst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 8,
      "text": "Apost’len fra Aandens Rige.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
