  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Saa mangen Nat jeg hen til Vinduet gik",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Og saae hvor Fløien sig i Vinden dreied’,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Hen over Søen fløi de Længsels Blik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Den mit og mine Børns det bedste eied’;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Hans Grav det var, jeg saae, men vidste ei,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Nu Tiden ridser Vished i mit Hjerte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Dansk, trofast var Din Sjel, som stolt Din Vei,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Sov sødt, vi sees, hvor Livet ei har Smerte.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
