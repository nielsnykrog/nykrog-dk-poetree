  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Jeg sendte som Barn, før jeg lukked' mit Øje,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Hver Aften en Bøn til min Gud i det Høje;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Slig Bøn steg vist aldrig mod Guddommens Øre;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Thi jeg bad min Gud mig almægtig at gjøre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Nu mærker jeg først, at den naaed' hans Throne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Nu først, at min Isse bær Almagtens Krone;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Han har givet mig Almagt i Drømmenes Rige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Snart af Taagernes Chaos min Verden skal stige.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
