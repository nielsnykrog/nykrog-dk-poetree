{
  "id": null,
  "title": "I fryden vil jeg leve en stund",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift I",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVI21.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "I frÿdenn vil ieg leffue en stundt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "christ giffue den dag en guodt | ende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "At huer kand finde sin kierist | guode ven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "saa kommer mig min til | hende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "hindes lade och lempe thi falder | hinder vel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "blant fruer och Iomffruer | alle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "ret aldrig bliffuer ieg vdj hier-tet | gladt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "førend ieg fanger met hinder | talet. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Bliff trofast alle din dage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "bleff stadig ÿ hiertet trofast,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Du ladt dig | aldrig bedrage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "bleff skier foruden last, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "huem thet ville tencke, huad epther | ville komme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "thenn mand giffuer ieg | stor pris,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "der-offuer haffuer ieg forsømmit mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "saa skal en daare bliffue | vÿs. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Ret rosenns farffue bode huide och rødt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "thet er hindis idelig dret,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Thet | drager thenn blomster foruden al meen, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "er opronden aff edell slegt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "vdenn | gud skal os ingen atskillie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "then glede | skall thi eÿ faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "ingen klaffer skall | fremme sin villie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "hand maa vel andet slaa paa: |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Thi blomster springer wd saa vide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "i | marcken saa mangefoldt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "och meist | om sommerzens tide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "thet volder thenn | klare Soel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "nar solen sin skin monne | giffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "alletingest tha gleder sig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "den | blomster min sorrig monne Driffue, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "der-offuer saa gleder ieg mig. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Adam lodt sig bedrage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "i paradis | , som hand sadt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "alt inden sin federste | dage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "os alle thil møgen hadt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "konninng Salmon han vilde thet prøffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "der-for lide han stor nødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "konning Dauid han vilde det øffue, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "Vrias han bleff der dødt. |",
      "part": false,
      "marginal_notes": []
    }
  ]
}