  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Mit Livs Eventyr (Inklusive Fortsættelse Og Tillæg). 1855-1877",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1855,
    "url": "https://tekstnet.dk/books/andersen-hc_mit-livs-eventyr-inklusive-fortsaettelse-og-tillaeg-1855-1877/015/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "»Det Dygtige Du skatted’ og forstod!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 1,
      "text": "»Dybt føle vi, Fjenden vor Broder dog er,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Aarhundreder med os forbunden;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Men selv han os tvang til den blodige Færd;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Nu gjælder kun tabt eller vunden.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "»Jeg kan ikke blive, jeg har ingen Ro!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "»Tapperhet, mensklighet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "hjeltemod, ädelmod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "är igår, som idag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "Danska krigsmäns lag.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "Med Svalorna dragar du bort mot nord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "du Danmarks sangrika Svala,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 4,
      "text": "ett vintriga hem, ett frostbunden jord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "med sommarens flägtar hugsvala.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 5,
      "text": "Och tusinde röstar på Sverrigas strand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 5,
      "text": "velkommen Dig snart skulla helsa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "O! helsa det goda, det älskade land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "de svenska Vennerna helsa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 6,
      "text": "Men medtag en talisman minnesgod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 6,
      "text": "från Vännan, som vel du känner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "och drick ur de svenska källornas flod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 6,
      "text": "en skål for de danske Venner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 7,
      "text": "Drick, ädle Skald, utur vänskapens bål,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "den är Din öfverallt oppa jorden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 7,
      "text": "men ingenstäds dricks H. C. Andersens skål",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 7,
      "text": "så varmt som här hemma i norden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 8,
      "text": "F. B.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 9,
      "text": "Skarpt som et Sværd laae Øresund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 9,
      "text": "Imellem Nabostrande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 9,
      "text": "En Rosengreen en Morgenstund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 9,
      "text": "Forened disse Lande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 9,
      "text": "Hver Rose aanded Poesie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 9,
      "text": "Den slagne Vunder læger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 9,
      "text": "Hvo mægted’ dette Trylleri?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 9,
      "text": "Tegner og Oehlenschläger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 9,
      "text": "!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 10,
      "text": "Det var under vaktparaden –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 10,
      "text": "från ståten så mången blick",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 10,
      "text": "flög hän till en välkänd främling,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 10,
      "text": "der langs promenaden han gick.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "Men främst med tindrande ögon",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "– när främlingen bort sig begaf –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "stod qvar vid sin moders sida",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "en fem qvarters hög skandinav.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "»Ack, snälla min älskade mamma,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "men är det då riktigt sant",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "att han der har gjort mina sagor –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "jag mins dem alla så grant:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "den modige tennsoldaten",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 11,
      "text": "och Karo och bondens ko",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 11,
      "text": "och flickan hos dockan i trädet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 11,
      "text": "och månen i storkens bo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 12,
      "text": "Ack, bjud honom hem i afton",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 12,
      "text": "att sitta i mormors berså,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 12,
      "text": "och låt oss få plättar och risgröt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 12,
      "text": "det bästa af allt ändå!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 12,
      "text": "Då skall jag väl ha min jacka",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 12,
      "text": "med silfverknapparna i ...",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 12,
      "text": "Tänk, om han villa berätta",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 12,
      "text": "en saga för mig och Marie!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 13,
      "text": "Så fråjdade skald, af naturen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 13,
      "text": "din lager du takit emot.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 13,
      "text": "Den kan ej förhärjas af stormen:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 13,
      "text": "i hjertat den eger sin rot ...",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 13,
      "text": "Till barn har du bildat oss alla",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 13,
      "text": "i lifvets stora »Bazar« –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 13,
      "text": "haf tack – o, måtte din himmel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 13,
      "text": "ett rum för barnen ha qvar!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 14,
      "text": "Behåll, hur tidens stridsvagn än må dundra,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 14,
      "text": "Dit liff af dikt och frojd i Sagans verld!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 14,
      "text": "Liuft är att älska, herrligt att beundra;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 14,
      "text": "Jag minnes Dig – med denna dubbla färd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 14,
      "text": "Atterbom.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 15,
      "text": "Du Kjærlige, du Milde, med et Hjerte som Faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 15,
      "text": "Bramfri, som altid den sande Aand man saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 15,
      "text": "Beskeden og saa rig dog paa Digtekunstens Skatte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 15,
      "text": "– I disse fattige Ord dit Billede jeg satte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 16,
      "text": "Bag Stjernen i dit Bryst et Hjerte slaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 16,
      "text": "Og i dit Slot man Digterharpen finder;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 16,
      "text": "Lyksalig Den, Gud giver mange Aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 16,
      "text": "Og Aar som dine, rig’ paa store Minder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 17,
      "text": "Härliga land!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 17,
      "text": "Lummiga lundar och öar;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 17,
      "text": "Soliga stränder och sjöar;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 17,
      "text": "Härliga land!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 18,
      "text": "Kämpande land!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 18,
      "text": "Skandiens förpost mot söder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 18,
      "text": "Manligt du strider och blöder;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 18,
      "text": "Kämpande land!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 19,
      "text": "Segrande land!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 19,
      "text": "Lagrar din klinga har skurit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 19,
      "text": "Skölden med ära du burit;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 19,
      "text": "Segrande land!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 20,
      "text": "Bröderneland!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 20,
      "text": "Trofasta handslag vi trycka,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 20,
      "text": "Samdrägt är kraft och är lycka,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 20,
      "text": "Bröderneland!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 21,
      "text": "Härliga land!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 21,
      "text": "Sköldmön dig följer med seger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 21,
      "text": "Frihed och framtid du äger;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 21,
      "text": "Härliga land!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 22,
      "text": "Med lyran på din arm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 22,
      "text": "Så full af poesier;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 22,
      "text": "Med lyran i din barm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 22,
      "text": "I hjertats djup, i själens brand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 22,
      "text": "Så rik på melodier;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 22,
      "text": "Du drar från land til land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 23,
      "text": "Sjung jord och himmel, sjung!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 23,
      "text": "Sjung sagor om att lefva!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 23,
      "text": "Sjung dödens saga, sjung!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 23,
      "text": "Som svanen på sin blåa sjö,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 23,
      "text": "Du sjungende må lefva,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 23,
      "text": "Du sjungende må dö!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 24,
      "text": "»Kun Casino!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 25,
      "text": "»See Tankelyn gik ud fra danske Hjerner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 25,
      "text": "Og lyste for den hele vide Jord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 25,
      "text": "De vendte Øiet op mod Himlens Stjerner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 25,
      "text": "Og ned i Løndomskraftens dunkle Spor;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 25,
      "text": "Du danske friske Strand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 25,
      "text": "Hvor Øiet frit omsvæver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 25,
      "text": "Og frie Blik til Tankeflugt os hæver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 25,
      "text": "Dig elsker jeg, Danmark, mit Fædreland!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 26,
      "text": "Paa Valdpladsen faldt Du for Danmarks Sag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 26,
      "text": "Der brast dit ildfulde Hjerte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 26,
      "text": "Din Aand var klar som den lyse Dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 26,
      "text": "Med »fremad!« den steg i det blodige Slag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 26,
      "text": "Saae Danskens Seier og – Smerte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 27,
      "text": "Græd stakkels Moder, nedbøiet tungt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 27,
      "text": "»Hans Liv var saa ungt!« – men evigt ungt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 27,
      "text": "Staaer ogsaa hans Eftermæle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 28,
      "text": "»Sit Løfte har han holdt, den tappre Landsoldat!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 29,
      "text": "– – »Nu komme de! hør fra Voldene Skud!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 29,
      "text": "Saa sunde, saa prægtige see de ud!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 29,
      "text": "Hurra! Hurra! I herlige, brave Soldater!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 29,
      "text": "De komme med Blomster paa Hat og Gevær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 29,
      "text": "Et vandrende Foraar de ligne;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 29,
      "text": "Gaae ind imellem dem, tal med hver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 29,
      "text": "Det er de Mænd, vi velsigne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 29,
      "text": "De stred og døied og udholdt, som Faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 29,
      "text": "Og vide selv ikke, hvor store de staae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 29,
      "text": "Den fineste Frøkens Rosenmund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 29,
      "text": "Kunde kysse Soldaten i denne Stund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 29,
      "text": "Hurra! Hurra! I herlige, brave Soldater!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 30,
      "text": "Med Seirens Grønt Soldaterne hjemdrage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 30,
      "text": "En Jubel gjennem hele Danmark gaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 30,
      "text": "Og sindrigt, smukt, just mellem disse Dage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 30,
      "text": "Det være maa, din Hæders Festdag staaer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 30,
      "text": "Du ogsaa ærligt kjæmped’ for det Sande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 30,
      "text": "Alt Godt og Herligt tjente Du saa tro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 30,
      "text": "Velsignet er rundtom i Kongens Lande",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 30,
      "text": "Din Virken i halvtredsindstyve Aar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 31,
      "text": "Din Daad er gjemt i Frugter, der vil trives,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 31,
      "text": "Dit Navn det staaer i Slægters Kjærlighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 31,
      "text": "Men ingen Kjærlighed dog større gives",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 31,
      "text": "Til Dig, end den, Du i vort Hjerte veed;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 31,
      "text": "Vi, dine Nærmeste, vi Lykkelige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 31,
      "text": "Som dagligt see Dig, dagligt staae Dig nær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 31,
      "text": "Tæl os, som Sjæle i dit Hjerte-Rige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 31,
      "text": "Saa inderligt vi holde af Dig hver.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 32,
      "text": "See med os mange Aar det Foraars-Grønne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 32,
      "text": "Der opad Muren groer til Spurvens Ly,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 32,
      "text": "Hør med os Fredens Klokker for det Skjønne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 32,
      "text": "Pluk Frugter af det Gode i det Ny.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 32,
      "text": "Med Seiers Blomst staaer Thyras »Vang og Vænge«,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 32,
      "text": "Du ogsaa, Oldefader, evig ung;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 32,
      "text": "Du leve med os, leve for os længe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 32,
      "text": "Hurra! da er os ingen Sorg for tung!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 33,
      "text": "»Blomster elsked hun og Blomster være",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 33,
      "text": "Som et Tæppe over Kisten lagt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 33,
      "text": "Toner elsked hun og Toner bære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 33,
      "text": "Vort Farvel, igjennem Taarer bragt!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 34,
      "text": "Han var saa sand, han var saa eiegod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 34,
      "text": "Et Barne-Sind og dog den dybe Tænker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 34,
      "text": "For ham i denne Verden klart det stod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 34,
      "text": "Hvad Gud til Mængden først bag Døden skjænker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 34,
      "text": "Han var et Fjeld i Danmark, seet vidt om,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 34,
      "text": "De Vises Steen i dette Fjeld var inde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 34,
      "text": "Hvor var han kjærlig, ligefrem og from,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 34,
      "text": "Og dog saa stor! han glemmes ingensinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 34,
      "text": "Thi ved hans Tankelyn et Lys blev tændt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 34,
      "text": "Der viser Skatte, saa umaalelige!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 34,
      "text": "Og han var Danmarks Søn, fra Ringhed sendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 34,
      "text": "En Konge dog, og det i Aandens Rige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 34,
      "text": "Hans Liv er sluttet her, saa godt og smukt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 34,
      "text": "Hans Navn, den Stjerne bliver aldrig slukt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 34,
      "text": "– For os, som stod ham nær, ham voxed` fast,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 34,
      "text": "En Deel af Verden med hans Hjerte brast.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
