      "text": "af min Elskedes fod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 10,
      "text": "gør mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 10,
      "text": "overflødig af henrykkelse -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 10,
      "text": "nu kaster",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 10,
      "text": "landgangen, spændt til",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 10,
      "text": "fanfare under min",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 10,
      "text": "Elskedes fod, alt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 10,
      "text": "det frygtelige, det",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 10,
      "text": "som hver eneste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 10,
      "text": "sjæl vil genkende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 10,
      "text": "som sig selv i",
      "part": false,
      "marginal_notes": []
    },
