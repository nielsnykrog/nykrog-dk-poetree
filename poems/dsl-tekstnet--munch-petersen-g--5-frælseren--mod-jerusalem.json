      "text": "med alt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 10,
      "text": "hvad endnu aldrig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
