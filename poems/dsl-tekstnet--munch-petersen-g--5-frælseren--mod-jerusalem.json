    {
      "id": 130,
      "stanza_id": 10,
      "text": "nyt's triumfexpres,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 10,
      "text": "bæres jeg af lethed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 10,
      "text": "umærkeligere end min",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 10,
      "text": "Elskedes",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 10,
      "text": "altforløsende landgangsfod -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 10,
      "text": "Det Sidste Riges",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 10,
      "text": "Banner bores",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 10,
      "text": "dirrende gennem verdens",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 10,
      "text": "hjærte -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 10,
      "text": "NU",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 10,
      "text": "vilde min",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 10,
      "text": "Elskede se mig -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 10,
      "text": "til støv vorden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 10,
      "text": "at se Dette,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 10,
      "text": "stiler jeg hastigere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 10,
      "text": "end alt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 10,
      "text": "uden farve",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 10,
      "text": "uden øjne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 10,
      "text": "uden ild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 10,
      "text": "at tænde min",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 10,
      "text": "Elskedes bud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 10,
      "text": "paa en anden maane,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 10,
      "text": "hvis hjærte endnu",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 10,
      "text": "gisper,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 10,
      "text": "endnu, ENDNU!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 11,
      "text": "find mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 11,
      "text": "søg mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 11,
      "text": "Elskede - !",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 11,
      "text": "eller jeg hader,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 11,
      "text": "hader dig som sejrens",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 11,
      "text": "overflødige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 11,
      "text": "paradis -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 11,
      "text": "find mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 11,
      "text": "søg mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 11,
      "text": "mig støvet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 11,
      "text": "gjort af intet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 11,
      "text": "til alt -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 11,
      "text": "Elskede, skal",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 11,
      "text": "jeg hade dig til",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 11,
      "text": "mindre end",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 11,
      "text": "støv -?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 11,
      "text": "hør:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 11,
      "text": "der findes ingen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 11,
      "text": "sejr!!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 12,
      "text": "stormfuglen har aldrig taget et vingetag -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 12,
      "text": "stormfuglens vinger har aldrig rørt sig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 12,
      "text": "flagrende eller værdigt -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 12,
      "text": "stormfuglens vinger er et tilbageholdt aandedrag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 12,
      "text": "staar stille -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 13,
      "text": "stormfuglen avancerer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 13,
      "text": "uden et vingetag tværs igennem stormen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 13,
      "text": "mod solens vrag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 13,
      "text": "for at skrige opstandelsen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 13,
      "text": "tusen aar for tidligt -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 14,
      "text": "my infinite world is",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 14,
      "text": "in the closed egg of my will towards god -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 15,
      "text": "every finished piece",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 15,
      "text": "of joy and clean bitterness",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 15,
      "text": "is put aside on the deep bottom of the sacred eye -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 16,
      "text": "always has god's heat been over me and",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 16,
      "text": "shall always be till perfection breaks through",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 16,
      "text": "the vast forest of my world -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 17,
      "text": "his face is of no use for my timefilling work -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 17,
      "text": "at some close or approaching time",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 17,
      "text": "the egg of my world will open,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 18,
      "text": "my work shall stop -,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 18,
      "text": "and eternal repeating of that single act of god,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 18,
      "text": "which is me,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 18,
      "text": "shall be the sign that my will may go -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 19,
      "text": "rocky souls on the way, where",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 19,
      "text": "supreme delight",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 19,
      "text": "is but beautifying sleep -,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 19,
      "text": "such is my love",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 20,
      "text": "that if you are stricken with mortal pain",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 20,
      "text": "because of me,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 20,
      "text": "it is a thousand times better than",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 20,
      "text": "had you never met me -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 21,
      "text": "if with unclean hands",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 21,
      "text": "I steal your sacred crown,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 21,
      "text": "you shall be a thousand times more pure,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 21,
      "text": "when I have left -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 22,
      "text": "and if for my joy",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 22,
      "text": "you are killed in the meanest way,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 22,
      "text": "by my hand your lips shall reach,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 22,
      "text": "awakening, the brow of The Most High -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 23,
      "text": "listen, every lonesome rocky soul:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 23,
      "text": "not one minute anyone of you are left -!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 23,
      "text": "such is my love for each of you -",
      "part": false,
      "marginal_notes": []
    }
  ]
}
