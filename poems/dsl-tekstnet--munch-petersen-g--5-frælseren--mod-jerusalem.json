      "text": "forhænget",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "fra de evige haver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "skal en due æde",
      "part": false,
      "marginal_notes": []
    },
    {
