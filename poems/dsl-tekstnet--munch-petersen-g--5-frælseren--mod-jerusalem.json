      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 8,
      "text": "i renede hænder -, og",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 8,
      "text": "din død vil",
      "part": false,
      "marginal_notes": []
    },
