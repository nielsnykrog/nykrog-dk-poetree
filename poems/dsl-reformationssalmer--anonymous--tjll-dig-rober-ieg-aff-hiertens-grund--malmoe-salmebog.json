  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "TJll dig rober ieg aff hiertens grund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "O herre Gud du hør min røst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "lad op din øren i denne stund/",
      "part": false,
      "marginal_notes": [
        "Psal cxliii"
      ]
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "oc hør bøn oc ver min trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Thi om du vilde mig døme ret/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "effter min ondskab som ieg haffuer fortient/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "da er ieg borte met alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Hoss dig duer ey vden miskundhed/",
      "part": false,
      "marginal_notes": [
        "Esaie lxiiii Philp iii"
      ]
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "vore synder ath forlade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "forgeffs er all wor hellighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "du vilt hannem intet haffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "J din aasyn ey funden vaar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "nogit menniske ren eller klar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "de ere syndere alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "For den skyld vil ieg sette mit haab/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "till Gudz miskund oc naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "oc ey til min verdskyld eller raad/",
      "part": false,
      "marginal_notes": [
        "Hiere xvii"
      ]
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "thi det er ey vden vaade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Gud haffuer mig iætt den euige ro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "det er min trøst och stadelige tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "hans ord kan icke liwe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Oc om ieg skulde en bie til queld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "oc indtil morgen stierne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "mit haab ieg aldrig forlade vil/",
      "part": false,
      "marginal_notes": [
        "Abacuc ii Psal xxii Psal cxliii"
      ]
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "ieg vil hannem tro saa gerne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Som hans folk Jsrael haffuer giort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "aff hiertens grund som vi haffue spurt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "han vor deris haab all ene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Thi han er mild oc miskundelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "han er all fuld aff naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "han vil aff reth barmhiertighed/",
      "part": false,
      "marginal_notes": [
        "Psal xxxiiii Titum iii Joan i Coloss i"
      ]
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "vaare synder alle forlade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Thi han er det vskyldige lam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "som oss aff dieffuelsens fengsel nam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "oc giorde oss klare och rene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Gud fader Søn och den Helligand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "hannem ville wi prise och ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "thi oss haffuer ingen frelst vden hand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "som wiaff skrifften lære/",
      "part": false,
      "marginal_notes": [
        "Deu xxxii",
        "Esa xlii"
      ]
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "Thi bør hannem loff oc tack allene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "til euig tid for vden men/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "der til sige wi nu AMEN",
      "part": false,
      "marginal_notes": []
    }
  ]
}