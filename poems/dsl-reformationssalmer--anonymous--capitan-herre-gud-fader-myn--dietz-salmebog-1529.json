  "source": {
    "id": null,
    "title": "Een ny handbog med Psalmer oc aandelige lofsange",
    "year_published": 1529,
    "publisher": "Ludwig Dietz",
    "printer": "Ludwig Dietz",
    "place": "Rostock",
    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/dietz-salmebog-1529/8/15"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "CApitan Herre Gud fader mÿn:",
      "part": false,
      "marginal_notes": [
        "Psal. xliij."
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "vdsen meg naaden thÿn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "then stund ieg her ÿ liffue er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Stor wildelse nw ÿ werden er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "miskunde oss Herre kiær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "att meg reghere thÿn ord oc lære/",
      "part": false,
      "marginal_notes": [
        "Psal. xxiiij"
      ]
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Kundgiør meg Herre then rette grund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "then stund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "her er then største nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "thÿn hellige ord forholt meg ey/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "ret wæy til liffuit giennom døden wd:",
      "part": false,
      "marginal_notes": [
        "Johan. xiiij."
      ]
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "æstw allene mÿn Herre oc Gud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Sig skynder fast then forsagde tÿd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "O Herre giør oss frÿ/",
      "part": false,
      "marginal_notes": [
        "Mat. xxiiij"
      ]
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "fraa alt ont bode till liff oc siæl/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "J all wor nød wÿ til teg fly/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "thÿn naade begære wÿ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "frels oss o Herre fraa werdzens qwal/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "oc wær oss alle miskundelig/",
      "part": false,
      "marginal_notes": [
        "Coloss. j."
      ]
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "forlÿg oss Herre formiddels thÿn søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "att wÿ kunde rett bliffue Christen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "vden meen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "thet er mÿn begere oc bøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "hielp att wÿ alle thÿn wilie giøre kunde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Meer gørs behoff att bede teg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "O Herre forlad ey meg/",
      "part": false,
      "marginal_notes": [
        "Psal. xxvj."
      ]
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "tw som sckapt haffuer alle ting/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "lad meg faa aff thÿn wÿsdom hÿd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "oc gack ey bort fraa meg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "med thÿn naade mit hierte wend omkring/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "oc skab ÿ meg een retter aand/",
      "part": false,
      "marginal_notes": [
        "Psalmo. j. Psalm. xxx"
      ]
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "tw kan/ wel wede huad meg giør møde oc wande/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "thÿ alt mit haab haffuer ieg til teg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 2,
      "text": "kom meg til trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 2,
      "text": "Herre Jesus Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 2,
      "text": "thÿ tw allene wor frelser æst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "Marck/ stæder/ oc all mÿne vndersaat/",
      "part": false,
      "marginal_notes": [
        "Deut. xvij."
      ]
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "haffuer ieg aff teg faat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "beskerm them alle for falske lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "Herre Gud her er nw kommen fram/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 3,
      "text": "een onder sedwan forwar oss alle ÿ thÿn ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 3,
      "text": "Tag thÿn hellig ord oc webne oss med/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 3,
      "text": "paa thet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 3,
      "text": "att dieffuelen oss ey beswige kan/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 3,
      "text": "med werdzlig praal oc menniskens tant/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 3,
      "text": "optend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 3,
      "text": "oss alle til saadan begære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 3,
      "text": "Att wor tro kunde rett til teg eene wære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 4,
      "text": "Greffuer/ Herrer/ Ridder oc Knechte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 4,
      "text": "oc alle slecte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 4,
      "text": "beffal ieg teg mÿn Herre oc Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 4,
      "text": "forøg wor tro oc giør henne ret/",
      "part": false,
      "marginal_notes": [
        "Luce. xvij."
      ]
    },
    {
      "id": 52,
      "stanza_id": 4,
      "text": "then werden haffuer forget/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 4,
      "text": "Jeg beder teg for thÿn horde død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 4,
      "text": "forlad oss ey ÿ saadan sorg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 4,
      "text": "langt før haffuer tw thet sielluff forkyndet/",
      "part": false,
      "marginal_notes": [
        "Mat. xxiiij Acto. xx."
      ]
    },
    {
      "id": 56,
      "stanza_id": 4,
      "text": "att falske Propheter skulde komme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 4,
      "text": "siynes fromme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 4,
      "text": "som faar men indwortis vlffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 4,
      "text": "som schrifften vdwÿser/ oc wÿ haffue befundit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 5,
      "text": "Til thÿn store barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 5,
      "text": "huilken allene teg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 5,
      "text": "opdrog paa korsit for wore synder sleet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 5,
      "text": "Jeg flyer til teg o Herre ÿ thit skød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 5,
      "text": "aldrig offuergiff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 5,
      "text": "Jeg maner teg for thÿn Guddoms foriæt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 5,
      "text": "then tw haffuer loffuit for langen tÿd/",
      "part": false,
      "marginal_notes": [
        "Hier. xxxj."
      ]
    },
    {
      "id": 67,
      "stanza_id": 5,
      "text": "til teg rober nw saa mangen bedrøffuit aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 5,
      "text": "Oplad thÿn ørhen oc hør wor røst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 5,
      "text": "oc trøste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 5,
      "text": "oss med thÿn godhed alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 5,
      "text": "Beskerm oss att wÿ icke ÿ falsk tro falle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 6,
      "text": "Brendemercke haffue the ÿ theris samwit/",
      "part": false,
      "marginal_notes": [
        "j. Tim. iiij."
      ]
    },
    {
      "id": 73,
      "stanza_id": 6,
      "text": "som oss haffue wrett lid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 6,
      "text": "for them sancte Powel beder oss att tage ware/",
      "part": false,
      "marginal_notes": [
        "ij. Petri. iij."
      ]
    },
    {
      "id": 75,
      "stanza_id": 6,
      "text": "The haffue forwent then hellige schrifft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 6,
      "text": "med theris falske dicht/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 6,
      "text": "O Herre frels oss for thÿn pÿne swar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 6,
      "text": "see her nid til oss thÿne fattige faar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 6,
      "text": "tw haffuer betalid for all wor synd/",
      "part": false,
      "marginal_notes": [
        "j. Timot. ij."
      ]
    },
    {
      "id": 80,
      "stanza_id": 6,
      "text": "Christus haffuer oss med teg forlÿgt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 6,
      "text": "thet bewÿss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 6,
      "text": "sancte Powel med schrifft oc mund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 6,
      "text": "Forwar oss ÿ thÿn naade alle stund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 7,
      "text": "Then rette tro wÿ bede aff teg/",
      "part": false,
      "marginal_notes": [
        "Marci. ix. Daniel. ix."
      ]
    },
    {
      "id": 85,
      "stanza_id": 7,
      "text": "hør oss nw Herre kiær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 7,
      "text": "før en døden oss omkuldstøder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 7,
      "text": "til thÿn miskund/ wort haab haffue wÿ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 7,
      "text": "aff hiertens begær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 7,
      "text": "O Herre wÿ ere saa ynckelige forførde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 7,
      "text": "fraa thÿn naade till wore eghne gierninger/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 7,
      "text": "thÿ styrck oss att wÿ kunde allene til teg/",
      "part": false,
      "marginal_notes": [
        "Psal. cxviij"
      ]
    },
    {
      "id": 92,
      "stanza_id": 7,
      "text": "haffue all wor tro oc haabit wort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 7,
      "text": "thÿne ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 7,
      "text": "ere sandhed wisselig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 7,
      "text": "Giff oss att wÿ maa leffue ewindelig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 8,
      "text": "Borger ret giff oss ÿ thit rÿge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 8,
      "text": "oc giør oss lÿge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 8,
      "text": "oc statt med oss alt ind til enden:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 8,
      "text": "att diefflene oss ey besuige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 8,
      "text": "O Herre ey fraa oss wige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 8,
      "text": "thÿn naadelige øgen ey bort fraa oss wende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 8,
      "text": "att nar wÿ komme ÿ wor yderste nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 8,
      "text": "att døden med grumhed wil oss tage fatt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 8,
      "text": "saa redde tw oc wer wor skiold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 8,
      "text": "Herre bold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 8,
      "text": "wÿ bede teg alle med graad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 8,
      "text": "Jeg beder for alle mÿne vndersaat.",
      "part": false,
      "marginal_notes": []
    }
  ]
}