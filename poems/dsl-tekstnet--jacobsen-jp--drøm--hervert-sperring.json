  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Bliv, o bliv i dine Drømmes Verden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Hig ej mod Livets virkelige Færd!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Det har kun Nats og Middagslysets Farve,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Drømmen har ene Morgenrødens Skjær; -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Dør du og har levet, død er du Livets,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Aanden vil da søge til Jorden igjen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Dør du som Drømmer, dø da kan du rolig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Hele din Verden med dig blegner hen.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
