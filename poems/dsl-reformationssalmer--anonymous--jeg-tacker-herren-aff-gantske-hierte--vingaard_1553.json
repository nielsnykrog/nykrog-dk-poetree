  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "JEg tacker Herren aff gantske hierte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "i de frommes raad oc i forsamlingen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Drabelige ere Herrens gerninger/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "ho dem acter/ han haffuer idel løst der aff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "⁕ Huad han skaffer det er hederligt oc ærligt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "oc hans retferdighed bliffuer euindelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Han haffuer stictet sine vnderlighede en ammindelse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "den naadige oc barmhiertige Herre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "⁕ Han giffuer dem næring som frycte hannem/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Euindelige tencker han paa sin Pact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Sine veldige gierninger lader han kundgøre sit Folck/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "at han vil giffue dem Hegningernis arff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "⁕ Hans henders handel er idel Sandhed oc ræt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Alle hans befallinger ere retskaffne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Stedze till euig tid bliffue de bestandige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Och ske met Trofasthed oc relighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "⁕ Han sender sit Folck en forløssning/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "han loffuer/ at hans pact skal bliffue euindelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Helligt och herligt er hans Naffn/ Herrens fryct er begyndelsen och visdom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Det er en kostelig kloghed/ huo der gør effter/ hans loff bliffuer euig.",
      "part": false,
      "marginal_notes": []
    }
  ]
}