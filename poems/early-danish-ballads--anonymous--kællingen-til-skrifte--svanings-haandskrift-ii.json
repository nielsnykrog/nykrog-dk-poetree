    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVII10.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Kierlingen sad paa brandspid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": ":: tred her met skel ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "oc ind da kam hindis nabo kone:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: \"Hui sidder I her? ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Ieg haffuer det hørd, ieg haffuer det spurd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "din daatter hun haffuer barsel giort.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": ":: Hui varr du icke der?\" ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Hun molcket foer oc fede nød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "hun saatte det paa ilden, hun giorde aff grød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": ":: De smaget saa vel. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "Hun tog den grød op vnder sin skød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "saa gaar hun til barsel by.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": ":: Saa maatte hun vel. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "Der hun kam paa heden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "hun møtte den hoffmand vrede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": ":: Hand red saa vel. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "\"Hel møt, hel møt, gammel trip,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "huad saa haffuer due i din bøt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": ":: Du giff mig det.\" ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 6,
      "text": "\"Ieg haffuer intet vnder min skød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "foruden en bøt met barsel grød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 6,
      "text": ":: De smagtr saa vel.\" ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 7,
      "text": "Hand giorde den kierling saa megen meen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "hand slog den grød emod den steen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 7,
      "text": ":: Nu ligger de der. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 8,
      "text": "Hand giorde den kierling saa megen harm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 8,
      "text": "hand røckte den ost vdaff hendis barm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 8,
      "text": ":: Den daat saa vel. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 9,
      "text": "\"Hoffmand, hoffmand, var din liff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 9,
      "text": "ieg haffuer i haanden en stumpet odde kniff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 9,
      "text": ":: Ieg sticker dig ihiel.\" ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 10,
      "text": "\"Ieg haffuer værit i saa mange et kiff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 10,
      "text": "ieg vaar icke red for quinder kniff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 10,
      "text": ":: Icke helder for din.\" ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 11,
      "text": "Den hoffmand red met skafft oc spiud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 11,
      "text": "den kierling haffde icke vden en stumpet kniff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 11,
      "text": ":: Hun stack ham ihiel. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 12,
      "text": "Buckskind støffuel drog hun paa been,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 12,
      "text": "forgylte spore spent hun igien.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 12,
      "text": ":: Hun red saa vel. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 13,
      "text": "Hun satte sig paa hans ganger graa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 13,
      "text": "saa red hun til bispens gaard.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 13,
      "text": ":: Hun red saa vel. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 14,
      "text": "Der hun kam til borgens led,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 14,
      "text": "vd stod bispen, huiler sig ved.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 14,
      "text": ":: Hand stod saa vel. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 15,
      "text": "Kierling faldt for bispen paa kne:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 15,
      "text": "\"Min naadige herre, ***",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 15,
      "text": ":: I skrøffter mig vel.\" ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 16,
      "text": "\"Huad haffuer du til synde giordt?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 16,
      "text": "\"Ieg haffuer saa fri en hoffmand mørd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 16,
      "text": ":: Hand red saa vel.\" ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 17,
      "text": "Hun fick icke for den hoffmands død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 17,
      "text": "foruden tre fredag flesk oc brød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 17,
      "text": ":: Saa maatt hun vel. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 18,
      "text": "Kierlingen tiener i bispens gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 18,
      "text": "hun driffuer de andre hoffmend for had.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 18,
      "text": ":: Saa maatte hun vel. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 19,
      "text": "Huilcken hoffmand hinde taler emod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 19,
      "text": ":: tred her met skel ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 19,
      "text": "hun tager dem i haar, hun slaar dem emod iord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 19,
      "text": ":: Saa maatt hun vel. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}