  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Zephir, hvorhen vil Du gaae?",
      "part": false,
      "marginal_notes": [
        "Speaker: ROSERNE"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Til de vandrende Piger, der staae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Med den kobberne Konka om Vældet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Der, hvor Cactussen groer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Hvor den kraftige Ranke sig snoer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Om Olietræet ved Fjeldet?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Bliv dog og see paa os og vor Pynt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Siig os dog lidt! de har nyligt begyndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Og Du jo veed, de har meget at tale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Thi Giovanni gik nyligt forbi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Blæste for dem en smuk Melodie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Kjendt i Albanernes Dale. –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Tusinde Kys kan endnu Du faae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Blunde paa Barmen, der rødmer og bæver. –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Nei, hvor han svæver!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Hører slet ikke os Sødskende smaa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "– Hvor har Du været? Hvad har Du øvet?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Vaad er Din Vinge, Du er bedrøvet!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Du blev nok dykket lidt, som det lader,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "Nede i Søen, hvor Pigen sig bader.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "Snildt skulde Du, som Maleren der,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "Holdt Dig bag ved de grønne Træer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "Bølgen ei gjorde min Vinge vaad!",
      "part": false,
      "marginal_notes": [
        "Speaker: ZEPHIR"
      ]
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "Det er Graad, Brødrenes Graad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 1,
      "text": "Did vi jo gik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 1,
      "text": "Hvor hun sad for den gabende Vrimmel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 1,
      "text": "Og med Uskyldigheds Blik",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 1,
      "text": "Saae mod Guds Himmel. –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 1,
      "text": "Og da hun knælede, fromt, uforfærdet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 1,
      "text": "Sprudlede Blodet for Bøddelsværdet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 1,
      "text": "Intet Tausheden brød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 1,
      "text": "– Beatrice er død!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "Død! er hun død?",
      "part": false,
      "marginal_notes": [
        "Speaker: ROSERNE"
      ]
    },
    {
      "id": 33,
      "stanza_id": 2,
      "text": "Hun, som intet forbrød! –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 2,
      "text": "Skal vi ei meer, her hvor Pilene græde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 2,
      "text": "See hendes Smiil, hendes barnlige Glæde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 2,
      "text": "Skal vi ei høre Fromheden bede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 2,
      "text": "Mens for Madonnas Billed dernede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 2,
      "text": "Deiligt i Aftenen Børnenes Klynge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 2,
      "text": "Lovsangen synge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 2,
      "text": "Ak, hun er død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 2,
      "text": "Hun, som intet forbrød!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 2,
      "text": "Her vi jo hørte Faderens Brynde –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 2,
      "text": "– Synden hun dræbte, er det at synde?",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
