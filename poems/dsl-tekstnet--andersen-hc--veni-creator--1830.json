{
  "id": null,
  "title": "»Veni creator«",
  "year_created": 1830,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1830,
    "url": "https://tekstnet.dk/books/andersen-hc_veni-creator/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "I Dalen staaer et Kloster hist i den frie Natur;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Med modne Druer slynger sig Ranken om dets Muur;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "For Billedet i Nischen hver Vandrer bøier Knæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Mens Fuglen synger Hymner høit i det grønne Træ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Bag Hyttens Dør staaer Bonden, han har den halv paa Klem;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Hvidklædt’ de blege Nonner fra Klostret skride frem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Den spæde Haand er bunden, hvor Friheds-Træet groer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "»Veni creator!« synge de Alle høit i Chor.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Paa Torvet bølger Vrimlen ret som en oprørt Sø. –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "– For hos sin Gud at leve, maa man paa Jorden døe!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Det er den glade Tanke, som giver Hjertet Mod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Skjøndt Bøddel-Øxen damper alt med det røde Blod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "»Veni creator!« toner – nu vinker Livets Dag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Een Stemme høres mindre ved hvert et Øxe-Slag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Det dæmpes meer og mere – hør end den Sidstes Sang –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "– Med Eet det bliver stille – man hører Øxens Klang.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
