  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "JSraels vdgaang aff Egipten/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "och Jacobs huss fra det groffue folck.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Da er kommen Juda til sin hellighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "oc Jsrael til sin veldighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "⁕ Det saa Haffuit oc flyde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "och Jordan vende sig tilbage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "⁕ Biergene haffue sprungit som bucke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "oc Tuerne som de vnge Lam",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "O Haff huad er dig at du flyde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "oc du Jordan at du komst tilbage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 5,
      "text": "⁕ Oc i Bierg at i haffue sprungit som Bucke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "oc i Tuer som de spæde lam",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 6,
      "text": "⁕ Jorden skelffuer for Herrens Ansict oc for Jacobs Gudz ansict",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 7,
      "text": "⁕ Huilcken som haffuer vent stenen til en Sø/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 7,
      "text": "oc klippen til vandsens Kielder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 8,
      "text": "⁕ Jcke oss o Gud icke oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 8,
      "text": "men dit naffn giff den ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "paa den barmhiertighedz oc sandheds vegne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 9,
      "text": "⁕ Ath Folckene skulle icke sige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "huor er nu deris Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 10,
      "text": "⁕ Men vor Gud er i Hiemmelen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 10,
      "text": "alting haffuer han giort effter sin vilge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 11,
      "text": "⁕ Deris affguder er Sølff oc Guld som ere Menniskens gerninger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 12,
      "text": "⁕ De haffue Mund oc kunde icke tale",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 12,
      "text": "de haffue øyen oc kunde icke see",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 13,
      "text": "⁕ De haffue øren oc kunde icke høre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 13,
      "text": "de haffue Næse oc kunde icke lucte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 14,
      "text": "⁕ De haffue hender oc kunde icke føle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 14,
      "text": "de haffue føder oc kunde icke gaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 14,
      "text": "de kunde icke raabe i deris strube",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 15,
      "text": "⁕ Lige dem skulle de bliffue som dem giort haffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 15,
      "text": "oc alle de som paa dem haabe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 16,
      "text": "⁕ O du Jsraels huss haabe til Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 16,
      "text": "han er din hielpere oc beskermere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 17,
      "text": "⁕ O du Aarons huss forlad dig paa Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 17,
      "text": "han er din hielpere oc beskermere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 18,
      "text": "O i gudfryctige forlader eder paa Herren/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 18,
      "text": "thi han er eders hielpere oc beskermere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 19,
      "text": "⁕ Herren haffuer kommet oss i hu/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 19,
      "text": "oc haffuer benedidet oss alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 20,
      "text": "⁕ Han haffuer velsignet alle de Gudfryctige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 20,
      "text": "saa vel de smaa som de store",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 21,
      "text": "⁕ Gud som forøger eder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 21,
      "text": "han formere eder oc alle eders Børn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 22,
      "text": "⁕ J ere benedide aff Herren/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 22,
      "text": "som skabte Hiemmelen oc Jorden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 23,
      "text": "⁕ Hiemmelens Hiemmel er Herrens/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 23,
      "text": "Jorden haffuer han giffuit Menniskens Sønner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 24,
      "text": "⁕ De døde loffue dig icke Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 24,
      "text": "Jcke heller alle de som nedfare til Helffuede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 25,
      "text": "⁕ Men wi som leffue benedide Herren",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 25,
      "text": "fra nu oc ind til euig tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 26,
      "text": "⁕ Ere vere Gud Fader oc Gud Søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 26,
      "text": "oc saa Gud den Helligaand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 27,
      "text": "⁕ Som verit haffuer aff begyndelsen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 27,
      "text": "nu oc altid er oc bliffuer til euighed Amen",
      "part": false,
      "marginal_notes": []
    }
  ]
}