  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Maagen skreg over Havets Spejl:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Skipper, tag ind dit hvide Sejl.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Skipperen gabed og strakte sig doven:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Maage, hold Mund med dit Skrig foroven. -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Skipper, Skipper, tag Sejlet ind!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Jeg spaar Dig, der kommer en Hvirvelvind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Snak, Du Tosse, det kjender Du ej;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "hvo er vel Skipper, Du eller jeg?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "- Hu! da foer over Havet Blæsten,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Skibet forgik i Bølgerne næsten -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Maagen rundt omkring Skibet fløj:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Naa, kan Du se, at jeg ikke løj!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Gode Raad bør man altid høre!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "- Da kløede sig Skipperen bag sit Øre.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
