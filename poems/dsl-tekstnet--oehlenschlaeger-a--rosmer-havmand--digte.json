{
  "id": null,
  "title": "Rosmer Havmand",
  "year_created": 1803,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Adam Oehlenschläger",
    "country": null,
    "wiki": "Q168356"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Digte",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1803,
    "url": "https://tekstnet.dk/books/oehlenschlaeger-a_digte/020/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Konning Uller er sig i Hu saa mod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "han sidder ved Midienat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Mens Maanen langsomt gaaer op i Blod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "rinder paa Kinden hans Taare brat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Vemodigt lyder hans Harpe i Lunden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Elina, den Elskede, er forsvunden!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Min Roe er borte, en rasende Ild",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "har tændt sig dybt i min Barm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Den ulmer og flammer saa vild saa vild!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Den spender til Vrede min matte Arm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Jeg vil tumle som de oprörte Tanker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "giennem fraadende Hav, paa bristende Planker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "De reise paa Dækket den gyldne Mast,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "de spænde de Silkeseil ud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Nu ville vi alle staae Last og Brast,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "og roligt vente paa Skiebnens Bud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "De brændende Hierter, som Kummer fordölge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "kan kun indlulles blidt af den rasende Bölge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Det er lutter unge behiertede Mænd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "som misted den elskede Möe;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "som har intet at önske paa Jorden igien",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "uden Favn mod Favn med hinanden at döe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "De hige, mens varslende Vinde larme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "efter at styrte i Havgudens kiölende Arme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Masten splintredes, Roret brak!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 4,
      "text": "Christ frels os, nu er det forbi!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 4,
      "text": "Masten styrtede, Skibet sprak!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 4,
      "text": "I vakkre Brödre! hist samles vi.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Den skumklædte Bölge sig over dem lukker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "Dybet de luende Hierter slukker!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 5,
      "text": "Giennem dybe, klare Blaae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 5,
      "text": "synker Kongen ned i Sandet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 5,
      "text": "Nattens blanke Stierner smaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 5,
      "text": "kan han skimte giennem Vandet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 5,
      "text": "Paa en Eng af Blomster fuld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "sidder han paa grönne Tue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "Havet hæver sig saa huld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "som en sölvblaa Himmelbue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "Men et selsomt Trylleflor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "slörer dog den hele Scene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "dækker Himmel, Hav og Jord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "alting, kun ei ham allene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 5,
      "text": "I den milde Sommerdag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 5,
      "text": "staaer Naturen klar og rolig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 5,
      "text": "Hist et guldudhamret Tag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "hvælver om en stille Bolig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "Uller sagte gaaer derind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "söde Toner kan han höre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 5,
      "text": "Rosen livnes paa hans Kind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 5,
      "text": "Sangen er bekiendt hans Öre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 5,
      "text": "Dören svævende gaaer op.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 5,
      "text": "Med uskyldig Englemine,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 5,
      "text": "som en svulmet Rosenknop",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 5,
      "text": "smiler for hans Blik Eline.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 5,
      "text": "Taus hun synker til hans Bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 5,
      "text": "taus hensvæve de i Dalen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 5,
      "text": "deres Hierters höie Lyst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 5,
      "text": "tolkes kun af Nattergalen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 5,
      "text": "Ved den skyggefulde Hæk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 5,
      "text": "som bortvifter hede Straaler,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 5,
      "text": "sætte de dem ved en Bæk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 5,
      "text": "mellem duftende Violer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 5,
      "text": "Om den runde, hvide Arm",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 5,
      "text": "slutter fine Silkesömme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 5,
      "text": "i den höie fulde Barm",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 5,
      "text": "ruller Issens gyldne Strömme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 5,
      "text": "Med den milde Rosenmund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 5,
      "text": "hun sin Skiebne ham fortæller.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 5,
      "text": "Taus tilhörer stille Lund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 5,
      "text": "Almen lyttende sig hælder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 6,
      "text": "En Sommeraften, klar og huld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 6,
      "text": "da sad jeg ved den svale Strand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 6,
      "text": "I Silke vandt jeg pruden Guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 6,
      "text": "mildt kruste sig det stille Vand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 7,
      "text": "Da dreied i det Sölverblaae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 7,
      "text": "sig Söen pludselig saa rund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 7,
      "text": "Vidt bredte sig de Kredse smaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 7,
      "text": "det vifted stærkt fra Strand og Lund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 8,
      "text": "Da skildte Vandet sig til Bund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 8,
      "text": "som fordums Tid det röde Hav;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 8,
      "text": "en Kiempe fra den vaade Grund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 8,
      "text": "steeg langsomt af sin dybe Grav.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 9,
      "text": "Da hæved Stormen sig saa vild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 9,
      "text": "da sortned Himmelen saa brat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 9,
      "text": "kun Stiernen med sin Purpurild",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 9,
      "text": "nedlued i den sorte Nat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 10,
      "text": "Jeg skimted ham saa bleg og hvid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 10,
      "text": "Et Öie kun i Panden stod;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 10,
      "text": "han nærmede sig langsomt hid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 10,
      "text": "hans Öie ludede med Blod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 11,
      "text": "Sin stærke Arm han om mig svang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 11,
      "text": "saa sprang han i den salte Söe!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 11,
      "text": "Tæt luktes höie Bölgegang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 11,
      "text": "Jeg troede sikkerlig at döe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 12,
      "text": "Da Elskte! blandte sig for dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 12,
      "text": "min Taare med det salte Hav.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 12,
      "text": "Gud Fader udi Himmerig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 12,
      "text": "lovpriset vær! du tog, du gav.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 13,
      "text": "Den stærke Havmand som et Lyn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 13,
      "text": "stak ned i Dybet paa en Hval.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 13,
      "text": "Jeg studsed ved det sieldne Syn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 13,
      "text": "Han bragte mig til denne Sal.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 14,
      "text": "Et Aar jeg er paa Havsens Bund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 14,
      "text": "og Rosmer trykker hver en Nat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 14,
      "text": "eet isnet Kys kun paa min Mund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 14,
      "text": "og spörger: Har du mig forladt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 15,
      "text": "Og skiönt han er saa blid og mild",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 15,
      "text": "saa svarer jeg dog altid: Nei!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 15,
      "text": "Da slukker sig hans Öies Ild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 15,
      "text": "han sukker dybt og gaaer sin Vei.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 16,
      "text": "Jeg hörer ham da Harpen slaae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 16,
      "text": "Snart lyder den som Kildevæld;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 16,
      "text": "snart som naar dybe Elve gaae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 16,
      "text": "om Natten i det hule Field.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 17,
      "text": "Kong Uller smiler glad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 17,
      "text": "af Fryd Elina skielver.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 17,
      "text": "Da skilles Havet ad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 17,
      "text": "som sig i Luften hvælver.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 18,
      "text": "En Skye saa sort og stor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 18,
      "text": "Vandbuen giennembröd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 18,
      "text": "Sin Arm Elina snoer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 18,
      "text": "om Uller i sin Nöd!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 19,
      "text": "See Skyen vælter frem!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 19,
      "text": "Flye, Elskte! vær ei seen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 19,
      "text": "thi kommer Rosmer hiem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 19,
      "text": "han steger dig paa Teen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 20,
      "text": "Fra Græsset Uller sprang:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 20,
      "text": "Han paa sit Glavind slog;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 20,
      "text": "Det er ei förstegang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 20,
      "text": "at jeg en Kiempe vog!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 21,
      "text": "Ak var din Arm en Storm",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 21,
      "text": "og var dit Sværd et Field,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 21,
      "text": "den höie Rosmer Kong",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 21,
      "text": "du slogst dog ei ihiel.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 22,
      "text": "Ved skiön Elinas Ord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 22,
      "text": "Kong Uller undres saare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 22,
      "text": "En Skræk ham giennemfoer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 22,
      "text": "ved hendes salte Taare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 23,
      "text": "Ak hvis du skulde döe!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 23,
      "text": "Kom, Elskte! lad os gaae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 23,
      "text": "Den bange Fæstemöe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 23,
      "text": "ham skiuler i en Vraa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 24,
      "text": "Da svulmer Hiertet ham.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 24,
      "text": "Sin Harm han ei kan dæmpe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 24,
      "text": "Han siger; Det er Skarn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 24,
      "text": "at vige for en Kiempe!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 25,
      "text": "Da kommer Rosmer ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 25,
      "text": "Hans Fodtrin ryster Jord;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 25,
      "text": "hans Aande er en Vind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 25,
      "text": "en Torden er hans Ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 26,
      "text": "En Kratskov er hans Skieg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 26,
      "text": "hans Skiold et Klippelag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 26,
      "text": "hans Kölle er en Eeg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 26,
      "text": "hans Hielm et gammelt Vrag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 27,
      "text": "Da tier Uller stil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 27,
      "text": "hans Kinder blier saa hvide;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 27,
      "text": "han lytter sagte til,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 27,
      "text": "ham lyster ei at stride.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 28,
      "text": "Hvo monne til dig komme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 28,
      "text": "mens jeg var höit paa Strand?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 28,
      "text": "Jeg lugter paa min Tomme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 28,
      "text": "her er en christen Mund!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 29,
      "text": "Der flöi en Fugl herind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 29,
      "text": "med Dödmands Been i Munde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 29,
      "text": "Jeg smed det ud igien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 29,
      "text": "det snareste jeg kunde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 30,
      "text": "Hun klapper ham saa snild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 30,
      "text": "hun sætter Mad paa Bord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 30,
      "text": "Den Havmand blier saa mild",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 30,
      "text": "ved skiön Elinas Ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 31,
      "text": "Hun synger ham en Sang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 31,
      "text": "hun reder af hans Haar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 31,
      "text": "det fæle Gruus og Tang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 31,
      "text": "hun det i Lokker slaaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 32,
      "text": "Da bliver Rosmer fro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 32,
      "text": "da det er jevnt og glat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 32,
      "text": "Saa lysteligt han loe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 32,
      "text": "at Muren revned brat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 33,
      "text": "Og hör nu Rosmer kiere!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 33,
      "text": "Nægt ei min ringe Bön.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 33,
      "text": "Du ikke grum fortære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 33,
      "text": "min Moders ældste Sön!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 34,
      "text": "Ham Havet drev herned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 34,
      "text": "han sidder i en Vraa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 34,
      "text": "Han er i Nöd bestæd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 34,
      "text": "han tör ei for dig gaae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 35,
      "text": "Elina ei du græde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 35,
      "text": "Er Rosmer da saa slem?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 35,
      "text": "Jeg skal ham ikke æde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 35,
      "text": "Lad ham kun komme frem!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 36,
      "text": "Da fatter Uller Mod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 36,
      "text": "han triner af sit Læe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 36,
      "text": "Han staaer ved Rosmers Fod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 36,
      "text": "Han sætter ham paa Knæe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 37,
      "text": "Er du Elinas Broder?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 37,
      "text": "Da mig velkommen vær!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 37,
      "text": "Er du af samme Moder?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 37,
      "text": "Da est du Rosmer kier!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 38,
      "text": "Vær freidig kun i Sind!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 38,
      "text": "Er du den ældste Sön?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 38,
      "text": "Han klapper ham paa Kind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 38,
      "text": "den bliver guul og grön.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 39,
      "text": "Han sætter ham paa Kappe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 39,
      "text": "Min Haand er alt for stor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 39,
      "text": "til kielende at klappe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 39,
      "text": "saa spædt et lille Noer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 40,
      "text": "Da blussed Uller röd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 40,
      "text": "Han drog sit Sværd i Harm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 40,
      "text": "Nu skal du faae din Död!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 40,
      "text": "Det foer i Rosmers Barm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 41,
      "text": "Han rörer ei en Mine;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 41,
      "text": "han sidder ganske tryg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 41,
      "text": "Luk Vinduet, Eline!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 41,
      "text": "nu stak der mig en Myg!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 42,
      "text": "Derpaa hun fölger ham",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 42,
      "text": "mildtsmilende til Senge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 42,
      "text": "Det er en sölvklar Dam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 42,
      "text": "imellem Blomsterenge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 43,
      "text": "Ned i sin vaade Vugge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 43,
      "text": "han stiger uden Harm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 43,
      "text": "De Elskte see ham dukke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 43,
      "text": "og synke Barm til Barm!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 44,
      "text": "Et Aar forgaaer paa Havets Bunde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 44,
      "text": "i Elskovs Lyst;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 44,
      "text": "i altid grönne Myrthelunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 44,
      "text": "Bryst imod Bryst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 45,
      "text": "Da sukker Uller tit af Længsel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 45,
      "text": "ved Aaens Bred.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 45,
      "text": "Ak hvad er i et evigt Fængsel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 45,
      "text": "selv Kierlighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 46,
      "text": "Den vaade Muur, vel hundred Favne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 46,
      "text": "adskiller dem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 46,
      "text": "fra hver en Fryd de tungt maa savne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 233,
      "stanza_id": 46,
      "text": "fra elskte Hiem!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 234,
      "stanza_id": 47,
      "text": "O du som skienkte mig min Pige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 235,
      "stanza_id": 47,
      "text": "saa huld igien!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 236,
      "stanza_id": 47,
      "text": "skienk mig mit stolte Kongerige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 237,
      "stanza_id": 47,
      "text": "skienk mig min Ven!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 238,
      "stanza_id": 48,
      "text": "Lad ikke her vort Liv hendaane,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 239,
      "stanza_id": 48,
      "text": "i Dæmringskier.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 240,
      "stanza_id": 48,
      "text": "Du röde Sol! Du hvide Maane!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 241,
      "stanza_id": 48,
      "text": "Ak var I her!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 242,
      "stanza_id": 49,
      "text": "Elina ganger snild at stande",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 243,
      "stanza_id": 49,
      "text": "for Rosmer ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 244,
      "stanza_id": 49,
      "text": "Stærkt higer op til hine Lande",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 245,
      "stanza_id": 49,
      "text": "rend=\"indent-2\" min Broders Sind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 246,
      "stanza_id": 50,
      "text": "Sin Længsel kan han ei fordölge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 247,
      "stanza_id": 50,
      "text": "Du stærke Mand!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 248,
      "stanza_id": 50,
      "text": "Bring ham igiennem Havets Bölge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 249,
      "stanza_id": 50,
      "text": "paa törre Sand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 250,
      "stanza_id": 51,
      "text": "Giv ham en jernbeslagen Kiste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 251,
      "stanza_id": 51,
      "text": "opfyldt med Guld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 252,
      "stanza_id": 51,
      "text": "For al den Godhed du ham viste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 253,
      "stanza_id": 51,
      "text": "jeg blier dig huld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 254,
      "stanza_id": 52,
      "text": "Ak dersom du mig huld vil blive,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 255,
      "stanza_id": 52,
      "text": "bestandig huld!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 256,
      "stanza_id": 52,
      "text": "da skal jeg strax din Broder give",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 257,
      "stanza_id": 52,
      "text": "Friehed og Guld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 258,
      "stanza_id": 53,
      "text": "Elina med saa megen Liste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 259,
      "stanza_id": 53,
      "text": "tog Guldet ud;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 260,
      "stanza_id": 53,
      "text": "saa lagde hun sig selv i Kiste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 261,
      "stanza_id": 53,
      "text": "den skiönne Brud!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 262,
      "stanza_id": 54,
      "text": "Höi Rosmer farer alt med Lempe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 263,
      "stanza_id": 54,
      "text": "han er saa tryg; ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 264,
      "stanza_id": 54,
      "text": "Han löfter op den unge Kiempe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 265,
      "stanza_id": 54,
      "text": "paa brede Ryg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 266,
      "stanza_id": 55,
      "text": "Den tunge Kiste let han tager",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 267,
      "stanza_id": 55,
      "text": "i stærken Mund;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 268,
      "stanza_id": 55,
      "text": "derpaa han med sin Byrde drager",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 269,
      "stanza_id": 55,
      "text": "fra Havsens Bund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 270,
      "stanza_id": 56,
      "text": "Nu har jeg hævet dig paa Landet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 271,
      "stanza_id": 56,
      "text": "til Solen röd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 272,
      "stanza_id": 56,
      "text": "Nævn aldrig hvad du saae i Vandet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 273,
      "stanza_id": 56,
      "text": "det blev din Död!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 274,
      "stanza_id": 57,
      "text": "Saa sprang han atter ud i Havet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 275,
      "stanza_id": 57,
      "text": "Det stod i Skye!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 276,
      "stanza_id": 57,
      "text": "Af Bölgerne han blev begravet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 277,
      "stanza_id": 57,
      "text": "i Morgengry.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 278,
      "stanza_id": 58,
      "text": "Men da han ikke fandt Eline",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 279,
      "stanza_id": 58,
      "text": "da blev han bleg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 280,
      "stanza_id": 58,
      "text": "da malte Angest hver en Mine,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 281,
      "stanza_id": 58,
      "text": "og höit han skreg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 282,
      "stanza_id": 59,
      "text": "Dybt hörtes han i Havet larme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 283,
      "stanza_id": 59,
      "text": "med Arm og Been.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 284,
      "stanza_id": 59,
      "text": "Tilsiilst han sprang af Qval og Harme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 285,
      "stanza_id": 59,
      "text": "til Flintesteen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 286,
      "stanza_id": 60,
      "text": "Lumsk dukker nu hans haarde Pande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 287,
      "stanza_id": 60,
      "text": "Nu er hans Lyst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 288,
      "stanza_id": 60,
      "text": "at lade Havets Snekker strande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 289,
      "stanza_id": 60,
      "text": "imod sit Bryst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 290,
      "stanza_id": 61,
      "text": "Men Uller og Elina henrykt staae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 291,
      "stanza_id": 61,
      "text": "med Glædestaarer i hinandens Arme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 292,
      "stanza_id": 61,
      "text": "De höre Lundens Nattergale slaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 293,
      "stanza_id": 61,
      "text": "kun fiernt de höre Havets Bölger larme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 294,
      "stanza_id": 61,
      "text": "De aande i det rene Ætherblaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 295,
      "stanza_id": 61,
      "text": "de bade sig i Morgensolens Varme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 296,
      "stanza_id": 61,
      "text": "Letsvævende de iler op fra Lunden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 297,
      "stanza_id": 61,
      "text": "Alt synes dem en Dröm, som er forsvunden!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
