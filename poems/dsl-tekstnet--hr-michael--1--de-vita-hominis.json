  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "De Vita Hominis",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1514,
    "url": "https://tekstnet.dk/books/hr-michael_de-vita-hominis/001/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Wilt thu haffuæ løckæ och siælsens heyl,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "tha see tig offthæ i tetthæ speyl",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "som ieg wil tig nw sændhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Tha ladher thu huær mand waræ thin lighæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "til Gud sckalt thu tig wændhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "See huædhen thu komst, huart thu sckalt faræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "ey syndhæ mod Gud, tag thet til waræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "tænck hærpaa allæ tidhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "then ewighæ død then sckal hwn haffuæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "thet schalt thu wisselighen widhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Hwad doctor eller mæsther i wærdhen er til",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "som thet til fwldhæ sckriffuæ wil?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "som hær willæ gøræ plicht och bood,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "huar møghet Gud wil wæræ them good,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "thet kan ræth inghen sckriffuæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Nar thu æst i thin bæsthæ tijd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "thu myeent thet schal swo standhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "Dødhen kommer schulendhæ, ickæ tal eth ord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "tha schalt thu bødhæ huad thu haffuer giord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "met pinæ och hiarthens wandhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "tog thu haffuer allæ kisther fwld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "ey fawræ klæder och manghæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "Han sckiøder ey møghet thit krwsedhæ haar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "thinæ manghæ swønæ som hoes tig staar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "Gwd naadhæ tha then fattughæ siæl!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "Hwar er then stæd som hwn sig hæl",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "i swodan hiarthæqwidhæ?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "Haffuer thu tiænt Gud baadhæ aarlæ och sildhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "hwn fangher thet tha at widhæ.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
