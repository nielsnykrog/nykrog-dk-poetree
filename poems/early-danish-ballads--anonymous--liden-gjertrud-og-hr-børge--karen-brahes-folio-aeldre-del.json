{
  "id": null,
  "title": "Liden Gjertrud og Hr. Børge",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA6.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Her Pedder kaam fra tynge hiem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": ":: For-offuen wed dy tyeende. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "hans datter liden Kersten gaar hanom igenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Ther soffuer hind liden Giarthrud saa lønlig. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "\"Wer well-komenn hiem, kerr fadder min!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "huad war der thyden i dag paa tyng?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "\"Ther war thidenn, som meg thøgtte werst:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "dinn søster Giarttrud er lønlig fest.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "Syg meg, lidenn Kierstenn, datter min!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "huor er Giarttrud, søster dinn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "\"Giarttrud haffuer fangit saa vnderlig en synd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "vdj wor stien-stoffue der er hun miest.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "Giarttrud haffuer faaitt saa vnderlig en thraa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 5,
      "text": "hinder ganger fruer til och fra.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "Her Pedder gaar till venduett och ind hand suo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "daa brende der liusz i huerind wraa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "Her Pedder tog suerditt vnder syn skiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 7,
      "text": "\"Alltt med Guds loff gaar ieg her-ind.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "Her Pedder ind aff dørrenn treennd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 8,
      "text": "stalltt Giartrud hun wendis till wegen der-weed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "\"Thu syg meg, Giarttrud, datter myn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 9,
      "text": "huem er der fader aff søner dynn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "\"Første myn søner kand skiold y lieding førre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 10,
      "text": "saa maa dy well dieris fader spørge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "Første myn søner kand berre forgylldene suerd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 11,
      "text": "thaa spør thy well, huem thieris fader er.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "\"Thu statt nu op, Giarttrud, datter myn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 12,
      "text": "thu gack vd aff gaardenn med søner dinn!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "Tthett suarde hindis styffmoder, saa thog hun opaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 13,
      "text": "\"Mynn edlig herre, y siger icke saa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "Hindis moder hun aaruett hinder karume V,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 14,
      "text": "mynn herre, y laader hind en aff dem!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "\"Hun skall icke karumett faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 15,
      "text": "alt paa sinn fuod saa maa hun gaa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "\"Mynn faader gifftte meg med karume V,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 16,
      "text": "tha skall ieg nu laane hind en aff dem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "Menn kannd well børnn till verden berre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 17,
      "text": "mand kand icke skiebben for dem werre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 18,
      "text": "\"Hestenn er alle paa hiedde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 18,
      "text": "och karumen stander alle v-redde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 19,
      "text": "\"Hestenn stander alle y staallde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 19,
      "text": "selleff well wy reedde karumen saa boollde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 20,
      "text": "Hinder søster karumen for hinder bredde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 20,
      "text": "hindis styffmoder hinder till karum liede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 21,
      "text": "Hun lagde y karum dy hønder smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 21,
      "text": "der-offuer saa brede hun bolster blaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 22,
      "text": "Thi løfftte stalltt Giarttrud y karumen ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 22,
      "text": "saa stryd daa rand hynd thaar paa kyend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 23,
      "text": "Sttalltt Giarttrud aag sørgendis aff gaarde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 23,
      "text": "hindis styffmoder hun greder saa saarre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 24,
      "text": "Der hun kaam y grønnen eng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 24,
      "text": "ther møtte hinder her Byre med al sinn mend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 25,
      "text": "Hand red till karmen och ind hand suo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 25,
      "text": "ther luo stallt Giarttrud med søner smaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 26,
      "text": "\"Herre Gud giffue dynn fader wie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 26,
      "text": "for deg hand sender saa langtt aff lie!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 27,
      "text": "Her Byrre hand thog seeg tømen y heende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 27,
      "text": "thend karum hand y synn egen gaard wende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 28,
      "text": "Her Byrre slog offuer hinder skaarlagenn-skiend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 28,
      "text": "saa fulde hand hind sellffuer fraa karum och ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 29,
      "text": "Der war hun vdj maanetter thuo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 29,
      "text": "thennd thridy luod hand sitt brølup buo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 30,
      "text": "Hand luod hyndis faader till brøllupett byude,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 30,
      "text": "men hand thuor icke daa til ham ridde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 31,
      "text": "Hindis styffmoder kaam der ridden y gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 31,
      "text": "stalt Giartrud ganger hind vd ymod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 32,
      "text": "\"Vell-komenn, stalltt Ingellild, moder myn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 32,
      "text": "huor er her Pedder, styffader myn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 33,
      "text": "\"Thj quer, stallt Gierttrud, thu sigge icke saa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 33,
      "text": "hand vell deg well for fader staa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 34,
      "text": "\"Hand war mynn styffader alt saa gram:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 34,
      "text": "hand dreff meg aff garde til stuor harum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 35,
      "text": "I komer, stalltt Ingerlild, kerre moder myn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 35,
      "text": "føllger y meg y stoffuen ind!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 36,
      "text": "Thj drock derris brøllup y dage ny,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 36,
      "text": "hinndis moder wor der y alle dy.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 37,
      "text": "Tthend niendde dag drog frw Ingerlild hiem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 37,
      "text": ":: For-offuenn wed thi thieende. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 37,
      "text": "stalt Gierttrud leffuer med her Byrre ygen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 37,
      "text": ":: Ther soffuer hun liden Giarttrud saa lønlig. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}