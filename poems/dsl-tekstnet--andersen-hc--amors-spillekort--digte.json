    "url": "https://tekstnet.dk/books/andersen-hc_digte-1830/042/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Det er dog baade en Skam og Tort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "At vi skal være hans Spillekort;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Ja Bonde og Konge nok saa glad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Med Damen han tager til Herre-Blad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Snart er han inde, snart er han ude,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Han titter jo gjennem hver anden Rude.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Af Hjerter har han en mægtig Flok,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Men Kjærlighed giver dem alle nok.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Et Kors han sætter for hver som døer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Saaledes faaer han ihast sit Kløer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Paa Graven bliver jeg Spaden vaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Den sætter han paa et Kors som Spaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Saa spiller han lystigt Livet bort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Og vi maae tjene som Herrekort.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
