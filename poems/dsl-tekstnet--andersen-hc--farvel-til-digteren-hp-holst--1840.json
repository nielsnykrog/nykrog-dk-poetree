  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Flyv ned mod Syd, see der de rige Skatte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Som evig leve og begeistre maae!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Med Ungdoms Sjæl Du deres Storhed fatte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Og Du i Sang os giver, hvad Du saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Ja, flyv mod Syd, det bliver koldt her hjemme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Snart dække vaade Taager Danmarks Kyst;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": ":|: Her groer din Rose, den Du ei kan glemme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Fra Norden dufter Veemod i dit Bryst! :|:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "I det man skilles, komme alle Minder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Ret som en Börneflok med milde Blik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "De synge om, hvor snart det Hele svinder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Farvel! i Dig en trofast Ven vi fik!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "I Afskedsstunden staaer saa fjernt vort Möde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Og Tiden synes lang – hvad kan ei skee!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": ":|: Dog flyv! flyv i din Digter-Morgenröde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Farvel! Gud lad os glad hinanden see! :|:",
      "part": false,
      "marginal_notes": []
    }
  ]
}
