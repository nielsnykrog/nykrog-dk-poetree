  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Naar omkring mig alt er tyst og stille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Da er Vand mig ikke Søens Vove,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Træer ej de dunkle, tavse Skove,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Dal og Bakke ikke Jordens Bølger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Form ej Form og Farven ikke Farve,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Alt: et Udtryk for hvad Gud har drømt.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
