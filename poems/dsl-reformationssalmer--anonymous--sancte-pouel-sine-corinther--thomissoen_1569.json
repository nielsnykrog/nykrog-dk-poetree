  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Sancte Pouel sine Corinther/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "vnderuiste i den rette Lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Men strax effter hand drog der fra/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "begyntis mange Secter da.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Der stode op de Predicker ny/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Met falsk Lære i Corinther by:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Blant andet sagde de/ at være",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Jntet Liff effter Døden meer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "At wi døer bort som Faar oc Fæ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Jngen Opstandelse trode de.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Der Sancte Pouel saadant fornam/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Stor sorg den gode mand bekam.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Jt breff hand screff/ oc end vel skarpt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Straffede saadan Lærer hart:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Oc fremdrog Lærdom klar oc reen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Om opstandelsen/ vden meen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Lærde aff Scrifften/ At Jesus Christ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Den første fra døde opstod vist:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Beuiste der met/ at wi tillige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Skulle opstaa til det euig Rige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Ellers vaar troens Lærdom wklar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Om Christus ey opstanden vaar:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "De som i Christo soffuede hen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "Vaare alle fortabte/ huer oc en.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Synden haffde offuer oss halss oc haand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Om Christus ey opstod forsandt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Døden oc offuer oss all sin mact",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "Haffde met stor priss/ oc sin krafft.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "Thi lige som Døden ved en Mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Offuer alt Kiød fick offuerhaand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "Saa kommer igen ret Liffsens mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "Aff Christi Opstandelsis krafft.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "Derfor skulle wi som Jesus Christ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Fra de døde opstaa/ det er vist:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "Huer i sit skickelse Christo nest/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "Som hand det selff begynte best.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "Haabede wi ey Opstandelsen fast/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Hui skulle wi met stor møye oc hast",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "Oss i stor sorrig oc nød her giffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "Skulle wi her effter ey leffue?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "Lige som det deilige Huædekorn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Saais vdi Ageren/ oc tilforn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "Bortdøer oc raadner/ dog opgaar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "Lystigt/ oc groer det samme Aar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "Saa det jordiske Krop i sin graff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Raadner/ oc bliffuer til Aske oc støff:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "Dog voxer der aff it Legem saa klar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "Som met Gud leffuer blant Engle skar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "Naar det som vaar naturligt Kiød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "J graffuen raadnis effter sin Død:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "Jt Aandeligt Legeme det opstaar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "Som euiglig i Guds Huss boer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 13,
      "text": "Huad her hensaais i dødelighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "Det skal opstaa i herlighed:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "Huad her begraffuis vden mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "Det gaar her frem met veldig krafft.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "Som wi ere dødelig alle/ oc here",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Den Jordiskis Adams Billede bære:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "Den Himmelskis Billede wi oc faa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "Den euig monne oss alle tilstaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 15,
      "text": "Vort syndige Kiød oc Blod ey kand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "Arffue Guds Rige/ vort Fæderneland:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "Thi maa bort raadne hud oc haar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "At det kand vorde nyt oc klart.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 16,
      "text": "Wi skulle dog ey bortdøe alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "Men naar Basunen liude skal/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "Foruendis i it øyeblick.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "Der til huert Menniske sig beskicke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 17,
      "text": "Oc giffue god act paa den tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "J haab oc taalmodighed met flid:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "At naar da tilkomme skal Guds Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "Hand vente kand met glæde sin løn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 18,
      "text": "Om Verden end her giør oss tuang/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "Saa er dog drøffuelsens tid ey lang:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "Det tilkommende er derfor vor trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "Der til hielp oss Herre Jesu Christ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 19,
      "text": "Da skal Herren aff sine Vdualde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "Afftørre all graad/ som hand før talde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "All sorrig oc quide dem vist forgaar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "Da indgaar det rette Fryde Aar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 20,
      "text": "O Gud hielp vor suaghed oc nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "At wi gennem angist sorrig oc død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "Met trengsel gennem den sneffre Port/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "Til liffuit hoss dig vandre bort:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 21,
      "text": "J dit Rige i all euighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 21,
      "text": "Dig skue/ O hellig Trefoldighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "Met all den gantske Himmelske Hær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 21,
      "text": "Dig siunge stedse loff/ priss oc ære.",
      "part": false,
      "marginal_notes": []
    }
  ]
}