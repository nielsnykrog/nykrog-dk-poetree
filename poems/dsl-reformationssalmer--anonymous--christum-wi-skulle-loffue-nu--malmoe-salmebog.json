  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "CHristum wi skulle loffue nu/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Marie søn then rene Jomffru/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "saa wit som solen offuer skin/",
      "part": false,
      "marginal_notes": [
        "Math"
      ]
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "bekende wi Jesum en Herre all ene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Den som skabte hemmel oc iord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "han tog mandom en træl han word/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "ath han oss icke ganske wilde fortabe/",
      "part": false,
      "marginal_notes": [
        "Phil. ii"
      ]
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "thi wilde han sig til oss vmage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Gudz krafft ned aff hiemmelen kom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "i det Jomffruelige liff giorde en mandom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "den Jomffru som den naade bar/",
      "part": false,
      "marginal_notes": [
        "Luce iiEsai. vi"
      ]
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "hun wiste ey fuldkommelig hwad det war",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Det kyske hiertens hwss for /",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "g anammede Jesum Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "hun bleff Jomfru klar och sand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "sin Søn hun ndfick aff den Helligand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Den ædle moder bar oss den/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "som Gabriel forkynde vdsent/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "den Jomfru un søgte Elizabet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "oc fandz ath haff e det henne waar iætt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Johannes i sin moders barm/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "frøy e sig bode met fod oc arm/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Maria vd ff Gudz samffund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "sang Magnificat ode met hierte oc mund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Den som all werden haffuer i wold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "han fødis i en asne stold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "en liden mil fødde hans nature/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "som føder oc weder queger alle creature",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "Den Engelske skare glædis we",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "ath Christ vor kommen aff Abrahe seed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "det hørde de hyrder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "som voctede der queg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "ath Christ vor fød oss menniske lig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Ere wære dig Christ met konge naffn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "som føddis aff en Jomffru werden til gaffn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "holt din spyre met kongelig act/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "ath dieffuelsens rige faar icke mact",
      "part": false,
      "marginal_notes": []
    }
  ]
}