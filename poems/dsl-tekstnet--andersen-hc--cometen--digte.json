    "url": "https://tekstnet.dk/books/andersen-hc_digte-1830/016/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Da Sol stod op, og alle Nattens Terner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "(Jeg mener Stjerner)",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Med Hast igjennem Himlens Porte flyede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "En Skræder sad paa Bordet alt og syede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Ved Siden af ham stod et simpelt Fad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Med Mad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Dog nei! man saae Ruiner kun paa Bunden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Den tykke Mælk var dybt i Helten svunden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Mens Nattergalen slog i Bøgelunden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "– Med roligt Sind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Han tænkte nu saa fromt paa Ingenting.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Da nærmer, bondeklædt, sig Skjæbnens Dronning,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Og sælger ham en Krukke fyldt med Honning.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "– Bag Hyldetræet sad’ de Alfefruer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Med Graad paa Kind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Og for at frelse fløi de nu som Fluer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "I Stuen ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Og summede en Sang for Heltens Øre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Hvis Mening var: »Du maa ei Krukken røre.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "Men barsk af Væsen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "Han slog dem med en ulden Lap i Næsen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "Hver Gang de kom;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "Selv spiste han til Krukken reent var tom.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "Nu gik der, kan jeg tænke, et Qvarteer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "Maaskee lidt meer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "– Dog Tiden her gjør ikke stort til Sagen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "Da – ak, han vidste selv ei hvad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "Den arme Mand, som han paa Bordet sad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "I lovligt Kald, blev ganske som et Lagen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "I Læben beed han med de gule Tænder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "Og begge Hænder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "Mekanisk greb’ om de bespændte Lænder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 0,
      "text": "Thi dybt derinde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 0,
      "text": "Jog Boreas med alle sine Vinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 0,
      "text": "Tambourmajoren, tretten Niagarer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 0,
      "text": "Smaae Djævle-Skarer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 0,
      "text": "Og meget Andet som jeg ei kan huske.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 0,
      "text": "Han følte det at pine, save, ruske;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 0,
      "text": "Da kom hans Huustroe fra det nære Kammer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 0,
      "text": "Saae al hans Jammer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 0,
      "text": "Og spurgte ømt: »hvad er Dig vederfaret?«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 0,
      "text": "Men »au!« og »au!« og atter, »au!« var Svaret.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 0,
      "text": "– En Stund hun hører Mandens dybe Sukke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 0,
      "text": "Nu seer hun Fadet og den tomme Krukke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 0,
      "text": "Da aner hun – men gyser endnu mere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 0,
      "text": "»En Mavesnaps kan ene ham curere!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 0,
      "text": "Ak bleeg som Døden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 0,
      "text": "Han sidder paa sit Bord i Morgenrøden!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 0,
      "text": "Saa taler hun, og flyver let som Skovens Hind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 0,
      "text": "I fire Spring paa Apotheket ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 0,
      "text": "Men stum som Fisken,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 0,
      "text": "En Niobe, hun staaer saa bleg ved Disken.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 0,
      "text": "End gik et langt Minut,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 0,
      "text": "Før Apothekets snilde Substitut",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 0,
      "text": "Forstod Mimikken,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 0,
      "text": "Og søgte nu paa Hylden efter Drikken.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 0,
      "text": "Da Vee! Hvad har ei Fanden at bestille.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 0,
      "text": "Høit under Loftet hang en støvet Krokodille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 0,
      "text": "Der gav ham paa Organet for hans Snille",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 0,
      "text": "Et saadant Smæk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 0,
      "text": "Saa hele Substitutten fik et Knæk.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 0,
      "text": "– I Hast han nu Madammen expederte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 0,
      "text": "Men ak, leverte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 0,
      "text": "Slig brændbar Luft, som man for Luftballoner laver.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 0,
      "text": "Men ei for Skræder-Maver.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 0,
      "text": "Og med en Fart",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 0,
      "text": "Hun var i Hjemmet snart,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 0,
      "text": "Og rakte Manden Flasken fyldt med Drikken.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 0,
      "text": "Men knap til Livs han fik den,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 0,
      "text": "Før neppe selv han kunde sig forstaae;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 0,
      "text": "Det var som om han havde Vinger paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 0,
      "text": "»Ak hvad er det! ak hvad er det!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 0,
      "text": "Udbrød han. »See hvor er jeg let!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 0,
      "text": "Saa flink til Beens, – jeg troer jeg svæver!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 0,
      "text": "– Men Skræderkonen bæver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 0,
      "text": "Thi som han gjør fra Bordet lette Hop,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 0,
      "text": "Gaaer Vinduet op,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 0,
      "text": "Og som en Luftbalon han gjennem Luften stiger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 0,
      "text": "Høit Qvinden skriger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 0,
      "text": "Men skjøndt hun reiser sig fortvivlet paa sin Taae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 0,
      "text": "Kan hun dog ei den arme Skræder naae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 0,
      "text": "– O hvilket Syn! han svæver over Byen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 0,
      "text": "Og svinder som et Stjerneskud bag Skyen. –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 1,
      "text": "– – Tre lange Uger gaae med Suk og Graad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 1,
      "text": "Nymaanen seiler som en gylden Baad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 1,
      "text": "Paa Himlens Ocean; med vaade Blikke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 1,
      "text": "Hun skuer did – men ak! han er der ikke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 1,
      "text": "Hun havde tænkt: han kommer nok med Maanen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 1,
      "text": "Men ei han kom, – thi falder hun i Daanen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 1,
      "text": "Det gik vel siden over,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 1,
      "text": "Men ikkun lidet hun om Natten sover,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 1,
      "text": "Thi vaagen og i Drømme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 1,
      "text": "Hun seer sin Skræder høit paa Luftens Strømme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 1,
      "text": "– En Aften sad hun efter vante Skik",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 1,
      "text": "Med Taare-Blik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 1,
      "text": "Mens Tappenstregen lystigt lød i Staden;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 1,
      "text": "Da høres Larm paa Gaden;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 1,
      "text": "Hun seer derud – ak, stor er Folkevrimlen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 1,
      "text": "Thi høit paa Himlen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 1,
      "text": "Der staaer en stor, en underlig Comet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 1,
      "text": "Hvis Mage ei de ældste Folk har seet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 1,
      "text": "Om Pest, om Krig og Hungersnød man taler,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 1,
      "text": "Thi see, Cometen den har tvende Haler.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 1,
      "text": "– De Lærde strømme til fra alle Kanter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 1,
      "text": "Besee den i Qvadranter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 1,
      "text": "Udregne dens excentriske Ellipser,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 1,
      "text": "Men knipser",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 1,
      "text": "Tilsidst hinanden arrigt over Næsen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 1,
      "text": "Thi man er ueens om Cometens Væsen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 1,
      "text": "Dens Astronomer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 1,
      "text": "Beskrive den i flere tykke Tomer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 1,
      "text": "I Bladene de flaae hinandens Ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 1,
      "text": "Den hele Stad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 1,
      "text": "Forglemmer Søvn og Mad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 1,
      "text": "Selv Raadet tænker paa hvordan det dog kan være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 1,
      "text": "Da pludseligt Cometen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 1,
      "text": "Nær havde rammet Raadet i Planeten,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 1,
      "text": "Thi den med eet faldt ned fra Himmel-Scenen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 1,
      "text": "Og laae beskedent midt i Rendestenen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 1,
      "text": "– Fra Øster og fra Vester",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 1,
      "text": "Løb Folket til at see de sjeldne Rester,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 1,
      "text": "Selv Skræderkonen med sin vaade Kind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 1,
      "text": "Kom til og rørte i den med en Pind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 1,
      "text": "For af de brutte Dele",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 1,
      "text": "At faae et klart Begreb om Tingens Hele.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 1,
      "text": "Men som nu Alle søge rundt omkring,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 1,
      "text": "Hun støder paa et Spænde og en Ring;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 1,
      "text": "Ved dette Syn hun raaber høit og græder:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 1,
      "text": "»Ak! Jømeni! Cometen er min Skræder!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 1,
      "text": "Det er hans Spænde! det er hans Ring!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 1,
      "text": "Men af ham selv er der Ingenting!!!«",
      "part": false,
      "marginal_notes": []
    }
  ]
}
