  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift I",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVI31.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Offer lildt oc hans brødre tre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "for kongens | wrede saa komme dj,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": ":: sielff tuingit haffuer | hun ham. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Dett war icke for annden sag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "enndt | konngen wille hans hustrue haffue. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "Toffuelildt suøber hun sig ÿ skindt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "hun | gannger ÿ lofft for konngen indt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "Minn edelig herre will ÿ mig loffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "att | Offer lildt maa fredt ÿ lanndit haffue. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "Lennge stodt konngenn oc tennckte der paa, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "Huor handt kunde Toffuelildt antsuar faa. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "Toffuelildt wilt du mig loffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "denne | natt altt huosz mig att soffue. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "Denne natt altt huosz mig att soffue, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "Saa maa Offerlill fred ÿ landit haffue. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "Ieg haffuer mig saa dannis en mandt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "først saa will ieg rade mett ham. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "Thoffuelill suøber hun sig ÿ skinndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "hun | gannger ÿ lofft for offer lill indt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "Offerlill will ÿ mig loffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "enn natt | huosz wor konng att soffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 9,
      "text": ":: sielff | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "En natt huosz wor konninng att soffue, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 10,
      "text": "siden maa ÿ fredt, ÿ lanndit haffue. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "Dett suarede Offerlill for handt war wredt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 11,
      "text": "enn natt oc rett aldrig mere. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "Skaltt du nu till konngen gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 12,
      "text": "daa | drag icke ditt røde guldt paa. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "Thoffuelill gannger till skrine,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 13,
      "text": "som guldt | dett ligger ÿ line,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 13,
      "text": ":: Sielff tuingit haffuer | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 14,
      "text": "Hunn drog guldt wdt offuer guldt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 14,
      "text": "alle | hindis fingre dem sette hun fuldt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 15,
      "text": "Hun giørde sig mett enn silcke snor, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 15,
      "text": "dett guldit oc perler paa iorden stodt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 16,
      "text": "Toffuelill hun suøber sig wdÿ skindt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 16,
      "text": "hun | ganger ÿ lofft for konngen indt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 17,
      "text": "Toffue lill inndt att dørrenn tren,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 17,
      "text": "konngenn handt stander hinde op igen. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 18,
      "text": "Konngenn klapper paa hiunit blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 18,
      "text": "wilt | du Toffuelill huile her paa. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 19,
      "text": "Ieg er icke trett ieg er icke modt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 19,
      "text": "en liden huile hun er well guodt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 20,
      "text": "Heller will ÿ wÿ ÿ hoÿelofft soffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 20,
      "text": "heller ÿ will dricke mødt ÿ sede stoffue. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 21,
      "text": "Først will wÿ ÿ høÿelofft soffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 21,
      "text": "siden wil | wÿ dricke mødt ÿ Sedestue. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 22,
      "text": "Aarligt om morgenen dett war dag, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 22,
      "text": "Thoffuelill kraffde sin morgens gaffue. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 23,
      "text": "Dett fick Thoffuelill for hun wor wen, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 23,
      "text": "Tømmer bÿ oc tÿmmer bÿe lønn. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 24,
      "text": "Tømmerbÿe oc tømmerbÿe lønn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 24,
      "text": "oc Offerlill, fredt ÿ landen fick,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 24,
      "text": ":: sielff tuingit | haffuer hun ham. | ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}