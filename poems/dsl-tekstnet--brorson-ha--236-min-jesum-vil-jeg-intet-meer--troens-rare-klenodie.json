{
  "id": null,
  "title": "236. Min JEsum vil jeg, intet meer",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
