{
  "id": null,
  "title": "199. Nu derfor maa du dog ey plat",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
