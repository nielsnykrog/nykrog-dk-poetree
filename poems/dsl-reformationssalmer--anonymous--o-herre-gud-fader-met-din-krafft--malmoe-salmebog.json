  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Herre Gud Fader met din krafft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hielp oss dine børn oc giff oss mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "till aandelig strid mod werden ath kiffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "ath de wi kallis/ wi kunde den ret bliffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "O Fader forbarme dig offuer oss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "Christe dw est all ene vore skiold oc swerd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "dog mange det ey wil achte dess wer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "vden dw met oss i striden wilt staa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "den grumme død wi aldrig vndgaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "O Christe see til oss miskundelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "O Herre Helligand vaar trøstermand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "lær oss ret ath kende vor høffuitzmand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 4,
      "text": "lad oss ey komme vnder fremmed wald",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "naar wi i striden faa saar eller fald/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 5,
      "text": "O Helligand miskunde dig offuer oss",
      "part": false,
      "marginal_notes": []
    }
  ]
}