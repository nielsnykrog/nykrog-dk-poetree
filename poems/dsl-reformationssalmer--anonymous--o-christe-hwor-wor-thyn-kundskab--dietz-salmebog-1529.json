  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Christe hwor wor thÿn kundskab/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "tha Paffue Siluester leffde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Tha Keyser Constantinus gaff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "hannwm Rom alt vnder sitt welde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "forsant tror ieg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "hadde then Paffue teg giennom thit naadis liuss forstaait/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "han hadde wisselige thet werdzlige rÿge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "teg tha til prÿss forsmaait.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Hadde Gratianus teg rett kend/",
      "part": false,
      "marginal_notes": [
        "Anno Domini|M. C. xx."
      ]
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "tha han begynte att dichte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "then paffuelig low som kallis decret",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Romische hantering paahitte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "tha hadde han wel teg giffuit then ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "oc vnder thÿn lærdom bleffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "med hwilken tw hadde/ med then Helliaands naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "alle Christnes hierte omdreffuit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Hadde Keyser Nero desligest/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "teg kend then tÿd han raadde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "han hadde icke myrd saa mange Christne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "twonget them fraa teg att gange:",
      "part": false,
      "marginal_notes": [
        "Hiere. xvij"
      ]
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Desligest andre flere. Ther fore ieg wil",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "mÿn tro fraa mennisken wende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "allene Herre thÿn ord ere glæden mÿn:",
      "part": false,
      "marginal_notes": [
        "Rom. x."
      ]
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "the lære meg teg rett kende.",
      "part": false,
      "marginal_notes": []
    }
  ]
}