  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Her Form og Tanke sødt hinanden møde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Hvoraf blev Du vel skabt paa Jordens Kyst?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Af Vaarens friske Snee og Morgenrøde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Og Engle aanded Livet i dit Bryst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Du smiler selv fra Hækkens grønne Blade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Som Englen smilte til det første Par!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "I Morgenduggen Blomsterne sig bade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "En Draabe kun Du paa dit Blomster har.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Er det en Taare, Alfen græd, og sukked,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Fordi Du er saa smuk og dog skal døe?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Med Ungdoms Fylde, Bladene halv lukked,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Sødt drømmende, Du staaer paa Jordens Ø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Hvad drømmer Du? Din Drøm ei kjender Smerte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Dit Liv er Kjærlighed, din Sjæl er Duft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Dit Hele er et saligt Digter-Hjerte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Der Himlen seer, hvor Andre see kun Luft.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
