  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift I",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVI30.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Her Sallemandt handt er den skiøniste suendt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "frue mette-lildt heder hans frue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "dj hagde | huer-Andre ÿ hiertit saa kiere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "stuor | wilge dj tillsammen drog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: ÿ wide dett saa | well ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": ":: Her Sallemandt døde aff elskouff. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Her Sallemandt hagde en modersøster,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "hun heder | frue Ingeborrig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "till hinde rider Here Sallemand, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "for hinnde klager handt sin sorrig. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Dett war Herre Sallemandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "handt kom der | ridende ÿ gaardt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "wdstaar hans kiere moder-søster | ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "hun war well suøbt ÿ maardt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Wer du welkomen Her Sallemandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "kiere søster-sønne | min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "gack du dig ÿ høÿelofft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "du | dricker denn klare win,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": ":: ÿ wide dett | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Dett war Sallemandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "handt gaar paa Sallen att stande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "dett wor hans kiere moder-søster | ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "hun skiencker ham win till hande. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "Hør du Herre Sallemandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "men wÿ er enne | to,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "er ther ingen ÿ werden till,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "alt der | din hue ligger paa. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "Der er ingen ÿ werden till,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "der till hue | leger paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": "foruden hin skøne fru Mette-lildt | ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "oc hinnde maa ieg icke faa. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "Hør du herre Sallemandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "dett tør du icke tro, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 7,
      "text": "ÿ er saa ner to sÿdskinde-børn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 7,
      "text": "ÿ maa icke till-sammen bo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": ":: ÿ wide dett saa well | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "Heder hun icke frue mettelildt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 8,
      "text": "som forløsze maa | min quide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 8,
      "text": "dog skall ieg der aldrig nogen | frue, eller jomffrue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 8,
      "text": "soffue huosz min side. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "Hør du herre Sallemandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 9,
      "text": "ladt fare bort angist oc quide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 9,
      "text": "ÿ lader ethers breffue till Rom | schriffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 9,
      "text": "ÿ maa wel tilsammen bliffue. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "Dett wor herre Sallemandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 10,
      "text": "handt lader dj | lønne-breffue schriffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 10,
      "text": "sender handt dem | op att landt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 10,
      "text": "skøne frue mette-lildt att giff-ue | |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "Hun schreff ham itt andit igen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 11,
      "text": "hun sender | ham mett sin terne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 11,
      "text": "huor handt wil ÿ alle | werden fare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 11,
      "text": "ieg følger ham ganske gerne. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 12,
      "text": "Saa lodt handt sin skøtte skibe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 12,
      "text": "bode skøtt oc | bratt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 12,
      "text": "Saa løbe dj fraa lande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 12,
      "text": "den Anden pinndze-dag, gangen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 12,
      "text": ":: ÿ wide well | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 13,
      "text": "Di wunde op seÿl aff silcke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 13,
      "text": "saa høÿt ÿ dett | forgÿlte raae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 13,
      "text": "saa seilett dj till paris,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 13,
      "text": "mindre endt maneder to,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 13,
      "text": ":: ÿ wide well | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 14,
      "text": "Dett war Herre Sallemandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 14,
      "text": "handt løb for | parÿs indt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 14,
      "text": "Alle dj klocker ÿ staden war, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 14,
      "text": "dj gaff hannom wdt-igen. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 15,
      "text": "Wer ÿ welkommen Her Sallemandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 15,
      "text": "huor | haffuer ÿ fangit den frue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 15,
      "text": "her er kommen budt | fra sÿnder-landt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 15,
      "text": "ÿ maa icke tillsammen bliffue. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 16,
      "text": "Herre gud nade mig sagde Her Sallemandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 16,
      "text": "saa | well ieg mon fruen wnde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 16,
      "text": "saa sprack hans | hierte ÿ stÿcker siu,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 16,
      "text": "saa blodt rand aff hans | mundt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 17,
      "text": "Der wor sorrig ÿ fruerstue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 17,
      "text": "som alle dj | fruer græde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 17,
      "text": "frue Mette-lildt døde ÿ | høÿe-lofft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 17,
      "text": "Her Salemandt ÿ dett stræde, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 17,
      "text": ":: ÿ wide dett saa well ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 17,
      "text": ":: Her Salemandt døde for elskouff. | ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}