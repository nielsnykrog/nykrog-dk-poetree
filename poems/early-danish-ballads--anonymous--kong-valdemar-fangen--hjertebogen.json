{
  "id": null,
  "title": "Kong Valdemar fangen",
  "year_created": [
    1553,
    1555
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Hjertebogen",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1555,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/HJB30.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Ieg wyll eder end wysse quede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "y-huem den løster att høre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "herre Gud gyffuet, att landen dy motte stande y fredt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "och wy konnigens wylle motte giøre!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: I ryder ey! ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Ther war end kong y Dannemarck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "hand war bode ryg och bold:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "nock daa hagde hand borigh och feste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "att land och ryge udy wold.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Well siuff konge-ryge dem otte hand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "dem wyll yeg alle for eder neffne:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "saa ylde gyorthe sorte greffue Henryck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "hand førde dem fraa deris offne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Thett første war Dannemarck, thett anneth Swerig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "thett motte then herre ycke nyde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "thett trydie war Holsten och Mekelborre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "och theris tro monne bryde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Thett femte war Wendell under øø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "som lygger mellum Eluin och hedenn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "thett syette war Engelandt stort och sterckt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "och dy tyent konnigen best.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Thetth syette war Engelandt, thett syuende Sotlandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "thett motte then herre ycke nyude:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "dy tog bort wor kronit konning,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "thett motte alle danske fortryde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Dy tog bortt wor kronyd konghe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "som hed konning Waldemur:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "thett stod saa y otte aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "thett landen stod udy wode.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Thett lyde fast att thett nyende aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "then herre tog tyll att lange:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "sender hand bud tyll Dannemarck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "beder thennum løsse siig aff fange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Syu tussynd marck sølff tha war ther weyd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "sex hundrit ørss mett lodt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "daa tackith konnige wore synne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "hannum bode lente och gaff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Send hand bud tiill Dannemarck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "tyll kyere sønner sine:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "\"Beder thennum giøre for æren sin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "och løsse theris fader aff pine!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Thiitt ryder thy tyll støffne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "och saa tiill ting:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "thy beder alt om thett huide sølff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "och løsse theris fader aff pyne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "VI tussindt marck solff daa war ther weytt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "VI hundert ørss mett ladt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "tha tacket konnigen wenner syn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "hannum bode lente och gaff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "Saa glade ware alle thy danske hoffmendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "theris herre war løst aff quide:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "dy beginte yend wysse och quad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 12,
      "text": "greff Henryck bad thennum byde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "\"Byder y here yend lyden stund!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "thett kand etther lidet skade:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "wy haffuer yend tyding for nyulig spurtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 13,
      "text": "wy wylle altt mett eder rade.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Konnigen hand stod y fremmer-staffn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "hans øgen thy runde saa saare:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "\"Y danske hoffmend, legger arer for bore!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 14,
      "text": "y tror ycke thend forreder hans ord!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "Saa glade war alle thy danske hoffmend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "theris herre war løst aff møde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "som engelen war paa paske-morgen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 15,
      "text": "wor-herre stod op aff døde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 15,
      "text": ":: I rider ey! ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}