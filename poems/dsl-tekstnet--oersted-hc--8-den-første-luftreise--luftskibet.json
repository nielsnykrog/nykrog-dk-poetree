{
  "id": null,
  "title": "8. Den første Luftreise",
  "year_created": 1836,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Ørsted",
    "country": null,
    "wiki": "Q44412"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Luftskibet",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1836,
    "url": "https://tekstnet.dk/books/oersted-hc_luftskibet/010/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "See! Hvilken Folkestrøm langs hen ad Veien!",
      "part": false,
      "marginal_notes": [
        "Speaker: Gudin."
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Pariserne har om den store Prøve",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Dog faaet Nys, skjøndt hemmelig den holdtes.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "I tusindviis man søger Lamuette.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Jeg Lykken prise maa, som lod mig finde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Dig, Ungdomsven, endnu den samme Morgen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Da jeg kom til Paris. Jeg ahned ikke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "At strax jeg skulde see den første Reise,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Hvor Mennesket, fritsvævende, befarer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Det tynde Luftens Hav, og det med Charles,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Hvis Skarpsind alt den nye Kunst forbedred.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Desuden har et herligt Sted vi faaet;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Saa eensomt, og for Synet saa beqvemt dog;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Den hele Plads os ligger grant til Skue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Fra Top til Grund den stolte Mongolfiere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Staaer for mit Blik; saa stor jeg ei den troede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Den synes mig et Taarn; hvad er dens Høide?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Halvfjerdsindstyve Fod den er og fire.",
      "part": false,
      "marginal_notes": [
        "Speaker: Charles."
      ]
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Og maalt paa tvers, den holder ott’ og fyrge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "I Midten; men for oven og for neden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Den slutter stærk og skjøn sig med en Runding.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Med Malerpenslen har man rigt den prydet.",
      "part": false,
      "marginal_notes": [
        "Speaker: Gudin."
      ]
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "En Krands af Frankrigs Lilier den omgiver,",
      "part": false,
      "marginal_notes": [
        "Speaker: Charles."
      ]
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Derunder seer Du hele Dyrekredsen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Men Beltet, som sig bredt om Midten slynger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Har Kongens Navnetræk, med Sole blandet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Og under denne Kreds eiheller savnes",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Den muntre Pragt, som kan forlyste Øiet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Fra Himmel og fra Jord en broget Vrimmel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Man hentet har, for Folket at antyde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Hvordan man her har Jorden Himlen nærmet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Falsk eller rigtigt tænkt, som man det tyder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Hvoraf er den vel gjort? Kan den og holde?",
      "part": false,
      "marginal_notes": [
        "Speaker: Gudin."
      ]
    },
    {
      "id": 33,
      "stanza_id": 5,
      "text": "Af Lærred den bestaaer, som vel skal holde;",
      "part": false,
      "marginal_notes": [
        "Speaker: Charles."
      ]
    },
    {
      "id": 34,
      "stanza_id": 5,
      "text": "Men med Papir den er beklædt for Tæthed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 6,
      "text": "Et Gallerie gaaer rundt omkring for neden.",
      "part": false,
      "marginal_notes": [
        "Speaker: Gudin."
      ]
    },
    {
      "id": 36,
      "stanza_id": 6,
      "text": "Det er vel for de Reisende; men Taarnet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 6,
      "text": "Jeg frygter helde vil, naar En sig flytter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 7,
      "text": "Saa vilde det, hvis uden Eftertanke",
      "part": false,
      "marginal_notes": [
        "Speaker: Charles."
      ]
    },
    {
      "id": 39,
      "stanza_id": 7,
      "text": "Man gik tilværks; men derfor er der sørget.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 7,
      "text": "Man aftalt har ved Tilraab at advare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 7,
      "text": "Hinanden, saa man vælge kan sin Stilling.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 7,
      "text": "Du seer en Ildkurv, hængt i sikkre Kjæder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 7,
      "text": "Midt for det Svælg, man aabent lod i Bunden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 7,
      "text": "Derfra skal høit i Sækken Blusset stige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 7,
      "text": "Hvis den blev stillet skjævt, ufeilbart tændtes",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 7,
      "text": "Saa fængbart Stof. Man være maa forsigtig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 8,
      "text": "Jeg seer, at blindt man ikke gaaer i Faren.",
      "part": false,
      "marginal_notes": [
        "Speaker: Gudin."
      ]
    },
    {
      "id": 48,
      "stanza_id": 8,
      "text": "Nu troer jeg, at jeg kjender Ydersiden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 8,
      "text": "Af Tingen; men det Indre, hvad den driver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 8,
      "text": "Jeg fatter ei; den veier vistnok meget,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 8,
      "text": "Vel meer end tusind Pund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 9,
      "text": "Ja sexten hundred,",
      "part": false,
      "marginal_notes": [
        "Speaker: Charles."
      ]
    },
    {
      "id": 53,
      "stanza_id": 9,
      "text": "Naar den sin Ladning faaer; dog let beseires",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 9,
      "text": "Den Vægt og mere til. Nær ligger Grunden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 9,
      "text": "Den stiger, som et Stykke Træ i Vandet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 9,
      "text": "Hvorfor det skeer, det veed Du ganske sikkert.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 10,
      "text": "Det, mens vi Drenge var, Du mig forklared.",
      "part": false,
      "marginal_notes": [
        "Speaker: Gudin."
      ]
    },
    {
      "id": 58,
      "stanza_id": 10,
      "text": "Naar Noget veier meer, end al den Vædske,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 10,
      "text": "Som Rummet fylde kan, det selv indtager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 10,
      "text": "Da synker det; men hvis det veier mindre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 10,
      "text": "Det bæres op til Vædskens Overflade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 10,
      "text": "Men Lærred og Papir jo veier mere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 10,
      "text": "End Luften, som ved dem af Stedet trænges!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 10,
      "text": "End sige Træ og Jern!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 11,
      "text": "Men glem kun ikke,",
      "part": false,
      "marginal_notes": [
        "Speaker: Charles."
      ]
    },
    {
      "id": 66,
      "stanza_id": 11,
      "text": "At den udspiles til et Rum saa mægtigt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 11,
      "text": "At hvis til Bunds i Vand den skulde synke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 11,
      "text": "Usammentrykt, den mindre ei fortrængte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 11,
      "text": "End fire Millioner Pund. Nu er vel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 11,
      "text": "Ei Luften meget vægtfuld; dog fortrænges",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 11,
      "text": "Deraf fem tusind Pund, som vilde opfyldt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 11,
      "text": "Maskinens Rum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 12,
      "text": "Det mindst jeg havde tænkt mig!",
      "part": false,
      "marginal_notes": [
        "Speaker: Gudin."
      ]
    },
    {
      "id": 74,
      "stanza_id": 12,
      "text": "Er det og vist, ei nogen kunstig Gjetning?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 13,
      "text": "At veie Luft, ei koster megen Møie;",
      "part": false,
      "marginal_notes": [
        "Speaker: Charles."
      ]
    },
    {
      "id": 76,
      "stanza_id": 13,
      "text": "Jeg viser Dig det let, om Du det ønsker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 14,
      "text": "Vel da, hvad skeer der meer, hvorledes hæver",
      "part": false,
      "marginal_notes": [
        "Speaker: Gudin."
      ]
    },
    {
      "id": 78,
      "stanza_id": 14,
      "text": "Nu Ildens Magt Maskinen op fra Jorden?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 15,
      "text": "Naar Luften bliver varm, den sig udvider;",
      "part": false,
      "marginal_notes": [
        "Speaker: Charles\" data-placement=auto data-html=true data-content='Charles] &nbsp;SES, Gudin ATekstkritisk note 27\">A."
      ]
    },
    {
      "id": 80,
      "stanza_id": 15,
      "text": "Det gamle Rum den ikke meer kan fatte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 15,
      "text": "Derfor en Deel ved Blusset maa forjages",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 15,
      "text": "Af den uhyre Luftsæks Indhold; tænk dig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 15,
      "text": "At kun den halve Deel gaaer bort, saa har du",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 15,
      "text": "To tusind og femhundred Punds Formindskning,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 15,
      "text": "Og let kan sexten hundred Pund da løftes.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 16,
      "text": "Nu fatter jeg det klart; jeg ogsaa mindes,",
      "part": false,
      "marginal_notes": [
        "Speaker: Gudin."
      ]
    },
    {
      "id": 87,
      "stanza_id": 16,
      "text": "Det er en Lov, at Varmen Alt udvider.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 16,
      "text": "Men, Ven, jeg hører at Du selv har udtænkt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 16,
      "text": "Et Luftskib, mindre stort og mindre farligt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 16,
      "text": "Hvis det dig plager ei, forklar mig dette.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 17,
      "text": "Det snart er skeet. Viid da, en Luft der gives,",
      "part": false,
      "marginal_notes": [
        "Speaker: Charles."
      ]
    },
    {
      "id": 92,
      "stanza_id": 17,
      "text": "Langt mindre vægtfuld end vor Atmosphæres;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 17,
      "text": "Med den udpuster jeg en Sæk af Silke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 17,
      "text": "Som Kugle skabt, og tættet med en Fernis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 17,
      "text": "Omkring den kastet er et Net af Snore,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 17,
      "text": "Ved det en Kurv, af Vidier fletted, bæres,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 17,
      "text": "Hvori to Mænd beqvemt kan gjøre Reisen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 17,
      "text": "Gudin.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 18,
      "text": "Hvad Størrelse har vel din Silkekugle?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 19,
      "text": "Dens Gjennemsnit er kun halvfemte Favne;",
      "part": false,
      "marginal_notes": [
        "Speaker: Charles."
      ]
    },
    {
      "id": 101,
      "stanza_id": 19,
      "text": "Lidt over tredie Part af dennes Høide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 19,
      "text": "Mit Luftskibs Vægt, fyldt med den lette Luftart,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 19,
      "text": "Er hundred femti Pund. Naar dertil kommer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 19,
      "text": "To Reisende, og hvad de med sig føre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 19,
      "text": "Vil Vægten dog ei overgaae sex hundred.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 19,
      "text": "Men Luften, som af Kuglen maa fortrænges,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 19,
      "text": "Vel over otte hundred Pund vil veie;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 19,
      "text": "Saa let, du seer, min Luftbold sig skal hæve.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 20,
      "text": "Men hvilket Navn har denne lette Luftart,",
      "part": false,
      "marginal_notes": [
        "Speaker: Gudin."
      ]
    },
    {
      "id": 110,
      "stanza_id": 20,
      "text": "Som tjene skal din Flugt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 21,
      "text": "Den fører Navnet",
      "part": false,
      "marginal_notes": [
        "Speaker: Charles."
      ]
    },
    {
      "id": 112,
      "stanza_id": 21,
      "text": "Af brændbar Luft; thi Ild den hurtigt fænger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 21,
      "text": "Dog mig ved denne Kraft den ikke tjener,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 21,
      "text": "Men ved den ringe Vægt, som deraf kræves,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 21,
      "text": "For Kuglen ret udspændt og fyldt at holde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 22,
      "text": "Tre Maaneds Tid, troer jeg, er alt forløben",
      "part": false,
      "marginal_notes": [
        "Speaker: Gudin."
      ]
    },
    {
      "id": 117,
      "stanza_id": 22,
      "text": "Fra Prøven, som du gjorde med en mindre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 22,
      "text": "Siig hvorfor har du dvælet, og i Forkjøb",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 22,
      "text": "Kom ikke Mongolfier ved egen Luftfart?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 23,
      "text": "Fordi det var, Fortjenesten at røve",
      "part": false,
      "marginal_notes": [
        "Speaker: Charles."
      ]
    },
    {
      "id": 121,
      "stanza_id": 23,
      "text": "En skjællig Løn. Opfinderen maa hædres.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 24,
      "text": "Opfinder er jo Du, saavel som hine.",
      "part": false,
      "marginal_notes": [
        "Speaker: Gudin."
      ]
    },
    {
      "id": 123,
      "stanza_id": 25,
      "text": "Med Forskjel dog, den som en mægtig Tanke",
      "part": false,
      "marginal_notes": [
        "Speaker: Charles."
      ]
    },
    {
      "id": 124,
      "stanza_id": 25,
      "text": "Til virksomt Liv fremdrog, han er Opfinder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 25,
      "text": "Af første Rang. Jeg kun er Efterligner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 25,
      "text": "Min Høst er voxet paa hans Grund; derfor jeg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 25,
      "text": "Bør villig vige ham; ei frem mig trænge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 26,
      "text": "Hvor ædelt tænkt.",
      "part": false,
      "marginal_notes": [
        "Speaker: Gudin."
      ]
    },
    {
      "id": 129,
      "stanza_id": 27,
      "text": "Ei meer end Retfærd byder.",
      "part": false,
      "marginal_notes": [
        "Speaker: Charles."
      ]
    },
    {
      "id": 130,
      "stanza_id": 27,
      "text": "Men glem nu ei at see dig om i Kredsen!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 27,
      "text": "Til Farten man har meget at berede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 27,
      "text": "Ei værd at sees. Den nye Kunst det mangler",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 27,
      "text": "Paa Færdighed. Men meget her Du ellers",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 27,
      "text": "Opmærksomhed vil finde værd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 28,
      "text": "Du mener?",
      "part": false,
      "marginal_notes": [
        "Speaker: Gudin."
      ]
    },
    {
      "id": 136,
      "stanza_id": 29,
      "text": "De sjeldne Mænd, som her Du finder samlet.",
      "part": false,
      "marginal_notes": [
        "Speaker: Charles."
      ]
    },
    {
      "id": 137,
      "stanza_id": 29,
      "text": "See Buffon hist, den hæderkronte Olding,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 29,
      "text": "Hvis Ildsjæl tændte vidt og bredt sin Lue;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 29,
      "text": "Han som forstaaer saa skjønt med Ord at male,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 29,
      "text": "At selv et Sind, langt fjernet fra Naturen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 29,
      "text": "Fortryllet seer hos ham dens Værkers Storhed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 29,
      "text": "I klare Overblik.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 30,
      "text": "Alt fra min Barndom",
      "part": false,
      "marginal_notes": [
        "Speaker: Gudin."
      ]
    },
    {
      "id": 144,
      "stanza_id": 30,
      "text": "Jeg mindes vel, hvordan hans skjønne Bøger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 30,
      "text": "Tit lærte mig at see med andre Øine",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 30,
      "text": "De Dyr, som før jeg vel at kjende troede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 31,
      "text": "Tæt ved ham staaer en Mand i Kraftens Alder,",
      "part": false,
      "marginal_notes": [
        "Speaker: Charles."
      ]
    },
    {
      "id": 148,
      "stanza_id": 31,
      "text": "Lavoisier det er, end ei blandt Folket",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 31,
      "text": "Hans Navn er stort; men til et evigt Rygte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 31,
      "text": "Ved Tanker og Forsøg han har lagt Grunden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 31,
      "text": "Med Aandens Blik utrættet han forfølger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 31,
      "text": "Og træffer grant de mange fine Stoffer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 31,
      "text": "Hvis Luftnatur unddrager dem vort Øie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 31,
      "text": "Umaalt hans Rigdom er; men kun den tjener",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 31,
      "text": "Hans Videlyst og Videnskabens Venner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 32,
      "text": "En Lykkens Mand!",
      "part": false,
      "marginal_notes": [
        "Speaker: Gudin."
      ]
    },
    {
      "id": 157,
      "stanza_id": 33,
      "text": "Saa vilde jeg ham kalde,",
      "part": false,
      "marginal_notes": [
        "Speaker: Charles."
      ]
    },
    {
      "id": 158,
      "stanza_id": 33,
      "text": "Hvis Solons Ord mig ikke foresvæved;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 33,
      "text": "Dog denne Mand ei lignes bør ved Kroesus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 33,
      "text": "Hans Minde skal ei hænge ved hans Rigdom.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 33,
      "text": "Hist seer Du Diderot, som dristigt stifted",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 33,
      "text": "Hiin Encyklopædie, den Kæmpeskabning.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 33,
      "text": "Men d’Alembert, hans meget større Hjælper,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 33,
      "text": "Jeg kan ei vise Dig; for fire Uger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 33,
      "text": "Vi jorded ham.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 34,
      "text": "Ven, tilgiv min Forundring!",
      "part": false,
      "marginal_notes": [
        "Speaker: Gudin."
      ]
    },
    {
      "id": 167,
      "stanza_id": 34,
      "text": "Dig var jo Dyd, Religion og Sæder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 34,
      "text": "Bestandigt dyrebar! Kan Du da prise",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 34,
      "text": "De Mænd, hvis Skrifter, og hvis Liv har virket",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 34,
      "text": "Saa meget Ondt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 35,
      "text": "Lad ikke gammel Fordom",
      "part": false,
      "marginal_notes": [
        "Speaker: Charles."
      ]
    },
    {
      "id": 172,
      "stanza_id": 35,
      "text": "Fra Klostrets Buur Din sunde Sands omtaage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 35,
      "text": "Jeg nægter ei, at ofte hines Angreb",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 35,
      "text": "Traf selv det Hellige. Men glem kun ikke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 35,
      "text": "Hvorledes først det Hellige var vanskabt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 35,
      "text": "Religion og Stat i alle Grene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 35,
      "text": "Var gjennemtrængt af mørke Tiders Rædsler.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 35,
      "text": "Stod Kirkebud almægtigt ei mod Tanken?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 35,
      "text": "Stod Fødsel ei mod medfødt ædel Daadkraft?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 35,
      "text": "Hvor der til Strid er saadan Spire nedlagt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 35,
      "text": "Der kæmpes maa. Det Gamle maa gaae under,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 35,
      "text": "Og gjøre Plads for en forynget Skabning.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 35,
      "text": "At nu i Kampens Harm de store Kræfter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 35,
      "text": "Forvildes tit, at Ilden, som skal rense",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 35,
      "text": "Det ædle Malm fra Slaggen, ogsaa spreder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 35,
      "text": "Vildt noget bort af dette, vel et Vilkaar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 35,
      "text": "For Dødeliges Daad maa stedse blive.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 35,
      "text": "Og brændemærk mig ikke mine Helte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 35,
      "text": "Som sædeløse Mænd. Prøv først at sigte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 35,
      "text": "Fra Sandhed fjendtlig Løgn, og jeg tør love,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 35,
      "text": "Du ei fordømmer dem, ja at du finder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 35,
      "text": "I D’Alembert en Mand, hver Hæder værdig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 36,
      "text": "Men vil den Nyhedssæd, man nu har udspredt,",
      "part": false,
      "marginal_notes": [
        "Speaker: Gudin."
      ]
    },
    {
      "id": 194,
      "stanza_id": 36,
      "text": "Ei bringe farlig Frugt for Stat og Kirke?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 37,
      "text": "Vel ahner jeg for Stat og Kirke Fare;",
      "part": false,
      "marginal_notes": [
        "Speaker: Charles."
      ]
    },
    {
      "id": 196,
      "stanza_id": 37,
      "text": "Men af de gamle Feil, man vil beskytte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 37,
      "text": "Ei af det Mod, som blotter dem, udleder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 37,
      "text": "Dens Kilde jeg. See hist den gode Konge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 37,
      "text": "Omslynget med et Næt af Fortids Misgreb;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 37,
      "text": "Vee over hver, som stiller sig med Vranghed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 37,
      "text": "Mod den, som vil med vaersom Haand dem rette!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 37,
      "text": "Sligt Vanvid huler meer og meer en Afgrund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 37,
      "text": "For Folket, som for Kongen og for Kirken.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 38,
      "text": "O! gid at hver Modstander af det Gode",
      "part": false,
      "marginal_notes": [
        "Speaker: Gudin."
      ]
    },
    {
      "id": 205,
      "stanza_id": 38,
      "text": "Beskæmmes maa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 39,
      "text": "Og at det Godes Venner",
      "part": false,
      "marginal_notes": [
        "Speaker: Charles."
      ]
    },
    {
      "id": 207,
      "stanza_id": 39,
      "text": "Kun med besindigt Raad sig Kongen nærme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 39,
      "text": "Men lad os ei vort Øiemeed forfeile!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 39,
      "text": "See vel dig om! Hist staaer en kraftig Olding",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 39,
      "text": "Ved Diderot.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 40,
      "text": "Han i de simple Klæder?",
      "part": false,
      "marginal_notes": [
        "Speaker: Gudin."
      ]
    },
    {
      "id": 212,
      "stanza_id": 40,
      "text": "Ja han er Synet værd for tusind Andre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 40,
      "text": "Hans klare Forskerblik, den stærke Villie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 40,
      "text": "Den Sandruhed, som lyser af hans Aasyn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 40,
      "text": "Indgyder Ærefrygt. Jeg næsten gjætter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 40,
      "text": "Det Franklin være maa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 41,
      "text": "Du rigtigt træffer.",
      "part": false,
      "marginal_notes": [
        "Speaker: Charles."
      ]
    },
    {
      "id": 218,
      "stanza_id": 41,
      "text": "Sit Fødelands fuldmægtige Udsending,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 41,
      "text": "Han sluttet har den Fred, som skal betrygge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 41,
      "text": "Hiin Frihed, hvorfor det saalænge kæmped,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 41,
      "text": "Iblandt hvis Fædre han maa billigt sættes.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 41,
      "text": "Ham blev ved Fødselen ei Rang, ei Rigdom",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 41,
      "text": "Tildeel, men trange Kaar; dog mægtigt hæved",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 41,
      "text": "Ham egen Flid til Lærdom og til Velstand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 41,
      "text": "Høit staaer hans Navn i Videnskabens Rige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 41,
      "text": "Som den, der indsaae først den store Grundlov,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 41,
      "text": "At hver electrisk Virkning har sit Udspring",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 41,
      "text": "Af Kraftens Ligevægt, som blev forstyrret,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 41,
      "text": "Og som ved indre Kamp skal gjenoprettes.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 41,
      "text": "Hvordan han Himlens Lyn har lært at lede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 41,
      "text": "Veed hele Verden nu. Saaledes staaer han",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 41,
      "text": "Da med en doppelt Krands: han vristed Sceptret",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 233,
      "stanza_id": 41,
      "text": "Fra Undertrykkerne, fra Himlen Lynet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 234,
      "stanza_id": 42,
      "text": "Beundringsværdig! Men der ved hans Side",
      "part": false,
      "marginal_notes": [
        "Speaker: Gudin."
      ]
    },
    {
      "id": 235,
      "stanza_id": 42,
      "text": "Jeg seer en Mand, saa hæslig, at han bærer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 236,
      "stanza_id": 42,
      "text": "En Daares Præg med en Forbryders parret.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 237,
      "stanza_id": 43,
      "text": "Marat er Mandens Navn. Hans Blik ei lyver.",
      "part": false,
      "marginal_notes": [
        "Speaker: Charles."
      ]
    },
    {
      "id": 238,
      "stanza_id": 43,
      "text": "Naturens Videnskab har ingen Dyrker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 239,
      "stanza_id": 43,
      "text": "Saa fuld af Overmod, af Had, af Rænker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 240,
      "stanza_id": 43,
      "text": "Som denne Mand. Han Ildens skjulte Aarsag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 241,
      "stanza_id": 43,
      "text": "For Øiet stille vil, og lidt kun ahner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 242,
      "stanza_id": 43,
      "text": "Det Hemmelige, som han plumpt vil sandse.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 243,
      "stanza_id": 43,
      "text": "Han Newton vil fra gamle Throne styrte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 244,
      "stanza_id": 43,
      "text": "Og hader alt, hvad stort er og ophøiet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 245,
      "stanza_id": 44,
      "text": "Det er da ham, som vilde have dræbt Dig?",
      "part": false,
      "marginal_notes": [
        "Speaker: Gudin."
      ]
    },
    {
      "id": 246,
      "stanza_id": 45,
      "text": "Det sær mærkværdigt er ved Daadens Aarsag.",
      "part": false,
      "marginal_notes": [
        "Speaker: Charles."
      ]
    },
    {
      "id": 247,
      "stanza_id": 45,
      "text": "Fordi jeg ikke fandt hans Mening rigtig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 248,
      "stanza_id": 45,
      "text": "Han Kaarden mod mig trak; og havde sikkert",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 249,
      "stanza_id": 45,
      "text": "Mig heden sendt, hvis Hurtighed og Styrke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 250,
      "stanza_id": 45,
      "text": "Ei havde mig erstattet Værgets Afsavn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 251,
      "stanza_id": 45,
      "text": "Men nu er meer ei Tid til andre Tanker;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 252,
      "stanza_id": 45,
      "text": "Udspændt Luftsækken er; den muntre Lue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 253,
      "stanza_id": 45,
      "text": "Sig hæver høit, og alt man er til Rede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 254,
      "stanza_id": 45,
      "text": "At løse Snorene, som fast den holde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 255,
      "stanza_id": 45,
      "text": "Betragt nu kun de To, som vove Farten:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 256,
      "stanza_id": 45,
      "text": "Han for vor høire Haand er Hovedmanden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 257,
      "stanza_id": 45,
      "text": "Pilatre de Rosier. Hans Mod forvovent",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 258,
      "stanza_id": 45,
      "text": "Man kalde kan. Marqvisen af Arlandes",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 259,
      "stanza_id": 45,
      "text": "Den anden er. Han Æren har for Øie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 260,
      "stanza_id": 46,
      "text": "Men siig mig dog hvorfor ei de, som opfandt",
      "part": false,
      "marginal_notes": [
        "Speaker: Gudin."
      ]
    },
    {
      "id": 261,
      "stanza_id": 46,
      "text": "Luftskibet, selv den Ære sig tilegne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 262,
      "stanza_id": 46,
      "text": "Er det af Frygt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 263,
      "stanza_id": 47,
      "text": "Nei derpaa kan Du stole.",
      "part": false,
      "marginal_notes": [
        "Speaker: Charles."
      ]
    },
    {
      "id": 264,
      "stanza_id": 47,
      "text": "Men hvis et Uheld traf den første Opfart,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 265,
      "stanza_id": 47,
      "text": "Maaskee den hele Kunst faldt reent tilbage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 266,
      "stanza_id": 47,
      "text": "I Glemsel; saa man frygter, skjøndt med Uret,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 267,
      "stanza_id": 47,
      "text": "Hvis jeg mig skuffer ei.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 268,
      "stanza_id": 48,
      "text": "See nu sig hæver",
      "part": false,
      "marginal_notes": [
        "Speaker: Gudin."
      ]
    },
    {
      "id": 269,
      "stanza_id": 48,
      "text": "Luftskibet stolt, belyst af Solens Straaler! –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 270,
      "stanza_id": 48,
      "text": "See hvor de hilse nu til os herneden!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 271,
      "stanza_id": 48,
      "text": "Og høit op til dem stiger Flokkens Jubel –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 272,
      "stanza_id": 48,
      "text": "De nærme sig Paris. Ak hvis de dreves",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 273,
      "stanza_id": 48,
      "text": "Af Vinden mod dets Taarne, dets Paladser! –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 274,
      "stanza_id": 48,
      "text": "Nei, nu de hæve sig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 275,
      "stanza_id": 49,
      "text": "Man har forstærket",
      "part": false,
      "marginal_notes": [
        "Speaker: Charles."
      ]
    },
    {
      "id": 276,
      "stanza_id": 49,
      "text": "Det sjunkne Blus. Nu kan fra høien Himmel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 277,
      "stanza_id": 49,
      "text": "De skue ned paa Staden og dens Slotte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 278,
      "stanza_id": 49,
      "text": "Det er den første Gang, at Manden skued",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 279,
      "stanza_id": 49,
      "text": "Med Fuglens Blik ned paa den travle Vrimmel. –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 280,
      "stanza_id": 49,
      "text": "Alt ere de hinsides Staden komne. –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 281,
      "stanza_id": 49,
      "text": "En anden Luftstrøm nu de have naaet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 282,
      "stanza_id": 49,
      "text": "I høie Luft. Den fører dem tilbage. –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 283,
      "stanza_id": 49,
      "text": "See nu de dale ned; min Kikkert siger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 284,
      "stanza_id": 49,
      "text": "Mig, at der ei dem noget Ondt er tilstødt.",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
