{
  "id": null,
  "title": "Dronning forener de elskende",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA109.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Her er en iumfru paa wor land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "thett er saa høffsk en lille-wand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": ":: Thend weneste lylly paa thette land, hun gaasz meg aldrig aff huoffue. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Paa wordt land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "hun er saa høffsk en lyly-wand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Hun er høffsk och hun er huid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "och hun er daanys och dydelig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Hun er huid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "och hun er dannisz och dydelig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Der thiener en suend y kongens gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "hand slider rød skaarlagen, hand drager morrd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "I kongenns gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "hand slider rød skaarlagen, hand drager muord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Hand kand icke søffuen om natten faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "saa er den iumfru y hans huoff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "Om nattenn faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "saa er den iumfru y hans huoff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Hun haffuer hanom y hiarttett kierr",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "for alle dy mienesker y werden er.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 5,
      "text": "I hiarttett kierr",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "for alle dy myenesker y werden er.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Thett stuod saa enn aar ellder thuo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "ingen thett weste, och ingen thett fruo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 6,
      "text": "Aar elder thuo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "ingenn thett weste och ingen thett fruo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Thend herre skulde y lieding faare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "den iumfru gred, hun skuld hieme werre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 7,
      "text": "Y lyeding faare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "denn iumfru gred, hun skuld hieme werre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Hand klaper hinder wed huidenn kiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "\"Huy sørger thu saa, alder-kerreste mynn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 8,
      "text": "Huiden kind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "\"Huy sørger thu saa, alder-kerreste myn?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Ieg skall købe deeg aager-vld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "och iett saa skøntt ett hoffuett guld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 9,
      "text": "Aager-vld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "och iett saa skønt ett hoffuet-guld.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "\"Ieg well rett aldrig hoffuettguld berre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "thend stund y skaall y lieeding werre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 10,
      "text": "Hoffuett-guld berre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "thend stund y skall y lieeding werre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Mytt guods thett wilde ieg kongenn gyffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "alt om y matte y landen blyffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 11,
      "text": "Kongen gyffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "alt om y matte y landen blyffue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Droningen stuod och liude der-paa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "saa hiemelig hun luo vnder skaarlagen smaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 12,
      "text": "Och lyude der-paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "saa hiemelig hun luo vnder skaar-lagen smaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "\"Thaa skall ieg nu thett giøre saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "att y skaall buode eders wilge faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 13,
      "text": "Giørre saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 13,
      "text": "att y skall buode eders wilge faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "Her Nellus, thu skalt icke y liedding y aaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "ieg skall lade begge eders brølup buo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 14,
      "text": "I lyding y aaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "ieg skaall lad begge eders brølup buo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Ther-som thu est hynder nogett for rig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "thaa er hun theg møget for dydelig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 15,
      "text": "Nogett for rig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 15,
      "text": "tha er hun deg møgett for dydelig.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "Droningen suøber seg hoffuett y skyend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "hun gaar y lofft for kongen innd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 16,
      "text": "Hoffuett y skiennd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 16,
      "text": "hun gaar y lofft for kongen ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "\"Ieg bederr enn bønn, myn edelig herre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "Maa her Nelus icke loffue stalt Blydelild med erre?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 17,
      "text": "Mynn edelig herre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 17,
      "text": "Maa her Nelus icke loffue stalt Blidelild med ere?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "\"Iaa saa mend, daa maa hand saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "ieg wel lade begis dierisz brølup buo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 18,
      "text": "Maa hand saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 18,
      "text": "ieg well lad beggis dierris brølup buo.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "Ther waar løst att liude der-paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "den rider gaff denn iumfru syn thro.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": ":: Den weneste lyly paa thette land hun gaaesz meg aldrig aff huoffue! ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}