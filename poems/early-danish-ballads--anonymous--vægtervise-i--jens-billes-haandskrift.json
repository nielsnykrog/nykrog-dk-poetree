  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Jens Billes Håndskrift",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1555,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/BILL3.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "den vinters-nat gørs kold oc lang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "der-af | ypes min høgelig kere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "det jeg mote finde | min kereste ven",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "alt bode j dyd oc ere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "jeg | gick for bori alt met stor sore",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "bekymred | var al min sinde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "jeg bad den veckter saa | inderlig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "hielp meg den til trøsterjnde |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "oc veckter god for-staa min ord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "fornvmed | hafver dv min kere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "vedst dv meg nogen | gode rod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "ieg vil dig høgelig ere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "min gafve | skal vere for eder vspard",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "om jeg kand tro-skaf befinde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "din rigdom skal jeg gøre sa | stor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "for-smaa skaltdu at voge ofver mvr | oc tinde |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "oc vngersvend god din klafve er stor |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "det mercker jeg paa din tale",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "vil min | froe trøste dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "din glede bliver al mode |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "hvn er bode danis oc dydelig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "hine føler | bode tvckt oc sinde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "dit budskaf vil jeg tro-lige bere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "troskaf skal du be-finde |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "den veckter gor saa hemelig bort",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "han | klaper paa dør met lise",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "oc voge op min skøne | froe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "eders glede vil seg op reyse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "her holler | en svend for-vden vor gord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "hans glede | hafve j at volde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "lar meg forstaa paa eders | talle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "om j ville troskaf be-holle |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "oc veckter god tal jcke saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "din ord hafver | dv forboret",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "den svend jeg hafver j hiertet | ker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "for ham ber jeg stor sørig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "hand er fra | meg saa langen led",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "der-ofver saa tager | jeg røne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "oveckter vare din talle sant",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "riglige | ville jeg dig lønne |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "den veckter vogste j hven vred",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "oc hand | be-gynte at trve",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 5,
      "text": "jeg hafver eder tient saa | langen tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 5,
      "text": "jeg er jcke vant at lyve |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 5,
      "text": "lader mig for-staa paa eders talle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "om j | ville troskaf be-finde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "jeg hielper den | gest som jeg kand best",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "alt bode ofver | mvr oc tinde |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "oc gledens port blef der af lat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 6,
      "text": "alt j den same | sinde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 6,
      "text": "til-samen da kome de vnge tv",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 6,
      "text": "al søri | mvne de for-gleme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 6,
      "text": "oc da be-gynte en lønlig | snack",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "at mester mote det skrive",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "j ere oc dyd | oc glede oc fryd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "de mote til-samenblive |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 7,
      "text": "den veckter bar op en vise oc kvad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 7,
      "text": "det | skald ofver bierig oc dalle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 7,
      "text": "oc er her nogen | fremed gest",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 7,
      "text": "der fryckter for dagsent fare |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 7,
      "text": "hand brvger for-nvft oc ofve-vold",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 7,
      "text": "om | hand kand seg besinde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 7,
      "text": "forglemer hand | seg da gleder det mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "bode lif oc gods | oc lemer |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 8,
      "text": "den froe hvn fick saa storer svck",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 8,
      "text": "alt j | den vngersvnds arme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 8,
      "text": "hinis rosen-kinder | di falned ved",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 8,
      "text": "der-ofver mote gvd forbar-me",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 8,
      "text": "o veckter god hvi bedrøver dv meg |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 8,
      "text": "det kaand deg deg jntid frome",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 8,
      "text": "den | nat hvn er jcke hal fo-gon",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 8,
      "text": "siden | vi til-samen kome |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 9,
      "text": "den froe lod op et lididet vindve",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 9,
      "text": "hvn | saa ofver bierig oc dalle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 9,
      "text": "hvn saa den lyse | morigen-stierne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 9,
      "text": "hvn skinde ofver verden | alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 9,
      "text": "min aller-keriste ven jeg befaller eder | krist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 9,
      "text": "den dag skin lys met alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 9,
      "text": "j-hvort som | j j verden komer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 9,
      "text": "jeg vil eder aller vnd-falle | |",
      "part": false,
      "marginal_notes": []
    }
  ]
}