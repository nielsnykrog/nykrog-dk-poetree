  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "LJge maade tog han oc kalken effter afftens maaltiid oc sagde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Tager oc dricker allesammen der aff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "dette er det ny Testamentis kalk y myt blod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "det som bliffuer vdgiffuit for eder oc for mange til syndernis forladelse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "gører saa offte som y det dricke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "y myn hwkommelse.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Herren wære eder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Oc med dyn aandt.",
      "part": false,
      "marginal_notes": []
    }
  ]
}