  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Almæctige Gud, al Verdens Skaber oc HErre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Præctig du gaaer her ud, din Gierning ziirlig maa være!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Herlighed er din dragt, oc Lius dit Klædebon hvide!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Deilighed er din Pract, du skin som Solen hin blide!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Blankt dit Klædebon er, din' Hænders Gierninger liuse,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Neppe dem Phoebus seer, før hand flux lader sig kiuse.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Ingen, i Verden viid, sligt Mesterstycke har skaaret,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Ingen, af Adams tiid, saa konstig Qvinde har baaret;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Ej Teltmageren kand sit Pauluun kruse saa artig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Perlestickerens Haand tapet ej Sticker saa fartig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Du jo HErre Gud før, det skønnest' Himmelens Decke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Som det, HErre, dig bør, mon ofver Jorderig strecke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Ziirlig Demanten er, saa oc den røde Rubine:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Soolen skønner oc skær, paa højen Himmel, maa skinne:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Perlerne stickis næt tapetet herligt at pryde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Stjernerne bedr' er sæt', hves Orden ingen kand bryde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Aldrige nogen tiid slig grundvold Mestere lagde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Ingen i Verden viid slig Bygning muured' oc magde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Du jo stærckere langt al Verden monne begrunde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "Bjerget saa højt oc rankt med Klipper brede ja runde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "Icke med Pæl til styt, paa piller Stæne ved giære;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "Men paa været saa blødt, som Hafvet icke kand bære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "Vanden' hen ofvergaae taarn, spiir' oc fjeldene høje,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "Landene dog ej maae den ringste Skade tilføje.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "Du Rørmestere klog oplader Kilderne klare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "Qvæger maae der faae nok, der dricker Djurenis Skare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 1,
      "text": "Elfven saa striide gaaer imellem grønneste Liide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 1,
      "text": "Fuglen der Skaalen naaer, der segler Svanen hin hviide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 1,
      "text": "Aanden der dycke maae der med sin' Ellinger spiller,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 1,
      "text": "Tryggelig gaasen graa paa Tuen sofver oc hviler.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 1,
      "text": "Gardener est du viis det gjr din Hafve tilkænde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 1,
      "text": "Fuld med Vrter oc riis, oc Græs foruden all ende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 1,
      "text": "Ageren det kundgiør som du opfylder med Grøde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 1,
      "text": "Træerne det udfør' af dig forgyldes med føde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 1,
      "text": "Det Viingaarden fortæl, som gîr os Vinen hin blanke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 1,
      "text": "Olden det viiser vel i Skofven' høje ja ranke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 1,
      "text": "Fuglen der fryder sig, med sit sød-klingende Stemme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 1,
      "text": "Ved velsignelse slig, oc kand sin Skaber ej glemme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 1,
      "text": "Du Fiskmestere riig din Dam kand aldrig udtømmis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 1,
      "text": "Vandet ej setter sig, dog det med Demning ej gemmis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 1,
      "text": "Hvalen hand gaaer i spryng, oc Styrren leeger med hale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 1,
      "text": "Silden hun gaar i Lyng, oc Torsk med Finderne prale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 1,
      "text": "Marsvinet tumler sig, den Sæl-hund spiller for Borde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 1,
      "text": "Tanthejen underlig mon til en Dantzere vorde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 1,
      "text": "Orphei Harpe gaaer, men Hafvet springer oc spiller,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 1,
      "text": "Lutten Apollo slaaer, men Fisken tumler oc driller.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 1,
      "text": "Du Skolemester est fix som uden Bogstafven lærer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 1,
      "text": "Icke med V eller X men med Mirakler udsperrer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 1,
      "text": "Dennem hvo seer oc hør i Himmelen eller paa Jorde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 1,
      "text": "Var hand Læredreng før hand maae snart Mestere vorde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 1,
      "text": "Som udførligen meer her efter blifver befundet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 1,
      "text": "Oc for alle ja hver af dine Skabninger vundet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 1,
      "text": "David Sangeren, vel maae dine præctig' idrette",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 1,
      "text": "Vndr' oc priise med Skel hand maae bekænde med rette;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 1,
      "text": "Jorderig er opfyldt af HErrens Godhed fra grunde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 1,
      "text": "Jorderig er forgyldt med HErrens Gafver de runde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 1,
      "text": "O du kiereste Gud, frem for Sirenerne mange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 1,
      "text": "Du betager mit Mood! Jeg er din Skabelses fange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 1,
      "text": "Saadan Foræring riig med andr' utallige fleere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 1,
      "text": "Du ej, HErre Gud, dig, men Mennisken monne forære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 1,
      "text": "At de skulle for det, dig lofv' oc hiertelig priise,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 2,
      "text": "Ja paa hverrende sted, dig tack oc ære beviise.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 2,
      "text": "Ligesom du oc vist var Konsten mæctig oc ferdig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 2,
      "text": "Vilde du uden frist fuldbiurde Skabningen værdig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 2,
      "text": "Dage sex, stod det paa, alting, af intet, bereddis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 2,
      "text": "Siuvende hviilte saa, oc ved de Gierninger glæddis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 2,
      "text": "Værdelig om sligt verk nu skuld' oc kunde beregnis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 2,
      "text": "Maatte mig vel nu stærk en Engle-tunge tilegnis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 2,
      "text": "Palladis Viisdoms Skriin vil her fuld snarlig udtømmis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 2,
      "text": "Oc Demostenes fiin for tungen lidet berømmis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 2,
      "text": "Skulde her høris ret sligt u-begribelig Under,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 2,
      "text": "Øret var alt for slet det Hiertet icke begrunder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 2,
      "text": "Er ej bedre for raad, vi os dig, Skaber, tilvende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 2,
      "text": "Bede med Suck oc graad du vilt din hellig Aand sende:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 2,
      "text": "Hvilken i første tiid den raa materie qvegte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 2,
      "text": "Varmed' af Kraften bliid oc ret som Hønnen udklegte:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 2,
      "text": "HErre Gud, hiælp oc varm gif Lius vort syndige Hierte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 2,
      "text": "HErre Gud dig forbarm stik op din Fackel oc Kierte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 2,
      "text": "Flydende giør min Pen den drif med Fingrene dine,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 2,
      "text": "Lydende giør din Ven ô Øremester hin fiine:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 2,
      "text": "Du, som eenist dog er den døv-mand lærer at høre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 2,
      "text": "Du, ô Skabere kier, lær dummen tungen at røre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 2,
      "text": "Paa dit Løfte til gafn vi ville haabe ja liide;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 2,
      "text": "Hermed i Jesu Nafn vi saa til Arbeydet skriide.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
