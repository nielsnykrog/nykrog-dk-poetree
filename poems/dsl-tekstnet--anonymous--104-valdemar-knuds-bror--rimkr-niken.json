{
  "id": null,
  "title": "104. Valdemar, Knuds bror",
  "year_created": 1495,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Rimkrøniken",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1495,
    "url": "https://tekstnet.dk/books/anon_rimkroeniken/107/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Thet kan wære en faerlig sedh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "at giøre imod syn ord och edh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "och mest en herre och første.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "sandhed han begherer aff hwer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Ieg thet befand meth gørste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Trediw aar effter ieg konning wor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "ieg hedhen oc ind tijl Norgæ for",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Philippum giorde ieg tijl hertug ther.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "The iettæ meg manskab fiern oc ner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "tro tiæniste the meg sworde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Ther nest ieg op offuer Elffuen foer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "och lade them øde meth allæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Saa fick ieg meg en ionfrw klar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "hwn konghens dotter aff Beemen war;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Dagmær mwnne man henne kallæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "han hade seg tænct i Danmark ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "orloff han meg paa førde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "Thi for ieg genesten hannum imod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Meth Danmarks macth tijl hest oc fod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Siden lod ieg bygge Demyn slot",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "och ned slo Hwerisborig, som wor om got,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "ieg skøtte ey hwo thet spurde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "Greffue Henric oc greffue Gyntzelyn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "och manskap the meg sore.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "Ieg wand oc eth slot, thet hed Stætyn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "och eth hed Nutten, wndher hande myn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "Marcgreffuen thet tijl hørde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "Ther næst wand ieg oc Rytzeland.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "Oc hertugen aff Polen gik meg til hand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": "tha han myn seyer hørde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "han skøtte ey ath hans folk fik meen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "han wille thet land bestride.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "Ieg kom meth trysynnetiwe twsend men,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": "the wore ey fære, icke tijl en.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 7,
      "text": "Saa drowen tijlbage han wor ey blijd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "for han misthe ther i eenlig strijd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 7,
      "text": "the ypersthæ too men han hade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": "Them sloo Broder oc Swen Stærkæ ihiell",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 7,
      "text": "Wij wore ther ath ful glade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 8,
      "text": "Siden lod ieg giøre offuer Elffuen en broo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 8,
      "text": "och foer ther offuer meth tørre skoo;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 8,
      "text": "greffue Henric willæ ieg tha geste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 8,
      "text": "Hans land wand ieg wnder macthen myn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 8,
      "text": "meth sloth oc stædher the besthe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 9,
      "text": "For Hamborigh ieg eth halt aar laa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 9,
      "text": "alt før ieg kunne then stadhen faa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 9,
      "text": "Meth too borgher ieg belade them saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 9,
      "text": "ath the kunne icke meer tijl them faa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 9,
      "text": "æn the hade førre inne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 10,
      "text": "Ieg lod byggæ eth slot i Ditmerske land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 10,
      "text": "elder noger thet fraa meg winne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 10,
      "text": "Saa lod ieg oc byggæ eth anneth sloth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 10,
      "text": "tijl lande wern bode fast oc goth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 10,
      "text": "ther stoorTraffuenmyndhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 11,
      "text": "meth hal annith twsende store skijb,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 11,
      "text": "tijl Estland lod ieg stande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 11,
      "text": "Ieg wand thet land oc wor saa froo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 11,
      "text": "ieg lod them kænne then helliæ troo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 12,
      "text": "Saa søcthe ieg them i Liffland boo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 12,
      "text": "oc kom them tijl then cristen troo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 12,
      "text": "Ieg Ræffuell oc Rij bestrijde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 12,
      "text": "ieg skickede them wndher Danmarks wold.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 12,
      "text": "the meg ther well tijl lyddhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 13,
      "text": "Twsende tw hundrede oc otte aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 13,
      "text": "effther ath Gutz søn fødher waar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 13,
      "text": "tha slos i Swerige hos Lene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 13,
      "text": "som Swæckæ, syn maw, tijl hielppe kom",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 13,
      "text": "meth danskæ riddhre oc swene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 14,
      "text": "Thernest tha for greffue Henric aff land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 14,
      "text": "och meg befaledæ syn hwsfrw i hand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 14,
      "text": "Thet kom saa ath ieg meth henne laa;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 14,
      "text": "Han toge't tijl hadh ther han thet fraa;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 14,
      "text": "ther foræ bleffue wij wsottæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 15,
      "text": "Han greff meg i Lywthø paa myn sæng",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 15,
      "text": "han oss tijl Sweryn førde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 15,
      "text": "Ther sade wi fangnæ i boyer stærk",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 15,
      "text": "tijl danskæ woss løstæ for xl twsent mark",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 15,
      "text": "tha the thet spurde oc hørde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 16,
      "text": "the gaffuer som ieg ther borth gaff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 16,
      "text": "the stode ey dyrt mynnæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 16,
      "text": "Meth hestæ oc andræ kleynodh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 16,
      "text": "som ieg the herre giffue lodh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 17,
      "text": "Saa mottæ wij leggæ wore hender paa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 17,
      "text": "Gutz werdigæ legom oc swæriæ theraa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 17,
      "text": "ath wij skullæ thet ey heffnæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 17,
      "text": "Men tha ieg kom tijl lande igen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 17,
      "text": "om ieg kunde faa thes effnæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 18,
      "text": "Thi sænde ieg budh tijl pawen i Rom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 18,
      "text": "han fik godh tyendæ tha han tijdh kom;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 18,
      "text": "han meg affløsen hiem førdhe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 18,
      "text": "tha ieg fra them tijl lande for,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 18,
      "text": "som ieg tijl forne aff rørdhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 19,
      "text": "Saa lod ieg ther sænckæ en mechtig hær;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 19,
      "text": "i Borendhweld slos han theswær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 19,
      "text": "Ieg hade tha bleffuet ther greben ighen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 19,
      "text": "hade ey meg vndsæth en myn wen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 19,
      "text": "medh raadiched och lystæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 20,
      "text": "Men siden ieg wor aff orloff træth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 20,
      "text": "och bødh them skellig ath leffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 20,
      "text": "Forthi ath the som leffue meth skeell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 20,
      "text": "thet gor them gærnæ i werdhen well,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 20,
      "text": "meth gudh tha bliffue the geffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 21,
      "text": "tha løb meg i synd alt som mest",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 21,
      "text": "hwo effter meg skullæ regere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 21,
      "text": "och hworlunde myne sønner tre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 21,
      "text": "skullæ seg hwer modh annen the,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 22,
      "text": "Ieg bleff saa standendæ nær en daw",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 22,
      "text": "før ieg kom meth myn tænckæ i law",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 22,
      "text": "om thesse forscreffne støckæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 22,
      "text": "Siden spurde meg en riddher godh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 22,
      "text": "han badh meg thet wth thryckæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 23,
      "text": "»Faar borth,« sade ieg, »tijl Swerigis land!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 23,
      "text": "Ther boer en riddher, her Bonde hed han.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 23,
      "text": "Han kan theg thet berættæ.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 23,
      "text": "och fik thet ath widhe ther han tijd kom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 23,
      "text": "aldelis som ieg hannum iættæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 24,
      "text": "»Thyn herre,« sade han, »han tænctæ ther aa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 24,
      "text": "hworledis thet skullæ hans søner gaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 24,
      "text": "Men syæ hannum thet for sandhen saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 24,
