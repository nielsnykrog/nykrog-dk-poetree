  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "DJg være loff oc priss o Herre Christ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "benedidet er den dag for vist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Vy loffue dig nu oc til ewig tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Hellig hellig est du i det høgiste/",
      "part": false,
      "marginal_notes": [
        "Esaie vi"
      ]
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Englene oc offuer Engle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Tronerne oc det hiemmelske herskaff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Dig loffue Cherubin och Seraphin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Hellig hellig hellig siungis i det øffuerste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "* Dit folk o Christe loffue dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Din brud aff hiertet nw glæder sig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "For din naade oc barmhiertighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Hellig hellig hellig hun siunger dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Pax domini sit semper vobiscum",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Herrens fred wær met eder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "Oc met din aand",
      "part": false,
      "marginal_notes": [
        "Johan i"
      ]
    }
  ]
}