  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "MJn siel holder megit aff herren",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 1,
      "text": "Oc min aand frøyder sig i Gud min frelsere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 2,
      "text": "Thi han haffuer seet till sin tienerindis fornedring",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 2,
      "text": "der fore/ se/ nw fra denne tid skulle alle slecter sige mig ath wære salig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 3,
      "text": "Thi han haffuer giørt merckelige mod mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 3,
      "text": "som er mectig hwess naffn oc er helligt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 4,
      "text": "Oc hans miskundhed recker fra det ene slect oc til det andet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 4,
      "text": "offuer dem alle som frøcter hannem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 5,
      "text": "Han haffuer giort mectige gerninger met sin arm/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 5,
      "text": "han haffuer forspredt de hwstolte aff deris hiertens grund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 6,
      "text": "Han haffuer neder stødt de weldige aff sædet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 6,
      "text": "och de fornedrede haffuer han ophøffuit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 7,
      "text": "De hungrue haffuer han mettet met det som gaat er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 7,
      "text": "oc de rige haffuer han forladit thombugede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 8,
      "text": "Han haffuer tenckt paa sin miskundhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 8,
      "text": "och ophwlpet sin tienere Jsrael",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 9,
      "text": "Som han tilforn hagde tilsagt wore forfedre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 9,
      "text": "Abraham oc hans afffødninge ath holde euindelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 10,
      "text": "Ere være Gud fader Søn och den Helligand",
      "part": false,
      "marginal_notes": []
    }
  ]
}