  "source": {
    "id": null,
    "title": "[tabt]",
    "year_published": 1533,
    "publisher": "Christiern Pedersen",
    "printer": "Joh. Hoochstraten",
    "place": "Malmø",
    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/malmoe-salmebog/1/69"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "LOffuer Gud i fromme Christne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "queder oc værer glade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "met konnig Dauid psalmiste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "priser Gud i alle stad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "At Gudz ord monne nu klinge",
      "part": false,
      "marginal_notes": [
        "Psal xxxiii"
      ]
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "saa vit offuer alle land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "der met wi Christum finde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "vor eniste frelser mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Gud haffuer nu aff sin naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "opuect en Christen mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Gudz ord monne han framdrage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Der met beuiser hand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "ath wi som kallis Christne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "haffue lenge farid vilde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "til alt gaat wærid vissne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "det vaar vore lærefædrers skyld",
      "part": false,
      "marginal_notes": [
        "Hierem l Joh xiiii Johan viii Roma i Psa lxxxi"
      ]
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Reth vey til hiemmerige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "er Gudz ord vden tuil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "som Christus selff siger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "huo hannem følger far ey wild/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Men wi haffue det foractid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "ingen tro satte wi der paa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "thi haffuer oss Gud bort kastid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "oc lod oss i mørcke gaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Alt det som wi monne gøre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "vor ingen mand nøtteligt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "thi dieffuelen monne oss føre/",
      "part": false,
      "marginal_notes": [
        "Gene iii Hier xxiii i Tim iiii"
      ]
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "ret mod Gudz ord altid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Met falske iertegen och drømme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "satte han sin snare for oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Ath wi skulle Gudz ord glømme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "och saa met hannem forgaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Han haffuer och ladit scriffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "mod Gudz ord lærdom ny/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "der met han monne forgiffue/",
      "part": false,
      "marginal_notes": [
        "ii Tessal i i Corin xvi"
      ]
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "alle dem som Gudz ord sky/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "Och sette deris haab til andit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "en Christi pine oc død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "de ere aff Gud forbandit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "oc komme til helffuedis glød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "Der paa skal mand dem mercke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "som dieffuelsens lærdom følge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 5,
      "text": "ath de ville altid gerne/",
      "part": false,
      "marginal_notes": [
        "Hier xviii"
      ]
    },
    {
      "id": 43,
      "stanza_id": 5,
      "text": "haffue deris egen vilge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 5,
      "text": "oc følge deris egne sinde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "oc menniskens falske lærdomme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "Gudz ord wille de ey nemme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "de ere dem beske och hwasse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "De holde mere aff deris wane/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 6,
      "text": "och gamle forfædrers dict/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 6,
      "text": "en aff Gudz ord det sande",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 6,
      "text": "och Gud faders hellige skrifft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 6,
      "text": "Som ewig tid haffuer wærid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "dogsige de ath det er nyt/",
      "part": false,
      "marginal_notes": [
        "Johan i",
        "i Ti iiii"
      ]
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "Gudz ord haffue de forladit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "oc dieffuelens lærdom till dem byt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 7,
      "text": "De klæde stocke oc stene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 7,
      "text": "oc holde besynderlige dage/",
      "part": false,
      "marginal_notes": [
        "Abacuc ii"
      ]
    },
    {
      "id": 58,
      "stanza_id": 7,
      "text": "der met ville de Gud tiæne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 7,
      "text": "och der fore hiemmerige haffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 7,
      "text": "De fattige lade de fryse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 7,
      "text": "och lide hunger oc nød/",
      "part": false,
      "marginal_notes": [
        "Esa lviii"
      ]
    },
    {
      "id": 62,
      "stanza_id": 7,
      "text": "Gud bød wi skulle dem spise/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "hans bud wi inted skøde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 8,
      "text": "Er det icke en stor blindhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 8,
      "text": "ath de wille Gud ey tro/",
      "part": false,
      "marginal_notes": [
        "Esaie vi Joan xiiii Joan xiii"
      ]
    },
    {
      "id": 66,
      "stanza_id": 8,
      "text": "som er den euig sandhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 8,
      "text": "oc wil giffue dem euig ro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 8,
      "text": "Alle dem hans lerdom følge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 8,
      "text": "det haffuer Christus fortiænt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 8,
      "text": "alt oppaa kaarssens galye/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 8,
      "text": "der till vaar han vdsent",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 9,
      "text": "Gud fader haffuer sin søn skickit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 9,
      "text": "til alles vor salighed/",
      "part": false,
      "marginal_notes": [
        "Joan iii"
      ]
    },
    {
      "id": 74,
      "stanza_id": 9,
      "text": "han haffuer oss sin scrifft giffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 9,
      "text": "hun er fulkommelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 9,
      "text": "Hun kan dig all sandhed lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 9,
      "text": "alt som dig er nytteligt/",
      "part": false,
      "marginal_notes": [
        "ii Tim iii Ma xxiii"
      ]
    },
    {
      "id": 78,
      "stanza_id": 9,
      "text": "wi behøffue ey mestere flere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 9,
      "text": "Christus giffuer hiemmerige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 10,
      "text": "Thi lade wi dem nu fare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 10,
      "text": "som tro paa sin egen krafft/",
      "part": false,
      "marginal_notes": [
        "Mat xv"
      ]
    },
    {
      "id": 82,
      "stanza_id": 10,
      "text": "wi wille hoss gudz ord wære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 10,
      "text": "oc tro huad Christus haffuer sagt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 10,
      "text": "J hannem all sandhed findis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 10,
      "text": "all naade och all miskund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 10,
      "text": "de skulle met dieffuelen twingis",
      "part": false,
      "marginal_notes": [
        "Coloss ii Joan iii"
      ]
    },
    {
      "id": 87,
      "stanza_id": 10,
      "text": "som hannem tro ingelund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 11,
      "text": "Seduane kan dem ey hielpe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 11,
      "text": "naar dommen holdis skal/",
      "part": false,
      "marginal_notes": [
        "Joan viii"
      ]
    },
    {
      "id": 90,
      "stanza_id": 11,
      "text": "oc ey deris gamle forfædre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 11,
      "text": "Christus bliffuer offuer dem alle/",
      "part": false,
      "marginal_notes": [
        "Joan v Math v"
      ]
    },
    {
      "id": 92,
      "stanza_id": 11,
      "text": "Hans ord skulle da framgonge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 11,
      "text": "oc alle skulle hiemmerige fonge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 11,
      "text": "som hannem haffue gongit til hande/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 11,
      "text": "och effter hans lærdom vandrit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 12,
      "text": "Priss wære Gud euindelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 12,
      "text": "som oss haffuer sine ord sent/",
      "part": false,
      "marginal_notes": [
        "Ephesi i"
      ]
    },
    {
      "id": 98,
      "stanza_id": 12,
      "text": "met dem wi kunde bliffue salig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 12,
      "text": "oc komme fra dieffuelsens tant/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 12,
      "text": "De lære ath tro gud all ene",
      "part": false,
      "marginal_notes": [
        "Mat xxii"
      ]
    },
    {
      "id": 101,
      "stanza_id": 12,
      "text": "altid for vden galle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 12,
      "text": "oc vor ieffn christen ath tiene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 12,
      "text": "det vnde oss Christus alle",
      "part": false,
      "marginal_notes": []
    }
  ]
}