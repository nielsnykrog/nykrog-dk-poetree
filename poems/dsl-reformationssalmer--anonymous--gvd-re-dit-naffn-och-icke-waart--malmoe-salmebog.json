  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "GVd ære dit naffn och icke waart/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "som loffuer miskund oc holder dine ord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Lad wchristne ey faa den frøyd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "at de mue sige/ huor er deris Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "Ja vor Gud er i hiemmelen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "huad han vil det bliffuer giort oc endt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Men deris guder ere oc guld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "som mand gør met hender oc staal",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "De haffue mund oc kunde icke tale",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "oc øgen som mand vil dem male",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 5,
      "text": "De haffue ørn oc icke høre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "och næse som mand vil dem gøre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 6,
      "text": "De kunde ey røre hand eller fod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "ey bede hielp om de i ilden stod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 7,
      "text": "Saadanne skulle de oc bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "som dem gøre oc de som der til lide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 8,
      "text": "Men lader oss sette vort haab til gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "saa vil han vere vor skiold oc spiud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 9,
      "text": "Som gamble fedre hagde haab til Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "saa vaar han oc deris skiold oc spiud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 10,
      "text": "Ehuo som frøcter oc haab til Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 10,
      "text": "den vill Gud vere baade skiold oc spiud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 11,
      "text": "Ere være Gud fader",
      "part": false,
      "marginal_notes": []
    }
  ]
}