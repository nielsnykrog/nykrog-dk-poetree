  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Da Tanke Lynet udsprang fra Din Pande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "En större Seekraft Videnskaben fik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "En umaalt Skat Du gav til Verdens Lande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Og gjennem alt det Skjönne i det Sande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Til Gud Du förer os med aabent Blik!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
