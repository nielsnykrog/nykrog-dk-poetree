  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Jeg er styg og rynket, jeg véd det nok,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "et Skumpelskud mellem Skabningers Flok;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Mennesket ønsker mig Pokker i Vold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "kalder mig ret en forgiftig Trold.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Ikke det véd, bag mit runkne Skind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "har jeg igrunden et ærligt Sind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Spottet i Verden, forstødt og hadet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "har jeg min Bolig bag Skræppebladet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Røres Du vilde, hvis Du blot saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "hvor mine fattige Unger smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "ligesom Menneskebørn, med Glæde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "hilse paa deres Moder dernede.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
