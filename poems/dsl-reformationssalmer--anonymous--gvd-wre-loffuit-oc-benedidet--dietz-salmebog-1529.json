  "source": {
    "id": null,
    "title": "Een ny handbog med Psalmer oc aandelige lofsange",
    "year_published": 1529,
    "publisher": "Ludwig Dietz",
    "printer": "Ludwig Dietz",
    "place": "Rostock",
    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/dietz-salmebog-1529/9/30"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "GVd wære loffuit oc benedidet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "somoss sielff haffuer bespÿset/",
      "part": false,
      "marginal_notes": [
        "j. Corin. xj."
      ]
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Med sitt legom oc med sitt blod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "thet giffue oss Herre Gud til gode",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Kyrieleyson.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Herre wid thit hellige legom",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "thet som aff thÿn moder Maria kom/",
      "part": false,
      "marginal_notes": [
        "Math. j."
      ]
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "thit hellige blod oc thÿn død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "hielp oss Herre aff all wor nød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Kyrieleyson.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Thit hellige legom er for oss giffuit/",
      "part": false,
      "marginal_notes": [
        "Luce. xxij."
      ]
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "ÿ døden att wÿ skulle leffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Jngen større gaffue kunde han oss skencke:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "ther med wÿ hannwm oc hans død betencke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Kyrieleyson.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Kierlighed o Herre teg saare thwungit haffuer/",
      "part": false,
      "marginal_notes": [
        "Johan. v."
      ]
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "att thit blod ey offuer oss klaffuer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "oc betalid all wor skyld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "att oss Gud er worden huld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Kyrieleyson.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "Gud ÿ alle gaffuer oss wil welsigne/",
      "part": false,
      "marginal_notes": [
        "Hebre. xij."
      ]
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "att wÿ paa hans wæy skulle bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "ÿ rett kierlighed oc broderlig tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "att then mad kommer oss ey til wro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Kyrieleyson.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "Herre med thÿn aand oss aldrig forlad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "men teg altÿd paakalle ÿ allen stad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "Att thÿn arme Christenhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "maa leffue/ ÿ fred oc samdrectighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": "Kyrieleyson.",
      "part": false,
      "marginal_notes": []
    }
  ]
}