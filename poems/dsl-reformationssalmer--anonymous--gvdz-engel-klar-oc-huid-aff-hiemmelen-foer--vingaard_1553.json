  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "GVdz Engel klar oc huid/ aff Hiemmelen foer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oplod Graffuen oc forferde vocten met Jordskelff stort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Orlige om Morgenen der Sol gick op/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Ginge Quinderne til Graffuen at smøre Jesu døde Krop",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "⁕ Engelen i graffuen trøstede dem alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "han bad dem ey frycte/ men glade vere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Thi Jesus aff Nazaret vor opstanden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Den de søgte i Dødzens baande",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "det siger hans Discipler foruist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "i Galileya de see den Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "Maria græd oc i graffuen saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "stæden der Jesu Legeme laa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Bag sig hun saa en leffuendis Mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Haffuer du icke sagde hun tagit hannem/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "Jesus det vor/ thi lagde han",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "sig Maria mine huer Mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "ath ieg vil til Hiemmels fare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "til min Gud oc eders Herre Gud oc Fader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Mine Brødre skulle i vere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "och min Faders Børn kære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Quinderne til graffuen komme igen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "der motte de atter see Engle siun/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 6,
      "text": "Saa vist ville Gud oss det vere kend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 6,
      "text": "ath Christus for oss hid vdsend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Leffuer nu vden all ende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 7,
      "text": "Englen sagde/ at frøcte ey saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 7,
      "text": "di ieg lader eder nu god tiende forstaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 7,
      "text": "⁕ Christus Kaarsfest den i søge hoss de døde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "er nu opstanden fra alt møde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Kommer oc seer stæden der han i laa/ graffuen er tom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "han leffuer i krafft som en Kong from/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 8,
      "text": "Repeticio",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 9,
      "text": "Saa vist ville Gud oss det vere kend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 9,
      "text": "at Christus for oss vdsend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 9,
      "text": "leffuer nu vden all ende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 10,
      "text": "Jesus kom oc sagde det samme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 10,
      "text": "helsel gode Quinder/ verer ey saa bange/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 10,
      "text": "Tror en leffuendis Mand/ Det see och føle i vel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 10,
      "text": "ieg haffuer paa mig baade krop oc Siæl/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 10,
      "text": "Thi siger mine Brødre/ ath de sig ey møye",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "Jeg vil dem i Gallileya møde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 11,
      "text": "Repeticio",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 12,
      "text": "at Christus for oss vdsend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 12,
      "text": "leffuer nu vden all ende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 12,
      "text": "at Christus for oss vdsend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 12,
      "text": "leffuer nu vden all ende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 13,
      "text": "⁕ Cleophas gick til Emaus heden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 13,
      "text": "aff metynck han om Jesu talde met sin ven/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 13,
      "text": "Jesu holt sig til dem oc lærde dem scrifften/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 13,
      "text": "Saa at de motte Sagen ret forstaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 13,
      "text": "Met Tegn oc hiertens brynde lod han sig kende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 13,
      "text": "At de vel fornumme/ huort de vaare vende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 14,
      "text": "⁕ Saa vist vilde Gud oss det vere kend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 14,
      "text": "at Christus for oss vdsend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 14,
      "text": "leffuer nu wden all ende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 15,
      "text": "Som Cleophas met Apostlerne talde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 15,
      "text": "Da gick Jesus ind til dem oc sagde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 15,
      "text": "Fred met eder/ Fred vere met eder/ alle sammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 15,
      "text": "met glæde oc frygd euindelige Amen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 15,
      "text": "Han Oed met dem/ han lod dem see oc træffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 15,
      "text": "at mand ey mere skulde paa tuiffle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 16,
      "text": "Saa vist vilde Gud oss det vere kend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 16,
      "text": "at Christus for oss hid vdsend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 16,
      "text": "leffuer nu wden all ende",
      "part": false,
      "marginal_notes": []
    }
  ]
}