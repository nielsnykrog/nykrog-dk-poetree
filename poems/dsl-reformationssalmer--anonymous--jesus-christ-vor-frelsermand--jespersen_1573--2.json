  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "JEsus Christ vor Frelsermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "den som Døden offueruand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "hand er opstanden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Synden haffuer hand fangen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Kyrieleison/ O Herre miskunde oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Den vden all Synd fødder vaar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Guds vrede hand for oss bar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Oc flyde oss venskab/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "At Gud vil oss nu kier haffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Kyrieleison/ O Herre miskunde oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Død Synd Liff oc all naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Monne hand allene offuer raade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Hand vil redde alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Som hannem trolig paakalde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Kyrieleison/ O Herre miskunde oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "REsurrexi et adhuc tecum sum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "Posuisti super me manum tuam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Mirabilis facta est scientia tua,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "Haleluia,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "Domine probasti me, et cognouisti me:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "tu cognouisti sessionem meam et resurrectionem meam.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Gloria Patri et Filio et Spiritui sancto:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 4,
      "text": "Sicut erat in principio et nunc et semper, et in secula seculorum, Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": ".",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": ".",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": ".",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": "GLoria in excelsis Deo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "Et in terra pax hominibus bonæ voluntatis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "Laudamus te.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "Benedicimus te.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": "Adoramus te.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 6,
      "text": "Glorificamus te.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 6,
      "text": "Gratias agimus tibi, propter magnam gloriam tuam.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 6,
      "text": "Domine Deus, rex coelestis, Deus Pater omnipotens.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 6,
      "text": "Domine Fili vnigenite, Jesu Christe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 6,
      "text": "Domine Deus, agnus Dei, Filius Patris.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 6,
      "text": "Qui tollis peccata mundi, miserere nobis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 6,
      "text": "Qui tollis peccata mundi, suscipe deprecationem nostram.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 6,
      "text": "Qui sedes ad dexteram Patris, miserere nobis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "Quoniam tu solus sanctus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "Tu solus Dominus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "Tu solus altissimus, Jesu Christe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 6,
      "text": "Cum sancto spiritu, in gloria Dei Patris, Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 7,
      "text": "HAleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 7,
      "text": "Pascha nostrum immolatus est Christus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 7,
      "text": "Epulemur in azymis synceritatis et veritatis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 7,
      "text": "Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 8,
      "text": "VJctimæ paschali laudes immolant Christiani.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 9,
      "text": "Agnus redemit oues, Christus innocens Patri reconciliauit peccatores.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 9,
      "text": "Mors et vita duello conflixere mirando, dux vitæ mortuus regnat viuus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 10,
      "text": "Dic nobis Maria quid vidisti in via?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 11,
      "text": "Sepulchrum Christi viuentis, et gloriam vidi resurgentis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 11,
      "text": "Angelicos testes, sudarium et vestes. Surrexit Christus spes nostra, præcedet suos in Galilæa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 12,
      "text": "Credendum est magis soli Mariæ veraci, quam Judæorum turbæ fallaci.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 12,
      "text": "Scimus Christum surrexisse à mortuis verè. Tu nobis victor rex miserere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 13,
      "text": "Tu nobis victor rex miserere, Haleluia. Credo latinus vt in die Natiuitatis Christj.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "CHrist stod op aff Døde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 14,
      "text": "oc frelste oss alle aff nøde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 14,
      "text": "Thi ville wi alle være glad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 14,
      "text": "oc loffue vor Herre i allen stad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 14,
      "text": "Kyrieleis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 15,
      "text": "O Christe Konning/ forbarme dig offuer oss/ Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "MAne prima sabbathi surgens Dei Filius, nostra spes et gloria.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "Victo rege sceleris, redijt ab inferis, cum summa victoria.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "Cuius resurrectio, omni plena gaudio, consolatur omnia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 16,
      "text": "Resurgentis itaque Maria Magdalena facta est prænuncia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 16,
      "text": "Ferens Christi fratribus, eius morte tristibus, expectata gaudia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 16,
      "text": "O beati oculi, quibus regem seculi, morte iam deposita, prima est intuita.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 16,
      "text": "Hæc est illa foemina, cuius cuncta crimina ad Christi vestigia eius lauit gratia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 16,
      "text": "Quæ dum plorat et mens orat, facto clamat, quod cor amat Jesum super omnia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 16,
      "text": "Non ignorat quem adorat, quid precetur, et deletur quod mens timet conscia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 16,
      "text": "O Jesu saluator pie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 16,
      "text": "vita nostra verè factus es, per tuam sanctam mortem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 16,
      "text": "Patri tuo coæqualis, dum fuisti nunc mortalis, morte mortem superasti.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 16,
      "text": "Tu es mundi saluator ille æternus, quem prædixerunt diuini vates. Cuius liuore sanata est ecclesia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 16,
      "text": "Tu es vera coeli porta, per te mundo lux est orta. Tu resurgendo, sublata tristitia, mundum reples lætitia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 16,
      "text": "O Domine Jesu benigne, audi vota laude plena, Deo Patri tuam ecclesiam clementer reconcilia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 16,
      "text": "Tu fons summæ bonitatis, qui nos lauas à peccatis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 16,
      "text": "fratres tuos tua iusticia semper amictos refoue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 16,
      "text": "Vt tecum permaneant in gloria.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 17,
      "text": "CHrist laa i Dødsens baande/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 17,
      "text": "for vore Synder giffuen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 17,
      "text": "Hand er igen opstanden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 17,
      "text": "bar oss det euige leffnet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 17,
      "text": "At wi skulle altid være glad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 17,
      "text": "hannem tacke oc prise i allen stad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 17,
      "text": "oc siunge Haleluia/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 17,
      "text": "Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 18,
      "text": "Døden kunde ingen tuinge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 18,
      "text": "Blant alle Menniskens Sønner/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 18,
      "text": "Det giorde alt vore synder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 18,
      "text": "Jngen wskyldig vaar at finde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 18,
      "text": "Der aff da kom den Død saa snart/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 18,
      "text": "Fick mact offuer oss met en fart/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 18,
      "text": "Holt oss i sit Rige fangne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 18,
      "text": "Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 19,
      "text": "Jesus Christus Gud Faders Søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 19,
      "text": "Vdi vort sted er kommen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 19,
      "text": "Ved hannem faa wi den euige løn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 19,
      "text": "Oc Døden er offueruunden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 19,
      "text": "All sin Ret oc all sin mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 19,
      "text": "Som wi vaare vnderlagt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 19,
      "text": "Borttog Christi Død allene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 19,
      "text": "Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 20,
      "text": "Der vaar en gantske vnderlig krig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 20,
      "text": "Der Døden oc Liffuit stridde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 20,
      "text": "Liffuit fick mact oc offuerhaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 20,
      "text": "Oc monne Døden affliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 20,
      "text": "Scrifften haffuer oss det kundgiort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 20,
      "text": "At Christi Død bedreff det mord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 20,
      "text": "En spot aff Døden er vorden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 20,
      "text": "Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 21,
      "text": "Her er det rette Paaskelam",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 21,
      "text": "Om huilckit Gud haffuer budit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 21,
      "text": "Det er det som paa Kaarssit kom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 21,
      "text": "For vor skyld stegt oc dødet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 21,
      "text": "Dets Blod stenckis paa vore Dørre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 21,
      "text": "Oc holder Døden vden faare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 21,
      "text": "Den Mordener kand oss ey røre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 21,
      "text": "Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 22,
      "text": "Saa holde wi det høye Fest",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 22,
      "text": "Met hiertens fryd oc glæde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 22,
      "text": "At Jesus Christus er oss nest/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 22,
      "text": "Sin Naadis skin oss beteede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 22,
      "text": "Hand er selff Retuishedsens liuss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 22,
      "text": "Som opliuser vor hiertis Huss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 22,
      "text": "Syndsens Nat hun er bortgangen. Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 23,
      "text": "Aff det sande Paaskelam",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 23,
      "text": "Æde wi och saa leffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 23,
      "text": "Den gamle Surdey/ Menniskens lærdom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 23,
      "text": "Guds ord skal hand nu vige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 23,
      "text": "Christus hand er den sande Mad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 23,
      "text": "Som bespiser den Christne stad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 23,
      "text": "Troen kand ey andet lide. Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 24,
      "text": "Hand frelste oss fra død oc synd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 24,
      "text": "Alt met sin bittre pine/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 24,
      "text": "Hand er bleffuen opstandelsen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 24,
      "text": "Retfærdighed monne hand giffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 24,
      "text": "Stat op aff søffne all Christenhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 24,
      "text": "Lad mørckens gierninger være dig leed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 24,
      "text": "Retfærdelig leff i Christo Jesu. Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 25,
      "text": "Pharaonis mact den grumme Mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 25,
      "text": "Er nu fordømt met alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 25,
      "text": "Ved Jesum Christ vor Frelser sand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 25,
      "text": "Oss aff Egypten hand kalde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 25,
      "text": "Her haffue wi den sande Mosen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 25,
      "text": "Som vdledde all Jsraels kiøn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 25,
      "text": "Fra Syndsens trældom til hiertens lise. Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 26,
      "text": "Loff priss oc ære være dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 26,
      "text": "Dauid/ O Christe vor Konning/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 26,
      "text": "Som stridde for oss mandelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 26,
      "text": "Goliath er offueruunden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 26,
      "text": "Som lagde vind paa met all sin vold",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 26,
      "text": "At fordærffue Jsraels skiold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 26,
      "text": "Dit Aandelig Jsraels folck sig glæder. Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 27,
      "text": "VErè dignum et iustum est,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 27,
      "text": "æquum et salutare:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 27,
      "text": "Te quidem Domine omni tempore,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 27,
      "text": "sed in hoc potissimum die,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 27,
      "text": "gloriosius prædicare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 27,
      "text": "cum pascha nostrum immolatus est Christus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 27,
      "text": "Jpse enim verus est agnus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 27,
      "text": "qui abstulit peccata mundi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 27,
      "text": "qui mortem nostram moriendo destruxit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 27,
      "text": "et vitam resurgendo reparauit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 27,
      "text": "Et ideo cum angelis et archangelis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 27,
      "text": "cum thronis et Dominationibus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 27,
      "text": "cumque omni militia coelestis exercitus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 27,
      "text": "hymnum gloriæ tuæ canimus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 27,
      "text": "sine fine dicentes.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 28,
      "text": "Erens Konning/ O Christe/ Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 29,
      "text": "O Fader vdi Himmelen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 29,
      "text": "ved din Søn hør vor bøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 29,
      "text": "hand er oss fød oc giffuen vist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 29,
      "text": "til all vor hielp oc trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 29,
      "text": "Vær oss mild/ O Fader/ Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 30,
      "text": "Huilcken som vaar død oc for oss giffuen. Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 31,
      "text": "O Christe Konning i euighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 31,
      "text": "wi bede dig vær oss blid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 31,
      "text": "du som Døden haffuer fordærffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 31,
      "text": "oss salighed forhuærffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 31,
      "text": "bønhør oss/ O Herre. Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 32,
      "text": "Hand er opstanden/opfaren/ som hand sagde/ Loffuer Herren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 33,
      "text": "Hellig Aand vor Bøn til dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 33,
      "text": "O Gud vor trøstermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 33,
      "text": "Samuittighedsens trøst/ hiertens lyst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 33,
      "text": "Affslet alle Christnis brøst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 33,
      "text": "Fred oc glæde giff oss. Loffuer Herren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 34,
      "text": "Bed Gud for oss/ Haleluia/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 34,
      "text": "Loffuer Herren. Haleluia. Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 35,
      "text": "Konningens Daatter aff euighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 35,
      "text": "Christi Brud glæder sig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 35,
      "text": "for den hun haffuer i Aanden vndfangen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 35,
      "text": "hand er som hand sagde opstanden.opfaren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 35,
      "text": "hun sig paa Gud forlader/ Haleluia.",
      "part": false,
      "marginal_notes": []
    }
  ]
}