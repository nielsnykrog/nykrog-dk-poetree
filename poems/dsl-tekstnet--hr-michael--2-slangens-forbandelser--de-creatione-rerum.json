{
  "id": null,
  "title": "2. Slangens forbandelser",
  "year_created": 1514,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Michael",
    "country": null,
    "wiki": "Q108476156"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "De Creatione Rerum",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1514,
    "url": "https://tekstnet.dk/books/hr-michael_de-creatione-rerum/002/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "for allæ mennisckæ scalt thu wighæ, 1.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "forbandhet scalt thu och wordhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Thu haffdhæ møghet ondt vti thinæ sindhæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "then tijd thu komst til thennæ qwindhæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Thit hoffuet scal bliffuæ sønderkryst, 2.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "thu scalt och krybæ paa thit bryst, 3.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "iordhen scalt thu forthæræ. 4.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Tig scal ey sckiwlæ klæder eller haar, 5.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "forsmaadt scalt thu och wæræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Tig scal och sla baadhæ lidhen och stoer, 6.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "och hadhæ tig allæ paa iordhen boer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "thet giffuer ieg tig tilkænnæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "at al thin macht scal fran tig gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "wachthæ tig fuldwæl for hænnæ!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Huar hwn tig finder, thu maath alt fly,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "huad hælder thu æsth paa marck eller by,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Huar hennes naffn næffnes med stadig troo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "ther maath thu huercken bidhæ eller boo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "thet warer til ewighæ tidhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "Som thu haffuer swighet then førsthæ qwindhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "hwn scal gøræ tig stoer wandhæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "och scal tig swichthæ manghæfold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "bethaghæ thin macht och alt thit wold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "thet spørs offuer allæ landhæ.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "»ieg bedher tig, Herræ, thu war mig god,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "giff mig ey thinæ vredhæ!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "Thet ieg haffuer giort, giordhæ ieg aff nød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "then tijd mig qwindhen æbled bød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "Herræ, huad thu wilt aff oss gøræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "wij staa hær baadhæ och willæ thet høræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "forsee oss med thet bæsthæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "Giff oss nw plicht for wor vtucht,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 0,
      "text": "wij bødhæ thet wij kwndhæ læsthæ.«",
      "part": false,
      "marginal_notes": []
    }
  ]
}
