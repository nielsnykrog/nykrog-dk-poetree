  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Ville-mand och hans venne møe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": ":: Strengen er aff guld. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "thi legte guld-taffuell i thieris bue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Saa lille legte hand for sin iomfru. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Thi legte taffuell med guld saa rød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "och ey da gred den venne møe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "\"Heller greder i for guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "heller i græder for gode kleder?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "\"Icke græder ieg for guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "och ey for gode kleder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "Ieg græder mere for bro hin blide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "som ieg skall offuer ride.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "Ieg græder mere for blide bro:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 5,
      "text": "ther drucknede mine systre tho.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "\"Icke tør i grede for bro hin blide:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "XII skulde for ether riide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "Tolff skulle for ether riide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 7,
      "text": "oc tolff ved huerennd siide.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "Der di kom paa bliide bro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 8,
      "text": "der skregnede iomfruens ganger skou.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "Ther skregnede iomfruens ganger søm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 9,
      "text": "oc iomfruen ud for striden strøm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "\"Wi fare oss till Tømmer-by",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 10,
      "text": "oc kiøbe oss harper udaff ny.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "Ville-mand tager harpen i haand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 11,
      "text": "hand ganger for vandet at stande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "Hand slog harpen aff haande:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 12,
      "text": "oc fisket aff thet vande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "Hand slo harpen offuer then by:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 13,
      "text": "oc fulen aff den høye skye.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "Hand slog harpen aff liste:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 14,
      "text": "oc løff aff linde-quiste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "Hand slog løff aff linde-træ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 15,
      "text": "oc hornen aff thet leffuinde fææ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "Hand slog barck aff bircke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 16,
      "text": "och knapen aff then kircke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "Hand slog harpen aff harm:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 17,
      "text": "oc nu aff iomfruens arm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 18,
      "text": "Hand slog harp under øø:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 18,
      "text": "\"Velle-mand, Velle-mand, tag din møø!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 19,
      "text": "Velle-mand, Velle-mand, tag din fester-møø!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 19,
      "text": "ieg acther ey for hinder at døø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 20,
      "text": "Vellemand, Vellemand, tag din viff!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 20,
      "text": "ieg achter ey for hinder at lade min liff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 21,
      "text": "Vellemand, Vellemand, tag din møø!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 21,
      "text": "oc lad mig ligge under vanden at døø!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 22,
      "text": "Thi vedste icke andet, end iomfruen vor død:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 22,
      "text": "da stod hun op bode huid oc rød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 23,
      "text": "Hun stod op som lilie oc roser,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 23,
      "text": ":: Strengen er aff guld. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 23,
      "text": "oc hindes II kiere søstrer hoss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 23,
      "text": ":: Saa lille lieger hand for sin iomfru. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}