{
  "id": null,
  "title": "Ditmarskens Erobring I",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Rentzells Håndskrift",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/RNZ69.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Aff Gud er skicket øffrighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "som huer er plictig lydighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "thi Gud vill thet saa haffue;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "men oprør oc gienstridighedt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "whørsom oc hornackethedt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "vill Gud selff altid plage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Thi bønder vdj Ditmerske land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "opbleste aff en anden aand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Gudz skick ville thi ey lyde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "thet angrer bode quinde oc mannd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "som kommen er till ret forstand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "saa saare the thet fortrÿde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Compelle intrare er saa god,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "med macth at staa thet horde emod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "naar lempen ey maa gielde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "de førster aff en høyborne rogh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "thi røcte ther ind till hest oc fod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "oc trenge mact met velde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Om førster hagde hydet ath,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "the skulle bleffuit nederlagdt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "frÿt folck ville the thennom scriffuue;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "the puckede paa thieris egnne mact,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "oc øffrigheds act hagde de forlagt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "vnder otte oc firetiffuue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Høyborne første, konningh Christians søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 4,
      "text": "konning Frederich then anden, vng oc skøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 4,
      "text": "eth andet monne hannd tencke:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 4,
      "text": "hand ville haffuue løn eller bøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "eller the bønder skulle nappe aff røn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "hand acthe thennom at skiencke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 5,
      "text": "Met krud oc lod, som ther hørt till;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 5,
      "text": "thet vor och met i samme spill",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 5,
      "text": "tho førster oc brøder bode,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 5,
      "text": "for sandhed ieg thet sige vill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 5,
      "text": "the vor frimodigh nock ther till",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "at giffue sig till then vaade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 6,
      "text": "Hertug Hans oc hertug Adelph met",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 6,
      "text": "aff Lantheholsten komme the aff sted",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 6,
      "text": "stuor mact met alle rette;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 6,
      "text": "om the bønder slig herlighedt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 6,
      "text": "burde saa lingi at nyde met fredt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 6,
      "text": "ther om saa ville the trette.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 7,
      "text": "The thre førster the nnom ther tøcke lodh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 7,
      "text": "at the bønder hagde lycken godt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 7,
      "text": "fast mure end bønder pleie:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 7,
      "text": "om the saa kunde, thennom imod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 7,
      "text": "besydde foruden skat oc bodt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 7,
      "text": "thieris rette arff oc eye.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 8,
      "text": "Met korth berad beslutte the saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 8,
      "text": "vmsegelsse breff lod the vdgaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 8,
      "text": "the bønder at skicke till haande:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 8,
      "text": "om the vilde the haande gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 8,
      "text": "tha motte the vel nade faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 8,
      "text": "heller the ville mod thennom stande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 9,
      "text": "The bønder hagde tha icke beret",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 9,
      "text": "en ret got ord at giffue i verdt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 9,
      "text": "men the vore vforsagit:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 9,
      "text": "liffuet ville the verge met suerd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 9,
      "text": "the vore ther till vforferd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 9,
      "text": "thieris brød thet vor alt bagit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 10,
      "text": "The førster rycte till Alberstaarp by,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 10,
      "text": "tha lucthe the bønder brød aff ny,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 10,
      "text": "som thennom monne ilde smage;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 10,
      "text": "the bønder saa saa høyt i skye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 10,
      "text": "the minte the ville icke flÿ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 10,
      "text": "the motte dogh gaa tilbage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 11,
      "text": "Den dannske oc holste addell god",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 11,
      "text": "the vor oc ved saa frÿt enn mod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 11,
      "text": "the monne slet inthet frÿcte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 11,
      "text": "thieris sind oc mod tilsammen stodt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 11,
      "text": "thi bønder at trede vnder fodt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 11,
      "text": "oc vinde en euig rycte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 12,
      "text": "Till Mellerup rycte the ther nest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 12,
      "text": "ther kom saa mangen fremmede giest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 12,
      "text": "at ther motte hielme bløde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 12,
      "text": "ther vurde sig huer som hand kunde best,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 12,
      "text": "bode till fod oc saa till hest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 12,
      "text": "ther bleff saa mange døde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 13,
      "text": "The bønder tabte ther by oc slagh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 13,
      "text": "oc thet vor paa then første dagh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 13,
      "text": "the ret tilsammen komme;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 13,
      "text": "ræt saa betenckte huer sin sagh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 13,
      "text": "hand tog icke thennom paa sin bagh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 13,
      "text": "men holt sig vdj rømme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 14,
      "text": "Thet hialp thig inthet this wære forthi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 14,
      "text": "dog mange acthet icke liffuen at frj",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 14,
      "text": "blant rytter oc blant kmecte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 14,
      "text": "thieris graffue komme the selff wdj,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 14,
      "text": "oc wore folck ginge thennom forbj,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 14,
      "text": "thet skulle the icke neckte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 15,
      "text": "Ther bønderne vare nederlagdt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 15,
      "text": "endog the hagde thet icke ackt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 15,
      "text": "oc førsternne hagde byden innde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 15,
      "text": "tha vor vor krigsfolck wforsagdt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 15,
      "text": "med frisker mod oc stadige ackt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 15,
      "text": "ath the ville landet vinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 16,
      "text": "Lidet ther epter, en stacket thiid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 16,
      "text": "tha rycte the op met gandske fliid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 16,
      "text": "thill Heidem monne the acte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 16,
      "text": "oc tha vor lycken thennom saa blid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 16,
      "text": "the komme en anden wey till strid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 16,
      "text": "oc fore enddog saa sacte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 17,
      "text": "Tha komme the offuer ath Thillebro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 17,
      "text": "then dagh wor mange glad oc fro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 17,
      "text": "the fand then vey met liste;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 17,
      "text": "men thet vor icke the bønders tro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 17,
      "text": "ath the som icke wdj landit boo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 17,
      "text": "the nogit aff then vey viste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 18,
      "text": "For Heiden begÿntis saa hard en liegh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 18,
      "text": "ath ther bleff mangen om kinderne bleg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 18,
      "text": "ther maatte saa mangen dane;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 18,
      "text": "saa mange bønder bleff raffnen stegt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 18,
      "text": "Erick Rud tha icke sin herre sueg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 18,
      "text": "met ere førde hand sin faune.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 19,
      "text": "The danske rytter giorde got skiell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 19,
      "text": "beuiste thennom then dagh ræt well,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 19,
      "text": "the felde huad the kunde møde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 19,
      "text": "saa mange bønder sloge the ihiell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 19,
      "text": "for thieris forelder met wskell",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 19,
      "text": "hagde slagit thieris slect till døde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 20,
      "text": "Vdj høyborne førstis konning Hanssis tid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 20,
      "text": "ther lycken vor thennom megit wblidh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 20,
      "text": "som stander i gammel mands tale:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 20,
      "text": "før halfftresindtiffue och IX aars thiid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 20,
      "text": "at hand i Ditmerske tabte then striid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 20,
      "text": "nu motte the legit betale.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 21,
      "text": "Oc nu bleff Heiden wunden oc brend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 21,
      "text": "saa megit rigdom bleff ther skiendh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 21,
      "text": "thet kand icke sigis till fulde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 21,
      "text": "then plage haffuer oc Gud thennom send,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 21,
      "text": "som vel skall wære paa thennom kiend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 21,
      "text": "ther nu ligger offuer mulde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 22,
      "text": "Brunsbyttell kom oc i then nød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 22,
      "text": "oc Lunden then bleff brend i glød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 22,
      "text": "the motte oc dantze till hoffue;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 22,
      "text": "then dantz vor surt och icke sød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 22,
      "text": "saa mange bunde bleff ther død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 22,
      "text": "som sorgelig gick at soffuue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 23,
      "text": "Thet huss the hagde opbyggit saa fast,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 23,
      "text": "motte theforbøde forbøde met en hast,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 23,
      "text": "som the monne kalle Hannem;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 23,
      "text": "ther blegit mange som en gast",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 23,
      "text": "oc fick ther bode skade oc last",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 23,
      "text": "oc motte end rymme met skamme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 24,
      "text": "Thet huss vor thieris største tillfluct,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 24,
      "text": "ther hagde the actthet thennom at brøge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 24,
      "text": "vort folck till breck oc skade;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 24,
      "text": "ith øye haffuer the dogh ey till brugt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 24,
      "text": "eller for it haar kunde giøre wtuckt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 24,
      "text": "met alt thet the oplade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 25,
      "text": "Nu ligger the bønder i marcken strødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 25,
      "text": "som gress ther slais oc er forødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 25,
      "text": "wdi store hobe tillige;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 25,
      "text": "saa trengis the till wfrid er fødh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 25,
      "text": "aff retten att vore ther till nød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 25,
      "text": "thieris øffrighed at viige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 26,
      "text": "Ther vor ingen thennom lagde i graff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 26,
      "text": "men the betalde then samme laff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 26,
      "text": "som the monne thennom skicke;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 26,
      "text": "met dansker oc holster paa den dagh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 26,
      "text": "ther laae vnder i thenne skaff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 26,
      "text": "saa gieldis gield till pricke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 27,
      "text": "The bønder i Vetzelbuur,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 27,
      "text": "som ther laa inde i skiul oc luur,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 27,
      "text": "ther the then thiende hørde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 27,
      "text": "at Heden vor brend oc badit vur",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 27,
      "text": "oc bønderne the wsle creatur",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 27,
      "text": "war omkommen oc forførde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 28,
      "text": "The vende thieris kaabe met en hast,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 28,
      "text": "the bad om naade och end fuldfast",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 28,
      "text": "the førster thill fodt fallde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 28,
      "text": "thennom bleff tilgiffuit thieris last,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 28,
      "text": "saa mange som ther wor wforkast",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 28,
      "text": "the thogis till nade alle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 29,
      "text": "For førsterne komme store oc smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 29,
      "text": "met huide staacke maatte the gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 29,
      "text": "the herer vor thennom milde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 29,
      "text": "the sorde the førster alle saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 29,
      "text": "hulskab oc mandskad met thennom saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 29,
      "text": "huort the thennom haffue ville.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 30,
      "text": "Vor Gud vere loffuit till euig tidt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 30,
      "text": "som vore første vore saa blidh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 30,
      "text": "oc lod thennom seir vinde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 30,
      "text": "till hannom sette wj alle vore lidh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 30,
      "text": "oc frøcte hannom met største flid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 30,
      "text": "oc dragis thenne seir till minde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 31,
      "text": "Oc tenncke paa, huad før er skeedh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 31,
      "text": "ther Gud vor thette rige vredt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 31,
      "text": "och oss sin straff till sennde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 31,
      "text": "oc lade synden wære oss leedht;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 31,
      "text": "men Gud haffuer oss sin nade thiedt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 31,
      "text": "oc vill thet onde borth vende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 32,
      "text": "Som oss kand skade till liff oc siæll;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 32,
      "text": "oc giør huer anden ret oc skiell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 32,
      "text": "vor øffrighed hør at lÿde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 32,
      "text": "saa skall thet gange oss alle wel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 32,
      "text": "oc Gud beuare liff oc siæll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 32,
      "text": "oc lader oss himmerig nyde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 33,
      "text": "Gud ske oc loff euindeligh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 33,
      "text": "oss haffuer begaffuit saa rigeligh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 33,
      "text": "som boo i Dammarcks rige:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 33,
      "text": "oc giffuit vor konningh førsteligh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 33,
      "text": "saa wnngh at driffue mandom sligh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 33,
      "text": "som icke er hørt thislige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 34,
      "text": "Gud lade hans nade leffue vell",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 34,
      "text": "oc holde huer ved logh och skiell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 34,
      "text": "i faders spaar at gange;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 34,
      "text": "Gud giffue hannom lycken till liff oc siæll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 34,
      "text": "at hannom maa lide lenge well",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 34,
      "text": "oc himmerig at fange.",
      "part": false,
      "marginal_notes": []
    }
  ]
}