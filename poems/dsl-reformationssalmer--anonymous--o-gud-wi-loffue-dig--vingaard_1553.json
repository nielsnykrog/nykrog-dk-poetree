  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Gud wi loffue dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Vi bekende dig en Herre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Dig en euig Fader/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "priser nu den gantske Verden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "Det samme gøre alle Engle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "Hiemlene oc alle veldige Engle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Den priiss siunge Cherubin oc Seraphin/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "Met waffladelige stemme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "Hellig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "Hellig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "Hellig est du Herre Gud Sabaot",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "Hiemlene oc Jorden ere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "opfylte/ met din Maiestetis ære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "Din erlige forsamling dine Apostlers tal/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "Dig loffue oc bekende for en Herre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "Lige saa gøre oc altid/ Dit hellige tal dine Propheters",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 8,
      "text": "Den gantske skare dine hellige Martirers/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "Dit hellige naffn loffue oc prise.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 9,
      "text": "Alle Gudfryctige oc vdualde/ loffue oc bekende dig i all Verden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "En wbegribelig Maiestetis Fader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 10,
      "text": "⁕ Din sande ærefulde enbaarne Søn Jesum Christum/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 10,
      "text": "Tro wi at vere lige met dig i Guddommen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 11,
      "text": "Der til den Helligaand/ Sandelig at vere alles vore Trøstermand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 12,
      "text": "O Herre Christe du est ærens Kong/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 12,
      "text": "Du est din Faders euige Søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 13,
      "text": "Jomfruens liff vor dig icke verstyggeligt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 13,
      "text": "til at anamme mandom/ oc forløse alle vdualde Menniske",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 14,
      "text": "Du haffuer offueruundet den bittre pine dødzens sting/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 14,
      "text": "oc oplat alle som Tro paa dig Hiemmerigis rige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 15,
      "text": "Der faare sider du nu paa Gudz høyre haand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 15,
      "text": "i euig Maiestetis ære met din Fader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 16,
      "text": "Oc wi Tro at du her effter vorder tilkommendis",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 16,
      "text": "en streng dommere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 17,
      "text": "Derfaare o Herre wi formane dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 17,
      "text": "hielp dine tro tienere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 17,
      "text": "som du forløste met dit dyrebare Blod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 18,
      "text": "Dine venner gør delactige i den euige ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 18,
      "text": "met dit hellige oc vduolde folck",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 19,
      "text": "⁕ O Herre frels dit Folck/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 19,
      "text": "oc velsigne dem som ere din Arff oc eyedom",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 20,
      "text": "Regere oc lær dem/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 20,
      "text": "oc ophøye dem til euindelig tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 21,
      "text": "Vi benedide dig Gud i euighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 21,
      "text": "och ære dig dag fra dag/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 21,
      "text": "Oc loffue dit naffn til euig tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 21,
      "text": "nu oc altid euindelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 22,
      "text": "O Herre verdis at beuare oss altid fra Synden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 22,
      "text": "oc i denne dag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 23,
      "text": "Forbarme din offuer oss Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 23,
      "text": "oc forbarme dig offuer oss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 24,
      "text": "O Herre din barmhiertighed bliffuer offuer oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 24,
      "text": "saa som wi oss paa dig forlade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 25,
      "text": "Til dig Herre staar alt vort haab/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 25,
      "text": "der fore lad oss icke bliffue til skendzel euindelige",
      "part": false,
      "marginal_notes": []
    }
  ]
}