  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "VY saade oc graade ÿ Babilon/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Nar wÿ tenchte paa Syon.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Wÿ hengde wor leeg høgt op ÿ qwist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Vd mett the floder som ther ere mest.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "The som oss hadde taget till fanger/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "Vilde haffue giort oss til sanger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "The eskede aff oss een glædelig wise/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "Som wÿ plede ath siunge ÿ lÿse.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "Wÿ sagde ath thet ey wære kand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "At siunge Guds sang ÿ fremmede land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 5,
      "text": "Syon wille wÿ aldrig forgætte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "Men elske henne for Babilons rette.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 6,
      "text": "O Gud tenck paa hÿn blodgirige hundt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "Som oss gerne forlade ÿ grundt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 7,
      "text": "Men thu forderffuelige Babilon/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "Som haffuer saa forstørret Syon.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 8,
      "text": "Tw faar wel thin rette løn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "Som oc skal kende paa thin børn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 9,
      "text": "Gudt Fader Søn och then Helliaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "ske priis oc ære ÿ alle stundt.",
      "part": false,
      "marginal_notes": []
    }
  ]
}