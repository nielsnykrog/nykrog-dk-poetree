  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Daatter Jerusalem huor skal ieg holde dig fore?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Huor vid maa ieg ligne dig?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "O Jomfru daatter Sion/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "huem skal ieg ligne dig ved/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "at ieg maa trøste dig?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Effterdi ath din forderffue er io større end Haffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "huo kan da hele dig",
      "part": false,
      "marginal_notes": []
    }
  ]
}