  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "NW bede wÿ then Helliaand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "om then Christelig tro oc rett forstand/",
      "part": false,
      "marginal_notes": [
        "Psal. cxviij"
      ]
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "att wÿ Gud elske kunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "oc hannwm kalle paa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "helst ÿ dødzens stunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "nar wÿ aff werden gaa/ Kyrio.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Tw werdige liwss giff oss thit skÿn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "lær oss Jesum Christ kende alleen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "att wÿ hooss hanwm bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "then tro frelsermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "ther for wor synd wilde lÿde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "ingen kan frelse wden han/ Kyrioleys.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "O søde aand skenck oss thÿn løst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "giff oss kierlighed wdi wort bryst/",
      "part": false,
      "marginal_notes": [
        "Acto. iiij."
      ]
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "att wÿ kunde hwermand elske",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "aff hiertens grunde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "hans lærdom ther oss frelste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "føllie ÿ alle stunde/ Kyrioleys.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "O høgeste trøster ÿ alle nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "hielp att wÿ icke frøcte skendzel eller død/",
      "part": false,
      "marginal_notes": [
        "Johan. xvj"
      ]
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "men fast ÿ troen bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "mod dieffuelsens falske list/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "lad ingen ting oss driffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "fraa wor frelser Jesu Christ/ Kyrioleys.",
      "part": false,
      "marginal_notes": []
    }
  ]
}