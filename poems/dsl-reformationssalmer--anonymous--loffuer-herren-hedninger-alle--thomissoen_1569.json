  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Loffuer Herren Hedninger alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Thi hand dem ey nectede sin naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Disligest alle Folck skal til hannem falde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Thi hand dem haffuer frelst aff alskens vaade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "hans godhed offuer oss rundelig forøgt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Thi hand oss met sin naade haffuer søgt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "hans trofasthed/ er oss beteed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Thi ske hannem loff euindelig.",
      "part": false,
      "marginal_notes": []
    }
  ]
}