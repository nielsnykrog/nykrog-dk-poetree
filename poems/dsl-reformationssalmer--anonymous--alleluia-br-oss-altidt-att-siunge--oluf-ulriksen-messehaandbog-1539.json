  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Alleluia bør oss altidt att siunge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Herren loffue oc prijse aff hiertens grunde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Thi hans miscundt haffuer vore synder alle vdslet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "al kierlighed oc got haffuer hand oss beted.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Alt det som liiff haffuer. det scal Gud loffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "for hans megne miscund oc store naade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "han haffuer oss giffuit venscaff. styrcke. liiff oc krafft.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "hand haffuer forderffuit synd. død oc all dieffuelens magt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Gud haffuer dem som tro paa hannem iet naade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "vil dennem hielpe oc trøste i al vaade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "himmerigis rige vil handt dennem alle giffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "det holder han vist. di hand kand icke liue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "O Gud Fader dig vere loff oc aere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "medt din søn Jesu Christo vor frelsere kiere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "desligest den helligaand aff oss alle sammen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "vy tacke dig nu oc euindelige Amen.",
      "part": false,
      "marginal_notes": []
    }
  ]
}