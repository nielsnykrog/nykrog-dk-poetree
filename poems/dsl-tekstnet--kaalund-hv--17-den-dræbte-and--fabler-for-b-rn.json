  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "I Skoven risled den klare Aa;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "en blodig Vildand bag Sivet laa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "af Jægerens Bøsse var den dræbt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "den havde sig hen til Reden slæbt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Nu stod omkring den de Ællinger smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "de kunde det sletikke ret forstaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "de krøb under Vingen, men den var slap -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "\"Vaagn op, søde Moder, rab, rab, rab, rab!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Saa aabned de alle Smaanæbene vidt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "\"Vi ere saa sultne, giv os lidt!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Men moderløs' vare de arme Smaa -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "O, har Du en Moder, da skjøn derpaa!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
