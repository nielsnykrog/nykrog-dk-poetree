  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "En Skraldemandshest over Torvet drog",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "det tunge Læs, og Kudsken slog.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Dens Øje var sløvt, og Hovedet hang;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "men pludselig højt dens Vrinsken klang;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "i Aaget spændt for den tunge Kærre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "den hilste med Vrinsken sin fordums Herre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Og Herren standsed, han kjendte igjen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "sin herlige Traver, sin trofaste Ven.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Han kjøbte den fri og ømt den plejed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "skjøndt mangen en vælig Ganger han ejed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Og spurgte man, hvilken der hued ham bedst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "da peged han paa sin gamle Hest.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
