  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "MEd glæde oc fred far ieg nw heen/",
      "part": false,
      "marginal_notes": [
        "Philip. ij."
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "alt effter Guds wilie/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "wil ieg nw skilies:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "effter the ord som Gud haffuer loffuit meg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "døden skall mÿn søffn worde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Thet giør alt Jesus Christ Guds søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "then tro frelsermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "then ieg haffuer seet med mÿne øgne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "ieg tror wist att han er wort lÿff oc all wor salighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "ÿ nød oc dødzens wonde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Then haffuer tw Herre nw satt fram/",
      "part": false,
      "marginal_notes": [
        "Roma. iij."
      ]
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "for alle folk med stor /",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "oc til hans rÿge alle land/ lader bede oc raade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "med thit dyre oc hellige ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "som synder oc nør fast klinger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Han er thet klare oc salige liwss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "for alle hedninge att liwse",
      "part": false,
      "marginal_notes": [
        "Johan. viij."
      ]
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "thennom som ere vwÿss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "oc Gud icke kende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Han er oc thit folks Jsrael/ prÿss/ ære/ frøgd oc glæde.",
      "part": false,
      "marginal_notes": []
    }
  ]
}