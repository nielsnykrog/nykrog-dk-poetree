      "id": 0,
      "stanza_id": 0,
      "text": "Thet skulæ hwer cristen man kommæ i hw",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "ath Dyæwelsens snaar the æræ 7:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Han wel for mannen nedhiæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Han strør therfaræ bothæ fiern oc ner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Wi thøræ allæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "paa Gud kallæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "thet han oss nadhen sennæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Wi æræ thet vondh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
