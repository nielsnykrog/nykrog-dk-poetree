  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "»Hos Holberg Elskov er Pedanteri,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Hans Elskende skal være Parodi«,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Blev sagt. Den Mening er forbi",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Ved »de Usynlige«. – Tænkning, Geni",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Her viser os, at Hjerte boer deri;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Dets Slag fornemmes, medens Spøgen fri",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Og let udfolder sig. Os gled forbi",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Ved Scenens skjønne, virkende Magi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Opfrisket, fuldt af Farve-Trylleri,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Saa ungt – et gammelt Holbergsk Maleri.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
