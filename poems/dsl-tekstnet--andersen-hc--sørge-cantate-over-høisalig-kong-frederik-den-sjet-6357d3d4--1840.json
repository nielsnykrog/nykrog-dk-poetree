{
  "id": null,
  "title": "Sørge-Cantate over Høisalig Kong Frederik den Sjette",
  "year_created": 1840,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1840,
    "url": "https://tekstnet.dk/books/andersen-hc_soerge-cantate-over-hoeisalig-kong-frederik-den-sjette/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Død er vor Konge! Død Kong Frederik!",
      "part": false,
      "marginal_notes": [
        "Speaker: CHOR"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Hans Kongevei tidt gjennem Tjørne gik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Han meente ærligt det med Folk og Rige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Død er vor Konge! Død Kong Frederik!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Og Hjertet føler, hvad de Ord vil sige!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Ved Sommerslottet suse Skovens Ege",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Om tunge Aar og ei om Barnets Lege,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Om Kongesønnen i de kolde Sale! –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Høit om hans Ynglings Daad skal Stenen tale;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Paa Bondens brudte Aag er Støtten sat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Mod Himlen peger den i Sorgens Nat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Høit ruller Bølgen mod den danske Slette,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Den synger om den Sortes Takke-Bøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Velsignet være Frederik den Sjette,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Ei sælges tør, o Afrika, din Søn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Naar Svalen kommer hid fra Keiserborgen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Fra Donaus Keiserborg, den qviddrer Sorgen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Den Sorg, dens Moder saae paa Kongens Pande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Da der han værnede om Hjemmets Lande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "Om Oldtids Tingsted Bondens Marker tale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "Om Bonden nu forkynde Raadets Sale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "Thi der udtaler jo sin bedste Skjønnen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "Ei Adelsbaaren kun, men Bondesønnen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "Kongen er død!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "Hør over Vangen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "Sørgesangen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "Som den ved Femte Fredriks Kiste lød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "»Hold Taare op at trille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "Og du min Cithar stille!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "Nu bæres Kongen bort",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "Til Graven!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "»Nu bæres Kongen bort til Graven!«<button id=note1 type=button class=\"btn btn-outline-secondary btn-sm comment\" data-container=body data-toggle=popover data-template=\"<div class='popover' role='tooltip'><div class='arrow'></div><h3 class='popover-header'></h3><div class='popover-body'></div></div>\" data-placement=auto data-html=true data-content=\" <p>Ewalds Sørgesang over Høisalig Kong Frederik V.</p> \" data-title=\" Fodnote 1\">F1</button>",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 0,
      "text": "Den danske Bonde bad: o, maae vi bære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 0,
      "text": "Vor Konge til hans sidste Hvilested!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 0,
      "text": "Den lange Vei er kort, og let vil være",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 0,
      "text": "Den Byrde, som har al vor Kjærlighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 0,
      "text": "Han Byrden bar for os, und os den Ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 0,
      "text": "Den lange Vei er kort, naar ham vi bære!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 0,
      "text": "Gud signe Bonden! her var Hjertet Tolk.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 0,
      "text": "Taknemlighed, betegn du Danmarks Folk!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 1,
      "text": "I hvert et Bondehuus, om nok saa lille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 1,
      "text": "Et Lys er tændt, langs Veien hvor de gaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 1,
      "text": "Og i den kolde Nat, ved Grøften stille",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 1,
      "text": "Med deres Børnebørn de Gamle staae:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 1,
      "text": "»Nu kommer Kongens Liig! see Faklen brænder!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 1,
      "text": "Og Barn og Gubbe folde deres Hænder;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 1,
      "text": "De glemme aldrig dette Øieblik.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 1,
      "text": "»I Jesu Navn! Farvel Kong Frederik!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 1,
      "text": "Lad Floret hænge ned om Sørgestaven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 1,
      "text": "Og Faklen lyse rød!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 1,
      "text": "For os hiin Sørgesang gjenlød!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 1,
      "text": "»Nu bæres Kongen bort til Graven!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 1,
      "text": "Hvad er mod Aandens Rige hist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 1,
      "text": "Den Pragt, os Jorden viste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 1,
      "text": "Den samler sig til allersidst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 1,
      "text": "Her i den snevre Kiste!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 1,
      "text": "I Kirkens gamle, hvælvede Gange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 1,
      "text": "Lød de dybe Sørgesange Over Kongens Baare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 1,
      "text": "Det var ei den sidste Taare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 1,
      "text": "Mangt et Øie der ham gav;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 1,
      "text": "Grædes vil der langt fra Kongens Grav.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 1,
      "text": "O, mangt et Træk, saa ærligt, ligefremt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 1,
      "text": "Tegn paa hans Hjerte, har vort Hjerte gjemt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 1,
      "text": "Det bliver aldrig glemt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 1,
      "text": "Det trætte Støv de Hvile gav;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 1,
      "text": "Der er saa tyst nu ved hans Grav.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 1,
      "text": "Kun Maanens Straale kysser Kongens Kiste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 1,
      "text": "Tag vort Farvel! det er det sidste!",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
