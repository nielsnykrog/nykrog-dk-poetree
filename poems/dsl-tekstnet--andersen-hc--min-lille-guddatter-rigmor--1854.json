  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1854,
    "url": "https://tekstnet.dk/books/andersen-hc_min-lille-guddatter-rigmor/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Du er som en Fugl og saa ellevild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Et dansk lille Barn med Italiens Ild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "To kornblaa Øine, og heel selv en Rose,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Saa kjæk og saa sød og – en Drillepose!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Af Mormoer og Farmoer klarlig man seer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Der speiler sig Noget i din Characteer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Hvor nysselig, kysselig, Du – Kjælegrisen!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Din Gudfader er det, som synger Dig Visen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Du er ham kun venlig en enkelt Gang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Og strax saa faaer Du derfor en Sang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Forkjælede, trollede, villiefulde, –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Og dog saa sød, at Du kysses skulde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Du er som en Blomst, Du er som en Fugl,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Du er som et Barn i den glade Juul,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Ja Du kan være den sødeste Pige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Og det er Du altid, – vil Morfaer sige!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
