  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Skaden flagred i Gaarden ind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Ej se, hvilket dejligt Aaleskind!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Grisen giver sig til at rende -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "de snapped af Skindet hver en Ende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Tyv, grynted Grisen, lad Skindet ligge!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Saa stode de der nogle Øjeblikke. -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Grisen rusked, og Skaden haled,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "mens alle Kyllingerne lystigt galed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Det gik paa langs, det gik i Ring,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Skaden den gjorde de vældigste Spring;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "saa bleve de ved at slide og rykke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "til hver af Skindet beholdt sit Stykke.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
