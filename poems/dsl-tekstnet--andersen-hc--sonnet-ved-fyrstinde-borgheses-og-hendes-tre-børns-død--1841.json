  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "En Paradisets Blomst, af Troen bragt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Til Themsens Bred og plantet der i Solen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Skjød herligt frem, dens Duft, dens Yndes Magt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Dens Glands, – sligt findes ei hos Vaarviolen!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Men Kjærligheden planted Blomsten om,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Den Blomst, som gjorde alle Hjerter glade;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Den satte den ved Tiberen i Rom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "En himmelsk Duft gik fra dens rene Blade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Og Duften steg; vi hørte Engle sige:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "»Den Blomst er ei for noget jordisk Sted,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "I Lysets Have blomstrer kun dens Lige!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "En Engel saae vi da til Jorden stige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Og rive Blomsten op; tre Skud gik med,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Tre unge Skud – de groe nu i Guds Rige!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "Rom, den 1ste Januar 1841.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
