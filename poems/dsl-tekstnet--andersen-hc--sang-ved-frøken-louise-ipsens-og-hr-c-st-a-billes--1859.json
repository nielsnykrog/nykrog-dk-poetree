{
  "id": null,
  "title": "Sang ved Frøken Louise Ipsen’s og Hr. C. St. A. Bille’s Bryllup, den 8. Juni 1859",
  "year_created": 1859,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
