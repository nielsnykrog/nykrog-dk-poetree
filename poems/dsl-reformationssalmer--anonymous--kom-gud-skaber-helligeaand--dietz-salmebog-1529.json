  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "KOm Gud skaber helligeaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "besøg wort hierte med thÿn miskund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "med thÿn naade forny wor sind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "att wÿ kunde kende skabning thÿn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Tw som kallis wor trøstermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "then høgeste nogen tÿd wære kand/",
      "part": false,
      "marginal_notes": [
        "Johan. xvj. j. Johan. ij."
      ]
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "een aandelig salwe/ salwe oss med/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "att wÿ med thÿne gaffuer bliffue besett.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Optend ÿ oss thÿn Guddoms ild/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "oc ødeleg wor eghen wild/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "giff oss ett hierte reent oc pwrt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "oc styrcke ÿ oss thet tw haffuer giort.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Tw æst siwfold ÿ gaffuer skøne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "tw æst Guds finger paa then rette hand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Guds faders ord giffuer tw wel fart/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "offuer alle land at predickis snart.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Drÿff fraa oss nw dieuelsens list/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "lær oss att kende rett Jesum Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "oc tage korssit aff hans milde hand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "hwilkid han atskillig giffuer alle mand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Lær oss faderen att kende wel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "som oss forsørger bode lÿff oc siæl/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "sÿn søn for oss ÿ døden gaff/",
      "part": false,
      "marginal_notes": [
        "Johan. iij."
      ]
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "att wÿ skulde icke faa ewig straff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Gud fader wære loff oc hans kiære søn",
      "part": false,
      "marginal_notes": [
        "Gala. j."
      ]
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "som oss forhwerffde then ewig løn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "ther til wor trøster then Helliaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "loff prÿss oc ære ÿ alle land.",
      "part": false,
      "marginal_notes": []
    }
  ]
}