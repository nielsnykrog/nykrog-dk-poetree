  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "IEsus Christ wor frelsermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "then ther døden offuerwand/",
      "part": false,
      "marginal_notes": [
        "Ephe. iiij."
      ]
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "han er opstanden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "synden haffuer han fangen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Kyrieleyson o Herre miskund oss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Then vden all synd fødder war/",
      "part": false,
      "marginal_notes": [
        "Hebre. iiij. Roman. v."
      ]
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Guds wrede han for oss bar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "flÿde oss wenskab/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "att Gud wil oss nw kiære haffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Kyrieleyson o Herre miskund oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Død/ synd/ lÿff/ oc all naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "monne han allene offuer raade/",
      "part": false,
      "marginal_notes": [
        "Mat xxviij"
      ]
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "han wil redde alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "ther hannwm trolig paakalde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Kyrieleyson o Herre miskunde oss.",
      "part": false,
      "marginal_notes": []
    }
  ]
}