  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "GVd ære dit naffn oc icke vort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "som loffuer miskund och holder dine Ord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Lad wchristne ey faa den frøyd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "at de mue sige/ huor er deris Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "Ja vor Gud er i Hiemmelen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "huad han vil det bliffuer giort oc endet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Men deris Guder ere Sølff oc guld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "som mand gør met hender oc Skaal",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "De haffue øren oc icke høre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "oc Næse som mand vil dem gøre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 5,
      "text": "De kunde ey røre haand eller fod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "ey bede hielp om de i Jlden stod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 6,
      "text": "Saadanne skulle de och bliffue som dem gøre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "oc de som der til lide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 7,
      "text": "Men lader oss sette vort haab til Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "saa vil han vere vor skiold oc spiud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 8,
      "text": "Som gamle fedre haffde haab til Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "saa vaar han deris skiold oc Spiud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 9,
      "text": "Ehuo som frycter oc haaber til Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "den vil Gud vere baade skiold oc Spiud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 10,
      "text": "Ere vere Gud Fader oc Gudz Søn ocsaa Gud den Helligaand",
      "part": false,
      "marginal_notes": []
    }
  ]
}