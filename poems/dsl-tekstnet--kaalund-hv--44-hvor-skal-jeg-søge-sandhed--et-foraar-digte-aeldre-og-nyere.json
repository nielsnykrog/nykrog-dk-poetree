{
  "id": null,
  "title": "44. Hvor skal jeg søge Sandhed?",
  "year_created": 1858,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Vilhelm Kaalund",
    "country": null,
