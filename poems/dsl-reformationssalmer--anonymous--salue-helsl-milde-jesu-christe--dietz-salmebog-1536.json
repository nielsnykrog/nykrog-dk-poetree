  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "SAlue helsæl milde Jesu Christe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Alle naade oc miskundhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "euige Konning/ wort hierte/ liiff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "wor kiære søde oc sande trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Helse wÿ teg som er thin ydmyge Dronning.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Til teg O Guds søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "wor meglere skøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "opløffte wÿ wor bøn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Wÿ arme vdlende Adams børn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Til teg allene wille wÿ sucke oc wene /",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "klage saare mett grædende thaare /",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "J thenne grædende dall/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "fuld mett alle qwall/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Til wÿ indkomme gennom dørren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Eya tw wor fortaler/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "til Gud wor Fader oc æst wor hugswalere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "Frÿ oss fra alle menniskers løgner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Oc thin miskundheds hellige øgen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "huilke oss oplede/ wochte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "oc euige glæder thw hid til oss wende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "O Jesu Christe Jomffru Marie welsignede lifsens frucht /",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "mett all ære oc tucht.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Fly att wor kiære Fader oss raader/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "ÿ thenne her ælende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Oc thet wÿ kunde kende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "o barmhiertige Gud wor Fader/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "O meget gode Jesu wor broder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "O søde trøster Helliaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "Benaade oss alle AMEN.",
      "part": false,
      "marginal_notes": []
    }
  ]
}