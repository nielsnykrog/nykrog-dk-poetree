  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Vid Jesum christum vor herre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Huilken som effter sin opstandelse aff døde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "skinbarligen betede sig for alle sine discipler.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Oc i deris asyn er opfaren tiil himelen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Paa det han skulle giøre oss delactige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "aff sin guddommelighed oc ere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Oc derfore",
      "part": false,
      "marginal_notes": []
    }
  ]
}