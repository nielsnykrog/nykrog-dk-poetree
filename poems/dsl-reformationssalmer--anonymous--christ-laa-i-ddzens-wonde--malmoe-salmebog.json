    "title": "[tabt]",
    "year_published": 1533,
    "publisher": "Christiern Pedersen",
    "printer": "Joh. Hoochstraten",
    "place": "Malmø",
    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/malmoe-salmebog/1/42"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "CHrist laa i dødzens wonde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "for wore synder giffuen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "han er igen opstanden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "bar oss det euig liff/",
      "part": false,
      "marginal_notes": [
        "Esa. liii Rom. iiii"
      ]
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "der fore skulle wi være glad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "hannem tacke oc prise i alle stad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "oc siunge Alleluia",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Døden kunde ingen tuinge",
      "part": false,
      "marginal_notes": [
        "Roma. v"
      ]
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "bland mennisken alle paa iorden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "det giorde wor store synder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "i dem wi fødde wore/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "der fore kom døden saa snart/",
      "part": false,
      "marginal_notes": [
        "Psal. li"
      ]
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "oc greb oss alle met en fart/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "hans fanger motte wi være",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Jesus Christus Gudz eniste Søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "han er i vor sted kommen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "och haffuer synden affslet huer en/",
      "part": false,
      "marginal_notes": [
        "Phil. ii Joan. i ii Tim i Phil. i Rom. v"
      ]
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "der met haffuer han bort tagit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "fra døden bode velde oc mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "oc all hans grumhed nederlagt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "han kan nu oss intit skade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Det wor en vnderlig strid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "da døden oc liffuit stridde/",
      "part": false,
      "marginal_notes": [
        "Ose xiii|i Co xv"
      ]
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "oc liffuit offuerhand fick/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "oc monne døden affliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Der hagde scrifften omtalit før/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "ath en død den anden sløg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "han haffuer sin seyer nu tabit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Her er det rette paaske lam/",
      "part": false,
      "marginal_notes": [
        "Exo xii i Joan i"
      ]
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "der om Gud hagde screffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "det bleff paa korssit for huer mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "brent i største kerlighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "hans blod renser oss aff all vor synd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "at døden kan oss inted tuinge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "Christus haffuer hannem offueruundit",
      "part": false,
      "marginal_notes": [
        "Coll ii"
      ]
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Saa holde wi den store høytid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "met hiertens frøyd oc glede/",
      "part": false,
      "marginal_notes": [
        "Joan i oc viii Rom xiii"
      ]
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "ath Gud er oss nu mild oc blid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "oc haffuer oss løst aff møde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "han er selff det euige liuss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "han kan vort hierte ret vnderuise/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "wi skulle fly syndsens mørckhed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "Gudz ord skulle wi effter følge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "det er vore sielis søde brød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "menniskens lerdom ey skøde/",
      "part": false,
      "marginal_notes": [
        "Mat iiii oc xv"
      ]
    },
    {
      "id": 45,
      "stanza_id": 6,
      "text": "han er oss ont och icke god/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 6,
      "text": "Christus vil vore sielis mad være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 6,
      "text": "hans ord all ene skulle wi beuare/",
      "part": false,
      "marginal_notes": [
        "Joan x i Pet ii"
      ]
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "ret tro kan andet ey lide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 7,
      "text": "Han haffuer oss frelst fra synd oc død alt met sin bitter pine/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 7,
      "text": "thi skulle wi synde offuergiffue/",
      "part": false,
      "marginal_notes": [
        "Eph iiii Ti ii Rom xii"
      ]
    },
    {
      "id": 51,
      "stanza_id": 7,
      "text": "staa op oc bliffue nu rene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 7,
      "text": "oc leffue alle retuiselig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 7,
      "text": "oc elske huer anden vden suig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 7,
      "text": "det vnde oss Christus",
      "part": false,
      "marginal_notes": []
    }
  ]
}