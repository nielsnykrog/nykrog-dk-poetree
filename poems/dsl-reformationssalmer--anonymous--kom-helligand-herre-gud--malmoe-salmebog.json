  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "KOm Helligand herre Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "opfyll met din naade oc miskund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "dine Christnes hierte hw och sind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "din brendendis kerlighed i dem optend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "O Herre met din naadis liwss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "der met bepryd vort hiertis hwss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "hent dem tilsammen i verden bo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "aff alle tungemaall till en tro",
      "part": false,
      "marginal_notes": [
        "Actu. ii"
      ]
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Alleluia Alleluia",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Dw hellige liwss oc visdoms port/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "lad oss opliwsis met liffsens ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "oc ler oss Gud ret alle ath kende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "aff hiertens grund hannem fader ath kalde/",
      "part": false,
      "marginal_notes": [
        "Mat. vi. Rom viii"
      ]
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "O herre beskerm oss fra fremmede lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "ath wi ingen mestere atspørge mere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "en Jesum Christum vor frelsere kære/",
      "part": false,
      "marginal_notes": [
        "Luce i"
      ]
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "ath wor tro kunde til hannem all ene være",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Alleluia loffuer Herren",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Du hellige ild oc søde trøst/",
      "part": false,
      "marginal_notes": [
        "Joannis xiiii oc xvi"
      ]
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "hielp oss nu i all wor brøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "din vilge altid effter ath følge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "oc lad ingen modgang oss fra skillye/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "O herre met din guddoms krafft styrcke oss vsle oc giff oss mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "gennem sorg oc bedrøffuelse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "ath komme til dig vor frelsere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Loffuer Herren Alleluia",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "O sandhedz kilde oc hiertens frøyd",
      "part": false,
      "marginal_notes": [
        "Joan. xvii"
      ]
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "met aandelig smøcke vore hierte bepryd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "at wi met haab oc en Christelig tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "met Gud oc vor neste i kerlighed bo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "O hiertens Herre oc aandelige liff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "bestrid i oss all syndzens kiff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "Skenck oss din gunst/ och stat oss bi/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "ath wi ey falle i den aandelige kri/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "Alleluia loffuer herren",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "O Gud all ene vor hiertens trøst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "aff tho i oss all syndzens brøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "Din ild dit wand/ dit sandhedz liwss/",
      "part": false,
      "marginal_notes": [
        "i Pet. i"
      ]
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "lad brende och tho wort aandelig hwss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "O Herre Gud i ewigheid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "wi tacke din barmhertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "beuar i oss det du haffuer giort",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "met aandelig krafft oc hellige ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "loffuer Herren Alleluia",
      "part": false,
      "marginal_notes": []
    }
  ]
}