  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Rumlepotten rendte omkring,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Børnene gjorde de lystigste Spring.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Børn! saa raabte den, værer dog stille;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "skaber Jer ikke saa kaade og vilde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "hvortil skal dog de Skraal og Skrig?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Se, I staar nu i Vejen mig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Bums! der foer den mod Fødderne En,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "stødte sig saa paa et Stoleben,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "rendte fra Døren hen mod Skabet -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "lystig de Smaa den efterabed;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "alt hvad den brummede, Børnene maatte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "elske den gamle Knurrepotte.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
