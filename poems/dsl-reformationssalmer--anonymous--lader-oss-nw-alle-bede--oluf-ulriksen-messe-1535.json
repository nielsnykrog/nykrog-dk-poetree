  "source": {
    "id": null,
    "title": "Een handbog som inde holler det hellige Euangeliske Messe embede",
    "year_published": 1535,
    "publisher": "Oluf Ulriksen",
    "printer": "Oluf Ulriksen",
    "place": "Malmø",
    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
