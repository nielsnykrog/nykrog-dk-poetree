  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Troens Rare Klenodie",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1739,
    "url": "https://tekstnet.dk/books/brorson-ha_troens-rare-klenodie/241/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Op! op! I folk paa jordens kreds,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "O vaager op dog allesteds,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Herud af syndens slumme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Hvi sove I, hvor er det fat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Da verdens endes mørke nat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Og dommens dag vil komme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Smyk dig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Hastig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Tiden endes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Verden brændes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Himlen ruser,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Dommedagens skye alt suser.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Op, søvnig christenhed, paa vagt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Thi dommeren med tordens magt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Om midnats tiid vil møde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Vel den! som sig bereder her,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Og ret har haft sin JEsum kier,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Den skal hand ey forstøde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Hvo ey",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Den vey",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Følge vilde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "Og for silde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "Det vil kiende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "Hand maa evig, evig brænde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Ach, ach! hvor vil I der bestaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Som frekke her i synden gaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Og HErrens ret forvende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Naar I skal frem af eders grav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Og legge regenskabet af,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "Hvad vil det faae for ende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "Langt ud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "Fra Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "Skal I stødes",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 2,
      "text": "Bort, og nødes",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 2,
      "text": "Ind at ligge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 2,
      "text": "Hos den rige mand at tigge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "Strax lukkes himlens døre til,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "Hvor meget man end banke vil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "Man bør dog staae der ude,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "Da skal I hen med satan gaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 3,
      "text": "Hos de fordømte ligge saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 3,
      "text": "I evig baand og knude,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 3,
      "text": "Hvor der",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 3,
      "text": "Da er",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 3,
      "text": "Graad og jammer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 3,
      "text": "I de flammer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 3,
      "text": "Af den hede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 3,
      "text": "Evig brændende Guds vrede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 4,
      "text": "For Guds i himlen skyld da seer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 4,
      "text": "Dog til, at I ey sove meer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 4,
      "text": "I verdens synde-glæde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 4,
      "text": "Naar hendes korte lyst forgaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 4,
      "text": "I da med JEsu sande faar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 4,
      "text": "Frimodig frem kand træde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 4,
      "text": "Naar Guds",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 4,
      "text": "Doms buds",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 4,
      "text": "Torden kommer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 4,
      "text": "Verdens sommer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 4,
      "text": "Ende tager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 4,
      "text": "I da ind i himlen drager.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 5,
      "text": "Hvor det livsaligste Guds lam",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 5,
      "text": "Er deres skiul, som elskte ham,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 5,
      "text": "Som grundig sig omvendte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 5,
      "text": "Som stode fast i troens striid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 5,
      "text": "Og deres ædle naadens tiid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 5,
      "text": "Til salighed anvendte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 5,
      "text": "Det tal",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 5,
      "text": "Det skal",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 5,
      "text": "Da bestige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 5,
      "text": "Magt og rige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 5,
      "text": "I det høye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 5,
      "text": "Evig sig i Gud fornøye.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 6,
      "text": "Ach, søde JEsu, kom dog brat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 6,
      "text": "Kast verden over ende, at",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 6,
      "text": "Vi snart dig see og tale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 6,
      "text": "Hielp, JEsu, at vi vist maae naae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 6,
      "text": "Den herlighed, med dig at gaae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 6,
      "text": "I himlens fryde-sale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 6,
      "text": "Hvor sig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 6,
      "text": "Liflig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 6,
      "text": "Høre lade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 6,
      "text": "Alle glade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 6,
      "text": "Himmelgiester,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 6,
      "text": "Guds propheter, konger, præster.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 7,
      "text": "Hent os fra denne græde-dal",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 7,
      "text": "Til dines flok i frydens sal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 7,
      "text": "Hvor engle-cither røres,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 7,
      "text": "Hvor der er evig harpe-klang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 7,
      "text": "Hvor glæden har sin fulde gang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 7,
      "text": "Hvor tre gang hellig høres,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 7,
      "text": "Det verk",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 7,
      "text": "Saa stærk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 7,
      "text": "Saa eendrægtig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 7,
      "text": "Og saa mægtig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 7,
      "text": "Alle drive,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 7,
      "text": "Naar de Gud al ære give.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 8,
      "text": "Naar Frelseren saa mild vil gaae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 8,
      "text": "Og sette livets krone paa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 8,
      "text": "De hvide-klædte skarer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 8,
      "text": "Naar de gaae ind med ham i fryd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 8,
      "text": "Med himmelske basuners lyd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 8,
      "text": "Naar Gud sig aabenbarer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 8,
      "text": "Naar man",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 8,
      "text": "Da kand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 8,
      "text": "Jubilere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 8,
      "text": "Triumphere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 8,
      "text": "Uden ende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 8,
      "text": "Da maa verden evig brænde.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
