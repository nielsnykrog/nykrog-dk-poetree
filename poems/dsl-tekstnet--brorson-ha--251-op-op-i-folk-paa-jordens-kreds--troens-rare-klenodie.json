{
  "id": null,
  "title": "251. Op! op! I folk paa jordens kreds",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
