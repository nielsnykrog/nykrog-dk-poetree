{
  "id": null,
  "title": "Fæstemand og Fæstemø i Skibbrud",
  "year_created": [
    1575,
    1590
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
