  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA167.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Her Karll rydder saa wydde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": ":: Menn linndenn grorr. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "till sytt brølup att bydde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Thy blomster dy er faldenn, som der waar paa. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Hannd bød faader och muoder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "hans søster och hans broder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Hand bød och tiell hans sleffred-wyff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "hand holder hind kieerer ind synn lyff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "Hans sleffred spuorde hun herre synn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "\"Maa ieg nu gaa att skenke wynn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "\"Alltt om du weelltt adtt skienncke gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "daa tag icke alt ditt rødde guld paa!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "\"Huy formieener y meg mytt guld saa rød?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 5,
      "text": "thett gaff meg myn faadder, ther ieg war mø.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "Hun gick heenn och drog y mantteell blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "thett rødde guld y sømenn luo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "Hun drog gwllditt offuer gulditt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 7,
      "text": "alle hyndis fynger denom satte hun fuld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "Hun tuog thuo sølleff-kaar paa synn haand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 8,
      "text": "saa gaar hun ind for brudenn att staande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "Saa skenckitt hun wynn aff harum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 9,
      "text": "hun spylltte paa brudens ermme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "Tthett meelltt brudenn paa benncke:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 10,
      "text": "\"Huem er denn frue, der skencker?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "Tthett suaridtt her Kaall hans muoder saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 11,
      "text": "\"Thett er mynn sønn hans sleffred-mordtt\".",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "\"I-men hand haffde sligenn sleffred-wyff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 12,
      "text": "huy loffuett hand meg daa tiell vnge brud?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "Thry gang haffuer mytt brølup weritt giortt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 13,
      "text": "men alltid er ieg bleffuen møø hieem-førtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "Tthett første thett woldtte meg styff-muoder strid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 14,
      "text": "myn skieebenn er worddenn meg møggitt vblidtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "Tthett anditt thett woldtte meg suerd och knyffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 15,
      "text": "men thette haffuer woldt meg sleffredtt-wyff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "I spendder nu heestenn for karme braatt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 16,
      "text": "ieg well hiem till min faadder y naatt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "\"Karmen er icke reedde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 17,
      "text": "och heestenn er vde paa hieedde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 18,
      "text": "\"I-men ieg kaand icke kaarum faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 18,
      "text": "thaa skaall ieg nu paa mynn fuod heenne gaa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 19,
      "text": "Hun sloff offuer seg kaabe blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 19,
      "text": "saa monne hun vd aff garde gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 20,
      "text": "Och der hun kaam tieell borige-lied,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 20,
      "text": "vd stander hyndis faader, hand huiller seeg wed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 21,
      "text": "\"Hør du thett, kierre datter mynn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 21,
      "text": "huy komer du saa fraa brølup dynn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 22,
      "text": "\"Her Kaall hand haffuer en sleffred-wyff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 22,
      "text": "ieg well icke were hans haadings-wyff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 23,
      "text": "Ieg skaall nu aldrig mierre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 23,
      "text": "throloffue nogen rider flieerre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 24,
      "text": "Sttalltt Ellind mone seeg y chloster gyffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 24,
      "text": ":: Menn linden gror. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 24,
      "text": "her Kaall drack brølup med synn sleffred-wyff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 24,
      "text": ":: Thy blomster thi er faalden, som der war paa. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}