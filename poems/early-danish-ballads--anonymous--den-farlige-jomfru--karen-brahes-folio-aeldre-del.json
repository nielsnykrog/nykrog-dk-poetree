{
  "id": null,
  "title": "Den farlige Jomfru",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA178.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Der war drøck paa heelle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "der drack kemper snelle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": ":: I fører saa weell worre runer, y-meddens wy ey maa! ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Der drack och Ionn Rannd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "och saa hind rige rider Rossens-wand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "\"Hør du rige Rosens-wand!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "huy fester du dieg icke en lili-wand?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "\"Ieg saa rett aldrig saa wen en møø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "ieg luoffuer hinder io till mynn sleffred vnder ø.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "\"Menn nu wed ieg saa wenn en møø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "suiger du hynnder, thett wordder dynn død.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "\"Werge du saa dynn vnge lyff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "som du skalltt førre meg till den wyff!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "Der dy kaam till denn iumfruens lund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "løffuer wor hengd med røde guld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "\"Du sig meg, vngenn her Iuer Rand!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "huem er oss desz vndlig siunn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "\"Tthett er nu denn iumfruens lund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "ieg haffuer deg sagtt aff y allenn stund.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "\"Da weendt dieg, vngenn Ion Randt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "hiem igien till wor eggen land!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 10,
      "text": "\"Wergge dw saa weell dynn vnge lyff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "som dw skalt følge meg tiell denn wyff!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 11,
      "text": "Tthi kaam till denn iumfru daa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "dy bloddige strøme dy rinder der fraa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 12,
      "text": "\"Sig meg nu, vnggenn Ionn Rand!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "huad er thett for thett for enn ynckelig feerd?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 13,
      "text": "\"Tthett wor alle dy ridders blod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "som biellitt wor aff denn iumfrw guod.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 14,
      "text": "\"Daa wendtt theg, vnggenn Ionn Rand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "for meg till myn egenn lannd!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 15,
      "text": "\"Werge dw saa dynn vngenn lyff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "som du skalt følge meg till denn wyff!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 16,
      "text": "Dy red for denn iumfrus slott,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "slottitt war med stauffuer om-saatt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 17,
      "text": "For huerind staffuer, der wor neder støtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "der war en riders houed paa saatt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 18,
      "text": "\"Du sig meg, vngen Ionn Rand!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 18,
      "text": "huad er thett for enn ynckelig syun?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 19,
      "text": "\"Tthett er alle dy riders hoffuett,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 19,
      "text": "som begligtt wor aff den iumfru guod.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 20,
      "text": "\"Ieg bedder deg, vngenn Ionn Rand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 20,
      "text": "for meg hiem till mynn egenn land!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 21,
      "text": "\"Wiergge nu saa weell ditt vnge lyff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 21,
      "text": "som thu skallt følge meg ind til denn wyff!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 22,
      "text": "Dy kaam daa for denn iumfruens gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 22,
      "text": "denn waar thred med dragenn suerdtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 23,
      "text": "Dy ridder ind aff dørenn thrennd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 23,
      "text": "den iumfru smiller vnder sinn skiennd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 24,
      "text": "Dy thuog wand och saatte dy ridder tilbuords,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 24,
      "text": "rider Rosen-wand thalde rett aldrig ett ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 25,
      "text": "Dy waar icke snarer til buorditt saatt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 25,
      "text": "ind der waar thre dragenn suerdtt offuer dieris hoffuett ragtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 26,
      "text": "Ionn Rand klaper iumfruen weed huiddenn kiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 26,
      "text": "\"Du steelle din wredde, kerre søster mynn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 27,
      "text": "Mynn kierre søster, du stielle dynn suerd!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 27,
      "text": "her er en rider, er dieg well werdt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 28,
      "text": "Mynn kerre søster, du stieelle deg braatt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 28,
      "text": "her er den suend, ieg haffuer deg iett.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 29,
      "text": "Saa snaartt bleff woxeliuss opteend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 29,
      "text": "stuod for den edlig here och brend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 30,
      "text": "Dy oeed och drack enn lyddenn stund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 30,
      "text": "denn iumfru løster att suoffue gange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 31,
      "text": "Dy hygge bluoss bleff daa optend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 31,
      "text": "saa sørgenn gicke rider Rosen-wand med iumfruenn till seenng.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 32,
      "text": "Her Ionn Rand klaper hynnder weed huidden kiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 32,
      "text": "\"Gyff hanom dynn thro, kierre søster mynn!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 33,
      "text": "Denn iumfru tuog ridderenn y synn fauffuen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 33,
      "text": "saa gaff hun hanom guld-krone och konings-naffuen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 34,
      "text": "Denn iumfru hun holltt saa weell synn thro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 34,
      "text": "med erre luod hun dierris brølup buo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 34,
      "text": ":: I førre saa well wor runer, men wy ey maa! ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}