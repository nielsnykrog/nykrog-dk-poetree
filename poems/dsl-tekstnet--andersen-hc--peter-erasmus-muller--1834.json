  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Om Sygeleiet sad Dit Hjertes Kjære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Dit Faderblik var fuldt af Kjærlighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Du bad dem hvile, bad dem rolig’ være,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Thi længer ei Du nogen Smerte leed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Du smilede; de saae Dig blunde stille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Og drømte Livshaab af den Søvn, Du nød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Men da Din Haand de trofast kysse ville,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Da var den kold – da saae de, Du var død!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Ja død! – hensovet fra hver Jordlivs Smerte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "For karsk og salig hos Din Gud at staae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Du var Apostel i Dit Ord og Hjerte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Vor Frelsers Mildhed i Dit Øie laae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "O gid Din Fred, Dit Sind til dem nedstige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Hvis Hjerte bløder, hver som Haab ei veed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Til hver, som skal forkynde Christi Rige! –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "– Vor Lærers Bud var Fred og Kjærlighed.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
