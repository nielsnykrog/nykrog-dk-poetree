{
  "id": null,
  "title": "Brud i Vaande",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA169.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Saa lyddenn daa war stallt Ludse-lild fest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": ":: Denn somer er bolld. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "hindis faader hand løfftte hynder seelliff tiell heest.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Der dantzer buode iumfruer och mørr paa grønenn. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Hannd suor om denn øffuerste Gud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "hannd løfftte rett aldrig saa tung enn brwd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "\"Hun er annttenn meed kiender smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "och helder hun haffuer synn heelsuott faatt!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "Hand løfftte icke ieenn, hand løfftte icke thuo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "hand løfftte weell three, dog thi tho waar smaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "Dy red offuer saa grøn en hiede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "der daannitt stallt Ludselild, som hun reed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "Tthett meelltte denn suend, her Eyeller red nest:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 5,
      "text": "\"Hui mone stalltt Ludselild faalde fraa heest?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "\"Anttenn daa er hyndis saaddell for trang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 6,
      "text": "och heelder hynndis wiee denn giørris for laanng.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "\"Icke daa er mynn saaddell for trang;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 7,
      "text": "myn wie den er meg møggitt for laanng.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "Och der dy kaam y grønenn lund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 8,
      "text": "daa baad staltt Ludseelild huylle en stund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "\"Meg tøckis, thett er saa stuor enn mien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 9,
      "text": "thett wy skaall icke førre bruden fram!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "Sttalltt Ludsellild hynder faldtt thaare paa kiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 10,
      "text": "\"Thu west saa liditt aff sorigenn mynn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "I ganger y lunddenn och skeemtter edder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 11,
      "text": "i-men ieg gaar bortt och huiller meeg!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "Heer Eller gick icke langtt der fraa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 12,
      "text": "sttalltt Lwdsellild føde thy sønner thuo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "Her Ellier skødd sytt suerd for sieg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 13,
      "text": "\"Med Guds loff gaar ieg till dieeg!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "Sttaltt Ludseelild thog thett lynn saa smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 14,
      "text": "der suøbtte hun y synn sønner thuo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "\"Syg meg, stalltt Lwdselild, vnge brud myn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 15,
      "text": "huem er der faadder aff sønner dynn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "\"Saa hiellpe meg Gud aff ald myn nød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 16,
      "text": "ieg weed hanom huerkind løffuind eller død!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "Minn faader hand døde vd med thend strand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 17,
      "text": "som rider thi luo med skibb for land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 18,
      "text": "Otte waar dy suenne, mynn bwre brød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 18,
      "text": "den nyennde waar en ridder, mynn erre nød.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 19,
      "text": "\"Sig meg, stalltt Ludselild, vnge brud mynn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 19,
      "text": "huad gaff denn ridder theeg for erre dynn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 20,
      "text": "\"Hand gaff meg en sylcke-serck:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 20,
      "text": "den haffuer ieg sleett med hiarttens werck.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 21,
      "text": "Hand gaff meg ett røde-guld-baand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 21,
      "text": "och fem guld-ringe paa huer mynn haand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 22,
      "text": "Hand gaff mig en guldbonden kniff:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 22,
      "text": "ieg var tilfreds, dend saad i hans liff!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 23,
      "text": "\"Syg meg, staalltt Ludselild, vnge brud mynn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 23,
      "text": "huad wellt du nu giøre aff sønner dynn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 24,
      "text": "\"Wy lieegger dennom vndder enn liende-ruod!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 24,
      "text": "ieg frøgtter, ieg bidder denom aldrig buod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 25,
      "text": "Wy liegger dennom vnder saa bred enn stieenn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 25,
      "text": "ieg ber for denom buod anggist och myeenn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 26,
      "text": "\"Tthi quer, stalltt Ludselild, sigg icke saa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 26,
      "text": "en beddere foster-muodder skaall dy faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 27,
      "text": "Tthett waar myn suene, dynn burre brød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 27,
      "text": "seelliff waar ieg den rider, dinn ere nød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 28,
      "text": "Ieg laadder dynn sønner till foster-muoder faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 28,
      "text": "stallt Ludselild! thu skaalt raadde mitt buo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 29,
      "text": "Tthu bleff aldrig saa wiee aff hiarttet dynn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 29,
      "text": "att thu klager mynn muoder aff sorig dynn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 30,
      "text": "Hun laadder deg hørre, naar hun bliffuer wred,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 30,
      "text": "du fødde dynn bønn paa saa wild enn hiedde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 31,
      "text": "Saa sluo dy offuer hind kobe blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 31,
      "text": "her Eller løfftte hynd seelleff till ganger graa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 32,
      "text": "Her Eller hand kaam till borige lieed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 32,
      "text": "der stuod hans muoder, hun huilitt sieg wieed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 33,
      "text": "\"Sieg meg, her Eller, kerr sønne mynn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 33,
      "text": "huelckenn er keere vnge brud dynn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 34,
      "text": "\"Mynn kierre muodder, y thager tiell waare!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 34,
      "text": "hun komer her fremerst y iumfru-skaare.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 35,
      "text": "\"Daa saa ieg aldrig y lyffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 35,
      "text": "enn bleger brud vd-ride!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 36,
      "text": "\"Dett er icke vnder, thett hun er bleg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 36,
      "text": "hun haffuer stanndenn saa haard enn lieeg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 37,
      "text": "I gremer hyndder icke med onnde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 37,
      "text": "y guord iorditt dy hindis muoder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 38,
      "text": "Hindis muoder døde aff thuiellinger thuo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 38,
      "text": "saa well skall ieg denom foster-muoder faa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 39,
      "text": "Dy sluoff offuer hynder skaarlagenn-skiend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 39,
      "text": "saa fulde dy hynder y fruer stuoffuen ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 40,
      "text": "Dy saatte hyndder paa dy hønder blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 40,
      "text": "her Eiller hand ganger hynder till och fraa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 41,
      "text": "Her Eyller hand skienchet hinder mød och vin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 41,
      "text": "hand skienchet warm øll for unge brud sin.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 42,
      "text": "Hand lagde sin unge brud paa bolster bla,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 42,
      "text": "sielff lagde hand sig i baren straa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 43,
      "text": "\"Hør du, her Eyller, kier sønen min!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 43,
      "text": "hui soffuer du iche hos unge brud din?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 44,
      "text": "\"Och det er sæd paa hindis øe:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 44,
      "text": "udi sex ugger skal hun ligge møe.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 45,
      "text": "\"Det suared hans moder, den lille-vand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 45,
      "text": "I sex ugger ligger barselquinder fra dieris mand.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 46,
      "text": "Der waar gleede och haalleff størr gamell:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 46,
      "text": ":: Denn somer er bolld. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 46,
      "text": "dy drack buode brølup och barsell till-samell.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 46,
      "text": ":: Der dantzer buode iumfruer och møør paa grønenn. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}