{
  "id": null,
  "title": "Esbern og Sidsel",
  "year_created": [
    1590,
    1591
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Anna Munks Håndskrift",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1591,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/MUNK32.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Enn Anden Viise |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 1,
      "text": "Her Espenn hand thienner ÿ konngens gaardt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "hand thiennthe sig ÿ saa mangen guode dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "kongen slo hanom thill rider,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "och hannom lænen forgaff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": ":: nu lengis mig ÿ landen hiem thill minn | allerkierist | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Konngenn sloff hannom thill rider,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "och | hannom forleninngenn gaff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "hannd gaff | hannom staltt Iomffru Sidzellildt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "hunn var saa venn som dagenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": ":: nu | lenngis mig ÿ Lanndett hiem thill min | allerkieriste. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "Her Espenn gannger ÿ gaardenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "hanndt | legte mett sølff-slagenn Suerdt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "daa | kom hannom ÿ hoffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "hanns Lannge | ørsell-fredt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": ":: m: l: ÿ: l: h: t: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Thett var herre Espenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "hannd suøber | sig hoffuitt ÿ skinnd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "saa gannger hand | ÿ høffuenn-lofftt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "for skiønne fru Sidzellidt ÿnnd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": ":: nu. l. m: v: l: h: t: m: a. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Hell sider ÿ skiønne fru Sidzellild",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "ÿ | spennder eder guldt om thiinn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "denn | ørsell-ferdt, ieg haffuer loffuitt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "hannd | stannder thilbage ÿgienn. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Noch saa haffuer ÿ buode guldt och sølff, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "dett leger forindenn vor kiste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "ÿ giffuer | denn Suenndt eders erennd buortt-fare, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "eder Selff kannd ieg icki møste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": ":: n: l: d: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "Noch saa haffuer ÿ buode guldt och sølff, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "dett ligir forindenn eders skrinn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "ÿ giffuer denn suenndt eders Erennde skall fare, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 7,
      "text": "bliffuer hieme allerkieriste minn. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "Høre ÿ skiønne fru Sidzelille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "ÿ giffuer eders | minnde ther-thill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "att ieg motte holde løffthe minn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 8,
      "text": "ieg kommer vell Snartt ÿgienn |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "Thett var om thenn Sønndag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "saa hellig | tha var thenn dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "her Espenn hanndt | rider thill kierckenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 9,
      "text": "hanndt beder vd | frennder daa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 9,
      "text": ":: n: l: m: ÿ. l. h: t: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "Haffuer ieg nogett modt eder brott,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "eller | nogett modt eder giordt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 10,
      "text": "tha heffner dett | paa mig Sielff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 10,
      "text": "ÿ heffner dett paa mig | ÿ dag:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 10,
      "text": ":: n: l: m: v: l: h: l: m: a: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "Thi redt dennom Saa lennge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 11,
      "text": "vdi-gienom | dÿ grøne skouffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 11,
      "text": "aldrig kom skønne | fru Sidzellildz arum",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 11,
      "text": "aff her Espenns Sadellbouffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 11,
      "text": ":: n: l: m: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 12,
      "text": "Saa tog hunn denn Rider ÿ faffnn, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 12,
      "text": "hunn bødt hannom thusindt guodnatt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 12,
      "text": "ÿ lader eder minndis minn kiere herre |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 12,
      "text": "att ieg er medt eders barnn. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 13,
      "text": "Hannd haffde icki acktitt att verre hedenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 13,
      "text": "forudenn Monidt ienn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 13,
      "text": "dett | var vell fuldt femthenn aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 13,
      "text": "før den | herre hannd kom ÿgienn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 13,
      "text": ":: n: l: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 14,
      "text": "Thett var herre Espenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 14,
      "text": "hannd | stÿritt sÿnn Snecki fraa lannd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 14,
      "text": "dett | var høÿenn bermerrijs,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 14,
      "text": "hanndt vende | sÿnn gannger paa Sanndt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 15,
      "text": "Wocter ÿ vell vor Rige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 15,
      "text": "vocter dett vell | medt Ere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 15,
      "text": "farer vell medt skiønne | fru Sidzelilldt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 15,
      "text": "hun er min hiertens-kiere |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 16,
      "text": "Thett var icki der-epther",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 16,
      "text": "maanitt foruden | ienn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 16,
      "text": "dett var skiønne fru Sidzellildt | gannger ÿ høffuenn-lofft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 16,
      "text": "hun føde saa | venn enn datther.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 16,
      "text": ":: n: L: m: i: L: h: t: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 17,
      "text": "War hannd buorthe ÿ femthenn Aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 17,
      "text": "mierre | och icki minnde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 17,
      "text": "her Espenn tager thill | att lannge Saa Saare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 17,
      "text": "hiem thill sÿnn | guodenn quinnde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 17,
      "text": ":: n: l: m: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 18,
      "text": "Thett var herre Espenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 18,
      "text": "hanndt stÿrett | sinn snecke thill lanndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 18,
      "text": "dett var høÿen | bermerijs,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 18,
      "text": "hannd rennde sinn ganger paa Sandt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 19,
      "text": "Huor lider folck paa ditt Lannd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 19,
      "text": "baade | fiernn och ner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 19,
      "text": "huor lider skiønne fru | Sidzelille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 19,
      "text": "ieg haffuer hender ÿ mitt hierte saa kier.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 19,
      "text": ":: n: l: m: v: l: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 20,
      "text": "Huor lider folck paa ditt lanndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 20,
      "text": "och buode | vde och innde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 20,
      "text": "huor lider skønne frue | Sidzellildt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 20,
      "text": "hunn er min Saa guodt-enn | quinnde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 20,
      "text": ":: n: l: m: v: l: h: t: m | : a: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 21,
      "text": "Hannd thog possenn paa sÿnn bag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 21,
      "text": "och pilegrims-Stauff | ÿ hennde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 21,
      "text": "Saa gaar hand thill | sÿnn egenn gaardt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 21,
      "text": "som ingen manndt hanom | kiennde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 21,
      "text": ":: n: l: m: v: l: h: t: m: A: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 22,
      "text": "Thett var herre Espenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 22,
      "text": "kom ÿ sinn egen | gaardt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 22,
      "text": "vdstodt skiønne fru Sidzelille |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 22,
      "text": "hunn var vell suøbtt ÿ mordt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 23,
      "text": "Thett var skiønne her Espenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 23,
      "text": "hannd | thall thill skiønne fru Sidzelillid vnnder | skinndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 23,
      "text": "vill ÿ lane mig hus ÿ natt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 23,
      "text": "for eder kiere hosbonndis Siell |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 24,
      "text": "Thett suaritt skiønne fru Sidzellildt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 24,
      "text": "och | hinnde rannd thorre paa kinndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 24,
      "text": "fuld-gierne | vdj vor-herris naffnn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 24,
      "text": "for sin | hosbonnde minn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 24,
      "text": ":: n: l: m: v: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 25,
      "text": "Hus vill ieg dig lanne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 25,
      "text": "och madt vill ieg | dig giiffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 25,
      "text": "Ieg haabis thill gudt-fader ÿ himmerig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 25,
      "text": "her Espen er enndnu ÿ liffue. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 26,
      "text": "Her stannder ÿ skiønne fru Sidzellildt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 26,
      "text": "ÿ ere | Saa guodt enn quinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 26,
      "text": "vill ÿ lade mig enn | badstuffue rede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 26,
      "text": "for kier hosbonnde dinn. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 27,
      "text": "Thett suaritt skiønne fru Sidzelille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 27,
      "text": "hun | Stodt ÿ skarlagenn-skinndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 27,
      "text": "fuldt-gierne | ieg dett giører",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 27,
      "text": "for minn kiere hosbonndis | skÿldt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 28,
      "text": "Sielff hennthe hunn hannom ludt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 28,
      "text": "och | Sielff hennthe hunn hannom vanndt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 28,
      "text": "Saa thiennthe hun her Espenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 28,
      "text": "thenn | fromme Erlige manndt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 29,
      "text": "Thett var skiønne fru Sidzelille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 29,
      "text": "hun | touidt hanns huide haanndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 29,
      "text": "berre sig | aldrig sitt Ridersnaffnn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 29,
      "text": "Seg lennger | dølle kanndt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 30,
      "text": "Saa fulde dÿ her Espenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 30,
      "text": "fulde hannom ÿ fruer-Stoffen inndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 30,
      "text": "da loo | skiønne fru Sidzellildt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 30,
      "text": "som før bar | blegenn kinndt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 31,
      "text": "Dett var glede ÿ herre Espenns gaardt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 31,
      "text": "och buode vde och innde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 31,
      "text": "hanns datther | hunn bleff ÿ stuffuenn ind leed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 31,
      "text": "den | skiøniste der Sollenn motte offuer skinne |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 32,
      "text": "Saa giffthe her espenn Sinn datther |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 32,
      "text": "thett var enn iomffru saa venn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 32,
      "text": "hand | gaff hinnde hinn vnnge her karll, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 32,
      "text": "hanndt var enn Rider saa skiønn. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 33,
      "text": "Nu haffuer skiønne fru Sidzellildt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 33,
      "text": "forvonndenn all sÿnn harum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 33,
      "text": "hunn | Soffuer huer natt saa gladelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 33,
      "text": "ÿ her | Espenns Arum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 33,
      "text": ":: Før denn herre | var kommenn vdj landitt hiem till | sÿnn Aller-kieriste. | ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}