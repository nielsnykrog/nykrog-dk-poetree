  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Lyriske Digte",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1924,
    "url": "https://tekstnet.dk/books/jacobsen-jp_lyriske-digte/022/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Marmoret er hvidt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Men det lyser ikke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Søjlerne er slanke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Men de knejse ikke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Kapitælernes frodige Pragt er svunden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Akantusløvet har rullet sig sammen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Er visnet og faldet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Smuldrende blander det sit Støv med Plintens.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Og de gyldne Skaaler er tomme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Deres Malm har intet Mæle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Hebe har kun Taarer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Bakkos har kun Vinløv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Døsigt lege Panthrene med Thyrsen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Af Ælde ryster Zeuses lokketunge Hoved,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Poseidon fægter sælsomt i Luften med sin Trefork,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Og Phoebus seer bedrøvet efter Solen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "De ledige Hestes Hove",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Trampe paa den strengløse Lyre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Muserne slumre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "Gratierne er skilte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Men Lauren har alle sine Blade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Mellem de Søjler staar der en Laure",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Stærkstammet, lavstammet, storkronet og bred.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Nedover Søjlerne, rodfæstet i dem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Løbe de tornede Ranker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Leger det flimrende Løv",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Af den Plante, hvis purpurgyldne Roser",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Alle Sydens Kvinder elske.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Mange Mænds Vej gaar forbi de Søjler,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "Alle Mænds Blikke vogte paa Rosen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "Mange Blomster bær den,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "Og højt er de baarne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "Dog før Dag er vel begyndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 2,
      "text": "Er dens Blomster forbi.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "Men Lauren har [alle sine Blade.]",
      "part": false,
      "marginal_notes": []
    }
  ]
}
