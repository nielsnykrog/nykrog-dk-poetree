  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "JEg vil siunge Herren/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "thi han haffuer hederlige handlet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Hest oc vogn haffuer han styrt i Haffuet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Herren er min styrcke oc Lofsang/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "oc han er min Salighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "Det er min Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "hannem vil ieg prise/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "han er min Faders Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "oc hannem vil ieg holde meget aff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "Herren er den rette stridzmand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "ia Herre er hans naffn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "Pharaos vogne/ och hans mact skød han ned i Haffuet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 4,
      "text": "⁕ Hans vdualde Høffuidzmend drucknede i fledehaffuet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "affgrunden haffuer betackt dem/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "De suncke till bondz lige som Stene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 5,
      "text": "⁕ Herre din høyre haand gør merckelige vnderlige ting/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "Herre din høyre haand haffuer nedslaget fienden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 6,
      "text": "⁕ Oc met din store herlighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 6,
      "text": "haffuer du nedstyrt dine modstandere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 7,
      "text": "⁕ Di der du vdlost din hastighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 7,
      "text": "da op aad hun dem lige som Affner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 8,
      "text": "⁕ Ved du bleste/ da skiød sig Vandet op/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 8,
      "text": "oc Floderne stode i hoffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 8,
      "text": "affgrundene plompede sammen mit vdi haffuet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 9,
      "text": "⁕ Fienden sagde/ ieg vil forfylge dem oc griffue dem dele raabet vd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 9,
      "text": "oc husuale mig paa dem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 10,
      "text": "⁕ Jeg skal draue mit Suerd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 10,
      "text": "oc min egen haand skal ødelegge dem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 11,
      "text": "⁕ Da lost du dit vær blæse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 11,
      "text": "saa betackte Haffuit dem/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 11,
      "text": "oc de siuncke ned som Bly vdi mectige vand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 12,
      "text": "⁕ Herre huo er din lige iblant guderne?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 12,
      "text": "Huo er din lige/ der saa mectig er hellig/ forferlig/ loflig/ oc i gerninger saa vnderlig?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 13,
      "text": "Der du vdrackte din høygre haand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 13,
      "text": "da slugte hun Jorden op.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 14,
      "text": "⁕ Aff din barmhiertighed haffuer du lid dit Folck/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 14,
      "text": "huilcket du haffuer forløst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 15,
      "text": "¶ Oc haffuer førd dem aff din styrcke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 15,
      "text": "til din hellige Bolig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 16,
      "text": "⁕ Der Folckene det hørde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 16,
      "text": "da bebrede de/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 16,
      "text": "banghed fald Philisterne paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 17,
      "text": "¶ Da forfæredes Edoms Førster/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 17,
      "text": "Redzle betog Moabs veldige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 17,
      "text": "och alle Canaans indbyggere mistrøstede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 18,
      "text": "⁕ Lad forfærelse oc fryct falde paa dem ved din veldige arm/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 18,
      "text": "at de mue bliffue stille som Stene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 19,
      "text": "¶ Jndtil dit Falck Herre er igiennem kommet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 19,
      "text": "indtil dette Folck er igiennem kommet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 19,
      "text": "det du haffuer forhuerffuet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 20,
      "text": "⁕ Før dem ind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 20,
      "text": "oc plante dem paa dit Arffbierge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 21,
      "text": "¶ Huilcket du Herre haffuer giort dig til en Bolig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 21,
      "text": "til din helligdom Herre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 21,
      "text": "den din haand haffuer bered.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 22,
      "text": "Herren bliffuer en Kong/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 22,
      "text": "stedze oc euindelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 23,
      "text": "Thi Pharao drog ind i Haffuet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 23,
      "text": "met Heste oc vogne oc Reysenere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 23,
      "text": "och Herren lod Haffuet falde offuer dem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 24,
      "text": "Men Jsraels Børn ginge paa det tørre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 24,
      "text": "mit igiennem Haffuet.",
      "part": false,
      "marginal_notes": []
    }
  ]
}