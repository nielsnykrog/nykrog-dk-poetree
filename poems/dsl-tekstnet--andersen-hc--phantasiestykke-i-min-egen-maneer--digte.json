{
  "id": null,
  "title": "Phantasiestykke i min egen Maneer",
  "year_created": 1830,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
