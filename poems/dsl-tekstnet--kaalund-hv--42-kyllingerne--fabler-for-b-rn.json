  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "\"Jeg fryser, Moder, om mine Ben\". -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "\"Og jeg har traadt i en Rendesten\". -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "\"Og jeg er søvnig - og jeg er træt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "i mine smaa Vinger - og jeg er mæt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "\"O, lille Moder, o giv os Ly,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "vi er saa angst for den sorte Sky!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Og Hønen dem gjorde saa gjerne tilpas;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "men under hendes Vinger var næppe Plads.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "De myldred derinde, der var en Larm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "naar En blev kold, blev en Anden varm;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "her titted et Hoved, her stak et Par Ben;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "men Himlen blev atter lys og ren,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "og Solen skinte; da kom tilsyne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Smaakyllingerne under den bløde Dyne.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
