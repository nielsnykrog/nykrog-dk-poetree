  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "En Pudelhund havde mistet sin Kjole;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "den vilde sig ude i Aftenen sole;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "hu! tænkte den, jeg maa varme min Krop.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Saa krøb den paa Brædestablen op,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "mens Tænderne Tappenstreg slog i Munden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "tilrette lagde sig Pudelhunden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Men Solen stedse dybere veg -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "paa Bræderne højere Pudelen steg;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "dog Solen, førend den ret det mærked,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "sig listede ned bag Plankeværket. -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Et Bjæf af Forundring Pudelen gav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "den tænkte: hvor Pokker blev Solen af?",
      "part": false,
      "marginal_notes": []
    }
  ]
}
