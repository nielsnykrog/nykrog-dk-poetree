{
  "id": null,
  "title": "Hilsen fra Dyrehavens Dryader",
  "year_created": 1924,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Jens Peter Jacobsen",
    "country": null,
