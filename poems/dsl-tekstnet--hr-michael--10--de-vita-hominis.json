  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "De Vita Hominis",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1514,
    "url": "https://tekstnet.dk/books/hr-michael_de-vita-hominis/010/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Uexatus morbis morti tumulando propinquo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Candida sic orbis turbatus cuncta relinquo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "thet kændhes paa mig som allæ mwæ see.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Huar er nw wærdzens æræ?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Mig hiælper ey raad, ey læghædom.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Fuld ynkælighen ieg til wærdhen kom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Icht brydhær sønder baadhæ fødher och hænder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "myt hoffuit thet wærker, vdh faldhæ mynæ tænder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "podagel staar i myn sidhæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "och ræcker swo nedh til baadhæ been,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "krampæ dragher mig allæ tidhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "Myt hiarthæ thet wærker och alt myt lijff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "som ther stodhæ i en draffuen knijff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "myn rygh brøsther al i styckæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "awi, hwad ieg haffuer ildhæ giort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "hær fangher ieg aldrig lyckæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Myn hwg han løber baadhæ hist och hijd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "for ieg vnytthælighen haffuer thæret myn tijh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Gud giordhæ ieg aldrig ræth eller sckiæl,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "ieg duldhæ myn tiændhæ, thet wisthæ ieg wæl,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "ieg wildhe’n ey kirkæn sændhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Myn præst hannum giordhæ ieg offthæ emood,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Myn almessæ wildhæ ieg ickæ giffuæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "uthen thet som inghen mand kwndhæ nydhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "thet lood ieg fattughæ mennisckæ bydhæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "them sidhen at dørræn driffuæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "tha lenedhæ han myn siwghæ och nød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "thet wildhæ ieg inthet sckiødhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "Then tijd ieg war baadhæ karsck och kaad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": "ffuld aarlæ ieg om daghen aad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "Meth fasthæ, meth bønær, meth kirckægang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "then tijd tychthæ mig waræ gansckæ lang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "ieg schuldhæ i kircken standhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 7,
      "text": "Er hær nw enchthen qwindhæ eller mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 7,
      "text": "ieg mesthær i stæd myn andhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "O werdhen, huar haffuer thu gæcket mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "then tijd thu drogst myt sindh til tig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 8,
      "text": "at tiænæ tig allæ tidhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 8,
      "text": "inghen wil mig nw sckødhæ eller see",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 8,
      "text": "at ieg schuldhæ thettæ bidhæ.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
