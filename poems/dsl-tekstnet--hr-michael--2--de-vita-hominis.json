  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Nascens procedo nudus de ventre parentis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "In partu ledo matrem grauibus nocumentis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Lath vp thit hoffuit och see tig om",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "hwar leghomet thet til wærdhen kom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "tænk therpaa allæ tidhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "wanmechtig och nøghen komst thu paa iord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "mod leghomæns løsth at stridhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Thin modher taaldhæ for tig møghæl nød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "thet war stort wndhær hwn bleff ey død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Then tijd thu føddes eth mænnisckæ at wæræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "gør hennæ baadhæ hedhær och tucht och æræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "meth effnæ gack hennæ til handhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Meth ord, meth gerninghær gør hennæ ey harm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "hielp hennæ thet thu kant læsthæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "ey enesthæ i liffuæ, mæn efther hennæ død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Lad hennæ ey møghet taalæ skiærsildznød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "ridhær thu meth hundredhæ hæsthæ.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
