{
  "id": null,
  "title": "Akademisk Læseforening",
  "year_created": 1835,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Carl Ploug",
    "country": null,
    "wiki": "Q347860"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1835,
    "url": "https://tekstnet.dk/books/ploug-c_akademisk-laeseforening/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "\"Der stod et Træ i Regensens Gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Det bar saa skyggefulde Grene;\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Derunder Slægterne fra Høst og Vaar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Sig kunde broderlig forene;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Der drak de Tankens Honning, Ordets Duft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Og Sangen rulled gjennem Aftnens Luft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Om Danmarks Ø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Om Hjertets Mø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Om Gaardens Pris og Christians Hæder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Og Træet Spire paa Spire gav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Som af sin gode Marv det maatte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Men Gaardens Forsyn holdt mere af",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "En lille vissen Urt i Potte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Og derfor kapped Øxen af dets Rod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Endskjønt det i sin fejre Sommer stod;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Flokken, som sad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Under dets Blad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Blev spredt, som salig Polens Sønner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Det faldt de husvilde Svende ind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "\"Der gaaer paa Gaden jo saa Mange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "\"Med samme Stempel og Brodersind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "\"Som dem, der bo i Gaardens Gange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "\"Hvad om vi samled sammen dem med Il",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "\"Og Facultetet narrede April?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "\"Om vi med dem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "\"Bygged et Hjem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "\"Af ny for gjæve Musasønner?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "Der staaer en Knejpe paa Hauserplads:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "Paa Pladsen der det netop kniber,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "Og Luften falder lidt tung og kras,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "- Tak ske de offenlige Piber!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "Fra Kakkelovnen Pallas bag sit Skjold",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 0,
      "text": "Alvorlig ser paa sine Drenges Sold;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 0,
      "text": "Smal Vittighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 0,
      "text": "Glider kun ned",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 0,
      "text": "I \"Vrøvleho'dets\" trange Strube.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 0,
      "text": "Men døje kan man lidt Puf og Tryk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 0,
      "text": "Hvor nok af Hjerterum der gives,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 0,
      "text": "Og Atmosfæren er ej for tyk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 0,
      "text": "Hvor Livet frit og frisk kan trives;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 0,
      "text": "En Smule Sold gjør ikke Pallas vred,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 0,
      "text": "Thi Mod og Kraft forfriskes jo derved,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 0,
      "text": "Og Viddets Spil",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 0,
      "text": "Dog af og til",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 0,
      "text": "Erstattes kan af flotte Løjer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 0,
      "text": "Idag vor Knejpe til Verden kom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 0,
      "text": "Et Aar er just forganget siden;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 0,
      "text": "Er end dens Kræfter en ringe Sum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 0,
      "text": "Saa voxe de vel til med Tiden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 0,
      "text": "Gid den bevare blot sit ægte Præg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 0,
      "text": "Og huse Brodersindet bag sin Væg!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 0,
      "text": "Derpaa beror",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 0,
      "text": "Fremtidens Flor:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 0,
      "text": "Thi skal Geburtsdagsbarnet leve!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 0,
      "text": "Vor Hu har intet Blivested,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 0,
      "text": "Den flytter med vort simple Kammer:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 0,
      "text": "Vort Hjerte varmes ikke ved",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 0,
      "text": "En huslig Arnes milde Flammer:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 0,
      "text": "Og knuger Livets Kval vort Bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 0,
      "text": "Vi savne tidt en kjærlig Røst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 0,
      "text": "Som nyfødt Haab og Mod og Trøst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 0,
      "text": "Kan i den syge Sjæl opklække.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 0,
      "text": "Men ene vi dog aldrig staa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 0,
      "text": "Vor Vej er dog ej mørk og øde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 0,
      "text": "Saasnart kun vore Hjerter slaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 0,
      "text": "Hinanden broderlig imøde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 0,
      "text": "Vi fødtes jo af samme Skød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 0,
      "text": "Det samme Aandens Kald vi lød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 0,
      "text": "Og Evighedens Straale gød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 0,
      "text": "Den samme Ild i vore Aarer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 0,
      "text": "Og derfor om vor hele Stand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 0,
      "text": "Et stærkt og helligt Baand sig vinder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 0,
      "text": "Som, selv ej slidt af Tidens Tand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 0,
      "text": "Med Gubben Ynglingen forbinder;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 0,
      "text": "En Pagt, der voxed, frisk og sund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 0,
      "text": "Af Hjertets foraarsvarme Bund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 0,
      "text": "Men drak sin Marv, sin indre Gund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 0,
      "text": "Af Tankelivets rige Kilde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 0,
      "text": "Kun Enkeltmand har intet Hjem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 0,
      "text": "Men husvild er ej hele Stammen:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 0,
      "text": "I denne Kreds vi kaldte frem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 0,
      "text": "Et Arnested for Broderflammen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 0,
      "text": "Her staar et Ly for Regn og Vind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 0,
      "text": "Gror Lindring for hvert sorgfuldt Sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 0,
      "text": "Her farver Glædens Kald vor Kind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 0,
      "text": "Og lokker Toner af vort Hjerte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 0,
      "text": "Og om vort Samfunds unge Kraft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 0,
      "text": "Vil stolt paa Tidens Strømning flyde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 0,
      "text": "Om Tanken selv, der har det skabt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 0,
      "text": "Vil som en visnet Skal det bryde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 0,
      "text": "Det Liv, vi her alt levet har,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 0,
      "text": "De Blomster og den Frugt, det bar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 0,
      "text": "Skal tindre som en Stjerne klar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 0,
      "text": "Paa vor Erindrings stille Bue!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 0,
      "text": "Kors, Akademicum! er det Dig selv?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 0,
      "text": "Kjender Du Dig i det store Hotel?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 0,
      "text": "Du, som i Vimmelskafts-Sølen sov vel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 0,
      "text": "Druknende i Gjæld!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 0,
      "text": "Hvor er din Sfære af Tran og Tobak?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 0,
      "text": "Hvor er din Vinduestræk og din Schak,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 0,
      "text": "Oppositionen med Briller og Frak",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 0,
      "text": "Og drøvtygget Snak?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 0,
      "text": "Her ser man jo Ministre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 0,
      "text": "Ulke og Stokfilistre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 0,
      "text": "Gentlemen og Pak:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 0,
      "text": "En afdanket Formand slaar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 0,
      "text": "Her paa Puf Etatsraads-Folder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 0,
      "text": "Og for Blomsterpige gaar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 0,
      "text": "Mangen driftig Solder:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 0,
      "text": "Se, Carl Nielsen i Embedshabit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 0,
      "text": "Gamle Bekjendte af Holbergs Elit',",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 0,
      "text": "Triblers Fink-Lohr og tyrolsk Kvirrevit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 0,
      "text": "Og Frøkner i Sort og Hvidt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 0,
      "text": "Ak, men det Hele er kun Illusion!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 0,
      "text": "Atter, naar Phoebus faar fyldt sin Ballon,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 0,
      "text": "Finder Enhver kun sin gamle Person,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 0,
      "text": "Blot for al Fiction:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 0,
      "text": "Lysene slukkes, og Tonerne dø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 0,
      "text": "Skæget gror frem paa den blomstrende Mø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 0,
      "text": "Hele Besætningen gaar op i Frø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 0,
      "text": "Thi \"alt Kjød er Hø\".",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 0,
      "text": "Herskab og Domestikker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 0,
      "text": "Af samme Bolle drikker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 0,
      "text": "Lige genereus:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 0,
      "text": "Ungdomskraften slaar Sparto",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 0,
      "text": "Til de pudrede Parykker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 0,
      "text": "Og Magnaters Morgenro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 0,
      "text": "Endes af en Rykker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 0,
      "text": "Stadsen bli'r bragt Marchandiseren hen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 0,
      "text": "Slet ingen Rest af vor Lyst er igjen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 0,
      "text": "Uden et Hul i din Kasse, min Ven!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 0,
      "text": "Og saa dine Tømmermænd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 0,
      "text": "Lad det kun flygte, det raske Moment!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 0,
      "text": "Lad det ha' tømt Dig din Pung saa omtrent!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 0,
      "text": "Glæden, min Bro'er! gi'r, naar selv den er endt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 0,
      "text": "Varige Procent.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 0,
      "text": "Svulmer dit Bryst ikke af Harmoni?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 0,
      "text": "Hører Du Toner ej bruse deri,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 0,
      "text": "Toner af Livet og dets Poesi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 0,
      "text": "Som gjør stærk og fri?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 0,
      "text": "Tidt skal dit Hjerte banke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 0,
      "text": "Tidt nynne skal din Tanke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 0,
      "text": "Samme Melodi.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 0,
      "text": "Snart vi skilles, - og faa Kald,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 0,
      "text": "Viv og Børn og egen Hytte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 0,
      "text": "Mindet om vor Ungdom skal",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 0,
      "text": "Vi dog med os flytte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 0,
      "text": "Og naar engang udi Bedstefa'rs Sal",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 0,
      "text": "Atter der nippes af Glædens Pokal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 0,
      "text": "Gjenfødt af Tanken opstande da skal",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 0,
      "text": "Vort lystige Karneval!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 0,
      "text": "Sold, Akademicum, een Gang endnu!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 0,
      "text": "Kald dine Sønner med sværmende Hu!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 0,
      "text": "Løft dine Stemmer til Gjenboers Gru",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 0,
      "text": "Een Gang endnu!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 0,
      "text": "Væk nu med Driverne, Bordene frem!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 0,
      "text": "Stolene ind mellem Stolene klem!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 0,
      "text": "Bli'r der ej Plads til et tørstende Lem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 0,
      "text": "Faar han gaa hjem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 0,
      "text": "Kom, vore Ganymeder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 0,
      "text": "Unge Johan og Peder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 0,
      "text": "Og sæt Boller frem!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 0,
      "text": "Thi det var jo dog en Skam,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 0,
      "text": "Om vor Knejpe Straadød døde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 0,
      "text": "Den bør druknes i en Dam",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 0,
      "text": "Udaf Druer røde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 0,
      "text": "Kraftigt og friskt var det Liv, den gav Ly,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 0,
      "text": "Derfor den hilse sin Død uden Sky;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 0,
      "text": "Lystig og kjæk, som den var i sit Gry,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 0,
      "text": "Den dale for Nytaarsny!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 0,
      "text": "Husker I, dengang vi bosatte ble'",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 0,
      "text": "Tæt ved Regensen for Markstykker tre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 0,
      "text": "Levede sobert af Kaffe og The",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 0,
      "text": "I vor Ide;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 0,
      "text": "Fik, mens vi sad paa den muddrede Plads,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 0,
      "text": "Tyrke-Divaner og kristent Kalas,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 0,
      "text": "Lavede Hyldingsadresser paa Trads;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 0,
      "text": "Jo, det var Spas!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 0,
      "text": "Spilte \"Contubernaler,\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 0,
      "text": "Og hørte kvalme Taler",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 0,
      "text": "Af Professor Ras-:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 0,
      "text": "Slog saa ned i Vimmelskaft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 0,
      "text": "Trak af Russer hele Flokken,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 0,
      "text": "Soldede med dem paa Kraft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 0,
      "text": "Efter Formandsklokken;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 0,
      "text": "Tegned og præked og sang Politik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 0,
      "text": "Snyder paa Snyder fra \"Kammeret\" fik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 0,
      "text": "Misted vor Kasse, men holdt os en Klik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 0,
      "text": "Og halvt i Hundene gik.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 0,
      "text": "Ja, vi er blevne os lige til Sidst;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 0,
      "text": "Selvsamme Dyder og selvsamme Brist,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 0,
      "text": "Vrøvl og Principer og Enhed og Tvist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 0,
      "text": "Bo her som hist.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 0,
      "text": "Nu er det ude, vort Kredsløb er endt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 0,
      "text": "Formen, vi bugted os i, har udtjent;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 0,
      "text": "Nytte vi skal, hvad vi her har erkjendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 0,
      "text": "I et nyt Moment.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 0,
      "text": "Imorgen Kveld med Glæde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 0,
      "text": "Skal ind i dette træde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 0,
      "text": "Hver en brav Student!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 0,
      "text": "Men i Aften Mindets Kraft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 0,
      "text": "Sejre over det, vi haabe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 0,
      "text": "Blande i den stærke Saft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 0,
      "text": "Vemods milde Draabe!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 0,
      "text": "- Her har vi tømt Ungdomsglædernes Skaal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 0,
      "text": "Varmet vort Hjerte ved Vingudens Baal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 0,
      "text": "Svoret, at Frihed og Ret er vort Maal!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 0,
      "text": "Drik Akademicums Skaal!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
