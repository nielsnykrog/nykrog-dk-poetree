{
  "id": null,
  "title": "72. Revolutionstiden",
  "year_created": 1858,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Vilhelm Kaalund",
    "country": null,
    "wiki": "Q2362214"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Et Foraar. Digte, Ældre Og Nyere",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1858,
    "url": "https://tekstnet.dk/books/kaalund-hv_et-foraar/071/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Giganten var styrtet; paa ensom Ø",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "maatte han, som rystede Verden, dø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Og der var Fryd i Filistrenes Lejr,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "nu havde man vundet den store Sejr;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "nu havde man lænket med sejge Baand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Omvæltningens higende Kæmpeaand;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "nu vared vel Freden til evig Tid;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "nu blev det ej mér end til Pennestrid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "- Og Dagene kom, og Dagene gik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "og der blev blandet en Dvaledrik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "og der blev øst med et bundløst Sold",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "og præket om Fred og Maadehold;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "men Misfornøjelsens Djævel sneg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "sig over Jorden og drev sin Leg;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "den listed sig ind i Hytte og Slot",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "med ængstende Tvivl og isnende Spot;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "den rokked ved Alt, den gnavede skjult,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "saa Alt blev tomt og underlig hult.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Og Tiden ligned en sminket Gjæk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "der skjulte med Smil de slappe Træk:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "Den mærked Øxen ved Træets Rod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "den aned Vulkanen, hvorpaa den stod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "- Og der blev født en Slægt uden Ro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "en Slægt uden Tillid og Barnetro;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "den hvirvled sig i den vildeste Dans,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "den gabede midt i Blændværkets Glans;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "hvad Tænkerne skrev, hvad Skjaldene sang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "det havde for den ej Livsfyldens Klang;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "den lytted med Forventningens Ve,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "som skulde nu brat det Mægtige ske!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "Den vented og vented paa Skjæbnens Dom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "den raabte: Kom ind! men Ingen kom;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 0,
      "text": "Den nye Messias, den nye Profet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 0,
      "text": "som Sværmerne spaaede, blev ikke set.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 0,
      "text": "og Ingen tændte det Sandhedslys,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 0,
      "text": "hvortil man trængte i Tvivlens Gys.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 0,
      "text": "Hvad hjalp den grublende Menneskekløgt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 0,
      "text": "De Vises Sten blev forgjæves søgt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 0,
      "text": "det syntes Alt som et Kredsløb dumt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 0,
      "text": "hvori det Krumme blev evigt krumt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 0,
      "text": "Det var, som Livet i Fredens Skjød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 0,
      "text": "var viet ind til en langsom Død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 0,
      "text": "det var, som skulde dets Pulse staa -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 0,
      "text": "hvad eller Gjenfødelsens Time slaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 0,
      "text": "Den kom, den kom, den anede Stund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 0,
      "text": "den brast under Foden, den hule Grund;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 0,
      "text": "den mørke Sky har sit Lyn udsendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 0,
      "text": "og Freden, \"den evige Fred\", er endt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 0,
      "text": "I Oprør sig vælter Tidens Flod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 0,
      "text": "dens Bølger er røde af Menneskeblod;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 0,
      "text": "dens usleste Bundfald af Had og Nag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 0,
      "text": "er steget for Lyset og kommet for Dag;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 0,
      "text": "og alle de Suk, som i Stilhed lød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 0,
      "text": "om gammel Uret og gammel Nød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 0,
      "text": "om svegne Løfter og skuffede Haab,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 0,
      "text": "nu svulme til et Befrielsesraab -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 0,
      "text": "et Raab, der henfarer med Stormens Sus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 0,
      "text": "saa Throner vakle og styrte i Grus;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 0,
      "text": "og Folkevilliens Kæmpe stor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 0,
      "text": "opløfter vild sit Hoved fra Jord;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 0,
      "text": "den knejser i Sky med Titanens Trods:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 0,
      "text": "\"Jeg vil ej behandles som død Kolos;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 0,
      "text": "imens I fejred Blændværkets Fest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 0,
      "text": "stod jeg derude i Slud og Blæst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 0,
      "text": "Nu vil jeg smage den Lykke engang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 0,
      "text": "hvorom saa fristende Ordene klang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 0,
      "text": "Til Lykkens Ø fører vel en Bro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 0,
      "text": "hvis ellers jeg kan mine Drømme tro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 0,
      "text": "og kan jeg ikke derover naa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 0,
      "text": "velan, lad da Dommedagskampen staa!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 0,
      "text": "Det vakler, det brager ved Kæmpens Gang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 0,
      "text": "og Dødsskrig sig blande med Sejerssang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 0,
      "text": "Den højeste Stordaad, den plumpeste Vold",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 0,
      "text": "opløfter Sjælen og isner den kold.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 0,
      "text": "Og Alt sig blander saa sært iflæng:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 0,
      "text": "Hist strækker sig Betler i Kongeseng;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 0,
      "text": "mens Jordens Mægtige husvilde gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 0,
      "text": "tage Tiggerens Børn deres Guldkroner paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 0,
      "text": "Ydmyget er Alt, som knejste i Sky;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 0,
      "text": "det Gamle er styrtet, men hvor er det Ny,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 0,
      "text": "det Ny, det Ny, som blev forberedt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 0,
      "text": "- en Herlighed, som Ingen har set!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 0,
      "text": "Det er, som vi staa mellem Verdner to",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 0,
      "text": "og har kun en Spindevævstraad til Bro.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 0,
      "text": "Vi sé omkring os et Syndflodshav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 0,
      "text": "men ikke den Jord, som skal stige deraf",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 0,
      "text": "med klarere Lys, med renere Luft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 0,
      "text": "vi mærke ikke dens Blomsterduft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 0,
      "text": "vi famle endnu i Mulm og Nat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 0,
      "text": "- Hvor findes det frelsende Ararat?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 0,
      "text": "Føler Du, Gamle, Dig trættet og tung,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 0,
      "text": "spørger Du Nyt kun derhjemme i Stolen?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 0,
      "text": "Var ogsaa Du begejstret og ung,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 0,
      "text": "steg din Aand som en Ørn imod Solen?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 0,
      "text": "Sværmed engang Du for Frihedens Sag?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 0,
      "text": "Har Du den mægtige Kejser beundret,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 0,
      "text": "lyttet med Fryd til de tordnende Brag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 0,
      "text": "da i hundrede Slag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 0,
      "text": "over Verden med Sejer han dundred?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 0,
      "text": "Ser Du nu, mæt af Erfaring og Aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 0,
      "text": "tvivlende til ved den brogede Færden?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 0,
      "text": "Længes Du under de graanede Haar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 0,
      "text": "efter Fred midt i Ufredens Verden?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 0,
      "text": "Viser man ikke din Alder Respekt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 0,
      "text": "kommer man ej dine Ønsker imøde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 0,
      "text": "vender sig bort den opvoxende Slægt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 0,
      "text": "har dit Ord ingen Vægt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 0,
      "text": "vinker Savnet Dig hen til de Døde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 0,
      "text": "Endt er din Ungdoms begejstrede Drøm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 0,
      "text": "Fremmed forlængst for hver ny Aabenbaring,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 0,
      "text": "kæmper Du svag mod den rivende Strøm",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 0,
      "text": "som et Barn med din Oldingserfaring.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 0,
      "text": "Roser man Tiden, Du kalder det Vind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 0,
      "text": "finder, at Alt i din Ungdom var bedre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 0,
      "text": "Da var der Alvor i Daad og i Sind;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 0,
      "text": "hvor den Unge kom ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 0,
      "text": "stod han taus blandt ærværdige Fædre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 0,
      "text": "Underligt hasted Dig Tiden afsted,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 0,
      "text": "Barnet fast blev Dig for klog paa sin Skamle;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 0,
      "text": "Tidsstrømmen rulled, Du fulgte ej med,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 0,
      "text": "Du holdt fast ved det Vante, det Gamle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 0,
      "text": "Mod din hellige Enfold, din Fædrenetro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 0,
      "text": "satte kjækt man Systemer paa nyeste Mode,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 0,
      "text": "dunhaget Dreng hørte Græsset at gro;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 0,
      "text": "naar de Vittige lo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 0,
      "text": "lo de ikke som Rahbek og Tode.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 0,
      "text": "Sig mig, Du Gamle, hvad tykkes Dig nu?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 0,
      "text": "Bliver Dig Verden alt værre og værre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 0,
      "text": "synes Dig Jorden slagen med Gru",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 0,
      "text": "og forladt af sin Skaber, sin Herre?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 0,
      "text": "Rammer det Dig med Aarhundreders Vægt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 0,
      "text": "det Uhyre, som sker; tror Du, Verden skal bløde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 0,
      "text": "bløde af Saar, som Du mente var lægt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 0,
      "text": "og den levende Slægt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 0,
      "text": "for sit Letsind forfærdeligt bøde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 0,
      "text": "Gamle, fornem dog et trøstende Ord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 0,
      "text": "hør det, det lyder til Dig fra de Unge:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 0,
      "text": "Sejre forvist skal Lyset paa Jord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 0,
      "text": "det er sagt med Profeternes Tunge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 0,
      "text": "Han, som før Dagenes Fødsel var til,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 0,
      "text": "i de rullende Tider bag Stjernerne vaager.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 0,
      "text": "Livet er intet Tilfældighedsspil -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 0,
      "text": "der maa ske, hvad der vil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 0,
      "text": "det skal dages, trods Uvejr og Taager!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 0,
      "text": "Vakler end alt i det flygtige Døgn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 0,
      "text": "vælter sig vildt Nationer i Krampe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 0,
      "text": "styrte forvist skal hver knejsende Løgn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 0,
      "text": "om end først efter rasende Kampe!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 0,
      "text": "Taalmod, Du Gamle! Striden er lang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 0,
      "text": "Mange maa lide, og Mange maa sukke;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 0,
      "text": "Menneskets Slægt skal dog juble engang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 0,
      "text": "den Lyksalighedssang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 0,
      "text": "som i Paradis lød ved dens Vugge!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 0,
      "text": "Fred om din Alder! Fred om din Tro!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 0,
      "text": "Højt over Uvejret Stjernerne tindre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 0,
      "text": "Røver Dig Verden din Alderdomsro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 0,
      "text": "luk da Øjet og ty til dit Indre;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 0,
      "text": "vend dér dit Syn imod Evigheds Hav.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 0,
      "text": "Herren er Herren, hans Navn være lovet!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 0,
      "text": "Tager han end, hvad paa Jord han os gav -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 0,
      "text": "over Menneskets Grav",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 0,
      "text": "løfter Menneskeslægten sit Hoved!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 0,
      "text": "Du, som med det kjække Sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 0,
      "text": "med de stolte Kæmpeplaner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 0,
      "text": "styrter Dig i Kampen ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 0,
      "text": "er den Sejer, som Du aner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 0,
      "text": "Broder, mér end Hjernespind?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 0,
      "text": "Er Du mér end Tidens Gjæk?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 0,
      "text": "Sé den Gamles slappe Træk -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 0,
      "text": "Kæmper blive kan til Dværge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 0,
      "text": "Mus er født saa tidt af Bjerge;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 0,
      "text": "Du med dine stolte Planer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 0,
      "text": "Du vil flytte Bjerge væk!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 0,
      "text": "Herlig, herlig er din Drøm:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 0,
      "text": "Verdensfrihed, Verdenslykke!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 0,
      "text": "Gjenfødt skal nu Livet dykke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 0,
      "text": "op af Tidens vilde Strøm",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 0,
      "text": "og bortkaste karsk sin Krykke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 0,
      "text": "Glædestempler skal det bygge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 0,
      "text": "blive som en festlig Leg -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 0,
      "text": "Ingen, Ingen sidde bleg",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 0,
      "text": "i den kolde, mørke Skygge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 0,
      "text": "Nærmer sig alt Sejrens Dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 0,
      "text": "jubler Du den alt imøde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 0,
      "text": "Sank i Graven med de Døde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 0,
      "text": "tusindaarige Bedrag?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 0,
      "text": "Krymper sig for Sandheds Vælde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 0,
      "text": "Løgnen i den sidste Strid?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 0,
      "text": "Staa vi for en gylden Tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 0,
      "text": "uden Herskere og Trælle?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 0,
      "text": "Aander Du dens rene Luft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 0,
      "text": "falder fra dit Øje Bindet?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 0,
      "text": "Tør nu Ingen mér forblindet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 0,
      "text": "sætte Vanvid mod Fornuft?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 0,
      "text": "Har det Evige maaske",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 0,
      "text": "sig paany da aabenbaret?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 0,
      "text": "Er hvert Spørgsmaal alt besvaret,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 0,
      "text": "kan den vantro Thomas sé,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 0,
      "text": "lægge Fingren selv i Arret?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 0,
      "text": "Broder, det er Sværmeri!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 0,
      "text": "Bag de skjønne Illusioner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 0,
      "text": "lér den bittre Ironi.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 0,
      "text": "Paa Tyranners knuste Throner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 0,
      "text": "er dog Verden ikke fri;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 0,
      "text": "der er blodig Had og Trods",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 0,
      "text": "mellem Jordens Millioner -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 0,
      "text": "ak, og ingen ny Forsoner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 0,
      "text": "vandrer kjærlig mellem os!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 0,
      "text": "Ham, som Fredens høje Ord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 0,
      "text": "talte her i Støvets Zone,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 0,
      "text": "ham gav man en Tornekrone,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 0,
      "text": "han blev ikke hørt paa Jord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 0,
      "text": "Fremad bruste Tidens Elv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 0,
      "text": "Riger sank, og ny blev grunded,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 0,
      "text": "Lykken blev dog aldrig fundet:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 0,
      "text": "\"Elsk din Næste som Dig selv\",",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 0,
      "text": "denne Sejr blev aldrig vundet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 0,
      "text": "Man har kæmpet, man har lidt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 0,
      "text": "man har prøvet, man har vraget;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 0,
      "text": "men fra Lykken ligevidt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 0,
      "text": "staar man, skuffet og bedraget -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 0,
      "text": "Du vil gjøre Kæmpeskridt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 0,
      "text": "Du vil brat en Verden forme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 0,
      "text": "uden Kampe, uden Storme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 0,
      "text": "give Hver, som savner, Sit!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 0,
      "text": "Broder, det er Sværmeri!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 0,
      "text": "Kampen raser paa vor Klode -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 0,
      "text": "hæv os, styrk os, gjør os gode;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 0,
      "text": "da, først da er Verden fri.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 0,
      "text": "Ak, thi, Broder, Tidens Orm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 0,
      "text": "Verdensnøden, Verdensskaden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 0,
      "text": "ligger ej paa Overfladen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 0,
      "text": "ej blot i den ydre Form.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 233,
      "stanza_id": 0,
      "text": "Søg den i dit eget Bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 234,
      "stanza_id": 0,
      "text": "dér skal Du Tyrannen fælde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 235,
      "stanza_id": 0,
      "text": "kun ved Kjærlighedens Vælde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 236,
      "stanza_id": 0,
      "text": "kan Du ende Verdens Brøst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 237,
      "stanza_id": 0,
      "text": "skabe Mennesker af Trælle;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 238,
      "stanza_id": 0,
      "text": "alt det Andet slaar ej til,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 239,
      "stanza_id": 0,
      "text": "ender Kampen ej herneden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 240,
      "stanza_id": 0,
      "text": "renser Klinten ej fra Hveden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 241,
      "stanza_id": 0,
      "text": "er kun Tant og Gjøglespil.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 242,
      "stanza_id": 0,
      "text": "Ogsaa jeg er ung som Du,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 243,
      "stanza_id": 0,
      "text": "deler Savn som Du med Tiden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 244,
      "stanza_id": 0,
      "text": "jeg maa med som Du i Striden;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 245,
      "stanza_id": 0,
      "text": "frem til Lyset staar min Hu.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 246,
      "stanza_id": 0,
      "text": "Det skal sejre, ja forvist,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 247,
      "stanza_id": 0,
      "text": "Mørket mér og mér fortrænges!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 248,
      "stanza_id": 0,
      "text": "Ogsaa jeg fra Støvet længes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 249,
      "stanza_id": 0,
      "text": "har som Du ej Ro og Rist.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 250,
      "stanza_id": 0,
      "text": "\"Fremad mod det fjerne Maal!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 251,
      "stanza_id": 0,
      "text": "være Løsnet paa vor Klode.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 252,
      "stanza_id": 0,
      "text": "Frem mod Lyset, men med Taal;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 253,
      "stanza_id": 0,
      "text": "lang er Kampen for det Gode.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 254,
      "stanza_id": 0,
      "text": "Længe vil endnu vi rave",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 255,
      "stanza_id": 0,
      "text": "frem ad Banen Skridt for Skridt -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 256,
      "stanza_id": 0,
      "text": "Broder, naar Enhver faar Sit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 257,
      "stanza_id": 0,
      "text": "smuldre vi i vore Grave.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
