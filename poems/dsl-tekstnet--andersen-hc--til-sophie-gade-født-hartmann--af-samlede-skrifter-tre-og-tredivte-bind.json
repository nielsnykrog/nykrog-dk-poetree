  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Min egen stærke Dreng, min fine Pige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "En Rigdom stor, stor som min Kjærlighed!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Nei, der er ikke To saa nydelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Som disse To, – ja, det hver Moder veed!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Igjennem Øinene til Hjertebunden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Man seer, som man kan ind i Himlen see;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "En yndig lille Rosenknop er Munden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Vorherre, lad mit Hjertes Tanke skee!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
