  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Du lille Nisse med Huen rød,",
      "part": false,
      "marginal_notes": [
        "Speaker: Kokkepigen:"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Du skal ogsaa have din Julegrød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Der er ingen Nisse, lad Dig sige! -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Da smiled den gamle Kokkepige:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Han bor i Kjælder, i Stald, paa Kvist,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "den Skjelm, han stjal mig dog Pølsen sidst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Og Grøden blev ned i Stalden sat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Da listed fra Kjøkkenet Husets Kat. -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Den næste Morgen den Gamle kom",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "og raabte, da hun fandt Skaalen tom:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Hvo uden Nissen kan Grøden spise!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "- Da maatte Katten i Krogen fnise.",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
