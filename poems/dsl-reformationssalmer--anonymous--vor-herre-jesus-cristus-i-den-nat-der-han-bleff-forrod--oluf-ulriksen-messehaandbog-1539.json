    {
      "id": 0,
      "stanza_id": 0,
      "text": "VOr herre Jesus cristus i den nat der han bleff forrod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Tog han brød tackede oc brøt det oc gaff sine discipler oc sagde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Tager det hen oc ederit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Det er mit legomme som giffuis for eder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "det gører i myn hukommelse.",
      "part": false,
      "marginal_notes": []
    }
  ]
