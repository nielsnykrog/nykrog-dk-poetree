  },
  "body": [
    {
      "id": 0,
      "stanza_id": 3,
      "text": "»Halleluja!« sang Englehæren,",
      "part": false,
      "marginal_notes": [
        "Speaker: CHOR"
      ]
    },
    {
      "id": 1,
      "stanza_id": 3,
      "text": "»Gud i det Høie, ene Æren,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 3,
      "text": "Fred for hvert Hjerte, som har blødt!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 3,
      "text": "Paa Sorgens Hav jeg øiner Arken,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 3,
      "text": "Jeg veed med Hyrderne paa Marken,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 3,
      "text": "I Dag er os en Frelser født.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 4,
      "text": "Straa i Krybben var hans Leie,",
      "part": false,
      "marginal_notes": [
        "Speaker: DUET"
      ]
    },
    {
      "id": 7,
      "stanza_id": 4,
      "text": "Ei hans Rigdom vi opveie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "Hele Himlen er hans Eie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "Liv han kalder frem af Død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "Stjernen var hans Fødsels Kjærte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 4,
      "text": "Født i Armod og med Smerte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 4,
      "text": "Diende ved Moder-Hjerte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "Livets Savn og Fryd han lærte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "Syndens Aag han sønderbrød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 5,
      "text": "Vil ei Sorgens Sky sig fjerne,",
      "part": false,
      "marginal_notes": [
        "Speaker: CHORAL"
      ]
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "Tænk paa Jesu Fødsels Stjerne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "I et Nu, jo den oprandt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "Maa i Sorg og Savn Du sukke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 5,
      "text": "Husk, en Krybbe var hans Vugge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Han, som Himlens Throne vandt.",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
