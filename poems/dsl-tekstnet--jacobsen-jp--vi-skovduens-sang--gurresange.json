  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Gurresange",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1886,
    "url": "https://tekstnet.dk/books/jacobsen-jp_gurresange/006/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Samlet paa Flugt over Ø, –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Kommer! lytter!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Død er Tove! Nat paa hendes Øje,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Stille er hendes Hjerte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Men Kongens vugger vildt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Dødt og dog vildt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Sælsomt lig Baad paa Vove,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Snekkens Styrer – ligger død, hildet i Dybets Tang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Ingen bærer dem Bud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Ufør er Vejen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Som tvende Strømme vare deres Tanker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Hvor rinde nu Toves Tanker?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Kongens i sælsomme Bugter sig vride,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Søgende Toves,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Finder dem ikke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Kisten saa' jeg paa Kongens Skuldre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Henning den støtted';",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Mørk var Natten, en enkelt Fakkel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Lyste i Gyden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "Skjalv for sin Hævn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "Taarer, som ikke græde hun vilde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "Funkled' i Blik.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "Vide fòr jeg, Sorg mig sanked', meget jeg saa'!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "Kjøre med Kisten,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "Gangeren, som ham bar til Sejer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "Maatte den drage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "Vildsomt vankede Kongens Øje",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "Sælsomt lyttede Kongens Hjerte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "Efter et Ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "Henning talte Ord til Kongen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "Blik og Hjerte søgte dog end.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "Stirrer og lytter med bedende Læbe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 0,
      "text": "Tove er tavs.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 0,
      "text": "Vide fòr jeg, Sorg mig sanked', meget jeg saa'!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 0,
      "text": "Munken vilde Rebet drage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 0,
      "text": "Men han saa' paa Kjøresvenden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 0,
      "text": "Sorgens Rune til ham talte;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 0,
      "text": "Solen sank til Klang, som lyder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 0,
      "text": "Over Jordens Døde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 0,
      "text": "Helvigs Falk",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 0,
      "text": "I Kongegaarden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 0,
      "text": "Gurres Due slog.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
