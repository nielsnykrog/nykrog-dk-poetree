  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Høit paa Grenen Fuglen gynger;",
      "part": false,
      "marginal_notes": [
        "Speaker: ELSKEREN"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Hører dog hvor smukt den synger!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Qvidrer lystigt hvad den veed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Synger om min Kjærlighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Nævner over tusind’ Gange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Hendes Navn i sine Sange;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Hjertet finder atter Ro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Thi jeg veed, hun er mig tro!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Nei, fra Reden blev jeg skræmmet,",
      "part": false,
      "marginal_notes": [
        "Speaker: FUGLEN"
      ]
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Der er Bryllup nu i Hjemmet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Bruden var Din Hjertenskjær –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Du forstaaer mig ikke her!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Budskab den fra hende bringer.",
      "part": false,
      "marginal_notes": [
        "Speaker: ELSKEREN"
      ]
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "O, saa saligt sødt det klinger!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Mig hun seer paa Tankens Strøm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Og i hendes bedste Drøm!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "– Brud og Brudgom sad nu sammen;",
      "part": false,
      "marginal_notes": [
        "Speaker: FUGLEN"
      ]
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Der var Lystighed og Gammen!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Smukt om Troskab blev der talt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Men om Dig ei Talen gjaldt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Gud, til Dig jeg Tak vil sende!",
      "part": false,
      "marginal_notes": [
        "Speaker: ELSKEREN"
      ]
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Fader, ja, Du gav mig hende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Hun min første Kjærlighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "Min i Tid og Evighed!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Lille Fugl, løft glad din Vinge!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Hilsen du til hende bringe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Du om Troskab synge maa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "Ogsaa hun vil dig forstaae!",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
