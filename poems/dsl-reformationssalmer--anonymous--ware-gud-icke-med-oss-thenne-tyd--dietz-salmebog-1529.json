  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "WAre Gud icke med oss thenne tÿd/",
      "part": false,
      "marginal_notes": [
        "Exod. xiiij."
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "saa skal Jsrael sige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Ware Gud icke med oss thenne tÿd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "wÿ hadde lid angist oc qwide/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Gud saa the Christne store oc smaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "aff mange wantro foractis saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "ther thennom monne saare forfølge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "The menniske ere ÿ hw saa wrede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "the reese thennom mod oss alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Saa leffuendis hadde the sunckit oss nedder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "med oss /",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Wor siæl hun gick igiennom thet wand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "wÿ hadde forsunckid alle mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "hadde Gud icke med oss wærid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Benedidet wære Herren ther oss ey gaff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "vnder theris tender fangne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "alt som een fwl ther snaren kommer aff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "saa er wor siæl vndgangen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "then snare er brøsten/ oc wÿ ere frÿ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "wor herris naffn thet staar oss bÿ:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Som haffuer skapt himmel oc iorden.",
      "part": false,
      "marginal_notes": [
        "Gene. j."
      ]
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Aere wære teg Gud ÿ ewighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "wor fader lodst tw teg kalle/",
      "part": false,
      "marginal_notes": [
        "Math. vj."
      ]
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "begaffue oss med thÿn miskundhed:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "wÿ bede tw oss ey vndfalle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Then ære thÿn søn skall wære lÿg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "fraa nw oc ind til ewige tÿd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Then Helliaand ey fraa skillies.",
      "part": false,
      "marginal_notes": []
    }
  ]
}