    "year_published": 1562,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/LNGK24.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Edell, Skønn, tucktiig, oc Dÿdelig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Trofast, Och | ere-riig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Er thennd ther meg haffuer loffuitt | oc sagtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "att holde mett sandenn aff alldh | hinndis agtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "hinndis wiillig thro thienner | Ieg were wiill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "i lenger oc meer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "haffuer hun | mitt hiertte i machtt oc wolld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Thij ønsker | Ieg hinnde lÿckenn hundritt maall tuszinfold. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Hunn er thennd ther meg kannd gledenn sennde, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Oc alld minn Sorrig bortt fraa meg wennde, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Mett hinndis fornumstig oc frÿnttlighe thale, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "kannd hunn mitt hiertte saa well husuale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Thij | Er mitt hiertte saa kommerfuld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Som Edell-Stene | the ere for guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Ieg haffuer hinde kier | for-wdenn suig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Christ giffue hinnde Gleden | Euinndeligh. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Thett siste sinnde wij skildis att,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "med lidenn | , Glede, Suck, Sorrig, oc Graad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "hunn loffuitt meg wenskab mett hannd oc munnd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Iegh | Giorde oc saa wdj samme stunnd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Thij wiill | Ieg holde huad Ieg haffuer hinnde tillsagtt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Bode dag oc natt, hinndis daglig farffue |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "thennd wiill Ieg bere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "hunn er blantt skøne | Iomfruer enn Ere. |",
      "part": false,
      "marginal_notes": []
    }
  ]
}