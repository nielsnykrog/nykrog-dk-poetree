{
  "id": null,
  "title": "Sallemand dør af Elskov",
  "year_created": [
    1560,
    1562
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Langebeks kvart",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1562,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/LNGK3.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "HEr Salemand er thend Skønniste | Swennd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "frw Mette-lile heder thænd froe, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Thi hagde huer-anndenn i hiertett saa kier,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "for | god willge the tilsammen droe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: I wider thet saa | well, her Salemand døde wdaff elskow:. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Her Salemand hagde en morsøster,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "hunn | heder frw Inngeborrig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Till hinde riider | her Salemand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Oc klaffuer for hinde sin sorriig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": ":: I wiider thett saa well. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Thet waar her Salemand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "hand kom | ther riidenndis i gaard:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Wde staar hans MorSøster,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "hun wor well Swøbtt i maar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": ":: I wider | thett saa well att her Salemand døde aff elskow | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Wer thw well-kommen her Salemand |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "kierre Søster-sønn min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "Gack thw thig i høgiitt-Lofftt | ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "thw dricker thennd klare win",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": ":: I wider:. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "Thet waar Herre Salemand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "hand gaar paa | Sallenn att stannde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "Thett wor hans kierre morsøster,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "hun skencker hannom vinen thill hende |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "Hør thw herre Salemand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "meden wi erre | ene thwo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "Er ther ingenn i werdenn thiill, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "alltt ther thin hug ligger aa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": ":: I wider: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": "Ther er ingen i werden tiill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "alltt ther | min hug ligger paa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "for-wthenn hin Stoltenn | frw Mette-lill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "Oc hinde kand ieg icke faa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 7,
      "text": "Hør thw her Salemand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 7,
      "text": "thw tør thet | icke troe:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "I ere allt thwo sÿdskenn-børn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 7,
      "text": "I | maa icke thilszammen boe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": ":: I wider thett saa: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 8,
      "text": "Heder hun icke frw Mette-lill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 8,
      "text": "Som forLøsse maa minn Quide:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 8,
      "text": "da skall aldrig nogen | werre thill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 8,
      "text": "ther ieg skall legge hoss min side:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 8,
      "text": ":: I wider | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 9,
      "text": "Heder hun icke frw mettelill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 9,
      "text": "Som forløsze minn harm:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 9,
      "text": "daa skall ther aldriig noghenn | werre thiill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 9,
      "text": "ther ieg skall legge vdj arm:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 9,
      "text": ":: I wider: | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 10,
      "text": "Hør tw herre Salemand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 10,
      "text": "lad fare bort | anngist oc Quide:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 10,
      "text": "I Lader ether breffue thiill | Romme schriffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 10,
      "text": "thett i maa well tilsamen bliffue |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 11,
      "text": "I fruer i kunde Saa mange Suincke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 11,
      "text": "Som | bønnder ther age thill thorre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 11,
      "text": "Ieg wed thend icke verdenn thill.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 11,
      "text": "Ieg will icke forklaffue min sorige |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 12,
      "text": "Thet waar herre Salemand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 12,
      "text": "hand lader, the | Lønne-breff schriffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 12,
      "text": "Sennder hand thennom op | aff Land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 12,
      "text": "frw Mette-lill lader hand thennem giffue |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 13,
      "text": "Hun schreff hannom ett anditt egien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 13,
      "text": "thett | sennde hun hannem mett sin terne:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 13,
      "text": "I-huor | hannd willde i werdenn fare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 13,
      "text": "hun willde mett | følge saa gerne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 13,
      "text": ":: I wider thett saa well | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 14,
      "text": "Saa lader hand sin snecke skiibe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 14,
      "text": "alltt | baade skøtt oc bratt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 14,
      "text": "Saa lagde thi fraa landitt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 14,
      "text": "thennd anden pintze-natt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 14,
      "text": ":: I wider | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 15,
      "text": "The wunde op theris silcke-Segell",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 15,
      "text": "saa høgt | i forgylldenne raa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 15,
      "text": "Saa seiglett the till paris, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 15,
      "text": "minndre end maanede tho",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 15,
      "text": ":: I wider | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 16,
      "text": "Thett waar her salemand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 16,
      "text": "hand lagde for | paris Innd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 16,
      "text": "alle the klocker i stadenn worre |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 16,
      "text": "the ginge emod hanom egien |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 17,
      "text": "Ver i well-komen her salemand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 17,
      "text": "huor | haffuer i fangitt thend frue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 17,
      "text": "her er kommen | breff fraa Sonnen Aa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 17,
      "text": "I maa icke thilsammen | bliffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 17,
      "text": ":: I wider thett saa well | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 18,
      "text": "Herre Gud raade mig sagde her salemannd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 18,
      "text": "Saa well Ieg thend froe maa wnnde: |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 18,
      "text": "Saa sprack hanns hiertte i stÿcker vij:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 18,
      "text": "Oc blodiitt | randt aff hans munde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 18,
      "text": ":: I wider | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 19,
      "text": "Ther waar sorriig i fruer-stuen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 19,
      "text": "Och | alle the Iomfruer the grede:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 19,
      "text": "frw Mette-lill døde i | høgiitt-lofftt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 19,
      "text": "her salemand i thett | strede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 19,
      "text": ":: I wiider thett saa well | att her salemand hand døde vdaff Elskove | ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}