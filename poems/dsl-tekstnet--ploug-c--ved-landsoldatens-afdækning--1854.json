    "place": null,
    "year_published": 1854,
    "url": "https://tekstnet.dk/books/ploug-c_ved-landsoldatens-afdaekning/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Det var i Nattens mørke Time",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "De Kæmper herfra drog ud;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Men højt paa Himmelen Solen stod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Da kom de med Sejersbud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Det donned over Strand, det lysned over Land, og aldrig det glemmes.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Dengang de løfted det tunge Værge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Var Danmarks Skæbne saa strid;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Dengang de svunge den Bøgegren,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Det fejred Skærsommer blid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Det donned over Strand o. s. v.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Hvordan de kæmped, hvordan de sejred,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Og Hvo der i Striden faldt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Hver mandig Gjerning, hvert Offer skjønt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "- Det er nu en Saga Alt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Det donned o. s. v.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Den Saga bærer saa godt et Vidne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Om Hjertet i menig Mand;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Thi han beviste hin Julinat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Hvor højt han elsked sit Land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "Det donned o. s. v.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "Det var ikke Andres Bud og Bønner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "Der drev ham i Slaget frem;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "Det var ham selv, der søgte sit Maal",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "Og hentede Sejren hjem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "Det donned o. s. v.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "Det var ham selv, som vilde hævne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "Al Danmarks Smerte og Nød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "Ham selv, der fejede Marken ren",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "Og trodsede Saar og Død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "Det donned over Strand, det lysned over Land og aldrig det glemmes.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "Men Folket, for hvem han stred og blødte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "Det skænker ham nu hans Løn;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 0,
      "text": "Det rejser som Sejersmonument",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 0,
      "text": "Et Billede af sin Søn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 0,
      "text": "Det melder over Strand, det sjunger over Land hans Hæder og Ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 0,
      "text": "Se, her skal Han nu staa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 0,
      "text": "Mens Tiderne forgaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 0,
      "text": "Saalænge danske Hjerter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 0,
      "text": "For Danmarks Ære slaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 0,
      "text": "Just som han stod og gik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 0,
      "text": "I al sin Dragt og Skik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 0,
      "text": "Med Alvor i sin Mine",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 0,
      "text": "Og med Glæden i sit Blik;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 0,
      "text": "Saa mandig i sit Legem, som barnlig i sin Sjæl,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 0,
      "text": "Med Løvet over Hoved og Byttet under Hæl,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 0,
      "text": "En Sejerherre stolt - den tappre Landsoldat!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 0,
      "text": "Hurra, Hurra, Hurre!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 0,
      "text": "Og som han her staar skabt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 0,
      "text": "I Skjønhed og i Kraft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 0,
      "text": "I Ungdom, der ej ældes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 0,
      "text": "I Liv, der ej gaar tabt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 0,
      "text": "Den Stamme sund og prud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 0,
      "text": "Af hvilken han sprang ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 0,
      "text": "Skal trives og skal skyde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 0,
      "text": "Mange tusind nye Skud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 0,
      "text": "Af hver en Dreng, som stammer vort Sprog paa Moderskød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 0,
      "text": "Af hver en Knøs, som lærer at stræbe for sit Brød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 0,
      "text": "Der voxer op engang en tapper Landsoldat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 0,
      "text": "Hurra, Hurra, Hurra!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 0,
      "text": "Og det er Danmarks Trøst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 0,
      "text": "Naar bange gaar dets Bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 0,
      "text": "Fordi en Fare drager",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 0,
      "text": "Sig sammen om dets Kyst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 0,
      "text": "At har det Sønner faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 0,
      "text": "Saa kan det stole paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 0,
      "text": "At hver og een har Vilje",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 0,
      "text": "Til for Moderen at slaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 0,
      "text": "Er Dronning Thyras Gjerde i Grus end sunket hen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 0,
      "text": "Af blanke Bajonetter det rejses kan igjen:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 0,
      "text": "Vort Dannevirke er - den tappre Landsoldat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 0,
      "text": "Hurra, Hurra, Hurra!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
