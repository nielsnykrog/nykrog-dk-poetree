{
  "id": null,
  "title": "Jeg har en ven i mit hjerte kær",
  "year_created": [
    1570,
    1573
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Langebeks kvart",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1573,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/LNGK42A.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Yeg haffuer enn yomffru y medtt hyertte ker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Chrest gyffue, dett gar meg thell gode;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "yeg saffuer, yeg wager, y-huadtt yeg gor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "stesse leger hun meg y huffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Nar yeg yng om døren ttren,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "yeg acktted mynn aller-kerreste att fynde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "mynn øgen saa fast om hussett gar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "aldtt om hun er der-ynde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Hunn sprynger for meg wdy enn dans,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "hunn sken som enn marrygenn-stryenne;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "mytt hyertte er ttussen fryde-fuldtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "myn øgen ser henne gerne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Maatte yeg hoss mynn aller-kerreste sede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "aldtt hoss hennes smalle syde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "aldryg skulle wentter werre saa kall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "att meg skulle dett forttryøde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "War yeg thy tussen gyøllen ryg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "dem welle yeg der-thell gyffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "att yeg motte fynde mynn aller-kerrest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "och och ydelyg hoss henne blyffue.",
      "part": false,
      "marginal_notes": []
    }
  ]
}