{
  "id": null,
  "title": "† Adam Oehlenschläger",
  "year_created": 1850,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Carl Ploug",
    "country": null,
    "wiki": "Q347860"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1850,
    "url": "https://tekstnet.dk/books/ploug-c_adam-oehlenschlaeger/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "\"Skjaldenes Adam\" or død! \"Det nordiske Sangriges Konning\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Bøjed sit Hoved træt; Plektret faldt ud af hans Haand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Naar han rørte med det de liflig tonende Strenge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Lyttede Land og Hav, bævede Nordens Natur;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Granerne susede blidt, og Fossen rislede sagte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Huldren sukkede ømt, Jutulen græd som et Barn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Elverpigernes Ring sig løste paa dugvaade Tillie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Blomsten duftede stærkt, Bølgerne aandede dybt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Menneskens Hjerter svam i stille Fryd som Naturen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Rørtes, kvægedes mildt, aned et højere Liv, -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Det var hans Herskermagt; nu er den brudt som hans Øje:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Derfor er Landesorg over det tredelte Nord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Til Østens Væld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Til Morgenrødens Straaler",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Paa Ungdomsvinger fløj hans Sjæl",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Og øste Guld deraf i fulde Skaaler.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "I Sprogets Schakt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Nedsteg han dristig ene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Og hented op dets skjulte Pragt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "De klare Perler, farverige Stene;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Og undrende hans Samtid stod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "Da ud han strø'de Alt med ødselt Mod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Med uvant Haand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Han Tryllelampen hæved,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Og bød som Herre Lampens Aand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Udrette villig, hvad hans Villie kræved.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Den bygged op",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Ham Slotte uden Lige;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Thi Stjerner krone deres Top,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "Men Grunden favner Hjertets dunkle Rige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "De rejste sig en Sommernat;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "Men de skal staa, til Tidens Maal er sat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "I Glemsels Mørke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "Laa gamle Norden;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "Kæmpernes Styrke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "Smuldred i Jorden;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "Gudernes Himmel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "Var tom og død;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "Dækket af Skimmel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "Var Suttungs Mjød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "Da saa' i Natten",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "Med klare Blikke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "Han Fafnerskatten",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "Funklende ligge;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "Da vog han Dragen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 4,
      "text": "Med Guddomskraft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 4,
      "text": "Og drog for Dagen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 4,
      "text": "Hvad der var tabt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 5,
      "text": "Af Gravens Kammer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 5,
      "text": "Gik Mænd i Brynjer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 5,
      "text": "Thor med sin Hammer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 5,
      "text": "Milde Asynjer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 5,
      "text": "Med Skjoldglands hæved",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 5,
      "text": "Sig Valhals Tag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 5,
      "text": "- Oldtiden leved",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 5,
      "text": "I Harpeslag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 6,
      "text": "Og Sangens Bue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 6,
      "text": "Steg over Jorden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 6,
      "text": "Med syvfolds Lue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 6,
      "text": "Smelted den Norden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 6,
      "text": "De bittre Minder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 6,
      "text": "Faldt ned som Regn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 6,
      "text": "Og Buen skinner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 6,
      "text": "Som Pagtens Tegn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 7,
      "text": "\"Ved Askens Grene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 7,
      "text": "\"Paa Ida-Sletten",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 7,
      "text": "\"Skal gjenforene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 7,
      "text": "\"Sig Asaætten\":",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 7,
      "text": "Saa Vala kvæder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 7,
      "text": "Saa Nornen vil",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 7,
      "text": "Hans Sangerhæder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 7,
      "text": "Er Ygdrasil.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 8,
      "text": "Hvad der hvisker, hvad der klager",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 8,
      "text": "Inderst i en Kvindes Hjerte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 8,
      "text": "Hvad der binder, hvad der drager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 8,
      "text": "Kjærlighedens Fryd og Smerte -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 9,
      "text": "Sødt det fra hans Harpe toned:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 9,
      "text": "Kvindens Liv, det dybe, stille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 9,
      "text": "Underfuldt i ham forsonet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 9,
      "text": "Var med Mandens Kraft og Smile.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 10,
      "text": "Signes Digter, Valborgs Sanger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 10,
      "text": "Danmarks Stolthed, Nordens Hæder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 10,
      "text": "Evighedens Løn nu fanger;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 10,
      "text": "Men ved Graven Kvinden græder.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
