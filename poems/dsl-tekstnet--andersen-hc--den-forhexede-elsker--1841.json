  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Flyv, ja flyv I sorte Fugle! reis herfra med Gud;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Men tag Hilsener med Eder til min unge Brud! –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "I Athen, der hvor jeg fødtes, saae I Ly og Læ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "I vor Gaard, tæt op til Porten, groer et Æbletræ;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Der i Træets grønne Grene, sid og syng I Smaae!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Hende, som jeg ene elsker, der I sige maae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Hun mig ei tør vente – ak! jeg veed, hvor hun har grædt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Da jeg kom fra Hjemmet, blev jeg Slave, siig kun det:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Jeg har ægtet Enkens Datter, Hexens Datterlille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Hun som Floderne forhexed’, – ei de rinde ville,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Hun som har forhexet Havet, – Skibene staae stille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Hun, som har fortryllet Brønden, – Vandet vil ei frem, –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Ogsaa mig hun har forhexet, ei jeg seer mit Hjem! –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Vil jeg til det, strax paa Flugten Regn og Snee jeg har,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Vender jeg da om til Hexen, skinner Solen klar.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
