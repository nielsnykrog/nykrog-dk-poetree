  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Alleniste Gud i Himmerig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "være loff oc priss for alle sin naade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Herren være met eder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 2,
      "text": "Oc met din Aand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 3,
      "text": "Lader oss alle Bede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 4,
      "text": "O Herre etc.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 5,
      "text": "Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 6,
      "text": "Epistelen bescriffuer oss Sancte Poffuel til de Corinther.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 7,
      "text": "Kiere Brødre etc.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 8,
      "text": "Comma et Colon.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 9,
      "text": "Periodus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 10,
      "text": "Periodus alia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 11,
      "text": "Quæstio.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 12,
      "text": "Finale.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 13,
      "text": "Herren være met eder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 14,
      "text": "Oc met din Aand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 15,
      "text": "Disse effterfølgendis Ord bescriffuer oss den hellig Lucas Euangelista.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 16,
      "text": "Gud være loffuit for sit gladeligt budskab.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 17,
      "text": "Comma et colon.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 18,
      "text": "Periodus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 19,
      "text": "Periodus in monosyllabis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 20,
      "text": "Quæstio.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 21,
      "text": "Finale.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 22,
      "text": "Lader oss bede/ Fader vor du som est i etc.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 22,
      "text": "Vor Herre Jesus Christus i den nat etc.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 23,
      "text": "Herren være met eder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 24,
      "text": "Oc met din Aand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 25,
      "text": "Wi tacke dig Herre almectigste euige Gud etc.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 26,
      "text": "Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 27,
      "text": "Herren være met eder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 28,
      "text": "Herren Velsigne dig oc beuare dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 28,
      "text": "Herren liuse sit Ansict offuer dig oc være dig naadig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 28,
      "text": "Herren lette sit Aasiun paa dig/ oc giffue dig Fred.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 29,
      "text": "Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 30,
      "text": "O Menniske tenck paa Jesu død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 30,
      "text": "Som dig haffuer frelst aff Synd oc nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 30,
      "text": "For Adam hand haffde ilde giord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 30,
      "text": "J Paradiss brød vor Herris ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 31,
      "text": "VIdit et vt vidit peruerso lumine Momus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 31,
      "text": "Tam pulcrum eximij forte laboris opus:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 31,
      "text": "Quorsum inquit, parui precij, mediocris opellæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 31,
      "text": "Nullius ingenij, res iterare leues?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 31,
      "text": "Legit at hoc idem, et penitus lecto, arbiter æquus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 31,
      "text": "Omnia Musarum numina testor, ait:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 31,
      "text": "Non melius forma, præstantius ordine, maius",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 31,
      "text": "Iudicio quicquam hoc prodijt in genere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 31,
      "text": "Andreas Seuerinus V.",
      "part": false,
      "marginal_notes": []
    }
  ]
}