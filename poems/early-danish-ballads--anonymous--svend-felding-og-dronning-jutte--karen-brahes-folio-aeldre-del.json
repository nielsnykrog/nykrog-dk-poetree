{
  "id": null,
  "title": "Svend Felding og Dronning Jutte",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA31.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Dett wor daner-kongen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hand taller tell suene tho:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "\"Beder y her Suend Feldinig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "y stoffuen ind for meg gaa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: Fører y wor vnge droning ind till Danmarck. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Ind kaam her Suend Fellding,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "och stedis hand for buor:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "\"Huad well y, daner-kongen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "huy haffuer y sendt meg ord?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "\"Hør thu, her Suend Felding,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "thu est en rider med erre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "thu skall ind till Bede-land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "hiente meg en hiarttens-kier.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "\"Skall ieg ind till Beddere-land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "och hientte eders hiarttens-kere:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "saa men wed, daner-kongen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "ieg kand icke iene faare.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "\"Saa men wed, her Suend Fellding,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "du skallt icke ienne faarre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "ieg laner theg errke-bespen aff Skaane,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "hanom følger saa stuor en skaar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Deg føllger ercke-bespen aff Skaane",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "och ter-till rider IX:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "saa men wed, her Suend Felding,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "du mat well lide paa dy.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Saa wand thi op derris silcke-segell",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "med deris forgyldene flyø:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "saa seglett dy till Bedere-land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "mynder ind maneter thre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Kaste dy derris acker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "paa den huide saand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "thett wor her Suend Felding,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "hand trend ther først y land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Mett vdj den borig-gard",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "der axler dy skaarlagen-skiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "saa gaar dy y hyffue-lofft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "for Bedder-lantz konngen ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Dett wor her Suend Felding,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "hand ind at døren trend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "thett wor beder-konning,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "hand recker hanom huiden hand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "\"Her sieder y, beder-koning,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "y och etters kerre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "myn edlig herre aff Danmark",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "beder om ehters datter metet erre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "\"I eddellig herre aff Danmark",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "y kand well føffue eters ord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "legger y aff etters skaarlan,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "y ganger med meg tilbordts.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "\"Wy legger icke neder wor skaarlagen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "wy ganger icke tilbord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "førrind ethers nade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 12,
      "text": "wider osz ansuar-ord.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "\"Leger neder eders skarlagen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "och ganger met meg tilbords:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "bider her til y morgenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 13,
      "text": "ieg wider eder ansuar-ord.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Der luo dy y monethter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "och der luo di y moneter thre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "dy kunde icke frøcken Iyttelild",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 14,
      "text": "for deris øgen sie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "Børren bleser saa mildelig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "och byller leger paa saand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "thi edlig herer aff Danemark",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 15,
      "text": "dy ganger for kongen att staande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "\"Børenn bleser saa mildellig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "och skibben tager til att skridde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "myn herre, y wider osz ansuar-ord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 16,
      "text": "wy kand icke lenger bide.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "Dett wor beder-koning,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "hand thaller til rider thuo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "\"Bedder y myn kerr datter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 17,
      "text": "y stoffuen ind for meg gaa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "Ind daa kaam dy rider thuo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "och stedis thi for bord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "\"Stander op, frøken Iyttelild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 18,
      "text": "ethters fader haffuer send ether ord.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "Dett melltte frøckenn Iiuttellid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "hun suaritt saa blidlig tiell:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "\"Rad thett Gud-fader y Hiemerrig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 19,
      "text": "y-huad myn fader hand weell.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "Dett war silcke och skarlagen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "dy paa iordenn bred:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "thett wor frokenn Iiuttelild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 20,
      "text": "hun bleff der-offuer lied.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 21,
      "text": "Dett war frøcken Iyttelild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "hun ind att døren thrend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 21,
      "text": "dy edlig rider aff Danemarck",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 21,
      "text": "dy stander hender op igenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 22,
      "text": "Dy edellig rider aff Danmarck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 22,
      "text": "dy stander hinder op igenn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 22,
      "text": "thett war herre Suend Felding,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 22,
      "text": "hand recker hender huiden haand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 23,
      "text": "Frem gaar frøckenn Iiutelild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 23,
      "text": "och stedes hun for bord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 23,
      "text": "\"Huad well y, myn kerr fader,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 23,
      "text": "huj haffuer y sendt meg ord?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 24,
      "text": "Dett melltte herre Suend Feldding,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 24,
      "text": "første hand bruden saae:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 24,
      "text": "\"Skam daa faa dyn hender,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 24,
      "text": "och der dyn øgen skuld thuo!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 25,
      "text": "\"Hor du, myn kerr datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 25,
      "text": "herre Gud haffuer bewist deg erre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 25,
      "text": "du skallt ind til Danmarck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 25,
      "text": "den danske droning at werre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 26,
      "text": "Tthett suaritt frøckenn Iiuttelild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 26,
      "text": "och hinder rand tharre paa kiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 26,
      "text": "\"Skall ieg y aar til Danmarck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 26,
      "text": "saa longt fra moder min?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 27,
      "text": "Op stuod beder-konning,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 27,
      "text": "hand axller skarlagen-skiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 27,
      "text": "hand gaff bortt frøcken Iiutelild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 27,
      "text": "aller-kereste datter synn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 28,
      "text": "Frem gick herre Suend Felding,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 28,
      "text": "hand tager hinder y synn faffuen:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 28,
      "text": "\"Myn herre och Danmarcks krone,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 28,
      "text": "thett skall gaa etter till gaffuen.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 29,
      "text": "Saa giorde dy thett geste-buod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 29,
      "text": "well y dage thre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 29,
      "text": "dy edlig rider aff Danemark",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 29,
      "text": "dy gledis y alle dy.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 30,
      "text": "Dett war silcke och skaarlagen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 30,
      "text": "thett bleff paa iorden bred:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 30,
      "text": "thett war frøcken Iiuttelild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 30,
      "text": "hun bleff till stranden lidd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 31,
      "text": "Dett wor herre Suend Felding,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 31,
      "text": "hand tog hinder y syn faffuen:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 31,
      "text": "saa løffte hand frøcken Iiutte land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 31,
      "text": "y forgyldene staffuen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 32,
      "text": "Saa wonde dy op deris sillcke-seggell",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 32,
      "text": "med deris forgyldene flyøff:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 32,
      "text": "saa seglet di till Danmarck",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 32,
      "text": "minder ind maneter tho.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 33,
      "text": "\"Wy well tage frøckenn Iuthtelild",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 33,
      "text": "och døbe hinder vdde for staffuen:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 33,
      "text": "wy kalder hinder frøcken Iiulan,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 33,
      "text": "thett er ett hallff feeder naffuen.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 34,
      "text": "Tthett suaredt frøcken Iiuttelild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 34,
      "text": "och saa tog hun oppa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 34,
      "text": "hun suarit da her Suend Felding,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 34,
      "text": "hun bleff y hoffuen saa muod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 35,
      "text": "\"Tthett er alldrig saa arrig en skalck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 35,
      "text": "haffuer hand tho broggitt erme:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 35,
      "text": "komer hand ind til Bederland,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 35,
      "text": "dy kalder hanom io wer en herre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 36,
      "text": "\"Dog er thett alldrig saa arrig en wyff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 36,
      "text": "haffuer hun en sprungitt huffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 36,
      "text": "komer hun ind til Danemarck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 36,
      "text": "dy kalder hinnder io were en frue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 37,
      "text": "Denn kurre hand stander paa Københaffuens husz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 37,
      "text": "och sier hand vd saa wid:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 37,
      "text": "\"Ieg sier saa mangen Bederlands skib,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 37,
      "text": "førre forgyldene flyø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 38,
      "text": "Ieg serr saa mange Bedderland skib,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 38,
      "text": "dj stunder til Danmarcks land:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 38,
      "text": "Chrest segne eder, ionckeren aff Danemark,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 38,
      "text": "dy well eder alle till hand.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 39,
      "text": "Tthett wor herre Suend Felding,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 39,
      "text": "hand styrer sin skib for lannd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 39,
      "text": "thett wor iunkeren aff Danemark,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 39,
      "text": "hand rider paa huiden sannd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 40,
      "text": "Tthett wor her Suend Felding,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 40,
      "text": "hand wøffter med syn hatt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 40,
      "text": "\"Min herre, y sprenger icke ørrsz i dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 40,
      "text": "wy haffuer icke ind fryden faatt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 41,
      "text": "Kaaste dy derris acker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 41,
      "text": "paa den huiden sannd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 41,
      "text": "tog dy frøkenn Iiuttellild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 41,
      "text": "dy løfft hinder først y land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 42,
      "text": "Tthett wor frøckenn Iiuttelild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 42,
      "text": "hun threend ther først y land:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 42,
      "text": "frem gaar daner-kongen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 42,
      "text": "hand recker hind huiden hand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 43,
      "text": "Tther bleff silcke och skaarlagen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 43,
      "text": "thett bleff paa iorden bred:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 43,
      "text": "thett wor frøcken Iiuttelild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 43,
      "text": "hun bleff till slottett lied.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 44,
      "text": "Tthett meltte frøckenn Iiuttelild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 44,
      "text": "thett første hun brud-husen suo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 44,
      "text": "\"Skaam faa alle thj themermeend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 44,
      "text": "som her lagd wiend paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 45,
      "text": "Skam faa alle thj themermend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 45,
      "text": "som her tog øll och mad:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 45,
      "text": "bød først och sidst her Suend Felding,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 45,
      "text": "hand war der radsmand for.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 46,
      "text": "\"Sttollperenn er alle aff egge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 46,
      "text": "tiellien er alle aff bøg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 46,
      "text": "thett er ett halleff ieder brude-husz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 46,
      "text": "ind deg sømer y att legge.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 47,
      "text": "\"Fuld wusenn maa ieg droning",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 47,
      "text": "y Danmark at were:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 47,
      "text": "skuld ieg nu bliffue saa suaritt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 47,
      "text": "aff ett barnn, der sleffred er.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 48,
      "text": "\"Inddog ieg er ett sleffred-barnn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 48,
      "text": "thett worder ieg at at lide:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 48,
      "text": "ieg suo rett aldrig nogen modders søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 48,
      "text": "ieg thuorde io fuld well lide.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 49,
      "text": "\"Suost du aldrig nogen modders søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 49,
      "text": "du thuord io fuld well bid:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 49,
      "text": "daa mød y morgenn y marcken vd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 49,
      "text": "ther skalt du dysten ridde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 50,
      "text": "Dett wor daner-kongen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 50,
      "text": "hand thog hinder y syn arum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 50,
      "text": "saa gaff hand frøckenn Iiutelild",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 50,
      "text": "guld-krone och droninge-naffuen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 51,
      "text": "Dett wor aarlig om morgen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 51,
      "text": "hun kreffuet hindis morgen-gaffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 51,
      "text": "\"Y giffuer meg her Suend Felding,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 51,
      "text": "ieg well icke andit haffue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 52,
      "text": "\"Ieg haffuer guld, och ieg haffuer sølff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 52,
      "text": "och der-til borig och feste:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 52,
      "text": "y faar icke aff myn guode mend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 52,
      "text": "som ride skall myn heste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 53,
      "text": "Ieg well giffue eder guld och sølleff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 53,
      "text": "och der-til borrig saa bolde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 53,
      "text": "selleff well ieg haffue min guode mend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 53,
      "text": "der-med myn land at holdde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 54,
      "text": "Thett wor aarlig om morgen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 54,
      "text": "der dagenn wor liusz:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 54,
      "text": "thett wor her Suend Felding,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 54,
      "text": "hand ganger till brude-husz.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 55,
      "text": "Tthett wor herre Suend Felding,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 55,
      "text": "hand kam y brude-husz:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 55,
      "text": "\"Myn herre, y lanner meg ørrsz i dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 55,
      "text": "ieg er til dyster fusz.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 56,
      "text": "\"Taa skall ieg lanne theg ganger graa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 56,
      "text": "leg hanom gylt saadell paa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 56,
      "text": "thett er well otte wienter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 56,
      "text": "siden hand wienter suo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 57,
      "text": "Tthett er well otte wentter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 57,
      "text": "siden hand suolen suo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 57,
      "text": "fuld well er dy XV,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 57,
      "text": "sidenn hanom kaam saadell paa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 233,
      "stanza_id": 58,
      "text": "Saa lieede dy vd den gamell graa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 234,
      "stanza_id": 58,
      "text": "lagd paa forgyldene miell:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 235,
      "stanza_id": 58,
      "text": "hans øgen dy gloffued som elluerstieen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 236,
      "stanza_id": 58,
      "text": "til hesten matt hand well lidde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 237,
      "stanza_id": 59,
      "text": "Tthett første reed, thi samell red,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 238,
      "stanza_id": 59,
      "text": "thi heelled war buode stercke:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 239,
      "stanza_id": 59,
      "text": "Suend Feldings suerd thett sønder gick,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 240,
      "stanza_id": 59,
      "text": "thett drøff saa langt y marck.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 241,
      "stanza_id": 60,
      "text": "Daa luo droning frw Iiutellild",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 242,
      "stanza_id": 60,
      "text": "op vnder hindis skaarlagen-skiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 243,
      "stanza_id": 60,
      "text": "\"Slig war alle myne meend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 244,
      "stanza_id": 60,
      "text": "ieg førde til Danmarck ind.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 245,
      "stanza_id": 61,
      "text": "\"Du bid meg, her Per kieempe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 246,
      "stanza_id": 61,
      "text": "du bide meg vd for by:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 247,
      "stanza_id": 61,
      "text": "imen ieg rider y staden ind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 248,
      "stanza_id": 61,
      "text": "och hienter meg ett sperd aff ny.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 249,
      "stanza_id": 62,
      "text": "Suend Felding hand ganger i kercken ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 250,
      "stanza_id": 62,
      "text": "hand lader seg wel berette:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 251,
      "stanza_id": 62,
      "text": "sa lader hand wie Guds legom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 252,
      "stanza_id": 62,
      "text": "y sitt spere-stage att sette.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 253,
      "stanza_id": 63,
      "text": "Lader hand wiee Guds legom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 254,
      "stanza_id": 63,
      "text": "lader sette y syn sperre-stage:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 255,
      "stanza_id": 63,
      "text": "saa snartt daa flyde den lieede throld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 256,
      "stanza_id": 63,
      "text": "som saad paa mandens bag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 257,
      "stanza_id": 64,
      "text": "Tthett andit red, thi samell red,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 258,
      "stanza_id": 64,
      "text": "thi hellid war bode stercke:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 259,
      "stanza_id": 64,
      "text": "thett wor her Pedder kempe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 260,
      "stanza_id": 64,
      "text": "hans halsz y sønder gick.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 261,
      "stanza_id": 65,
      "text": "Daa gred droning frw Iiutilild",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 262,
      "stanza_id": 65,
      "text": "op vnder hindis skarlagenn skiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 263,
      "stanza_id": 65,
      "text": "\"Fuld wusen kaam saa mange aff mine",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 264,
      "stanza_id": 65,
      "text": "her til Danmark ind.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 265,
      "stanza_id": 65,
      "text": ":: Førr y wor vnge droning ind til Danmarck. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}