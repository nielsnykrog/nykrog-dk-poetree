  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "I Kunstens Hal nu vaier Sorgens Fane,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Der, hvor din Rigdoms Karavaner drog.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Farvel! flyv hen, Du Sangens sjeldne Svane,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Du hævded’ Danmarks Navn og Danskens Sprog!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
