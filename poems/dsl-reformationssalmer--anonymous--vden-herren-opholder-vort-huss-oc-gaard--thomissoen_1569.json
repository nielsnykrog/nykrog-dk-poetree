  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Vden Herren opholder vort Huss oc gaard/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc skaffer huad der er inde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Oc sender sin benedidelse huert Aar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "at wi maa altid finde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "hans Guddoms gaffue gifft oc laan/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "som hand giffuer met sin milde haand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "ellers er vort arbeid forlaarit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Vden Herren selff den Stad beuarer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Oc vocter baade Land oc Rige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Oc met sin Guddoms mact forsuarer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Oc holder dem saa ved lige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Vden Gud giffuer selffuer naade oc fred",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Forgeffuis da vaage de Voctere ved/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "All konst oc raad monne falde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Thi seer til i som aarle opstaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Oc side om afftenen silde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Met sorrig arbeide oc stor vantro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Saa ville i giøre eder rige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Met kummer i æde det harmelig brød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Thi Gud sender sine baade klæde oc føde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Naar de monne sødelig soffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Seer eders Fruct oc Børn saa smaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "Dem haffuer Herren skabit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Alt effter sin euige Vissdoms raad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Oc eder met dem begaffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Hand vil oc dem saa vel forsee/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "At deris føde skal være til rede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Det skulle i selffuer befinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Ligeruiss som mange pile oc skud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "En Stridsmand haffuer i hænde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "Oc effter sin villie oc effter sit bud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "Monne dem forskiude oc sende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Saa giør oc Gud ved Quinde oc Mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "Aff atskillige Stæder oc fremmede Land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "Kommer hand dem vnderlig sammen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Vel er den Mand/ der Gud vil giffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "Slig vnge folck oc mange/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "At hand færdig oc rystig maa bliffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "Mod sine Fiender at stande/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "Naar hand taler met dem i Porte oc Taarn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "Da skal hand altid gaa dem tilforn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "Hand skal icke bliffue forhaanit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "Gud Fader oc Søn oc den hellig Aand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "Hannem bør oss alle at prise/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "At hand beuarer vort Huss oc Land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 6,
      "text": "Oc oss velsignelse beuiser.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 6,
      "text": "Hand styrcke vor tro oc kierlighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 6,
      "text": "At wi ey met wtacknemmelighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "Hans godhed skulde bortkaste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 7,
      "text": "Forgeffuis er alt arbeid oc kaast/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 7,
      "text": "naar Gud selff husit icke bygger/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 7,
      "text": "plat intet er Menniskens konst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 7,
      "text": "huo paa sin egen krafft ere trygge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 7,
      "text": "thi huilcken Stad/ Gud met sit raad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 7,
      "text": "ey selff hielper oc raader/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 7,
      "text": "mand giør der til ihuad mand vil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 7,
      "text": "det vist plat intet bader.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 8,
      "text": "Huad hielper det at wi aarle opstaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 8,
      "text": "Belade oss met stor møye/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 8,
      "text": "Vor anslag gaar ey til ey fra",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 8,
      "text": "End som Gud det vil føye/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 8,
      "text": "Endog dit Brød met sued oc nød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 8,
      "text": "J arbeide monne forhuærffuis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 8,
      "text": "Naar Gud ey vil velsigne til/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 8,
      "text": "Dit arbeid dig fordærffuis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 9,
      "text": "Vor Fader giør det saa allen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 9,
      "text": "At Landene vel regeris/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 9,
      "text": "Det see wi daglige huer oc en/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 9,
      "text": "Huor denne Hyrde ombæris",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 9,
      "text": "Huert Regiment bleff ilde endt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 9,
      "text": "Huor det end vaar høymectigt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 9,
      "text": "Gud naade Folck/ oc være Tolck/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 9,
      "text": "At troen ey forsmecter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 10,
      "text": "At Gud Menniskens børn forseer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 10,
      "text": "Aff hans Naade det monne være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 10,
      "text": "Hand opholder dem baade faa oc fleer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 10,
      "text": "Deris sorrig kand dem ey nære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 10,
      "text": "Om de met hast sig møye fast/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 10,
      "text": "Hand det for dem omuender.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 10,
      "text": "Som en fuldsterck giør Pilen ferd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 10,
      "text": "Den hende haffuer i hænder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 11,
      "text": "Huor salig er da slig en By/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 11,
      "text": "Som aff Gud selff monne regeris/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 11,
      "text": "Det huss der Forstander er i",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 11,
      "text": "Den aff Gud paa sin vey ledis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 11,
      "text": "Derfor see til/ at din tro stil",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 11,
      "text": "Paa hannem allene sig trøster.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 11,
      "text": "Thi vden hans haand huer Kongis land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 11,
      "text": "Vist i sit bæste brøster.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 12,
      "text": "Thi prise wi dig O Fader sand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 12,
      "text": "Som oss din hielp tilsende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 12,
      "text": "Disligest din Søn oc hellig Aand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 12,
      "text": "Met tack wi alle bekiende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 12,
      "text": "At du saa vel/ til Liff oc Siel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 12,
      "text": "Oss dine Børn vilt beuare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 12,
      "text": "Ah lad dette Land/ alt ved din haand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 12,
      "text": "Bliffue frijt fra vaade oc fare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 13,
      "text": "Herren høre dig Bøn i din modgangs tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 13,
      "text": "oc hielpe dig i din nøds dag/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 13,
      "text": "Den som frelste Jacob der hand all sin tillid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 13,
      "text": "satte til Gud i sin sag/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 13,
      "text": "met sorg oc stor modgang der hand omgick/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 13,
      "text": "oc trøst aff Gud da fick/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 13,
      "text": "hans naffn dig nu styrcke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 13,
      "text": "fra synd oc sorg oc all din wlycke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 14,
      "text": "Du haabte til Gud/ oc satte til hannem din tro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 14,
      "text": "J din store nød oc trang/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 14,
      "text": "Thi skal hand nu sende dig sin hielp til euig ro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 14,
      "text": "Aff sit hellige Zion/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 14,
      "text": "Saa du skalt nu vel bliffue beuarit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 14,
      "text": "Som altid er hans sed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 14,
      "text": "At de hannem elske",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 14,
      "text": "Fra Synd oc sorrig hand dem altid frelser.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 15,
      "text": "Dit hiertens gudelig Offer hand oc anseer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 15,
      "text": "Blidelig det anammer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 15,
      "text": "Oc dig sin tacknemmelig gode villie beteer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 15,
      "text": "Til liff oc Siel allsammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 15,
      "text": "Hand vnde dig oc din hiertens attraa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 15,
      "text": "Effter hans villie at gaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 15,
      "text": "Oc styrcke alle dine anslag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 15,
      "text": "Fra synd oc sorrig nu effter denne dag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 16,
      "text": "Saa wi kunde oss mod alle vore wuenner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 16,
      "text": "Aff din salighed forheffne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 16,
      "text": "Oc i vor Guds naffn opreise vore Bannere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 16,
      "text": "Met Seyer dem fordærffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 16,
      "text": "At Gud vilde sig der met lade betee/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 16,
      "text": "Saa huer maa høre oc see",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 16,
      "text": "At Gud dig bønhører/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 16,
      "text": "Fra synd oc sorrig oc all nød dig fører.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 17,
      "text": "Da siger huer mand/ der denne din gierning hører oc seer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 17,
      "text": "Ja nu kand ieg oc det skønne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 17,
      "text": "At Herren hielper sin salffuede Konning/ jo lenger jo meer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 17,
      "text": "Oc haffuer hørt hannem sin Bøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 17,
      "text": "Aff Himmelen lader Gud alt dette skee/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 17,
      "text": "Det giør de onde saa vee.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 17,
      "text": "Hans høyre haands styrcke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 17,
      "text": "All synd oc sorrig saalunde vdslycke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 18,
      "text": "De Fiender dristede sig paa Vogenborrig oc Reyssetyg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 18,
      "text": "Oc paa deris megne styrcke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 18,
      "text": "Wi dissimellem kalde paa Guds naffn met høy lyd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 18,
      "text": "Oc wi hannem saa dyrcke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 18,
      "text": "Thi tryckte Gud dem ned/ saa de falde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 18,
      "text": "Wi staa end nu alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 18,
      "text": "Gud skal oss stadfeste/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 18,
      "text": "Fra synd oc sorrig altid til det bæste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 19,
      "text": "Du Gud som est vor rette Herre oc Konning",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 19,
      "text": "Haffuer oss denne dag frelsit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 19,
      "text": "Der wi dig paakalde/ at see gode villien din/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 19,
      "text": "Vore wuenner bleffue da reffsit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 19,
      "text": "Wi tacke din store Barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 19,
      "text": "Met fred oc kierlighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 19,
      "text": "Lad oss tilsammen bo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 19,
      "text": "Vden synd oc sorrig oc all anden wro.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 20,
      "text": "O Herre frelss denne vor rette Herre oc Konning/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 20,
      "text": "Som du haffuer oss giffuit:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 20,
      "text": "Oc huess wi bede for hannem effter villien din",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 20,
      "text": "Lad det bønhøret bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 20,
      "text": "At wi maa dig tiene met ro oc fred/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 20,
      "text": "J god samdrectighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 20,
      "text": "Oc siden til euig tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 20,
      "text": "Vden synd oc sorrig met dig være salig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 21,
      "text": "CApitan Herre Gud Fader min/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 21,
      "text": "vdsend mig naaden din/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 21,
      "text": "den stund ieg her i liffue er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 21,
      "text": "Stor vildelse nu i Verden er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 21,
      "text": "miskunde oss Herre kier/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 21,
      "text": "at mig regere dine Ord oc lære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 21,
      "text": "kundgiør mig Herre den rette grund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 21,
      "text": "den stund her er den største nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 21,
      "text": "dit hellige Ord forholt mig ey/ ret vey",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 21,
      "text": "til liffuit gennem døden vd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 21,
      "text": "est du allene min Herre oc Gud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 22,
      "text": "SIg skynder fast den forsagde tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 22,
      "text": "O Herre giør oss frj",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 22,
      "text": "Fra alt ont baade til liff oc Siel.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 22,
      "text": "J all vor nød wi til dig fly/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 22,
      "text": "Din Naade begære wi/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 22,
      "text": "Frelss oss O Herre fra Verdsens qual.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 22,
      "text": "Oc vær oss alle miskundelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 22,
      "text": "Forlig oss Herre formedelst din Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 22,
      "text": "At wi kunde ret bliffue Christne vden meen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 22,
      "text": "Det er min begære oc bøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 22,
      "text": "Hielp at wi alle din villie giøre kunde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 23,
      "text": "MERe giøris behoff at bede dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 23,
      "text": "O Herre/ forlad ey mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 23,
      "text": "Du som skabt haffuer alleting.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 23,
      "text": "Lad mig faa aff din Vissdom hid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 23,
      "text": "Oc gack ey bort fra mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 23,
      "text": "Met din Naade mit hierte vent omkring.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 23,
      "text": "Oc skab i mig en retter Aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 23,
      "text": "Du kant vel vide huad mig giør møde oc vonde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 23,
      "text": "Thi alt mit haab haffuer ieg til dig/ kom mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 23,
      "text": "Til trøst/ Herre Jesu Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 23,
      "text": "Thi du allene vor Frelser est.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 24,
      "text": "MARck/ Stæder/ oc alle mine vndersaatte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 24,
      "text": "Haffuer ieg aff dig faat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 24,
      "text": "Beskerme dem alle for falske lære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 24,
      "text": "Herre Gud her er nu kommen fram",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 24,
      "text": "En onder seduan/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 24,
      "text": "Foruar oss alle i din ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 24,
      "text": "Tag dine hellige Ord oc vebne oss met/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 24,
      "text": "Paa det at Dieffuelen oss ey besuige kand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 24,
      "text": "Met verdzslig praal oc menniskens tant/ optend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 24,
      "text": "Oss alle til saadan begære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 24,
      "text": "At vor tro kunde ret til dig ene være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 25,
      "text": "GREFVEr/ Herrer/ Ridder oc Knecte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 25,
      "text": "Oc alle Slecte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 25,
      "text": "Befaler ieg dig min Herre oc Gud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 25,
      "text": "Forøg vor tro/ oc giør hende ret/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 25,
      "text": "Den Verden haffuer forgæt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 25,
      "text": "Jeg beder dig for din haarde død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 25,
      "text": "Forlad oss ey i saadan nød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 25,
      "text": "Langt før haffuer du det selff forkyndet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 25,
      "text": "At falske Propheter skulle komme/ siunis fromme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 25,
      "text": "Som Faar/ men induortis Vlffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 25,
      "text": "Som Scrifften vduiser/ oc wi haffue befundit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 26,
      "text": "TIL din store Barmhiertighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 26,
      "text": "(Huilcken allene dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 26,
      "text": "Opdrog paa Kaarssit for vore Synder slet)",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 26,
      "text": "Jeg flyer/ til dig O Herre i dit skød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 26,
      "text": "Mig aldrig offuergiff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 26,
      "text": "Jeg maner dig for din Guddoms foriet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 26,
      "text": "Den du haffuer loffuit for langen tid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 26,
      "text": "Til dig rober nu saa mangen bedrøffuit aand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 26,
      "text": "Oplad dine øern oc hør vor røst/ oc trøste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 26,
      "text": "Oss met din godhed alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 26,
      "text": "Beskerme oss at wi icke i falsk tro falde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 27,
      "text": "BRENde mercke haffue de i deris samuittighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 27,
      "text": "Som oss haffue wret ledit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 27,
      "text": "For dem Sancte Pouel beder oss at tage vare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 27,
      "text": "De haffue foruent den hellige Scrifft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 27,
      "text": "Met deris falske dict:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 27,
      "text": "O Herre frelss oss for din pine suar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 233,
      "stanza_id": 27,
      "text": "See her til oss dine fattige Faar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 234,
      "stanza_id": 27,
      "text": "Du haffuer betalit for all vor Synd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 235,
      "stanza_id": 27,
      "text": "Christus haffuer oss met dig forligt/ det beuiss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 236,
      "stanza_id": 27,
      "text": "Sancte Pouel met scrifft oc mund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 237,
      "stanza_id": 27,
      "text": "Foruar oss i din Naade alle stund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 238,
      "stanza_id": 28,
      "text": "DEN rette tro wi bede aff dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 239,
      "stanza_id": 28,
      "text": "Hør oss nu Herre kier",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 240,
      "stanza_id": 28,
      "text": "Før end Døden oss omkuld støder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 241,
      "stanza_id": 28,
      "text": "Til din miskund vort haab haffue wi",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 242,
      "stanza_id": 28,
      "text": "Aff hiertens begær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 243,
      "stanza_id": 28,
      "text": "O Herre wi ere saa ynckelig forførde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 244,
      "stanza_id": 28,
      "text": "Fra din Naade til vore egne gierninger/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 245,
      "stanza_id": 28,
      "text": "Thi styrck oss/ at wi kunde allene til dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 246,
      "stanza_id": 28,
      "text": "Haffue all vor tro/ oc haabit vort/ dine ord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 247,
      "stanza_id": 28,
      "text": "Ere sandhed visselig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 248,
      "stanza_id": 28,
      "text": "Giff oss at wi maa leffue euindelig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 249,
      "stanza_id": 29,
      "text": "BORGer Ræt giff oss i dit Rige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 250,
      "stanza_id": 29,
      "text": "Oc giør oss lige:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 251,
      "stanza_id": 29,
      "text": "Oc stat met oss alt ind til enden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 252,
      "stanza_id": 29,
      "text": "At Diefflene oss ey besuige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 253,
      "stanza_id": 29,
      "text": "O Herre ey fra oss vige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 254,
      "stanza_id": 29,
      "text": "Din naadelige øyen ey bort fra oss vende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 255,
      "stanza_id": 29,
      "text": "At naar wi komme i vor yderste nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 256,
      "stanza_id": 29,
      "text": "At Døden met grumhed vil oss tage fat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 257,
      "stanza_id": 29,
      "text": "Saa redde du/ oc vær vor skiold/ Herre bold/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 258,
      "stanza_id": 29,
      "text": "Wi bede dig alle met graad/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 259,
      "stanza_id": 29,
      "text": "Jeg beder for alle mine Vndersaatte.",
      "part": false,
      "marginal_notes": []
    }
  ]
}