  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "MEn wi leffue paa Jorden her/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "met Døden ere wi omfangne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Huem fly wi da til om hielp/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "at wi Gudz vrede vndgange/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Du est den Herre all ene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Oss tuingis nu vore Synder saa saare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "som dig nu Gud fortørne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Hellige herre Gud forbarme dig offuer oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Hellige stercke Gud/ forbarme dig offuer oss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Hellige barmhiertige trøstermand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "du euige Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Lad oss icke indfalle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "i den euige dødens nød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Kyrieleyson",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Mit i døden omfanger oss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Helffuedis mact oc vrede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Huem frelste oss aff saadanen død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "at vndfly hans suig och list/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Det gør du Herre all ene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "ver du nu oss miskundelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "helst fordi du vist vor brøst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "hellige Herre Gud/ Forbarme dig offuer oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "hellige stercke Gud/ forbarme dig offuer oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "hellige Barmhiertige trøstermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 1,
      "text": "Du euige Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 1,
      "text": "Lad oss icke fordømmis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 1,
      "text": "vdi den suare Helffuedis pine/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 1,
      "text": "Kyrieleyson",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Mit vdi Helffuede oss driffuer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "vor natur oc Synder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "Huem skulle wi da nu tilfly/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "ath wi mue dem quit bliffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "Till dig Herre Christ all ene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 2,
      "text": "Dit dyrebar Blod du for oss vdgaff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 2,
      "text": "for all vor Synd til ith vederlaff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 2,
      "text": "hellige Herre Gud/ forbarme dig offuer oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 2,
      "text": "Hellige stercke Gud/ forbarme dig offuer oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 2,
      "text": "Hellige Barmhiertige trøster mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 2,
      "text": "du euige Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 2,
      "text": "Lad oss icke affalle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 2,
      "text": "aff den rette Tro i mistrøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 2,
      "text": "Kyrieleyson",
      "part": false,
      "marginal_notes": []
    }
  ]
}