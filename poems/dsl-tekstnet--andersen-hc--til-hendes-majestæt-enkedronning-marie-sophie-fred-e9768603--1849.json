  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1849,
    "url": "https://tekstnet.dk/books/andersen-hc_til-hendes-majestaet-enkedronning-marie-sophie-frederikke/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Der var en Tid, da under Havens Hække,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Ved Frederiksberg, paa Baaden Flaget gled,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "I Jubel Drot og Dronning sad der begge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Af Folket seet i patriarkisk Fred;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Nu er i Haven tyst, Du sidder ene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Og Tidens Storme selv til Danmark naaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Men Troskabs Træet her har stærke Grene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Du seer det, som Du saae det i din Vaar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Seer Drot og Folk i ædel Villie lige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Der er en Styrke i slig Trofasthed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Du hörer Danmarks Navn i Hæder stige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Nordstjernen liig, den aldrig skal gaae ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Dansk blev din Tanke ved Kong Frederiks Side,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Dansk blev dit Hjerte i det danske Land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Naar Danmark leed, dit Hjerte maatte lide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "See Fred og Solskin over Danmarks Strand!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
