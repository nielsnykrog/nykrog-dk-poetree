  "title": "Til Hendes Majestæt Enkedronning Marie Sophie Frederikke",
  "year_created": 1849,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
