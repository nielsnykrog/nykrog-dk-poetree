{
  "id": null,
  "title": "Ved Studentermødet i Kjøbenhavn",
  "year_created": 1835,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Carl Ploug",
    "country": null,
