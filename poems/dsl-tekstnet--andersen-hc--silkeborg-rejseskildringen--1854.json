  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Det var som om Baad vi saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Da Dampprammen kom op ad Gudenaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Mod Strøm og mod Vind en Solskins Dag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Stolt vaiende med sit danske Flag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Den aanded et Liv i Landskabets Ro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Hernede, hvor Ørnen i Skovene boe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Fra Kattegattet til Gudenaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Kan Dansken nu Himmelbjerget naae!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
