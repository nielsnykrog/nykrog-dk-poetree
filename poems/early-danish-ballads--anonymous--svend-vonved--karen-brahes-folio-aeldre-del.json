    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA203.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Suend Wonn-wed sedder y burre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hand slar guld-harpenn saa prudde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Hand legtte alt saa offtte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "thett hørde frw Enerlild y lofftte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "\"Hør thw, Suend Wonwed, sønnenn mynn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "hui slaar thu saa guld-harpe dynn?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Beeddere matte thu theg vd-ridde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "blantt anddre kieemper att stridde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "Findder thu, kieere søne mynn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "thinn faders banne, tha høffuene thend.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 5,
      "text": "\"Skaall ieg meg vd-ridde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "tha flyr meg wabben dyrre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 6,
      "text": "Fynder ieg mynn faadders baanne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "tha høffner ieg thend saa gierne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 7,
      "text": "Høffner ieg icke kierre faadders baanne mynn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "tha komer ieg rett aldrig igenn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 8,
      "text": "Frw Ellind bleff y synddee saa wred:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "\"Ieg hør, myn sønn, att thu est redtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 9,
      "text": "Ieg sier thett paa thinn gylltte suerd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "ett ord er vdj thinn ferdtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 10,
      "text": "Hør thu, ridder Suend Wonuedt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 10,
      "text": "tha segne thieg saa brattynn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 11,
      "text": "\"Stteeller ethtter, frw Enerlinn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 11,
      "text": "stteeller ettthter, kier muodder mynn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 12,
      "text": "Ønsker meg ingenn vsieer att faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 12,
      "text": "y wydde icke, huor myn riese weel gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 13,
      "text": "Y-huor ieg rider offuer marcke och hieedde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 13,
      "text": "ieg achter icke quinde-wreedde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 14,
      "text": "Suend Wonueedtt rider aff gaarde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 14,
      "text": "saa vnderlig wor hans ferdt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 15,
      "text": "Hans hielem hand wor brenddendde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 15,
      "text": "hans spuore thi wor klingendde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 16,
      "text": "Hans heste wor springende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 16,
      "text": "seelliff ridder den herre saa syngende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 17,
      "text": "Hand red y dage, hand red y thuo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 17,
      "text": "icke kunde hand byen naa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 18,
      "text": "\"Hye-iaa,\" suaridtt Suend Wonuedtt tiell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 18,
      "text": "\"er her icke by y ald werden till?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 19,
      "text": "Hand suo seeg weed hyffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 19,
      "text": "saa stuor en hiordde driffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 20,
      "text": "Hannd thaallede till hanom saa offuer-bratt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 20,
      "text": "\"Wysss meg gaatt herberig y theene natt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 21,
      "text": "Huor thaa staar thend fiesk y fluodt?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 21,
      "text": "huor daa gaar dy fuoller y stuodh?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 22,
      "text": "Huor da bleser thend haste wynd?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 22,
      "text": "huor driecker Widdrick med kieemper synn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 23,
      "text": "Hiurddenn saad och thauffuede der-tiell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 23,
      "text": "ingen ann-suar hanom giffue weell.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 24,
      "text": "Hand baar op synn nøffue haard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 24,
      "text": "sluo thend hiurde wed yee:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 25,
      "text": "\"Lieg nu død paa thette saand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 25,
      "text": "ieg finder weel kong Widrik y Hollandtt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 26,
      "text": "Suend Wonuedt red icke langtt der-fraa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 26,
      "text": "saa stuor en kieempe suo hand der gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 27,
      "text": "Hand haffde biørnen paa sinn bag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 27,
      "text": "och bassi paa synn leenndde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 28,
      "text": "Huer end finger, der hand aae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 28,
      "text": "ther speller anddre smaa dyr paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 29,
      "text": "Hand red till thenn hiyrde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 29,
      "text": "saa giørlig hand hanom spurdde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 30,
      "text": "Om hand wilde med hanom fecte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 30,
      "text": "och dyrenn med hanom skyfftte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 31,
      "text": "\"Rett aldrig wordtte meg buodett thet buod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 31,
      "text": "sidden ieg Esmer koning wuoff.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 32,
      "text": "\"Wuoff thu Esnner kongge fynn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 32,
      "text": "thaa wuoff thu kierre faadder mynn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 33,
      "text": "Nu løster meg att fecte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 33,
      "text": "och dyren med thieg skyfftte.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 34,
      "text": "Thy skrøff enn kriends alltt som thi stuod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 34,
      "text": "thi ginge der-y, thi kieemper guod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 35,
      "text": "Tthi feggttis y dage, thi fegttis y thuo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 35,
      "text": "ingenn kund sieer aff andden faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 36,
      "text": "Then thridi dag att queldde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 36,
      "text": "Suend Won-wedt kiempenn feelde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 37,
      "text": "Hand bantt synn suerd weed syddee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 37,
      "text": "muod flierre kieemper att stridde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 38,
      "text": "Tther hand kaam paa willddenn marck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 38,
      "text": "ther møtte hanom en kieempe sterck:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 39,
      "text": "\"Sigg meg, edelig ridder guod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 39,
      "text": "huor daa staar thi fesk y fluod?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 40,
      "text": "Huor daa staar thi fesk y fluod?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 40,
      "text": "huor gaar thi beste fuoller y stuodh?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 41,
      "text": "Huor daa blesser theend haaredeste wynnd?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 41,
      "text": "huor dricker kong Widdrick med kieemper synn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 42,
      "text": "\"For østenn stuod thend feesk y fluod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 42,
      "text": "for westenn staar thi fuoller y stuod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 43,
      "text": "For nuorddenn bleser denn haardde wynd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 43,
      "text": "y Holland drecker kon Widdrick med kieemper synn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 44,
      "text": "Suend Won-weed thog guld-ringenn aff synn barum,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 44,
      "text": "hand saatte denn paa denn kieempis arum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 45,
      "text": "\"Nu sig, thw warst thend første mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 45,
      "text": "som gaatht vd-aff Suend Wonn-wed fandtt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 46,
      "text": "Suend Won-wed red for hyggenn thindde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 46,
      "text": "hand bad thend wegttter lad sieg ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 47,
      "text": "Hand wilde icke ladde hanom ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 47,
      "text": "saa luod hand offner murenn sprinngge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 48,
      "text": "Hand bantt synn hest weed thuoffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 48,
      "text": "saa gick hand i stoffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 49,
      "text": "Saa gick hand i stoffuen ind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 49,
      "text": "for Widdrick konge och kieemper synn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 50,
      "text": "Suend Wonne-wed saatte sieeg ouerst till buords,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 50,
      "text": "men icke thaalde hand till nogenn ett ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 51,
      "text": "Hand oed och drack och fieeck sieeg maad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 51,
      "text": "icke spurdde hand kongenn att.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 52,
      "text": "\"Aldrig wor ieg nogenn steed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 52,
      "text": "saa mange forbandit dome y waar.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 53,
      "text": "Kong Diderick thaaller till kieemper feem:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 53,
      "text": "\"Bindder y meg dene gallnne mand.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 54,
      "text": "\"Thag thu IIII till thi feem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 54,
      "text": "staatt sielliff mitt emellom denom.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 55,
      "text": "Enn hyrrenn-sønn thaa bliff tu theg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 55,
      "text": "til du faar bunditt ther band paa meg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 56,
      "text": "Kong Essmer wor myn faadder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 56,
      "text": "frw Ellind waar mynn muoder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 57,
      "text": "Thi baad meg ey saa giørre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 57,
      "text": "mitt guld paa huer skaalck att ødde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 58,
      "text": "\"Waar Esmer konge thinn faadder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 58,
      "text": "frw Ellind thinn kerr muodder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 59,
      "text": "Suend Wonwed saa er thitt naffuen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 59,
      "text": "kieer søster-sønn saa est du mynn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 60,
      "text": "Suend Wonne-wed, willthu bliffue huosz meg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 60,
      "text": "buodde hieder och erre wiell ieg giør thieeg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 61,
      "text": "Mynn ridder skaall paa deg waare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 61,
      "text": "y-huor du willdt y landitt faarre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 62,
      "text": "Naar thu wildtt fraa meg faare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 62,
      "text": "mytt guld weell ieg icke weed thieeg spaarre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 63,
      "text": "Saa gick hand sieg y stuoffuen ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 63,
      "text": "hannd oeed och hand drack thennd klaare wynn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 64,
      "text": "Saa sluo hand harpe saa lennge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 64,
      "text": "att syndder gick alle guld-strennge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 65,
      "text": "Saa faar hand sieg op att land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 65,
      "text": "saa feste hand sieeg en iumfru skønn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 66,
      "text": "Hindis faadder hand hieedder kong Sieddffuer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 66,
      "text": "hand bleff wieett aff orum saa lieedt.",
      "part": false,
      "marginal_notes": []
    }
  ]
}