  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Sankt Hans du bringer os Sommertid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "din Fest skal staa i det Grønne;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Stadsen koster os ikke en Hvid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Kukker og Drossel synge: Kom hid!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Alle Smaapiger er kjønne!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Kjønnere gjør dem nu Kildens Væld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Lykke og Held!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Lykke og Held!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Det vilde Skovæble trives.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Hexene flyve henover Vang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Hesten er kun en Humlestang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Klog Mand trækker da med sin Kabuds,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "seer ei derpaa, seer ei derpaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Bonden tænder paa Marken Blus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "saa kan ei Sot og Syge ham naa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Hil være Sanct Hans!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Hil være Sanct Hans!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Snart komme alle de Stjerner smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "de blinke smukt ned fra oven;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Nattergalene høre vi slaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Kjærestefolk med hinanden gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "der er saa dejligt i Skoven.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "Sammen de vandre til Kildens Væld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "Lykke og Held!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 1,
      "text": "Lykke og Held!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 1,
      "text": "Ei skjønnere Aften gives.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 1,
      "text": "Rumlende, tumlende kommer en Flok,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 1,
      "text": "nogle paa Krykke, andre med Stok;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 1,
      "text": "Skillinger blanke de kaste paastand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 1,
      "text": "i Kildens Vand, i Kildens Vand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 1,
      "text": "Sundheds Urt er den bedste Urt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 1,
      "text": "den er langt meer end Guldet purt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 1,
      "text": "Hil være Sanct Hans!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 1,
      "text": "Hil være Sanct Hans!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 2,
      "text": "Sanct Hans, du bringer os Sommertid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 2,
      "text": "din Fest skal staa i det Grønne.",
      "part": false,
      "marginal_notes": []
    },
    {
