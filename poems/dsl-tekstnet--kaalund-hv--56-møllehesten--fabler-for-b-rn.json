  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Hvi stirrer Du, Hest, fra det gamle Skur",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "saa sorrigfuld ud i Guds Natur?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Om Jorden suse nu Vaarens Vinde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "men der er saa mørkt og skummelt inde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Du vilde nok gjerne herud engang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "i det høje Græs paa den grønne Vang?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Hesten, den svarede ej et Muk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "drog kun et tungt, et smerteligt Suk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "kunde ej klage og kunde ej græde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "sukked for Livets Frihed og Glæde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "synes, den var til Bedre skabt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "end at ødsle i Møllen sit Mod, sin Kraft.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
