  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Det Nøgne Menneske",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1932,
    "url": "https://tekstnet.dk/books/munch-petersen-g_det-noegne-menneske/020/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "– jeg synes, de fleste er kloge –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "ikke saa glade, men kloge og betænksomme –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "– jeg søger en ven –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 2,
      "text": "– han skal gaa med mig i haanden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "– og han skal sige:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "jeg ved heller ingenting – forstaar ingenting,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "uden at her er smukt lige her – og der ligger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "et væltet træ derhenne –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "jeg kender ikke til \"hvorfor\" – ved ikke, hvad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "noget er, uden at det er morsomt eller",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "kedeligt –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "og han skal sige: jeg synes, der er meget smukt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "og grimt i verden –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "– meget andet skal han ikke gøre –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "– saadan skal vi gaa –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "med hinanden i haanden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "mens vi forsøger at se glade ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "mens vi viser hinanden det morsomme, grimme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "kedelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "og skønne i verden –",
      "part": false,
      "marginal_notes": []
    }
  ]
}
