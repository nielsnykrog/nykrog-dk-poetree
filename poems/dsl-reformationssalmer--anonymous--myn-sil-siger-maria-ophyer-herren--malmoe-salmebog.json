  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Myn siæl (siger Maria) ophøyer Herren",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Oc myn aand frøyder sig i Gud min frelsere",
      "part": false,
      "marginal_notes": [
        "Luce i"
      ]
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Faar han saa til sin tienerskis / see her aff skulle alle slecter sige mig salig ath vere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Forthi den giorde mig stor ting som mectig er/ oc hans naffn er helligt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Oc hans barmhiertighed er fra slecht oc til slechter hoss thennem som hannem frøchte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Han haffuer giort weldighed met sin arm/ och forstørnet de som hoffuerdige ere i deris hiertis sind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Han haffuer affstøt de mectige aff deris sæde/ och ophøget de ydmyge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "De Hungrue opfylte han met gode ting/ och de rige forlad han thome",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Han haffuer ihukommid sin barmhiertighed/ och sin tiæner Jsrael ophulpet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Som han talede til wore foreldre/ besynderlig til Abraham oc hans sæd till ewig tid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Ere wære Gud fader oc Gud Søn oc saa Gud den Helligand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Som haffuer wærit aff begyndelsen oc nw och altid er/ och bliffuer til ewig tid/ AMEN",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Loffuer Christum wor frelsere Alleluia Alleluia Alleluia",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Gud wære loff oc ewig tack Alleluia Alleluia Alleluia",
      "part": false,
      "marginal_notes": []
    }
  ]
}