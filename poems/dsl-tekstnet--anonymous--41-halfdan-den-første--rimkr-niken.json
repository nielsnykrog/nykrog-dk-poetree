{
  "id": null,
  "title": "41. Halfdan den Første",
  "year_created": 1495,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Rimkrøniken",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1495,
    "url": "https://tekstnet.dk/books/anon_rimkroeniken/044/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "ieg tæncker thet wor ey mynne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Saa fick ieg thet myn broder i handh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "for ieg willæ mere wynne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Saa for ieg selff aff rygeth wdh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "och ander smaa landh meth skioldh oc spywd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "som Sweriges rygæ tijl lyddhæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "Siden for ieg tijl Swerigæ selff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "thet rygæ vndher meg at wynne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "medh swenskæ men oc fynne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 3,
      "text": "Thet fortrødh Erich, hans søsthersøn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "han hade thet thænct at wræcthæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "Han soor han skullæ meg giffue myn løn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 4,
      "text": "Han hade en kempe, thet haffuer ieg sporth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "som aadh och egh kunne dyliæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "Thi hade ieg meg en kølffue giorth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "wel ierngyrdh efther myn williæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "och slo then kempe tijl dødhe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "och andræ fleræ meth samme stang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "theres haffue ieg ther paa marken strødhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 6,
      "text": "Men Erich han dog marken beholth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "Tha ieg bleff læcth ieg hannum thet golth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 6,
      "text": "ieg wilæ thet ey fordrawen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 7,
      "text": "Ieg hade nar fonghet eth faldh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "thet kunne ieg wel menæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 7,
      "text": "och østh paa them fast stenæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 8,
      "text": "The gaffue meg ther fore biærggrams naffn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 8,
      "text": "ath ieg saa brødh then kleppe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 8,
      "text": "och tog ther sten i handh oc fawn;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 9,
      "text": "Tha bwrdhe Erich marken ath fly",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 9,
      "text": "tijl Danmark lodh han glijdhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 9,
      "text": "Han stridhe meth myn brodher aff ny",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 9,
      "text": "oc thabede thrænde tijdhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 10,
      "text": "som han hannum tha paa førdhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 10,
      "text": "Tha ieg thet spurde, ieg wor ey blidh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 10,
      "text": "ieg hannum aff Danmark kørdhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 11,
      "text": "Saa fwldhe ieg hannum tijl Swerigæ indh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 11,
      "text": "Ieg wandh thet rygæ oc wor ey seen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 11,
      "text": "ieg nødhe them meg ath wighæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 12,
      "text": "Om syer the reysda seg meg imodh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 12,
      "text": "en knabæ meth syw hans sønner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 12,
      "text": "ieg slo them allæ som høner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 13,
      "text": "Siden kom ther en kempe saa stærk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 13,
      "text": "wel xi alne langgher.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 13,
      "text": "Han willæ tha meth meg øwæ hoffuerk;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 14,
      "text": "Han bødh meg aff i kretz ath slas",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 14,
      "text": "meth seg selfftholthæ kempæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 14,
      "text": "Ieg sade ieg willæ gøre them eth fas",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 14,
      "text": "om ieg fingæ ther tijl lempæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 15,
      "text": "ath ieg thordhe hannum so swaræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 15,
      "text": "Han slo ihiell sex eller syw",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 15,
      "text": "wdaff syn egæn skaræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 16,
      "text": "Saa tog han them han hade igen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 16,
      "text": "Ieg saa thet ath the fynghæ eth men",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 16,
      "text": "heller the wore wrede eller blyde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 17,
      "text": "En mectig kempe i Norgæ wor,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 17,
      "text": "han war so doll i twngæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 17,
      "text": "the woræ hannum bode twngæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 18,
      "text": "Han skullæ hannum enthen syn dotther faa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 18,
      "text": "tijl syn husfrw ath haffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 18,
      "text": "eller meth hannum i kretzen gaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 19,
      "text": "Thi lodh han kyndhe offuer allæ landh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 19,
      "text": "then skullæ hans dotther forhwærffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 19,
      "text": "ware seg ænthen swæn eller man,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 19,
      "text": "som then kempe kunne forderffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 20,
      "text": "och iomffrwen ieg forhwerffdhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 20,
      "text": "Ieg affledh meth henne en søn saa fraa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 20,
      "text": "hedh Asmwndh, han Norgæ ærffdhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 21,
      "text": "Af hannum kom Norgis koningligæ slecth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 21,
      "text": "och waret ther syen i staght oc macth;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 21,
      "text": "ieg kan thet siæ for sandhen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 22,
      "text": "Tha haffdhe ieg slaffuit so mangen man,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 22,
      "text": "bode kempper och saa iæthæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 22,
      "text": "han tog meg bort meth slæthtæ.",
      "part": false,
      "marginal_notes": []
    }
  ]
}