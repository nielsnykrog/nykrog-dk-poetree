  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "En Kæmpehøj paa Marken staar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "der græsse nu Bondens Lam og Faar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Og Solen skinner, og Vinden vifter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "og Maanen sit Lys paa Himlen skifter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "og Lærken hvirvler i Sky sin Sang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "saa sang den og for Kæmpen engang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Nu sover han længst fra Verdens Kiv; -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "men aldrig uddør Naturens Liv. -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Bag Bautastenenes Skygger brede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "ty Faarene ind for Solens Hede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "De frydes ved Livet, som Gud dem gav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "og slumre sorgløst paa Kæmpens Grav.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
