{
  "id": null,
  "title": "Sang ved Sølvbryllupsfesten",
  "year_created": 1872,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
