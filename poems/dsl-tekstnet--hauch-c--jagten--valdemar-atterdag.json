    "url": "https://tekstnet.dk/books/hauch-c_valdemar-atterdag/009/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Under de høie Bøge var hugget mangen Sti,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Der red Konning Volmer med sit Følge forbi;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "De vilde Dyr i Skoven ei glæded sig derved,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Den jagtlystne Skare lod dem kun liden Fred.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Foran de ædle Gjester red Danmarks høie Drot,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Staalbuen at spænde forstod den Herre godt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Kjølver og lette Pile fløi gjennem Skovens Net,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "De bladløse Bøge kun skjulte Vildtet slet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Solstraalerne blinked i Luften klar og blaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Paa alle Veie speided de Sporhunde graae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Bønderne gik i Rækker og gjente Vildtet til,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Da begyndte de Jægere det lystige Spil.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Herlig klang i Skoven de gyldenblanke Horn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Mens Hundeglammet gjenlød fra Krat og fra Torn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "De Riddere sig spredte bag Busk og høien Bøg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "De jaged kun med Mynder, men ei med flyvende Høg.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "De ædelige Fruer dem fulgte med Lyst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "De blanded deres Stemmer med Jægernes Røst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Sadlerne vare spændte med silkehvide Baand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Med Sølvertøilen leged da mangen fager Haand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Hundeglammet opsteg høit under vilden Sky,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Ei vidste Hjorten og Hinden, hvorhen de skulde flye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Daadyr og letten Hare kunde sig ikke skjule,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "Pilene fløi i Luften, liig rovlystne Fugle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Tovelil den Fagre heel nærved Kongen red,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Sig løste hendes Fletninger, de faldt i Vinden ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Da flagred over Skuldrene det udslagne Haar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "Liig guldfarvede Skyer, der bagved Solen gaaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "Hun sad heel rank paa Hesten, heel kjæk var hendes Aand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Da spændte hun sin Bue med hviden Jomfruhaand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "Og sigted mod et Raadyr, som flygted med Iil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "Da sank det til Jorden for den vingelette Piil.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "Kong Volmer smiled venlig, han tænkte ved sig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "»Blandt alle Verdens Qvinder hun passer bedst for mig.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "Han sagde: »Favre Jomfru, I har Lykken til Ven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "I seirer uden Møie, hvor I Jer vender hen.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "Hvorlænge Jagten vared, har Ingen mig fortalt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Ei heller kan jeg sige, hvormeget Vildt der faldt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "Dog hvisked en gammel Jæger, han syntes lidet fro:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "»Skal alle Dyr da skydes, som her i Skoven boe?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "Hvis saa de vilde færdes endnu i Dage tre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Da fik man i Skoven ingen Hjort meer at see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "Daadyr og letten Hare, Alt blev ødelagt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "Gud frelse de gode Skove fra denne vilde Jagt!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "Til Kongeborgen atter det lange Følge red,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Gjennem de Hestedækner trængte Gangernes Sved;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "Da sagde de Riddere: »Det var en herlig Fest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "Men denne Dag paa Jagten, den var dog allerbedst.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "- Fru Helvig saae fra Vinduet i Borggaarden ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "Hvor Tovelil den Fagre ved Kongens Side red;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "Da smiled hun heel selsomt, hun bort fra Vinduet gaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "Hun sagde: »Jomfru Tove heel mangen Kunst forstaaer.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 13,
      "text": "Saa sprang de stolte Riddere fra Gangerne til Jord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "Dem førte den ædle Marskalk til det kongelige Bord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "Hvo sammen vilde blive, de skiltes ei ad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "De ædelige Fruer mellem Ridderne sad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "Den stærke Viin i Bægerne fast som i Strømme randt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Kong Volmer drak kun lidet, han dertil var vant,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "I Høisædet sad han med Jagtklædning paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "Det lysned som Lynglimt, hvorhen den Herre saae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 15,
      "text": "Da skued man Hr. Eckhard ved Dronningens Side,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "Hvad hemmelig de talte, fik Ingen at vide;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "Hendes Kinder vare blege, hun syntes tankefuld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "Da leged atter Tovelil paa Harpen af Guld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 16,
      "text": "Fra Dronningens Side Hr. Eckhard ikke veg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "Men Dankongen lytted til Tovelilles Leg;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "Et Blik dog han kasted til Helvig saa brat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "Som Lynet, der tændes og slukkes i Nat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 17,
      "text": "Tilsidst til Jomfru Tove Hr. Henning nærmed sig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "Han sagde: »Tovelille, Kong Volmer elsker Dig.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "Gjensvared den Jomfru: »I tale dog ei saa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "Den Tro han gav Fru Helvig, vist aldrig brydes maa.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 18,
      "text": "- »Og dog min favre Søster, Du er af Fyrsteblod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "Fru Helvig selv ei stammer af ædlere Rod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "Og vel det kunde hændes, hvis Dronningen var død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "At Du maatte bære hendes Guldkrone rød.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 19,
      "text": "Da reiste sig den Jomfru med blussende Kind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "Hun iled gjennem Hallen som den flygtige Hind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "Hun vilde ham ikke høre, men hvad der meer er hændt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "Og hvad de siden talte, det er mig ei bekjendt.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
