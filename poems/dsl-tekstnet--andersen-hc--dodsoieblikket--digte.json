  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Digte",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1830,
    "url": "https://tekstnet.dk/books/andersen-hc_digte-1830/041/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Hvad er det dog som lyser? det luttres for min Sands;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Jeg føler Øiet briste i denne Straaleglands.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Mit Hoved mat sig bøier for Kraften i min Aand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Og mildt om Hjertet løsner sig alle snevre Baand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "I Døden faae vi Vinger, det troe vi jo som Smaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Ja Aanden den faaer Vinger, som Tankens overgaae!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "I Stjernernes Systemer i Miden paa vor Jord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Jeg seer en Guddoms Fylde hvortil jeg ei har Ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "En Evighed jeg skuer i Alt, selv i mit Bryst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Og alle Taager synke bag Jordens kjendte Kyst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "I mine Brødres Hjerter nu først jeg læser ret,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Vel er’ vi alle svage, men ingen ganske slet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "O kunde vi herneden saa klart i Andre see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Som i vort eget Indre, vi gjorte Dem ei Vee.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "I hver jeg mig gjenkjender, i store, som i smaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "O skal vi da i Døden hinanden først forstaae?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Jeg er saa let, saa salig, saa luttret i min Tro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Jeg føler Kamp og Stræben, og dog en himmelsk Ro!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
