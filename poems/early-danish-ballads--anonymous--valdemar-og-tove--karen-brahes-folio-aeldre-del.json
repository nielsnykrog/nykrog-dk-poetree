{
  "id": null,
  "title": "Valdemar og Tove",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA80.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Der gar dantzen wdde weed aae:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "der danser hun droningenn med synn iumfruer smaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": ":: Imen rade kong Wollemuor loffuer denom bude. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Der dantzer droningenn med synn iumfruer ny:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "stalt war hun Thuolild, hun kuad for dy.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "\"Hør thu, Thuollilde, liege myn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "du holtt op sylcke med handenn dynn!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "\"Fuld ilde da matte ieg kongen luo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "matte ieg icke sylcke paa iordenn drage.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "\"Daa sig meg, Thuolild, liege myn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "och nar fek kongen wilig dyn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "\"Ieg war meg saa lidell ett barn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "der ieg stuod y myn faders gard.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "Ieg stuode vde buod lidell och wenn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "daner-kongen rider frem med alle synn mend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "Hand sende efter meg dy rider ny:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "och icke saa wilde ieg følge dy.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "Saa kaam hand selleff kongen med ald syn mend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "saa matte ieg Thuo-lild følge dem.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "\"Du sig meg, Thuolild, liege myn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "huad war da morgen-gaffue dynn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 10,
      "text": "\"Hand gaff meg saa gatt ett guld-skrw:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "saa matte ieg giffuee den herre myn thro.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 11,
      "text": "Hand gaff meg en sylke-serck:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "thett wor otte iumfruer deris hande-werk.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 12,
      "text": "Hand gaff meg dy guld-ringe ny:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "Suerigis droning otttte dy.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 13,
      "text": "Syden bar ieg saa blege kiend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "for hans magt waa møgt storre ind myn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 14,
      "text": "Hand gaff meg saa gaatt ett guld-baann:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "sliggitt kaam aldrig vdj eders hannd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 15,
      "text": "Hand klede meg y sylcke och skaarlagen rød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "saa war y ey, droning Soffy, med ald eydders møø.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 16,
      "text": "Dett suarid droning Soffy vd-aff rett harum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "\"Du schalt aldrig tage mere gaffue vd-aff hands handd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 17,
      "text": "Well herre Gud, att ieg maa løffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "tha skal hand deg haleff myndere gyffue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 18,
      "text": "Droningenn suøber seg hoffuett y skyend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 18,
      "text": "hun gaar y lofftt for kong Oleffmurr ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 19,
      "text": "\"Hør y, mynn herre, huad ieg sygger eder:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 19,
      "text": "huy haffuer y Thuolild kierrer ind meg?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 20,
      "text": "\"Fordy haffuer ieg Thuolild y hiartet saa kier:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 20,
      "text": "for hindis thuo søner thiener meg saa neer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 21,
      "text": "Første ieg rider igemell Flensborig-by,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 21,
      "text": "her Biørnn hand fører myn baner y sky.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 22,
      "text": "Første ieg rider igiemell Holster-land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 22,
      "text": "Knud-lild fører mynn baaner paa hand.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 23,
      "text": "\"Hør y, mynn herre, huad ieg beder eder:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 23,
      "text": "maa Thuolild gaa y badstuoffue med meg?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 24,
      "text": "\"Saa giernne giffuer ieg mytt mynde der-till,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 24,
      "text": "alt om hun Thuolild selleff saa well.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 25,
      "text": "Tthett stuod saa y wintter thuo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 25,
      "text": "ycke kunde dronningen stolt Thuoldid faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 26,
      "text": "Tthett waar om en hellig iyulle-dag:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 26,
      "text": "till kierken daa wilde stalltt Thuolild faar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 27,
      "text": "Tthuolild ganger att gaadenn fram:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 27,
      "text": "buode sylke och rødee guld eftter hynd saam.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 28,
      "text": "Droningenn vd aff wynduett saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 28,
      "text": "hun suo stallt Thuolild paa gaaden gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 29,
      "text": "Droningenn thaaller till iumfruer thuo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 29,
      "text": "\"Y beder stalt Thuo-lild ind til meg gaa!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 30,
      "text": "Tthuolild slog offuer seg skaarlagenn-skiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 30,
      "text": "saa gaar hun y lofftt for droningen ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 31,
      "text": "Ind kaam Thuolild och steddis for buord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 31,
      "text": "\"Huad wilde y, myn frw, huy sende y meg ord?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 32,
      "text": "Droningenn klaper paa hønnde blaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 32,
      "text": "\"Thu kom, stalt Thuolid, huyle her-paa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 33,
      "text": "Hor thu, stolt Thuolild, huad ieg siger deg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 33,
      "text": "welt du y affttenn gaa y badstuoffue med meg?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 34,
      "text": "\"Ike saa er ieg badstuoffue-lie:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 34,
      "text": "ieg badder med eders naade, saa well ieg ride.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 35,
      "text": "Droningenn taller till iumfruer thuo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 35,
      "text": "\"Lader y meg den badstuoff redde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 36,
      "text": "I giører denn badstuoff hied som glød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 36,
      "text": "stalt Thuolild skall der-inde dø.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 37,
      "text": "Tuolild skulde y badstuoffuen gaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 37,
      "text": "selleff stuod hun droningen och suo der-paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 38,
      "text": "Tthuolild ind y badstuoffue thrend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 38,
      "text": "droningen locker selliff døren igenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 39,
      "text": "Tthuolild robtte saa hytt ett skregg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 39,
      "text": "thett hørde her Biønn, alt som hand red.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 40,
      "text": "Her Biørnn hand rider y grønen eng:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 40,
      "text": "hand hørde syn muoder y bastuoffuen briende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 41,
      "text": "Her Biønn hand till badstuoffuen rend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 41,
      "text": "tha wor hans moder inde-breennd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 42,
      "text": "Med sorrig-fuld hiartt och blegend kiend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 42,
      "text": "saa gaar hand y lofftt for droningen ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 43,
      "text": "\"Her sedder y, droningenn, y skaarlagen rød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 43,
      "text": "huor-for skulde myn moder y badstuoffuen død?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 44,
      "text": "\"Fordy luod ieg dyn muoder indbrinde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 44,
      "text": "alt for hun suoff huosz herre myn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 45,
      "text": "Her Biørnn slog droningenn wed syn kiend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 45,
      "text": "thett bloditt stank offuer hyndis skaarlagenn-skynd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 46,
      "text": "\"Leffuer ieg och myn broder, her Knud:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 46,
      "text": "tha skall wy dryffue deg aff Dannemark vd.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 47,
      "text": "\"Well Gud, att ieg och myn harre maa leffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 47,
      "text": "buode hanom och deg skall wy aff landitt dryffue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 47,
      "text": ":: Men rade kong Olleffmuor loffuer denom buode. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}