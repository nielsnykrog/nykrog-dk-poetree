  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "IEsus Christus er vaar salighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "som fra oss tog Gud faders wrede/",
      "part": false,
      "marginal_notes": [
        "Esa. liii"
      ]
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "met sin pine oc hellige død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "frelste han oss fra helffuedis nød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Ath wi aldrig det forgæde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "gaff han oss sit legeme ath æde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "som er skiult i brødsens skin/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "oc at dricke sit blod i vin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Huem aff denne kaast vil æde/",
      "part": false,
      "marginal_notes": [
        "Mathei xxvi i Cor. xi"
      ]
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "sit hierte oc sin sag han ey forgæde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "huem vuerdig her til gaar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "for liffuit da den euige død han faar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Thi skalt du Gud fader prise/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "ath han dig saa vell vilde spise/",
      "part": false,
      "marginal_notes": [
        "Rom viii"
      ]
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "oc han for dine synders løst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "i døden sin Søn haffuer giffuit vist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Saadan naade oc barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "søger ith hierte i stort arbeyd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "est du karsk saa bliff her fra/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "ath du skalt icke fordømmelsen faa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Du skalt nu bliffue i stadelig tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "da foer du naade miskund oc ro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "aff denne kaast han haffuer giffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "oss arme till det euige liff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Han siger selff kommer i arme/",
      "part": false,
      "marginal_notes": [
        "Mat xi Mat ix"
      ]
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Jeg vil mig offuer eder forbarme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Jngen læge haffue de karske behoff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "hans konst er dem en spot oc wtro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "Vilt dw met dine gerninger fange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "oc i hiemmelen for dem indgange/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "da vore min pine oc død ey fyllist/",
      "part": false,
      "marginal_notes": [
        "Gal ii"
      ]
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "for du dig selff din salighed est",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "Tror du fast aff hiertens grund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "oc bekender met din mund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "saa est du ret gantske vel skickit/",
      "part": false,
      "marginal_notes": [
        "Rom. x"
      ]
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "oc denne kaast din siel vederqueger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "Denne fruct kan ey heden være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "brødre oc søstre skalt du ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "met dine penninge gotz oc iord/",
      "part": false,
      "marginal_notes": [
        "Joan xiii"
      ]
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "der met dem hielp som Gud haffuer budit",
      "part": false,
      "marginal_notes": []
    }
  ]
}