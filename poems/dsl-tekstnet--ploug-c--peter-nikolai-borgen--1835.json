  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Der flyver Toner over Belt og Fjord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Til Barndomshjemmets stille Dal de trænge;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Lyt, gamle Fader! til det fjerne Kor!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Gjenkjender Du paa Røsten dine Drenge?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Dem er det, der, saa tidt din Stemme klang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Stod om din Stol, en taus, opmærksom Klynge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Hvis Tunger løstes af en indre Trang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Hvem Hjertets Kald fik lært engang at synge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Vær hilset, Gubbe med de mange Aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Med Kinden furet og med Issen kullet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Som vandrer om blandt Blomsterrie i Vaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Imens din Samtid raadner under Muldet!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Thi Livets kjælne Lyst forsmaa'de Du,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Men var til Savn og Møje altid rede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Derfor Du staar i hærdet Kraft endnu,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "En knudret Eg, skudt af den jydske Hede!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Vær hilset Du, som skrev din Viden ind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Med dybe Træk i Barnets bløde Tanke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "- Mens Orm og Møl fortære tykke Bind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "Staa hine Ciffre talende og blanke; -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "Som forskede med indadvendte Blik",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "Naturens skjulte Kræfter, Livets Gaade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "Meris Drengens Videlyst i Eje fik",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "Hvert Sandhedsblink, din tause Grubien naa'de!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "Du var ej blot hans Lærer, men hans Ven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "Til hvem med sikker Tillid han sig klynged;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "Hans unge Kraft oprejste Du igjen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "Naar Mismod, Tvivl og Sorg hans Bryst betynged;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "Du tøjlede hans kaade Overmod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "Og Lidenskabens vilde Flammer slukked,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "Du vared ham for Snaren ved hans Fod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "Og Livets Scene for hans Blik oplukked.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 0,
      "text": "En Saadan var Du, ligegyldig, om",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 0,
      "text": "Bifald og Hæder udenfra Du vandt Dig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 0,
      "text": "Det var ikkun din gode Villie, som",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 0,
      "text": "Fast med Disciplens Ve og Vel forbandt Dig;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 0,
      "text": "Og Skolen var din Lyst, dit rette Hjem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 0,
      "text": "Var Maalet for din Stræben og din Tænken,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 0,
      "text": "Din Kundskab og dit Liv var viet dem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 0,
      "text": "Som sad derinde lyttende paa Bænken.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 0,
      "text": "Men Parcen drejer Tenen, Lustrer fly, -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 0,
      "text": "Livskraften modnes, ældes og forsvinder;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 0,
      "text": "Det Gamle maa fortrænges af det Ny,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 0,
      "text": "Som snart kun lever selv i blege Minder;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 0,
      "text": "Snelokket Vinter bli'r den grønne Vaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 0,
      "text": "I Gruset styrte Templer og Kolosser;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 0,
      "text": "Den Godes Virken kun ej brat forgaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 0,
      "text": "Kun hvad af Aanden fødtes, Tiden trodser.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 0,
      "text": "I to og tred've Aar sad uforsagt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 0,
      "text": "Og ufortrøden Du paa Lærestolen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 0,
      "text": "Nu viger ogsaa Du for Tidens Magt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 0,
      "text": "Nu er fuldendt din vante Gang \"paa Skolen\".",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 0,
      "text": "De Faa, der virkede med Dig som Mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 0,
      "text": "Alt længe slumre under Grønsværdækket,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 0,
      "text": "Discipelklyngen spredtes vidt om Land;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 0,
      "text": "Men Du staar ensom, nærved Gravens Rand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 0,
      "text": "Med Taarers bittre Glands i Sølverskægget.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 0,
      "text": "Dog, kjære Gamle! Du er ikke glemt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 0,
      "text": "Fordi maaske Dig Verden vender Ryggen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 0,
      "text": "Trofaste Hjerter har dit Billed gjemt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 0,
      "text": "Mens disse slaa, det dølges ej af Skyggen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 0,
      "text": "Besad din Aand ej Ørnens Blik og Flugt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 0,
      "text": "Har end dens Grublen lidet Nyt udgrundet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 0,
      "text": "Saa straaled Hjertets Renhed dobbelt smukt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 0,
      "text": "Og det har Dig din Plads i Hjerter vundet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 0,
      "text": "Du skal forladt ej famle til din Grav",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 0,
      "text": "Igjennem Livets Taage, Skæbnens Mørke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 0,
      "text": "Skjønt ingen Søn, din Alders Støttestav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 0,
      "text": "Er gangen frem af dine Lænders Styrke;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 0,
      "text": "Du var en Fader kjærlig, varm og huld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 0,
      "text": "Engang for hver Discipel, - det sig lønner:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 0,
      "text": "Barnløs, Du fik af Børn et talrigt Kuld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 0,
      "text": "Thi, Fader, Vi er' alle dine Sønner!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 0,
      "text": "Vor Tanke flyver over Belt og Fjord",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 0,
      "text": "Til Barndomshjemmet tidt og mangesinde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 0,
      "text": "Hvergang den dvæler der, den kjærlig snor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 0,
      "text": "Sin Blomsterkjæde om \"den Gamles\" Minde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 0,
      "text": "Vær trøstig! løft dit Hoved, let for Sorg!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 0,
      "text": "Buk ikke under for ukjendte Smerter!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 0,
      "text": "Hist venter Dig din Tak i Himlens Borg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 0,
      "text": "Her lever den og dø'r med vore Hjerter!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
