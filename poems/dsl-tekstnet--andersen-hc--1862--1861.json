  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Igjen et Aar udfolder sine Vinger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Det flyver frem med Morgenrødens Glands;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Igjen vi spørge: hvad mon Aaret bringer?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Hvor falder Sørgeflor, hvor Brudekrands?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Skal Krigsraab eller Fredens Hymne lyde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Hvad meisler det i Verdens Marmorblok?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Hvad vil det reise og hvad vil det bryde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Far hen hver frygt! Vorherre hjelper nok.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Han er i gode og i tunge Dage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Det Hjerte, vi os trygt tør hælde til;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Igjennem Mulmet vi til Klarhed drage;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Vort Liv er ei Tilfældigheders Spil!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
