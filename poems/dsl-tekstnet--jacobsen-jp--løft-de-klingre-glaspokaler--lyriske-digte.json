  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Løft de klingre Glaspokaler,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Som Burgunderbølger maler",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Røde som den sorte Nat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Fat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Eders Bægre og rejs jer brat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "I Rid're af Livets bugnende Bord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Rid're af den runde Jord!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
