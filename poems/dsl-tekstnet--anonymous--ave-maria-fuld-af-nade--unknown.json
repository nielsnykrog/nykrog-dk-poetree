  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "versus Aue Maria, fuld met nadæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Guth er met tegh, gøm oss fran wadæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "sadhæ Gabriel ængil han tel tegh kom",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "ther tw wnfecth thet hemmelskæ lam.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "sade Elyzabeth tell tegh then synnæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "ther hun tegh søgthæ met ydmygh tuct.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Velseynet ver oc tyth legomes fruct.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "versus Jesus Christus, som nw hauer frelst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "och Adam och Eua, the hadæ fortabeth,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "the bruthæ Gutz buth som them hadæ skabet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Eua, tyth naffn hauer hun omwenth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "til aue, thet hauæ wi allæ kenth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "oc Marie siunghæ ihuar wi ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Amen",
      "part": false,
      "marginal_notes": []
    }
  ]
}