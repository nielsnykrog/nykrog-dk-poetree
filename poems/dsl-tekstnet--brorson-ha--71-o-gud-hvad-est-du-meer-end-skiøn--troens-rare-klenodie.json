{
  "id": null,
  "title": "71. O GUd! hvad est du meer end skiøn",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
