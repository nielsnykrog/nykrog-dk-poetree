{
  "id": null,
  "title": "11. Konen ved Ledet i Frederiksdal",
  "year_created": 1858,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Vilhelm Kaalund",
    "country": null,
