{
  "id": null,
  "title": "Mosters Skiærmbræt",
  "year_created": 1830,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Digte",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1830,
    "url": "https://tekstnet.dk/books/andersen-hc_digte-1830/036/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Naar Kulden barsk sig nærmed’,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Naar Vintrens hvide Bier sværmed’,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Var der saa hjemligt og saa lunt i Mosters Stue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Paa Flisekakkelovnen saae man malet smukt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Hvorledes Jonas blev af Hvalen slugt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Idyllisk gnistred’ Ildens røde Lue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "For Dørene hang Tæpper og et paa Gulvet laae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Og grønne Tafts-Gardiner for Vinduet man saae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Paa Væggen var der i forgyldte Ramme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Med Tulipan i Haanden, en Madamme;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "(Saavidt jeg troer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Var det min Moders Bedstemoer).",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Desuden saae man al vor Slægt i Silhuetter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Men hvad der meest behaged’ mig og lille Fætter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Det var et Skjærmbræt, nydeligt at skue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Thi Billeder var klinet smukt derpaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Og jeg og Fætter, vi var’ den Gang smaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Og sad paa Skammelen i Mosters Stue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "Vi saae hvorledes, bort fra Paradiset",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "Adam og Eva løb af Frygt for Riset,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 0,
      "text": "Den Gang de havde gjort den gode Gud imod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 0,
      "text": "Kain flygtede med Mærket i sin Pande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 0,
      "text": "Syndflodens Vande",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 0,
      "text": "Gik over Skov og Bjerg. I Arken Noa bad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 0,
      "text": "Og Duen kom med Haabets Olieblad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 0,
      "text": "Ved Ørknens Kilde Hagar sad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 0,
      "text": "Og Drengen hvilte bleeg i hendes Skjød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 0,
      "text": "Det fæle Sodom’ sank i Flamme-Glød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 0,
      "text": "Vi hørte Josephs Klager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 0,
      "text": "Saae Pharaomed samt Ægyptens Plager.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 0,
      "text": "Her tog’ de Barnet Moses op af Vandet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 0,
      "text": "Der førte han, som Mand sit Folk til Canaans-Landet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 0,
      "text": "Med Spil og Sang drog Jephtas Datter ud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 0,
      "text": "Vildt hærged’ Samson, her stod Ruth som Brud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 0,
      "text": "Nu saae vi Drotten,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 0,
      "text": "Den bange Saul, hos Hexen hist i Grotten.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 0,
      "text": "Kong David sad med Harpen i sin Haand;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 0,
      "text": "Hist førtes Folket bort i Lænker og i Baand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 0,
      "text": "Imellem Fædre-Hjems Ruiner",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 0,
      "text": "Nomade-Skaren gik med Sorgens Miner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 0,
      "text": "Da lyste Stjernen for det taare-fyldte Øie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 0,
      "text": "Og Engle sang: »Jehova i det Høie.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 0,
      "text": "De hellige Konger tre ved Krybben stod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 0,
      "text": "Hvor Oxen kyssed’ Jesu-Barnets Fod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 1,
      "text": "– Saa tidt og gjerne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 1,
      "text": "Vi saae derpaa, og i vor lille Hjerne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 1,
      "text": "Fremstod en Verden underfuld og smuk.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 1,
      "text": "Men ak, en Morgen blev der Graad og Suk;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 1,
      "text": "Ved Døren holdt en Reisevogn – klart skinned’ Solen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 1,
      "text": "Den lille Fætter skulde langveis bort til Skolen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 1,
      "text": "– Jeg saae ham ei i hele otte Aar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 2,
      "text": "Men nu igaar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 2,
      "text": "Fortæller Moster: »lille Fætter kommer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 2,
      "text": "Endnu i Dag, og bli’er her for i Sommer.«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 2,
      "text": "Da blev jeg ret saa glad; hvert Barndoms Minde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 2,
      "text": "Randt mig isinde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 2,
      "text": "Jeg glemte reent, jeg alt var femten Aar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 2,
      "text": "Saa underligt mit Hjerte slaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 2,
      "text": "Da jeg ham hører komme. Ak, saa bange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 2,
      "text": "Jeg bag det gamle Skjærmbræt skjulte mig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 3,
      "text": "Han kyssed’ Moster, Gud, saa mange Gange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 3,
      "text": "Og sagde: »Hvor jeg længtes efter Dig!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 3,
      "text": "– Han var saa smuk, jeg havde knap ham kjendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 3,
      "text": "Men nu var han jo ogsaa en Student!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 4,
      "text": "Snart fandt han mig: ak, jeg var næsten død!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 4,
      "text": "Jeg følte, jeg blev ganske rød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 4,
      "text": "Ak, hvor hans Kys dog brændte, min Kind var lue-heed;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 4,
      "text": "Jeg slog mit Øie ned –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 4,
      "text": "Da stod en lille Dreng med Kogger og med Pile",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 4,
      "text": "Paa Skjærmen her;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 4,
      "text": "Ei før vi lagde Mærke til ham der,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 4,
      "text": "Nu syntes han saa ondskabsfuld at smile.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 4,
      "text": "Thi før, da jeg og Fætter vare smaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 4,
      "text": "Vi heller paa de andre Stykker saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 4,
      "text": "Nu vil han hævne sig med sine Pile.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
