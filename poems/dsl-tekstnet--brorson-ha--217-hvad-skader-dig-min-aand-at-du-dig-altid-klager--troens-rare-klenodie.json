{
  "id": null,
  "title": "217. Hvad skader dig, min aand, at du dig altid klager",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
