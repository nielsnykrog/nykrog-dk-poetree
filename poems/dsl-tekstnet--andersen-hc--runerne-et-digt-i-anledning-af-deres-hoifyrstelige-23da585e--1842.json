{
  "id": null,
  "title": "Runerne, et Digt i Anledning af deres Höifyrstelige Durchlauchtigheder Prinds Christian af Glücksborgs og Prindsesse Louise af Hessen-Cassels Höie Formæling den 26de Mai 1842",
  "year_created": 1842,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1842,
    "url": "https://tekstnet.dk/books/andersen-hc_runerne-et-digt-i-anledning-af-deres-hoeifyrstelige-durchlauchtigheder-prinds-christian-af-gluecksborgs-og-prindsesse-louise-af-hessen-cassels-hoeie-formaeling-den-26de-mai-1842/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Klinger, I Harper og Cymbler!",
      "part": false,
      "marginal_notes": [
        "Speaker: CHOR"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Der ligger et Slot i med Hegn af Rosentræer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "I Maanskin leged’ ved disse den lette Alfehær;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Den allersmukkeste Rose de kyssed’ paa Mund og Kind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Usynlige Runer da voxte i alle Blade ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Klinger, I Harper og Cymbler!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "To Börn af kongelig Stamme de nævned’, de for Dem bad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "De Tvendes hele Historie blev een paa hvert et Blad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Den læstes i Morgenröden af Alfernes hele Hær,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "En Rose er et Mysterie! hvad læste hver især!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Klinger, I Harper og Cymbler!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Hun dandser i Barne-Rækken",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Som Sylphiden svævende let!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Hun læser i Bogen ved Bækken,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Den risler derom en Sonet!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Hun er den kjærligste Datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Saa smuk og saa hjertensgod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Eet Rosenblad ikke omfatter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Saa herligt et Rosen-Blod!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "See der, som en kjæk Ungarer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Saa kraftig, saa slank og saa skjön,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "Paa Gangeren lystigt Han farer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "Man seer det er en Fyrste-Sön!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "Hun smiler og svinger med Klædet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 1,
      "text": "Han er hendes Barndoms Ven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 1,
      "text": "Hendes Fryd ham tidt har glædet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 1,
      "text": "Hun hans Sorg har deelt igjen!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Igjennem Kirken höit Orglet runger,",
      "part": false,
      "marginal_notes": [
        "Speaker: QVARTET"
      ]
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Rört hun sin Daabs-Pagt gjentager der;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "Ei hun veed hvad Droslen udenfor sjunger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "Tanken er hos Cherubernes Hær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "Gud alene raader for Lykken!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "Ved Rhinen under de grönne Ranker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "Sidder ved Bogen en Fyrste-Sön,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "Til Rosen i Danmark flyve hans Tanker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "Ned til ham flyve Tanker i Lön!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "Gud alene raader for Lykken.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "Kjærlighed! Du Hjertet bringer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "Hele Paradisets Lyst!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "Kjærlighed! paa dine Vinger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 3,
      "text": "Flyve vi til Himlens Kyst!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 3,
      "text": "(Mel.: Hr. Peder kasted’ Runer.)",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 3,
      "text": "Paa Rosens Blade Runerne de skreve,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 3,
      "text": "Ved Alfers Uskyldskys de Runer bleve!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 3,
      "text": "Nu Droslen slaaer i Birken,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 3,
      "text": "Den hilser paa de To,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 3,
      "text": "Som vandre hjem fra Kirken",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 3,
      "text": "Livsglade, fyldt med Tro!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 3,
      "text": "Gud med Dem! bede hvert et Hjerte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 3,
      "text": "I hver Fryd, under hver en Smerte:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 3,
      "text": "Gud med Dem!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 4,
      "text": "O læs dog de Blade til Ende.",
      "part": false,
      "marginal_notes": [
        "Speaker: QVINTET"
      ]
    },
    {
      "id": 52,
      "stanza_id": 4,
      "text": "Siig, hvad skal skee?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 4,
      "text": "»Sin Skjæbne Ingen tör kjende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 4,
      "text": "Ingen i Fremtiden see!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 4,
      "text": "Klinger, I Harper og Cymbler!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 4,
      "text": "Vi Alfer ere saa glade! vi dandse saa jublende hver!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 4,
      "text": "Der ligger et Slot i Danmark med Hegn af Rosentræer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 4,
      "text": "I deiligt Solskin her sidder det Brudepar ungt og smukt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 4,
      "text": "Vi bringe dem Havens Blomster og Træets bedste Frugt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 4,
      "text": "Klinger, I Harper og Cymbler!",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
