{
  "id": null,
  "title": "Fædrelandet. 28. Mai 1840",
  "year_created": 1840,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
