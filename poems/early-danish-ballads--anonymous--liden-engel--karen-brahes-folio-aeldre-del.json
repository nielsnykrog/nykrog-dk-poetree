{
  "id": null,
  "title": "Liden Engel",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA135.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Thett wor lyden Engell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hand wor buode fouffuer och bold;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "hand fuor seg weell op att land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "hand tager enn frue med wolde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: Ind er dagenn opliust! ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Hun heede lydden Maal-fred,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "thett nauffuen baar hun med prysz;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "for hynder luod hand sytt vnge lyff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "thett bleff thy buode wyss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Thett wor lydenn Engeell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "hand wogner om mydynatt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "vd-aff synn stercke drøme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "syger hannd saa offuer-bratt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "\"Meg tøgtte, att thend vll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "och saa denn vlleff graa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "thy hadde mynn hiertte vdi synn muond,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "saa wagenn som ieg luo.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "\"Thett er icke vnder, att y drømer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "och thett y drømer saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "i haffuer thagitt meg bortt med wold,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "spuorde icke mynn frennder till rad.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Ind kaam lyddenn smaa-dreng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "och steedis hand for buord;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "hand wore snild y thungenn synn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "hand kunde weell føffue synn ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "\"Hør y, lydenn Engeell!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "och weell y icke fly?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "her komer Giøde her Looumandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "paa firre vieee til by!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "\"Ieg redis icke for fyrre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "och ieg redis icke feem:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "och ycke for Giøde herre Luomand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "och icke for XXX mend!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "\"Thi er flerre ind firre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "och thi er flerre ind feem:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "thett er Giøde her Luomand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "med hundret webned mend.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Thett wor lyddenn Eenngell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "thog Mallfred y syn arum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "\"Thu kiende meg nogenn guode raad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "vdj wor herris nauffuen!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "\"Tager y eders suenne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "som y haffuer gyffuett brød;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "saa søgger wy Maary-kiercke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "meen oss trenger nød!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Tager y nu eders suene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "som reeditt haffuer edders heeste;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "søger y Maarri-kiercke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "som y kand allder-best!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "Thi luo der-for y dage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "weell y dage feem;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "alltt wor Giødde her Luomaand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 12,
      "text": "fremerst for alle deem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "Mellte thett Maall-freeds muoder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "hun waar hynder icke huld:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "\"Y breender aff Maary-kiercke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 13,
      "text": "och biuger hynd op med gulld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Tager wy buode guldt och søll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "och laader y skaallenn løøbe;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "er nu Maary kierke faall,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 14,
      "text": "y-dag well wy hynd kiøbe!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "Ildenn thuog tiell att briende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "och luoffuen leggtte fast ind;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "thett wor liddenn Mallfred,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 15,
      "text": "hun blegner y synn kieennd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "Ther waar saa hieett paa kieere-gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "alltt som den ild hun brende;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "ther waar langtt hieder y kierkenn inde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 16,
      "text": "der blyyett thog till att rinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "Melltte thett lydenn Engell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "hand wor y hoffuenn saa muod:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "\"Stynger wy woris heester y-hiiell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 17,
      "text": "wy swuller os y theris blod!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "Meelltte thett lyddenn smaa-dreng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "hand haffde thy heester kierre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "\"Stinnge wy lyddenn Maal-freed y-hieell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 18,
      "text": "denn død er hun wel werd!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "Thett wor lydenn Enggell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "tuog Maal-fred y aarme synn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "\"Thend død est thu icke werd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 19,
      "text": "hiart-allderkereeste mynn!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "Thi saatte hynder paa dy skiolde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "thi løfftte vnder hynder med spiud;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "saa løfftte the hynder saa sørgiendis",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 20,
      "text": "ad kierke-wyendu vd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 21,
      "text": "Thett wor lydenn Mall-freed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "hun ganger om keere-gaard;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 21,
      "text": "sueenne saa war hyndis kleeder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 21,
      "text": "brend saa waar hyndis hard.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 22,
      "text": "Tog dy lydenn Mall-fred,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 22,
      "text": "suøbtte hynder y kaabben blaa;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 22,
      "text": "løfftte thi hynder saa sørgendis",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 22,
      "text": "paa thend ganger graa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 23,
      "text": "Thett meelltte lyddenn Mall-fred,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 23,
      "text": "hun kaam y grønen lund:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 23,
      "text": "\"Y-dag brennder Maary-kierke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 23,
      "text": "och en saa rask en suend!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 24,
      "text": "I-dag breender Maary-kiercke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 24,
      "text": "och enn saa rask enn mand;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 24,
      "text": "alddrig komer hand sliggenn igenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 24,
      "text": "her paa thene land!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 25,
      "text": "Thett wor icke lennger effter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 25,
      "text": "altt y deene same høst:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 25,
      "text": "ganger hun seg till bure,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 25,
      "text": "hun fødde en sønn saa thrøst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 26,
      "text": "Thaa baar thi hanom till kierke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 26,
      "text": "chrestenett hanom om en natt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 26,
      "text": "dy kalltte hanom lydenn Engell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 26,
      "text": "dy døltte hanom, sa lenge dy maatte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 27,
      "text": "Fosterritt hun hanom y wynther,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 27,
      "text": "och fostritt hun hanom y ny;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 27,
      "text": "thett bleff enn denn wenneste ridder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 27,
      "text": "mand matte med øgen siee.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 28,
      "text": "Fosterritt hun hanom y wintter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 28,
      "text": "och fosterritt hun hannom y syu:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 28,
      "text": "\"Thyn morbroder slog dynn faader ihieell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 28,
      "text": "thett sigger ieg deeg nu!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 29,
      "text": "Saa forstrett hun hanom y wyntter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 29,
      "text": "och fosterritt hun hanom y feem:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 29,
      "text": "\"Dynn morbroder slog dynn faader ihiell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 29,
      "text": "thett siger ieg dieg!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 30,
      "text": "\"Hør y, mynn kieerre muoder!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 30,
      "text": "y er weell suøbtt y mord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 30,
      "text": "ieg weell ride meg vnder øø",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 30,
      "text": "och thiene y konngens gaard.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 31,
      "text": "\"Ryd thu theg tiell kongenns gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 31,
      "text": "thu thiener med hedder och erre;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 31,
      "text": "thinn mordbroder sloug dynn faader y-hieell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 31,
      "text": "ieg sigger theeg thett aldrig meerre!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 32,
      "text": "Hand thyenntte saa lenge y konngens gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 32,
      "text": "till kongenn bleff hanom hold;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 32,
      "text": "naar dy anddre rider legtte och luo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 32,
      "text": "daa war hand sorig-fuld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 33,
      "text": "Thett wor daner-kongenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 33,
      "text": "och hand mone hanom huoff-suaale:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 33,
      "text": "\"Hør thu, lydinn Engeell!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 33,
      "text": "huy sørger thu saa saarre?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 34,
      "text": "Du sørgger deeg saa saare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 34,
      "text": "som lyden fuoll paa quest;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 34,
      "text": "thu est som thend ieeneste mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 34,
      "text": "ther alle synne frender haffuer miest.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 35,
      "text": "\"Hør y, daaner-kongenn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 35,
      "text": "meg er saa møgett y-muod:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 35,
      "text": "myn morbroder slog myn faader i-hieell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 35,
      "text": "der gyck aldrig for buod!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 36,
      "text": "\"Ieg weell laanne theg aff mynn meend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 36,
      "text": "rider och guode suenne;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 36,
      "text": "saa ryd thu theeg bortt vnder øø",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 36,
      "text": "dynn faaders død att heffne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 37,
      "text": "Wylltt du heffuenene dynn faaders dødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 37,
      "text": "thett er saa well till maade;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 37,
      "text": "thre C meend thaa laaner ieg dieg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 37,
      "text": "buode y haarnesk och y plaadde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 38,
      "text": "Thett wor lydenn Engell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 38,
      "text": "hand rider y grønen lund;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 38,
      "text": "ther webner hand alle synn mennd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 38,
      "text": "vdi saa snaar en stund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 39,
      "text": "Ind kaam lydenn smaa-dreng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 39,
      "text": "och steedis hand for buord;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 39,
      "text": "hand waar snyld y konge synn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 39,
      "text": "hand kunde weell fyøffue syn ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 40,
      "text": "\"Hør y, guodenn Laumend!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 40,
      "text": "och weell y icke fly?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 40,
      "text": "her komer lyddenn Engell",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 40,
      "text": "och firre vieee fraa by!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 41,
      "text": "Her komer lydenn Engell",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 41,
      "text": "och firre vieee till by;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 41,
      "text": "hand er seeg y hoffue saa wreed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 41,
      "text": "haand førr synn haarnsk y skyø!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 42,
      "text": "\"Ieg haffuer weritt saa wyde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 42,
      "text": "buode till tienge och støffne:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 42,
      "text": "aldrig kaam ieg till denn stieed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 42,
      "text": "ieg hørrde lyden Engell nøffne.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 43,
      "text": "Thett wor Giøde Laumand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 43,
      "text": "klaper hanom weed huyddenn kynnd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 43,
      "text": "\"Wedstu nogenn guode raad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 43,
      "text": "keerre smaa-dreng mynn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 44,
      "text": "\"Wedste ieg nogen guode rad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 44,
      "text": "ieg sagde eedder denom heeldst;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 44,
      "text": "søgger wy nu wor stieen-stuoffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 44,
      "text": "y-mens wy threnger ald-miest!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 45,
      "text": "Dy weegge dy er aff mollmer-steen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 45,
      "text": "thy dørre thy er aff bly;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 45,
      "text": "thett skaall gaa fuld-vnderlig tiell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 45,
      "text": "om thi thager oss der-y!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 46,
      "text": "Sette dy denn stienn-stuoffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 46,
      "text": "weell firre wiee om-krynng;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 46,
      "text": "seelluff war lydenn Engell",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 46,
      "text": "fremerst y thend rinng.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 47,
      "text": "Thett wor Giødde Luomand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 47,
      "text": "hand vd aff winduet suo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 47,
      "text": "\"Huem er her for-vdenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 47,
      "text": "men y basker saa?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 48,
      "text": "Suaridtt thett lydenn Engell",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 48,
      "text": "vnder synn skaarlagen-skiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 48,
      "text": "\"Thett er ieg, lidenn Engell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 48,
      "text": "kier søster-sønn dynn!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 49,
      "text": "Suaridtt thett Giødde Luomand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 49,
      "text": "vd-aff saa møgenn harum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 49,
      "text": "\"Thett tødst thu liditt aff rosze,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 49,
      "text": "thu est ett sleffred-baarnn!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 50,
      "text": "\"Er ieg meg ett sleffred-baarn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 50,
      "text": "tha er ieg aff thi beste:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 50,
      "text": "nock haffuer ieg buode søluff och guld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 50,
      "text": "och rider och høffske heste!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 51,
      "text": "Ieg er ind ett sleffred-baarnn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 51,
      "text": "thett haffuer thu møggitt y wolden;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 51,
      "text": "noch daa haffuer ieg skoffue saa grøne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 51,
      "text": "och der-til borig saa bold!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 52,
      "text": "Thager wy nu buode søluff och guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 52,
      "text": "wy laader thett samell løbe:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 52,
      "text": "breender wy aff denn stien-stuoffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 52,
      "text": "wy for-maar hynder well att købe!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 53,
      "text": "Ther waar hyeett y for-stoffuenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 53,
      "text": "thett bly tog till att rinde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 53,
      "text": "well war der hieeder y stuoffuen inde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 53,
      "text": "thend ild tog til at brinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 54,
      "text": "Thett wor lyddenn Engell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 54,
      "text": "hand weende synn ganger om-krinng;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 54,
      "text": "icke wilde hand aff gaarden ridde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 54,
      "text": "førind stoffuenn den waar breend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 55,
      "text": "Lydenn Engell red aff gaarde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 55,
      "text": "sluo op med huyden hand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 55,
      "text": "der hand suo synn mor-broder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 55,
      "text": "luo y brendendis brannd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 56,
      "text": "Thett wor lydenn Engeell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 56,
      "text": "hand war saa wred y synde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 56,
      "text": "\"Nu haffuer du fangitt denn saame død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 56,
      "text": "som du gaff faader mynn!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 57,
      "text": "Thett war lydenn Enngell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 57,
      "text": "red y synn muoders gaard;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 57,
      "text": "wde stuod hans kerre muoder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 57,
      "text": "hun waar well suøbtt y muord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 233,
      "stanza_id": 58,
      "text": "\"Her stander y, myn keer mooder!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 234,
      "stanza_id": 58,
      "text": "y er weell suøbtt y skieend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 235,
      "stanza_id": 58,
      "text": "nu haffuer ieg weritt meeg op paa land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 236,
      "stanza_id": 58,
      "text": "myn faaders død ieg høffnett.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 237,
      "stanza_id": 59,
      "text": "Thett war fru Mall-fredt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 238,
      "stanza_id": 59,
      "text": "hun greed och hiender hun sluo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 239,
      "stanza_id": 59,
      "text": "\"Førre daa haffde ieg ien daglig sorrig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 240,
      "stanza_id": 59,
      "text": "nu haffuer ieg thuo!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 241,
      "stanza_id": 60,
      "text": "Thett worr lyddenn Engeell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 242,
      "stanza_id": 60,
      "text": "hand rand taar paa kieend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 243,
      "stanza_id": 60,
      "text": "\"Thett weell ieg for sanndingenn sygge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 244,
      "stanza_id": 60,
      "text": "att vnderlig er synde dynn!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 245,
      "stanza_id": 61,
      "text": "Lyddenn Engell weender synn hest om-kring,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 246,
      "stanza_id": 61,
      "text": "saa snart red hand aff gaarddenn;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 247,
      "stanza_id": 61,
      "text": "igenn stuod hans kierre muoder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 248,
      "stanza_id": 61,
      "text": "hun feelder saa muodige thorre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 249,
      "stanza_id": 62,
      "text": "Thett wor lydenn Enggell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 250,
      "stanza_id": 62,
      "text": "red op y kongens gaard;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 251,
      "stanza_id": 62,
      "text": "vde stuod daner-kongenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 252,
      "stanza_id": 62,
      "text": "hand waar weell suøbtt y mord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 253,
      "stanza_id": 63,
      "text": "Thett wor lyddenn Engell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 254,
      "stanza_id": 63,
      "text": "hand gaar for kongenn ind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 255,
      "stanza_id": 63,
      "text": "\"Y haffuer thaack, daaner-konngenn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 256,
      "stanza_id": 63,
      "text": "for alle eders edelig meend!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 257,
      "stanza_id": 64,
      "text": "I haffuer tack, daaner-konngenn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 258,
      "stanza_id": 64,
      "text": "for alle edders guode mennd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 259,
      "stanza_id": 64,
      "text": "nu haffuer ieg weritt meg op-att laand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 260,
      "stanza_id": 64,
      "text": "myn faaders død at høffne.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 261,
      "stanza_id": 65,
      "text": "\"Hør du, lyddenn Engell!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 262,
      "stanza_id": 65,
      "text": "kierre seelle mynn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 263,
      "stanza_id": 65,
      "text": "huor lidder skønne Maalfreed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 264,
      "stanza_id": 65,
      "text": "kierre mouder dyn?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 265,
      "stanza_id": 66,
      "text": "Huad wilde du sygge, lyddenn Engell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 266,
      "stanza_id": 66,
      "text": "keerre seelle myn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 267,
      "stanza_id": 66,
      "text": "om ieg wilde luoffue fru Mall-fred",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 268,
      "stanza_id": 66,
      "text": "till allerkereste mynn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 269,
      "stanza_id": 67,
      "text": "Suaridtt thett lydenn Engell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 270,
      "stanza_id": 67,
      "text": "haand stuod y skaarlagenn-skiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 271,
      "stanza_id": 67,
      "text": "\"Daa well ieg ride meg op att laand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 272,
      "stanza_id": 67,
      "text": "och taalle med muoder mynn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 273,
      "stanza_id": 68,
      "text": "\"Hør thu thett, lydenn Engell!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 274,
      "stanza_id": 68,
      "text": "ieg skieelle dieg weed denn quide;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 275,
      "stanza_id": 68,
      "text": "thu skalt følge meg op att laand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 276,
      "stanza_id": 68,
      "text": "saa weell wy ride dyd.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 277,
      "stanza_id": 69,
      "text": "Kongenn red y fru Mall-freds gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 278,
      "stanza_id": 69,
      "text": "thett wor løst att lydde der-paa;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 279,
      "stanza_id": 69,
      "text": "frem daa gyck denn wenne fru,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 280,
      "stanza_id": 69,
      "text": "hun gaff den herre synn thro.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 281,
      "stanza_id": 70,
      "text": "Kongenn hand luod denn weenne wyff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 282,
      "stanza_id": 70,
      "text": "thett wor en fru saa ween;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 283,
      "stanza_id": 70,
      "text": "hand gaff hind lydenn Engell synn søster,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 284,
      "stanza_id": 70,
      "text": "thett wor enn iumfru skønn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 285,
      "stanza_id": 71,
      "text": "Thett wor icke lenger der-eftter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 286,
      "stanza_id": 71,
      "text": "maanetter for-vdenn thuo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 287,
      "stanza_id": 71,
      "text": "thett wor danner-kongenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 288,
      "stanza_id": 71,
      "text": "luod beggis dieris brølup buo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 289,
      "stanza_id": 72,
      "text": "Nu haffuer skønne fru Maall-fred",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 290,
      "stanza_id": 72,
      "text": "forwondenn all synn haarum;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 291,
      "stanza_id": 72,
      "text": "hun er en weeldig droning,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 292,
      "stanza_id": 72,
      "text": "hun suoffuer y kongenns arum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 293,
      "stanza_id": 73,
      "text": "Nu haffuer lyddenn Enggell",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 294,
      "stanza_id": 73,
      "text": "forwondenn all synn quidde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 295,
      "stanza_id": 73,
      "text": "hand haffuer høffnitt synn faaders død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 296,
      "stanza_id": 73,
      "text": "kongens søster suoffuer huoss hans sydde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 297,
      "stanza_id": 73,
      "text": ":: Och nu er dauffuenn op-liust! ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}