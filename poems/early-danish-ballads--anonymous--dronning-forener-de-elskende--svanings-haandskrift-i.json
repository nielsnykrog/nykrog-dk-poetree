  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Svanings Håndskrift I",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1590,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/SVI115.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Her er een Iomfru paa worth land, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "det er saa høfsk en lilie vand |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "den venniste lilie paa dette land |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: hun gaas | mig aldrig aff huue. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Paa wort landt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "ther er saa skiøn een lilie wand, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "hun er høuisk, oc hun er huid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "hun er dannis | oc dÿdelig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "her en Iomfru paa worth landt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "hun gaaes mig aldrig aff hue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": ":: I. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Hun er huid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "hun er danes oc dÿdelig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "ther thien-ner een suend i Kongens gaard",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "hand slider rød | skarlagen drager maar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": ":: H e e I. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "I Kongens gaard",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "hand slider rød skarlagen dragir maar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "hand kand icke søffuen om natten soffue |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "saa er then Iomfru i hans hue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": ":: H e e I. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "Om natten soffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "saa er den Iomfru ÿ hans huue |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "hun haffuer och hannem i hierted kier",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "for alle | thi i werden er",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 4,
      "text": ":: H e e I h e. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "I hierted kier",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "for alle the ÿ werden ehr",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "thet stod | saa eth Aar eller to,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": "ingen det weste oc ingen der fro |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 5,
      "text": ":: H e e I p. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "Eth Aar eller 2",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "ingen det viste oc ingen det fraa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": "denn herre skulde leding faare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 6,
      "text": "then Iomfru | gred hun skulle hieme were.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 6,
      "text": ":: H e. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 7,
      "text": "I leding faare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": "then Iomfru gred hun skulle | hiemme wære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 7,
      "text": "hand klappet hinde wed huiden | kind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 7,
      "text": "thu sørge icke aller kieriste min. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 8,
      "text": "Wed huiden kind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 8,
      "text": "thu sørger icke aller kieriste min |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 8,
      "text": "ieg skall kiøbe dig agger wld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 8,
      "text": "eth saa skiønt eth | howed guld. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 9,
      "text": "Agger wld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 9,
      "text": "eth saa skiønit eth houed guld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 9,
      "text": "ieg vil | icke hoffued guld bere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 9,
      "text": "men ieg skal ÿ leding were |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 10,
      "text": "Hoffued guld bere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 10,
      "text": "men ieg skal i leding vere |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 10,
      "text": "mith godtz det will ieg Kongenn giffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 10,
      "text": "om i maa | i landet bliffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 10,
      "text": ":: H e. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 11,
      "text": "Kongen giffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 11,
      "text": "om ÿ maa ÿ landet bliffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 11,
      "text": "dronningen staar oc lÿder der paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 11,
      "text": "saa forstandig hun er | wnder skarlaggen smaa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 11,
      "text": "i skall begges eders wilie faa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 12,
      "text": "Lÿdder der paa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 12,
      "text": "ÿ skall beggis eder villie faa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 12,
      "text": "thu skalt icke ÿ leding roo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 12,
      "text": "ieg skal aldrig | brøllup booe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 12,
      "text": ":: H. e e. I. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 13,
      "text": "I leding roo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 13,
      "text": "ieg skal aldrig Brøllup booe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 13,
      "text": "est du | hinder noget for rig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 13,
      "text": "tha er hun dig far dÿdelig |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 13,
      "text": ":: her er en Iomfru paa wort landt, hun gaars | mig aldrig aff hue. | ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}