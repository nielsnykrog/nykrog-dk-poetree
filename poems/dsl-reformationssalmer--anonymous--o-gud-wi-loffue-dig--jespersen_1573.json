  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Gud wi loffue dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "wi bekiende dig en Herre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Dig en euig Fader/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "priser den gantske Verden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "Det samme giør alle Engle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "Himlene oc alle veldige Engle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Din priss siunge Cherubin oc Seraphin/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "met it waffladeligt stemme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "Hellig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "Hellig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "Hellig est du Herre Gud Zebaoth.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "Himlene oc Jorden er opfylt met din Maiestatis ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 6,
      "text": "Den er lig forsamling dine Apostlers tall/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "dig loffue oc bekiende en Herre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 7,
      "text": "Lige saa giør oc altid det hellige tall dine Propheters.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 8,
      "text": "Den gantske skare dine hellige Martirers/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 8,
      "text": "dit hellige Naffn loffue oc prise.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 9,
      "text": "Alle Gudfryctige oc vdualde loffue oc bekiende dig i all Verden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 10,
      "text": "En wbegribelig maiestatis Fader.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 11,
      "text": "Din sande ærefuld enbaarne Søn Jesum Christum/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 11,
      "text": "tro wi at være lig met dig i Guddommen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 12,
      "text": "Dertil den hellig Aand sandelig at være allis vor trøstermand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 13,
      "text": "O Herre Christe/ du est ærens Konning.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 14,
      "text": "Du est din Faders euige Søn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 15,
      "text": "Jomfruens liff vaar dig icke vederstyggelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 15,
      "text": "til at anamme Mandom oc forløse alle vdualde Menniske.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 16,
      "text": "Du haffuer offueruundet den bittre pine Dødsens sting/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 16,
      "text": "oc oplat alle som tro paa dig Himmerigis rige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 17,
      "text": "Derfor sider du nu hoss Guds høyre haand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 17,
      "text": "i euig maiestatis ære met din Fader.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 18,
      "text": "Oc saa tro wi at du her effter vorder tilkommendis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 18,
      "text": "en streng Dommere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 19,
      "text": "Derfor O Herre wi formane dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 19,
      "text": "hielp dine tro Tienere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 19,
      "text": "som du forløste met dit dyrebar Blod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 20,
      "text": "Dine venner giør deelactige i den euig ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 20,
      "text": "met dit hellige oc vdualde Folck.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 21,
      "text": "O Herre frelss dit Folck/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 21,
      "text": "oc velsigne dem som ere din Arff oc Eiedom.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 22,
      "text": "Regere oc lær dem/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 22,
      "text": "oc ophøye dem til euindelig tid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 23,
      "text": "Wi benedide dig Gud i euighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 23,
      "text": "oc ære dig dag fra dag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 24,
      "text": "Oc loffue dit naffn til euig tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 24,
      "text": "nu oc altid oc euindelig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 25,
      "text": "O Herre verdis at beuare oss i dag oc altid fra Synden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 26,
      "text": "Miskunde dig offuer oss O Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 26,
      "text": "oc forbarme dig offuer oss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 27,
      "text": "O Herre din miskundhed bliffue offuer oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 27,
      "text": "Saa som wi oss paa dig forlade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 28,
      "text": "Til dig Herre staar all vort haab/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 28,
      "text": "derfor lad oss icke bliffue til skendzel euindelig.",
      "part": false,
      "marginal_notes": []
    }
  ]
}