{
  "id": null,
  "title": "Mettelille og Dronning Sofie",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA43.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Frw Mallfred hun seder y burre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hun lerde syn datter saa prud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": ":: Selleff lader hun seg well. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "\"Tthu wogtte thig will for munde-glam!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "saa giør du ochsaa for drockenn mand!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "Tthu wogtte theg for her Nellus saa bold:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "saa mangen stalt innfrwe thager hand med wold.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "\"Her Niellus hand er saa dane en mand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "och ingen skøn iunfru saa giør hand skaam.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "Tthi weste icke anditt, ind dy wor iene thuo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "vd stuod her Nelus, hand liude der-paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "Her Nellus hand ind aff døren thrend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "frw Mallfred hun stander hanom op igenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "\"Her seder y, frw Mallfred, y sømer dy linn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "giffuer meg stalt Metelild till høstru mynn!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "Frw Malfred hun bleff saa bratt till suarre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "\"Hindis fader skall hindis gyffter-maall rade.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "Her Nellus hand drager buod sabell och mord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "saa rider hand seg y daner-kongens gaard.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "Mett y gaard der axler hand skiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "saa gaar hand i lofft for daner-kongen ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 10,
      "text": "\"Hell seder y, daner-kongen, drecker klarre wynn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "well y giffue meg stalt Mettelild til høstru mynn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 11,
      "text": "\"Sttalt Mettelild skalt du well faa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "och XV borig vde wed aaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 12,
      "text": "Ieg skal ind-daa giffue hinder merre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "Riber-husz med all sinn rede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 13,
      "text": "Ieg skall giffue hinder gyllte karem saa rød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 13,
      "text": "droning Soffi hun skall dyn vnge brud hiem-førre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 14,
      "text": "Ieg well giffue hinder axell-seng:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 14,
      "text": "droning Soffe skall førre ditt vnge brud hiem.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 15,
      "text": "Tthett suaritt droning Soffe vd-aff stuor harum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 15,
      "text": "\"Thett er ind for møgit til ett sleffred-barnn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 16,
      "text": "\"Du thi quer, droning Soffi, suar der inthett till!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 16,
      "text": "ieg giffuer myn datter, huad ieg well.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 17,
      "text": "Dy rade till brøllupitt y maniter V:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 17,
      "text": "stalt Mette-lild glede sig aldrig y dem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 18,
      "text": "Tthi førde den brud y her Nellus gaard:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 18,
      "text": "ther war icke røde guld for liegeren spardtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 19,
      "text": "Tthi fulde bruden y sallen ind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 19,
      "text": "efter ginge dy rider, dj bar hindis skiend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 20,
      "text": "Tthi saatte bruden paa brude-benck:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 20,
      "text": "ther gick frem dy rider, dy bar hinder skenck.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 21,
      "text": "Droning Soffe hun thaller till iumfrw synn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 21,
      "text": "\"Du hentte meg ind ett horrnn med winn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 22,
      "text": "Tthu hientte meg ind mit dyr-bar hornn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 22,
      "text": "thu skalt kaste der-y ett ieder-kornn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 23,
      "text": "Tthend iumfru hun ind y sallen thrend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 23,
      "text": "med guld-bonden hornn y huiden heend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 24,
      "text": "Tthett hornn war vden med røde guld smed:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 24,
      "text": "for inden war denn med ieder blend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 25,
      "text": "Droning Soffe hun dreker den vnge brud till:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 25,
      "text": "den vnge brud sagd niee, hun icke wilde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 26,
      "text": "\"Och welt du nu icke drecke med meg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 26,
      "text": "dyn fader skal ieg giør wred paa dieg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 27,
      "text": "\"Allt førind myn fader skuld bliffue meg wred:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 27,
      "text": "daa skall ieg ind drecke, dog thett bliffuer stuor nød.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 28,
      "text": "Staltt Mettelild thog hornn, och aff hun drack:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 28,
      "text": "guld-belltet om hindis side sprack.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 29,
      "text": "Sildig om afften, røg fald paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 29,
      "text": "den vnge brud løster til senge att gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 30,
      "text": "Tthi fulde bruden till brude-husz:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 30,
      "text": "for ginge di rider, bar brude-blaasz.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 31,
      "text": "Dy saatte bruden y bruden seng:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 31,
      "text": "her Nelus hand duelde icke møgitt lenge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 32,
      "text": "Daner-kongen hand luogte den brud-husz-dør brat:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 32,
      "text": "\"Her Nelus och stalt Metelild! Gud giffue eder guod nat!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 33,
      "text": "Orlig om morgen, der dagenn wor liusz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 33,
      "text": "hindis moder hun kaam y brude-husz.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 34,
      "text": "\"Gud maarnn, gud marnn, her Nelus saa brat!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 34,
      "text": "huor haffuer y lid med eders vnge brud y natt?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 35,
      "text": "\"Hun haffuer wreedt seg och weend seg som oxe y kloffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 35,
      "text": "thend lange natt kund hun icke soffue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 36,
      "text": "\"Hør thu, stalt Mettelild, datter minn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 36,
      "text": "du gack paa gioldit till moder dyn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 37,
      "text": "Statt op, stalt Mettelild, och kled thu theg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 37,
      "text": "thu skalt til kierike med droning Soffi ind.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 38,
      "text": "\"Saa men, myn kerr moder, daa well ieg saa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 38,
      "text": "ieg wel til kerke och aldrig fraa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 39,
      "text": "Fuld vsen bleff y daner-kongens sleffreds-wyff:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 39,
      "text": "ther-for maa ieg lade mit vnge lyff.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 40,
      "text": "Saa bratt kaam buod for daner-kongen ind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 40,
      "text": "hand skuld gaa i brude-husz til dater syn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 41,
      "text": "Alt saa bluott, alt som hand daa stuod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 41,
      "text": "saa mone hand ind y brude-husz gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 42,
      "text": "Daner-kongen ind at dørren thrend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 42,
      "text": "her Nielus recker han reecker hanom handen igen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 43,
      "text": "\"Gud maren, her Nelus, myn søn saa brat!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 43,
      "text": "huor haffuer teg lid med dyn vnge brud y nat?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 44,
      "text": "Hør thu, stalt Mettelild, kerre datter myn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 44,
      "text": "hui blegner saa din rosens-kiend?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 45,
      "text": "\"Fuld vsenn bleff myn moder eders sleffred-wyff:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 45,
      "text": "ther-for maa ieg lade mit vnge liff.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 46,
      "text": "Stalt Mettelild klaffuer seg wock och wee:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 46,
      "text": "thett horde droning Soffe, saa hiartelig mone hun liee.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 47,
      "text": "Tthett hørde droning Soffe, saa hiartelig hun luo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 47,
      "text": "stalt Mettelild døde y thend same wiee.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 48,
      "text": "Her Nellus feck aldrik en større harum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 48,
      "text": "stalt Metelild sualt vdj hans arum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 49,
      "text": "Danerkongen drog suerdt vnder skaarlagen rød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 49,
      "text": "hand woo droning Soffi til iorden dø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 50,
      "text": "Her Nielus sat hialtenn imod ett stienn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 50,
      "text": "aaaden thend giordde hans hiartte stuor mienn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 51,
      "text": "Der kaam vd aff her Nelus bure",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 51,
      "text": "thrende lig, dy war saa purre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 52,
      "text": "Tthett iene her Nelus, thett andit hans møø:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 52,
      "text": "droning Soffi, hun matte for suerdit død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 53,
      "text": "Ther war løst y daner-kongens gaard:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 53,
      "text": "kongen drok brølup med sinn sleffred-mord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 54,
      "text": "Hand giord droning Soffis frender til harum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 54,
      "text": "hand lagde sin sleffred y syn arum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 54,
      "text": ":: Selleff lader hun seeg well. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}