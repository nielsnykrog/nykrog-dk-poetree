  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Lasciuus iuuenis ego sum viuens per amorem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Sum calidus veneris, equitando viam gero florem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Migh tyckær nw saa vti myt sind:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Ieg wil ey sparæ ey mø, ey quind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "myn vngdom wil ieg forthæræ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "meth fruær och møer, the giffuæ mig gaffuæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "sielff wil ieg hoes them wæræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Jeg wil them kyssæ och taghæ i faffn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "tog thet er mig til lidhet gaffn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Ieg mothæ wæl ladhæ mig nøyæ",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "han fyl mig effther ihuort ieg gaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "mig siælff fran syndhen at bøyæ.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
