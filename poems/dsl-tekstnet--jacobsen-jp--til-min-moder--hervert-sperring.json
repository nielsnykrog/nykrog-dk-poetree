  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O! husker du Moder, den Gang jeg var lille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Jeg lagde mit Hoved saa glad i dit Skjød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Naar Tusmørkets Time den milde og stille",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Var kommen og Dagen den lyse var død?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Da sang du med sagte og vemodig Stemme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "De Sange, du jubled', da Modet var ungt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "De Sange, hvis Klang jeg endnu kan fornemme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Naar Tanken er trættet og Hjertet er tungt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Vel hørte jeg Toner langt skjønnere siden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Vel læste jeg Sange med stoltere Flugt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Mest elsker jeg dem dog, jeg hørte som Liden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Thi de bar for mig dog den rigeste Frugt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "De vakte en Længsel saa stærk i mit Hjerte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Der toned' fra Læben som Digt og som Sang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "De blev for min Tanke en lysende Kjerte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Der styrer mod Skjønhedens Rige min Gang.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
