    "url": "https://tekstnet.dk/books/skjoldborg-j_dynaes-digte/022/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Sommeren er en skønne Ti’,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "saa er da Fowlen saa glaah og fri,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "saa flywer ogsaa den bette Bi",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "te’ oll’ de Blomster, blaa og røde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Lywet er hverken Pin’ hell Plaw,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "a er nu midt i min Sommerdaw,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "a lier ogsaa saa godt at draw",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "te’ oll’ de Blomster, blaa og røde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Pigerne gror som Blomster op;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "no’n har en Fletning og no’n en Top,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "no’n er en Rose og no’n en Knop",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "— oll Slaws Blomster, blaa og røde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Sig mig en Gang, hvad Sol vild’ mjen’,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "hvis den en laangele Daw skuld’ tjen’",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "uden at smile til Pigern’ og skjen’",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "paa oll’ de Blomster, blaa og røde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 0,
      "text": "Solskin og Sommer, Tidsfordryw!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 0,
      "text": "Smiler En til’et, det hvidsker blyw,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 0,
      "text": "det er jo Glæderne ved Ens Lyw",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 0,
      "text": "og oll’ de Blomster, blaa og røde.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
