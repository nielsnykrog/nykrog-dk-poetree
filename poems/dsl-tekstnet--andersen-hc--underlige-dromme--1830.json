{
  "id": null,
  "title": "Underlige Drömme",
  "year_created": 1830,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1830,
    "url": "https://tekstnet.dk/books/andersen-hc_underlige-droemme/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Det er saa stille i vor By,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Thi det er kun ved Morgen-Gry;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Man seer ei Hund, man seer ei Kat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Selv Vægteren har sagt: »God Nat!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Han sidder i et Kjælder-Skuur,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Og faaer sig der en lille Luur. –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Tre Haandværkssvende gaae forbi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "De vandre bort i Compagni;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Paa Ryggen har de hele Klatten,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Og Voxdugs Overtræk om Hatten;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "De ere glade hver og een,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Thi de har unge, raske Been;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "En Smed, en Skræder og en Bager",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Er det, som nu paa Vandring drager.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Man snart kun Byens Taarne seer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Der Solens første Straale leer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Men hvor de Svende komme frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Som Konger Alt modtager dem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Det Hele røber noget stort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Dem Skoven staaer som Ære-Port;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Vel er ei Borgerskabet der,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "Men Skovens Fugle synge her,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "Det gaaer saa peent i Mol og Dur,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "Som om det Hele var Natur!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 1,
      "text": "Det er smukt, hvorhen de see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 1,
      "text": "Saa Hjertet ordenligt maa lee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 1,
      "text": "Ja, det vil gjennem Bryst og Frak,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 1,
      "text": "For selv at sige: »mange Tak!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Men som de gaae i Skoven frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "En deilig Qvinde møder dem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "Hun har græsgrøn Kjole paa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "Og Vinger smukt fra Skuldren gaae;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "Hun bærer frem et gyldent Horn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 2,
      "text": "Med smukke Blomster, Frugt og Korn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 2,
      "text": "kalder Verden hende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 2,
      "text": "Hun hilser vore Ungersvende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 2,
      "text": "Og skjænker dem med venligt Sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 2,
      "text": "Et Æble, rødt som hendes Kind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 2,
      "text": "Et Lykkens-Æble nok saa smukt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 2,
      "text": "Og svinder saa bag Skovens Bugt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 3,
      "text": "De Svende glad paa Æblet see;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 3,
      "text": "Men, Herre Gud! de er jo tre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 3,
      "text": "Og Æblet kan de ikke dele,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 3,
      "text": "Thi Lykken boer kun i det Hele.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 3,
      "text": "Der tænkes ud, der tænkes ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 3,
      "text": "Men Tanken bliver dog til Vind;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 3,
      "text": "Tilsidst staaer Skræderen da frem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 3,
      "text": "Og dømmer saadan mellem dem:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 3,
      "text": "At alle tre, paa dette Sted",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 3,
      "text": "Skal lægge sig paa Jorden ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 3,
      "text": "Og Æblet vil de den tildømme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 3,
      "text": "Der har de underligste Drømme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 3,
      "text": "Thi lægge de sig strax til Ro. –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 3,
      "text": "– Der gaaer en Time – der gaaer to –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 3,
      "text": "Men endeligt de sig da røre. –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 3,
      "text": "– Nu skal vi deres Drømme høre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 4,
      "text": "»Mit er da Æblet!« siger Smeden;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 4,
      "text": "»Jo jeg har været fælt i Heden;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 4,
      "text": "Ja værre end man muligt troer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 4,
      "text": "I Drømme jeg til Helved’ foer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 4,
      "text": "Det var en Smede lang og bred,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 4,
      "text": "Og den var Fanden selv for heed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 4,
      "text": "Der var en Larm, der var en Støi!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 4,
      "text": "Og Djævle kom og atter fløi;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 4,
      "text": "Den smiilte sødt, den hele Slægt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 4,
      "text": "Og kaldtes der: en hellig Sekt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 4,
      "text": "Paa Bibelen de smeded hen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 4,
      "text": "Gud kjendte den vist knap igjen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 4,
      "text": "Paa Hovedet blev sat hvert Ord;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 4,
      "text": "De fange vil den hele Jord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 4,
      "text": "Ja, binde Tanken og Fornuften;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 4,
      "text": "Med Taage fyldtes hele Luften,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 4,
      "text": "Og hvem de fangede hvert Aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 4,
      "text": "De bleve kaldte: Troens Faar!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 5,
      "text": "Men Skræderen begyndte nu:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 5,
      "text": "»Jeg drømte mere sært end Du!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 5,
      "text": "Jeg var saa luftig, som en Myg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 5,
      "text": "Og Vinger voxte paa min Ryg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 5,
      "text": "Ja, uden at jeg veed hvordan,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 5,
      "text": "Med eet jeg kom til Himlen an.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 5,
      "text": "Den var saa stor, den var saa sval,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 5,
      "text": "Det var en deilig Skræder-Sal!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 5,
      "text": "Paa hver en Sky stod Engle smaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 5,
      "text": "Der havde ei det mindste paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 5,
      "text": "De syede med Traad og Naal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 5,
      "text": "Regnbuen den var Skræder-Maal,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 5,
      "text": "Det Hele var saa propert her,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 5,
      "text": "Og Pressejern var Solen der,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 5,
      "text": "Man sang saa smukt paa dette Sted,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 5,
      "text": "Og jeg – ja jeg sang ogsaa med;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 5,
      "text": "Vi syede ved Sang og Spil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 5,
      "text": "Saa Helvede blev reent syet til.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 5,
      "text": "Jeg næsten troer det er endnu!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 5,
      "text": "Men Bager! siig, hvad drømte Du?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 5,
      "text": "Skjøndt Æblet neppe bliver Dit –«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 6,
      "text": "»Jo, Æblet troer jeg bliver mit!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 6,
      "text": "Gjensvarer han, »thi, med Forlov!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 6,
      "text": "Jeg hverken drømte eller sov,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 6,
      "text": "Thi, som jeg lagde mig til Ro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 6,
      "text": "Saae jeg, hvordan I begge To",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 6,
      "text": "Fløi hver til sit, med Huud og Krop;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 6,
      "text": "Een gik derned, Een gik derop!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 6,
      "text": "Da brugte jeg Forstandens fem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 6,
      "text": "Og tænkte: Den kom aldrig hjem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 6,
      "text": "Der engang foer til Helved ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 6,
      "text": "Og den, som fik i Himlen Sted,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 6,
      "text": "Han har jo Fryd og gode Dage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 6,
      "text": "Og vender heller ei tilbage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 6,
      "text": "Da hver er kommen nu til sit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 6,
      "text": "Jeg tænker, Æblet er da mit! –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 6,
      "text": "Det var en fiin, en deilig Slags,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 6,
      "text": "Thi spiste jeg det lige strax!«",
      "part": false,
      "marginal_notes": []
    }
  ]
}
