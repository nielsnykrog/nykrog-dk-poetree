{
  "id": null,
  "title": "Blomstens frugt hun spreder sig ud",
  "year_created": [
    1555,
    1559
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Jens Billes Håndskrift",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1559,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/BILL56.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Blomstrens fructt hun spreder siig vtt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "blanntt wrther oc synne smaa grene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "aff huilkenn tre ther woxer enn quist,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "ieg hennde met kierlliighett mynne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "hun groer op wnnder lyde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "oc worre hun planthit i rossenn-gaardt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "tha stode hun icke i iorden saa haar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "blant tyssell oc tornne, hun kandtt rett aldrig wnduige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Ieg plantiitt thenn rossenn allt mett min handtt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "i førsthe sommerssens grøde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "thenn rossen hun tuingis baade dag oc natt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "medtt siugdom oc stor møde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "hun kandt icke blomster berre;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "aff edeliig rydder hun op-runden er,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "thett skier om-sier, hun rossenn berr,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "thenn lyllie-quist hun er mynn hierttelligenns kierre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Rossenn hun groer i rossenn-gaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "hun ber sinne bladtt baade huide oc røde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "saa giør oc mynn kierist blannt fruer och møer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "for hennde ber ieg stor møde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "hun monne mitt hiertte saa tuinge;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "om dag for hinnde sørger ieg saa saarre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "om natthen ber ieg for hinde taarre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "naar ieg hinnde icke seer, tha maa mitt hiertte saa saare wercke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Thenn Gudtt, som alting haffuer i voldt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "oc himellen haffuer att raade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "hand signe mynn kierrist i-huor hun er,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "hun løsser well beggiis vor wonnde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "ieg tør hinnde icke obennbare;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "for stolte iomffruer haffde ieg hende saa kier,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "et krunit E hennde bogstaff er,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "i-huor hun er, hun er min hiertelig kere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "I Suerriig oc Norriig saa haffuer ieg werriit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "baade sier oc weyer saa lange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "mynn kierist hun gangis mig aldrig aff huen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "huadt heller ieg rider eller ager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "ieg kandtt huercken lege eller lee;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "allt fraa thenn stundtt ieg først hende saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "tha ippiis min sorriig baade lennger oc mer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "for henndes skiildtt ber ieg nu kinderne blege.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "Thett wor alt mynn største quide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "ieg skulle tiill skollen gannge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 5,
      "text": "ieg fick mynn kierriist saa siellenn att see,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 5,
      "text": "thett giorde mig daggenn saa lange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 5,
      "text": "ieg kunde baadde lesse oc schriffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "for stollthe iomffruer hagde ieg vmage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "ieg reddiis for spotthenn allt paa myn bag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "i fremede lande ther tuinges nu att bliffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "Huilkenn som thenne wiisse forstaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 6,
      "text": "henndis naffn thett kalliis N,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 6,
      "text": "hanns bogstaff er et krunnitt P,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 6,
      "text": "som hennde haffuer giort oc diictiit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 6,
      "text": "wy maa hanns naffn bekiende;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "thenn riige Christ aff hymmeriig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "handt wer mett oss, naar wy skulle døø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "Gudt-fader oc sønn, handt giffuer hanns naffnn godtt ennde.",
      "part": false,
      "marginal_notes": []
    }
  ]
}