  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "NV er fød oss Jesus Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Aff en Jomfru det er vist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "For vden mandz beblandelse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Er han voss kommen aff høyeste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "vor salighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "⁕ Gud vere met oss Emanuel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "den bebudede Gabriel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Der til er vidne Ezechiel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Han kom til voss vor frelsere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Gud Fader Søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "⁕ Fuldkommen er nu Dauidz dict/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Der til ocsaa Propheternis scrifft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Christus er det Engelske liuss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Som hyrderne saa i Krubben laa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "ith Menniske",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "⁕ Den som kom aff Hiemmelen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "han atspurde Mennisken/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "Ey quinde eller nogen Mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Forderffue nogen tid vilde han/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "O miskundhed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "⁕ Christne Børn forsamles nu/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "Met Christ eders Broder verer glade och fro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "giffuer hannem loff vor Konning Viiss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "Som voss forhuerffuede den euige priss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Euindelig.",
      "part": false,
      "marginal_notes": []
    }
  ]
}