{
  "id": null,
  "title": "† Ved den lille Gerda Collins Død",
  "year_created": 1845,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
