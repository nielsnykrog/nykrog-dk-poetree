  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1845,
    "url": "https://tekstnet.dk/books/andersen-hc_ved-den-lille-gerda-collins-doed/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Den lange Nat I skifteviis tilsammen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Sad hos det søde Barn I misted’ nys,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Med Bøn til Gud I skjærmed om Livs-Flammen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Der neppe udholdt selv en Moders Kys.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Hun fløi fra Eder bort en Foraars-Morgen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Den friske Barne-Sjæl til Himlen steeg;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Men hvor hun leged’ her, der boer nu Sorgen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Husk hendes Jordliv var en Uskylds-Leeg!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Nu faae vi Sommer, Solskin, Roser røde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Opstandelse forkynder Blomst og Straa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Og hun – for hende Jordens Smerter döde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Hun fulgte: »Kommer hid til mig I Smaa!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Græd kun, det mildner Sorgen, gjør den stille.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Skjøndt aldrig grædes Smerten ganske ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Men Troen voxer, – Mod I finde ville,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "I deelte Eders bedste Skat med Gud!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
