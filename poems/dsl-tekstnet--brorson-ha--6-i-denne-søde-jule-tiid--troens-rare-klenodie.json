  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "I denne søde jule-tiid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "bør man sig ret fornøye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Og bruge al sin konst og fliid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Guds naade at ophøye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Ved den, som er i krybben lagt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Vi vil, af gandske siele-magt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "I Aanden os forlyste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Din lof skal høres, Frelsermand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Saa vidt og bredt i verdens land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "At jorden den skal ryste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "En liden Søn af Davids rod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Som er og Gud tillige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "For verdens synders skyld forlod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Sit søde himmerige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Det var ham svart at tænke paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "At verden skulde undergaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Det skar ham i hans hierte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "I saadan hiertens kierlighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Hand kom til os paa jorden ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "At lindre vores smerte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Vor tak vi vil frembære da,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Endskiønt den er kun ringe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Hosanna og halleluja",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Skal allevegne klinge;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Guds ark er kommen i vor leyr!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Thi synge vi om fryd og seyr,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Mens hiertet sig kand røre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Vi synge om den søde fred,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "At helvede skal skielve ved",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "Vor jule-sang at høre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Gud er nu ikke længer vred,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Det kand vi deraf vide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "At hand har sendt sin Søn her ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "For verdens synd at lide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "Det vorde vidt og bredt bekiendt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "At Gud sin Søn for os har sendt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "Til jammer, vee og vaade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "Hvo vilde da ey være fro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "Og lade al sin sorg beroe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "Paa JEsu søde naade?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "Som natten aldrig er saa sort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "Den jo for solen svinder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "Saa farer al min kummer bort,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "Naar jeg mig ret besinder:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "At Gud saa hiertens inderlig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 4,
      "text": "Af evighed har elsket mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 4,
      "text": "Og er min broder vorden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 4,
      "text": "Jeg aldrig glemmer disse ord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 4,
      "text": "Som klingede i engle-koor:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 4,
      "text": "Nu er der fred paa jorden!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 5,
      "text": "Og blandes end min fryde-sang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 5,
      "text": "Med graad og dybe sukke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 5,
      "text": "Saa skal dog korsets haarde tvang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 5,
      "text": "Mig aldrig munden lukke;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 5,
      "text": "Naar hiertet sidder meest beklemt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 5,
      "text": "Da bliver frydens harpe stemt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 5,
      "text": "At den kand bedre klinge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 5,
      "text": "Og knuste hierter føle best,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 5,
      "text": "Hvad denne store fryde-fest",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 5,
      "text": "For glæde har at bringe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 6,
      "text": "Halleluja, vor striid er endt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 6,
      "text": "Hvo vilde mere klage?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 6,
      "text": "Hvo vilde mere gaae bespendt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 6,
      "text": "I disse fryde-dage?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 6,
      "text": "Syng høyt i skye. Guds kirke-flok:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 6,
      "text": "Halleluja, nu har jeg nok,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 6,
      "text": "Den fryd har ingen lige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 6,
      "text": "Halleluja, halleluja,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 6,
      "text": "Guds Søn er min, jeg vil herfra",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 6,
      "text": "Med ham til himmerige.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
