    "url": "https://tekstnet.dk/books/brorson-ha_troens-rare-klenodie/182/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Sørger du endnu min siel?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "O nu, hvortil tiener sorgen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Troe dog, JEsus vil dig vel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Skiønt hans raad dig er forborgen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Ach! hvor ofte har hans magt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Roser ud af torne bragt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Kast kun anker, her er grund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Det er got paa Gud at bygge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Har du trang en liden stund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "O! det er dog kun en skygge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Korset er en overgang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Glæden bliver evig lang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Christi vey er altid god,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Ret og rigtig nok befunden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Som sig haver med sit blod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Til din frelse høyt forbunden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Troe dog da, at det er sandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Mens du har saa stort et pant.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "JEsus giver fryd og graad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Og er ingen slumpe-lykke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "Men vor HErres vise raad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Lad det da dig ey mistykke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "Bie og tie i bøn og troe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Det skal give sielen roe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Vist er veyen tung og trang",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 4,
      "text": "Til at vandre for de fromme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 4,
      "text": "Skal vi blive fri engang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 4,
      "text": "Faae vi jo den vey at komme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Giennem ørken skal vi gaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "Saa er Canaan at faae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 5,
      "text": "Derop da, mit bange sind!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 5,
      "text": "Hvor man seyers krandse finder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 5,
      "text": "Og kun frisk i kampen ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 5,
      "text": "Det har ingen nød, jeg vinder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 5,
      "text": "Thi jeg er jo, JEsu! din,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Saa est du og himlen min.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
