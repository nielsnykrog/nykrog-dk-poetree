{
  "id": null,
  "title": "Passions-Sang, som Pifferari i Rom synge den, under Fastetiden",
  "year_created": 1836,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1836,
    "url": "https://tekstnet.dk/books/andersen-hc_passions-sang-som-pifferari-i-rom-synge-den-under-fastetiden/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Da jeg bad paa Oliebjerget,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Trængte Blodet frem som Vande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Stod i Draaber paa min Pande,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Det i Strømme flød for Dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Vee!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Mon Du vel tænker paa mig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Da de bandt mig fast til Søilen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Sloge mig med Svøber stærke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Saa der fremsprang blodigt Mærke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Jeg taalmodig led for Dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Vee!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Mon Du vel tænker paa mig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Da jeg spottet blev som Konge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Stod til Haan og til Vanære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Maatte Tornekronen bære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Al min Tanke var hos Dig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Vee!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Mon Du vel tænker paa mig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Udskjældt, dømt til Skjændsels-Døden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Medens Tornekrandsen saared’,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "Korsets Byrde jeg har baaret,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Gaaet Dødens Gang for Dig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "Vee!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Mon Du vel tænker paa mig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Da paa Korsets Træ jeg hængte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 4,
      "text": "Naglet gjennem Been og Hænder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 4,
      "text": "Leed en Qval, ei Verden kjender,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 4,
      "text": "Vilde jeg jo døe for Dig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Vee!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "Mon Du vel tænker paa mig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 5,
      "text": "Spydet jog’ de i min Side,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 5,
      "text": "Og fra den udstrømmed’ Vandet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 5,
      "text": "Dødens Tegn. Var det vel andet?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 5,
      "text": "Livets Tegn det var for Dig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 5,
      "text": "Vee!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Mon Du vel tænker paa mig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 6,
      "text": "Ei Du saae de dybe Vunder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 6,
      "text": "Kjær Du var mig, meer end Livet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 6,
      "text": "Jeg mit Blod for Dig har givet!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 6,
      "text": "Intet var for stort for Dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 6,
      "text": "Vee!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 6,
      "text": "Mon Du vel tænker paa mig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 7,
      "text": "Kunde jeg vel give mere?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 7,
      "text": "Jeg mig hengav uden Dvælen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 7,
      "text": "Jeg for Dig udaanded’ Sjælen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 7,
      "text": "Al min Kjærlighed var Dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 7,
      "text": "Vee!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 7,
      "text": "Mon Du vel tænker paa mig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 8,
      "text": "Født og baaren af Maria,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 8,
      "text": "Jeg din Broder blev i Kjødet;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 8,
      "text": "Daglig end i Altar-Brødet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 8,
      "text": "Brydes Legemet for Dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 8,
      "text": "Vee!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 8,
      "text": "Mon Du vel tænker paa mig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 9,
      "text": "Naar jeg, som Gjenløsnings-Summen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 9,
      "text": "Selv mig hengav her paa Jorden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 9,
      "text": "Hist jeg Livets Sum er vorden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 9,
      "text": "Hist jeg Lønnen er for Dig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 9,
      "text": "Vee!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 9,
      "text": "Mon Du vel tænker paa mig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 10,
      "text": "Tænkte jeg i Døden paa Dig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 10,
      "text": "Skulde jeg da ville mindre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 10,
      "text": "I min Himmel Dig erindre?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 10,
      "text": "Verdens Hersker mindes Dig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 10,
      "text": "Vee!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 10,
      "text": "Mon Du vel tænker paa mig!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
