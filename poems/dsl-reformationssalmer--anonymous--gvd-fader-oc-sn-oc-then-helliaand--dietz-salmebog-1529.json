  "source": {
    "id": null,
    "title": "Een ny handbog med Psalmer oc aandelige lofsange",
    "year_published": 1529,
    "publisher": "Ludwig Dietz",
    "printer": "Ludwig Dietz",
    "place": "Rostock",
    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/dietz-salmebog-1529/2/2"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "GVd fader oc Søn oc then Helliaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hannwm bør oss prÿse oc ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "han giør miskund ÿ alle land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "som wÿ maa daglige høre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Han haffuer bewÿst stor kierlighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "mod menniskens køn saa mangeleed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "som wÿ wille faa att høre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "J dieffuelsens wold ieg fangen laa/",
      "part": false,
      "marginal_notes": [
        "Gen. iij."
      ]
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "ieg wor fordømt til døde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "mÿn synd meg qwalde bode natt oc dag/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "ieg hadde stor angist oc møde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Oc alle tÿd sanck ieg diybere nid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "ther wor ey raad ey salighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "ieg wor ÿ synden vndfangen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Mÿne gode gierning the hiolpe meg ey/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "the kunde ey døden offuerwinde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "then stercke dieffuel han sagde ney/",
      "part": false,
      "marginal_notes": [
        "Lu"
      ]
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "han wilde icke lade seg binde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Aff meg eller nogit creatur/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "ieg wor ÿ hans wald aff mÿn natur/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "fordømdt til ewige pÿne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Ther wor oc ingen ÿ werden till/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "ther meg forløse kunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "ieg weed ret aldrig hwort ieg wil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "ieg maa till heluedis grunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Guds wrede ther offuer meg er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "oc syndzens byrde ther ieg nw bær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "fortapt tha maa ieg bliffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Tha ynckede Gud ÿ ewighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "mÿn ælende offuer maade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "han tenchte paa sÿn barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "han wilde meg hielpe lade:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Sitt faderlig hierte wende han til meg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "han kostit ther paa forwden swig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "thet kiærist ther han hadde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Han talde til sÿn kiære søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "thet er nw tÿd att forbarme/",
      "part": false,
      "marginal_notes": [
        "Luce. j. Osee. xiij. Phil. ij. Luce. ij."
      ]
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "tw skalt thet giøre for mÿn bøn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "far hæden oc frelss the arme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "Oc løøss thennom wdaff syndzens nød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "oc slaa then horde død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "oc lad thennom med teg leffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "Guds søn sÿn fader lydactig war/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "han kom til meg paa iorden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "aff een Jomffru bode reen oc klar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 6,
      "text": "han wilde mÿn broder worde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 6,
      "text": "Saa lønlig førde han sÿn stads/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 6,
      "text": "leed alskens nød oc møgen plads/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "for han wilde dieffuelen fange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 7,
      "text": "Guds søn han sagde kom hÿd til meg",
      "part": false,
      "marginal_notes": [
        "Math. xj."
      ]
    },
    {
      "id": 50,
      "stanza_id": 7,
      "text": "ieg wil meg offuer teg forbarme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 7,
      "text": "ieg tolde then bittre død for teg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 7,
      "text": "ther med tw himmerig skalt ærffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 7,
      "text": "Nw er ieg thÿn oc tw æst mÿn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 7,
      "text": "oc hwor ieg er ther skal tw wære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 7,
      "text": "then fiend skall oss ey atskillie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 8,
      "text": "Hwem haffuer hørd større kierlighed/",
      "part": false,
      "marginal_notes": [
        "Roman. v."
      ]
    },
    {
      "id": 57,
      "stanza_id": 8,
      "text": "en død for vwenner att lÿde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 8,
      "text": "thet haffuer ieg eene giord fore teg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 8,
      "text": "att tw skulle med meg bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 8,
      "text": "Jeg er then eene ther hielpe kand/",
      "part": false,
      "marginal_notes": [
        "Math. xj."
      ]
    },
    {
      "id": 61,
      "stanza_id": 8,
      "text": "thÿ kommer til meg bode qwinne oc mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 8,
      "text": "oss skall rett ingen atskillie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 9,
      "text": "Mit blod thet flyder paa iorden wd/",
      "part": false,
      "marginal_notes": [
        "Johan. xix."
      ]
    },
    {
      "id": 64,
      "stanza_id": 9,
      "text": "ieg bær thet korss med møde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 9,
      "text": "ieg lÿder for teg then horde død/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 9,
      "text": "tag tro oc lad teg døbe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 9,
      "text": "Mit lÿff offuerwinder then død med macht/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 9,
      "text": "all werdzens synder wore paa meg lagt/",
      "part": false,
      "marginal_notes": [
        "Esaie. liij."
      ]
    },
    {
      "id": 69,
      "stanza_id": 9,
      "text": "thÿ æstu salig worden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 10,
      "text": "Til himmels igien till fáder mÿn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 10,
      "text": "far ] herefter lakune orig. orig. ieg fraa thenne ælende /",
      "part": false,
      "marginal_notes": [
        "Johan.|xiiij. oc",
        "Johan.|xiiij. oc"
      ]
    },
    {
      "id": 72,
      "stanza_id": 10,
      "text": "ther wil ieg wære Mester thÿn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 10,
      "text": "then Helliaand teg att sende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 10,
      "text": "Som teg ÿ angiste trøste skal/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 10,
      "text": "oc teg vnderwÿse oc lære wel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 10,
      "text": "ÿ sandheds wæy att wandre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 11,
      "text": "Hwad ieg haffuer giord vnderwÿst oc lærd/",
      "part": false,
      "marginal_notes": [
        "Mat. xxiiij"
      ]
    },
    {
      "id": 78,
      "stanza_id": 11,
      "text": "thet skaltw giøre oc lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 11,
      "text": "ther med mit rÿge opfylt wort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 11,
      "text": "meg sielff til loff oc ære/",
      "part": false,
      "marginal_notes": [
        "Mat. xv. Marci. vij"
      ]
    },
    {
      "id": 81,
      "stanza_id": 11,
      "text": "Forware teg wel for menniskens sætt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 11,
      "text": "som oss forwender then Christelig rætt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 11,
      "text": "thet giffuer ieg teg til kende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 12,
      "text": "Tw skalt predicke then Christelig tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 12,
      "text": "som ieg befaler att lære/",
      "part": false,
      "marginal_notes": [
        "Matthei.|xxviij."
      ]
    },
    {
      "id": 86,
      "stanza_id": 12,
      "text": "Elsker hwer ander bode silde oc froo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 12,
      "text": "thet skal mit budord wære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 12,
      "text": "For dieffuelsens lærdom forwochte teg/",
      "part": false,
      "marginal_notes": [
        "Esaie. xl."
      ]
    },
    {
      "id": 89,
      "stanza_id": 12,
      "text": "thÿ han er falsk oc skadelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 12,
      "text": "Guds ord thet bliffuer ewindelig.",
      "part": false,
      "marginal_notes": []
    }
  ]
}