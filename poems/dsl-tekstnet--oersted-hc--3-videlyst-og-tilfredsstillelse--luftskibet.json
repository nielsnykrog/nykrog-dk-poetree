{
  "id": null,
  "title": "3. Videlyst og Tilfredsstillelse",
  "year_created": 1836,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Ørsted",
    "country": null,
