  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Jeg er den eene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Alvise stærke GUd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Mig skal du tiene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Og frygte mine bud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Dermed bemandet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Foragt al verdens vind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Elsk mig, ey andet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Af gandske siel og sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Tro mig, om vandet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "End gik i sielen ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Du skal ey tage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Mit navn forfængeligt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Straf skal hand smage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Som understaaer sig sligt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Ey bande, svære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Og skuffe ved mit navn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Ney du skal bære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Det i dit hiertes favn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Thi det skal være",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "I al din nød din havn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Tag hvile-dagen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Særdeles vel i agt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "At drive sagen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Af gandske fliid og magt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "GUds ord at høre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Og faae i hiertet fat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Derefter giøre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Alvorlig dag og nat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Og andre føre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "Til denne himmel-skat.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Viis mod din fader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Og moder lydighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "Alt got jeg lader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "Da paa dig flyde ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "Giv dennem ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "Som du skal tiene her,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 3,
      "text": "Meest dem, som bære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 3,
      "text": "Og bruge magtens sverd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 3,
      "text": "Lyd dem, som lære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 3,
      "text": "Dig himlens vandrings-færd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "Slaa ey din næste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "Langt mindre slaa ihiel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "Men søg hans beste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "Og gavn til liv og siel,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "Bort klammers hede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 4,
      "text": "Og bittre miners mord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 4,
      "text": "Bort had og vrede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 4,
      "text": "Af hele verdens jord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 4,
      "text": "I satans rede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 4,
      "text": "Min naade aldrig boer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 5,
      "text": "Du skal og ikke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 5,
      "text": "Bedrive horerie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 5,
      "text": "Den satans strikke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 5,
      "text": "Ved naaden gak forbi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 5,
      "text": "Fly den, der agter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 5,
      "text": "At gaae i lyster blind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 5,
      "text": "Vær reen i fagter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 5,
      "text": "I ord og alt dit sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 5,
      "text": "Som den, der tragter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 5,
      "text": "At gaae i himlen ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 6,
      "text": "Du skal ey tage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 6,
      "text": "Hvad andre hører til,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 6,
      "text": "Ved list og plage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 6,
      "text": "Paa ting, i kiøb og spil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 6,
      "text": "Flye ladheds sæde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 6,
      "text": "Og æd dit eget brød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 6,
      "text": "Tag det med glæde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 6,
      "text": "Som af min haand og skiød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 6,
      "text": "Jeg vil dig klæde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 6,
      "text": "Og føde til din død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 7,
      "text": "Lad dig ey finde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 7,
      "text": "Paa falskheds vrange sti,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 7,
      "text": "Lad retten vinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 7,
      "text": "Staa de fortrykte bi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 7,
      "text": "Set ey din næste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 7,
      "text": "En klak og lyde paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 7,
      "text": "Tal til hans beste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 7,
      "text": "Som kand med sandhed staae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 7,
      "text": "Jeg vil befæste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 7,
      "text": "Din gang og med dig gaae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 8,
      "text": "Du skal ey vilde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 8,
      "text": "Din næstes eye faae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 8,
      "text": "Stop utugts kilde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 8,
      "text": "I hiertets dybe vraae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 8,
      "text": "Lad dig fortryde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 8,
      "text": "Den mindste stoltheds vind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 8,
      "text": "Lær strax at bryde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 8,
      "text": "Al vellyst i dit sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 8,
      "text": "Saa skal der flyde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 8,
      "text": "En himmel-lyst derind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 9,
      "text": "Merk ydermere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 9,
      "text": "Din næstes hustrue skalt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 9,
      "text": "Du ey begiere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 9,
      "text": "Og hvad hand eyer alt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 9,
      "text": "Mit billeds ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 9,
      "text": "Fuldkommenhedens pragt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 9,
      "text": "Mig liig at være",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 9,
      "text": "I hellighedens dragt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 9,
      "text": "Det skal du bære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 9,
      "text": "Og tænk hvem det har sagt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 10,
      "text": "O JEsu lilde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 10,
      "text": "Du kiender min natur,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 10,
      "text": "At hiertets kilde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 10,
      "text": "Er skiden, beesk og suur,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 10,
      "text": "Hvor jeg ey kunde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 10,
      "text": "Det mindste selv formaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 10,
      "text": "Men slet til grunde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 10,
      "text": "I døden skulde gaae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 10,
      "text": "Om ingenlunde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 10,
      "text": "Var anden hielp at faae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 11,
      "text": "Men skaden heles",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 11,
      "text": "I dine vunders blod:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 11,
      "text": "Du har aldeles",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 11,
      "text": "Giort for os pligt og bod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 11,
      "text": "Til dig at rende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 11,
      "text": "Giør al min byrde let,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 11,
      "text": "Dig ind at spende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 11,
      "text": "I troens arme tet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 11,
      "text": "Det giør en ende",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 11,
      "text": "Paa lovens strenge ret.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 12,
      "text": "Da kand jeg trøstig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 12,
      "text": "I loven kige ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 12,
      "text": "Og trine lystig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 12,
      "text": "I et fornøyet sind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 12,
      "text": "Al verdens mørke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 12,
      "text": "Forsigtig gaae forbi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 12,
      "text": "Og dig ret dyrke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 12,
      "text": "I alt mit levnets sti,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 12,
      "text": "Du est min styrke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 12,
      "text": "At vandre derudi.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 13,
      "text": "Hvad mig da feyler",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 13,
      "text": "I dette svage leer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 13,
      "text": "Naar jeg mig speyler,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 13,
      "text": "Og ind i loven seer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 13,
      "text": "Det vil jeg rette",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 13,
      "text": "Ved aandens vise tugt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 13,
      "text": "Men alting sette",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 13,
      "text": "I dine vunders frugt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 13,
      "text": "Da lovens trette",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 13,
      "text": "Er gandske udelukt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 14,
      "text": "Jeg vil ey nøyes",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 14,
      "text": "Med verdens døde troe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 14,
      "text": "Hvor intet pløyes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 14,
      "text": "Og syndens tidsel groe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 14,
      "text": "Vil du dig give",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 14,
      "text": "Saa gandske til mig hen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 14,
      "text": "Da maa jeg blive",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 14,
      "text": "Jo gandske din igien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 14,
      "text": "I død og live,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 14,
      "text": "At følge dig min ven.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 15,
      "text": "Saa skee dig ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 15,
      "text": "O JEsu, for din død,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 15,
      "text": "Som lovens lære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 15,
      "text": "Har for mig giort saa sød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 15,
      "text": "At jeg kand træde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 15,
      "text": "De onde lyster ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 15,
      "text": "Og gaae med glæde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 15,
      "text": "Af verdens glæde keed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 15,
      "text": "Til brude-sæde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 15,
      "text": "I evig herlighed.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
