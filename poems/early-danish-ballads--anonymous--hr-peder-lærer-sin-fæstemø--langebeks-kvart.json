{
  "id": null,
  "title": "Hr. Peder lærer sin Fæstemø",
  "year_created": [
    1579,
    1583
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Langebeks kvart",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/LNGK90.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Her Peder hand skule sin festemø lerre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "huor hun skule løffue med tuct och ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": ":: Eren hun er dett feyerste thre i skoffuen før. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "\"Først annder iomfruer dig ganger i by,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "da sett du dig wed din søn att sy.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "Først ander iomfruer dig ganger thill wage-stue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "da leg du dig i dinn seng att søffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "Først ander iomfruer dig liger att lee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 3,
      "text": "da est du for-uden all spott och spe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "Først ander iomfruer haffuer angist och quie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "med eren søffuer du i en riders arem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "Først ander iomfruer haffuer angist och harm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 5,
      "text": "med eren soffuer du i en riders arem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "Du wocte dig well for lang by-ganng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 6,
      "text": "giør icke din acten-talle for lang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "Du wocte dig well for preste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 7,
      "text": "och for di drucken geste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "I-huor du seer en drucken daare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 8,
      "text": "du gack fraa hannom och lad hannom fare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "Saadan er unger-suen i sin troe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 9,
      "text": "som mand griffuer en aall om halle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 10,
      "text": "Saadan er unger-suend i sin troe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "som mand thrinner paa thryske-broe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 11,
      "text": "Brøster hun nere, hun syncker thill bundss,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 11,
      "text": "saa haffuer mand skam i allen stund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 12,
      "text": "I-huor du sider bland rider och suen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "bethenck din ære altt wed dig ene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 12,
      "text": ":: Eren hun er dett feyerste thre i skoffuen. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}