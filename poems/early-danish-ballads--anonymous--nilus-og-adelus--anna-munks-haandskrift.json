{
  "id": null,
  "title": "Nilus og Adelus",
  "year_created": [
    1590,
    1591
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Anna Munks Håndskrift",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1591,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/MUNK1.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Manngenn manndt øpper for-inndenn sinn gordt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "bode rosser och liller;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "sammenn woxe thop och rodt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "saa giør och guode willie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: Saa løsser hunn suenndinn aff anngist. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Her Peder hanndt bouffuer sig udt wedt aa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "hanndt haffuer di døtter fem;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Adellutz hiedder denn yngiste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "och hunn war skiønnist aff dem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Dett war bolde her Niellus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "hanndt beder sadell sinn hest:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "\"Ieg well ride thill her Peders gordt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "hanns ynngste datter att feste!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Dett war bolde her Niellus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "hanndt kommer ther ridennde udi gordt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "ud stod her Peder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "hanndt war well suøbt y mordt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "\"Wer well-komenn, bolde her Nielus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "wer well-komenn y minn gordt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "dett bronne miødt, det klare winn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "skall were for ether uspardt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "\"Ieg well icke haffue ethers bronne miød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "icke heller dett klare winn;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "i giffuer mig stalltenn Adellutz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "aller-kiereste datter din.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "\"I ganngger ether y stouffuenn inndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "i setter etherdt herre thill bortz;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "ieg well ganngge y høgelofft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "och høre minn dathers ordt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Gledt dig, staltenn Adellutz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "du gled dig alle dinne dagge:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "dig beder bolde her Niellus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "alt om du willt hannom haffue.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Dett war med hiinnders wille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "saa gladellige sagde hunn ia;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "saa bliffue hunn hannom giffuenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "udi denn samme dag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Dette tha spurde denn gannlle greffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "hanndt bode sig ud wedt aa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "her Niellus haffde denn iomfrue fest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "ther all hanns hoff stodt paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Dett tha war denn gamblle greffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "hanndt beder sadell sinn hest:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "\"Ieg well riide mig op-paa lanndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "danner-konning will ieg giest.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Dett tha war thenndt gamblle greffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "hanndt komme ther ridennde y gordt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "udt stanndder danner-konning,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "hand war well suøbtt udi mordt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "\"Wer well-kommenn, minn kiere mor-broder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "y ere well-komenn hidt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "well y drick med mig udi dag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 12,
      "text": "annthenn miød eller winn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "\"Hør y, danner-konninge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "y kiennder mig nogenn raadt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "her Niellus haffuer thenndt iomfrue fest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 13,
      "text": "ther all minn houff liger paa!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "\"Haffuer hanndt fest thenndt stalltte iomfrue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "ther alldt ethers houff thill studt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "well Gud-fader, ieg leffue maa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 14,
      "text": "hanndt skall hennder aldriig faa!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "Koningenn hanndt lader enn udbodt giøre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "thenndt lader hanndt biude saa strenngge:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "miest for bolde her Niellus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 15,
      "text": "hanndt skulle icke bliffue hiemme.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "Dett war danner-konning,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "hannd lader enn udboudt giøre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "miest for bolde her Niellus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 16,
      "text": "hanndt skulle sinn baner føre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "Dett war bolde her Niellus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "hanndt kommer ther y konningens gordt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "ud stannder danner-konning,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 17,
      "text": "hanndt var well suøbtt y mordt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "\"Wer well-komenn, bolde her Niels,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "tu est enn rider finn;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "du skallt udt-y leydinng y-aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 18,
      "text": "medt alle minn guode menndt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "\"Icke haffde ieg act y-aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "ieg skulle udi ledinnge dragge;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "ieg haffde act i samme thidt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 19,
      "text": "ath lade minn brøllup stannde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "\"Du skallt udt-y ledinng i-aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "minn banner skall thu føre;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "først du kommer thilbagge igienn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 20,
      "text": "saa maa du dinn brølup giøre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 21,
      "text": "\"Saa giernne farett ieg y ledinng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "faar ether adt wogge mith liff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 21,
      "text": "war thett icke for minn fester-møø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 21,
      "text": "saa manngge-foldt er hennders quide.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 22,
      "text": "Dett war bolde her Niellus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 22,
      "text": "hanndt kommer saa manngge i sinndt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 22,
      "text": "\"Ieg well ride miig oppaa lanndt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 22,
      "text": "och talle medt festermøø minn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 23,
      "text": "Dett war bollde her Niellus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 23,
      "text": "hanndt kommer ther riddennde i gordt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 23,
      "text": "och udt stannder hanns kiere festermø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 23,
      "text": "hunn war well suøbt udi mordt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 24,
      "text": "\"Wer uell-komenn, her Niellus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 24,
      "text": "du wer well-kommenn hiem;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 24,
      "text": "huor haffuer dig lidt i leydinng i-aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 24,
      "text": "allt medt minn guode menndt?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 25,
      "text": "\"Saa haffuer mig lidt i ledinng i-aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 25,
      "text": "allt medt ethers guode menndt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 25,
      "text": "Gud giffue minn lycke haffde werrett saa guodt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 25,
      "text": "ath ieg iche haffde komett igienn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 26,
      "text": "I-aar drog ieg i leydinng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 26,
      "text": "for ethers skylldt ath woffue mett liff;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 26,
      "text": "nu haffuer i henn-giffuett minn fester-mø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 26,
      "text": "for hinnder ber ieg stor quide.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 27,
      "text": "\"Hør du, bolde her Niellussenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 27,
      "text": "laadt bortt-fare dinn qviede;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 27,
      "text": "ieg giffuer dig minn søster-dather,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 27,
      "text": "møgget rigger endt hendis thi.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 28,
      "text": "\"Dett i giffuer mig ethers søster-datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 28,
      "text": "møggett rigger inndt hinnders thi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 28,
      "text": "saa kier haffuer ieg stalttenn Adelutz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 28,
      "text": "rett alldrig for-glemmer ieg hinndt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 29,
      "text": "Dett war boldt her Niellus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 29,
      "text": "hanndt maatte icke ridde aff gorde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 29,
      "text": "før-inndt hanndt haffuede fest lidenn Kierstin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 29,
      "text": "thill aller-kiereste sinn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 30,
      "text": "Dett war bollde her Nielss,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 30,
      "text": "hanndt beder sadell sinn hest:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 30,
      "text": "\"Ieg well ride mig op-paa lanndt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 30,
      "text": "thenndt gannlle greffue adt gieste.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 31,
      "text": "Dett sagde bollde her Niellus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 31,
      "text": "hanndt stodt y skallagenn-skendt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 31,
      "text": "\"Ieg well ridde mig op-paa lanndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 31,
      "text": "biude stalthenn Adellutz thill brøllup minn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 32,
      "text": "Dett war bolde her Niellus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 32,
      "text": "hanndt kommer ther riddennde i gordt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 32,
      "text": "udt da stodt thenndt gamelle greffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 32,
      "text": "hanndt war well suøbtt i mordt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 33,
      "text": "\"Wer well-kommenn, bolle her Niellus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 33,
      "text": "wer well-kommenn i wor gordt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 33,
      "text": "dett bronne miødt, denn klare winn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 33,
      "text": "skall werre for ether udspardt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 34,
      "text": "\"Ieg kommer icke for ethers brunne miødt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 34,
      "text": "eller for ethers klare winn;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 34,
      "text": "ieg wille talle medt staltenn Adellutz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 34,
      "text": "som føre war kiereste minn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 35,
      "text": "Hanndt thog hannom løstellige wedt sinn hanndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 35,
      "text": "fulde hannom i stoffuenn inndt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 35,
      "text": "dett første hanndt stalltte Adelutz saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 35,
      "text": "tha fielde hannom thare paa kiennde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 36,
      "text": "\"Her stannder y, staltenndt Adelutz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 36,
      "text": "i er enn fruue saa finn;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 36,
      "text": "well i were denn enne frue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 36,
      "text": "som rede skall brudenn minn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 37,
      "text": "Lennge stodt stalthenn Adelutz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 37,
      "text": "hunn torde slett innttett suare;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 37,
      "text": "\"ia,\" sagde denn gamelle greffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 37,
      "text": "\"ieg well sielff med hennde fare.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 38,
      "text": "Førde di thenndt unngge brudt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 38,
      "text": "y bolle her Niellus gordt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 38,
      "text": "dett huide sølff, dett røde guldt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 38,
      "text": "det war for dennom uspardt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 39,
      "text": "Dett war sieldige enn afftenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 39,
      "text": "di fulde thenndt brude thill senng:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 39,
      "text": "her Nielus och staltenn Adelutz",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 39,
      "text": "di giorde dieris thalle saa lanng.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 40,
      "text": "\"Hør du, staltenn Adellutz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 40,
      "text": "huad ieg siger dig:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 40,
      "text": "huii loffuett du denn gamelle greffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 40,
      "text": "och brødst dinn troff mod mig?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 41,
      "text": "Dett suarett hunn stallthenn Adelutz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 41,
      "text": "hennde ranndt thare paa kiennde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 41,
      "text": "\"Dett haffuer minn fader och frennder giordt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 41,
      "text": "och aldrige med willige minn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 42,
      "text": "Ieg stanndder saa lenngge och snacker medt ether,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 42,
      "text": "dett bliffuer io lenng och werde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 42,
      "text": "y fannger utack aff eders brudt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 42,
      "text": "och ieg aff herre minn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 43,
      "text": "\"Heilp Gud-fader i hemmerige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 43,
      "text": "aff sorig och alle denn minn quide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 43,
      "text": "som ieg wille heller snache medt dig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 43,
      "text": "enn soffue wedt brudenns side!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 44,
      "text": "\"Hører i, bolle her Niellus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 44,
      "text": "i fannger enn iomfrue guodt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 44,
      "text": "ieg beder ether for thenndt offuerste Gudt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 44,
      "text": "i giør hennder icke imodt!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 45,
      "text": "Dett war stalthenn Adelutz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 45,
      "text": "hunn breder dy selcke-pelle:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 45,
      "text": "\"Thett wedt Gud-fader i hiemmerige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 45,
      "text": "ieg laae ther heller sielff!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 46,
      "text": "Dett war stalltenn Adelutz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 46,
      "text": "hunn drog di sparlagenn sammell;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 46,
      "text": "henndes øgenn di ranndt, henndes hierte dett gred,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 46,
      "text": "hunn giorde dett aff guod gamenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 47,
      "text": "Dett war staltenn Adelutz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 47,
      "text": "hunn lucte thenndt dør saa braadt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 47,
      "text": "\"Her Niellus och eders unnge brudt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 47,
      "text": "Gudt giffue ether mangge guodt-naatter!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 48,
      "text": "Dett war stallthenn Adellutz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 48,
      "text": "hunn suøbt sig hoffuedt y skienndt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 48,
      "text": "och gannger hunn i høffuelofft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 48,
      "text": "for dannske dronning inndt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 49,
      "text": "Dett war dannske dronning,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 49,
      "text": "hunn klapper aff hønndett blaadt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 49,
      "text": "\"Kommer hiidt, stalthenn Adelutz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 49,
      "text": "och willtu huille her-aff?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 50,
      "text": "Kommer hidt, stalthenn Adelutz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 50,
      "text": "och will thu huille dig?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 50,
      "text": "thet war saa lidett medt mett raadt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 50,
      "text": "thenndt sorig skulle hennde dig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 51,
      "text": "Dii matte well laade dem thilsamell were,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 51,
      "text": "hinn-anndenn aff hiertett well unnd;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 51,
      "text": "saa well haffde liden Kierstenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 51,
      "text": "fonnggett enn anndenn manndt!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 52,
      "text": "Stallthenn Adelutz kunde der innthett til suare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 52,
      "text": "buode for sorig och quide;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 52,
      "text": "thenndt anndenn naatt ther-epther kommer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 52,
      "text": "hunn døde vedt droninngenns side.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 53,
      "text": "Her Niellus hanndt spurde di thidennde saa snartt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 53,
      "text": "hanndt haffde sinn kiereste mest;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 53,
      "text": "hanndt actede att sorgge sigh sielff ihiellff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 53,
      "text": "som willdenn foggell paa quest.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 54,
      "text": "Saa ennde di thenn lonngge dag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 54,
      "text": "bode medt sorig och kuide;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 54,
      "text": "denn anndenn natt, ther epther kommer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 54,
      "text": "hanndt døde wedt brudenns side.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 55,
      "text": "Her Niellus døde y brudens husse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 55,
      "text": "alltt udi brudenns arm;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 55,
      "text": "stallt Adellutz døde y fruer-stoffuenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 55,
      "text": "alle di fruer thill harum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 56,
      "text": "Dett dag war denn gamblle greffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 56,
      "text": "stodt offuer stalltt Adellutz graff;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 56,
      "text": "saa møggett aff dett røde guldt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 56,
      "text": "handt for henndes siell udt-gaff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 57,
      "text": "Nu raader ieg huer-ennde erllige manndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 57,
      "text": "som ride well thell hoffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 57,
      "text": "fest sig alldrige denn skiønne iomfrue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 57,
      "text": "en anden suend haffuer troloffuett.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 233,
      "stanza_id": 57,
      "text": ":: Saa løsser hunn suendenn aff anngist. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}