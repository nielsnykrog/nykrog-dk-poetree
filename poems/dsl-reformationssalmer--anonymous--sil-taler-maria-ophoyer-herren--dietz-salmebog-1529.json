  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "siæl (taler Maria) ophoyer Herren.",
      "part": false,
      "marginal_notes": [
        "Luce. j."
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Oc mÿn aand frygder seg/ ÿ Gud mÿn frelsere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "For han saa til sÿn tiænnerskis ringhed /",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "see her aff worde meg salig sigende alle børnebørn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "Forthi then giorde meg stor ting som mectig er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "oc hans naffn er helligt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Oc hans barmhiertighed er fraa slecht oc til slechte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "hooss thennom som hanwm frychte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "Han haffuer giort weldighed med sÿn arm/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "oc forstørned the som hofferdige ere ÿ theris hiertis sinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 5,
      "text": "Han haffuer affstøt the mechtige aff theris sæde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "oc ophøget the ydmyge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 6,
      "text": "The Hungrue opfylte han med gode ting/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "oc the rÿge forlod han thome.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 7,
      "text": "Han haffuer sÿn barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "oc sÿn tiæner Jsrael ophulpid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 8,
      "text": "Som han talde til wore forældre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "besynderlig Abraham oc hans sæd til ewig tÿd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 9,
      "text": "Aere wære Gud fader oc Gud søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "oc Gud then Helliaand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 10,
      "text": "Som haffuer wærid aff begyndelsen oc nw oc altÿd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 10,
      "text": "oc aff ewighed til ewighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 10,
      "text": "AMEN.",
      "part": false,
      "marginal_notes": []
    }
  ]
}