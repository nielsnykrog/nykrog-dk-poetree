  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Anna Munks Håndskrift",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1591,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/MUNK43.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Her Helmer hannd rider y rosenns-lunndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "sielff førde hannd sinn høg, hannd førde sielff sinn hunndt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": ":: Saa fri rider handt y sadell. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "I grønenn lunndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "sielff førde hannd sinn høg, sielff førde hanndt sinn hunndt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Hannd saa siig unnder liidenn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "iomffruens siu brødre kam riidenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Unnder liidenn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "iomffruenns siu brødre kam riidenn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "her Helmer hanndt riider medt sinn drenng:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "\"Vedstu nogenn goede raadt, du siiger mig dem.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "Thill sinn drenng:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "\"Vedstu nogenn raadt, du siiger mig dem.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "\"De bedste raadt, altt der ieg vedt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "huger hestenn medt sporenn och riider om-krinng.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "Ther ieg vedt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "huger hestenn med sporen och rider om-krinng.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "\"Dett skall aldrig min festermøø spørge thill by,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "dett ieg skall for henndis brødre fly.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 5,
      "text": "Spørge thill by,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "dett ieg skall fraa hendis brødre fly.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Her Helmer tog sinn hest med spore,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "saa fri redt handt henndis brødre emodt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 6,
      "text": "Synn hest medt spore,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "saa fri redt handt henndis brødre imodt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "\"Her Helmer, huy riider du oss imod?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "du veyett vor morbroder, bødt oss ey buod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 7,
      "text": "Oss emodt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "du veyett vor morbroder, bød oss ey buodt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Du veyett vor morbroder, bød oss ey buodt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "du tro-loffuett vor søster, spurdt os ey thill raadt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 8,
      "text": "Bødt oss ey buodt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "du troloffuitt vor søster, spurde os icki thill raadt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "\"Thi marck guld ligir y mitt skriinn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "dett skall verre buod for morbroder dynn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 9,
      "text": "Liger y skrinn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "dett skall verre buod for morbroder dinn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "\"Ieg vill icki haffue anndenn buodt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "ennd høyre hand och venster fod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 10,
      "text": "Anndenn buodt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "end høyre haannd och vennstre fodt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "\"Før du skaltt ennthen faa haannd eller fodt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "da skall dig hennde itt veyer-mod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 11,
      "text": "Haanndt eller fod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "da skall dig hennde itt veyer-mod.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Her Helmer hannd sytt suerd uddrog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "her Ellers hoffuitt hanndt der aff-hug.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 12,
      "text": "Sitt suerd uddrog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "her Ellers hoffuitt hand der aff-hug.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "Først da veiett handt Ebbi, och saa da veyett hannd Bang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "ochsaa vor legenn kommen paa ganng.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 13,
      "text": "Ebbi och Banng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 13,
      "text": "ochsaa vor legenn komen paa gang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "Saa veyett hannd Uulff och Adser Huidt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "saa vor fire brødre slagenn thilligh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 14,
      "text": "Och Adzer Huid,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "saa vor fire brødre veyen thilligh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Saa veyett hannd Terckill, saa veyett hanndt Tordt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "sex brødre var da slagenn thill iordt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 15,
      "text": "Terckill och Tord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 15,
      "text": "saa var sex brødre slagenn thill iord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "Op stodt her Folmer rødt som blod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "alle hanns venner var hannd guod.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 16,
      "text": "Rød som blodt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 16,
      "text": "alle hanns venner dennem var hannd guodt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "\"Her Helmer, her Helmer, du stille din vrede!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "ieg vill diig minn søster giiffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 17,
      "text": "Still dinn vrede!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 17,
      "text": "ieg vill dig min søster giiue!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "Helmer støtte sytt suerdt modt iord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "\"Nu hører ieg itt broders-ord.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 18,
      "text": "Sitt suerd mod iord:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 18,
      "text": "\"Nu hører ieg itt broders-ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "Haff tack, her Folmer, for dinn gaffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "ieg holder dig for broder alle minn dage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 19,
      "text": "For dinn gaffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 19,
      "text": "ieg holder diig for broder alle minn dage.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "Och dy redt thennom som brødre y by,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "her Folmer gaff hanom kiere søster synn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 20,
      "text": "Som brødre y by,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 20,
      "text": "her Folmer gaff hannom kier søster synn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "Saa drucke dy brølup medt glede och gammell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "dy leffuer thillsammenn forudenn all harm.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": ":: Saa frii riider hanndt y sadell. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}