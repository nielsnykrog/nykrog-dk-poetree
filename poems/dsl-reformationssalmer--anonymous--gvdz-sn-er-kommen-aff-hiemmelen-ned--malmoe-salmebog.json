  "source": {
    "id": null,
    "title": "[tabt]",
    "year_published": 1533,
    "publisher": "Christiern Pedersen",
    "printer": "Joh. Hoochstraten",
    "place": "Malmø",
    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/malmoe-salmebog/1/62"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "GVdz søn er kommen aff hiemmelen ned/",
      "part": false,
      "marginal_notes": [
        "Esaie ix"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "thi han oss inderlig elste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "vore gerninger ere vduelige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "de kunde oss icke frelse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Thi tro wi alle paa Jesum Christ/",
      "part": false,
      "marginal_notes": [
        "Esaie lxvi"
      ]
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "ath han er all wor salighed wist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "oc haffuer oss hiemmerige forwerffuit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Huad Gud i loffuen oss budit hagde/",
      "part": false,
      "marginal_notes": [
        "Rom viii"
      ]
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "oc wi det icke gøre kunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "da vare wi alle vnder Gudz wrede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "vor bøn vilde han ey høre/",
      "part": false,
      "marginal_notes": [
        "Leui. xix"
      ]
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "wi skulde være gode aff hiertens grund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "men wi ere onde i alle stund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "all waar krafft er forderffuit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Dog mente wi saa i wor blindhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Ath Gud hagde loffuen vdgiffuit/",
      "part": false,
      "marginal_notes": [
        "Rom ii"
      ]
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "ret lige som wi hagde selff kundit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "alt effter hennis vilge leffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Men hun er icke vden en speyil/",
      "part": false,
      "marginal_notes": [
        "Rom iii"
      ]
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "som oss vor wanart vise vill",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "der lønlige bor i hiertet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Den samme wanart wi ingelund kunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "aff vor egen mact forlade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "En dog wi det tit forsøge monne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "synden vilde dog offuer oss raade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Vi syntis vduertis være hellig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "men i hiertit vor syndens løst oc suig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "det Gudz low slet fordømmer",
      "part": false,
      "marginal_notes": [
        "Ro vii Exo xx"
      ]
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Vi skulle Gud frøcte aff hiertens grund/",
      "part": false,
      "marginal_notes": [
        "Deu x"
      ]
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "til hannem all vor tro sette/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "Oc elske hannem baade met hierte oc mund",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "oc aldrig hans bud forgette/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Vi skulle alle menniske haffue kær/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "saa vel vor fiende som vore venner/",
      "part": false,
      "marginal_notes": [
        "Mat v"
      ]
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "aff hiertet dem alt gaat vnde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Her maa wi see vor naturis mact/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 5,
      "text": "oc syndelige art begrybe/",
      "part": false,
      "marginal_notes": [
        "Gene vi oc viii"
      ]
    },
    {
      "id": 37,
      "stanza_id": 5,
      "text": "Hun skulle det gøre som nu er sagt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 5,
      "text": "om hun vilde met Gud bliffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 5,
      "text": "Men hwn er der altid emod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "sin fiende kan hun ey være god",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "och Gud kan hun ey frøcte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 6,
      "text": "Nu skulle Gudz bud opfyllis vden brøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 6,
      "text": "ellers motte wi alle fortabis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 6,
      "text": "Thi vdsende Gud sin Søn Jesum Christ",
      "part": false,
      "marginal_notes": [
        "Ezechi. xxxvi Rom. viii"
      ]
    },
    {
      "id": 45,
      "stanza_id": 6,
      "text": "oc lod hannem for vor skyld plauis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 6,
      "text": "Han haffuer Gudz bud all ene opfyld/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 6,
      "text": "der met Gudz faders wrede stild/",
      "part": false,
      "marginal_notes": [
        "Eph. ii"
      ]
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "som for gick offuer oss alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 7,
      "text": "Oc naar de nu opfylt ere/",
      "part": false,
      "marginal_notes": [
        "Ro viii Luce vii"
      ]
    },
    {
      "id": 50,
      "stanza_id": 7,
      "text": "aff Christo som dem kunde holde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 7,
      "text": "Her skulle wi Christne menniske lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 7,
      "text": "vor Christne trois krafft at vere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 7,
      "text": "Jcke andet en tro min herre kære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 7,
      "text": "din pine oc død min sa lighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 7,
      "text": "du haffuer for mig betalid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 8,
      "text": "Der paa ieg tuiler inthit met alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 8,
      "text": "dine ord kunde icke bedrage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 8,
      "text": "Du lad inted menniske i mishaab falle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 8,
      "text": "det drager du icke tilbage /",
      "part": false,
      "marginal_notes": [
        "Titum i Mar xvi i Pet i"
      ]
    },
    {
      "id": 60,
      "stanza_id": 8,
      "text": "Huo paa mig tror oc bliffuer døbt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 8,
      "text": "til hannem haffuer ieg hiemmerig køpt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 8,
      "text": "at han skal icke fortabis",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 9,
      "text": "Denne tro hielper oss for Gud all ene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 9,
      "text": "om wi henne i hiertet beuare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 9,
      "text": "Hun giffuer fra sig ith saadant skyn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 9,
      "text": "gode gerninger kan hun ey spare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 9,
      "text": "Til Gud all ene strecker sig en ret tro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 9,
      "text": "men kerlighed gør alle menniske gaat/",
      "part": false,
      "marginal_notes": [
        "Deutero xxxii"
      ]
    },
    {
      "id": 69,
      "stanza_id": 9,
      "text": "om du est aff Gud fødder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 10,
      "text": "Gudz bud lære oss ath kende vore synd/",
      "part": false,
      "marginal_notes": [
        "Rom iii oc vii"
      ]
    },
    {
      "id": 71,
      "stanza_id": 10,
      "text": "de sla vort hierte neder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 10,
      "text": "Saa kommer det hellige Euangelium/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 10,
      "text": "oc trøster oss alle oc siger/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 10,
      "text": "kommer alle til Christ hanvil eder glede/",
      "part": false,
      "marginal_notes": [
        "Act xv"
      ]
    },
    {
      "id": 75,
      "stanza_id": 10,
      "text": "vnder loffuen er sorg oc møde ath leffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 10,
      "text": "met henniss gerninger alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 11,
      "text": "Ret gode gerninger komme wisselig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 11,
      "text": "aff troen den Gud i oss skaber/",
      "part": false,
      "marginal_notes": [
        "Gala v"
      ]
    },
    {
      "id": 79,
      "stanza_id": 11,
      "text": "Gudz aand haffuer hun vden tuil met sig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 11,
      "text": "alt gaat han i oss mager/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 11,
      "text": "Dog gør troen oss salig all ene/",
      "part": false,
      "marginal_notes": [
        "Gene xv Galat v"
      ]
    },
    {
      "id": 82,
      "stanza_id": 11,
      "text": "gode gerninger skulle wor ieffn christen tiæne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 11,
      "text": "der paa wi den rette tro mercke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 12,
      "text": "Vort haab det bier tolmodelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 12,
      "text": "effter det Gudz ord oss iætter/",
      "part": false,
      "marginal_notes": [
        "Ro v oc viii"
      ]
    },
    {
      "id": 86,
      "stanza_id": 12,
      "text": "saa lenge det skeer met glæde oc fred/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 12,
      "text": "alting i Gudz hand setter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 12,
      "text": "Han wed vel hwad oss nøtteligt er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 12,
      "text": "alting lader han oss gaffnlig være",
      "part": false,
      "marginal_notes": [
        "Math vi"
      ]
    },
    {
      "id": 90,
      "stanza_id": 12,
      "text": "der paa skulle wi ey tuile",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 13,
      "text": "Oc om dw finge saa stor modgang/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 13,
      "text": "ath Gud syntis være dig vreder/",
      "part": false,
      "marginal_notes": [
        "Job per totum"
      ]
    },
    {
      "id": 93,
      "stanza_id": 13,
      "text": "Dog see du til ath ingen tuang/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 13,
      "text": "dig fra din tro bortleder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 13,
      "text": "Men bliff fast vid Gudz ord altid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 13,
      "text": "han synis være vred han er dog blit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 13,
      "text": "thi lad dig icke forfære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 14,
      "text": "Gud fader oc Søn oc den Helligand",
      "part": false,
      "marginal_notes": [
        "Coloss i"
      ]
    },
    {
      "id": 99,
      "stanza_id": 14,
      "text": "hannem wille wi prise alle sammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 14,
      "text": "hans godhed i alle land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 14,
      "text": "och bede han ville fuldkomme/",
      "part": false,
      "marginal_notes": [
        "Psalmo lxviii Mat vi"
      ]
    },
    {
      "id": 102,
      "stanza_id": 14,
      "text": "Det han i oss nu haffuer begynt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 14,
      "text": "Sig selff til priss euindelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 14,
      "text": "hanss naffn kunde helligt gøris",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 15,
      "text": "Hans rige tilkomme/ hans vilge ske",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 15,
      "text": "her paa iorden/ som i hiemmelens trone",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 15,
      "text": "Vort daglige brød oss i dag giffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 15,
      "text": "vore synder vilde forlade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 15,
      "text": "Ret lige som wi vore modbrødre gøre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 15,
      "text": "oc vilde oss icke i fristelse føre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 15,
      "text": "men frelse oss fra ont amen",
      "part": false,
      "marginal_notes": []
    }
  ]
}