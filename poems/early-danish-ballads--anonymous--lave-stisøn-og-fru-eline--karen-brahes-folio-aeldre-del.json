{
  "id": null,
  "title": "Lave Stisøn og Fru Eline",
  "year_created": 1583,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Karen Brahes folio, ældre del",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/KBRA41.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Dett wor Lauy Stysen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hand red seg vnder ø:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "feste hand stalltten Ellensborig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "hun war saa wen en møø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: Siden wilde hun aldrig søre. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Feste hand stolltenn Ellendsborig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "den høffske lili-wand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "saa løste hanom Lauj Stisenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "at drage y fremede land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "\"Hør du, Espenn Ottesenn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "ieg throer deg aller-best:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "wogte meg well stolten Ellensborig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "denn iumfrw, ieg haffuer fest!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Tthett wor Laui Stisenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "hand styrer sin sniecke fora land:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "thett wor stallten Ellensborig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "hun staar paa huiden saand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Hand haffde icke vde aff landit werit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "for-vden en stackit thid:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "thett wor Espen Ottesen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "hand agthett at giøre hanom suig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Tthett wor Espenn Ottesenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "och siuøber hand seg y skiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "saa gar hand y hyffuelofft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "for stalten Ellensborig ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "\"Hell seder y, stoltenn Ellensborig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "y løser myn elskuoffuens thuang!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "well y giffue meg en skiorte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "och siy den med eters haand?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Hell seder y, stolltenn Ellinsborig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "well y were meg saa huld:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "giffuer y meg en skiorte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "och syrr den seleff med guld!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "\"Giffuer ieg eter en skiortte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "och stecker ieg den med guld:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "spør thett Lauj Stisenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "hand bliffuer meg aldrig huld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Giffuer ieg nu ehter en skiorte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "och siyr den med myn hand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "thett spør well Lauj Stisenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "vdj dy fremede land.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "Tthett thi icke anditt wieste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "ind dy wor iene thuo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "vde stuod thend for-bandit thernn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 10,
      "text": "och liude hun der-paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Tthett tha wor den therne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "hun luod dy lønebreffue skriffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "sender hun denom op at land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 11,
      "text": "Laui Stisenn lader hun denom giffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "\"Her er en hiortt woon y ehters haffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "hand bleder dj øuerste blade:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "komer i icke snart aff lieding hiem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 12,
      "text": "hand giør thi blomster stuor skade.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "Tthett wor Lauj Stidsen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "der hand dy løne-breff suo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "hand kunde huerkind ede eler drike,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 13,
      "text": "icke søffuen om naten suoffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Hand kund huerkenn ede eller driecke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "icke søffuen om nattenn suoffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "\"Suene, y lader myn snecke rede!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 14,
      "text": "ieg well til Dan-mark buo.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "Tthett wor Laui Stisen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "hand styrer sin snecke for land:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "dett wor Espen Ottesenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 15,
      "text": "hand rende syn ganger paa sand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "\"Hør du, Espen Ottesen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "huor stander det hiem til myn?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "huor lider stolten Ellinsborig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 16,
      "text": "siden hun bleff kerreste dynn?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "\"Well stander y dyn gaarde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "well stander thett hieme til dyn:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "well lider stollten Ellensborig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 17,
      "text": "rett alldrig bliffuer hun mynn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 18,
      "text": "Tthett wor Laui Stisenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 18,
      "text": "hand suøber seg hoffuet y skiennd:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 18,
      "text": "saa ganger hand y hyffuelofft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 18,
      "text": "for staltenn Ellensborig ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 19,
      "text": "Tthett wor Lauj Stisenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 19,
      "text": "hand ind att dørenn thrend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 19,
      "text": "steelle saad stolltenn Ellinsborig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 19,
      "text": "och hinder rand thaare paa kiend.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 20,
      "text": "Lenge stuod Lauj Stidsenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 20,
      "text": "och thengte hand wed seg:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 20,
      "text": "\"Thett mone slett inthett for gode were,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 20,
      "text": "du stander icke op mod meg. -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 21,
      "text": "Hør thu, stalltenn Ellensborig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 21,
      "text": "huy giøres deg kiender saa bleg?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 21,
      "text": "haffuer ieg saa lenge aff landit werit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 21,
      "text": "det du haffuer glempt at lieegge?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 22,
      "text": "\"I maa thett well thro, Lauj Stidsenn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 22,
      "text": "men y haffuer weritt aff land:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 22,
      "text": "thett er alt for ethers skyld wordenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 22,
      "text": "det tiden giøres meg saa lang.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 23,
      "text": "\"Er thett nu for myn skyld wordenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 23,
      "text": "det tiden giøres deg saa lang:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 23,
      "text": "daa wolder thett Espen Ottesen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 23,
      "text": "dit belte giøris deg saa thrang.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 24,
      "text": "Tthett suaridt stallten Ellensborig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 24,
      "text": "saa tog hun paa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 24,
      "text": "\"Y thieer quer, Laui Stidsenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 24,
      "text": "y siger ret aldrig saa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 25,
      "text": "Saa hielpe meg Gud fader aff Hiemerig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 25,
      "text": "som tholde for meg død:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 25,
      "text": "rett aldrig wor ieg des werre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 25,
      "text": "Espen Ottesen hand war fød!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 26,
      "text": "\"Tthett war Lauj Stidsenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 26,
      "text": "hand thaller til suene thuo:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 26,
      "text": "\"Beder y Espen Ottesenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 26,
      "text": "y stoffuen ind for meg gaa!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 27,
      "text": "Ind kaam Espenn Ottesenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 27,
      "text": "och stedis hand for buor:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 27,
      "text": "\"Huad well y myg, Laui Stidsenn!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 27,
      "text": "huj haffuer y sendt meg ord?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 28,
      "text": "\"Skam faa du, Espenn Ottesenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 28,
      "text": "saa illde som du haffuer giortt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 28,
      "text": "Gud forlade deg, stollttenn Ellens-borig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 28,
      "text": "saa wel ieg haffuer deg troett!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 29,
      "text": "Tthett wor Laui Stidsenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 29,
      "text": "hand sitt suerd vddrog:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 29,
      "text": "woffue hand Espenn Ottesen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 29,
      "text": "for hindis øgen tho.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 30,
      "text": "Hand sluo ihiell Espen Ottesen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 30,
      "text": "vdy den fruerstoffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 30,
      "text": "saa stelle saad stallten Ellensborig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 30,
      "text": "det gaar hinder aldrig aff huoff.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 31,
      "text": "Saa sluo hand stalltten Ellens-borig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 31,
      "text": "vdj dy thimer fem:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 31,
      "text": "ther war icke en y ald hans gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 31,
      "text": "der hinder thuorde hielpe y dem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 32,
      "text": "\"Nu haffuer y meg saa slagenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 32,
      "text": "att ieg icke løffue kand:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 32,
      "text": "dog haffuer ieg eder kerest vdj myn hoff",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 32,
      "text": "for nogen wardsens mand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 33,
      "text": "Nu haffuer y meg saa slagen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 33,
      "text": "ieg redis fast for mit liff:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 33,
      "text": "dog haffuer ieg eder møgit kierer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 33,
      "text": "end ieg haffde Espen Ottesens X.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 34,
      "text": "Saa saatte hand stalltenn Ellensborig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 34,
      "text": "vdj saa møerke ett husz:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 34,
      "text": "der saad hun y wienter thuo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 34,
      "text": "hun suo huerken dag eller liusz.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 35,
      "text": "Ingen thør till den sørgefuld mø",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 35,
      "text": "gange tør eller well:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 35,
      "text": "for-vden Lauj Stidsens moder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 35,
      "text": "hun staall seg smuo siend till.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 36,
      "text": "Frw Biuri-all gaar hinder till och fra,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 36,
      "text": "skaffthauffll med hinder at liegge:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 36,
      "text": "\"Gud nade deg, kerre datter myn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 36,
      "text": "huad dine kiender giørs blege!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 37,
      "text": "\"I thør eder icke forvndre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 37,
      "text": "thett ieg er icke rød:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 37,
      "text": "y maa møgit mere forvndre der-paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 37,
      "text": "thett ieg er icke aff sorgenn død.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 38,
      "text": "Tthett war Lauj Stisenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 38,
      "text": "hand suøber seg hoffuit y skiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 38,
      "text": "saa gaar hand til dett mørcke husz,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 38,
      "text": "for staltenn Ellensborig ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 39,
      "text": "\"Tthu statt op, staltenn Ellensborig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 39,
      "text": "du duel icke holde lenge!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 39,
      "text": "gack du deg y hyffue-lofft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 39,
      "text": "och red myn sleffred senge!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 40,
      "text": "Vnder breder thu silcke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 40,
      "text": "och offuer thield saa smaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 40,
      "text": "thett er meg selliff, Lauj Stidsenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 40,
      "text": "meg løster at huile paa.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 41,
      "text": "Tthett suaridt stallten Ellensborig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 41,
      "text": "hun suarit et ord med erre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 41,
      "text": "\"Ald den gierning, der edir er kieer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 41,
      "text": "den well ieg gierne giørre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 42,
      "text": "Op stuod stalltenn Ellensborig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 170,
      "stanza_id": 42,
      "text": "hun duelde icke møgit lenge:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 171,
      "stanza_id": 42,
      "text": "saa gick hun y hyffuelofft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 172,
      "stanza_id": 42,
      "text": "hun rede den herris sengge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 173,
      "stanza_id": 43,
      "text": "Vnder saa brede hun silcke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 174,
      "stanza_id": 43,
      "text": "och offuer thett fløffll blaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 175,
      "stanza_id": 43,
      "text": "\"Chrest segne ham Lauj Stidsen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 176,
      "stanza_id": 43,
      "text": "som her skall huile paa!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 177,
      "stanza_id": 44,
      "text": "Aller thymitt staltell Ellensborig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 178,
      "stanza_id": 44,
      "text": "nogen tid en større harum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 179,
      "stanza_id": 44,
      "text": "saa thog hand hinder thieneste-mø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 180,
      "stanza_id": 44,
      "text": "hand lagd hind y sin arum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 181,
      "stanza_id": 45,
      "text": "\"Hør thu, stalltenn Ellensborig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 182,
      "stanza_id": 45,
      "text": "thøckis theg thett gaat at werre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 183,
      "stanza_id": 45,
      "text": "tha well ieg lade mit brølup",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 184,
      "stanza_id": 45,
      "text": "med myn sleffred giørre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 185,
      "stanza_id": 46,
      "text": "Ieg well giffue myn sleffred en kiortell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 186,
      "stanza_id": 46,
      "text": "skall were aff fløuell bla:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 187,
      "stanza_id": 46,
      "text": "ieg well giffue deg en andenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 188,
      "stanza_id": 46,
      "text": "skall wer aff wamild graa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 189,
      "stanza_id": 47,
      "text": "Ieg well giffue myn sleffred en bellte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 190,
      "stanza_id": 47,
      "text": "er giord aff guld saa fast:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 191,
      "stanza_id": 47,
      "text": "ieg well giff deg et andit,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 192,
      "stanza_id": 47,
      "text": "thett skall wer bundit aff bast.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 193,
      "stanza_id": 48,
      "text": "Tthett suaridtt stalltenn Ellensborig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 194,
      "stanza_id": 48,
      "text": "buode med thuogt och erre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 195,
      "stanza_id": 48,
      "text": "\"Alle dy kleder, y well meg giffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 196,
      "stanza_id": 48,
      "text": "denom well ieg gerne bere.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 197,
      "stanza_id": 49,
      "text": "Tthend sleffred stander y hyffuelofft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 198,
      "stanza_id": 49,
      "text": "hun kledis y fløffuell bla:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 199,
      "stanza_id": 49,
      "text": "stalt Ellensborig stander der neden for,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 200,
      "stanza_id": 49,
      "text": "klede seg y wamild gra.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 201,
      "stanza_id": 50,
      "text": "Tthend sleffred stander y hyffue-lofft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 202,
      "stanza_id": 50,
      "text": "giorder seg med guld saa fast:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 203,
      "stanza_id": 50,
      "text": "stalt Ellensborig stander der neden for,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 204,
      "stanza_id": 50,
      "text": "och giorder hun seg med bast.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 205,
      "stanza_id": 51,
      "text": "Førde dy denn sleffred-brud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 206,
      "stanza_id": 51,
      "text": "vdj den brøllups-gard:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 207,
      "stanza_id": 51,
      "text": "thett huide søleff, thett røde guld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 208,
      "stanza_id": 51,
      "text": "war icke for leggeren spartt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 209,
      "stanza_id": 52,
      "text": "Sildig om den afften,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 210,
      "stanza_id": 52,
      "text": "der doggen den drøff paa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 211,
      "stanza_id": 52,
      "text": "thett tha war thend sleffred-brud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 212,
      "stanza_id": 52,
      "text": "hun løster at suoffue gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 213,
      "stanza_id": 53,
      "text": "Saatte di den sleffred-brud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 214,
      "stanza_id": 53,
      "text": "vdj den brude-seng:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 215,
      "stanza_id": 53,
      "text": "thett war Lauj Stidsen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 216,
      "stanza_id": 53,
      "text": "hand dualde icke møgit lenge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 217,
      "stanza_id": 54,
      "text": "Lauj Stidsenn saatte seg paa senge-stock,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 218,
      "stanza_id": 54,
      "text": "stalt Ellensborig drog aff hans skuff:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 219,
      "stanza_id": 54,
      "text": "ther kund ingen y warden siee,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 220,
      "stanza_id": 54,
      "text": "hun anten gred eller luo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 221,
      "stanza_id": 55,
      "text": "Sttalt Ellensborig bockitt til iorden ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 222,
      "stanza_id": 55,
      "text": "drog aff Lauj Stidsens skuoff:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 223,
      "stanza_id": 55,
      "text": "thett guode belte, thett hand hinder gaff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 224,
      "stanza_id": 55,
      "text": "thett brast tha sønder y thuo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 225,
      "stanza_id": 56,
      "text": "Tthett suaritt stalltenn Ellensborig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 226,
      "stanza_id": 56,
      "text": "hun thøgte thett werre fuld ilde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 227,
      "stanza_id": 56,
      "text": "\"Nu holt thett, thett brøste skulde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 228,
      "stanza_id": 56,
      "text": "och brast, som brøste wilde.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 229,
      "stanza_id": 57,
      "text": "Tthett melltte Lauj Stidsenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 230,
      "stanza_id": 57,
      "text": "och suaritt hand hinde saa huadst:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 231,
      "stanza_id": 57,
      "text": "\"Huad war thett, som holde skulde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 232,
      "stanza_id": 57,
      "text": "och huad war thett, som brast?\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 233,
      "stanza_id": 58,
      "text": "\"Tthett guode bellte, som y meg gaff,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 234,
      "stanza_id": 58,
      "text": "och thett war thett, som brast:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 235,
      "stanza_id": 58,
      "text": "mitt sorrig-fuld hiarte matte well haffue brostet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 236,
      "stanza_id": 58,
      "text": "men thett holt alt for fast.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 237,
      "stanza_id": 59,
      "text": "Suaritt thett Lauy Stidsen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 238,
      "stanza_id": 59,
      "text": "hand bleff y hoffuen saa muod:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 239,
      "stanza_id": 59,
      "text": "\"Ieg suer der-paa, stalt Illensborig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 240,
      "stanza_id": 59,
      "text": "att du est mier ind guod!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 241,
      "stanza_id": 60,
      "text": "Sttat du op, mynn sleffred,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 242,
      "stanza_id": 60,
      "text": "och gack aff seng fraa meg!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 243,
      "stanza_id": 60,
      "text": "thu kaam igen, stalt Ellensborig!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 244,
      "stanza_id": 60,
      "text": "med ere anamer ieg theg.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 245,
      "stanza_id": 61,
      "text": "\"Hør y thett, Laui Stidsen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 246,
      "stanza_id": 61,
      "text": "y lader bortt faarre eders gamell!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 247,
      "stanza_id": 61,
      "text": "y lader hiente ind thi preste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 248,
      "stanza_id": 61,
      "text": "ther osz ma giffue til-samell!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 249,
      "stanza_id": 62,
      "text": "Tthett melltte stalltenn Ellens-borig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 250,
      "stanza_id": 62,
      "text": "klede seg for brude-seng:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 251,
      "stanza_id": 62,
      "text": "\"Hielp nu Gud fader y Hiemerrig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 252,
      "stanza_id": 62,
      "text": "eders wenskab matte waare lenge!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 253,
      "stanza_id": 63,
      "text": "Der war løst y Lauj Stidsens gaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 254,
      "stanza_id": 63,
      "text": "thi glede denom alle aff gamell:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 255,
      "stanza_id": 63,
      "text": "buod hand och stalltenn Ellensborig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 256,
      "stanza_id": 63,
      "text": "dy bleff da widd til-samell.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 257,
      "stanza_id": 64,
      "text": "Ind daa kaam den sleffred,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 258,
      "stanza_id": 64,
      "text": "hun war buode wred och wrang:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 259,
      "stanza_id": 64,
      "text": "\"Y gar frem, alle mine mørr,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 260,
      "stanza_id": 64,
      "text": "y henger op silcke offuer stang!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 261,
      "stanza_id": 65,
      "text": "Tthett melltte Lauj Stidsenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 262,
      "stanza_id": 65,
      "text": "och saa thog hand opaa:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 263,
      "stanza_id": 65,
      "text": "\"Du gaff att dør, du sleffred,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 264,
      "stanza_id": 65,
      "text": "vd fraa myn øgen thuo!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 265,
      "stanza_id": 66,
      "text": "Haffuer ieg stallt Ellens-borig brøtt imod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 266,
      "stanza_id": 66,
      "text": "thett haffuer du, sleffred, giort;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 267,
      "stanza_id": 66,
      "text": "men alle di dage, ieg løffue maa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 268,
      "stanza_id": 66,
      "text": "da skall ieg were hinder guod.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 269,
      "stanza_id": 67,
      "text": "Tthett war Laui Stidsenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 270,
      "stanza_id": 67,
      "text": "thog stallt Ellens-borig y syn arum:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 271,
      "stanza_id": 67,
      "text": "\"Loffuit wer Gud fader i Hemerrig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 272,
      "stanza_id": 67,
      "text": "for-wonden er all myn harum!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 273,
      "stanza_id": 68,
      "text": "Nu haffuer stallten Ellensborig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 274,
      "stanza_id": 68,
      "text": "for-wonden bod angist och quide:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 275,
      "stanza_id": 68,
      "text": "hun haffuer nu Lauj Stidsen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 276,
      "stanza_id": 68,
      "text": "med erre soffuer hun wed hans sidde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 277,
      "stanza_id": 68,
      "text": ":: Siden wilde hun aldrig sørrig. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}