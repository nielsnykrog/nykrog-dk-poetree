  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1849,
    "url": "https://tekstnet.dk/books/andersen-hc_poesien/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Der er et herligt Land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Det kaldes Poesien;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": ":|: Det naaer i Himlen op, :|:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Det rummes i en Rosenknop,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Og Hjerte-Melodien",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": ":|: Boer paa dets grönne Strand. :|:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Der faaes det rige Guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Hvorved Du Verdner vinder;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Der bliver Hjertet ungt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Og er Dig Livet altfor tungt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Du Jacobsstigen finder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Til Himlen underfuld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Der til et Skjönheds Digt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Sig Hverdags-Livet hæver;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Du föler, Gud er nær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Det Forbigangne lever der;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Den stærke Tænker bæver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Saa stort er her, saa rigt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Hvor Verden savner Ord,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Her liden Fugl har Sange;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "Held , som der blev Drot!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Ved Dig, alt Sandt og Skjönt og Godt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "– Trods Paradisets Slange –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Slaaer Glorie om vor Jord!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Det Aandens Hindostan,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 4,
      "text": "Det Hjem for Melodien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 4,
      "text": "Det Pagtens Land med Gud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 4,
      "text": "Som staaer, naar Verdner slettes ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Det kaldes Poesien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "Det Lysets Fædreland!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 5,
      "text": "Vor Junker kom i Skoven, der Grethe han saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 5,
      "text": "hun gik og samled’ Jordbær, hun trak dem paa Straae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 5,
      "text": "de modneste, de bedste, hvert friskt sødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 5,
      "text": "»ei Grethelil!« saa talte han, »det var jo heldigt mødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 5,
      "text": "jeg vil hjælpe med at plukke!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 6,
      "text": "»Det rødeste, det bedste, jeg fandt denne Stund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 6,
      "text": "det sødeste, meest friske, det groer paa din Mund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 6,
      "text": "du veed ei selv din Rigdom, jeg seer den,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 6,
      "text": "og derfor vil jeg hjælpe dig, jeg er en ærlig Ven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 6,
      "text": "jeg vil hjælpe med at plukke!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 7,
      "text": "I Skoven stod en Slaaentjørn, den hørte derpaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 7,
      "text": "før Junkeren det vidste, i Tjørnen han laae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 7,
      "text": "og Grethe løb, hun smiilte: »jo, jo Tak!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 7,
      "text": "den Slaaentjørn havde tornet Green, og alle Torne stak:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 7,
      "text": "»jeg vil hjælpe med at plukke!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 8,
      "text": "See Sørgetoget gjennem Gyden gaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 8,
      "text": "det er et deiligt Solskin, Lærken slaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 8,
      "text": "paa Kistelaaget er en Rose lagt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 8,
      "text": "den unge Brud til Graven bliver bragt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 9,
      "text": "I Gyden her, som Barn hun leged glad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 9,
      "text": "ved Hyldetræet hist som Brud hun sad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 9,
      "text": "ved Stenten der de skildtes, da han gik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 9,
      "text": "ved Stenten der om ham hun Dødsbud fik.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 10,
      "text": "Hvad drømte Rosen vel i Knoppen nys,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 10,
      "text": "hvad drømte den ved Solens første Kys,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 10,
      "text": "og ved det sidste glødende Farvel?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 10,
      "text": "hvad drømmer den paa Kistens sorte Fjel?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 11,
      "text": "See, Hørren staaer saa slank og fri,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 11,
      "text": "Hvor blomstrer hele Flokken!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 11,
      "text": "Hver Klokke der har Melodi,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 11,
      "text": "Men uden Knevl er Klokken;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 11,
      "text": "Du hører ei dens »ding, ding, dang!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 11,
      "text": "Nei, ikke nu – men først engang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 11,
      "text": "Naar Hørren ret har lidt og stridt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 11,
      "text": "Og ligger som Papiret hvidt; –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 11,
      "text": "En Tonemester paa det slaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 11,
      "text": "En Fjer er Troldomsstaven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 11,
      "text": "Hvad Blomsten følte, synligt staaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 11,
      "text": "I Klang det fra Papiret gaaer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 11,
      "text": "Liv svinger sig fra Graven.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
