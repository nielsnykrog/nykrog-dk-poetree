  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Hun var en Qvinde af et sjeldent Værd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Det Skjønne med sit Hjerte hun omfatted’,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Skjøndt gammel, fulgte hun de Unges Færd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Det Gode i det Ny’ hun kjærligt skatted’.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "En riig Erindrings Sum var hendes Skat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Den ruster ei, og evig vil den være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "I Jorden er nu hendes Kiste sat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Men selv hun er hos Gud og sine Kjære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Saa tro vor Tanke gjennem Rummet seer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Hist samles vi og skilles aldrig meer.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
