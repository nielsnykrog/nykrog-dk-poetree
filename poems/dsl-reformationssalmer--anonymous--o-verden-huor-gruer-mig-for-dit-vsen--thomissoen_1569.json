  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Verden huor gruer mig for dit væsen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "naar vilt du opnæse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "oc rese aff Synden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "aff Dieffuelen est du bunden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "til Helffuedis fart.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "O nød/ O jammer/ O ælende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Saa vden maade oc ende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Alle stende paa Jorden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Skendelige forførde vorde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Det gremmer mig hart.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Døu/ Blind er huer nu i de Sager/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Der i hand skulde vaage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Oc tage sig vare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "At hand salig maatte fare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "J Euighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Gantsk Mesterlige oc wformercket/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "Dieffuelen saadant vercker/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "Oc stercker sin Skare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Vden all fryct oc fare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "J stor tryghed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "Guds ord der mod rober oc lærer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "Jngen sig forbedrer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "Huer ærer ond Selskab:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "Rende i hob til Helffuede aff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Som i en Dantz.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "Synd er ey nu mere for synd actit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "Men huer for sig tracter/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "Oc vocter/ huad løst er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "Der til huer nu sig trøst er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": "Aldelis gantsk.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "Mand finder ey nogen sted vdi Landen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "Guds fryct mere for haanden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 6,
      "text": "Synd/ klander regerer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": "Vng/ Old/ Arm/ Rig sig tierer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 6,
      "text": "J ondskab frijt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "Brask/ bram/ Guds ædele gaffuer skender/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 7,
      "text": "Stor kaast huer tiluender",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 7,
      "text": "Oc blender vden sorrig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 7,
      "text": "Skulde hand end laane oc borge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 7,
      "text": "Det staa sin tid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 8,
      "text": "Det vaare vist io it Christeligt stycke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 8,
      "text": "Maadelige sig skicke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 8,
      "text": "Vaar icke slem Daarhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 8,
      "text": "Mod Gud oc nødtørfftighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 8,
      "text": "J spillet mest.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 9,
      "text": "Fraadzeri vraal skraal suerie sla met neffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 9,
      "text": "Stedz vdi suss hen sueffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 9,
      "text": "Oc leffue som Bester/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 9,
      "text": "Acter mand nu aller mest",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 9,
      "text": "For tidkort best.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 10,
      "text": "Huo tencker at Gud vil ey sligt haffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 10,
      "text": "Huad hielper alle dage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 10,
      "text": "Den skade beklage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 10,
      "text": "At Gud straffer oc plager",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 10,
      "text": "Synden met Død.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 11,
      "text": "Dieffuelen kand mand nu saa til ære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 11,
      "text": "Gierne villig at være/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 11,
      "text": "Kaast tære/ ringe acte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 11,
      "text": "Egit beste her ey betracte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 11,
      "text": "Heller Brødris nød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 12,
      "text": "Men huad til Guds ære kunde komme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 12,
      "text": "Guds ord oc Christendomme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 12,
      "text": "Til fromme fra arghed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 12,
      "text": "Der kand mand intet vden Karighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 12,
      "text": "Tui dig den skam.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 13,
      "text": "Det er stor Blindhed som ieg mener/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 13,
      "text": "Det maatte stocke oc stene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 13,
      "text": "Vel væne de plager/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 13,
      "text": "Der met Gud saadanne Sager",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 13,
      "text": "Vil straffe gram.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 14,
      "text": "Huad vil mand nu om saadanne klage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 14,
      "text": "Der Dieffuelen behage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 14,
      "text": "Oc voffue liff leffnit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 14,
      "text": "Gods/ ære/ Hustru/ børn offuergiffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 14,
      "text": "Mod Guds forbund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 15,
      "text": "Oc de megit Christeligt blod vdspilde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 15,
      "text": "Sit Færne land foruilde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 15,
      "text": "Wmilde i Sager/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 15,
      "text": "Huilcket Dieffuelen behager",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 15,
      "text": "Vel allelund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 16,
      "text": "Hoer/ Bolerj er Hiertens gilde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 16,
      "text": "Slem snack det kand kilde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 16,
      "text": "Aarle silde legemit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 16,
      "text": "Hoffmod/ Had/ tuedrectighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 16,
      "text": "Wlydighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 17,
      "text": "Den onde roed Gerighed til Rigdom",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 17,
      "text": "Er Gud all Verden om/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 17,
      "text": "Der aff kom den vaade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 17,
      "text": "At ey ret brugis Guds naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 17,
      "text": "Til salighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 18,
      "text": "Ah huo kand all ondskab fortellie/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 18,
      "text": "Der aff dybiste Helffuede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 18,
      "text": "Opuelder vden maade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 18,
      "text": "Lader sig huercken stoppe eller raade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 18,
      "text": "Nogrelund dissuer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 19,
      "text": "Mand siunger/ mand maner/ mand lærer/ mand straffer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 19,
      "text": "Jngen fruct mand skaffer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 19,
      "text": "Det napper dog intet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 19,
      "text": "Saa slet Verden forblindet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 19,
      "text": "J arghed er.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 20,
      "text": "Adelen aff ære oc dygd mon sigis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 20,
      "text": "Ædel naffn dem giffuis",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 20,
      "text": "Oc scriffuis til ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 20,
      "text": "Om de det alle fuldgiøre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 20,
      "text": "Findis nu vel.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 21,
      "text": "Borger oc Bønder som de mene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 21,
      "text": "Acte Guds ord rene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 21,
      "text": "Dog ene i Kircken",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 21,
      "text": "Siunis de Gud at dyrcke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 21,
      "text": "Er det oc skel?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 22,
      "text": "Guds ædele Sæd paa veyen trædis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 22,
      "text": "Aff Fule opædis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 22,
      "text": "Ey glædis paa stene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 22,
      "text": "Torn monne hende oc formene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 22,
      "text": "At giøre fruct.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 23,
      "text": "Ey hielper at Gud straffer oc ræder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 23,
      "text": "Met Jld/ Vand oc væder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 23,
      "text": "Wglæder/ Dyre tide/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 23,
      "text": "Pestilentz/ Krig/ Oprør/ quide/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 23,
      "text": "Følger dog ingen tuct.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 24,
      "text": "Derfor kiere Herre/ dig dog hid vende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 24,
      "text": "Paa ondskab giør ende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 24,
      "text": "Lad kiende din Doms stund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 24,
      "text": "Dieffuelen sla ned i grund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 24,
      "text": "Met din Haand vel hart.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 25,
      "text": "Din Herlighed/ O Christ/ sig skynde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 25,
      "text": "Din Basun lad klinge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 25,
      "text": "Forsuinde alt wkrud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 25,
      "text": "Hielp oss vel aff Verden vd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 25,
      "text": "Jo snart jo snart.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 26,
      "text": "Det begære alle Christne fromme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 26,
      "text": "Til priss dit Naffn komme/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 26,
      "text": "Hørsomme vden gammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 26,
      "text": "Oc sige alle sammen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 26,
      "text": "Amen Amen.",
      "part": false,
      "marginal_notes": []
    }
  ]
}