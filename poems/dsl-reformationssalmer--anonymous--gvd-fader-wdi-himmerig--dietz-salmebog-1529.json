  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "GVd fader wdi himmerig/",
      "part": false,
      "marginal_notes": [
        "Exodi. xx. Deuter. v. Deut. vj."
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "sÿn wilie han oss kende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "ther han oss nid til iorderig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "the. x. budord wdsende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Thet første budord thet er nw saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "thet bør teg nw att mercke:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "affguder skaltu teg ey faa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "men een Gud skaltu dyrcke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Tw skalt oc ey forfengelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Guds hellige naffn paakalle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "om tw wilt ey ewindelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "ÿ pÿnen thet vngiælde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Tw skalt oc komme ihw ther næst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Sabbats dag hellig att giøre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "oc tiæne Gud som tw kant best/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Guds ord tha skaltu høre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Tw skalt oc hedre oc ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "thÿn fader oc thÿn moder/",
      "part": false,
      "marginal_notes": [
        "Math. xv."
      ]
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "the teg opfødde med ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "med Gud tw salig worder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Tw skalt oc ingen slaa ihiel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "oc ey mandrab bedriffue/",
      "part": false,
      "marginal_notes": [
        "Math. v. Roma. xij."
      ]
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "thÿn broder skaltu vnde wel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "tha mottw salig bliffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Tw skalt oc ey bedriffue hoor/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "thet monne saa mangen daare/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "vkyskheds synd hun snart forgaar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "men pÿnen hun wel waarer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "Tw skalt oc ingen stiæle fraa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "hans gods/ hans heder ey ære/",
      "part": false,
      "marginal_notes": [
        "Rom. xiij."
      ]
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "ÿ werden skaltu leffue saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "att tw retwÿss kant wære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "Tw skalt ey falske witnesbyrd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "paa thÿn ieffnchristen bære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "eller thet bliffuer teg fuld gantske dyrt/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "ÿ ewig pÿne att wære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "Ther næst tw skalt oc ey attraa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "thÿn broders høstru wene:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "men all then stund tw leffue maa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "thÿn broder skaltu tiæne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "Thet sÿste budord thet er nw saa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "thet hør teg nw att mercke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "thÿn broders gods tw ey attraa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "hans hwss oc ey hans swene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "Gud fader Søn oc then Helliaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "han giffue oss aff sÿn naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "att wÿ motte wdi alle land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "hans budord wel bewaare.",
      "part": false,
      "marginal_notes": []
    }
  ]
}