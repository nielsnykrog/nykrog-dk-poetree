  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Livet maa synke i Dødsnattens Kule,",
      "part": false,
      "marginal_notes": [
        "Speaker: Chor."
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Tiden maa rane igjen, hvad den gav.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Jo, der er Noget, som Tiden besejrer;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Noget der er, som skal blive og staa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Evig skal funkle, som Stjernernes Belter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Vidskabs Trofæer og Kunstnerens Krands!",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
