{
  "id": null,
  "title": "239. Min brudgom, den liflige, skiønne og søde",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
    "wiki": "Q348003"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Troens Rare Klenodie",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1739,
    "url": "https://tekstnet.dk/books/brorson-ha_troens-rare-klenodie/229/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Min brudgom, den liflige, skiønne og søde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Som hiorden blant lillier pleyer at føde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Er hemmelig fra mine telte bortgangen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "O! at jeg ham havde tilbørlig undfangen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Hand raabte saa kierlig, jeg elskte min dvale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Nu døer jeg for idel hiert-knusende qvale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Jeg kurrer og klager, og ængstes saa saare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Mit hierte det svømmer i blodige taare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Hvor skal jeg ham søge, hvor skal jeg ham finde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Hvor skal jeg henvende de ængstede sinde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Et anskrig paa gader og stræder jeg giorte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Ach kummer og jammer, min JEsus er borte!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Jeg vægterne sagde den trængsel, jeg finder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Til giensvar de gave mig blodige kinder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Jeg tænkte, de skulde mig lindre min plage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Da torde de ogsaa mit smykke borttage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Jerusalems døttre, forbarmer dog eder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Ach kommer, og hielper, og søger og leder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Og naar I ham finde, og naar I ham møde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Da siger: jeg sørger mig for ham til døde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Saa løb jeg, saa skreeg jeg: hvor est du min fromme!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Da saae jeg, min lifligste mod mig at komme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Jeg var kun et øyeblik fra dem hengangen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "Da blev jeg af hannem saa naadig undfangen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "O sødere time end sukker i munden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "Da jeg nu igien har min kiereste funden!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Jeg har ham, jeg seer ham i kierligheds brynde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "Og veed ey, hvad jeg skal for glæde begynde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 7,
      "text": "Hvor skulde mit hierte ey fryde-fuld møde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 7,
      "text": "Hans tale er honning, kand alting forsøde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 7,
      "text": "Hand hopper, hand springer paa bierge og høye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 7,
      "text": "Jeg speyler mig i hans forelskede øye.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 8,
      "text": "Jerusalems døttre! ach siger og skiønner!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 8,
      "text": "Er hand ikke liflig blant menniskens sønner?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 8,
      "text": "Hvor kunde jeg andet end eder besvære?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 8,
      "text": "Hvor kunde jeg saadan en brudgom undvære?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 9,
      "text": "Betragter, om I dog hos andre vel finder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 9,
      "text": "Saa deylige rosen-bemalede kinder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 9,
      "text": "Kand nogen saaledes som denne behage?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 9,
      "text": "Ey jorden, ey himlen jeg for ham vil tage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 10,
      "text": "Har I vel af nogen saa deylig hørt sige?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 10,
      "text": "I ansigtet skinner et gyldene rige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 10,
      "text": "Hans krusede lokke saa sorte som ravnen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 10,
      "text": "For andre saa smukke, som hvede for avnen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 11,
      "text": "Hans øynes i kierlighed tindrende lue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 11,
      "text": "Er ligesom stierner om natten at skue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 11,
      "text": "Hans kinder som urtebed liflig bemænget,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 11,
      "text": "Hans læbe som rosen med myrrha besprenget.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 12,
      "text": "Hans hænder beqvemme til store bedrifter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 12,
      "text": "Som skiønne turkoser i gyldene stifter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 12,
      "text": "Hans lemmer den artigste danlighed zirer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 12,
      "text": "Som elfenbeen smykket med klare saphirer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 13,
      "text": "Hans fødder staae faste og fra mig ey flytter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 13,
      "text": "Som piller af marmor paa gyldene stytter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 13,
      "text": "Jeg skifter vel stedet snart ude snart inde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 13,
      "text": "Men allesteds JEsum jeg hos mig kand finde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "Hans aasyn er yndigt for sielenes øye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Som cederen pranger paa libanons høye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "Naar sielen ham kysser, hans gane den lugter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "Af paradiis roser og himmelske frugter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 15,
      "text": "Ja saadan een har jeg for alle udkaaret,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 15,
      "text": "Og saadan een var det, jeg havde forloret,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 15,
      "text": "Ja saadan een er det, jeg elsker for andre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 15,
      "text": "I hvor jeg i verden skal være og vandre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 16,
      "text": "Ham vil jeg, ham har jeg, den evige klippe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 16,
      "text": "Ham vil jeg ey lade, hand kand mig ey slippe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 16,
      "text": "I moders gemakker jeg vil ham indføre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 16,
      "text": "Der vil hand mig favne og frydefuld giøre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 17,
      "text": "Saa lad nu din sødhed mig aldrig undrykkes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 17,
      "text": "Men dybt i mit hierte som seglet indtrykkes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 17,
      "text": "At intet min kierlighed dæmper og dølger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 17,
      "text": "Men lammet, i hvor det gaaer, elsker og følger.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
