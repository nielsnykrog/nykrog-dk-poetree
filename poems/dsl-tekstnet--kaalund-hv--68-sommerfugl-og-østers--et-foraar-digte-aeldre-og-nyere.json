  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "\"Hvad fik hin Østers Skallen til?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Og jeg, hvi fik jeg ingen?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Hver næsvis Dreng kan, naar han vil,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "mig plumpt befamle Vingen.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Saa klaged højt en Sommerfugl,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "men mild Naturen svared:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "\"Hvad var Du, hvis det plumpe Skjul",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "for Lyset Dig bevared?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Dog giv mig dine Vinger to",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "og dine Øjne begge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "da skal Du tryg i Støvet bo",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "og faa en Skal til Dække.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Dér hører og dér sér Du ej,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "dér ængstes Du ej mere.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "- \"Nej,\" tænkte Sommerfuglen, \"nej,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "gid Pokker Østers være!\"",
      "part": false,
      "marginal_notes": []
    }
  ]
}
