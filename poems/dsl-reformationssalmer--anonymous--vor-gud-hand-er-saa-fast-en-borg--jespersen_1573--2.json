  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "VOr Gud hand er saa fast en borg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hand er vor skiold oc verie/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Hand hielper oss aff nød oc sorg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "der oss vil her besnerie/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Dieffuelen vor gamle Fiend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "vil oss offueruinde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "stor mact oc argelist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "bruger hand mod oss vist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "paa Jorden er ey hans lige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Vor egen mact er intet verd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Wi ere snart offueruunden:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Der strider for oss en veldige Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Alting maa for hannem bugne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Spør du huo hand er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Christus hand heder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "En Herre offuer alle Herrer/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Oc ey ere Frelsere flere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Marcken vil hand beholde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Det all Verden fuld aff Dieffle vaar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Oc vilde oss slet opsluge:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Dem frycte wi icke ved it haar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Thi Gud kand dem det forbiude.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Er Verdsens Første vred/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Vil oss sencke ned/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Hand kand dog intet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Christus haffuer hannem fangit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Jt Guds ord kand hannem binde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Det samme ord de lade vel staa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Oc der til wtack haffue:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Thi Gud vil selffuer hoss oss gaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Alt met sin Aand oc naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Tage de bort vort Liff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "Gods/ ære/ Børn oc Viff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "Wi passe ey der paa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "De kunde ey mere faa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "Guds rige wi dog beholde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "IVstus es Domine,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "et rectum iudicium tuum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "Fac cum seruo tuo secundum misericordiam tuam.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "Beati immaculati in via,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "qui ambulant in lege Domini.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "Gloria Patri et Filio et Spiritui sancto:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "Sicut erat in principio et nunc et semper,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "et in secula seculorum, Amen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 5,
      "text": "HAleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "Dilexi, quoniam exaudiuit Dominus vocem meam.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "Haleluia.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 6,
      "text": "FRa Mennisken haffuer ieg vend min hu/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "til dig min Siel oplyffter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 6,
      "text": "O Herre Gud beuar mig nu/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 6,
      "text": "at ingen mig misacter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 6,
      "text": "All min tillid haffuer ieg til dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 6,
      "text": "fra skam oc skendsel vocte mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "at sig min wuenner ey glæde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 7,
      "text": "Beskemmet bliffuer ingen Quinde eller Mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 7,
      "text": "Som sig paa dig forlade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 7,
      "text": "Din veldige Haand dem frelse kand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 7,
      "text": "Fra sorrig oc alskens vaade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 7,
      "text": "Men skam oc skendsel faa alle de",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 7,
      "text": "Som dine Tienere giøre vee/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 7,
      "text": "Foruden all Aarsage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 8,
      "text": "Viss mig/ O Herre/ din vey at gaa/ At ieg din sti maa lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 8,
      "text": "J sandhed lær mig fast at staa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 8,
      "text": "Thi du est Gud min Herre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 8,
      "text": "Min hielp oc trøst oc all tillid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 8,
      "text": "Der til forlader ieg mig altid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 8,
      "text": "Trotz dem som mig forfølge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 9,
      "text": "Min Herre lad dig til hiertet gaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 9,
      "text": "Oc verdis det at betencke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 9,
      "text": "Huorledis de alle met dig staa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 9,
      "text": "Huilcke du din Naade skencker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 9,
      "text": "Beslutet haffuer du foruist",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 9,
      "text": "Aff euighed foruden list/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 9,
      "text": "Huor met de salige vorde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 10,
      "text": "Min vngdoms brøst oc wfornufft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 10,
      "text": "O Herre vilt du forgætte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 10,
      "text": "Forlad mig all min store wtuct",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 10,
      "text": "Oc mine Synder affslette/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 10,
      "text": "Formedelst Christi rosens Blod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 10,
      "text": "Som nøgen for oss paa Kaarssit stod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 10,
      "text": "O Herre ihukom dette.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 11,
      "text": "Herren ere sød/ retuiss oc god",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 11,
      "text": "Alle dem som hannem paakalde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 11,
      "text": "Om de end noget aff veyen gaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 11,
      "text": "Hand vil dem dog ey vndfalde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 11,
      "text": "Hand lærer dem sin villie god/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 11,
      "text": "Befester hannem i deris hierte roed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 11,
      "text": "Alt effter sin egen villie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 12,
      "text": "Herrens Veye ere sandhed visselig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 12,
      "text": "Godhed/ miskund oc naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 12,
      "text": "Sit løffte holder hand tryggelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 12,
      "text": "Snarlig giffuer det til baade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 12,
      "text": "Alle dem hans Ord samtycke nu/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 12,
      "text": "Oc elske dem aff hierte oc hu/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 12,
      "text": "Som oss aff Scrifften kundgiøris.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 13,
      "text": "For dit hellige naffn/ O Herre Gud/ Affslet all mine Synder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 13,
      "text": "Det er saa megit det onde krud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 13,
      "text": "Oc voxer alle stunde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 13,
      "text": "Derfor O Herre vnderuise mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 13,
      "text": "Vdi din Low vandre rettelig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 13,
      "text": "Aldelis effter din villie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 14,
      "text": "Menniskens Siele som frycte Gud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 14,
      "text": "De skulle hans Rige arffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 14,
      "text": "De hannem tro faa euig ro/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 14,
      "text": "Oc skulle ret aldrig fordærffuis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 14,
      "text": "Herren er deris rette forsuar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 14,
      "text": "Sit Testament dem obenbar/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 14,
      "text": "Disligest den hellig Aand skencker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 15,
      "text": "O Herre Gud/ til dig altid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 15,
      "text": "Mine øyne ieg opløffter/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 15,
      "text": "Frelss mig aff Snaren ieg er vdi/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 15,
      "text": "Til Helffuede mig Synden forplicter/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 15,
      "text": "Forbarme dig mig/ O Herre Christ/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 15,
      "text": "Thi ieg er arm oc forsmaader vist/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 15,
      "text": "Der til aff mange foractet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 16,
      "text": "Min hiertens vee oc nød er stor/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 16,
      "text": "Vdaff min sorrig mig redde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 16,
      "text": "Ansee at ieg misactet er",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 16,
      "text": "Aff trældom plat formødder/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 16,
      "text": "Affslet all min wretuished/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 16,
      "text": "Thi mange giøre mig wfred/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 16,
      "text": "Oc aff fortred mig hade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 17,
      "text": "Beuar min Siel/ oc hielp nu mig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 17,
      "text": "At ieg icke nu beskemmis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 17,
      "text": "Mit stadige Haab haffuer ieg til dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 17,
      "text": "Din villie lad hoss mig fremmis/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 17,
      "text": "Oc hielp nu Herre aff sorrig oc vee",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 17,
      "text": "Jsrael dine Tienere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 17,
      "text": "Som dig allene tilhøre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 18,
      "text": "Gud Fader oc Søn oc hellig Aand Ville wi til euig tid prise/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 18,
      "text": "For hans Naade oc velgierning sand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 18,
      "text": "Som hand oss daglige beuiser/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 18,
      "text": "Til Legemit her forseer oss vel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 18,
      "text": "Oc rigelig bespiser vor Siel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 18,
      "text": "Thi siunge wi Haleluia.",
      "part": false,
      "marginal_notes": []
    }
  ]
}