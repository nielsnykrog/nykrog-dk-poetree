      "id": 0,
      "stanza_id": 0,
      "text": "¶ De retferdiges siæle ere i Guds hand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 1,
      "text": "Oc ondscabs pine scal dennem icke røre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 2,
      "text": "¶ Herre gack icke y rette med denne din tiænere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 3,
      "text": "Thi der kand da icke findis rettferdig naagen som leffuer",
      "part": false,
      "marginal_notes": []
    }
