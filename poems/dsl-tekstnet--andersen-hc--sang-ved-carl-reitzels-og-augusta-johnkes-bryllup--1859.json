{
  "id": null,
  "title": "Sang ved Carl Reitzels og Augusta Jöhnkes Bryllup, den 1ste Juni 1859",
  "year_created": 1859,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1859,
    "url": "https://tekstnet.dk/books/andersen-hc_sang-ved-carl-reitzels-og-augusta-joehnkes-bryllup-den-1ste-juni-1859/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Ved festligt Bord nu tømmes skal Pokalen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "En Krands af Ønsker være om den lagt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Forældre, Søskende, Enhver i Salen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Sit Hjertes Blomsterflor har Eder bragt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "I Kjærlighed mod Kjærlighedens Rige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Gaaer Livets Vei, og Troskab er dens Grund;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "O gid hver Dag, som kommer, maa udsige:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Velsignelse sprang frem fra denne Stund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "En Alvors-Time rig paa Drøm og Lykke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Er for den unge Brud, idet hun gaaer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Ind i det Hjem, hvor hun skal boe og bygge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Med Manden dele lyse, mørke Kaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Fromt sig hengive og dog Støtte være,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Fremmane Solskin er end Himlen graa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Der hvor ret elskes, der kan Hjertet bære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Hver Byrde, som Vor Herre lægger paa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Ved Mimers væld, Bogladen her vi mene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Brudgommen voxte op saa kjæk og klog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "»Det er ei godt, at Mennesket er ene!«",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Det læste han i alle Bøgers Bog;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Drog saa til Donau, Rhinen; – Hjertet vilde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Dog helst tilbage til det danske Hjem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "To Øine smilte der, trofaste, milde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Dem saae han paa, og saa brød Flammen frem!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Og nu da Foraar synges os fra Skoven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Forhaabningstiden svinger Krands og Flag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "Solvarmen strømmer ned, saa mild, fra oven,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Nu feires skal den glade Bryllupsdag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "For Brud og Brudgom Sangens Jubel stige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "Med gyldne Ønsker ret fra Hjertets Grund;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Gid hver en Dag, som kommer, maa udsige:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "Velsignelse sprang frem fra denne Stund!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
