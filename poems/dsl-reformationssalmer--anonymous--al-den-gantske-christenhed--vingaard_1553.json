  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "AL den gantske Christenhed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "priser Gudz Barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "for hans store kerlighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Det er nu sket som spaat hagde Esaias",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "⁕ Gabriels ord de ere fuldkomne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "Eia Eia en Jomfru haffuer it Foster fød/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "som Gud Fader hagde iæt i fordomtid",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "⁕ Nu er fød en Frelsermand en Frelsermand i Jsrael",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "aff en Jomfru/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "som oss sagde Gabriel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "⁕ Konningen vdaff Hiemmerige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "kom her ned til Jorderige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "at han vilde gøre oss salige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "Det er nu sket som spaat hagde Esaias",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 5,
      "text": "⁕ All den ganske Menniskens køn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 5,
      "text": "vor fortabit/ Gudz eniste Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "nu haffuer han oss løst igen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 6,
      "text": "Det er nu sket som spaat hagde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 7,
      "text": "⁕ Dieffuelen hagde oss alle grebit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 7,
      "text": "met sin løgen oss /",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 7,
      "text": "Christus haffuer hans mact knusit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 8,
      "text": "Det er nu sket som spaat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 9,
      "text": "⁕ Nu er kommen den salige tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 9,
      "text": "der Propheterne hagde om screffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 9,
      "text": "At Gud skulde giffue sin Søn her ned",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 10,
      "text": "Det er nu sket som spaat hagde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 11,
      "text": "⁕ Huo som Gudz Søn vil forsmaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 11,
      "text": "oc ey effter hans lærdom gaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 11,
      "text": "Han kan aldrig naade faa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 12,
      "text": "Det er nu sket som spaat hagde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 13,
      "text": "⁕ Huo som Synden vil offuer giffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 13,
      "text": "oc Gud om sin miskundhed bede/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 13,
      "text": "hand faa naade i Hiemmerige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 14,
      "text": "Det er nu sket som spaat hagde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 15,
      "text": "Det haffuer oss Christus nu fortient/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 15,
      "text": "der til haffuer hannem Gud vdsend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 15,
      "text": "Thi vaar mact hun er intet beuent",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 16,
      "text": "Det er nu sket som spaat hagde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 17,
      "text": "⁕ Der for bør oss tacke Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 17,
      "text": "Frycte hannem oc holde hans Bud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 17,
      "text": "Thi han er den voss hielper aff nød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 18,
      "text": "Det er nu sket som spaat hagde Esaias",
      "part": false,
      "marginal_notes": []
    }
  ]
}