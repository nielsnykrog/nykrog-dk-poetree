  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Christe huor vor din kundskab/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "da Paffue Siluester leffde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Da Keyser Constantinus gaff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "hannem Rom alt vnder sit velde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Forsant tror ieg/ hagde den Paffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "dig gennem dit naadis liuss forstait/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "han hagde visselige det verdzlige rige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "dig da til priss forsmaat",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Hagde Gratianus dig ret kent/",
      "part": false,
      "marginal_notes": [
        "Anno do|M C xx"
      ]
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "da han begynte at dicte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "den paffuelig low som kallis Decret",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Rommiske hantering paa hitte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "da hagde han vel giffuit dig den ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "och vnder din lerdom bleffuit/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "met huilcken du hagde met den Helligandz naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "alle Christnes hierte om dreffuit",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Hagde Keyser Nero desligest",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "dig kent den tid han raadde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "han hagde icke myrd saa mange Christne/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "twonget dem fra dig at gange/",
      "part": false,
      "marginal_notes": [
        "Hie xvii"
      ]
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Desligest andre flere Der fore vil ieg",
      "part": false,
      "marginal_notes": [
        "Rom. x"
      ]
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "min tro fra mennisken vende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "All ene herre dine ord ere gleden min",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "de lære mig dig ret kende",
      "part": false,
      "marginal_notes": []
    }
  ]
}