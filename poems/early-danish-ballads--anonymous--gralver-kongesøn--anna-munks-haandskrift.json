  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Ieg haffuer mig Enn Iomffru fest",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "som er | keÿserenns datther aff Rom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "huerinndt dag | thett Østenn dages,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "thaa vennher hunn min | komme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: farer nu vell hÿnn stalthenn sÿnell vnnder Liidenn. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Tacke haffue grannuoldt konngenssønn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "saa | vell holthe hanndt sÿnn thro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "hanndt førde | denn Iomffru thill Iselanndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "hanndt | Lodt sÿtt brølup bo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": ":: dett giorde handt | granuoldt konngenns-sønn Op-under Liden ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": ": Ennde:",
      "part": false,
      "marginal_notes": []
    }
  ]
}