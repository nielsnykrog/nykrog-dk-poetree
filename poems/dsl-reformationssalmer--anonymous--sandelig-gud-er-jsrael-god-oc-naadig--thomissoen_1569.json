  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Sandelig Gud er Jsrael god oc naadig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "huo som vil aff hiertet sin tro beuare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Men all min mod begynte som min Fod at skride oc falde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "ieg vaar i liffs oc Sielens fare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "For ieg bleff vred oc hastig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "paa hine stolte Brasker/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "der ieg saa den store lycke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "det gaar dem vel/ foruden skel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "hine wgudelige/ som mig kand tycke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Til Gud sette de icke lijd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "de frycte sig icke for dødsens tid.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Men som it Slaat baade fast oc sterck/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "faa de ret aldrig it Hoffuit verck/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "men ere fri for sorg oc vaande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Der for ere de saa glade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "at giøre andre skade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "saa driffue de deris spil/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "for Rigdom falder dem til/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "de ere hoffmodig oc stolte offuer maade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Met spot oc spe alleting foracte de/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "huad de tencke paa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "maa strax for sig fremgaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "Huad de monne tale oc andre befale/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "det maa den menige mand alt tage ved/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "lige som det vaar kommit fra Himmelen ned.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 4,
      "text": "Der for maa den fattig holde sig til dem/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 4,
      "text": "for hand er trengt til dem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "See saadanne ere de wgudelige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 5,
      "text": "som i Verden fige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 5,
      "text": "riffue oc kratte at de kunde io bliffue rige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 5,
      "text": "Huad skal ieg mere sige?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 5,
      "text": "Der ieg det saa da skred min Fod/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 5,
      "text": "oc ieg vilde være deris lige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 6,
      "text": "O min Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 6,
      "text": "dersom ieg da haffde brudet dit bud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 6,
      "text": "som du gaffst mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 6,
      "text": "da haffde ieg fortørnit dem som tro paa dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 6,
      "text": "O Herre Gud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 7,
      "text": "Jeg tog mig for vdi mit sind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 7,
      "text": "oc gick hen op i Templen ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 7,
      "text": "Der fick ieg at høre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 7,
      "text": "at de staa paa fuld løss en grund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 7,
      "text": "oc at deris endeligt den er ond/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 7,
      "text": "Dieffuelen dem bortfører.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 8,
      "text": "Derfor vil ieg nu bliffue alt hoss min Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 8,
      "text": "frycte hannem oc holde hans bud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 8,
      "text": "O Herre tag mig ved din høyre haand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 8,
      "text": "oc leed mig til Himmerige mit rette Færne land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 9,
      "text": "Amen.",
      "part": false,
      "marginal_notes": []
    }
  ]
}