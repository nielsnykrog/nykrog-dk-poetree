  },
  "body": [
    {
      "id": 0,
      "stanza_id": 12,
      "text": "Det er i Dag et deiligt Væ’r.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 12,
      "text": "Vinden vifter i Voldens Træer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 12,
      "text": "Der er ei en Skye paa Himlen at see.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 12,
      "text": "I Vinduet mine Blomster lee.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 12,
      "text": "Det er dog saa tungt med en Urtegaard,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 12,
      "text": "som indsluttes kun af et Potteskaar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 12,
      "text": "Om Sommeren er man kun lidet glad",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 12,
      "text": "ved at sidde midt i den lumre Stad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 12,
      "text": "Naar Öiet standser paa snevre Muur",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 12,
      "text": "da længes man efter den vide Natur.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 12,
      "text": "Grönt overalt og Fuglesang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 12,
      "text": "hoppende Vildt og Valdhornklang,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 12,
      "text": "viden Udfigt og svale Vind –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 12,
      "text": "det giör et let og fornöiet Sind!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 12,
      "text": "Jeg troer vi giorde ej saa ilde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 12,
      "text": "om vi kiörte idag til Kirstens Kilde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 12,
      "text": "Saa mored vi ogsaa Frökenen lidt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 12,
      "text": "Det stakkels Barn, hun græder saa tit.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 12,
      "text": "Hun blev forliebt i en smuk, ung Mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 12,
      "text": "Fordi han var over hendes Stand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 12,
      "text": "blev Moderen ganske angest og bange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 12,
      "text": "og holdt den stakkels Pige som Fange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 12,
      "text": "Troede endelig hun skulde glemme sin Ruus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 12,
      "text": "naar hun kom her, i et eenligt Huus.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 12,
      "text": "Et Aar hun nu har været hos mig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 12,
      "text": "Det giör mig ondt! thi hun græmmer sig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 12,
      "text": "Hendes Elsker er draget i Verden ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 12,
      "text": "om han eengang kommer igien, veed Gud!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 12,
      "text": "Fornöiet jeg vil hende gierne see.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 12,
      "text": "Idag beqvemt det kunde skee.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 12,
      "text": "Der kommer min Kone; vil höre hendes Mening.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 12,
      "text": "Ægtefolk maa giöre alt i Forening.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 12,
      "text": "Min kiere Mand! bliv ikke suur.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 12,
      "text": "Jeg hörte alt, thi jeg stod paa Luur.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 12,
      "text": "Du vil kiöre os ud i Skoven idag!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 12,
      "text": "Hvad siger du da til denne Sag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 12,
      "text": "At du dog er ret en god lille Mand!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 12,
      "text": "Fornöier os altid med hvad du kan.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 12,
      "text": "Det glæder mig ellers for Frökenen meer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 12,
      "text": "end for mig selv, som vel du indseer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 12,
      "text": "Hendes Öine som græder og er saa kiönne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 12,
      "text": "have godt af at komme ud i det Grönne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 12,
      "text": "Der er hun! Lav os da alting til.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 12,
      "text": "Mine Sager imens jeg ordne vil.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 13,
      "text": "Dybt Skoven bruser og Skyen gaaer.",
      "part": false,
      "marginal_notes": [
        "Speaker: MAND"
      ]
    },
    {
      "id": 45,
      "stanza_id": 13,
      "text": "Ved Strandens Blomsterbred Pigen staaer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 13,
      "text": "Höit opskyller Bölgen saa brat, saa brat;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 13,
      "text": "og hun synger ud i den dæmrende Nat,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 13,
      "text": "af trösteslös Kummer henrevet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 14,
      "text": "Ak Hiertet er dödt og hvorhen hun seer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 14,
      "text": "er intet, intet at önske sig meer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 14,
      "text": "Du Hellige! kald da dit Barn til dit Bryst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 14,
      "text": "Mig har jo alt henrykt den jordiske Lyst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 14,
      "text": "Jeg har jo alt elsket og levet!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 14,
      "text": "Deres Stemme har dog en herlig Klang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 14,
      "text": "Hvad hedder den Arie?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 14,
      "text": "Teklas Sang.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 14,
      "text": "Den er oversat efter tydsk Poesie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 14,
      "text": "til Weyses deilige Melodie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 14,
      "text": "Den er mig alt for melancolsk.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 14,
      "text": "Jeg kunde blive i Hovdet catholsk,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 14,
      "text": "hvis længe jeg hörte slige Sange.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 14,
      "text": "Af de Muntre er der dog ogsaa mange!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 14,
      "text": "Vær nu en lille, fornuftig Pige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 14,
      "text": "Vær munter og lad Sorgerne vige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 14,
      "text": "Min Mand har besluttet til Skoven at tage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 14,
      "text": "Vi skulde saa derud i disse Dage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 14,
      "text": "og idag er Veiret saa klart og net.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 14,
      "text": "Deri har De sandelig ganske Ret.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 14,
      "text": "Stakkels Pige! maa være saa meget inde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 14,
      "text": "Nu ja! Deri maa vi os finde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 14,
      "text": "Det er hverken min Mand eller mig som vil",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 14,
      "text": "holde Dem. Hvad skal man sige dertil!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 14,
      "text": "Deres Moder –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 14,
      "text": "Tal ikke om denne Sag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 14,
      "text": "Saa kiöre vi da til Skoven idag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 14,
      "text": "Ifald De Cathrine sende vil",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 14,
      "text": "til Kudsken, skal jeg lave alting til",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 14,
      "text": "i Kiökkenet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 14,
      "text": "Ja, det vil jeg gierne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 14,
      "text": "Man skal have saa mange Ting i sin Hierne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 14,
      "text": "kalder saa paa Pigen:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 14,
      "text": "Skynd dig til Hyrekudsken hen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 14,
      "text": "Vi skal i Skoven. Kom snart igien, –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 14,
      "text": "thi vi har travelt. Men först et Ord –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 14,
      "text": "bring denne Seddel – du veed hvor han boer –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 14,
      "text": "Den smukke –",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 14,
      "text": "Tys!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 14,
      "text": "Ih, Fröken Marie!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 14,
      "text": "De veed dog vel sagtens at jeg kan tie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 14,
      "text": "MARIA",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 14,
      "text": "Mine gamle Örenringe skal du faae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 14,
      "text": "For dem jeg kunde i Ilden gaae.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 14,
      "text": "Er det for Ringene, eller for mig?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 14,
      "text": "Hvor kan De nu spörge saa underlig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 14,
      "text": "Saa skal vi i Skoven? En herlig Sag!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 14,
      "text": "Skovtouren er min bedste Dag.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 14,
      "text": "Det er den eneste Dag jeg maa gaae",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 14,
      "text": "for min Madamme med Solhat paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 14,
      "text": "Ellers siger baade Hun og Han:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 14,
      "text": "Cathrine! klæd dig efter din Stand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 14,
      "text": "Naar dette Brev jeg nu bringer hen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 14,
      "text": "saa gier den unge Greve mig Penge igien.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 14,
      "text": "Det er i Sandhed en herlig Fyr!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 14,
      "text": "Saa seer jeg igien disse rare Dyr,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 14,
      "text": "disse nysselige Abekatter og Hyæner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 14,
      "text": "Derude de Folk dog meget fortiener.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 14,
      "text": "De trækker os Pengene ud af Landet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 14,
      "text": "siger, min Husbond. Det er forbandet!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 14,
      "text": "Ja, du gode Gud, hvad skal man sige?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 14,
      "text": "Det morer dog altid en stakkels Pige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 15,
      "text": "Da jeg imorges aabnede mit Öie",
      "part": false,
      "marginal_notes": [
        "Speaker: KONEN"
      ]
    },
    {
      "id": 112,
      "stanza_id": 15,
      "text": "da hopped Spurven glad paa törre Tage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 15,
      "text": "som glimted rödere i Morgenröde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 15,
      "text": "Den qviddrede og kaldte paa sin Mage;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 15,
      "text": "og sölvblaae Buen hvaltes i det Höie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 15,
      "text": "og Lærkens Slag fra Voldens Kroner löde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 15,
      "text": "De bæved mig imöde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 15,
      "text": "og toned: Du idag din Ven skal skue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 15,
      "text": "Da sprang jeg op og stirred over Byen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 15,
      "text": "henrykt i Sölverskyen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 15,
      "text": "mens Solen steeg ud af sin Rosenlue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 15,
      "text": "Og Lærken slog igien fra Voldens Kroner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 15,
      "text": "og Elskov bæved i dens Trylletoner.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 16,
      "text": "En stor, en hellig Aand usynlig vanker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 16,
      "text": "i al Naturens vidtudstrakte Egne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 16,
      "text": "og vækker Anelser om Livets Glæde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 16,
      "text": "Ak! Længsel lærte disse Kinder blegne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 16,
      "text": "adskilt fra den for hvem mit Hierte banker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 16,
      "text": "for hvem jeg kun kan sukke ömt og græde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 16,
      "text": "Hvi fyldte stille Glæde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 16,
      "text": "mit Bryst idag, da Solen röd sig velted?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 16,
      "text": "Det giorde han, den Helligaand, som bringer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 16,
      "text": "paa lette Zephyrvinger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 16,
      "text": "de Fölelser, som har mit Hierte smeltet.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 16,
      "text": "Det giorde han, den uskyldsrene Due,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 16,
      "text": "som svæver over os paa Himlens Bue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 17,
      "text": "En grusom Skiebne kold sit Jerngitter",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 17,
      "text": "imellem tvende unge Hierter trænger,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 17,
      "text": "som Himlens Harmonier sammenslynger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 17,
      "text": "Kun sielden sig det drukne Öie hænger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 17,
      "text": "paa elskte Gienstand; ved den svage Cither",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 17,
      "text": "kun fiernt han mig sin höie Længsel synger.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 17,
      "text": "Idag Naturen slynger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 17,
      "text": "sin Rosenkrands hen paa vor mörke Bane.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 17,
      "text": "I Skovens Tempel skal jeg Ludvig skue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 17,
      "text": "ved Maanens Altarlue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 17,
      "text": "Det lærte Elskovs Aand mig tidlig ane.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 17,
      "text": "Naar Tumlens Glædeskrig sig hisset hæve",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 17,
      "text": "skal taust i Lunden tvende Hierter bæve.",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
