  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Kom hellig Aand O Herre Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "opfyld met din Naade oc miskund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Dine Christnes hierte hu oc sind/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "din brendendis kierlighed i dem optend/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "O Herre met din Naadis liuss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "der met bepryd vort hiertis huss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "hent dem tilsammen i Verden bo/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "aff alle tungemaal til en tro.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Haleluia/ Loffuer Herren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Du hellige Liuss oc Vissdoms port/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Lad oss opliusis met Liffsens ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Oc lær oss Gud ret at kiende alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Aff hiertens grund hannem Fader at kalde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "O Herre beskerme oss fra fremmede lære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "At wi ingen Mestere atspørge mere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "End Jesum Christ vor Frelsere kiere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "At vor Tro kunde til hannem allene være.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Haleluia/ Loffuer Herren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Du hellige Jld oc søde trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Hielp oss nu vdi all vor brøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Din villie altid effter at følge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Oc lad ingen modgang oss fra dig skillie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "O Herre met din Guddoms krafft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Styrcke oss vsle/ oc giff oss mact",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Gennem sorrig oc bedrøffuelse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "At komme til dig vor Frelsere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Haleluia/ Loffuer Herren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "O sandheds Kilde oc hiertens fryd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Met aandelig smycke vore hierte bepryd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "At wi i Haab oc christelig Tro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Met Gud oc vor Neste i kierlighed bo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "O hiertens Herre oc aandelige Liff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 3,
      "text": "Bestrid i oss all Syndsens kiff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 3,
      "text": "Skenck oss din gunst oc stat oss bi/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 3,
      "text": "At wi ey falde i den aandelige Kri.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 3,
      "text": "Haleluia/ Loffuer Herren.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "O Gud allene vor hiertens trøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "Afftoe i oss all Syndsens brøst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "Din Jld/ dit Vand/ dit sandheds Liuss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "Lad brende oc toe vort aandelig huss.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 4,
      "text": "O Herre Gud i euighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 4,
      "text": "Wi tacke din Barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 4,
      "text": "Beuar i oss det du haffuer giort/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 4,
      "text": "Met Aandelig krafft oc hellige Ord.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 4,
      "text": "Haleluia/ Loffuer Herren.",
      "part": false,
      "marginal_notes": []
    }
  ]
}