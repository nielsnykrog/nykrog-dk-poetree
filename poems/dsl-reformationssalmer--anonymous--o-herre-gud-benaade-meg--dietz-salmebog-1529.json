  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Herre Gud benaade meg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "For thÿn store barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Affslætt all mÿn wretwÿshed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Jeg kendis mÿn synd hun er meg leed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Tho tw meg wel aff ondskab mÿn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "oc giør meg reen aff all mÿn synd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Thÿ ieg kender mÿn ondskab nw",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "mÿn synd er altÿd ÿ mÿn hw.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "O Herre Gud mod teg allene/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "haffuer ieg syndet thet kendis ieg gierne:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Ont haffuer ieg giord ÿ thÿn aasiwn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "att thet er wist som tw haffuer sagd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "att alle teg skulle bede om miskund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "thÿ wor natur er fuld aff synd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Hwad hadde wÿ ellers naade behoff?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "tw winder thennom offuer som thette ey tro.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "See Herre ÿ synden vndfangen ieg er:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "mÿn moder meg ÿ synden fødde/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "sandhed hun gielder altÿd for teg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "thÿn lønlige raad tw meg theede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Tw haffuer wÿst meg hwordan ieg er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "fuld aff ont oc syndzens begiær/",
      "part": false,
      "marginal_notes": [
        "Roma. vij."
      ]
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "thet kunde ieg icke før forstaa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "før tw lodst meg thÿn wÿsdom faa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Bestenck meg sielluff o Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "med thÿn Jsop oc naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "tha bliffuer ieg reen oc bædre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "qwÿt fraa all syndzens waade:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "Thÿn kiære søns blod er then Jsop:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "ther hwider en snee giør siæl oc krop/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "Lad meg faa att høre thÿne glædelig ord/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "saa frøgdis the been som forsmaade wore før.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Thit ansigt o Herre wend fraa mÿn synd/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "slæt wd all mÿn wretwished",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "skaffe ÿ meg eet reent hierte igien/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "forny mit sind/ oc forskyd ey meg/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "Tag ey fraa meg then Helliaand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "giff meg glæde ÿ thÿn frelsermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "Med een sterck aand giør meg stadig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "hooss teg att bliffue ewindelig.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "The troløse wil ieg lære thÿn wey/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "hworlunde the skulle hanwm kende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 5,
      "text": "att the maa vndgaa then falske stey/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 5,
      "text": "oc seg nw om til teg wende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 5,
      "text": "Beskerm meg herre mÿn saligheds Gud/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "fraa blodige synder alle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "O Herre lad op mit hierte oc mund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "thÿn loff oc ære att tale.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "Hadde tw legomligt offer elst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 6,
      "text": "tha wilde ieg thet wel giøre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 6,
      "text": "Een ydmyg aand saa tager tw helst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 6,
      "text": "eet angerfult hierte monne tw høre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 6,
      "text": "Bethee thit folk thÿn wilie god/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "oc byg thÿn Christen kircke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "saa skaltw retferdigheds offer faa/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "The skulle teg Christelig dyrcke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 7,
      "text": "Aere wære teg Gud ÿ ewighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 7,
      "text": "for thÿn miskund oc naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 7,
      "text": "wÿ tacke thÿn barmhiertighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 7,
      "text": "att tw wilt oss styre oc raade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 7,
      "text": "Ther till thÿn søn wor frelsermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 7,
      "text": "skall giffuis then samme ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 7,
      "text": "aff fattig oc rÿg ÿ alle land/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "Then Helliaand bør thennom lÿg wære.",
      "part": false,
      "marginal_notes": []
    }
  ]
}