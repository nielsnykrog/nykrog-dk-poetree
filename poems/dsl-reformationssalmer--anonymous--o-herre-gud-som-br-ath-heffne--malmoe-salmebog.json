  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Herre Gud som bør ath heffne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "O Gud som bør at heffne lad dig nu see",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Opstat o herre som dømer all iorden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "betale de hoffuerdige effter deris gerninger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "O herre huor lenge skulle de vgudelige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "huor lenge skulle de vngudelige saa hoffmode dem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Hui skulle de saa bryde ont aff sig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "oc tale saa fortredelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "Hui skulle de saa braske/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "som synde oc gøre ilde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 5,
      "text": "O herre dit folk fortrenge de/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "oc din arff fortrøcke de",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 6,
      "text": "De myrde viduer oc vdlendige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "och ihiel sla de faderløse",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 7,
      "text": "De sige ath Gud seer det icke/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 7,
      "text": "och ath Jacobss Gud achter det icke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 8,
      "text": "Ach griber forstand i gecke blant folket/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 8,
      "text": "och i daarer naar ville i worde kloge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 9,
      "text": "Skulde han icke høre som skabte alle øren?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 9,
      "text": "skulde han icke see/ som giorde alle øgen?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 10,
      "text": "Skulde han icke straffe/ som kan plage Hedningne?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 10,
      "text": "oc som lærer alle menniske det som de wide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 11,
      "text": "Ja Gud kender vel menniskens tancker/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 11,
      "text": "ath de ere forgengelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 12,
      "text": "O Gud salig er den mand som du reffser/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 12,
      "text": "oc lærer din low oc vilge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 13,
      "text": "Ath han kan være tolmodig i de onde dage/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 13,
      "text": "ind til graffuen bliffuer beret for de vgudelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 14,
      "text": "Thi herren vil icke forskiwde sit folk",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 14,
      "text": "oc ey sin arff oc eyedom",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 15,
      "text": "Thi retferdighed kommer vel igen til rette/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 15,
      "text": "oc den effterfølge alle de som ere aff hiertet retskabne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 16,
      "text": "Huo vil trede til mig emod de wdediske?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 16,
      "text": "huo vil staa hoss dem som gøre ilde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 17,
      "text": "Vden Gud waare selff min hielpere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 17,
      "text": "da waare min siel fuld ner bleffuen i stille",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 18,
      "text": "Der som ieg sagde min fod glider/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 18,
      "text": "Herre da styrckede mig din fromhed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 19,
      "text": "Naar ieg haffuer megen induertis bekømrelse/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 19,
      "text": "da huiler min siel sig vid din fortrøstning",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 20,
      "text": "Thi huad skulde det skalkachtige parti haffue met dig at skaffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 20,
      "text": "som haffuer for sed at fare met offuer wold",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 21,
      "text": "De fordriste dem megit mod den retferdige mandz siel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 21,
      "text": "oc fordøme det vskyldige blod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 22,
      "text": "Men Herren er mig til en beskermelse/ oc min Gud til en klippe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 22,
      "text": "der ieg maa haffue all min tilfluct til",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 23,
      "text": "Han skal betale dem for deris ondskaff oc synder han skal forderffue dem snarlige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 23,
      "text": "Ja vor herre och Gud han skal visselige forderffue dem alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 24,
      "text": "Gud fader Søn och den Helligand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 24,
      "text": "ske priss oc ære i allen stund",
      "part": false,
      "marginal_notes": []
    }
  ]
}