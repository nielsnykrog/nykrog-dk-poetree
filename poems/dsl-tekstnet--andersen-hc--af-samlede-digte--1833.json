  },
  "body": [
    {
      "id": 0,
      "stanza_id": 13,
      "text": "Hvad kommer Du fra Kirken her?",
      "part": false,
      "marginal_notes": [
        "Speaker: MODEREN"
      ]
    },
    {
      "id": 1,
      "stanza_id": 13,
      "text": "Vil Du ei see paa Stadsen her?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 13,
      "text": "I Dag staaer liden Grethe Brud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 13,
      "text": "Men Du er bleg! Du gode Gud!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 13,
      "text": "De seer jo ganske saadan ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 13,
      "text": "Som da – o Gud, jeg græde maa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 13,
      "text": "Som Lille Du i Græsset laae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 13,
      "text": "Et giftigt Dyr stak der din Fod;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 13,
      "text": "Døds-Smerten i dit Ansigt stod;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 13,
      "text": "Ak, dobbelt den jeg med Dig led.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 13,
      "text": "Din Fod jeg grov i Jorden ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 13,
      "text": "Og Jorden suged’ Giften ud;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 13,
      "text": "Saa har han gjort den gode Gud!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 14,
      "text": "Ja, Moder, Jorden hjælper der.",
      "part": false,
      "marginal_notes": [
        "Speaker: SØNNEN"
      ]
    },
    {
      "id": 14,
      "stanza_id": 14,
      "text": "I Hjertet er nu Giften her;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 14,
      "text": "Jeg føler den – forbarm Dig Gud!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 14,
      "text": "Din Jord vil suge Giften ud.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 14,
      "text": "O, grav det syge Hjerte ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 14,
      "text": "Det hjælper jo, saa faaer jeg Fred!",
      "part": false,
      "marginal_notes": []
    }
  ],
  "dramatic_poem": true
}
