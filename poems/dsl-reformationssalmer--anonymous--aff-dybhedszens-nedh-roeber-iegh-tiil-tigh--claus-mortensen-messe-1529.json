  "source": {
    "id": null,
    "title": "Thet cristelighe mesẞeembedhe",
    "year_published": 1529,
    "publisher": "Claus Mortensen Tøndebinder",
    "printer": "Oluf Ulriksen",
    "place": "Malmø",
    "corpus": "Danske Reformationssalmer (Dansk Sprog- og Litteraturselskab)",
    "url": "https://salmer.dsl.dk/claus-mortensen-messe-1529/4"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Aff dybhedszens nøedh roeber iegh tiil tigh/",
      "part": false,
      "marginal_notes": [
        "Psal.cxxix"
      ]
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "herre gudh wil thu migh høere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Thin naadszens øreen wænth thw tiil migh/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "myn røest iegh nw framfører",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Giffuer thw paa wor gierningh acth/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "ath hæffne synden meth thin magth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "O herre hwo kandh thet taallee",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Hoess tigh allene giælder naadhe och gwnst/",
      "part": false,
      "marginal_notes": [
        "Roma. viii."
      ]
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "til synden ath forladhe",
      "part": false,
      "marginal_notes": [
        "Ephe. ii"
      ]
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Naar wy tig noeghen tidth haffue myst/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "wy viddhe oss ey ath raaedhe/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "For tigh ingen sigh berøemme kand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "thy maa tig frøecthe alle mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "och trøesthe thennom paa thin naadhe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Til gudh staaer al myn haab och trøest/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "myn gierningh kand mig ey baadhe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "J thet thu ene haffwer mig forløesth/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "aff thin wsigheligh naadhe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Thine ord the ere en dyrebar schat/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "som thw oss haffuer effter ladt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "thennom wille wy gierne høre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Sckulle thet wære fraa maarghen stundh/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "och intil affthens endhe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Tha schulle myt hierte ingelund/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "fortuile eller fraa tigh wændis",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "Saa bør ath wære rett Jsraels arth/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "ath haabe och thro aff hierthet snarth",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "Och naadhe aff hannum begiære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Toegh synden hoess oss er manghefwldh/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "hoess gud er meghet meer naadhe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 4,
      "text": "Ath hielpe oss er han vel huld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 4,
      "text": "aff nøedh och alskens woedhe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Handh er forwist then retthe tolck/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "som haffuer forløst allt israels folck",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "aff saarrigh och synder alle",
      "part": false,
      "marginal_notes": []
    }
  ]
}