  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Kalv, Du raver som Du er fuld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "tag Dig iagt, Du ej falder omkuld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Du burde nok have Faldhat paa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "og som et Barn i Gangvogn gaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Kalven, den var et lille Fæ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "den sagde ikke andet end Bæ!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Bort fra sin Moder den skulde gaa, -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "første Gang ud den i Verden saae;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Ænderne, Hønsene, Katten og Soen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "fulgte den Alle over til Loen;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Benene satte den lidt paa tvers. -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Det var da nok en rigtig Kommers.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
