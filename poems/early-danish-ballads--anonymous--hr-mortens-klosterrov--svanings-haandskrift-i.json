  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Ieg will ether enn wise quede,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "huem der wil | lÿde paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "altt huor den wnge Her Marten,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "troloffuit en skiøn jomffrue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": ":: mendj Roser oc dj lilier dj groer well. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": ":: men dj roser oc | lilier gro | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Her Mortenn feste jomffrue lizebet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "bode | dannis oc dÿdelig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "dett fortrødt hans wenner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "for hun wor icke rig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": ":: men dj Roser | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Dett spurde jomffruens frender,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "dett tidennde | gick saa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "denn wolde gudt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "handt | skall hinde aldrig faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": ":: men dj Roser. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": "Hans frender sende ham aff landen wdt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 3,
      "text": "offuer dj salte rÿnn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "dj gaffue den jomffrue | ÿ kloster,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "dett wor modt allis hindis sindt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "Dett wor Herre Marten,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": "handt kom dog | hiem till landt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 4,
      "text": "saa stercke war dj tidende, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 4,
      "text": "som hannom kom till handt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "Saa stercke war dj tidende,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "dj gick hannom | allernest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": "dj haffuer giffuit ÿ kloster,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 5,
      "text": "den | jomffrue, som handt hagde fest. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "Dett wor Herre Marthen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": "oc suøber handt sig | wdÿ skindt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "saa ganger handt wdÿ høÿe-lofft | ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": "for sinn kiere fader indt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "Hør ÿ dett min kiere fader,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 7,
      "text": "ÿ haffuer | mig giort den harm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 7,
      "text": "ÿ haffuer min | festermøe ÿ kloster giffuen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "hun war eÿ wden itt barn |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "I haffuer mig ethers ærinde bort-sendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 8,
      "text": "alt offuer den salte søø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 8,
      "text": "nu haffuer ÿ giffuit ÿ | kloster,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 8,
      "text": "min kiere festermøø, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 9,
      "text": "Hør du kiere sønne min,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 9,
      "text": "du skalt icke der-for | quide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 9,
      "text": "en fast rigere iomffrue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 9,
      "text": "den | will ieg dig giffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 9,
      "text": ":: men thi roser oc | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 10,
      "text": "Langt heller wille ieg min festermøø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 10,
      "text": "alt | ÿ hindis skarlagen-skiendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 10,
      "text": "end ieg wille Her | Sti ridders dather,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 10,
      "text": "mett alt det godz hun eÿer. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 11,
      "text": "Hør du dett min kiere søn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 11,
      "text": "du tenck nu | paa min radt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 11,
      "text": "saa liditt haffuer lizebet | røden guldt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 11,
      "text": "endt mindre grønne iordt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 12,
      "text": "Jeg skiøtter icke om hindis guldt oc iordt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 12,
      "text": "dett siger ieg ether for sandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 12,
      "text": "ieg haffuer | hinde giffuit min christelige troe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 12,
      "text": "ieg | holler dett om ieg kandt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 12,
      "text": ":: men dj Roser | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 13,
      "text": "Dett war wnge Her Morten,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 13,
      "text": "handt rader | mett broder sin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 13,
      "text": "huor skall ieg faa aff | kloster,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 13,
      "text": "oc kiere festermøe min, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 14,
      "text": "Dett war Herre Nielaus,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 14,
      "text": "handt indt att klosteritt treen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 14,
      "text": "dett war alle dj kloster-jomffruer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 14,
      "text": "dj stander ham op igen. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 15,
      "text": "Hel sider alle jomffruer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 15,
      "text": "ieg kierer for ether | min nødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 15,
      "text": "dett min broder Her Marten, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 15,
      "text": "handt ligger paa baarenn dødt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 16,
      "text": "Alle da sadt dj kloster-jomffruer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 16,
      "text": "dj gaff dett | liditt ÿ giem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 16,
      "text": "foruden jomffrue lizebet, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 16,
      "text": "hun kaste bode sax oc søm. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 17,
      "text": "Hør ÿ dett kloster-jomffruer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 17,
      "text": "ieg giffuer ether | gode gaffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 17,
      "text": "maa ieg Her Marten min broders lig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 17,
      "text": "wdÿ ethers kloster begraffue. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 18,
      "text": "Dett suarede jomffrue Lisebet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 18,
      "text": "hun war | saa wener en møe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 18,
      "text": "ÿ begraffuer hans lig | ÿ kloster-kircke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 18,
      "text": "hand er den ære wel werdt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 19,
      "text": "Saa saare gredt jomffrue Lizebet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 19,
      "text": "alt wnder sin skarlagen-skindt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 19,
      "text": "dett dj førde her | Martens lig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 19,
      "text": "ÿ kloster-kircken indt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 20,
      "text": "Meszen hun war sungen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 20,
      "text": "oc folckit foer | hiem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 20,
      "text": "dog lodt dj Her Martens lig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 20,
      "text": "stande ÿ kircken igen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 20,
      "text": ":: men dj Roser | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 21,
      "text": "Dett war jomffrue Lizebet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 21,
      "text": "tende op dj | woxe-liujs,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 21,
      "text": "altt for Her Martens lig-bore, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 21,
      "text": "saa setter hun alle dem. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 22,
      "text": "Hun sette sig huosz hans ligbaare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 22,
      "text": "hun | wredt sin hender aff nødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 22,
      "text": "dett sÿe wor-herre for kiert,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 22,
      "text": "ieg bleff icke nøgen dødt. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 23,
      "text": "Jeg bleff giffuen ÿ kloster,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 23,
      "text": "alt modt min | ia oc wilge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 23,
      "text": "dett giorde begis woris | frender,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 23,
      "text": "dj wille osz bode attskilie. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 24,
      "text": "I bleff wdaff landen sendt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 24,
      "text": "dett er min største quide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 24,
      "text": "ieg kunde ether icke føre finde, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 24,
      "text": "føre ieg fantt ethers lig, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 25,
      "text": "Saa saare daa gredt den jomffrue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 25,
      "text": "oc hender | hun slog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 25,
      "text": "paa baaren laa den Ridder, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 25,
      "text": "saa hiertelig handt laae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 25,
      "text": ":: men dj | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 26,
      "text": "Opstodt Herre Marthen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 26,
      "text": "handt gadt icke lengre høre den harm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 26,
      "text": "handt lagde aff sin | lig-kleder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 26,
      "text": "tog jomffruen ÿ sin arm, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 26,
      "text": ":: men dj Roser oc dj lilier dj groer well. | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 27,
      "text": "Hør ÿ dett min kiere festermøe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 27,
      "text": "j lader bort-fare | ethers harm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 27,
      "text": "der er ethers festermandt, |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 27,
      "text": "der ÿ haffuer ÿ ethers arm. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 28,
      "text": "Hestene staar ÿ pilegaardt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 28,
      "text": "oc dj war alle | sorte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 28,
      "text": "Suennene dj er jerne-kledt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 28,
      "text": "som ether | skall følge bortt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 28,
      "text": ":: men dj Roser oc dj | ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 29,
      "text": "Dett war Herre Marthen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 29,
      "text": "slo offuer hinde | skarlagen smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 29,
      "text": "saa fuldes dj bade saa listelig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 29,
      "text": "altt offuer den kloster-gaardt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 30,
      "text": "Alle daa sade dj kloster-jomffruer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 30,
      "text": "dj leste | ÿ deris bog,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 30,
      "text": "dj tenckte dett wor gudtz engell,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 30,
      "text": "ther jomffrue Lizebeth tog. |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 31,
      "text": "Alle da sadt dj kloster-jomffruer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 31,
      "text": "oc tenckte | huer widt sig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 31,
      "text": "giffue dett gudt-fader ÿ | himmerig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 31,
      "text": "handt wille saa hente mig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 31,
      "text": ":: men | dj Roser oc dj lilier dj groer well. | ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}