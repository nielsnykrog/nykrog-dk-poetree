  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Solen Finns",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1936,
    "url": "https://tekstnet.dk/books/munch-petersen-g_solen-finns/064/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "titta på mitt bröst -!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "det är ungdomens bröst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "svällande av hårdhet -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "hoppet är underbart hårt som bara fan -,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "mitt blod är ett enda tveäggat hot",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "mot alla fiskar, som har buken uppåt -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "dödens bad är svalt efter alla rus -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "en hunger, som min, känner bara sig själv -,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "en hunger, som min, har tagit av sig varje känsla",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "för att kunna simma fritt -,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "hoppet är underbart hårt och tungt och svart",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "att ta i med hatets unga, berusade nävar -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "mitt bröst har ett skratt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "så hårt, att havet vänder sig -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "den enda vägen är mitt bröst -",
      "part": false,
      "marginal_notes": []
    }
  ]
}
