  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Haleluia det bør oss altid siunge.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Herren loffue oc prise aff hiertens grunde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Thi hans miskund haffuer vore synder alle vdslet/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "all kierlighed oc gaat haffuer hand oss beteed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Alt det som Liff haffuer det skal Gud loffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "For hans megne miskund oc store naade:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Hand haffuer oss giffuit venskab/ styrcke/ liff oc krafft/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Hand haffuer fordærffuit Synd død oc all Dieffuelens mact.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Gud haffuer dem som tro paa hannem iet naade/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Vil dem hielpe oc trøste i all vaade:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Himmerigis Rige vil hand dem alle giffue/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Det holder hand vist/ thi hand kand icke liuffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "O Gud Fader/ dig være loff oc ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Met din Søn Jesu Christ vor Frelser kiere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Disligest den hellig Aand aff oss allesammen/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "Wi tacke dig nu oc euindelig/ Amen.",
      "part": false,
      "marginal_notes": []
    }
  ]
}