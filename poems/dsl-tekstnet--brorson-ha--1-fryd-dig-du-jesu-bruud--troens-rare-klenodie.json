{
  "id": null,
  "title": "1. Fryd dig! du JEsu bruud",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
    "wiki": "Q348003"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": "Troens Rare Klenodie",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1739,
    "url": "https://tekstnet.dk/books/brorson-ha_troens-rare-klenodie/003/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Fryd dig! du JEsu bruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Her er et himmel-bud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Som tydelig skal sige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Fra GUd i himmerige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Dig skal hand stærk forkynde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Du har vor HErres ynde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Fryd dig! du JEsu bruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Hør budet nøye ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Hand siger: vær fornøyet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "GUd har dig høyt ophøyet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "GUds Søn dig selv vil tage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Til hustrue, bruud og mage.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 2,
      "text": "Fryd dig! du JEsu bruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 2,
      "text": "Saa stor en HErre GUd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 2,
      "text": "Saa vældig i sit rige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 2,
      "text": "Saa herlig uden lige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Og du, en fattig qvinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Skal saadan brudgom finde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 3,
      "text": "Fryd dig! du JEsu bruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 3,
      "text": "Nu seer det ikke ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 3,
      "text": "Som før i Edens have,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 3,
      "text": "Der alting gik af lave,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 3,
      "text": "Der satan var din lige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 3,
      "text": "Og helvede dit rige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 4,
      "text": "Fryd dig! du JEsu bruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 4,
      "text": "Hvor er den regn og sluud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 4,
      "text": "Af vredens grumme torden?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 4,
      "text": "Det klarer op paa jorden;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 4,
      "text": "Thi solen af det høye",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 4,
      "text": "Dig vinker med sit øye.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 5,
      "text": "Fryd dig! du JEsu bruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 5,
      "text": "Som seer saa bange ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 5,
      "text": "Af sorg for synden trænges,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 5,
      "text": "Og efter naaden længes,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 5,
      "text": "Du! du est just den datter,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 5,
      "text": "Som GUd saa herlig skatter.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 6,
      "text": "Fryd dig! du JEsu bruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 6,
      "text": "Det haver du forud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 6,
      "text": "At JEsus og hans Fader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 6,
      "text": "Sig selv tilbyde lader,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 6,
      "text": "Og Aandens fæstegaver",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 6,
      "text": "Du til forsikring haver.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 7,
      "text": "Fryd dig! du JEsu bruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 7,
      "text": "Er det din brudgoms bud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 7,
      "text": "Da tørst du dig ey klage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 7,
      "text": "At du mod ney skal tage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 7,
      "text": "GUd selv sig jo frembyder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 7,
      "text": "Trods den, der det fortryder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 8,
      "text": "Fryd dig! du JEsu bruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 8,
      "text": "Men satan spyt og spruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 8,
      "text": "Saa længe dig behager,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 8,
      "text": "Om disse brude-sager",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 8,
      "text": "Imod dit ønske stride,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 8,
      "text": "Du faaer det dog at lide.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 9,
      "text": "Fryd dig! du JEsu bruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 9,
      "text": "Af trængsels hytte ud!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 9,
      "text": "Er det nu tiid at klage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 9,
      "text": "I slige bryllups-dage?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 9,
      "text": "Tænk ey paa verdens jammer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 9,
      "text": "Men paa dit brude-kammer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 10,
      "text": "Fryd dig! du JEsu bruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 10,
      "text": "Det er den skarpest luud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 10,
      "text": "I satans glubske øye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 10,
      "text": "Naar du dig ret vil bøye",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 10,
      "text": "Til JEsu milde hierte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 10,
      "text": "At glemme al din smerte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 11,
      "text": "Fryd dig! du JEsu bruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 11,
      "text": "Mod satans lod og kruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 11,
      "text": "Hans glavind, skiold og pile,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 11,
      "text": "Du kandst ad alting smile,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 11,
      "text": "Saa er hand overvunden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 11,
      "text": "Thi JEsus har ham bunden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 12,
      "text": "Fryd dig! du JEsu bruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 12,
      "text": "Naar der er skrald og skud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 12,
      "text": "Paa Sinai at høre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 12,
      "text": "Det kand dig ikke røre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 12,
      "text": "Den dig til bruud udvaldte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 12,
      "text": "Hand al din gield betalte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 13,
      "text": "Fryd dig! du JEsu bruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 13,
      "text": "Og siig, at lovens bud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 13,
      "text": "Slet intet har at sige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 13,
      "text": "Mod JEsu naades rige:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 13,
      "text": "Siig, at du est forlovet",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 13,
      "text": "Med lovens lov og hoved.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 14,
      "text": "Fryd dig! du JEsu bruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 14,
      "text": "Og gak fra verden ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 14,
      "text": "I verdens lyst at hvege,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 14,
      "text": "Med dukke-tøy at lege,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 14,
      "text": "Din stand det ey kand lide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 14,
      "text": "Set verden reent til side.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 15,
      "text": "Fryd dig! du JEsu bruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 15,
      "text": "Est du et fade-klud",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 15,
      "text": "I verdens spodske øye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 15,
      "text": "Din JEsus af det høye",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 15,
      "text": "Dig desto meer vil ynde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 15,
      "text": "Det kand jeg dig forkynde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 16,
      "text": "Fryd dig! du JEsu bruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 16,
      "text": "Og alle dem bebud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 16,
      "text": "Som naadens trøst begiere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 16,
      "text": "At her er nok, og mere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 16,
      "text": "End de kand alle raade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 16,
      "text": "Af naade, naade, naade.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 17,
      "text": "Fryd dig! du JEsu bruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 17,
      "text": "Naar det seer ilde ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 17,
      "text": "Jo meer du glæde savner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 17,
      "text": "Jo meer dig JEsus favner,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 17,
      "text": "Hver taar, du her udgyder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 17,
      "text": "Dig tusind kys betyder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 18,
      "text": "Fryd dig! du JEsu bruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 18,
      "text": "Naar du gaaer ind og ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 18,
      "text": "Og vil dig nogen spørge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 18,
      "text": "Hvorfor du ey vil sørge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 18,
      "text": "Saa siig, at du kun vanker",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 18,
      "text": "I idel bryllups-tanker.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 19,
      "text": "Fryd dig! du JEsu bruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 19,
      "text": "Saa fryder sig din GUd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 19,
      "text": "Naar du est vel til mode",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 19,
      "text": "Ved naadens store gode,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 19,
      "text": "Som sig en brudgom glæder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 19,
      "text": "Ved brudens milde sæder.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 20,
      "text": "Fryd dig! du JEsu bruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 20,
      "text": "GUds engler selv gaae ud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 20,
      "text": "At see den dydens kierne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 20,
      "text": "Som JEsus seer saa gierne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 20,
      "text": "Og ønsker dig til lykke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 20,
      "text": "Udi dit brude-smykke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 21,
      "text": "Fryd dig! du JEsu bruud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 21,
      "text": "Og smyk dig mod din GUd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 21,
      "text": "Din brudgom dig vil hente,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 21,
      "text": "Hver time kand du vente,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 21,
      "text": "At du faaer bud at træde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 21,
      "text": "Til himlens bryllups-glæde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 22,
      "text": "Fryd dig! du JEsu bruud!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 22,
      "text": "Og tak for dette bud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 22,
      "text": "At hver en blode-draabe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 22,
      "text": "Kand takke, synge, raabe:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 22,
      "text": "Hosanna, priis og ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 22,
      "text": "Min søde GUd skal være.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
