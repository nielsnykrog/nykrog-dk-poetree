{
  "id": null,
  "title": "Anden Anhang til Christian V's første Ledings-Tog",
  "year_created": 1677,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Thomas Kingo",
    "country": null,
    "wiki": "Q348827"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1677,
    "url": "https://tekstnet.dk/books/kingo-t_anden-anhang-til-christian-v-s-foerste-ledings-tog/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Huor glad og frydefuld oprandt dend Morgen-røde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Da Høste-maaned fik sin Kurv med Sommer-Grøde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Indsamled, om endskiønt det regnede og drøb,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "At undertjden mand bag Axe-traven krøb.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "En Høst, en deylig Høst vor Norden dog formaatte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Der Døgne Løbne vaar to gange tj og otte, den 28. Aug.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "En Høst, en Konge-Høst, vor Dronnings Livis Frukt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Vaar lige dend Tijd moed og af sin Stamme plukt! ||",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "En Høst, en Seyer-Høst, en Høst af jdel Ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Som og i Ævighed skal Ærens Minde bære:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Thi samme Dag oc Tjd Princessen spüred frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Og tog i Norden fat paa Arfve-spiir og Hiem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Da kæmmede sin Mank den Ædle Gylden-Løwe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Og blant de Norske Field ræt viiste frem sin Prøve,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Hand brølede og beed med Svenske Biørn og Ulv,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Og kappedis om hvo der skulde kysse Gulv.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 1,
      "text": "Gud veed hvordan det vaar! Men som vi nu kand vilde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 1,
      "text": "Da fanged Dronningen og Hand at sammen strüde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 1,
      "text": "Hun for sin Konge-Sæd, Hand for sin Kongis Naun,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 1,
      "text": "Og begge Deele faldt med Lyst i Kongens Faun!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 1,
      "text": "Hun fik sin Vugge fuld af ævigt Haab og Glæde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 1,
      "text": "Og Kongen saae med Lyst en Skiold-Møe frem at træde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 1,
      "text": "Hvis Fødsels Dag og Stund i Almanakken staar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 1,
      "text": "Med Kongens Ære oc med Fiendens Blood og Saar!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 2,
      "text": "Du Nordiske Monark, Du Dyd-Kompas og Kroone,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 2,
      "text": "Du Efterrætning for hver Mand der er paa Throone,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 2,
      "text": "Du Hierte-middel-punkt, som midt i Norden staar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 2,
      "text": "Til hvilken hver vor Livs og Lykkis Streeg hengaar! ||",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 2,
      "text": "Dend Høst ey kunde dog dit Konge-Sind fornøye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 2,
      "text": "Du derfor vilde flux i Fiskens Boolig pløye,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 2,
      "text": "Og prøve hvad for Fisk dit stoore Belte-Hav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 2,
      "text": "For Kongers viide Garn i Fiske-Maaned gav.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 2,
      "text": "Du lodst i Gylden Raa det slappe Seyl ophidse,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 2,
      "text": "Som svangred blev af Vind, og peeb udaf sin Tridse,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 2,
      "text": "Du dermed lige lood til Lante-Rügen staa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 2,
      "text": "Som efter Ynske i Din Vold og maatte gaa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 2,
      "text": "Den Svenske Königsmark sin Kongis Mark qvitered,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 2,
      "text": "Som vaar en tudlang laant, og dend til Dig levered,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 2,
      "text": "Af hvis Forfædre dend med Ære vundet blev,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 2,
      "text": "Da Første Waldemar dend Heden-Sverm fordrev.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 3,
      "text": "Mens, ræt som Du med Lyst i Marken Mester spiller,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 3,
      "text": "Og Fienden til sin Frygt.og Flugt med Ære driller,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 3,
      "text": "Da høris der med hast en Tjding udaf Søe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 3,
      "text": "At Dronningen er svag og nær paa Triin at døe!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 3,
      "text": "Hielp Gud! Jeg mægter ey at skrive hvor forandred",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 3,
      "text": "Dit Løwe-Hierte blev! hvor dine Tanker vandred",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 3,
      "text": "Med din saa viide Siæl! Men Hiertens Kierlighed",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 3,
      "text": "Dit ifrige Gemyt strax til Din Dronning vreed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 3,
      "text": "Du gik igien til seyls, sampt Prinds Georg! Jeg gruer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 3,
      "text": "Naar Jeg dend farlige Seylads i Sindet skuer!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 3,
      "text": "Min Haand dend rister saa jeg nep kand føre Pen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 3,
      "text": "Og Sindet færdigt er for Frygt at daane hen! ||",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 3,
      "text": "Det Skib som haver Naun udaf dend Salig Herre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 3,
      "text": "Din Fader Frederich, Det keysed Du at bære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 3,
      "text": "Dig i sin Fiæle-faufn, Det kiender og en hver,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 3,
      "text": "Hvor gierne Faderen sin Søn paa Armen bær.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 3,
      "text": "Men, Sæde-Maaned, O! hvad hafde Du i Sinde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 3,
      "text": "Hvad Anslag hafde Du lagd op med Storm og Vinde?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 3,
      "text": "Hvad Forbund hafde Du med grumme Belte-Vand?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 3,
      "text": "Hvi vaar ald Luften som en storme-blanded Strand?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 3,
      "text": "Her veltis Prinds Georg! og maa for Bølgen dukke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 3,
      "text": "Som for sin Fiende vel er ellers spotsk at bukke!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 3,
      "text": "Hver Bølge truer med en Død og Dødsens Frykt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 3,
      "text": "Hver Suse-Vind har Magt at giør' en viis Forrykt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 3,
      "text": "Her hveger Landsens Haab og Fyrste paa en Smakke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 3,
      "text": "Som maa i Storme-Vand og Dødsens Fare flakke!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 3,
      "text": "Van Osten blæser ud! ach! i det grumme Hav!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 3,
      "text": "Hans Siugdom vaar en Storm, og Vand hans Død og Grav!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 3,
      "text": "Du, Konge, midlertüd sactmodig maatte taale",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 3,
      "text": "Hvor Belt, Din Tiener-strøm, imod Dig torde vraale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 3,
      "text": "Hvor Havet reyste sig, och stood som i en Ild,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 3,
      "text": "Og hver en Bølge vaar trods-modig, vreed og viid!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 3,
      "text": "Dend regne-fulde Luft med grumme Skyer muded,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 3,
      "text": "Saa hart og hesselig Nord-veste-kulen tuded,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 3,
      "text": "Og førte Sky paa Sky, med slige Puste-stød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 3,
      "text": "At Dødsens grumme Magt paa hver en Bølge flød! ||",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 3,
      "text": "Det sterke Kabeltow, Dend beeged Hampe-Sene,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 3,
      "text": "Vaar fast i Anker-ring, som sine Jerne-Grene",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 3,
      "text": "Nedkasted ydmyg til dend Afgrunds fæle Bund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 3,
      "text": "Og mægted ey et Hæft at faa i nogen Grund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 3,
      "text": "To store Anker smak! og intet kunde holde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 3,
      "text": "Imod de skrydendis opblæste Vande-volde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 3,
      "text": "Det tredie kom ud! som med tvæ-haged Klov,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 3,
      "text": "I Dødsens dybe Grav for Liv og Kroone grov!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 3,
      "text": "Det fik omsider fat! Jeg troor det kunde finde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 3,
      "text": "At heele Danmarks Liv, Du Konge, vaar der inde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 3,
      "text": "I det Velt-uren Skib! GVDS Haand greeb fat der paa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 3,
      "text": "At hver Mands Lyst og Liv skuld' ey i Belt forgaa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 3,
      "text": "Tak! tak! aldmægtig GVD, som Kongen vilde spare,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 3,
      "text": "Du kiendte ene selv hvor uskatteerlig vare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 3,
      "text": "Der inden Borde vaar! Din egen salved Mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 3,
      "text": "Hvis bedre Verden ey hâr haft, ey hafve kand!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 3,
      "text": "Tak for vort Konge-Huus, som Du hver Dag benaader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 3,
      "text": "Med Seyer, Ære, Børn, og frelser udaf Vaader,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 3,
      "text": "Naar Vaader høyest er! Lad frem ad Rigets Gaun,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 3,
      "text": "Og Kongens Ære groo i JEsu søde Naun! ||",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 4,
      "text": "GUD holdt paa mig, og Jeg holdt Christian dend",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 4,
      "text": "Femte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 4,
      "text": "Der en fortuiled Storm i Øster-Søe ham klemte!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 4,
      "text": "Too Rigers Liv og Død paa too Jern-Hager laa!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 4,
      "text": "Jeg derfor ævig her skal til et Minde staa!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
