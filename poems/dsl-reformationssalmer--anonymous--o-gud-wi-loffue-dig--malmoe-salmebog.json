  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "O Gud wi loffue dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "wi bekende dig en herre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Dig en euig fader/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "priser den ganske verden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 2,
      "text": "det samme gøre alle Engle/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "hiemlene oc alle weldige Engle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 3,
      "text": "Din priss siunge Cherubin oc Seraphin",
      "part": false,
      "marginal_notes": [
        "Esaie ii"
      ]
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "met waffladeligt stemme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "Hellig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 4,
      "text": "Hellig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 4,
      "text": "Hellig est dw Herre Gud Sabaot",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 5,
      "text": "Hiemlene oc iorden ere opfylte met din maiestetis ære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 6,
      "text": "Den erlige forsamling dine Apostlers tall/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 6,
      "text": "dig loffue oc bekende en Herre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 7,
      "text": "Lige saa gør oc altid dit hellige tall dine Propheters",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 8,
      "text": "Den gantske skare dine hellige Martirers",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 8,
      "text": "dit hellige naffn loffue oc prise",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 9,
      "text": "Alle gudfrøctige och vdwalde loffue oc bekende dig i all werden",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 10,
      "text": "En wbegribelig maiestetis Fader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 11,
      "text": "Din sande ærefulde enbørne søn Jesum Christum",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 11,
      "text": "tro wi at være lige met dig i Guddommen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 12,
      "text": "Der til den Helligand sandelig at wære alles wore trøstermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 13,
      "text": "O Herre Christe dw est ærens Konning/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 14,
      "text": "Dw est din faders ewige søn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 15,
      "text": "Jomfruens liff wor dig icke verstyggeligt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 15,
      "text": "til ath anamme mandom oc forløse alle vdwalde menniske/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 16,
      "text": "Dw haffuer offuerwundet den bittre pine dødzens sting/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 16,
      "text": "oc oplad alle som tro paa dig himmerigis rige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 17,
      "text": "Der fore sider dw nw paa Gudz høgre hand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 17,
      "text": "i ewig Maiestetis ære met din fader/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 18,
      "text": "Oc wi tro ath dw her effter worder tilkomendis",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 18,
      "text": "en streng dommere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 19,
      "text": "Der fore o Herre wi formane dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 19,
      "text": "hielp dine tro tienere/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 19,
      "text": "som dw forløste met dit dyrebare blod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 20,
      "text": "Dine wenner gør delactige i den ewige ære/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 20,
      "text": "met dit hellige oc vdwalde folk/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 21,
      "text": "O herre frelss dit folk",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 21,
      "text": "och welsigne dem som ere din arff och eyedom/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 22,
      "text": "Regere oc lær dem/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 22,
      "text": "oc ophøye dem til euindelige tid/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 23,
      "text": "Vi benedide dig gud i ewighed/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 23,
      "text": "oc ære dig dag fra dag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 24,
      "text": "Oc loffue dit naffn euindelige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 24,
      "text": "nw oc altid euindelige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 25,
      "text": "O Herre werdis ath beware oss altid fra synden/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 26,
      "text": "Miskunde dig offuer oss o Herre/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 26,
      "text": "oc forbarme dig offuer oss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 27,
      "text": "O Herre din miskund bliffuer offuer oss/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 27,
      "text": "saa som wi oss po dig forlade",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 28,
      "text": "Til dig Herre staar alt wort haab/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 28,
      "text": "der fore lad oss icke bliffue til skendzel euindelige",
      "part": false,
      "marginal_notes": []
    }
  ]
}