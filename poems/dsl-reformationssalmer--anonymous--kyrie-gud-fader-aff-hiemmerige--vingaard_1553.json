  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Kyrie Gud Fader aff Hiemmerige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Du sende oss din Søn till Jorderige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "fordi du vilde vere oss miskundelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "⁕ Christe Gudz Søn aff Hiemmerige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "du lost dig føde til Jorderige/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "At wi motte vorde Gudz børn met dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "O Helligaand som vost i den gerning mestermand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "at Jomfru fødde for wden mand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Lad oss ey dø i Syndens baand/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Men fød Christum i oss o Helligaand.",
      "part": false,
      "marginal_notes": []
    }
  ]
}