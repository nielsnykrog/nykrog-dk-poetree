  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "HVor fore stormede de hedninge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "oc folkene berammede vnøttige raad? Jørderigis konger haffuer sig bestercked/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "oc ere forsamlede mod Herren oc hans smurde mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Lad oss sønder bryde deris bond/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "och bortkaste deris aag fra oss",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 2,
      "text": "Den som haffuer sin bolig vdi hiemmelen skal dem bespotte/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 2,
      "text": "oc Herren skal dem haanlige faariage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 3,
      "text": "Da skall han dem wredelige tiltale oc dem i sin grumhed forskrecke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 4,
      "text": "Men ieg haffuer skickit min konge offuer mit hellige bierg Sion",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 5,
      "text": "Jeg skal predicke Gudz bud ath herren sagde til mig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 5,
      "text": "Du est min Søn J dag fødde ieg dig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 6,
      "text": "Eske aff mig och ieg skall giffue dig de hedninge til en arff/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 6,
      "text": "oc almwen till en eyedom",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 7,
      "text": "Dem skalt du sønder bryde met en iern spire/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 7,
      "text": "oc som ith leerkar sønder sla",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 8,
      "text": "Saa skulle i konger nu være kloge/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 8,
      "text": "oc lader eder vnderuise som ere iørderigis dommere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 9,
      "text": "Tiener Herren vdi frøct/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 9,
      "text": "och gleder eder i hannem met en skelffuende fare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 10,
      "text": "Køsser sønnen ath han icke bliffuer vred/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 10,
      "text": "oc ath i ey veyen tabe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 11,
      "text": "Naar hans grumhed begynder ath brende/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 11,
      "text": "da lider dem vel som sette deris loffue till hannem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 12,
      "text": "Ere være Gud fader oc Gud Søn/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 12,
      "text": "oc saa Gud den Helligand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 13,
      "text": "Som værit haffuer aff begyndelsen nu oc altid er/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 13,
      "text": "oc bliffuer euindelige",
      "part": false,
      "marginal_notes": []
    }
  ]
}