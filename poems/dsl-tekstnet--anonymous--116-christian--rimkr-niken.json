  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Før en ieg Danmarks krone bar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "som gud willæ lade meg sømme,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "saa hade ieg wold oc mectig war",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "Oldhenboricg oc Delmenhorst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "saa pleyer man them ath kallæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Thi staa the land tijl forworst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "och hielp oc trøst meth allæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "twsende iiij hundrede oc fyretywe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "och syw ther offuer, som scriffuet staar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "meth sanden kan ieg thet drwe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "Ieg spurde at thet saa scriffuet stod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "en nogher en konge elder første god",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "som styre wil land meth ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "Thi tog ieg meg thet i syndh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "ath ieg willæ aldrig begære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "noghermandz lijff elder ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "Doch ieg wille offte oc ydelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "motte thet giord meth rætte,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "tha wille ieg helder miskundelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 6,
      "text": "Swenskæ toge thet tijl had saa brath",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "ath danskæ the meg wdwolde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 6,
      "text": "Karl Knutzen giorde the tijl konge saa rath",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 6,
      "text": "och Swerigæ hannum befalde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "som the oc theris forældhernæ giorde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 7,
      "text": "tha the sambunde thesse rigæ try",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 7,
      "text": "och them tijl sammen besworde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 8,
      "text": "Saa fore the bort tijl Wisby ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 8,
      "text": "Fuldsaare mwnne hannum tha blegne om kind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 8,
      "text": "hannum thet ey wel behawde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 9,
      "text": "Han screff meg tijl wthi then nød",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 9,
      "text": "at ieg skullæ hannum wnsætthe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 9,
      "text": "oc hialp hannum aff then trætte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 10,
      "text": "Ieg lade myne skijb for Wisby ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 10,
      "text": "meth danskæ men the trøste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 10,
      "text": "Fuldsaare mwnne swenskæ tha blegne om kind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 11,
      "text": "Ieg stak en ild oppaa then by,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 11,
      "text": "ieg sparde ey bwsse, ey pile.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 11,
      "text": "Saa mangheth hiartæ gaff ther kny,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 11,
      "text": "ther wor fuldlidhen hwile.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 12,
      "text": "the iætte meg got meth twnghen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 12,
      "text": "Men ieg fornam siden fram i bædher",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 12,
      "text": "at thet wor sompt aff lwnghen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 13,
      "text": "Siden giorde ieg brøllop i Køpmanhaffn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 13,
      "text": "Dorothea drotning, Danmark tijl gaffn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 13,
      "text": "som ther wor for meg inne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 14,
      "text": "Twsende och fyrehundrede aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 14,
      "text": "thet kan ieg fulwel drwe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 14,
      "text": "ieg wil thet ickæ liwe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 15,
      "text": "Saa krijde ieg aa Swerige paa otte aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 15,
      "text": "før swenskæ wille meg ind tage,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 15,
      "text": "indtijl konning Karl wddreffuen waar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 16,
      "text": "Siden bleff iegh tha krwnt wthi Trunthem",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 16,
      "text": "tijl Norgis konning ath wære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 16,
      "text": "Saa halp meg Gud i macthen frem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 16,
      "text": "thi bør meg hannum ath ære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 17,
      "text": "effther ath Cristus wor boren,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 17,
      "text": "meg draghes thet en tijl mynne wel",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 17,
      "text": "sancti Olaui dag thet wor en.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 18,
      "text": "Siden ther effther paa fæmthe aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 18,
      "text": "her Hans, myn søn, tha fødder waar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 18,
      "text": "hwo thet wil wide tijl wisse.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 19,
      "text": "Annet aaret ieg intijl Øland foer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 19,
      "text": "Borholmen ieg ther belawde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 19,
      "text": "som meg tha wel behawde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 20,
      "text": "Ieg stormede tijl thet slot saa fast,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 20,
      "text": "ther reddis bode men oc qwinne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 20,
      "text": "meth bwsser och saa meth blidekast",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 21,
      "text": "Saa giorde ieg tha tijl skibs en hær",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 21,
      "text": "tijl Wiborig wthi Fynlande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 21,
      "text": "Thet gik ther hwercken bæder elder wær:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 21,
      "text": "thet slot the reent op brende.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 22,
      "text": "tijl konning oc herre at haffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 22,
      "text": "Och siden i Opsale adher igen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 22,
      "text": "the giorde meg gunst oc gaffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 23,
      "text": "twsende fyrehundrede aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 23,
      "text": "effter ath Gutz søn fødder waar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 23,
      "text": "meth sandhen kan ieg thet drwe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 24,
      "text": "Thet samme aar fødde megh drotning myn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 24,
      "text": "en dotther, hwn hed Margrete.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 24,
      "text": "Gud henne then gaffue wethe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 25,
      "text": "Henne gaff ieg konning i Skotland ind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 25,
      "text": "tijl drotning oc tijl syn kære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 25,
      "text": "meth danskæ herris samtycke och synd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 26,
      "text": "Paa thet ieg willæ at dansker mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 26,
      "text": "skullæ bliffue thes bædre i lwne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 26,
      "text": "Tha køffthe ieg Stormer oc Holtzeland",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 26,
      "text": "alt ind tijl Danmarks krwne.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 27,
      "text": "the henthe konning Karl tijl lande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 27,
      "text": "The iætte the wille tha meth hannum staa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 27,
      "text": "och ginghe hannum saa tijl hande.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 28,
      "text": "Siden foer ieg offthe i Swerig ind,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 28,
      "text": "Men mere paa dawtinghen lade ieg wind",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 28,
      "text": "for almwens fred och lisæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 29,
      "text": "Ther offuer tog ieg stor skade oc grwm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 29,
      "text": "ey kunne ieg meg saa ware.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 29,
      "text": "paa meg sloæ the wel saare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 30,
      "text": "Ieg slo oc fast paa them ighen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 30,
      "text": "ieg kunne ey annet elder motte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 30,
      "text": "The nøddhe meg tijl at gøre them men,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 31,
      "text": "En tijd fal thet seg saa i law",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 31,
      "text": "som wij paa Herlyong fundis,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 31,
      "text": "at ieg sloo them ther aff eth slaw;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 31,
      "text": "the deylig ther offuer wundis.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 32,
      "text": "ieg them tijl Danmark førde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 32,
      "text": "I Købmanhaffn kirke hengde ieg them;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 32,
      "text": "ther glæddis hwer dansk thet hørde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 33,
      "text": "Siden foer ieg atther tijl Swerigæ aa ny",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 33,
      "text": "Tijl Brunckeberge for Stocholm by",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 33,
      "text": "lod ieg mit folk op ganghe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 34,
      "text": "Ther laa ieg lenghe oc bidde got swor",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 34,
      "text": "som swenskæ meg dawlige iættæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 34,
      "text": "meg ath forrodhe meth slættæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 35,
      "text": "Ieg tencthe the skullæ tha haffue giort fult",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 35,
      "text": "theris høwelig dyt oc ære",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 35,
      "text": "och taghet meg ind som the hade hylt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 36,
      "text": "Tha giorde the paa meg stort aaredh;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 36,
      "text": "ther styrttæ saa mange døde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 36,
      "text": "aff mith folk och aff theres medh;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 36,
      "text": "ther offuer mottæ hiarthe bløde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 37,
      "text": "for Danmarks krones beste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 37,
      "text": "forthi ieg lod meg tijl wspaard",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 37,
      "text": "som myne giorde alle fleste.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 38,
      "text": "Mange bleffue tryltte oc lobe i sænck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 38,
      "text": "meth diæwels konst wethe han them skenck,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 38,
      "text": "doctor Rytting han, them thet giorde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 39,
      "text": "Tha ieg saa syden fornam ther om",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 39,
      "text": "the skøtte ey ord elder ære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 39,
      "text": "theris eyne lod ieg them wære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 40,
      "text": "Ther nest for ieg tha hædhen tijl Rom",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 40,
      "text": "myne syndher at bøde oc bædræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 40,
      "text": "The faffnede meg wel tha ieg tijd kom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 41,
      "text": "Først løsde han meg aff all myn synd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 41,
      "text": "Sixtus pawe then fiæræ,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 41,
      "text": "saa gaff han meg gunst meth bliden lynd;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 41,
      "text": "han giorde meg stoer hedher oc æræ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 42,
      "text": "blanth andre gunsther slige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 42,
      "text": "ath ieg maa lade holle eth studium",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 42,
      "text": "en stæd i Danmarks rigæ.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 43,
      "text": "Han gaff meg oc megeth skønt afflath",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 43,
      "text": "i myn capell i Roskild stath",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 43,
      "text": "aff synderlig nadis gaffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 44,
      "text": "Keyser Frederich, then høyburde mand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 44,
      "text": "giorde meg oc hedher oc ære:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 44,
      "text": "ewindelig tijl Danmark at wære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 45,
      "text": "Twsende och fyrehundrede aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 45,
      "text": "och fyre och halfierdesynne tywe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 45,
      "text": "i Romer stad hooss pawen ieg waar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 46,
      "text": "Ieg thet meth sendhen oc syæ kan",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 46,
      "text": "ath aar ther effther paa tredie",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 46,
      "text": "tha sende ieg bud tijl Mitzerland",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 46,
      "text": "her Hans, myn søn, en iomfrw ath bede.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 47,
      "text": "ionfrw Cristina mwnne man henne kalle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 47,
      "text": "Aff slecth ære the bode mæctigh oc wærd;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 47,
      "text": "deylig ær hwn meth alle.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 48,
      "text": "Theris brulløp giorde ieg paa Kiøbmanhaffn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 48,
      "text": "allæ myne rigæ tijll lycke oc gaffn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 48,
      "text": "Gud ladhet saa bliffue oc wære.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 49,
      "text": "Twsende oc firæhundrede aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 49,
      "text": "otte och halfierdæsynne tywe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 49,
      "text": "meth sendhen kan ieg thet drwe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 50,
      "text": "Saa bleff ieg tha paa Kiøbmanhaffn dødh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 50,
      "text": "i Roskild lawdh i iordhe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 50,
      "text": "Ieg tacker Gud som i all myn nødh",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 51,
      "text": "Thet twsende oc firæhundrede aar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 51,
      "text": "och eth oc fyresynne tywe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 51,
      "text": "effther ath Gutz søn fødher waar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 51,
      "text": "meth sendhen kan ieg thet drwe.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 52,
      "text": "ieg wil thet ickæ lywe,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 52,
      "text": "ther ieg haffde standet for Danmark tijl swaar",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 169,
      "stanza_id": 52,
      "text": "i trettæn aar och tywe.",
      "part": false,
      "marginal_notes": []
    }
  ]
}