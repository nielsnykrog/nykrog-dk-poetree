  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Saa standsed' og der den Blodets Strøm,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Som før var vant at rinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Saa dirred ogsaa de Nerver til Ro,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Og Sandserne alle blev blinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Og Hjertet og Hjernen virker ej mer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Du er kun Støv nu og livløst Ler.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Lad længes, lad grædes med Evighedssavn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Der er kun en Stofhob, en Daad og et Navn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "For alle gode Tanker de kan slet ikke dø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Før endnu bedre Tanker er spired af deres Frø.",
      "part": false,
      "marginal_notes": []
    }
  ]
}
