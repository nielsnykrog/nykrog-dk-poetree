  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Konggens søn aff Enggelland",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "hanom skeener guld offuer huiden hand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Hanom skeener guld offuer sadelbuo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": ":: Men børren bleser denom østen ind for Danmarck. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Hanom skener guld offuer sadelbuo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "for hand haffuer tro-loffuet saa skøn en iumfru.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "Den kongens søn lader verke en knar.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Den kongens sønn lader werrcke en knaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "sliggen kaam aldrig paa wandenn førre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Den war forgylltt imellom begge buore.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 3,
      "text": "Hun war forgylltte imellom begge buorr,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 3,
      "text": "wor herris naffuenn stuod skreffuett der for.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Den war forgyltt imellom bege staffuen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 4,
      "text": "Den war forgylltt imellom begge staffuen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 4,
      "text": "der stuod paa schreffuet wor herris naffuen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 4,
      "text": "Och thett stuod skreffuet y fremer-staffuen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 5,
      "text": "Och thett stuod skreffuett y fremer-staffuen:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 5,
      "text": "thend kongen sønn thog synn iumfru y arum.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 5,
      "text": "For vdenn thaa stuod thy løffuer smaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 6,
      "text": "For vdenn tha stuod thi løffuer smaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 6,
      "text": "huer anden worr guld, huer anden wor blaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 6,
      "text": "Vdy thend skib ther stuod en mast.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 7,
      "text": "Vdy thend skibb ther stuod en mast,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 7,
      "text": "thend hadde well M nobell kaast.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 7,
      "text": "Och offuer den mast der stuod en flyø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 8,
      "text": "Och offuer den mast der stuod en flyø,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 8,
      "text": "sligen kaam alldrig y wester-syø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 8,
      "text": "Hans acker wor aff røde guld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 9,
      "text": "Hans aacker wor alle aff røde guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 9,
      "text": "hansz seegell wor alle aff aager-vld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 9,
      "text": "For huerind thuo, som der war inde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 10,
      "text": "For huerinde tuoff, som der war inde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 10,
      "text": "thy war giortt aff sylcke-thuynde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 10,
      "text": "Huerinde thuoff och huerinde bondde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 11,
      "text": "Huerinde thuoff och huerinde bonde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 11,
      "text": "thy war slaffuen med iumfruens huide hand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 11,
      "text": "Thend konge hand tog syn søn at lere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 12,
      "text": "Tthend konge hand tuog syn søn att lerre:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 12,
      "text": "\"Myn kerre sønn thu thenck paa erre!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 12,
      "text": "Du thenck paa heder, du thenck paa erre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 13,
      "text": "Du thenck paa heder, du thenck paa erre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 13,
      "text": "du lade icke pening dyn harre werre!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 13,
      "text": "Thu spaar icke søleff eller røde guld.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 14,
      "text": "Thuo spaar icke søleff eller røde guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 14,
      "text": "thu gyff den suend, som deg well were huld!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 14,
      "text": "Den konge hand fulde syn sønn till strand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 15,
      "text": "Den konge hand fulde syn sønn till strand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 15,
      "text": "rider och suene skød hanom fraa land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 15,
      "text": "Den kongens søn thuog aff syn hatt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 16,
      "text": "Tthend kongen sønn tuog aff syn hatt:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 16,
      "text": "\"Faader och muoder, haffue M guod natt!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 16,
      "text": "Buod faader och muoder och høffsken kuinde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 17,
      "text": "Faader och muoder och høffsken quinde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 17,
      "text": "Gud lad oss alle med gledde fyndis!\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 17,
      "text": "Thy waar icke komitt vden lyditt fra land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 18,
      "text": "Tthi war icke komitt vden lyditt fraa land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 18,
      "text": "da bleeste der wieer aff wreden strand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 18,
      "text": "Ther bleste wieer aff mørken sky.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 19,
      "text": "Tther bleeste wier aff mørckenn sky,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 19,
      "text": "thy wedste denom huerkind land eller ly.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 19,
      "text": "Och saa kaaste dy derris aacker vd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 20,
      "text": "Och saa kaaste dy dierris acker vd,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 20,
      "text": "som XXX wintter haffde lieeett vnder skrw.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 20,
      "text": "\"Myn danesuend, y werer well frw!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 21,
      "text": "Mynne danesuend, y werer well fruo!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 21,
      "text": "thett er saa fast aff sylckee giortt.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 21,
      "text": "Hand høbbttis, at thett war for-vden ald faare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 22,
      "text": "\"Ieg hobbis, thett er for-vden all faare.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 22,
      "text": "Den herre tuog paa en wise och quad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 22,
      "text": "Men thett skieede ind førr mydy-natt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 23,
      "text": "Men thett skiedde ind for myde-natt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 23,
      "text": "thett stercke thuoff war synder ragt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 23,
      "text": "Saa satte hand seg paa forgyldene skryn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 24,
      "text": "Saa satte hand seg paa for-gyldene skrinn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 24,
      "text": "med sorig-fuld haand vnder blegge kynd.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 24,
      "text": "Thett wor stuor ynck att sie der paa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 25,
      "text": "Tthett wor stuor ynck att sie der paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 25,
      "text": "thett skib sluos alle y stycker smaa.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 25,
      "text": "Thend herre hand kaam dog løffuend til land.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 26,
      "text": "Tthend herre hand kaam dog løffuend till land,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 26,
      "text": "hand ganger saa sørind paa huidenn saand.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 26,
      "text": "Thend herre hand gick och klaffuet seg sare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 27,
      "text": "Tthend herre hand gick och klaffuett seg saare:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 27,
      "text": "\"Ieg mintte, ieg haffde ingen vrett-ferdige waare.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 27,
      "text": "For-vden en liden ganger rød.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 28,
      "text": "For-vden en lydenn ganger rød,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 28,
      "text": "den tuog ieg fraa en faderløss møø.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 28,
      "text": "Men well thett Gud, ieg komer hiem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 29,
      "text": "Men well thett Gud, ieg komer hiem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 29,
      "text": "da skall ieg gyffue hinder thuo for ienn.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 29,
      "text": "Rett vdy thett same synde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 30,
      "text": "Rett vdj thett saame synde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 30,
      "text": "thaa kaam till land hans forgyldenne skrienn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 30,
      "text": "Ther kaam gangind en kocke-dreng.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 31,
      "text": "Der kaam gangendis en kocke-dreng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 31,
      "text": "hand giorde thend here saa stuorlig mien.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 31,
      "text": "Hand haffde med seg thi suene fem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 32,
      "text": "Hand haffde med seg thy suene ny,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 32,
      "text": "herr Eski Frost hand red med dy.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 32,
      "text": "Thend kongens sønn hanom rand thaar paa kind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 33,
      "text": "Tthend kongens sønn hanom rand thaar paa kiend:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 33,
      "text": "\"Chrest nade meg, ieg kaam for Bruo-berig ind!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 33,
      "text": "Nu er ieg komen saa ilde att holde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 34,
      "text": "Nu er ieg komen saa ilde att holde:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 34,
      "text": "ieg er komen y her Esky Frost hans wolde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 34,
      "text": "Men hadde ieg komitt y her Buge hans leen.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 35,
      "text": "Men haffde ieg komitt y her Buge hansz leenn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 35,
      "text": "tha hade meg icke røbitt huerkind rider eller suene.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 35,
      "text": "Nu er ieg røbitt aff en kocke-dreng.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 36,
      "text": "Nu er ieg røbbitt aff en kocke-dreng,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 36,
      "text": "ieg skall thett høffne, om ieg komer hiem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 36,
      "text": "Wel nu Gud, att ieg maa løffue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 37,
      "text": "Well nu Gud, att ieg maa løffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 37,
      "text": "ieg skaall meg for kongenn aff Danmarck kierre.\"",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 37,
      "text": "Saa snartt som her Bugen thi thiden fruo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 38,
      "text": "Saa snartt som her Bugy dy thidind fruo,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 38,
      "text": "hand sendee eftter hanom hans søner thuo.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 38,
      "text": "Hand sende med denom dy suene fem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 39,
      "text": "Hand sende med thenom thi suene fem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 39,
      "text": "luod hyntte den harre till Haald och hiem.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 39,
      "text": "Her Buge vnd-feekk denn herre med erre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 40,
      "text": "Her Buge vnd-feeck den haare med erre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 40,
      "text": "dy danske luod hanom till Engeland førre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 40,
      "text": "Der bleff dy vnd-fangen med møgen erre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 40,
      "text": ":: Men børen bleser denom østenn ind for Danmarck. ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}