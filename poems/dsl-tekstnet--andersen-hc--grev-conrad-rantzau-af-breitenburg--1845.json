{
  "id": null,
  "title": "† Grev Conrad Rantzau af Breitenburg",
  "year_created": 1845,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1845,
    "url": "https://tekstnet.dk/books/andersen-hc_grev-conrad-rantzau-af-breitenburg/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "I Natten, naar paa Stjernerne man seer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Og tænker ret paa sine kjære Döde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Det er, som om der bleve Stjerner fleer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Dybt banker Hjertet, vore Kinder glöde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "Vi föle Livets Aander er’ os nær;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "Hvad stort og godt er kan ei gaae tilgrunde!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": "– En Grav nu mere! – Ikke længer her",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 1,
      "text": "Er Du, hvem Hjertet nödigst miste kunde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "Du som i Stilhed gik til Snillets Vraa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "Om Lædskedrikken Roser selv Du flætted’;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "Paa Stjernen i dit Öie Öiet saae,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": "Og hurtigt skete hvad Du mildt forjætted’.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Du var et Hjerte til at stole paa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "Din Aand gav Lys og Næring ved sin Lue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "Du elsket og forstaaet var, som faa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "I Kongesalen og i Folkets Stue.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 4,
      "text": "Om mange, mange Aar, en Solskinsdag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "Naar Gubben seer fra Marsken Borgens Flöie,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "Han husker paa sin Barndom med Behag,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Og Dig – da kommer Taarer i hans Öie.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 5,
      "text": "Dig elsked’ Barnet for dit milde Blik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 5,
      "text": "Der var en Ungdoms Friskhed i din Tanke;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Med ærligt, aabent Sind hver til Dig gik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "De fölte i dit Bryst et Hjerte banke!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 6,
      "text": "Din Grav faaer stille mangt et Hjertes Qvad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 6,
      "text": "I tause Rythmer Taarerne sig blande;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 6,
      "text": "Gud vil opfylde hvad Du kjærligt bad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "– Svæv som en Fredens Aand om disse Lande!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
