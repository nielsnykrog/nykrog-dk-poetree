{
  "id": null,
  "title": "Christ ved mit hjerte er bange",
  "year_created": [
    1579,
    1583
  ],
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "anonymous",
    "country": null
  },
  "source": {
    "corpus": "Den ældste danske viseoverlevering (University of Copenhagen)",
    "title": "Langebeks kvart",
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1583,
    "url": "https://cst.dk/dighumlab/duds/DFK/Dorthe/html/LNGK78.htm"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Christ vedt mit hiarte er bange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "och brender som gluende lue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "de dage er mig saa lange",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "for en saa høffuisk en frue;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "hun motte wel were en førstinne",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "en dronning-naffn at bere;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "vdj hou, hiart, alle sinnde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "sømmer hinder bode tuct och ere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Kunde ieg bliffue vdy liffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "vdy thy thusennde aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "hindis fromhed at beschriffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "meg lang vmugligt waar;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "hun er baade danis och didefuldtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "trofast och erhe-riegh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "hindis dyuder ouffuer-gaar bode sylff oc guld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "huor findir man hindis lige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Roo och glede bode dag och natt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "saa lenge som liffuid khan vinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "en stor Gudtz gaffue och dyrbare schatt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "en from och dyudig quinde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "bedrøffuitt hiarte khan hun housuale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "som er aff sorrigen krist,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "met sin lifsalig ordtt och thale",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "giffuer hun stor glede och trøst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 3,
      "text": "Abigaill var en quinde sa fyn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 3,
      "text": "der rosz sa vide aff gange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 3,
      "text": "konning Dauid tog hinder til dronning sin",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 3,
      "text": "for sin velgierning mange;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 3,
      "text": "sa bleff oc Hester dett edelich blod",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 3,
      "text": "op-høyett en dronning at vere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 3,
      "text": "hun war gudfrictig, dannis och guod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 3,
      "text": "hun feck stuor heder och ehre.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 4,
      "text": "Nu er der ingen y werden till",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 4,
      "text": "eblant sadane oprigtige quinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 4,
      "text": "led och spør, huorlangt du viltt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 4,
      "text": "som lignis khan vid henne;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 4,
      "text": "som solen for andere sma sternne er",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 4,
      "text": "och guldt for kobber och thin,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 4,
      "text": "sa er dhen ieg haffuer vdj hiertett kier,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 4,
      "text": "blant fruer och iomfruer hun skin.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 5,
      "text": "Euindelig vill ieg glede meg,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 5,
      "text": "ieg motte then lilÿ borge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 5,
      "text": "o Gud, min troff er fast til degh,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 5,
      "text": "min vwenner giør du den sorge;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 5,
      "text": "de ere saa mange, bode fruer och møer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 5,
      "text": "som hinne den glede misandtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 5,
      "text": "som Gud, Vor-Herre, haffuer hinne til født,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 5,
      "text": "ad lyckenn ganger hinder tilhandt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 6,
      "text": "Dett giør de vdaff affuind och had,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 6,
      "text": "hendis licke de effter lange,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 6,
      "text": "de ere saa lidett aff hiartett glad,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 6,
      "text": "att de kunde den icke fannge;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 6,
      "text": "de thale well skønntt med tunge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 6,
      "text": "der er stor suig iblandtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 6,
      "text": "aff deris falske tunge",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 6,
      "text": "bruger dy bode løgen och tanndtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 7,
      "text": "Gud giffue deris hiarte briste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 7,
      "text": "som er saa auenfuldtt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 7,
      "text": "min ven vil ieg icke miste",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 7,
      "text": "for verdens sølff heller guldtt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 7,
      "text": "de khan icke forwende den løcke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 7,
      "text": "som Gud han hinder anndt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 7,
      "text": "skulle en hiarte briste y støcke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 7,
      "text": "dett siger ieg paa min sandtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 8,
      "text": "Laad dennum sige, huad de sige vill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 8,
      "text": "de schulle icke andett befinde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 8,
      "text": "en dett som ehren hører thill,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 8,
      "text": "vere seg enthen mand eller quinde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 8,
      "text": "alle gode gauffuer khommer aff Gud,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 8,
      "text": "sa schriffue de vise klercke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 8,
      "text": "och giffue dennum som frochte hans budt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 8,
      "text": "dett skal du spørre och mercke.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 9,
      "text": "Ihuor ieg ryder heller ganger",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 9,
      "text": "min hou hosz hinder er,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 9,
      "text": "saa sare ieg effter hinder langer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 9,
      "text": "ieg ville giernne hosz hinder vere;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 9,
      "text": "hun er oprigtig och dydelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 9,
      "text": "vdy alskens tugtt och ere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 9,
      "text": "straffe hannem Gud-fader vdj himerig,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 9,
      "text": "som andett aff hinne ville begiere.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 10,
      "text": "Lengsel oc denn store attraa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 10,
      "text": "leger slett mit hiartte vdj duale,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 10,
      "text": "førrenn ieg hender att see khan faa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 10,
      "text": "och frintelich mett hinner thale;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 10,
      "text": "motte ieg til hinder khomme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 10,
      "text": "for falske klaffers onde munde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 10,
      "text": "det blef meg til store fromme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 10,
      "text": "vdj thenn gledelich stund.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 11,
      "text": "Naar ieg paa hinder tencker,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 11,
      "text": "den edelich trøsterinde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 11,
      "text": "mit hiartte er klemtt vdj lencke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 11,
      "text": "førin ieg khan hinder finde;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 11,
      "text": "hun haffuer meg loffuid aff hiartet gott",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 11,
      "text": "att were min fultro wenn;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 11,
      "text": "hun skal befinde forvden all spott",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 11,
      "text": "aff hiartet det same igienn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 12,
      "text": "Endog thiden khan seg forhalle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 12,
      "text": "och lickenn er bleffuen meg gram,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 12,
      "text": "Gud khan meg best husuale",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 12,
      "text": "och vennde dett anderledis ohm;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 12,
      "text": "han ved min hiartens tancke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 12,
      "text": "han rader mit angiste bod,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 12,
      "text": "paa natzens dør vil ieg bancke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 12,
      "text": "min troff er til hannem gott.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 13,
      "text": "Trofast aff hiartt och synne,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 13,
      "text": "sa lenge ieg leffue khan,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 13,
      "text": "schal hun mig aldrig finde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 13,
      "text": "det siger ieg ether for sanndtt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 13,
      "text": "hun vil mig icki vnndfalle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 13,
      "text": "dett er min største trøst,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 13,
      "text": "ieg elscher hinder for alle",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 13,
      "text": "som hiartett vdy mit brøst.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 14,
      "text": "Skulle ieg dett ouffuer-giffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 14,
      "text": "som er meg troff och huld,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 14,
      "text": "ieg vil førre tagis aff liffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 14,
      "text": "ligge vnder then suortte mulldh;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 14,
      "text": "hinis bostaff vil ieg bere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 14,
      "text": "vdi mit hiartenns skrynn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 14,
      "text": "ieg vedt then wisselig at were,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 14,
      "text": "hun haffuer och mit vdi synn.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 15,
      "text": "Ingen kan solen foruide",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 15,
      "text": "ad schinne ohm dagen klaar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 15,
      "text": "eller monen ohm natten ad skride",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 15,
      "text": "paa himmelen obenbaer:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 15,
      "text": "sa khan ieg ingenn fortencke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 15,
      "text": "ad eske den ieg haffuer kier;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 15,
      "text": "mit gode richte wille de forkrencke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 15,
      "text": "ieg khan dennom icke quit were.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 16,
      "text": "Endog de huiske och tiske,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 16,
      "text": "ville meg then glede forwennde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 16,
      "text": "de ere saa smedig och sliffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 16,
      "text": "ieg det vel paa thennum kiender:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 16,
      "text": "de khan doch icke rørre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 16,
      "text": "hendis trofast hiarte och modt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 16,
      "text": "hun lader seg icke forførre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 16,
      "text": "hun er bode from och godh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 17,
      "text": "Ringe er ieg at bere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 17,
      "text": "sadan huldskaff och oprictighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 17,
      "text": "som hun beuieser meg herre",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 17,
      "text": "och altid haffuer bethedtt;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 17,
      "text": "ieg loffuer hinder alle mine dage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 17,
      "text": "aff gantzske hiarttenns grund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 17,
      "text": "giøre dett hun well behage",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 17,
      "text": "indtil min sieste stundtt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 18,
      "text": "Nu wil ieg alting laade fare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 18,
      "text": "paa denne tid och stund,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 18,
      "text": "Gud nadelich hinder beuare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 18,
      "text": "fra vnde mennischers mund;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 18,
      "text": "de schal doch inttett vdrette",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 18,
      "text": "vden deris vlempe stoer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 18,
      "text": "deris thale er søde och slette,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 18,
      "text": "hun troer icke paa deris ordh.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 19,
      "text": "Euige Gud som osz haffuer skafft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 19,
      "text": "och alting haffuer at raade,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 19,
      "text": "som ingen mennissche vil haffue fortafft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 19,
      "text": "han beuare osz til-sammen bode;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 19,
      "text": "vy kunde fremdage vor liffnitt saa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 19,
      "text": "her vdi iorderige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 19,
      "text": "at naar wi skulle af werden gaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 19,
      "text": "maa findes vdj hemerige.",
      "part": false,
      "marginal_notes": []
    }
  ]
}