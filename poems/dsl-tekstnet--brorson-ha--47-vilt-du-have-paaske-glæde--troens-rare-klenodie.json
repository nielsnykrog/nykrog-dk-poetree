{
  "id": null,
  "title": "47. Vilt du have paaske-glæde?",
  "year_created": 1739,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Adolph Brorson",
    "country": null,
