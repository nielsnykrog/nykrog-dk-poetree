      "id": 0,
      "stanza_id": 0,
      "text": "⁕ Ja/ dine Propheter haffue predicket wnyttig oc løst skualder for dig/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Och ey haffue vent dit Fengsel/",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Men nogre falske trusel haffue de predicket dig faare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "At der aff er landflyttigt Folck bleffuit",
      "part": false,
      "marginal_notes": []
    }
  ]
