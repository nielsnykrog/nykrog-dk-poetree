  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Thenndt 25 Wiisze",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Lystiig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 1,
      "text": "Hin vnge her karll aff nør-ÿttland",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 1,
      "text": "hand kand saa listelig | gille",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 1,
      "text": "och rider hand seg thill Siellanndt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 1,
      "text": "ther fremmer | hand alle sin wille",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 1,
      "text": ":: ÿ bider osz vnder thiellen min skiønnest ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 2,
      "text": "Her karll hannd seder ÿ høgelofft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 2,
      "text": "hand Leger met | racker och finde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 2,
      "text": "huad will ÿ mig suar min skiønne | Iomfrue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 2,
      "text": "med Eren will ieg ether winde.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 2,
      "text": ":: I. B ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 3,
      "text": "Ieg er mig ett kongens barn,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 3,
      "text": "och y Enn greffue Sa rig |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 3,
      "text": "ÿ er icke saa aff slegt eller Adell",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 3,
      "text": "attj Kunde were | min lige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 3,
      "text": ":: I. B ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 4,
      "text": "I er west et konngens barn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 4,
      "text": "och ieg en greffue saa rig |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 4,
      "text": "Ieg beder ether aller-kieriste ven",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 4,
      "text": "ÿ Lader meg were | ethers Lige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 4,
      "text": ":: I B ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 5,
      "text": "Her karll ÿ kannd saa Lystelig gille",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 5,
      "text": "som ieg haffuer | hørtt en mand",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 24,
      "stanza_id": 5,
      "text": "ieg thør dog icke for fader min",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 25,
      "stanza_id": 5,
      "text": "suar ether | som ieg ether Ond.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 26,
      "stanza_id": 5,
      "text": ":: I B ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 27,
      "stanza_id": 6,
      "text": "Leger ÿ aff ethers rÿders-kleder,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 28,
      "stanza_id": 6,
      "text": "kleder ether ÿ | Iomfrue Lige",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 29,
      "stanza_id": 6,
      "text": "ÿ suer meg paa ethers Christelig | thro",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 30,
      "stanza_id": 6,
      "text": "ÿ will meg aller Suige.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 31,
      "stanza_id": 6,
      "text": ":: I B. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 32,
      "stanza_id": 7,
      "text": "I maa lade ethers har wd-woxe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 33,
      "stanza_id": 7,
      "text": "och Iomfrue-kleder | at skier,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 34,
      "stanza_id": 7,
      "text": "saa farer ÿ thill min Faders gaardt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 35,
      "stanza_id": 7,
      "text": "ÿ | thager ether thienneste ther |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 36,
      "stanza_id": 8,
      "text": "I haffuer thack aller-kieriste min",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 37,
      "stanza_id": 8,
      "text": "alt for ethers goude rad |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 38,
      "stanza_id": 8,
      "text": "ieg will komme inden halff-Aars-frest",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 39,
      "stanza_id": 8,
      "text": "thet maa | Ennd well fulduell ghaa",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 40,
      "stanza_id": 8,
      "text": ":: I B O V T M S ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 41,
      "stanza_id": 9,
      "text": "Saa lod hannd seg har woxe",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 42,
      "stanza_id": 9,
      "text": "och Iomfrue-kleder att | skier",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 43,
      "stanza_id": 9,
      "text": "och saa foer hannd thill kongens gaard",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 44,
      "stanza_id": 9,
      "text": "alt som | hand end Iomfrue monne Were",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 45,
      "stanza_id": 9,
      "text": ":: I B O ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 46,
      "stanza_id": 10,
      "text": "Thet war wngen herre karll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 47,
      "stanza_id": 10,
      "text": "hand ind aff dørenn | thren,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 48,
      "stanza_id": 10,
      "text": "thet war Fruer och Iomfruer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 49,
      "stanza_id": 10,
      "text": "thÿ stannder | hannom op Igien,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 50,
      "stanza_id": 10,
      "text": ":: I B O ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 51,
      "stanza_id": 11,
      "text": "Her sider ÿ Liden Kirstenn",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 52,
      "stanza_id": 11,
      "text": "ether følger bode thogt och | Ere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 53,
      "stanza_id": 11,
      "text": "ieg er ether sennd aff Fremet Land",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 54,
      "stanza_id": 11,
      "text": "will ÿ meg | ethers sleffnet Lere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 55,
      "stanza_id": 11,
      "text": ":: I B ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 56,
      "stanza_id": 12,
      "text": "Ald then sleffnet ther ieg kannd",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 57,
      "stanza_id": 12,
      "text": "then Lerer ieg ether medt | ere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 58,
      "stanza_id": 12,
      "text": "ieg will spørge min Fader att,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 59,
      "stanza_id": 12,
      "text": "om wj maa Samel | Were",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 60,
      "stanza_id": 12,
      "text": ":: I B ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 61,
      "stanza_id": 13,
      "text": "I Stannder op tho aff mine Iomfruer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 62,
      "stanza_id": 13,
      "text": "ÿ Snacker | med hinder boude,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 63,
      "stanza_id": 13,
      "text": "y-meden ieg gaar ÿ høgelofft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 64,
      "stanza_id": 13,
      "text": "Och | Spør min fader thill rade |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 65,
      "stanza_id": 14,
      "text": "Her Seder ÿ Danner-kongen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 66,
      "stanza_id": 14,
      "text": "aller-kiereste min Fader |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 67,
      "stanza_id": 14,
      "text": "her er kommet Enn Iomfrue aff Fremmede Land |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 68,
      "stanza_id": 14,
      "text": "hun giernne will sleffnet Nemme",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 69,
      "stanza_id": 14,
      "text": ":: I B ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 70,
      "stanza_id": 15,
      "text": "Meg er sennd end Iomfrue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 71,
      "stanza_id": 15,
      "text": "Saa Lanngt aff fremede | Lannde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 72,
      "stanza_id": 15,
      "text": "saa giernne tha will hun sleffnet Lere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 73,
      "stanza_id": 15,
      "text": "Saa | lidet hun ther-aff kand,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 74,
      "stanza_id": 15,
      "text": ":: I B ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 75,
      "stanza_id": 16,
      "text": "Hinder er Fader och moder Fra død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 76,
      "stanza_id": 16,
      "text": "Søskenn och brøder | alle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 77,
      "stanza_id": 16,
      "text": "saa giernne tha will hun sleffnet Lere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 78,
      "stanza_id": 16,
      "text": "Saa | Fouer er alle hindis Ford.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 79,
      "stanza_id": 16,
      "text": ":: I B ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 80,
      "stanza_id": 17,
      "text": "Hun Siønnes att were saa deilig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 81,
      "stanza_id": 17,
      "text": "hinder Følger bode thogt | och ere,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 82,
      "stanza_id": 17,
      "text": "huad will ÿ mig suar kier fader min",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 83,
      "stanza_id": 17,
      "text": "maa hun | hos mig were.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 84,
      "stanza_id": 17,
      "text": ":: I B ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 85,
      "stanza_id": 18,
      "text": "Saa well maa ÿ thill-Sammen were,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 86,
      "stanza_id": 18,
      "text": "Effther begis | ethers wille,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 87,
      "stanza_id": 18,
      "text": "thu wogte hinder for kier broder din |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 88,
      "stanza_id": 18,
      "text": "hannd kand saa Lestelig Gille",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 89,
      "stanza_id": 18,
      "text": ":: I B ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 90,
      "stanza_id": 19,
      "text": "Thi war thill-sammell it Aar Omkring,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 91,
      "stanza_id": 19,
      "text": "for-inden | thenn fruer-stue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 92,
      "stanza_id": 19,
      "text": "Ingen Andet weste,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 93,
      "stanza_id": 19,
      "text": "End thj war | Iomfruer bode",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 94,
      "stanza_id": 19,
      "text": ":: I B ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 95,
      "stanza_id": 20,
      "text": "Thet war omkring enn pindtz-dag",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 96,
      "stanza_id": 20,
      "text": "thi skulle thill kierken | fare",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 97,
      "stanza_id": 20,
      "text": "tha wortte Dannsker droning",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 98,
      "stanza_id": 20,
      "text": "thi thiding først att | War",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 99,
      "stanza_id": 20,
      "text": ":: I B ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 100,
      "stanza_id": 21,
      "text": "Thet war dannsker dronning",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 101,
      "stanza_id": 21,
      "text": "hun suøber seg hoffuet | ÿ skiend,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 102,
      "stanza_id": 21,
      "text": "saa gaar hun ÿ høger-lofft,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 103,
      "stanza_id": 21,
      "text": "For dannsker kongen | och inde,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 104,
      "stanza_id": 21,
      "text": ":: I B ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 105,
      "stanza_id": 22,
      "text": "Hør ÿ thet min Edelig Herre,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 106,
      "stanza_id": 22,
      "text": "ieg will ether sige ther-fraa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 107,
      "stanza_id": 22,
      "text": "thet er icke enn Iomfrue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 108,
      "stanza_id": 22,
      "text": "wor datter haffuer att | Lere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 109,
      "stanza_id": 22,
      "text": ":: I B. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 110,
      "stanza_id": 23,
      "text": "Op stod danner-kongen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 111,
      "stanza_id": 23,
      "text": "thog offuer seg skarlagenn-skiend |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 112,
      "stanza_id": 23,
      "text": "saa gaard hannd ÿ Fruerstuen,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 113,
      "stanza_id": 23,
      "text": "For Fruer | Och Iomfruer Ind.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 114,
      "stanza_id": 23,
      "text": ":: I B. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 115,
      "stanza_id": 24,
      "text": "Her sider ÿ fruer och Iomfruer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 116,
      "stanza_id": 24,
      "text": "møer och godenn Quinde |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 117,
      "stanza_id": 24,
      "text": "och saa hin vnge here karll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 118,
      "stanza_id": 24,
      "text": "Alt om hand er her Inde |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 119,
      "stanza_id": 24,
      "text": ":: I. B. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 120,
      "stanza_id": 25,
      "text": "Op stod vngenn herre karll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 121,
      "stanza_id": 25,
      "text": "ÿ Silcke-kiorthell rødt |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 122,
      "stanza_id": 25,
      "text": "hør ÿ danner-Kongen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 123,
      "stanza_id": 25,
      "text": "huad haffuer j meg att Wede |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 124,
      "stanza_id": 26,
      "text": "Hør thu vngen herre karll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 125,
      "stanza_id": 26,
      "text": "thet haffuer ieg thig Att | wede",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 126,
      "stanza_id": 26,
      "text": "hui est thu kommen ÿ høgelofft",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 127,
      "stanza_id": 26,
      "text": "thill Ennest | Datter min",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 128,
      "stanza_id": 26,
      "text": ":: I B. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 129,
      "stanza_id": 27,
      "text": "Suarde thet vngen herre karll,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 130,
      "stanza_id": 27,
      "text": "hand war saa small | som lillie-kuest,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 131,
      "stanza_id": 27,
      "text": "wed mend Danner-kongen",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 132,
      "stanza_id": 27,
      "text": "ieg haffuer | hinder wonden mest Lest",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 133,
      "stanza_id": 27,
      "text": ":: I B. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 134,
      "stanza_id": 28,
      "text": "Tha skall ieg giffue thig thenn Første død",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 135,
      "stanza_id": 28,
      "text": "ther nogen rider | will haffue,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 136,
      "stanza_id": 28,
      "text": "iegskall lade thig hoffuit fra Slaa,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 137,
      "stanza_id": 28,
      "text": "din | lig ÿ kiercken Begraffue",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 138,
      "stanza_id": 28,
      "text": ":: I B ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 139,
      "stanza_id": 29,
      "text": "Suarde thet Liden Kiersten",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 140,
      "stanza_id": 29,
      "text": "hindis øgen thi runde saa stride |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 141,
      "stanza_id": 29,
      "text": "ieg beder ether min kier Fader",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 142,
      "stanza_id": 29,
      "text": "ÿ giør meg aller then Kuide |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 143,
      "stanza_id": 29,
      "text": ":: I. B. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 144,
      "stanza_id": 30,
      "text": "Suarde thet hindis kier moder",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 145,
      "stanza_id": 30,
      "text": "saa Lestelig vnder skind |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 146,
      "stanza_id": 30,
      "text": "ieg haffuer thig offte thill Senge Fuld",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 147,
      "stanza_id": 30,
      "text": "medt Eneste | datter min",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 148,
      "stanza_id": 30,
      "text": ":: I B ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 149,
      "stanza_id": 31,
      "text": "Saa thit haffuer ieg thagit thig ÿ Arom,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 150,
      "stanza_id": 31,
      "text": "och køst wid | din mund saa rødt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 151,
      "stanza_id": 31,
      "text": "hagde ieg west du her Karll warst",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 152,
      "stanza_id": 31,
      "text": "ieg | skulle haffue slaget thig thill døde",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 153,
      "stanza_id": 31,
      "text": ":: I B ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 154,
      "stanza_id": 32,
      "text": "Thet Suarde Dannsken dronning",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 155,
      "stanza_id": 32,
      "text": "hun Suarde ett ordt | medt ere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 156,
      "stanza_id": 32,
      "text": "thet er stoor Sønnde at skielle thennom att |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 157,
      "stanza_id": 32,
      "text": "som giernne thill-Sammen wille Vere",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 158,
      "stanza_id": 32,
      "text": ":: I B. ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 159,
      "stanza_id": 33,
      "text": "Ther war stoor glede ÿ kongens gaard",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 160,
      "stanza_id": 33,
      "text": "at Liude ther-paa |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 161,
      "stanza_id": 33,
      "text": "Konngen gaff Sin datter bortt",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 162,
      "stanza_id": 33,
      "text": "hind wnge her Karll | hinder thog.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 163,
      "stanza_id": 33,
      "text": ":: I B ::",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 164,
      "stanza_id": 34,
      "text": "Nu haffuer vngen her karll",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 165,
      "stanza_id": 34,
      "text": "for-wonnden bode Angest |",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 166,
      "stanza_id": 34,
      "text": "nu soffuer hannd saa gladelig",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 167,
      "stanza_id": 34,
      "text": "wdj Liden kierstenn | hindis Arom",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 168,
      "stanza_id": 34,
      "text": ":: I Bider Osz Vnder thielden min | ald skiønneste, ::",
      "part": false,
      "marginal_notes": []
    }
  ]
}