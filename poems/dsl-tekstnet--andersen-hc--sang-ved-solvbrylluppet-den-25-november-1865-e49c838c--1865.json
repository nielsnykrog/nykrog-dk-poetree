{
  "id": null,
  "title": "Sang ved Sölvbrylluppet den 25 November 1865",
  "year_created": 1865,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
    "wiki": "Q5673"
  },
  "source": {
    "corpus": "Tekstnet — Det Danske Sprog- og Litteraturselskab",
    "title": null,
    "publisher": null,
    "printer": null,
    "place": null,
    "year_published": 1865,
    "url": "https://tekstnet.dk/books/andersen-hc_sang-ved-soelvbrylluppet-den-25-november-1865/"
  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Erindrer Du –? Ja det er længe siden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Og dog saa kort, kun fem og tyve Aar,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Kun fem og tyve Vingeslag af Tiden,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Der lyner fremad mod en evig Vaar;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Erindrer Du Bredgadens Gaard, den gamle?",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Halv spansk, med Muur, Balkon og Lindetræer.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Det var et Hjem, der kunde Hjerter samle,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Der kom og saae og vandt han Bruden her.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 1,
      "text": "Hun var saa freidig, mild og snild tillige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 1,
      "text": "Og Beileren var brav og god Student;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 1,
      "text": "Hvad Hjerterne da saae i Drømmens Rige,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 1,
      "text": "Er rullet op og nu som Sandhed kjendt.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 1,
      "text": "Den deelte Sorg er halv, den deelte Lykke",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 1,
      "text": "Er dobbelt stor i Ægtekjærlighed.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 1,
      "text": "Hver Prøvelse fløi hen, som Skyens Skygge;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 1,
      "text": "Fra Himlen milde Øine see herned.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 16,
      "stanza_id": 2,
      "text": "Den grønne Krands blev Sølv, nu Guldet kommer,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 17,
      "stanza_id": 2,
      "text": "Hvert Aar vil Krandsen faae sit gyldne Blad;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 18,
      "stanza_id": 2,
      "text": "Om fem og tyve Aar, i Eftersommer",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 19,
      "stanza_id": 2,
      "text": "Den straaler, – atter toner Bryllupsqvad.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 20,
      "stanza_id": 2,
      "text": "Da kan I sige, naar de Visen sjunge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 21,
      "stanza_id": 2,
      "text": "Sølvbryllupsdagen var jo Ungdomsdag!",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 22,
      "stanza_id": 2,
      "text": "Syng Brudeparrets Skaal, de altid unge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 23,
      "stanza_id": 2,
      "text": "Fornem i Sangens Flugt vort Hjerteslag!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
