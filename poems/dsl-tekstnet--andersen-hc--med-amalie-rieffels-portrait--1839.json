  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Tangenterne, de sorte og de hvide,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Er Troldoms Stave; Du berører dem,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Og Melodiens Aander bruse frem;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "De til Turnering paa dit Bud udride,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "De lyde Dig, Du løfte deres Tunge,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Dit Navn de gjennem Verden høit skal sjunge!",
      "part": false,
      "marginal_notes": []
    }
  ]
