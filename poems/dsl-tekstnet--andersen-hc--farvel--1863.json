  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Nu kommer Kongens Liig! – Du Folkekjære,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "Du var saa mild og god mod Høi og Lav,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Du var saa dansk som nogen Mand kan være,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "Hav evig Tak for hvad Du Danmark gav.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Du ærligt med os tunge Dage prøved’,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "Og med os har Du Glædes-Taarer grædt,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Men nu er hvert et Hjerte dybt bedrøvet,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "Det var groet fast til dit, – thi bløder det.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Dit brast i Døden, trofast til det sidste;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Mod Slesvigs Jord sig Øiet sænked’ ned.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Igjennem Taarer see vi mod din Kiste;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "Farvel! I Gjerning staaer din Kjærlighed,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 12,
      "stanza_id": 0,
      "text": "Og i hvert Bryst er reist et Dannevirke;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 13,
      "stanza_id": 0,
      "text": "Du veed det, seer det med forklaret Blik,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 14,
      "stanza_id": 0,
      "text": "Mens Sørgeklokker lyde fra hver Kirke,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 15,
      "stanza_id": 0,
      "text": "Og vort Farvel. – Farvel Kong Frederik!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
