  },
  "body": [
    {
      "id": 0,
      "stanza_id": 0,
      "text": "Tre, fire Katte hinanden mødte",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 1,
      "stanza_id": 0,
      "text": "ved Kjøkkentrappen omkring en Bøtte.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 2,
      "stanza_id": 0,
      "text": "Miau, sagde med Kjendermine En,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 3,
      "stanza_id": 0,
      "text": "jeg synes, jeg lugter et Sildeben. -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 4,
      "stanza_id": 0,
      "text": "Saa trængte de Alle om Bøtteranden;",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 5,
      "stanza_id": 0,
      "text": "den Ene skubbed afvej en den Anden.",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 6,
      "stanza_id": 0,
      "text": "Stop! skreg den Største, lad mig gaa ned,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 7,
      "stanza_id": 0,
      "text": "saa skal jeg give Jer strax Besked:",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 8,
      "stanza_id": 0,
      "text": "Hvi skulle vi saa hinanden trænge -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 9,
      "stanza_id": 0,
      "text": "Vips: hopped han ned - det vared lidt længe -",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 10,
      "stanza_id": 0,
      "text": "Miau, sagde Kattene rundt omkring,",
      "part": false,
      "marginal_notes": []
    },
    {
      "id": 11,
      "stanza_id": 0,
      "text": "pas paa, han giver os Ingenting!",
      "part": false,
      "marginal_notes": []
    }
  ]
}
