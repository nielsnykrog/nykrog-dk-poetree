{
  "id": null,
  "title": "Sang ved Herr Grosserer I. B. Melchiors og Frøken Johanne Melchiors Bryllup den 3die Marts 1867",
  "year_created": 1867,
  "neighbors": null,
  "duplicate": false,
  "locations": false,
  "author": {
    "name": "Hans Christian Andersen",
    "country": null,
